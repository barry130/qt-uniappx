{
	"id": "qt-stat",
	"displayName": "轻听音乐统计采集（qt-stat）",
	"version": "1.0.0",
	"description": "轻量级全端统计采集插件：设备匿名标识（UUID）、启动/访问/页面 PV/停留时长/JS 错误采集，内存队列 + 定时/满批批量匿名上报（POST /api/v1/stat/report），hide 持久化队列防丢，失败重试。仅采集 JS/UTS 层可捕获运行错误（原生崩溃不做采集）。纯采集版，接口契约见 STATS_DESIGN.md。",
	"keywords": [
		"统计",
		"埋点",
		"采集",
		"PV",
		"错误上报"
	],
	"repository": "",
	"engines": {
		"HBuilderX": "^4.66",
		"uni-app": "",
		"uni-app-x": "^4.66"
	},
	"dcloudext": {
		"type": "uts",
		"sale": {
			"regular": {
				"price": "0.00"
			},
			"sourcecode": {
				"price": "0.00"
			}
		},
		"contact": {
			"qq": ""
		},
		"declaration": {
			"ads": "无",
			"data": "采集匿名统计数据：客户端随机 UUID（非 IMEI/OAID）、设备型号、系统版本、App 版本、页面访问、停留时长、运行错误；不含任何个人身份信息，不上传设备硬件标识。",
			"permissions": "android.permission.INTERNET"
		},
		"npmurl": "",
		"darkmode": "x",
		"i18n": "x",
		"widescreen": "x"
	},
	"uni_modules": {
		"dependencies": [],
		"encrypt": [],
