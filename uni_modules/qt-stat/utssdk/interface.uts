/**
 * qt-stat 跨端统一类型定义
 * 供各平台 index.uts 与 App 侧共同引用
 *
 * 事件契约见《STATS_DESIGN.md》§4.1：POST /api/v1/app/stat/report
 * 事件字段：evt/ts/deviceId/ut/appVersion/model/os/page/duration/ch/errorType/message/stack/extra
 */

/**
 * 事件类型（与后端契约一致）
 * - launcher 冷启动、show 回前台、hide 退后台（带 duration 停留时长）
 * - page 页面访问（带 page 路由）、error JS/UTS 运行错误、custom 预留
 */
export type QtStatEventType = 'launcher' | 'show' | 'hide' | 'page' | 'error' | 'custom'

/**
 * 插件初始化参数
 */
export type QtStatOptions = {
	/** 上报地址（必填），如 resolveUrl("app/stat/report")，最终为 POST /api/v1/app/stat/report */
	ingestUrl: string
	/** 渠道标识，如 official */
	channel: string
	/** 调试日志开关（仅影响插件自身 console 输出，不影响上报） */
	debug: boolean
	/** 批量上报定时间隔（毫秒），默认 10000 */
	batchIntervalMs: number
	/** 满批触发条数（1..200），默认 50 */
	maxBatchSize: number
}
