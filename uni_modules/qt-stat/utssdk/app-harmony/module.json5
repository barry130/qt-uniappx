{
  "module": {
    // 鸿蒙模块名按 uni-app x 的生成规则写死：packageName 去掉 @、'/'→'__'、'-'→'_'，
    // 即 @uni_modules/qt-stat → uni_modules__qt_stat。
    // （这个字段可以省略让编译器生成，写出来是为了让「插件被编成哪个 module」在源码里可见。）
    "name": "uni_modules__qt_stat",
    // 固定为 har：uts 插件编译到鸿蒙时整体就是一个 har 模块（见 uts-for-harmony 文档）。
    "type": "har",
    "deviceTypes": [
      "default",
      "tablet",
      "2in1"
    ],
    "requestPermissions": [
      {
        // 采集上报直连 astral 的 POST /api/v1/app/stat/report（匿名公开接口），必须有联网权限。
        // INTERNET 属于 system_grant（安装即授予、无弹窗），所以不需要 reason/usedScene；
        // 反过来，给 system_grant 权限硬加 reason 在部分版本上会因缺 $string 资源而编译失败。
        "name": "ohos.permission.INTERNET"
      }
    ]
  }
}
