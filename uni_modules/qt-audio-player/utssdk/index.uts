/**
 * qt-audio-player 统一入口兜底（安卓 / 鸿蒙之外的平台走此文件）
 *
 * 平台实现：
 * - 安卓端：utssdk/app-android/index.uts
 * - 鸿蒙端：utssdk/app-harmony/index.uts（自研 AVPlayer + AVSession + 长时任务，不用 uni 内置后台音频管理器）
 *
 * 注意：各平台优先取自己的 utssdk/<平台>/index.uts，本文件只在没有对应平台实现时生效；
 * 这里的存根一律抛错，表示「该平台不支持」。
 */

import type {
	AudioPlayerVoidCallback,
	AudioPlayerTimeCallback,
	AudioPlayerErrorCallback,
	AudioPlayerStateCallback,
	AudioPlaylistItem,
	AudioResolveRequestCallback,
	AudioTrackChangedCallback,
} from './interface.uts'

/**
 * 原生通知栏音乐播放器（前台服务保活）— 内部实现类，**不导出**
 * 安卓 / 鸿蒙端均有各自的原生实现，其他平台调用会抛出错误
 *
 * 为何去掉 export：UTS 编译器会为「导出给 JS 的类」生成
 * `UTSBridge.registerJavaScriptClassInstance(...)` 构造函数桥；该 Kotlin API 是 internal
 * 可见性，编译器于是在生成的 `UniUTSMethodRegister.registerUTSMethod()` 上注入
 * `@Suppress("INVISIBLE_MEMBER", "INVISIBLE_REFERENCE")`，导致每次编译都打印
 * 「This code uses error suppression for 'INVISIBLE_REFERENCE' … UNSPECIFIED …」警告。
 * 前端只经模块级函数（audioPlay 等）调用播放器，从不 new 本类（全仓零引用），
 * 去掉 export 后构造函数桥不再生成、警告随之消失，生成的 Kotlin 类形态与行为均不变。
 */
class QtAudioPlayer {
	constructor() {
		throw new Error('[qt-audio-player] 本平台未实现（仅支持安卓端 / 鸿蒙端 APP）')
	}
}

/**
 * 检查/请求通知栏权限（安卓端 APP 生效；鸿蒙端见 app-harmony 的 ensureNotificationPermission）
 * 其他平台直接回调 true（视为已授权），由调用方按平台降级。
 */
export function ensureNotificationPermission(onGranted: (granted: boolean) => void): void {
	if (onGranted != null) onGranted(true)
}

