/**
 * qt-audio-player 统一入口
 * 本插件仅支持安卓端 APP，其他平台调用时抛出错误
 * 安卓端实现见 utssdk/app-android/index.uts
 */

import type { AudioPlayerVoidCallback, AudioPlayerTimeCallback, AudioPlayerErrorCallback } from './interface.uts'

/**
 * 安卓端原生通知栏音乐播放器（前台服务保活）
 * 仅支持安卓端 APP，其他平台调用会抛出错误
 */
export class QtAudioPlayer {
	constructor() {
		throw new Error('[qt-audio-player] 本插件仅支持安卓端 APP')
	}
}

/**
 * 检查/请求通知栏权限（仅安卓端 APP 生效）
 * 其他平台直接回调 true（视为已授权），由调用方按平台降级。
 */
export function ensureNotificationPermission(onGranted: (granted: boolean) => void): void {
	if (onGranted != null) onGranted(true)
}

// ==================== 模块级门面（与 app-android 同名导出） ====================
// JS 侧统一走这些无实例函数（见 app-android/index.uts 的说明）；
// 这里给非安卓平台提供同签名的抛错存根，保证跨平台类型检查通过。

