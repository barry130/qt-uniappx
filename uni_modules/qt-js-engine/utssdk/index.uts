/**
 * qt-js-engine 通用实现（非安卓平台占位）
 *
 * 安卓实现见 ./app-android/index.uts。iOS 计划走系统 JavaScriptCore（阶段二），
 * 在此之前统一返回「不支持」，在线取链不可用（本地音乐不受影响）。
 */

import type {
	QtJsStart,
	QtJsStop,
	QtJsEvaluate,
	QtJsIsRunning,
	QtJsLoadBundle,
	QtJsLoadPlayBundle,
	QtJsInvoke,
	QtJsDropOp,
	QtJsIsHealthy,
	QtJsDataDir,
	QtJsReadTextFile,
	QtJsWriteTextFile,
	QtJsExists,
	QtJsRemove,
	QtJsMkdirs,
	QtJsListDir,
	QtJsReadAssetText,
	QtJsSpikeNativeTimer,
	QtJsStartCallback,
	QtJsEvalCallback,
	QtJsVoidCallback,
	QtJsFileCallback,
	QtJsSpikeTimerCallback,
} from './interface.uts';

const NOT_SUPPORTED = '当前平台暂不支持音源 JS 引擎';

export const start: QtJsStart = function (options, callback: QtJsStartCallback) {
	callback(null, NOT_SUPPORTED);
};

export const stop: QtJsStop = function (callback: QtJsVoidCallback) {
	callback({ ok: true, error: '' });
};

export const evaluate: QtJsEvaluate = function (code, callback: QtJsEvalCallback) {
	callback({ ok: false, value: '', error: NOT_SUPPORTED });
};

export const loadBundle: QtJsLoadBundle = function (code, callback: QtJsVoidCallback) {
	callback({ ok: false, error: NOT_SUPPORTED });
};

export const loadPlayBundle: QtJsLoadPlayBundle = function (code, callback: QtJsVoidCallback) {
	callback({ ok: false, error: NOT_SUPPORTED });
};

export const invoke: QtJsInvoke = function (name, argsJson, timeoutMs, callback: QtJsEvalCallback) {
	callback({ ok: false, value: '', error: NOT_SUPPORTED });
};

export const dropOp: QtJsDropOp = function (opId: number) {
	// 无引擎可放弃
};

export const isRunning: QtJsIsRunning = function (): boolean {
	return false;
};

export const isHealthy: QtJsIsHealthy = function (): boolean {
	return true;
};

// 文件读写与平台无关，但非安卓端音源包机制整体未启用，这里统一按「无目录」处理。
export const dataDir: QtJsDataDir = function (): string {
	return '';
};

export const readTextFile: QtJsReadTextFile = function (path, callback: QtJsFileCallback) {
	callback(false, '', NOT_SUPPORTED);
};

export const writeTextFile: QtJsWriteTextFile = function (path, text, callback: QtJsFileCallback) {
	callback(false, '', NOT_SUPPORTED);
};

export const exists: QtJsExists = function (path, callback: QtJsFileCallback) {
	callback(false, '', NOT_SUPPORTED);
};

export const remove: QtJsRemove = function (path, callback: QtJsFileCallback) {
	callback(false, '', NOT_SUPPORTED);
};

export const mkdirs: QtJsMkdirs = function (path, callback: QtJsFileCallback) {
	callback(false, '', NOT_SUPPORTED);
};

export const listDir: QtJsListDir = function (dir, callback: QtJsFileCallback) {
	callback(false, '', NOT_SUPPORTED);
};

export const readAssetText: QtJsReadAssetText = function (path, callback: QtJsFileCallback) {
	callback(false, '', NOT_SUPPORTED);
};

export const spikeNativeTimer: QtJsSpikeNativeTimer = function (
	delayMs: number,
	callback: QtJsSpikeTimerCallback
) {
	callback('', NOT_SUPPORTED);
};
