{
	"id": "qt-js-engine",
	"displayName": "轻听音源 JS 引擎（qt-js-engine）",
	"version": "1.0.0",
	"description": "Android / Harmony / iOS 本地执行音源包脚本的 JS 引擎插件（包由用户安装，仓库不内置）。Android 使用系统 WebView V8，Harmony 使用 ArkWeb，iOS 使用系统 WebKit JavaScriptCore 的 ES Module 加载器。各平台提供原生 HTTP、定时器、文件持久化、独立播放包/数据包装载和超时隔离；iOS 官方包验签使用原生 CryptoKit Ed25519。",
	"keywords": [
		"WebView",
		"V8",
		"JS引擎",
		"音源",
		"source-bundle"
	],
	"repository": "",
	"engines": {
		"HBuilderX": "^4.66",
		"uni-app": "",
		"uni-app-x": "^4.66"
	},
