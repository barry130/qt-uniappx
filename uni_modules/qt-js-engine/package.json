		"declaration": {
			"ads": "无",
			"data": "插件不采集任何数据；引擎执行的是应用自身下发的音源包脚本，脚本内的网络请求由宿主注入的 HTTP 桥发出。",
			"permissions": "android.permission.INTERNET；ohos.permission.INTERNET"
		},
