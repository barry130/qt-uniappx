{
	"id": "qt-js-engine",
	"displayName": "轻听音源 JS 引擎（qt-js-engine）",
	"version": "1.0.0",
	"description": "安卓端本地执行音源包脚本 source-bundle.js 的 JS 引擎插件（脚本由用户在应用内安装，仓库不内置）。后端是系统 WebView 的 V8/JIT（混淆脚本 init 从内嵌解释器的 6-9s 降到约 200-350ms，可删 platforms 白名单、无需预热）。带原生注入的定时器与 HTTP 桥、装载闸门、poison 隔离；iOS 侧走系统 JavaScriptCore。",
	"keywords": [
		"WebView",
		"V8",
		"JS引擎",
		"音源",
		"source-bundle"
	],
	"repository": "",
	"engines": {
		"HBuilderX": "^4.66",
		"uni-app": "",
		"uni-app-x": "^4.66"
	},
	"dcloudext": {
		"type": "uts",
		"sale": {
			"regular": {
				"price": "0.00"
			},
			"sourcecode": {
				"price": "0.00"
			}
		},
		"contact": {
			"qq": ""
		},
		"declaration": {
			"ads": "无",
			"data": "插件不采集任何数据；引擎执行的是应用自身下发的音源包脚本，脚本内的网络请求由宿主注入的 HTTP 桥发出。",
			"permissions": "android.permission.INTERNET"
		},
		"npmurl": "",
		"darkmode": "x",
		"i18n": "x",
		"widescreen": "x"
	},
