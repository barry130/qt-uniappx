<template>
  <view
    v-if="!layout.isWide"
    class="tab-bar"
    :style="'background-color:' + theme.skin.tabSurface + ';border-color:' + theme.skin.border + ';bottom:' + bottomPx + 'px;'"
  >
    <view
      v-for="item in tabs"
      :key="item.path"
      class="tab-item"
      @click="go(item.path)"
    >
      <view
        class="tab-chip"
        :style="active(item.path) ? 'background-color:' + theme.skin.accentSoft + ';' : 'background-color:transparent;'"
      >
        <view class="tab-icon-wrap">
          <!-- 图标 48rpx：与 .tab-icon-wrap 的 56 x 52rpx 配套。原先写 24 是
               24rpx = 375dp 手机上只有 12dp，正好是容器的一半（容器当时写的是
               28px，px 与 rpx 混排的另一处老账），720dp 窗口上才偶然对上 -->
          <QtIcon
            :name="item.icon"
            :size="48"
            :color="active(item.path) ? theme.skin.accent : theme.skin.iconMuted"
          />
          <view v-if="hasDot(item.path)" class="tab-dot" />
        </view>
        <text
          class="tab-label"
          :style="('color:' + (active(item.path) ? theme.skin.accent : theme.skin.textMuted) + ';') + qtFont(22)"
        >{{ item.label }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed } from "vue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtSwitchTab } from "@/uni_modules/qt-ui/composables/qt-nav";
import { qtFont } from "@/uni_modules/qt-ui/stores/font-scale";

/**
 * 竖屏底部导航：悬浮胶囊（2026-10-19 起从通栏改为悬浮 pill，参照用户给的
 * 悬浮导航设计稿）：左右各一个入口「发现 / 我的」，中间不放发布按钮。
 *
 * 几何契约：离地 64rpx + 高 120rpx（合计 184rpx）+ 底部安全区（三键导航 /
 * 虚拟导航条，见 use-qt-layout.ts 的 safeBottomPx），总占位写进 use-qt-layout.ts
 * 的 QT_TAB_BAR_HEIGHT_RPX，由 qtTabBarHeightPx() 按窗口宽折算并叠加安全区
 * ——qt-toast-host 的让位、qt-mini-player 悬浮球的初始边距都按它取值，
 * 三处必须同源（tools/check-toast.mjs 断言 qtTabBarHeightPx() 被 toast-host
 * 使用、常量等于 184）。
 *
 * 2026-10-20 起这里的尺寸改用 rpx（设计 px × 2）而不是写死 px：本组件只在
 * `!layout.isWide` 的手机档渲染，而手机档整页内容都是 rpx（随窗口宽度线性放大）。
 * 写死 px 会让它在宽一点的窗口上「内容巨大、底部导航还是手机大小」，用户实测
 * 720dp 模拟器时原话就是「底部tag显示太小」。改成 rpx 后 375dp 手机上渲染结果
 * 与改动前完全一致（375/750 = 0.5，rpx 值 × 0.5 正好等于原 px 值），宽窗口上则
 * 跟着整页一起放大。
 *
 * 宽屏不渲染（rail 接管导航）；阴影不用 box-shadow（可点击容器在
 * uni-app x Android 上会点击穿透，见 design.md），靠 border 与
 * tabSurface 色差表达悬浮层次。
 */
const props = defineProps<{
  current: string;
  /** 需要亮红点的 tab 路径列表（不带前导斜杠，如 pages/profile/index） */
  dots?: string[];
}>();

const theme = useThemeStore();
const layout = useQtLayout();

type TabItem = { path: string; label: string; icon: string };
const tabs: TabItem[] = [
  { path: "pages/home/index", label: "发现", icon: "compass" },
  { path: "pages/profile/index", label: "我的", icon: "user" },
];

function active(path: string): boolean {
  return props.current == path;
}

/**
 * 离地高度（px）。两种形态，用户 2026-10-31 真机定稿：
 *
 * 1. **有系统导航栏（三键导航）**：qt-page-frame 的 padding-bottom 已经把内容
 *    容器整体抬到导航条上沿，绝对定位子节点锚的就是这个收短后的容器底边（安卓
 *    真机实测：容器 1440x3011、胶囊 76,2577-1364,2807）。所以三键机离地量必须
 *    收成 0 = 胶囊直接贴着导航条；再叠 64rpx 就会「太高」（用户 2026-10-31 实拍
 *    反馈：全面屏那档刚好、三键这档偏高）。
 *
 * 2. **全面屏手势 / 没有导航栏**：系统遮挡区=0（实测 raw=0、容器=全屏 3168），
 *    容器等于没被抬，离地量就纯粹是 TAB_BOTTOM_RPX。用户三轮口径：24rpx
 *    （≈2.4mm）贴底、100rpx（≈10mm）有点高，中间取 64rpx（≈6.7mm）用户确认
 *    「全面屏高度合适」。⚠️ 调这个值步子要大：24→40 只差 1.6mm 肉眼几乎无感。
 *
 * ⚠️ 历史的坑别再踩第二遍：2026-10-31 曾判定「按 safeBottomPx 做分支会翻车、
 * 手势档瞬时 inset>0 会把离地吃掉」，于是改成固定值——那是误判。真凶是 qtRpx()
 * 冷启动读到 windowWidth=0（日志 win=0x742）算出 0，computed 又永不重算，导致
 * 怎么调 rpx 都渲染成 bottom:0。分支逻辑本身是对的，见下面的 reactive 写法。
 */
const TAB_BOTTOM_RPX = 64;

/**
 * ⚠️ 这里必须依赖响应式的 layout.windowWidth，不能只靠 qtRpx()（它内部直读
 * uni.getWindowInfo()，非响应式）。vivo V2505A 实锤：冷启动首帧 getWindowInfo()
 * 返回 win=0x742（宽=0），qtRpx(64) 算出 0，而 computed 若只依赖 isWide（手机上
 * 恒 false）→ 宽度纠正后永不重算，bottom 永久 0 = 胶囊贴屏底。2026-10-31 用户
 * 连续三轮调 24/40/64rpx 全「没有任何效果」就是它（dumpsys：胶囊底边恰为屏高
 * 3168）。读一次 win 建立依赖，refreshQtLayout 把窗口宽改成 384 后本值必然重算出
 * 64rpx 真值。
 */
const bottomPx = computed((): number => {
  const win = layout.windowWidth;
  // 宽屏走常驻播放栏的几何，不吃手机档的导航条让位
  // 三键导航：容器已被 padding 抬到导航条上沿 → 离地 0（贴导航条）
  // 手势全屏：容器未被抬 → 固定 64rpx 离地
  const rpx = layout.isWide ? 24 : (layout.safeBottomPx > 0 ? 0 : TAB_BOTTOM_RPX);
  return rpx * (win / 750);
});

function hasDot(path: string): boolean {
  if (props.dots == null) return false;
  const bare = path.charAt(0) == "/" ? path.substring(1) : path;
  return props.dots.indexOf(bare) >= 0;
}

/**
 * 切换底部导航页：统一走 qtSwitchTab（鸿蒙 reLaunch / 其它平台 switchTab）。
 *
 * 2026-10-19 鸿蒙实测（这条坑值得留档）：`uni.switchTab` 与 `uni.reLaunch` 到 tab
 * 页都会回调 success、`getCurrentPages()` 栈顶也会变成目标路由，但原生视图停在
 * 原页不动 —— 因为两者最终都走 runtime 的 `switchSelect → tabBar0.appendItem`，
 * 而原生 Tabs 容器在追加第二个 tab 页时不生效。最终解法是 pages.json 在鸿蒙上
 * 不注册 tabBar（`#ifndef APP-HARMONY`），首页/我的退化成普通页面，`reLaunch`
 * 走普通页路由，实测可切换。
 */
function go(path: string): void {
  if (active(path)) return;
  qtSwitchTab("/" + path);
}

</script>

<style>
.tab-bar {
  /* 必须 absolute 而不是 fixed（2026-10-25 真机白胶囊实锤）：layout 单例初始值是
     375x667（compact），宽屏设备冷启动头几帧本组件会先按 !isWide 挂载，等尺寸
     纠正后 v-if 拆除 —— 而 position:fixed 节点在这台设备的 Vapor 上有「挂载后
     拆不掉」的漏显隐实锤（同 fe479af 宽屏 rail 漏红案），残留一条放大版的白胶囊
     压在内容上。absolute 锚定到页面根（容器均无定位上下文），视觉与 fixed 一致，
     且非 fixed 节点的 v-if 拆除在全仓都是可靠的。 */
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  /* 离地值走内联 style（bottomPx = 固定 64rpx）：容器由 page-frame 的
     padding-bottom 让到系统遮挡区上沿，所以三键机的虚拟导航条不会盖住胶囊
     下半截；手势机则纯粹是这 64rpx 的离地量。 */
  height: 120rpx;
  /* 总占位 = 64rpx 离地 + 120rpx 高 = 184rpx（375dp 基准下 = 92px），与
     use-qt-layout.ts 的 QT_TAB_BAR_HEIGHT_RPX 保持一致（toast 让位、悬浮球初始边距都按它算；
     2026-10-29 起非全面屏再叠加 safeBottomPx，见 use-qt-layout.ts） */
  flex-direction: row;
  align-items: center;
  border-radius: 60rpx;
  border-width: 1px;
  border-style: solid;
}
.tab-item {
  flex: 1;
  height: 120rpx;
  justify-content: center;
  align-items: center;
}
/* 当前项的圆角 chip：图标与文字一起包进 accentSoft（参照设计稿的高亮胶囊） */
.tab-chip {
  flex-direction: column;
  align-items: center;
  padding: 10rpx 40rpx;
  border-radius: 40rpx;
}
.tab-icon-wrap {
  position: relative;
  width: 56rpx;
  height: 52rpx;
  justify-content: center;
  align-items: center;
}
.tab-dot {
  position: absolute;
  top: -4rpx;
  right: -8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background-color: #ff4b4b;
}
.tab-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
}
</style>
