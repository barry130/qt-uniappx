<template>
  <view
    v-if="player.current != null && !layout.isTv && (settings.mode != 'docked' || !layout.isWide) && sheetHidden"
    class="mini-player-host"
    :style="hostStyle"
  >
    <view
      class="fab-right"
      :class="showStrip ? (layout.isWide ? 'mini-player-wide' : 'mini-player') : (layout.isWide ? 'fab-right-wide' : '')"
      :style="containerStyle"
      @touchstart="onTouchStart"
      @touchmove="onTouchMove"
      @touchend="onTouchEnd"
      @touchcancel="onTouchEnd"
      @click.stop="onContainerClick"
    >
    <view
      v-if="!showStrip"
      class="fab-inner"
      :class="layout.isWide ? 'fab-inner-wide' : ''"
      :style="fabSizeStyle + 'background-color:' + theme.skin.mediaSurface + ';border-color:' + theme.skin.mediaBorder + ';'"
    >
      <view class="fab-cover-spin" :class="layout.isWide ? 'fab-cover-spin-wide' : ''" :style="fabSizeStyle + discStyle">
        <image class="fab-cover" :class="layout.isWide ? 'fab-cover-wide' : ''" :style="fabSizeStyle + 'background-color:' + theme.skin.coverPlaceholder + ';'" :src="currentCover()" mode="aspectFill" @error="onCoverError" />
      </view>
      <view
        class="fab-state"
        :class="layout.isWide ? 'fab-state-wide' : ''"
        :style="fabStateStyle + 'background-color:' + (player.playing ? theme.skin.mediaControl : theme.skin.mediaScrim) + ';'"
        @click.stop="onBallStateClick"
      >
        <QtIcon :name="player.playing ? 'pause' : 'play'" :size="layout.isWide ? 20 : 26" :color="theme.skin.mediaText" />
      </view>
    </view>

    <view
      v-else
      class="mini-player-inner"
      :class="isDocked ? 'mini-player-inner-docked' : (layout.isWide ? 'mini-player-inner-wide' : '')"
      :style="stripStyle"
    >
      <view class="mini-cover-wrap" :class="isDocked ? 'mini-cover-wrap-docked' : (layout.isWide ? 'mini-cover-wrap-wide' : '')" :style="coverSizeStyle + discStyle">
        <image v-if="currentCover().length > 0" class="mini-cover" :class="isDocked ? 'mini-cover-docked' : (layout.isWide ? 'mini-cover-wide' : '')" :style="coverSizeStyle + 'background-color:' + theme.skin.coverPlaceholder + ';'" :src="currentCover()" mode="aspectFill" @error="onCoverError" />
        <view v-else class="mini-cover-fallback" :style="'background-color:' + theme.skin.accentSoft + ';'"><QtIcon name="music" :size="layout.isWide ? 22 : 36" :color="theme.skin.accent" /></view>
      </view>
      <view class="mini-copy" :class="layout.isWide ? 'mini-copy-wide' : ''" :style="copyHeightStyle">
        <!-- 用户 2026-11-14：迷你条歌名改单行跑马灯（长名滚动看全）；字号/行高沿用原 miniTitleStyle 口径，页面隐藏时由 active 关停。 -->
        <QtMarquee
          class="mini-title"
          :text="currentName()"
          :size-rpx="isDocked ? 26 : 27"
          :size-px="14"
          :weight="600"
          :color="theme.skin.text"
          :width-px="miniTitleWidthPx"
          :line-height-px="miniTitleLinePx"
          :active="pageVisible"
        />
        <text class="mini-artist" :class="layout.isWide ? 'mini-artist-wide' : ''" :style="miniArtistStyle" :max-lines="1">{{ currentArtist() }}</text>
      </view>
      <view v-if="isDocked" class="mini-action mini-action-docked" :style="actionSizeStyle" @click.stop="previousTrack">
        <QtIcon name="skip-back" :size="32" :color="theme.skin.text" />
      </view>
      <view
        class="mini-action"
        :class="isDocked ? 'mini-action-docked' : (layout.isWide ? 'mini-action-wide' : '')"
        :style="toggleSizeStyle + 'background-color:' + (isDocked ? theme.skin.accent : theme.skin.surfaceMuted) + ';'"
        @click.stop="togglePlayback"
      >
        <QtIcon :name="player.playing ? 'pause' : 'play'" :size="layout.isWide ? 18 : 24" :color="isDocked ? theme.skin.onAccent : theme.skin.text" />
      </view>
      <view
        class="mini-action"
        :class="isDocked ? 'mini-action-docked' : (layout.isWide ? 'mini-action-wide' : '')"
        :style="actionSizeStyle + 'background-color:' + (isDocked ? 'transparent' : theme.skin.surfaceMuted) + ';'"
        @click.stop="nextTrack"
      >
        <QtIcon name="skip-forward" :size="layout.isWide ? 18 : (isDocked ? 32 : 24)" :color="theme.skin.text" />
      </view>
      <view
        class="mini-progress-track"
        :class="isDocked ? 'mini-progress-track-docked' : (layout.isWide ? 'mini-progress-track-wide' : '')"
        :style="progressTrackStyle"
      >
        <view
          class="mini-progress-fill"
          :class="isDocked ? 'mini-progress-fill-docked' : (layout.isWide ? 'mini-progress-fill-wide' : '')"
          :style="progressStyle"
        ></view>
      </view>
    </view>
  </view>
  </view>
</template>

<script setup lang="ts">
import { computed, ref, watch, onMounted, onUnmounted } from "vue";
import { onShow, onHide } from "@dcloudio/uni-app";
import { usePlayerStore } from "@/stores/player";
import { useQtLayout, qtRailWidth } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtMarquee from "@/uni_modules/qt-ui/components/qt-marquee/qt-marquee.uvue";
import {
  miniFabX,
  miniFabY,
  miniExpanded,
  miniEdgeSide,
  miniEdgeAnimating,
  miniRenderWidth,
  miniRenderHeight,
  miniRotateDeg,
  miniCurrentWidth,
  miniCurrentHeight,
  miniPlayerMount,
  miniPlayerUnmount,
  miniPlayerSetPlaying,
  miniPlayerSetVisible,
  ensureMiniPositioned,
  miniSyncRenderSize,
  miniSnapToNearestEdge,
  miniExpandFromFab,
  miniCollapse,
} from "@/uni_modules/qt-ui/services/mini-player-singleton";
import { qtFontDualPx, fontScale } from "@/uni_modules/qt-ui/stores/font-scale";
import { useMiniPlayerSettings } from "@/uni_modules/qt-ui/stores/mini-player";
import { qtRpx } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtMiniDockTopPx, qtMiniDockBarHeightPx } from "@/uni_modules/qt-ui/composables/mini-player-layout";
import { qtSheetOverlayCount } from "@/uni_modules/qt-ui/stores/sheet-visibility";

const props = defineProps<{ aboveTab?: boolean }>();
const settings = useMiniPlayerSettings();
const isDocked = computed((): boolean => settings.mode == "docked");
/**
 * 底部弹层（QtSheet 家族）打开期间整条隐藏：本组件渲染在框架层，z 序在页面内容
 * 之上，不藏会浮在弹窗上（sheet-visibility.ts 记录计数）。dock 预留与 tab 栏
 * 不动，弹层遮罩盖在其后即可。
 */
const sheetHidden = computed((): boolean => qtSheetOverlayCount().value == 0);
const joinedDock = computed((): boolean => isDocked.value && props.aboveTab == true);
const showStrip = computed((): boolean => isDocked.value || settings.mode == "bar" || miniExpanded.value);
const renderWidth = computed((): number => isDocked.value ? layout.paneWidth - qtRpx(48) : miniRenderWidth.value);
const renderHeight = computed((): number => isDocked.value ? qtMiniDockBarHeightPx() : miniRenderHeight.value);
// Native nodes can retain their page's old rpx basis after a wide/compact switch.
// Bind the shared window's current pixel sizes for every persistent mini shape.
const stripStyle = computed((): string => {
  const left = isDocked.value ? qtRpx(20) : layout.isWide ? 8 : qtRpx(16);
  const right = isDocked.value ? qtRpx(16) : layout.isWide ? 7 : qtRpx(14);
  const radius = isDocked.value ? qtRpx(28) : renderHeight.value / 2;
  const corners = joinedDock.value ? radius + "px " + radius + "px 0 0" : radius + "px";
  return "width:" + renderWidth.value + "px;height:" + renderHeight.value + "px;padding-left:" + left + "px;padding-right:" + right + "px;border-radius:" + corners + ";background-color:" + (joinedDock.value ? "transparent" : theme.skin.surface) + ";border-color:" + theme.skin.border + ";" + (joinedDock.value ? "border-width:0;" : "");
});
const copyHeightStyle = computed((): string => {
  const height = layout.isWide ? Math.max(42, 37 * fontScale.scale) : qtRpx(isDocked.value ? 60 * fontScale.scale : Math.max(72, 68 * fontScale.scale));
  return "height:" + height + "px;padding-left:" + (layout.isWide ? 10 : qtRpx(16)) + "px;padding-right:" + (layout.isWide ? 6 : qtRpx(12)) + "px;";
});
const coverSizeStyle = computed((): string => {
  const size = isDocked.value ? qtRpx(76) : layout.isWide ? 42 : qtRpx(80);
  const radius = isDocked.value ? qtRpx(16) : size / 2;
  return "width:" + size + "px;height:" + size + "px;border-radius:" + radius + "px;";
});
const actionSizeStyle = computed((): string => {
  const size = isDocked.value ? 44 : layout.isWide ? 34 : qtRpx(64);
  const margin = isDocked.value ? 2 : layout.isWide ? 5 : qtRpx(8);
  return "width:" + size + "px;height:" + size + "px;border-radius:" + size / 2 + "px;margin-left:" + margin + "px;";
});
/** 播放/暂停主键：停靠条的红色圆比上一曲/下一曲小一圈（2026-11-13 用户反馈太大）。 */
const toggleSizeStyle = computed((): string => {
  if (!isDocked.value) return actionSizeStyle.value;
  const size = 36;
  const margin = 2;
  return "width:" + size + "px;height:" + size + "px;border-radius:" + size / 2 + "px;margin-left:" + margin + "px;";
});
const fabSizeStyle = computed((): string => {
  const size = layout.isWide ? 72 : qtRpx(120);
  return "width:" + size + "px;height:" + size + "px;border-radius:" + size / 2 + "px;";
});
const fabStateStyle = computed((): string => {
  const size = layout.isWide ? 34 : qtRpx(56);
  return "width:" + size + "px;height:" + size + "px;border-radius:" + size / 2 + "px 0 " + size / 2 + "px 0;";
});

/**
 * 歌名跑马灯（2026-11-14 用户批准）：字号跟全局缩放，行高沿用原 miniTitleStyle 口径
 * （窄 38rpx/停靠 34rpx、宽 20px，乘 scale），避免组件默认 1.4×+4 行高把 72rpx 双行小列顶爆。
 */
const miniTitleLinePx = computed((): number =>
  layout.isWide ? Math.round(20 * fontScale.scale * 100) / 100 : qtRpx((isDocked.value ? 34 : 38) * fontScale.scale)
);
/** 跑马灯宽度上限 = 条宽 − 两侧内边距 − 封面 − 文案列内边距 − 三个按键（含左边距）；实际以实测视口为准。 */
const miniTitleWidthPx = computed((): number => {
  const padL = isDocked.value ? qtRpx(20) : layout.isWide ? 8 : qtRpx(16);
  const padR = isDocked.value ? qtRpx(16) : layout.isWide ? 7 : qtRpx(14);
  const cover = isDocked.value ? qtRpx(76) : layout.isWide ? 42 : qtRpx(80);
  const copyL = layout.isWide ? 10 : qtRpx(16);
  const copyR = layout.isWide ? 6 : qtRpx(12);
  const toggle = isDocked.value ? 38 : layout.isWide ? 34 + 5 : qtRpx(64) + qtRpx(8);
  const next = isDocked.value ? 46 : layout.isWide ? 34 + 5 : qtRpx(64) + qtRpx(8);
  const prev = isDocked.value ? 46 : 0;
  return Math.max(0, renderWidth.value - padL - padR - cover - copyL - copyR - toggle - next - prev);
});
const miniArtistStyle = computed((): string => {
  const s = fontScale.scale;
  const line = layout.isWide
    ? "line-height:" + Math.round(17 * s * 100) / 100 + "px;"
    : "line-height:" + qtRpx((isDocked.value ? 26 : 30) * s) + "px;";
  return ("color:" + theme.skin.textMuted + ";") + qtFontDualPx(qtRpx(isDocked.value ? 20 : 22), 12) + line;
});

/**
 * 四模式迷你播放器（宽窄屏共享偏好与位置）。
 *
 * 2026-10-24 改造：本组件在**每个页面**的 qt-page-frame 里都挂一份，但全部
 * 实例渲染 mini-player-singleton.ts 里的同一份共享状态（位置/展开/吸附侧/
 * 渲染尺寸/旋转角）。不再有「显示权注册 + 栈顶路由轮询」的交接协议 ——
 * 页面进出时的闪烁正是那个协议造成的（出栈页卸载后球才补挂、切 Tab 靠
 * 轮询补挂，中间是几百毫秒的空洞）。现在：
 *   - 页面栈里被盖住的实例本来就在下层窗口里，看不到，无需隐藏；
 *   - 转场动画期间新旧两页各有一个像素级一致的球，随页面一起运动，
 *     视觉上就是同一个球；
 *   - 第 2 个页面起没有初始化阶段，球出现即在正确位置。
 * 平台教训仍适用：宿主 fixed + 子级 absolute（鸿蒙 fixed 嵌 fixed 命中失效）、
 * 首帧窗口尺寸不可信（初始化重试 + 落盘护栏，全在 store 里）。
 */

const player = usePlayerStore();
const layout = useQtLayout();
const theme = useThemeStore();
const pageVisible = ref(true);
const failedCover = ref("");
let lastRotation = 0;

const progressRatio = computed((): number => {
  const duration = player.duration;
  if (duration <= 0) return 0;
  return Math.max(0, Math.min(1, player.progress / duration));
});
const progressRailSizeStyle = computed((): string => {
  const height = isDocked.value ? qtRpx(2) : layout.isWide ? 2 : qtRpx(4);
  return "height:" + height + "px;border-radius:" + (isDocked.value ? 0 : height / 2) + "px;";
});
const progressTrackStyle = computed((): string => {
  const left = isDocked.value ? qtRpx(20) : layout.isWide ? 50 : qtRpx(84);
  const right = isDocked.value ? qtRpx(20) : layout.isWide ? 78 : qtRpx(156);
  const bottom = isDocked.value ? (joinedDock.value ? 0 : qtRpx(8)) : layout.isWide ? 4 : qtRpx(7);
  return progressRailSizeStyle.value + "left:" + left + "px;right:" + right + "px;bottom:" + bottom + "px;background-color:" + theme.skin.divider + ";";
});
const progressStyle = computed((): string => progressRailSizeStyle.value + "width:" + Math.round(progressRatio.value * 100) + "%;background-color:" + theme.skin.accent + ";");

const hostStyle = computed((): string => {
  if (isDocked.value) return "left:" + (qtRpx(24) + layout.paneLeft) + "px;top:" + (layout.paneTop + qtMiniDockTopPx(props.aboveTab == true)) + "px;right:auto;bottom:auto;width:" + renderWidth.value + "px;height:" + renderHeight.value + "px;";
  // 宿主始终只覆盖球或展开条本身；展开时不能铺满窗口，否则会截获页面滚动。
  return "left:" + (miniFabX.value + layout.paneLeft) + "px;top:" + (miniFabY.value + layout.paneTop) + "px;right:auto;bottom:auto;width:" + miniRenderWidth.value + "px;height:" + miniRenderHeight.value + "px;pointer-events:auto;";
});

const containerStyle = computed((): string => {
  const width = renderWidth.value;
  const height = renderHeight.value;
  const radius = isDocked.value ? qtRpx(28) : height / 2;
  const transition = !isDocked.value && miniEdgeAnimating.value
    ? "transition: left 0.22s ease-out, top 0.22s ease-out, width 0.22s ease-out, height 0.22s ease-out, border-radius 0.22s ease-out;"
    : "";
  // 子级用 absolute 铺满宿主（宿主已经 fixed 并带 left/top），这里不能再写 left/top，
  // 否则会在宿主偏移之上再偏移一次，命中测试区域与视觉错位（鸿蒙上表现为点不到）。
  const corners = joinedDock.value ? "border-radius:" + radius + "px " + radius + "px 0 0;" : "border-radius:" + radius + "px;";
  return "left:0;top:0;width:" + width + "px;height:" + height + "px;" + corners + transition;
});

const discStyle = computed((): string => {
  // Reset the native transform even on covered pages when entering the fixed bar.
  if (settings.mode == "docked") return "transform: rotate(0deg);";
  // Covered pages keep their last frame without subscribing to every animation tick.
  if (pageVisible.value) lastRotation = miniRotateDeg.value;
  return "transform: rotate(" + lastRotation + "deg);";
});

let startX = 0;
let startY = 0;
let origX = 0;
let origY = 0;
let dragging = false;
let moved = false;

watch(() => settings.mode, () => {
  dragging = false;
  moved = false;
});

function onTouchStart(event: UniTouchEvent): void {
  moved = false;
  if (isDocked.value) return;
  const touch = event.touches[0];
  startX = touch.clientX;
  startY = touch.clientY;
  origX = miniFabX.value;
  origY = miniFabY.value;
  dragging = true;
  moved = false;
}

function onTouchMove(event: UniTouchEvent): void {
  if (!dragging) return;
  const touch = event.touches[0];
  const dx = touch.clientX - startX;
  const dy = touch.clientY - startY;
  // 超过阈值视为拖动，避免误判为点击
  if (!moved && (Math.abs(dx) > 10 || Math.abs(dy) > 10)) {
    moved = true;
  }
  if (!moved) return;
  const minX = layout.isWide ? qtRailWidth() + 8 : 0;
  let nx = origX + dx;
  let ny = origY + dy;
  nx = Math.max(minX, Math.min(nx, layout.paneWidth - miniCurrentWidth.value));
  ny = Math.max(0, Math.min(ny, layout.paneHeight - layout.safeBottomPx - miniCurrentHeight.value));
  miniFabX.value = nx;
  miniFabY.value = ny;
}

function onTouchEnd(): void {
  if (!dragging) return;
  dragging = false;
  // 拖动结束后吸附最近一侧并落盘（store 内部处理动画与持久化）
  if (moved) {
    miniSnapToNearestEdge();
  }
}

function onContainerClick(): void {
  if (moved) {
    moved = false;
    return;
  }
  if (settings.mode == "expandable" && !miniExpanded.value) {
    // 展开前先吸附到最近一侧；播放条从该侧向内容区展开（store 处理动画起点）
    miniExpandFromFab();
    return;
  }
  openPlayer();
}

function onBallStateClick(): void {
  if (settings.mode == "ball") { onContainerClick(); return; }
  togglePlayback();
}

function togglePlayback(): void {
  if (moved) { moved = false; return; }
  player.toggle();
}

function nextTrack(): void {
  if (moved) { moved = false; return; }
  player.next(false);
}

function previousTrack(): void {
  if (moved) { moved = false; return; }
  player.previous();
}

function currentName(): string {
  const current = player.current;
  return current != null ? current.name : "正在播放";
}

function currentArtist(): string {
  const current = player.current;
  return current != null ? current.singer : "";
}

/** 打开播放页；若为拖动手势则忽略点击 */
function openPlayer(): void {
  // 先收起（共享状态幂等）：球回到当前吸附侧，右侧展开条不留悬空位置
  miniCollapse();
  if (moved) {
    moved = false;
    return;
  }
  // 栈顶已是播放页时不再 push：本组件被所有页面引用，页面上没有「已在播放页」的守卫，
  // 连点悬浮球会堆叠出多个播放页实例 —— 每个实例各自 ensureLyric 取一遍歌词、
  // 各起一套定时器与逐字 rAF。返回键本来就能回到已有实例，无需再叠一层。
  try {
    const pages = getCurrentPages();
    if (pages.length > 0) {
      const top = pages[pages.length - 1];
      const route = top.route;
      if (route != null && route == "pages/player/index") return;
    }
  } catch (_) {
    // 静默：页面栈读不出直接导航，最多多开一层播放页
  }
  uni.navigateTo({ url: "/pages/player/index" });
}

function currentCover(): string {
  const current = player.current;
  // 在播本地文件有内嵌封面就用它（coverOf 内部回落到 song.picUrl）
  const cover = current != null ? player.coverOf(current) : "";
  return cover == failedCover.value ? "" : cover;
}

function onCoverError(): void {
  const current = player.current;
  const src = currentCover();
  failedCover.value = src;
  if (current != null && src.length > 0) player.recoverCover(current, src);
}
watch(() => player.current, () => { failedCover.value = ""; });
watch(() => player.current != null ? player.coverOf(player.current) : "", () => { failedCover.value = ""; });

function onOutsideClick(): void {
  miniCollapse();
}

let mountId = 0;
onShow(() => {
  pageVisible.value = true;
  miniPlayerSetVisible(mountId, player.current != null);
});
onHide(() => {
  pageVisible.value = false;
  miniPlayerSetVisible(mountId, false);
});
onMounted(() => {
  // 登记渲染实例（旋转 rAF 的引用计数）+ 确保共享状态已初始化（幂等，
  // 只有全站第一次挂载才会真正初始化，后续页面零延迟直接渲染）
  mountId = miniPlayerMount(pageVisible.value && player.current != null);
  miniPlayerSetPlaying(player.playing);
  if (miniRenderWidth.value <= 0) miniSyncRenderSize();
  ensureMiniPositioned();
  uni.$on("qt-mini-player-outside-click", onOutsideClick);
});

watch(() => player.playing, (playing) => {
  miniPlayerSetPlaying(playing);
});

watch(() => player.current != null, (hasSong) => {
  miniPlayerSetVisible(mountId, pageVisible.value && hasSong);
});

onUnmounted(() => {
  uni.$off("qt-mini-player-outside-click", onOutsideClick);
  miniPlayerUnmount(mountId);
});
</script>

<style>
.mini-player-host {
  /* absolute 而不是 fixed（2026-10-25）：host 按 left/top 显式定位，页面根就是窗口，
     坐标语义不变；但 fixed 节点在真机 Vapor 上有「挂载后 v-if 拆不掉」的漏显隐实锤
     （宽屏 tab-bar 白胶囊案、fe479af rail 漏红案）—— 窄屏挂了球之后转宽屏，
     !isWide 的 v-if 拆不掉就会残留一颗悬浮球。 */
  position: absolute;
  z-index: 998;
  pointer-events: auto;
}
.fab-right {
  /* 必须用 absolute 而不是 fixed：鸿蒙（uni-app x）上 fixed 宿主里的 fixed 子节点
     命中测试会失效，触摸直接穿透到下层页面（2026-10-19 真机实证：点悬浮球完全没反应，
     同一位置的榜单行反而被点开）。宿主 .mini-player-host 已经是 fixed 且按 left/top
     定位，子级用 absolute 铺满宿主即可，视觉与交互在四端一致。 */
  position: absolute;
  left: 0;
  top: 0;
  z-index: 998;
  pointer-events: auto;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
}
.fab-inner {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  justify-content: center;
  align-items: center;
  /* shadow removed: Android 点击穿透（见 ui-review.md P0-1） */
  overflow: hidden;
  border-width: 2rpx; border-style: solid;
}
/* 旋转放在外层容器上，比 image 组件更稳定地支持 transform */
.fab-cover-spin {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  transform-origin: center;
  overflow: hidden;
}
.fab-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
}
.fab-state {
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  right: 0;
  bottom: 0;
  border-radius: 28rpx 0 28rpx 0;
  justify-content: center;
  align-items: center;
}

