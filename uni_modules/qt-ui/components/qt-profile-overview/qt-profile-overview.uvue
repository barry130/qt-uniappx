.tiles-pane { margin-top: 10px; margin-left: 0; margin-right: 0; padding: 12px 0 10px; border-radius: 12px; }
.tile-icon-pane { width: 36px; height: 36px; border-radius: 12px; }
.group-pane { margin-top: 10px; margin-left: 0; margin-right: 0; border-radius: 12px; }
.cell-pane { height: 52px; padding-left: 14px; padding-right: 14px; }
.cell-icon-pane { margin-right: 10px; }
</style>
