<template>
  <view v-if="visible" class="qs-mask qt-tv-skip" :class="layout.isWide ? 'qs-mask-wide' : ''" :style="maskStyle" @click="close">
    <view ref="tvPanel" class="qs-panel qt-tv-skip" :class="layout.isWide ? 'qs-panel-wide' : ''" :style="panelStyle" @click.stop>
      <view v-if="title.length > 0" class="qs-header" :class="layout.isWide ? 'qs-header-wide' : ''" :style="'border-bottom-color:' + theme.skin.divider + ';'">
        <view class="qs-heading">
          <text class="qs-title" :class="layout.isWide ? 'qs-title-wide' : ''" :style="'color:' + theme.skin.text + ';' + qtFontDual(30, 16) + (layout.isTv ? 'line-height:' + Math.ceil(qtFontValuePx(16) * 1.35) + 'px;' : '')">{{ title }}</text>
          <text v-if="subtitle.length > 0" class="qs-subtitle" :class="layout.isWide ? 'qs-subtitle-wide' : ''" :style="'color:' + theme.skin.textMuted + ';' + qtFontDual(23, 12) + (layout.isTv ? 'line-height:' + Math.ceil(qtFontValuePx(12) * 1.4) + 'px;' : '')">{{ subtitle }}</text>
        </view>
        <view v-if="dismissible" class="qs-close" :class="layout.isWide ? 'qs-close-wide' : ''" data-qt-tv-id="sheet-close" :style="layout.isTv ? 'width:56px;height:56px;margin-left:12px;' : ''" @click="close"><QtIcon name="close" :size="layout.isWide ? 18 : 28" :color="theme.skin.iconMuted" /></view>
      </view>
      <view class="qs-body"><slot></slot></view>
      <view class="qs-footer" :class="layout.isWide ? 'qs-footer-wide' : ''"><slot name="footer"></slot></view>
    </view>
  </view>
</template>
<script setup lang="ts">
import { computed, watch, onUnmounted, inject, ref } from "vue";
import { useQtTvModal } from "@/uni_modules/qt-ui/composables/use-qt-tv-modal";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import { useQtLayout, qtFixedPaneStyle } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtSheetWidth } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { qtFontDual, qtFontValuePx } from "@/uni_modules/qt-ui/stores/font-scale";
import { qtSheetOverlayOpen, qtSheetOverlayClose } from "@/uni_modules/qt-ui/stores/sheet-visibility";
const props = withDefaults(defineProps<{ visible: boolean; title?: string; subtitle?: string; dismissible?: boolean; footerFlush?: boolean }>(), { title: "", subtitle: "", dismissible: true, footerFlush: false });
const emit = defineEmits<{ "update:visible": [value: boolean]; close: [] }>();
const layout = useQtLayout();
const theme = useThemeStore();
const tvPanel = ref<UniElement | null>(null);
useQtTvModal(tvPanel, (): boolean => props.visible, close);
const inWorkspace = inject<boolean>("qt-sheet-in-workspace", false);
const maskStyle = computed((): string => {
  const background = "background-color:" + theme.skin.scrim + ";";
  // 普通手机页内容被播放栏预留缩短，蒙层须锚定完整 pane，不能跟着内容底边抬高。
  // 宽屏/托管实例保持 absolute；不逃出覆盖层，也不改变列表 viewport 和滚动位置。
  if (layout.isWide || inWorkspace) return background;
  return "position:fixed;" + qtFixedPaneStyle() + background;
});
// 底部弹层打开期间框架层迷你播放栏整体隐藏（qt-mini-player 读这个计数）。
// 防重入：同一次打开只登记一次；宿主带着 open 状态卸载时也要注销，避免计数泄漏。
let overlayRegistered = false;
watch((): boolean => props.visible, (open: boolean): void => {
  if (open && !overlayRegistered) {
    overlayRegistered = true;
    qtSheetOverlayOpen();
  } else if (!open && overlayRegistered) {
    overlayRegistered = false;
    qtSheetOverlayClose();
  }
}, { immediate: true });
onUnmounted((): void => {
  if (overlayRegistered) {
    overlayRegistered = false;
    qtSheetOverlayClose();
  }
});
const panelStyle = computed((): string => {
  const width = layout.isWide ? qtSheetWidth("drawer") : layout.paneWidth;
  const bottom = layout.isWide ? 12 : Math.max(8 * layout.windowWidth / 750, layout.safeBottomPx);
  // 用户 2026-11-13：带底部动作条的弹层不再在取消键下留一整行空白（安全区改由 footer 自己垫满）。
  return "width:" + width + "px;max-height:" + Math.max(0, layout.paneHeight * 0.86 - layout.safeBottomPx) + "px;background-color:" + theme.skin.sheetSurface + ";padding-bottom:" + (props.footerFlush ? 0 : bottom) + "px;";
});
function close(): void { if (!props.dismissible) return; emit("update:visible", false); emit("close"); }
</script>
<style>
/* One window-sized ancestor; never mount this inside a tiny trigger node. */
.qs-mask { position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: flex-end; z-index: 999; }
.qs-mask-wide { justify-content: center; align-items: center; }
.qs-panel { border-radius: 32rpx 32rpx 0 0; overflow: hidden; }
.qs-panel-wide { border-radius: 16px; }
.qs-header { flex-direction: row; align-items: center; padding: 24rpx 32rpx; border-bottom-width: 1rpx; border-bottom-style: solid; flex-shrink: 0; }
.qs-header-wide { padding: 14px 20px; border-bottom-width: 1px; }
.qs-heading { flex: 1; min-width: 0; }
.qs-title { font-size: 30rpx; font-weight: 600; }
.qs-title-wide { font-size: 16px; }
.qs-subtitle { font-size: 23rpx; margin-top: 6rpx; }
.qs-subtitle-wide { font-size: 12px; margin-top: 3px; }
.qs-close { width: 64rpx; height: 64rpx; margin-left: 16rpx; align-items: center; justify-content: center; }
.qs-close-wide { width: 36px; height: 36px; margin-left: 10px; }
.qs-body { min-height: 0; flex-shrink: 1; }
.qs-footer { flex-shrink: 0; }
.qs-footer-wide { flex-shrink: 0; }
</style>
