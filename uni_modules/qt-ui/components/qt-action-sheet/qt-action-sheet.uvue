<template>
  <view v-show="visible" class="as-mask" :class="layout.isWide ? 'as-mask-wide' : ''" :style="'background-color:' + theme.skin.scrim + ';'" @click="close">
    <view class="as-sheet" :class="layout.isWide ? 'as-sheet-wide' : ''" :style="sheetStyle" @click.stop>
      <view v-if="title.length > 0" class="as-title" :class="layout.isWide ? 'as-title-wide' : ''" :style="'border-bottom-color:' + theme.skin.divider + ';'">
        <text class="as-title-text" :class="layout.isWide ? 'as-title-text-wide' : ''" :style="('color:' + theme.skin.textSubtle + ';') + qtFontDual(24, 13)">{{ title }}</text>
      </view>
      <scroll-view
        class="as-list"
        :class="layout.isWide ? 'as-list-wide' : ''"
        direction="vertical"
        :show-scrollbar="false"
        :scroll-into-view="scrollAnchor"
        @click.stop
      >
        <view
          v-for="(action, index) in actions"
          :key="index"
          :id="'as-item-' + index"
          class="as-item"
          :class="[action.disabled ? 'as-item-disabled' : '', layout.isWide ? 'as-item-wide' : '']"
          :style="'border-bottom-color:' + theme.skin.divider + ';'"
          @click="pick(index)"
        >
          <text
            class="as-item-text"
            :class="layout.isWide ? 'as-item-text-wide' : ''"
            :style="('color:' + actionColor(action) + ';') + qtFontDual(29, 15)"
            >{{ action.name }}</text
          >
        </view>
      </scroll-view>
      <view class="as-cancel" :class="layout.isWide ? 'as-cancel-wide' : ''" :style="'background-color:' + theme.skin.surfaceMuted + ';'" @click="close">
        <text class="as-cancel-text" :class="layout.isWide ? 'as-cancel-text-wide' : ''" :style="('color:' + theme.skin.textSubtle + ';') + qtFontDual(29, 15)">取消</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { computed, nextTick, ref, watch } from "vue";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtSheetWidth } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";

export type SheetAction = {
  name: string;
  color?: string;
  disabled?: boolean;
};

const layout = useQtLayout();
const theme = useThemeStore();
const props = defineProps<{
  visible: boolean;
  title?: string;
  actions: SheetAction[];
  /** 当前选中项下标（-1 = 无选中）。打开时若它在折叠区外，列表自动滚到它。 */
  selectedIndex?: number;
}>();
const emit = defineEmits<{
  "update:visible": [value: boolean];
  select: [action: SheetAction, index: number];
  close: [];
}>();
const title = computed((): string => props.title != null ? props.title! : "");

// 动作项文字颜色：自定义色优先，缺省退主题文字色。守卫收进脚本——模板里 &&
// 不保证短路（两边都求值），color 为 undefined 时内联读 action.color.length 会炸
function actionColor(action: SheetAction): string {
  if (action.color != null && action.color.length > 0) return action.color;
  return theme.skin.text;
}

/**
 * 打开弹窗时把选中项滚进视口：列表上限停在「半行」，选中项一旦在折叠区里
 * 用户既看不到高亮也想不到下面还能滑，所以打开瞬间用 scroll-into-view 定位。
 * 只在选中项超出整行视口时才滚（前几项时把选中行顶到顶部反而显得跳）。
 */
const scrollAnchor = ref("");
const selectedIdx = computed((): number => props.selectedIndex != null ? props.selectedIndex! : -1);
watch(() => props.visible, (v: boolean) => {
  if (!v) {
    scrollAnchor.value = "";
    return;
  }
  const idx = selectedIdx.value;
  if (idx < 0) return;
  // 整行视口数 = max-height ÷ 行高 向下取整（窄屏 572rpx/104rpx，宽屏 494px/52px）
  const fullRows = layout.isWide ? 9 : 5;
  if (idx <= fullRows) return;
  const target = "as-item-" + idx;
  nextTick(() => {
    scrollAnchor.value = target;
  });
});

/**
 * 抽屉宽度走统一契约（use-qt-widths 的 QT_SHEET_WIDTH.drawer = 420），
 * 宽屏下还要夹到窗口内（窄窗口 420 会顶到 rail 或窗口边缘）。
 * 高度/圆角仍由 .as-sheet-wide 管，这里只补宽度与底色。
 */
const sheetStyle = computed((): string => {
  let style = "background-color:" + theme.skin.sheetSurface + ";";
  if (layout.isWide) {
    const w = qtSheetWidth("drawer");
    style += "width:" + w + "px;";
  }
  return style;
});

function close(): void {
  emit("update:visible", false);
  emit("close");
}
function pick(index: number): void {
  const action = props.actions[index];
  if (action == null || action.disabled) return;
  emit("update:visible", false);
  emit("select", action, index);
}
</script>

<style>
/*
 * 必须 absolute 而不是 fixed（2026-10-25 真机实锤：宽屏托管「每日新歌」里点歌曲
 * 操作没反应，切到「我的」后弹层反而漏在那页上）。Vapor 把 fixed 节点提升到窗口层
 * 参与 z 序：托管时蒙层(z999) 被覆盖层(z1000、不透明) 压住 → 看不见；而覆盖层
 * visibility:hidden 又管不到提升到窗口层的 fixed 后代 → 切 tab 后漏在别的页上。
 * absolute 锚到最近定位祖先（qt-page-frame 根，position:relative；普通页与托管 pane
 * 的原点都是窗口原点），四边全屏视觉与 fixed 一致，且随所在页面子树一起显隐。
 */
.as-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  justify-content: flex-end;
  z-index: 999;
}
.as-mask-wide {
  flex-direction: row;
}
.as-sheet {
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  padding-bottom: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.as-sheet-wide {
  /* 宽度改由 sheetStyle 内联给出（走 qtSheetWidth 契约，窄窗口自动夹紧） */
  height: 100%;
  border-radius: 0;
  padding-bottom: 0;
}
.as-title {
  padding: 30rpx 32rpx 18rpx;
  border-bottom-width: 1rpx; border-bottom-style: solid;
}
.as-title-wide {
  padding: 16px 20px 10px;
  border-bottom-width: 1px; border-bottom-style: solid;
}
.as-title-text {
  font-size: 24rpx;
  text-align: center;
}
.as-title-text-wide {
  text-align: left;
  font-size: 13px;
}
.as-list {
  /* 上限故意停在「5 行半」：下半截露出的下一行就是「底下还能滑」的暗示，
     整行对齐时用户看不出列表被截断（572 = 104 × 5.5）。 */
  max-height: 572rpx;
}
.as-list-wide {
  /* 同 .as-list：9 行半，半行做可滚动暗示（494 = 52 × 9.5） */
  max-height: 494px;
}
.as-item {
  height: 104rpx;
  justify-content: center;
  align-items: center;
  border-bottom-width: 1rpx; border-bottom-style: solid;
}
.as-item-wide {
  height: 52px;
  border-bottom-width: 1px; border-bottom-style: solid;
}
.as-item-disabled {
  opacity: 0.45;
}
.as-item-text {
  font-size: 29rpx;
  font-weight: 500;
}
.as-item-text-wide {
  font-size: 15px;
}
.as-cancel {
  height: 108rpx;
  margin-top: 12rpx;
  justify-content: center;
  align-items: center;
}
.as-cancel-wide {
  height: 54px;
  margin-top: 6px;
}
.as-cancel-text {
  font-size: 29rpx;
}
.as-cancel-text-wide {
  font-size: 15px;
}
</style>
