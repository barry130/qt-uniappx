<template>
  <QtSheet :visible="visible" :title="title" @close="close">
    <scroll-view class="as-list" direction="vertical" :show-scrollbar="false" :scroll-into-view="reveal.anchor.value" :style="listStyle">
      <view v-for="(action, index) in actions" :key="index" :id="reveal.itemId(index)">
        <QtOption :label="action.name" :selected="index == selectedIdx" :disabled="action.disabled == true" :color="action.color != null ? action.color : ''" :dense="true" @select="pick(index)" />
      </view>
    </scroll-view>
    <template #footer>
      <view class="as-cancel" :class="layout.isWide ? 'as-cancel-wide' : ''" :style="'background-color:' + theme.skin.surfaceMuted + ';'" @click="close">
        <text class="as-cancel-text" :class="layout.isWide ? 'as-cancel-text-wide' : ''" :style="'color:' + theme.skin.textMuted + ';' + qtFontDual(28, 15)">取消</text>
      </view>
    </template>
  </QtSheet>
</template>
<script setup lang="ts">
import { computed } from "vue";
import QtSheet from "@/uni_modules/qt-ui/components/qt-sheet/qt-sheet.uvue";
import QtOption from "@/uni_modules/qt-ui/components/qt-option/qt-option.uvue";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { qtFontDual, fontScale } from "@/uni_modules/qt-ui/stores/font-scale";
import { qtSelectionIndex } from "@/uni_modules/qt-ui/composables/selection";
import { useQtSelectionReveal } from "@/uni_modules/qt-ui/composables/use-qt-selection-reveal";

export type SheetAction = { name: string; color?: string; disabled?: boolean };
const props = withDefaults(defineProps<{
  visible: boolean;
  title?: string;
  actions: SheetAction[];
  selectedIndex?: number;
}>(), { title: "", selectedIndex: -1 });
const emit = defineEmits<{
  "update:visible": [value: boolean];
  select: [action: SheetAction, index: number];
  close: [];
}>();
const layout = useQtLayout();
const theme = useThemeStore();
const selectedIdx = computed((): number => qtSelectionIndex(props.selectedIndex, props.actions.length));
const reveal = useQtSelectionReveal((): boolean => props.visible, (): number => selectedIdx.value, (): string => JSON.stringify(props.actions));
// 一行的实际高度：紧凑行不设 min-height，高度=上下内边距 + 一行文字
// （见 qt-option 的 .qo-row-dense：手机 22rpx*2，宽屏 11px*2）。
const rowHeight = computed((): number => {
  if (layout.isWide) return 22 + 15 * fontScale.scale * 1.35;
  const unit = layout.windowWidth / 750;
  return (44 + 28 * fontScale.scale * 1.35) * unit;
});
const listStyle = computed((): string => {
  const unit = layout.isWide ? 1 : layout.windowWidth / 750;
  const header = props.title.length > 0 ? (layout.isWide ? 64 : 112 * unit) : 0;
  const footer = layout.isWide ? 60 : 112 * unit;
  const available = Math.max(0, layout.windowHeight * 0.86 - layout.safeBottomPx - header - footer);
  const need = props.actions.length * rowHeight.value;
  const row = rowHeight.value;
  // Native scroll-view needs an explicit bounded viewport, including for a one-row menu.
  // 放得下就贴合内容（不留空白拖尾）；放不下时留半行露头，让人一眼看出还能下滑 ——
  // 直接按可用高度截断，下一行会被整行盖住，看不出列表还能滚。
  const height = need <= available ? need : Math.max(row * 2, available - row * 0.45);
  return "height:" + Math.round(Math.min(need, available, height)) + "px;";
});
function close(): void { emit("update:visible", false); emit("close"); }
function pick(index: number): void {
  const action = props.actions[index];
  if (action == null || action.disabled == true) return;
  emit("update:visible", false);
  emit("select", action, index);
}
</script>
<style>
.as-list { flex-shrink: 1; min-height: 0; }
.as-cancel { height: 96rpx; align-items: center; justify-content: center; margin-top: 8rpx; }
.as-cancel-wide { height: 48px; margin-top: 4px; }
.as-cancel-text { font-size: 28rpx; }
.as-cancel-text-wide { font-size: 15px; }
</style>
