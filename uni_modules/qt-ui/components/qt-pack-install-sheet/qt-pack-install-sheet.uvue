<template>
  <!-- 普通安装引导使用统一 Sheet；全局服务仍是唯一业务状态来源。 -->
  <QtSheet :visible="st.visible.value" title="安装播放音源包" :dismissible="!st.installing.value" @update:visible="onVisibleChange">
    <scroll-view direction="vertical" class="qpis-body" :style="bodyStyle" :show-scrollbar="false">
      <view class="qpis-content" :class="layout.isWide ? 'qpis-content-wide' : ''">
        <text class="qpis-desc" :style="'color:' + theme.skin.textMuted + ';' + qtFontDual(24, 13)">在线播放需要安装一次播放音源包。这里一键安装官方包，也可以到「音源包管理」手动安装。</text>
        <view class="qpis-info" :class="layout.isWide ? 'qpis-info-wide' : ''" :style="'background-color:' + theme.skin.surfaceMuted + ';border-color:' + theme.skin.border + ';'">
          <text :style="'color:' + theme.skin.text + ';font-weight:600;' + qtFontDual(26, 14)">{{ offerTitleText }}</text>
          <text v-if="st.offerNotes.value.length > 0" class="qpis-info-notes" :class="layout.isWide ? 'qpis-info-notes-wide' : ''" :style="'color:' + theme.skin.textMuted + ';' + qtFontDual(22, 12)" :max-lines="4">{{ st.offerNotes.value }}</text>
        </view>
      </view>
    </scroll-view>
    <template #footer>
      <view class="qpis-actions" :class="layout.isWide ? 'qpis-actions-wide' : ''">
        <QtButton label="立即安装" variant="primary" size="lg" :disabled="st.installing.value" @click="onInstall" />
        <view class="qpis-manual-btn" :class="layout.isWide ? 'qpis-manual-btn-wide' : ''"><QtButton label="手动管理" variant="outline" size="md" :disabled="st.installing.value" @click="onManual" /></view>
      </view>
    </template>
  </QtSheet>
</template>
<script setup lang="ts">
import { computed } from "vue";
import QtSheet from "@/uni_modules/qt-ui/components/qt-sheet/qt-sheet.uvue";
import QtButton from "@/uni_modules/qt-ui/components/qt-button/qt-button.uvue";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout, qtRpx } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtFontDual, fontScale } from "@/uni_modules/qt-ui/stores/font-scale";
import { packInstallSheetState, packInstallSheetClose, packInstallSheetGoManual, packInstallSheetInstall } from "@/services/pack-install-sheet";
const st = packInstallSheetState();
const theme = useThemeStore();
const layout = useQtLayout();
const offerTitleText = computed((): string => {
  const name = st.offerName.value;
  return name.length > 0 ? "官方播放包 v" + name : "官方播放包（版本号 " + st.offerCode.value + "）";
});
const bodyStyle = computed((): string => {
  const preferred = (layout.isWide ? 180 : qtRpx(310)) * fontScale.scale;
  const available = Math.max(0, layout.windowHeight * 0.86 - layout.safeBottomPx - (layout.isWide ? 210 : qtRpx(360)) * fontScale.scale);
  return "height:" + Math.min(preferred, available) + "px;";
});
function onVisibleChange(value: boolean): void {
  // 双护栏：Sheet emit 前就 guard，这里在服务变更前再次校验。没有 v-model 先写 visible。
  if (st.installing.value || value) return;
  packInstallSheetClose();
}
function onInstall(): void { packInstallSheetInstall(); }
function onManual(): void {
  if (st.installing.value) return;
  packInstallSheetGoManual();
}
</script>
<style>
.qpis-body { min-height: 0; }
.qpis-content { padding: 24rpx 28rpx 0; }
.qpis-content-wide { padding: 16px 20px 0; }
.qpis-info { margin-top: 24rpx; border-width: 1px; border-style: solid; border-radius: 16rpx; padding: 20rpx 24rpx; }
.qpis-info-wide { margin-top: 16px; border-radius: 10px; padding: 12px 14px; }
.qpis-info-notes { margin-top: 8rpx; }
.qpis-info-notes-wide { margin-top: 6px; }
.qpis-actions { padding: 28rpx 28rpx 24rpx; }
.qpis-actions-wide { padding: 20px 20px 12px; }
.qpis-manual-btn { margin-top: 16rpx; }
.qpis-manual-btn-wide { margin-top: 10px; }
</style>
