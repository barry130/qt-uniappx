<template>
  <view
    class="switcher"
    :class="layout.isWide ? 'switcher-wide' : ''"
    :style="'background-color:' + theme.skin.surfaceMuted + ';'"
    @click="open"
  >
    <view class="switcher-inner" :class="layout.isWide ? 'switcher-inner-wide' : ''">
      <text class="switcher-text" :class="layout.isWide ? 'switcher-text-wide' : ''" :style="('color:' + theme.skin.textSubtle + ';') + qtFontDual(24, 16)">{{ label() }}</text>
      <QtIcon class="switcher-caret" name="chevron-down" :size="layout.isWide ? 18 : 24" :color="theme.skin.iconMuted" />
    </view>
  </view>
</template>

<script setup lang="ts">
import { onMounted } from "vue";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useSourceStore } from "@/stores/source";
import { useSourceRegistryStore } from "@/stores/source-registry";
import { platformLabel } from "@/services/platform";
import { pickSourceFromSheet } from "@/services/source-sheet";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";

const emit = defineEmits(["change"]);
const store = useSourceStore();
const registry = useSourceRegistryStore();
const layout = useQtLayout();
const theme = useThemeStore();

function label(): string {
  return platformLabel(store.current);
}
function open(): void {
  // 弹层与清单口径统一在 services/source-sheet（四个入口共用）：未装包提示、
  // 当前项 accent 高亮、打开时自动滚到选中项都在那里，这里只接「换没换」。
  // 必须走全局 host（qt-action-sheet-host，挂在 qt-page-frame 根）：原生渲染里
  // absolute 锚定父节点，内联 <qt-action-sheet> 的蒙层只有本组件（头部一行）那么高，
  // 弹层从蒙层底部向上溢出被屏幕裁掉（2026-10-25 真机：只剩最后一项+取消）。
  pickSourceFromSheet().then((changed: boolean) => {
    if (!changed) return;
    emit("change", store.current);
  });
}

onMounted(() => {
  registry.ensure();
});
</script>

<style>
.switcher {
  height: 64rpx;
  padding: 0 24rpx;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  border-radius: 32rpx;
}
.switcher-inner {
  height: 64rpx;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.switcher-text {
  height: 64rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 64rpx;
}
.switcher-caret {
  margin-left: 6rpx;
}

.switcher-wide { height: 44px; padding-left: 18px; padding-right: 18px; border-radius: 22px; }
.switcher-inner-wide { height: 44px; }
.switcher-text-wide { height: 44px; line-height: 44px; font-size: 16px; }
</style>