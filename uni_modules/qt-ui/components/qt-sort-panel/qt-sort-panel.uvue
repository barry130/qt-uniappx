<template>
  <QtSheet :visible="visible" title="更改歌曲排序方式" @update:visible="onVisibleChange">
    <view class="qt-sort-body" :class="layout.isWide ? 'qt-sort-body-wide' : ''">
      <view class="qt-sort-row" :class="layout.isWide ? 'qt-sort-row-wide' : ''">
        <text class="qt-sort-label" :class="layout.isWide ? 'qt-sort-label-wide' : ''" :style="'color:' + theme.skin.textSubtle + ';' + qtFontDual(24, 13)">排序方式</text>
        <view class="qt-sort-chips">
          <view v-for="key in SORT_KEYS" :key="key" class="qt-sort-chip-slot" :class="layout.isWide ? 'qt-sort-chip-slot-wide' : ''">
            <QtOption :label="keyLabel(key)" kind="chip" :selected="sortKey == key" @select="tapKey(key)" />
          </view>
        </view>
      </view>
      <view class="qt-sort-row" :class="layout.isWide ? 'qt-sort-row-wide' : ''">
        <text class="qt-sort-label" :class="layout.isWide ? 'qt-sort-label-wide' : ''" :style="'color:' + theme.skin.textSubtle + ';' + qtFontDual(24, 13)">方向</text>
        <view class="qt-sort-chips">
          <view v-for="dir in SORT_DIRS" :key="dir" class="qt-sort-chip-slot" :class="layout.isWide ? 'qt-sort-chip-slot-wide' : ''">
            <QtOption :label="dir == 'asc' ? '正序' : '倒序'" kind="chip" :selected="hasKey() && (dir == 'desc') == sortDesc" :disabled="!hasKey()" @select="tapDir(dir)" />
          </view>
        </view>
      </view>
      <text class="qt-sort-hint" :class="layout.isWide ? 'qt-sort-hint-wide' : ''" :style="'color:' + theme.skin.textSubtle + ';' + qtFontDual(22, 12)">不选排序方式即默认顺序；已选中的再点一次取消</text>
    </view>
  </QtSheet>
</template>
<script setup lang="ts">
import QtSheet from "@/uni_modules/qt-ui/components/qt-sheet/qt-sheet.uvue";
import QtOption from "@/uni_modules/qt-ui/components/qt-option/qt-option.uvue";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";
const props = defineProps({
  visible: { type: Boolean, default: false },
  sortKey: { type: String, default: "none" },
  sortDesc: { type: Boolean, default: false },
});
const emit = defineEmits(["update:visible", "select", "desc"]);
const theme = useThemeStore();
const layout = useQtLayout();
const SORT_KEYS: string[] = ["name", "album", "singer"];
const SORT_DIRS: string[] = ["asc", "desc"];
function keyLabel(key: string): string {
  if (key == "album") return "按专辑名";
  if (key == "singer") return "按歌手名";
  return "按歌曲名";
}
function onVisibleChange(value: boolean): void { emit("update:visible", value); }
function hasKey(): boolean { return SORT_KEYS.includes(props.sortKey); }
// 点选只改变排序，不关闭；再次点当前键回 none。
function tapKey(key: string): void { emit("select", props.sortKey == key ? "none" : key); }
function tapDir(dir: string): void {
  if (!hasKey()) return;
  emit("desc", dir == "desc");
}
</script>
<style>
.qt-sort-body { padding: 0 28rpx 28rpx; }
.qt-sort-body-wide { padding: 0 20px 20px; }
.qt-sort-row { margin-top: 26rpx; flex-direction: row; align-items: center; }
.qt-sort-row-wide { margin-top: 18px; }
.qt-sort-label { width: 128rpx; flex-shrink: 0; }
.qt-sort-label-wide { width: 72px; }
.qt-sort-chips { flex: 1; flex-direction: row; flex-wrap: wrap; }
.qt-sort-chip-slot { margin-right: 16rpx; margin-bottom: 12rpx; }
.qt-sort-chip-slot-wide { margin-right: 10px; margin-bottom: 8px; }
.qt-sort-hint { margin-top: 20rpx; }
.qt-sort-hint-wide { margin-top: 12px; }
</style>
