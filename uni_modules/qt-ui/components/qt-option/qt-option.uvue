<template>
  <view class="qo" :class="[kindClass, disabled ? 'qo-disabled' : '']" :style="optionStyle" @click.stop="pick">
    <slot name="leading"></slot>
    <view class="qo-body">
      <text class="qo-label" :class="layout.isWide ? 'qo-label-wide' : ''" :style="labelStyle">{{ label }}</text>
      <text v-if="description.length > 0" class="qo-description" :class="layout.isWide ? 'qo-description-wide' : ''" :style="descriptionStyle">{{ description }}</text>
      <slot></slot>
    </view>
  </view>
</template>
<script setup lang="ts">
import { computed } from "vue";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";
import { qtSelectionColor } from "@/uni_modules/qt-ui/composables/selection";

const props = withDefaults(defineProps<{
  label: string;
  description?: string;
  selected?: boolean;
  disabled?: boolean;
  kind?: "row" | "chip" | "card";
  /** Non-selection action color (e.g. destructive menu action); selected red always wins. */
  color?: string;
  /**
   * 菜单行用紧凑行高：`.qo-row` 的 104rpx 是给设置类列表用的（两行文字也放得下），
   * 单行菜单里用同一套会显得行间空隙过大，所以由调用方（action sheet）显式声明。
   */
  dense?: boolean;
}>(), { description: "", selected: false, disabled: false, kind: "row", color: "", dense: false });
const emit = defineEmits<{ select: [] }>();
const layout = useQtLayout();
const theme = useThemeStore();
const red = computed((): string => qtSelectionColor(theme.dark));
const kindClass = computed((): string => {
  const base = "qo-" + props.kind + (layout.isWide ? " qo-" + props.kind + "-wide" : "");
  if (!props.dense) return base;
  // 紧凑行只对 row 有意义（chip/card 自带内边距），宽窄屏用两套单位互不覆盖
  return base + (layout.isWide ? " qo-row-dense qo-row-dense-wide" : " qo-row-dense");
});
const optionStyle = computed((): string => {
  if (props.kind == "row") return "border-bottom-color:" + theme.skin.divider + ";";
  return "background-color:" + theme.skin.surfaceMuted + ";border-color:" + (props.selected ? red.value : theme.skin.border) + ";";
});
const labelStyle = computed((): string => {
  const color = props.disabled ? theme.skin.textSubtle : props.selected ? red.value : props.color.length > 0 ? props.color : theme.skin.text;
  return "color:" + color + ";font-weight:" + (props.selected ? "600" : "400") + ";" + qtFontDual(28, 15);
});
const descriptionStyle = computed((): string => "color:" + (props.selected ? red.value : theme.skin.textMuted) + ";" + qtFontDual(23, 12));
function pick(): void { if (!props.disabled) emit("select"); }
</script>
<style>
.qo { flex-direction: row; align-items: center; flex-shrink: 0; min-width: 0; }
.qo-body { flex-shrink: 1; min-width: 0; }
.qo-row { min-height: 104rpx; padding: 20rpx 32rpx; border-bottom-width: 1rpx; border-bottom-style: solid; align-self: stretch; }
.qo-row-wide { min-height: 52px; padding: 10px 20px; border-bottom-width: 1px; }
/* 单行菜单的紧凑行：不设 min-height，高度=内边距+一行文字（约 82rpx / 42px），
   去掉 104rpx 最小高度撑出来的空隙。必须排在 .qo-row / .qo-row-wide 之后才生效。 */
.qo-row-dense { min-height: 0; padding: 22rpx 32rpx; }
.qo-row-dense-wide { min-height: 0; padding: 11px 20px; }
.qo-chip { min-height: 64rpx; padding: 12rpx 24rpx; border-radius: 16rpx; border-width: 1rpx; border-style: solid; }
.qo-chip-wide { min-height: 36px; padding: 6px 14px; border-radius: 8px; border-width: 1px; }
.qo-card { padding: 24rpx; border-radius: 20rpx; border-width: 2rpx; border-style: solid; }
.qo-card-wide { padding: 14px; border-radius: 10px; border-width: 1px; }
.qo-label { font-size: 28rpx; line-height: 1.35; }
.qo-label-wide { font-size: 15px; }
.qo-description { font-size: 23rpx; line-height: 1.4; margin-top: 6rpx; }
.qo-description-wide { font-size: 12px; margin-top: 3px; }
.qo-disabled { opacity: 0.45; }
</style>
