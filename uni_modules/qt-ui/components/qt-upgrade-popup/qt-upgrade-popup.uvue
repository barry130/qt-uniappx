<template>
  <view v-if="visible && info != null" class="up-mask" :style="maskStyle" @click="onMaskTap">
    <view class="up-card" :class="layout.isWide ? 'up-card-wide' : ''" :style="cardStyle" @click.stop>
      <view class="up-header" :class="[layout.isWide ? 'up-header-wide' : '', shortWide ? 'up-header-short' : '']">
        <image class="up-icon" :class="layout.isWide ? 'up-icon-wide' : ''" src="/static/icon/xxxhdpi.png" mode="aspectFill" />
        <view class="up-heading" :class="[layout.isWide ? 'up-heading-wide' : '', shortWide ? 'up-heading-short' : '']">
          <text class="up-title" :class="layout.isWide ? 'up-title-wide' : ''" :style="'color:' + themeStore.skin.text + ';' + qtFontDual(30, 19)">发现新版本</text>
          <view class="up-meta" :class="[layout.isWide ? 'up-meta-wide' : '', shortWide ? 'up-meta-short' : '']">
            <text class="up-version" :class="layout.isWide ? 'up-version-wide' : ''" :style="'color:' + themeStore.skin.accent + ';' + qtFontDual(24, 14)">{{ info.versionName }}</text>
            <view v-if="isBeta" class="up-badge" :class="layout.isWide ? 'up-badge-wide' : ''" :style="'background-color:' + themeStore.skin.successSoft + ';'">
              <text class="up-badge-text" :class="layout.isWide ? 'up-badge-text-wide' : ''" :style="'color:' + themeStore.skin.success + ';' + qtFontDual(19, 11)">测试版</text>
            </view>
            <text v-if="sizeText.length > 0" class="up-size" :class="layout.isWide ? 'up-size-wide' : ''" :style="'color:' + themeStore.skin.textMuted + ';' + qtFontDual(22, 13)">{{ sizeText }}</text>
          </view>
        </view>
      </view>
      <scroll-view :key="info.versionCode" class="up-content" :style="'border-top-color:' + themeStore.skin.divider + ';border-bottom-color:' + themeStore.skin.divider + ';'" direction="vertical" :show-scrollbar="true">
        <view class="up-content-inner" :class="layout.isWide ? 'up-content-inner-wide' : ''">
          <QtRichText
            :html="info.versionInfo"
            :color="themeStore.skin.text"
            :font-size="26"
            :line-height="1.7"
            align="left"
          />
        </view>
      </scroll-view>
      <view class="up-footer" :class="[layout.isWide ? 'up-footer-wide' : '', shortWide ? 'up-footer-short' : '']">
        <view v-if="downloading || probing" class="up-progress" :class="layout.isWide ? 'up-progress-wide' : ''">
          <view class="up-progress-track" :class="layout.isWide ? 'up-progress-track-wide' : ''" :style="'background-color:' + themeStore.skin.surfaceMuted + ';'">
            <view class="up-progress-bar" :class="layout.isWide ? 'up-progress-bar-wide' : ''" :style="'width:' + progress + '%;background-color:' + themeStore.skin.accent + ';'"></view>
          </view>
          <text class="up-progress-text" :class="layout.isWide ? 'up-progress-text-wide' : ''" :style="'color:' + themeStore.skin.textMuted + ';' + qtFontDual(22, 13)">{{ progressText }}</text>
        </view>
        <!-- 手机双下载入口并排，稍后操作独占次行；宽屏三项同排，为矮横窗留出正文空间。 -->
        <view class="up-actions">
          <view v-if="showCancelBtn && !separateCancel" class="up-action" :class="[showDirectBtn || showBrowserBtn ? 'up-action-gap' : '', (showDirectBtn || showBrowserBtn) && layout.isWide ? 'up-action-gap-wide' : '']">
            <QtButton label="以后再说" variant="outline" size="sm" @click="cancel" />
          </view>
          <view v-if="showDirectBtn" class="up-action" :class="[showBothDownloads ? 'up-action-gap' : '', showBothDownloads && layout.isWide ? 'up-action-gap-wide' : '']">
            <QtButton :label="primaryBtnText" size="sm" :disabled="downloading || probing" @click="update" />
          </view>
          <view v-if="showBrowserBtn && !downloading && !probing" class="up-action">
            <QtButton label="浏览器下载" variant="outline" size="sm" @click="updateByBrowser" />
          </view>
        </view>
        <view v-if="showCancelBtn && separateCancel" class="up-later">
          <QtButton label="以后再说" variant="ghost" size="sm" @click="cancel" />
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import { ref, computed, onUnmounted } from "vue";
import QtButton from "@/uni_modules/qt-ui/components/qt-button/qt-button.uvue";
import QtRichText from "@/uni_modules/qt-ui/components/qt-rich-text/qt-rich-text.uvue";
import type { AppUpdateInfo } from "@/services/upgrade";
import { formatFileSize, resolveDownloadUrl } from "@/services/upgrade";
import { useQtLayout, qtStatusBarPx, qtRpx } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtSheetWidth } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";

const layout = useQtLayout();
const themeStore = useThemeStore();
const shortWide = computed(() => layout.isWide && layout.isShort);

/** 专用升级弹窗保持居中与强制更新契约；正文占据标题和固定操作区之间的剩余空间。 */
const dialogSpace = computed(() => {
  const gap = layout.isWide ? 16 : qtRpx(24);
  const top = qtStatusBarPx() + gap;
  const bottom = layout.safeBottomPx + gap;
  const available = Math.max(0, layout.windowHeight - top - bottom);
  return { top, bottom, height: Math.floor(layout.isShort ? available : Math.min(800, available * 0.9)) };
});
const maskStyle = computed((): string => {
  const space = dialogSpace.value;
  return "padding-top:" + space.top + "px;padding-bottom:" + space.bottom + "px;background-color:" + themeStore.skin.scrim + ";";
});
const cardStyle = computed((): string => {
  const width = layout.isWide ? qtSheetWidth("modal") : Math.max(0, layout.windowWidth - qtRpx(48));
  return "width:" + width + "px;height:" + dialogSpace.value.height + "px;background-color:" + themeStore.skin.sheetSurface + ";";
});
import { downloadApk, installApk, openInBrowser } from "@/services/app-native";
import { saveToPublicMedia, ensurePublicDirPermission } from "@/uni_modules/qt-app-native";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";
import { logMsg, logMsgErr } from "@/services/logger";

/** APP 更新包公共目录（固定）：Download/QtDownload/Update */
const UPDATE_SUB_DIR = "QtDownload/Update";
const UPDATE_FILE_PREFIX = "轻听音乐";

// 下载完成后的延迟关闭定时器：组件卸载时必须清掉，避免在已卸载实例上触发回调
let closeTimer: number | null = null;
onUnmounted(() => {
  if (closeTimer != null) {
    clearTimeout(closeTimer);
    closeTimer = null;
  }
});

const props = defineProps<{
  visible: boolean;
  info: AppUpdateInfo | null;
}>();
const emit = defineEmits<{
  "update:visible": [value: boolean];
  closed: [];
}>();

const downloading = ref(false);
const progress = ref(0);
/** GitHub 加速探测进行中（按钮显示「测速中…」） */
const probing = ref(false);
/**
 * 逃生开关：直链下载失败、或已经拉起过安装界面后放开关闭入口。
 * 否则网络不可达 / 用户取消安装时，强制更新弹窗既关不掉也装不上，用户会被彻底卡住。
 */
const escapeAllowed = ref(false);

const isBeta = computed(() => props.info != null && props.info.channel == "beta");
const sizeText = computed(() =>
  props.info != null ? formatFileSize(props.info.fileSize) : ""
);

/** 按钮显隐规则：downloadUrl 有显示「直接下载」；browserUrl 有显示「浏览器下载」 */
const showDirectBtn = computed(() => props.info != null && props.info.downloadUrl.length > 0);
const showBrowserBtn = computed(() => props.info != null && props.info.browserUrl.length > 0);
const showBothDownloads = computed(() => showDirectBtn.value && showBrowserBtn.value && !downloading.value && !probing.value);
const separateCancel = computed(() => showBothDownloads.value && !layout.isWide);
/** 「以后再说」：非强制更新常显；强制更新仅在下载失败后作为逃生入口出现 */
const showCancelBtn = computed(
  () =>
    !downloading.value &&
    !probing.value &&
    (props.info == null || !props.info.isForce || escapeAllowed.value)
);
/** 强制更新时点遮罩不关闭；仅在下载失败/无法拉起安装时放行，避免完全卡死 */
const maskClosable = computed(
  () => props.info == null || !props.info.isForce || escapeAllowed.value
);

const primaryBtnText = computed(() => {
  if (probing.value) return "测速中...";
  if (downloading.value) return "下载中...";
  return "直接下载";
});
const progressText = computed(() =>
  probing.value ? "测速中" : progress.value + "%"
);

function closeSelf(): void {
  emit("update:visible", false);
  emit("closed");
}

function cancel(): void {
  if (downloading.value || probing.value) return;
  closeSelf();
}

function onMaskTap(): void {
  // 强制更新时点击遮罩不关闭（下载失败后除外）
  if (!maskClosable.value) return;
  cancel();
}

/** 浏览器下载：打开 browserUrl（双链接方案的浏览器分支） */
function updateByBrowser(): void {
  const info = props.info;
  if (info == null || downloading.value || probing.value) return;
  openInBrowser(info.browserUrl);
  // 强制更新不关闭弹窗：从浏览器返回后仍需拦截，否则等于放行了强制更新
  if (!info.isForce) closeSelf();
}

async function update(): Promise<void> {
  const info = props.info;
  if (info == null || downloading.value || probing.value) return;
  escapeAllowed.value = false;
  // GitHub 直链：先并发探测加速节点选最快可用（全部失败回退原始链接）
  probing.value = true;
  let url = info.downloadUrl;
  try {
    url = await resolveDownloadUrl(info, () => {});
  } catch (_) {
    url = info.downloadUrl;
  } finally {
    probing.value = false;
  }
  if (url.length == 0) {
    qtShowToast({ title: "暂无可用下载地址", icon: "none" });
    return;
  }
  logMsg("[Upgrade] 开始下载：" + url);
  // 直链下载（uni.downloadFile + 进度条）
  downloading.value = true;
  progress.value = 0;
  try {
    const path = await downloadApk(url, (_received, _total, percent) => {
      progress.value = percent;
    });
    progress.value = 100;
    // 另存一份到公共目录 Download/QtDownload/Update（固定，不可修改）
    let installPath = path;
    try {
      // 权限申请与写入都是异步的（鸿蒙首次会弹下载目录权限弹窗），必须 await：
      // 否则会拿弹窗还没结束的空结果，APK 只能留在临时目录
      const granted = await ensurePublicDirPermission();
      if (granted) {
        const apkName = UPDATE_FILE_PREFIX + "_v" + info.versionName + ".apk";
        const saved = await saveToPublicMedia(path, "download", apkName, UPDATE_SUB_DIR);
        if (saved != null && saved.length > 0) installPath = saved;
        else logMsg("[Upgrade] 公共目录保存失败，使用临时文件安装");
      } else {
        logMsg("[Upgrade] 无公共目录权限，使用临时文件安装");
      }
    } catch (e) {
      logMsgErr("[Upgrade] 公共目录保存失败", e);
    }
    // 下载完成，拉起安装。
    // 注意：拉起安装成功不放开强制更新——用户取消安装回到 APP 后仍然要拦住；
    // 只有连安装界面都拉不起来（更新这条路走不通）时才给逃生入口，避免彻底卡死。
    if (!installApk(installPath)) {
      escapeAllowed.value = true;
    }
    // 非强制更新：下载完成后关闭弹窗；强制更新等安装后由用户处理
    if (!info.isForce) {
      // 句柄必须存到 closeTimer：onUnmounted 只清这一个变量，
      // 丢了句柄就等于没清理，弹窗在 600ms 内被卸载时回调会在已销毁实例上触发。
      if (closeTimer != null) {
        clearTimeout(closeTimer);
        closeTimer = null;
      }
      closeTimer = setTimeout(() => {
        closeTimer = null;
        downloading.value = false;
        closeSelf();
      }, 600);
    } else {
      downloading.value = false;
    }
  } catch (e) {
    downloading.value = false;
    progress.value = 0;
    // 下载失败：放开关闭入口（强制更新也能退出），用户可改用浏览器下载
    escapeAllowed.value = true;
    const msg = e != null && (e as Error).message != null ? (e as Error).message : "下载失败";
    qtShowToast({ title: msg, icon: "none" });
  }
}
</script>

<style>
.up-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  justify-content: center;
  align-items: center;
  z-index: 999;
}
.up-card {
  border-radius: 28rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.up-header {
  flex-direction: row;
  align-items: center;
  padding: 28rpx 32rpx;
  flex-shrink: 0;
}
.up-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}
.up-heading {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.up-title {
  font-size: 30rpx;
  font-weight: 700;
}
.up-meta {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 6rpx;
}
.up-version {
  font-size: 24rpx;
  font-weight: 600;
}
.up-badge {
  margin-left: 14rpx;
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
}
.up-badge-text {
  font-size: 19rpx;
}
.up-size {
  margin-left: 14rpx;
  font-size: 22rpx;
}
.up-content {
  flex: 1;
  min-height: 0;
  border-top-width: 1px;
  border-top-style: solid;
  border-bottom-width: 1px;
  border-bottom-style: solid;
}
.up-content-inner {
  padding: 24rpx 32rpx;
}
.up-footer {
  padding: 24rpx 32rpx 28rpx;
  flex-shrink: 0;
}
.up-progress {
  margin-bottom: 20rpx;
  flex-direction: row;
  align-items: center;
}
.up-progress-track {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  overflow: hidden;
}
.up-progress-bar {
  height: 8rpx;
  border-radius: 4rpx;
}
.up-progress-text {
  margin-left: 16rpx;
  font-size: 22rpx;
}
.up-actions {
  flex-direction: row;
}
.up-action {
  flex: 1;
  min-width: 0;
}
.up-action-gap {
  margin-right: 16rpx;
}
.up-later {
  margin-top: 12rpx;
}
.up-card-wide {
  border-radius: 16px;
}
.up-header-wide {
  padding: 18px 24px;
}
.up-icon-wide {
  width: 44px;
  height: 44px;
  border-radius: 12px;
}
.up-heading-wide {
  margin-left: 12px;
}
.up-title-wide {
  font-size: 19px;
}
.up-meta-wide {
  margin-top: 4px;
}
.up-version-wide {
  font-size: 14px;
}
.up-badge-wide {
  margin-left: 8px;
  padding: 2px 7px;
  border-radius: 5px;
}
.up-badge-text-wide {
  font-size: 11px;
}
.up-size-wide {
  margin-left: 8px;
  font-size: 13px;
}
.up-content-inner-wide {
  padding: 18px 24px;
}
.up-footer-wide {
  padding: 16px 24px;
}
.up-progress-wide {
  margin-bottom: 12px;
}
.up-progress-track-wide {
  height: 4px;
  border-radius: 2px;
}
.up-progress-bar-wide {
  height: 4px;
  border-radius: 2px;
}
.up-progress-text-wide {
  margin-left: 10px;
  font-size: 13px;
}
.up-action-gap-wide {
  margin-right: 12px;
}
.up-header-short {
  padding: 12px 24px;
}
.up-heading-short {
  flex-direction: row;
  align-items: center;
}
.up-meta-short {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  margin-left: 16px;
}
.up-footer-short {
  padding: 12px 24px;
}
</style>
