<!--
  统一图标组件
  全站图标唯一入口，内部使用 services/icons.ts 自绘的线性 SVG。
  用法：qt-icon name="play" :size="44" color="#ffffff"
  size 单位：手机端为 rpx；宽屏（isWide）下为 px。
  原因：rpx 随窗口宽度缩放，宽屏（≥900dp）下若仍按 rpx 计算图标会被放大到离谱；
  调用方在 isWide 分支传入的值本来就按 px 预期。注意 rpx 并不封顶 ——
  uni-app x 不支持 pages.json 的 rpxCalcMaxDeviceWidth（该键 schema 里标了不支持），
  1rpx 恒等于 windowWidth/750，所以 720dp 窗口里 48rpx 是 46dp 而不是 24dp。
-->
<template>
  <image
    class="qt-icon"
    :style="sizeStyle"
    mode="aspectFit"
    :src="src"
  />
</template>

<script setup lang="ts">
import { computed } from "vue";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { iconSrc } from "@/uni_modules/qt-ui/services/icons";

const props = defineProps<{
  name: string;
  size?: number;
  color?: string;
  strokeWidth?: number;
}>();

const layout = useQtLayout();
const px = computed((): number => (props.size != null ? props.size! : 40));
const tint = computed((): string => (props.color != null ? props.color! : "#4a5162"));
const weight = computed((): number => (props.strokeWidth != null ? props.strokeWidth! : 2));

const src = computed((): string => iconSrc(props.name, tint.value, weight.value));
const sizeStyle = computed((): string => {
  const unit = layout.isWide ? "px" : "rpx";
  return "width:" + px.value + unit + ";height:" + px.value + unit + ";";
});
</script>

<style>
.qt-icon {
  flex-shrink: 0;
}
</style>
