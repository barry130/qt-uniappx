<template>
  <view class="qt-checkbox" :class="[boxClass, disabled ? 'qt-checkbox-disabled' : '']" :style="boxStyle" @click.stop="onTap">
    <view v-if="checked" class="qt-checkbox-dot" :class="layout.isWide ? 'qt-checkbox-dot-wide' : ''" :style="'background-color:' + selectedColor + ';'"></view>
  </view>
</template>
<script setup lang="ts">
import { computed } from "vue";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtSelectionColor } from "@/uni_modules/qt-ui/composables/selection";
/** Compatibility API for all toggle/multi-select indicators; red only, never a check glyph. */
const props = defineProps<{ checked?: boolean; size?: "sm" | "md"; disabled?: boolean }>();
const emit = defineEmits<{ change: [boolean] }>();
const theme = useThemeStore();
const layout = useQtLayout();
const checked = computed((): boolean => props.checked == true);
const size = computed((): string => props.size != null ? props.size : "md");
const selectedColor = computed((): string => qtSelectionColor(theme.dark));
const boxClass = computed((): string => "qt-checkbox-size-" + size.value + (layout.isWide ? "-wide" : ""));
const boxStyle = computed((): string => "border-color:" + (checked.value ? selectedColor.value : theme.skin.border) + ";");
function onTap(): void { if (props.disabled != true) emit("change", !checked.value); }
</script>
<style>
.qt-checkbox { align-items: center; justify-content: center; border-style: solid; border-width: 2rpx; flex-shrink: 0; }
.qt-checkbox-size-sm { width: 36rpx; height: 36rpx; border-radius: 18rpx; }
.qt-checkbox-size-md { width: 44rpx; height: 44rpx; border-radius: 22rpx; }
.qt-checkbox-size-sm-wide { width: 20px; height: 20px; border-radius: 10px; border-width: 1px; }
.qt-checkbox-size-md-wide { width: 24px; height: 24px; border-radius: 12px; border-width: 1px; }
.qt-checkbox-dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; }
.qt-checkbox-dot-wide { width: 6px; height: 6px; border-radius: 3px; }
.qt-checkbox-disabled { opacity: 0.45; }
</style>
