<template>
  <view v-if="notice != null" class="nts-mask qt-tv-skip" :style="maskStyle" @click="onMaskTap">
    <view ref="tvPanel" class="nts-card qt-tv-skip" :class="layout.isWide ? 'nts-card-wide' : ''" :style="cardStyle" @click.stop>
      <view v-if="hasTitle && !tv.enabled" class="nts-title-wrap" :class="layout.isWide ? 'nts-title-wrap-wide' : ''">
        <text class="nts-title" :class="layout.isWide ? 'nts-title-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(34, 20) + tvLine(20)">{{ notice!.title }}</text>
      </view>
      <scroll-view
        v-if="hasContent || (tv.enabled && hasTitle)"
        class="nts-content qt-tv-scroll"
        direction="vertical"
        :show-scrollbar="false"
        :style="contentStyle"
      >
        <text v-if="tv.enabled && hasTitle" class="nts-title nts-title-wide" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(34, 20) + tvLine(20) + 'margin-bottom:12px;'">{{ notice!.title }}</text>
        <QtRichText
          :html="notice!.content ?? ''"
          :color="themeStore.skin.textMuted"
          :font-size="26"
          :line-height="1.7"
          align="left"
        />
      </scroll-view>
      <view class="nts-actions" :style="tvActionsStyle">
        <view class="nts-btn nts-btn-primary" data-qt-tv-id="notice-know" :class="layout.isWide ? 'nts-btn-wide' : ''" :style="'background-color:' + themeStore.skin.accent + ';' + tvPrimaryStyle" @click="onKnow">
          <text class="nts-btn-text-primary" :class="layout.isWide ? 'nts-btn-text-wide' : ''" :style="('color:' + themeStore.skin.onAccent + ';') + qtFontDual(26, 15) + tvLine(15)">我知道了</text>
        </view>
        <view v-if="hasJump" class="nts-btn nts-btn-secondary" data-qt-tv-id="notice-jump" :class="layout.isWide ? 'nts-btn-wide' : ''" :style="'background-color:' + themeStore.skin.surfaceMuted + ';' + tvSecondaryStyle" @click="onJump">
          <text class="nts-btn-text-secondary" :class="layout.isWide ? 'nts-btn-text-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(24, 15) + tvLine(15)">点击跳转</text>
        </view>
        <view v-if="hasClose" class="nts-check-row" :class="[layout.isWide ? 'nts-check-row-wide' : '', tv.enabled ? 'qt-tv-skip' : '']" :style="tvCheckStyle" @click.stop="toggleHideToday">
          <QtCheckbox data-qt-tv-id="notice-hide-today" :checked="hideToday" :size="layout.isWide ? 'sm' : 'md'" @change="onHideTodayChange" />
          <text class="nts-check-text" :class="layout.isWide ? 'nts-check-text-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(24, 13) + tvLine(13)">今天不显示</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, watch } from "vue";
import QtCheckbox from "@/uni_modules/qt-ui/components/qt-checkbox/qt-checkbox.uvue";
import QtRichText from "@/uni_modules/qt-ui/components/qt-rich-text/qt-rich-text.uvue";
import type { Notice } from "@/types/notice";
import { openNoticeUrl } from "@/services/notice";
import { exitApp } from "@/services/app-native";
import { qtFixedPaneStyle, useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtSheetWidth } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtTv } from "@/uni_modules/qt-ui/composables/use-qt-tv";
import { useQtTvModal } from "@/uni_modules/qt-ui/composables/use-qt-tv-modal";
import { qtFontDual, qtFontValuePx } from "@/uni_modules/qt-ui/stores/font-scale";

const layout = useQtLayout();
const themeStore = useThemeStore();
const tv = useQtTv();
const tvPanel = ref<UniElement | null>(null);
function tvLine(basePx: number): string {
  return tv.enabled ? "line-height:" + Math.ceil(qtFontValuePx(basePx) * 1.4) + "px;" : "";
}
const tvInlineActions = computed((): boolean => tv.enabled && layout.isShort);
const tvInnerWidth = computed((): number => Math.max(0, Math.min(qtSheetWidth("modal"), layout.paneWidth - 56) - 48));
const tvCheckWidth = computed((): number => 56 + 8 + Math.ceil(qtFontValuePx(13) * 5));
// Keep both original actions on the first short-screen line. The checkbox gets
// its own full-width line when three complete labels would exceed the pane.
const tvCheckOwnLine = computed((): boolean => tvInlineActions.value && hasClose.value && tvInnerWidth.value < (hasJump.value ? 2 : 1) * Math.ceil(qtFontValuePx(15) * 4 + 16) + tvCheckWidth.value + (hasJump.value ? 24 : 12));
const tvActionWidth = computed((): number => {
  const reserved = hasClose.value && !tvCheckOwnLine.value ? tvCheckWidth.value + 12 : 0;
  return Math.max(0, Math.floor((tvInnerWidth.value - reserved - (hasJump.value ? 12 : 0)) / (hasJump.value ? 2 : 1)));
});
const tvControlHeight = computed((): number => Math.max(56, Math.ceil(qtFontValuePx(15) * 1.4) + 16));
const tvActionsStyle = computed((): string => tv.enabled ? (tvInlineActions.value ? "flex-direction:row;flex-wrap:wrap;align-items:center;flex-shrink:0;margin-top:16px;" : "flex-shrink:0;") : "flex-shrink:0;");
const tvPrimaryStyle = computed((): string => {
  if (!tv.enabled) return "";
  const h = tvControlHeight.value;
  return "height:" + h + "px;min-height:" + h + "px;flex-shrink:0;border-radius:28px;" + (tvInlineActions.value ? "width:" + tvActionWidth.value + "px;margin-top:0px;" : "margin-top:16px;");
});
const tvSecondaryStyle = computed((): string => {
  if (!tv.enabled) return "";
  const h = tvControlHeight.value;
  return "height:" + h + "px;min-height:" + h + "px;flex-shrink:0;border-radius:28px;" + (tvInlineActions.value ? "width:" + tvActionWidth.value + "px;margin-top:0px;margin-left:12px;" : "margin-top:12px;");
});
const tvCheckStyle = computed((): string => {
  if (!tv.enabled) return "";
  const h = tvControlHeight.value;
  const w = tvCheckOwnLine.value ? tvInnerWidth.value : tvCheckWidth.value;
  return "min-height:" + h + "px;flex-shrink:0;" + (tvInlineActions.value ? "width:" + w + "px;margin-top:" + (tvCheckOwnLine.value ? 12 : 0) + "px;margin-left:" + (tvCheckOwnLine.value ? 0 : 12) + "px;" : "margin-top:12px;");
});

/**
 * 宽屏宽度走统一浮层契约（QT_SHEET_WIDTH.modal = 560），并夹到窗口内。
 * 改造前写死 560px，在 640×360 之类窄横屏上会横出窗口。
 *
 * 高度同理：`.nts-card-wide` 的 `max-height: 560px` 只防「内容太长撑满大屏」，
 * 但 780×360 这类横屏手机（会落进 isWide 分支）整窗才 360px 高，遮罩又是居中对齐，
 * 560px 的卡片会把标题和按钮同时挤到屏幕外 —— 所以上限必须跟窗口高走。
 */
const cardStyle = computed((): string => {
  const bg = "background-color:" + themeStore.skin.sheetSurface + ";";
  if (tv.enabled) {
    const width = Math.max(0, Math.min(qtSheetWidth("modal"), layout.paneWidth - 56));
    const maxH = Math.max(0, layout.paneHeight - 56);
    return bg + "width:" + width + "px;max-height:" + maxH + "px;padding:24px;border-radius:16px;";
  }
  if (!layout.isWide) return bg + "width:" + Math.min(layout.paneWidth - 24, layout.windowWidth * 620 / 750) + "px;";
  const maxH = Math.max(260, layout.paneHeight - 32); // 32 = 上下各 16 的呼吸位
  return bg + "width:" + qtSheetWidth("modal") + "px;max-height:" + maxH + "px;";
});

/** 遮罩底色随主题（浅色 0.52 / 深色 0.64 的 scrim，深色下纯黑遮罩太闷） */
const maskStyle = computed((): string => qtFixedPaneStyle() + "background-color:" + themeStore.skin.scrim + ";" + (tv.enabled ? "z-index:1700;" : ""));

/**
 * 正文区尺寸：宽屏给**确定高度**（scroll-view 在 Vapor 宽屏下 max-height 不保证形成可滚动区块，
 * 内容一长就会把按钮顶出屏幕），但固定 360px 在横屏矮窗里已经超过整窗高度，
 * 所以按窗口高反算并夹到 [120, 360]。
 */
const contentStyle = computed((): string => {
  if (tv.enabled) {
    // Backend titles can wrap arbitrarily; TV title and body share one scroll area.
    const control = tvControlHeight.value;
    const actions = tvInlineActions.value ? 16 + control + (tvCheckOwnLine.value ? 12 + control : 0) : 16 + control + (hasJump.value ? 12 + control : 0) + (hasClose.value ? 12 + control : 0);
    const fixed = 48 + actions;
    const h = Math.max(0, Math.min(360, layout.paneHeight - 56 - fixed));
    return "height:" + h + "px;min-height:0px;flex-shrink:1;margin-top:0px;margin-bottom:0px;";
  }
  if (!layout.isWide) return "margin-top:24rpx;margin-bottom:4rpx;max-height:760rpx;";
  const h = Math.max(120, Math.min(360, layout.paneHeight - 220));
  return "height:" + h + "px;margin-top:14px;margin-bottom:2px;";
});

const props = defineProps<{
  notice: Notice | null;
}>();

const emit = defineEmits<{
  // 回传是否勾选“今天不显示”
  closed: [value: boolean];
}>();
// Locked notices keep consuming Back; exit remains the explicit know action.
useQtTvModal(tvPanel, (): boolean => props.notice != null, (): void => onMaskTap(), 1700);

const hideToday = ref(false);

/** 是否可关闭（决定了“我知道了”行为与复选框显隐） */
const isClosable = computed(() => props.notice != null && (props.notice!.dialogClosable ?? 1) == 1);
const hasTitle = computed(() => props.notice != null && props.notice!.title != null && props.notice!.title!.length > 0);
// 内容富文本：在 JS 侧同步解析后用原生 <text> 渲染，与标题同帧出现（不走异步的 rich-text）
const hasContent = computed(() => props.notice != null && props.notice!.content != null && props.notice!.content!.length > 0);
/** 是否存在跳转链接 */
const hasJump = computed(() => props.notice != null && props.notice!.url != null && props.notice!.url!.length > 0);
const hasClose = isClosable;

/** 切换“今天不显示” */
function toggleHideToday(): void {
  hideToday.value = !hideToday.value;
}
// Checkbox click.stop，文本/整行仍可切换，单次点击只更新一次。
function onHideTodayChange(checked: boolean): void { hideToday.value = checked; }

/** “我知道了”：可关闭则关闭当前弹窗；不可关闭则退出APP */
function onKnow(): void {
  if (!isClosable.value) {
    exitApp();
    return;
  }
  emit("closed", hideToday.value);
}

/** “点击跳转”：打开跳转链接并关闭当前弹窗 */
function onJump(): void {
  const url = props.notice != null ? props.notice!.url : "";
  openNoticeUrl(url);
  emit("closed", hideToday.value);
}

/** 点击遮罩：仅可关闭时关闭 */
function onMaskTap(): void {
  if (isClosable.value) {
    emit("closed", hideToday.value);
  }
}

// 切换到下一条开屏时重置勾选状态
watch(
  () => props.notice,
  () => {
    hideToday.value = false;
  }
);
</script>

<style>
.nts-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  /* 底色走 maskStyle（skin.scrim），深浅主题不同透明度 */
  justify-content: center;
  align-items: center;
  z-index: 999;
}
.nts-card {
  width: 620rpx;
  max-height: 1100rpx;
  border-radius: 32rpx;
  /* 底色走 cardStyle（skin.sheetSurface），深色下不再是一块刺眼的纯白 */
  padding: 40rpx 40rpx 32rpx;
  overflow: hidden;
}
.nts-title-wrap {
  justify-content: center;
  align-items: center;
}
.nts-title {
  /* 颜色走行内（skin.text） */
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}
.nts-content {
  margin-top: 24rpx;
  margin-bottom: 4rpx;
}
.nts-btn {
  height: 72rpx;
  justify-content: center;
  align-items: center;
  border-radius: 36rpx;
  margin-top: 28rpx;
}
.nts-btn-primary {
}
.nts-btn-text-primary {
  font-size: 26rpx;
  font-weight: 600;
}
.nts-btn-secondary {
  margin-top: 16rpx;
  /* 底色走行内（skin.surfaceMuted） */
}
.nts-btn-text-secondary {
  /* 颜色走行内（skin.textMuted） */
  font-size: 24rpx;
}
.nts-check-row {
  margin-top: 24rpx;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
.nts-check-text {
  margin-left: 14rpx;
  /* 颜色走行内（skin.textMuted） */
  font-size: 24rpx;
}

/* Vapor 宽屏：px 覆盖 rpx。弹窗限宽 560px 居中，避免 620rpx 在
   1600x900 / 2560x1440 上被放大到 800-940dp 占满整屏 */
.nts-card-wide {
  /* 宽度改由 cardStyle 内联给出（走 qtSheetWidth 契约，窄窗口自动夹紧） */
  max-height: 560px;
  border-radius: 16px;
  padding: 24px 24px 20px;
}
.nts-title-wrap-wide {
  justify-content: center;
  align-items: center;
}
.nts-title-wide {
  font-size: 20px;
  line-height: 28px;
}
.nts-btn-wide {
  height: 44px;
  border-radius: 22px;
  margin-top: 16px;
}
.nts-btn-text-wide {
  font-size: 15px;
}
.nts-check-row-wide {
  margin-top: 14px;
}
.nts-checkbox-wide {
  width: 16px;
  height: 16px;
  border-radius: 4px;
}
.nts-check-text-wide {
  margin-left: 8px;
  font-size: 13px;
}
</style>
