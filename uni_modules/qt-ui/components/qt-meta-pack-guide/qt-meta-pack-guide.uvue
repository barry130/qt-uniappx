  width: 48px;
  height: 48px;
  border-radius: 12px;
}
.mg-title {
  margin-top: 24rpx;
  color: #191d26;
  font-size: 34rpx;
  font-weight: 700;
}
.mg-title-wide {
  margin-top: 14px;
  font-size: 18px;
}
