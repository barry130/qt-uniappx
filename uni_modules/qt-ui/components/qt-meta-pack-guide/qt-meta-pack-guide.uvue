  margin-top: 10rpx;
  color: #6b7385;
  font-size: 24rpx;
}
.mg-sub-wide {
  margin-top: 6px;
  font-size: 13px;
}
.mg-divider {
  margin-top: 28rpx;
  width: 520rpx;
  height: 1px;
  background-color: #eef1f7;
}
.mg-divider-wide {
  margin-top: 16px;
  width: 356px;
}
.mg-body {
  margin-top: 24rpx;
  color: #596173;
  font-size: 26rpx;
  line-height: 1.6;
}
.mg-body-wide {
  margin-top: 14px;
  font-size: 14px;
}
.mg-actions {
  margin-top: 36rpx;
  flex-direction: row;
  align-items: center;
}
.mg-actions-wide {
  margin-top: 20px;
}
.mg-btn {
  margin-left: 20rpx;
}
.mg-btn-wide {
  margin-left: 12px;
}
</style>
