<!--
  「回到顶部」悬浮按钮（右下角）
  用法：<QtBackToTop :visible="showBackToTop" @tap="backToTop" />
  - visible：是否显示，由外层滚动容器根据滚动距离传入（滚动一定距离后再显示）
  - tap：用户点击，由外层执行真正的滚动回顶部
  仅一枚头朝上的小火箭图标（无底色圆形）；位置用 JS 计算 px 再以 fixed+left/top 定位，
  与迷你悬浮球一致，避免 calc()/env() 在该 Vapor 版本不生效导致跑到左上角。
  刻意**不改成 absolute**（2026-10-25）：坐标是窗口系（事件/窗口尺寸直接算），而
  absolute 会锚到 frame 内容区或页内容器，原点在标题栏/状态栏之下（搜索/歌单页还
  额外让开内容列内边距），窗口坐标直接用必然错位。代价是宽屏托管工具页里本按钮被
  覆盖层压住不可见（既有表现），关工具后偶有残留副本与宿主页自己的同位按钮重叠。
-->
<template>
  <view
    v-if="visible"
    class="qt-back-to-top"
    :class="layout.isWide ? 'qt-back-to-top-wide' : ''"
    :style="posStyle"
    @click="$emit('tap')"
  >
    <QtIcon name="rocket" :size="layout.isWide ? 28 : 56" :color="theme.skin.icon" />
  </view>
</template>

<script setup lang="ts">
import { computed } from "vue";
import { qtRpx, useQtLayout, qtPlayerBarHeightPx, qtTabBarHeightPx } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useMiniPlayerSettings } from "@/uni_modules/qt-ui/stores/mini-player";
import { qtMiniDockReservePx } from "@/uni_modules/qt-ui/composables/mini-player-layout";
import { usePlayerStore } from "@/stores/player";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";

defineProps<{
  visible: boolean;
}>();

const layout = useQtLayout();
const player = usePlayerStore();
const miniSettings = useMiniPlayerSettings();
const theme = useThemeStore();

defineEmits<{
  (e: "tap"): void;
}>();

// No per-instance window query or resize watcher: use the shared reactive snapshot.
const posStyle = computed((): string => {
  const size = layout.isWide ? 40 : qtRpx(80);
  const right = layout.isWide ? 24 : qtRpx(24);
  const bottom = miniSettings.mode == "docked" && player.current != null
    ? qtMiniDockReservePx(!layout.isWide) + (layout.isWide ? 20 : qtRpx(16))
    : (layout.isWide ? layout.safeBottomPx + 20 : qtTabBarHeightPx() + qtRpx(16));
  const left = Math.max(0, layout.windowWidth - right - size);
  const top = Math.max(0, layout.windowHeight - bottom - size);
  return "left:" + left + "px;top:" + top + "px;";
});
</script>

<style>
/* fixed + 内联 left/top：与迷你悬浮球相同的定位方式，稳定不跑位。
   不能改 absolute：坐标是窗口系，absolute 锚点在标题栏/状态栏之下会错位（见头部注释） */
.qt-back-to-top {
  position: fixed;
  z-index: 950;
  width: 80rpx;
  height: 80rpx;
  justify-content: center;
  align-items: center;
}
.qt-back-to-top-wide { width: 40px; height: 40px; }
</style>
