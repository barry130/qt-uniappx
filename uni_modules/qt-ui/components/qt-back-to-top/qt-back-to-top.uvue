<!--
  「回到顶部」悬浮按钮（右下角）
  用法：<QtBackToTop :visible="showBackToTop" @tap="backToTop" />
  - visible：是否显示，由外层滚动容器根据滚动距离传入（滚动一定距离后再显示）
  - tap：用户点击，由外层执行真正的滚动回顶部
  仅一枚头朝上的小火箭图标（无底色圆形）；位置用 JS 计算 px 再以 fixed+left/top 定位，
  与迷你悬浮球一致，避免 calc()/env() 在该 Vapor 版本不生效导致跑到左上角。
  刻意**不改成 absolute**（2026-10-25）：坐标是窗口系（事件/窗口尺寸直接算），而
  absolute 会锚到 frame 内容区或页内容器，原点在标题栏/状态栏之下（搜索/歌单页还
  额外让开内容列内边距），窗口坐标直接用必然错位。代价是宽屏托管工具页里本按钮被
  覆盖层压住不可见（既有表现），关工具后偶有残留副本与宿主页自己的同位按钮重叠。
-->
<template>
  <view
    v-if="visible"
    class="qt-back-to-top"
    :class="layout.isWide ? 'qt-back-to-top-wide' : ''"
    :style="posStyle"
    @click="$emit('tap')"
  >
    <QtIcon name="rocket" :size="64" color="#3f4756" />
  </view>
</template>

<script setup lang="ts">
import { ref, computed, watch, onMounted } from "vue";
import { qtRpx, useQtLayout, QT_PLAYER_BAR_HEIGHT_PX } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { usePlayerStore } from "@/stores/player";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";

defineProps<{
  visible: boolean;
}>();

const layout = useQtLayout();
const player = usePlayerStore();

defineEmits<{
  (e: "tap"): void;
}>();

/** 图标尺寸与右边距/底边距（rpx） */
const SIZE = 80;
const MARGIN_RIGHT = 24;
const MARGIN_BOTTOM = 150;

const left = ref(0);
const top = ref(0);
const posStyle = computed((): string => "left:" + left.value + "px;top:" + top.value + "px;");

function reposition(): void {
  const win = uni.getWindowInfo();
  // 宽屏有常驻底栏时上抬 64px，否则按钮贴在底栏右端、和进度条重叠。
  // 屏幕上抬量用 px（桌面不随 rpx 缩放），手机仍走 rpx。
  const lift = layout.isWide && player.current != null ? QT_PLAYER_BAR_HEIGHT_PX : 0;
  left.value = win.windowWidth - qtRpx(MARGIN_RIGHT) - qtRpx(SIZE);
  top.value = win.windowHeight - qtRpx(MARGIN_BOTTOM) - qtRpx(SIZE) - lift;
}

onMounted(() => {
  reposition();
});

// 旋转/分屏后窗口尺寸变化，fixed 的 px 定位必须重算，
// 否则竖转横后 top 超出新 windowHeight，按钮消失在屏幕外。
// 同时监听「是否有当前歌曲」：底栏的出现/消失会改变可用的底部空间。
watch(
  () => [layout.windowWidth, layout.windowHeight, player.current != null],
  () => {
    reposition();
  }
);
</script>

<style>
/* fixed + 内联 left/top：与迷你悬浮球相同的定位方式，稳定不跑位。
   不能改 absolute：坐标是窗口系，absolute 锚点在标题栏/状态栏之下会错位（见头部注释） */
.qt-back-to-top {
  position: fixed;
  z-index: 950;
  width: 80rpx;
  height: 80rpx;
  justify-content: center;
  align-items: center;
}
.qt-back-to-top-wide { width: 40px; height: 40px; }
</style>
