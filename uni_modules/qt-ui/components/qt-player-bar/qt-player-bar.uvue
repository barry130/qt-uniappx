<!-- HD dock: equal wings keep the transport centered; native slider handles hosted-page dragging. -->
<template>
  <view v-if="visible" class="pbar" :style="barStyle" @click.stop="openPlayerPage">
    <view class="pbar-left" :style="wingStyle">
      <view class="pbar-song" @click.stop="openPlayerPage">
        <image class="pbar-cover" :style="coverStyle" :src="cover" mode="aspectFill" @error="onCoverError" />
        <view class="pbar-copy" :style="copyStyle">
          <text class="pbar-title" :style="('color:' + theme.skin.text + ';') + qtFontPx(14)" :max-lines="1">{{ title }}</text>
          <text class="pbar-artist" :style="('color:' + theme.skin.textMuted + ';') + qtFontPx(12)" :max-lines="1">{{ artist }}</text>
        </view>
      </view>
      <view v-if="metrics.showLike" class="pbar-btn" hover-class="pbar-btn-hover" @click.stop="toggleLike">
        <QtIcon :name="liked ? 'heart-fill' : 'heart'" :size="19" :color="liked ? theme.skin.danger : theme.skin.iconMuted" />
      </view>
    </view>
    <view class="pbar-center" :style="centerStyle" @click.stop>
      <view class="pbar-controls">
        <view class="pbar-btn" hover-class="pbar-btn-hover" @click.stop="prevTrack"><QtIcon name="skip-back" :size="20" :color="theme.skin.icon" /></view>
        <view class="pbar-main" :style="'background-color:' + theme.skin.accent + ';'" hover-class="pbar-btn-hover" @click.stop="togglePlay"><QtIcon :name="playing ? 'pause' : 'play'" :size="21" :color="theme.skin.onAccent" /></view>
        <view class="pbar-btn" hover-class="pbar-btn-hover" @click.stop="nextTrack"><QtIcon name="skip-forward" :size="20" :color="theme.skin.icon" /></view>
      </view>
      <view class="pbar-progress" :style="progressStyle">
        <text v-if="metrics.showTimes" class="pbar-time" :style="timeStyle">{{ posText }}</text>
        <slider class="pbar-seek" :min="0" :max="1000" :step="1" :value="seekPercent" :disabled="player.duration <= 0 || !castCanSeek" track-class="pbar-slider-track" track-active-class="pbar-slider-active" thumb-class="pbar-slider-thumb" @touchstart="onSeekStart" @touchcancel="onSeekCancel" @changing="onSeekChanging" @change="onSeekChange" />
        <text v-if="metrics.showTimes" class="pbar-time" :style="timeStyle">{{ durText }}</text>
      </view>
    </view>
    <view class="pbar-right" :style="wingStyle" @click.stop>
      <view v-if="dlnaSupported()" class="pbar-btn" hover-class="pbar-btn-hover" @click.stop="openDlna"><QtIcon name="cast" :size="19" :color="casting ? theme.skin.accent : theme.skin.iconMuted" /></view>
      <view class="pbar-btn" hover-class="pbar-btn-hover" @click.stop="cycleMode"><QtIcon :name="modeIcon" :size="19" :color="theme.skin.iconMuted" /></view>
      <view v-if="showVolume" class="pbar-volume">
        <view class="pbar-btn" hover-class="pbar-btn-hover" @click.stop="toggleMute"><QtIcon :name="volumeIconName()" :size="19" :color="theme.skin.iconMuted" /></view>
        <slider class="pbar-vol-slider" :min="0" :max="100" :step="1" :value="volPercent" track-class="pbar-slider-track" track-active-class="pbar-slider-active" thumb-class="pbar-slider-thumb" @changing="onVolChanging" @change="onVolChange" />
      </view>
      <view class="pbar-btn" hover-class="pbar-btn-hover" @click.stop="openQueue"><QtIcon name="list" :size="21" :color="theme.skin.icon" /></view>
    </view>
  </view>
</template>
<script setup lang="ts">
import { computed, ref, onMounted, onUnmounted, watch } from "vue";
import { useMiniPlayerSettings } from "@/uni_modules/qt-ui/stores/mini-player";
import { usePlayerStore } from "@/stores/player";
import { useQtLayout, qtRailWidth } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { qtFontPx, fontScale } from "@/uni_modules/qt-ui/stores/font-scale";
import { qtPlayerBarHeightPx } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtHdPlayerMetrics } from "@/uni_modules/qt-ui/composables/hd-layout";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import { qtShowToast } from "@/services/toast";
import { audioPlayer, PLAYER_VOLUME_CHANGED_EVENT } from "@/services/audio-player";
import { dlnaSupported, openDlna, dlnaUiState } from "@/services/dlna";
const castUi = dlnaUiState();
const casting = computed((): boolean => castUi.state.value != null && castUi.state.value!.target == "dlna");
const castCanSeek = computed((): boolean => !casting.value || castUi.state.value!.canSeek);

const props = defineProps<{
  /**
   * 停靠模式：给 qt-wide-workspace 覆盖层用（内联 absolute，随覆盖层显隐）。
   *
   * 为什么需要第二份：宽屏工具页（搜索/榜单/歌单广场/每日新歌/设置）是被覆盖层
   * z-index:1000 整个盖住宿主页的，宿主页那条 fixed 底栏（z-index:940）根本看不见；
   * 工具页自己又被框架层禁掉了底栏（showPlayerBar 要求 hostedRoute 为空）。
   * 结果就是「打开工具页 → 播放控制整条消失」，只能靠返回键回到宿主页才能再暂停。
   * 网易云 / QQ 音乐 pad 版换页时底栏是常驻的，这里补上同一条。
   */
  docked?: boolean;
}>();
const emit = defineEmits<{ queue: [] }>();

const player = usePlayerStore();
const layout = useQtLayout();
const theme = useThemeStore();

/**
 * 固定模式的宽屏布局；手机固定模式由 qt-mini-player 的长条承接。
 */
const miniSettings = useMiniPlayerSettings();
const visible = computed((): boolean => miniSettings.mode == "docked" && layout.isWide && player.current != null);

/**
 * 可用宽度 = 窗口宽 - rail 宽。
 * 所有分档都必须用它算：rail 在 medium 档是 64px、wide 档是 96px，
 * 直接拿 windowWidth 判断会在「900px 窗口 + rail」时高估一截 rail 宽，
 * 结果就是进度条被挤没（真机表现：总时长被裁掉）。
 */
const innerWidth = computed((): number => Math.max(0, layout.windowWidth - qtRailWidth()));

const metrics = computed(() => qtHdPlayerMetrics(innerWidth.value, fontScale.scale));
const showVolume = computed((): boolean => metrics.value.showVolume && metrics.value.wingPx >= 216 + (dlnaSupported() ? 40 : 0) && (!casting.value || castUi.state.value!.canSetVolume));
const wingStyle = computed((): string => "width:" + metrics.value.wingPx + "px;");
const centerStyle = computed((): string => "width:" + metrics.value.centerPx + "px;");
const progressStyle = computed((): string => "width:" + Math.min(560, metrics.value.centerPx) + "px;");
const coverStyle = computed((): string => "width:" + metrics.value.coverPx + "px;height:" + metrics.value.coverPx + "px;background-color:" + theme.skin.coverPlaceholder + ";");
const copyStyle = computed((): string => "width:" + metrics.value.copyPx + "px;");
const timeStyle = computed((): string => "width:" + metrics.value.timePx + "px;color:" + theme.skin.textSubtle + ";" + qtFontPx(11));
// fixed host and absolute hosted dock share the same safe-area budget as the frame.
const barStyle = computed((): string => {
  const base = "left:" + qtRailWidth() + "px;top:" + Math.max(0, layout.windowHeight - qtPlayerBarHeightPx()) + "px;bottom:auto;height:" + qtPlayerBarHeightPx() + "px;padding-bottom:" + layout.safeBottomPx + "px;background-color:" + theme.skin.surface + ";border-top-color:" + theme.skin.divider + ";";
  return (props.docked == true ? "position:absolute;right:0;" : "") + base;
});
const title = computed((): string => {
  const cur = player.current;
  return cur != null ? cur.name : "";
});
const artist = computed((): string => {
  const cur = player.current;
  return cur != null ? cur.singer : "";
});
const cover = computed((): string => {
  const cur = player.current;
  // 在播本地文件有内嵌封面就用它（coverOf 内部回落到 song.picUrl）
  return cur != null ? player.coverOf(cur) : "";
});
const playing = computed((): boolean => player.playing);
function onCoverError(): void {
  const song = player.current;
  if (song != null) player.recoverCover(song, cover.value);
}

/** 拖动预览值（秒）；-1 表示未在拖动，直接用 store 进度 */
const dragValue = ref(-1);
const displayProgress = computed((): number => {
  if (dragValue.value >= 0) return dragValue.value;
  return player.progress;
});
const ratio = computed((): number => {
  const d = player.duration;
  if (d <= 0) return 0;
  return Math.max(0, Math.min(1, displayProgress.value / d));
});

const seekPercent = computed((): number => Math.round(ratio.value * 1000));
// A drag belongs to the track that started it. A late release after a native track
// transition must not seek the newly playing song.
let seekTrackKey = "";
function currentTrackKey(): string {
  const cur = player.current;
  return cur == null ? "" : cur.platform + ":" + cur.id + ":" + player.playbackRevision();
}
function onSeekStart(): void {
  seekTrackKey = currentTrackKey();
  dragValue.value = -1;
}
function onSeekCancel(): void {
  seekTrackKey = "cancelled";
  dragValue.value = -1;
}
function onSeekChanging(event: UniSliderChangeEvent): void {
  if (player.duration <= 0) return;
  if (seekTrackKey.length == 0) seekTrackKey = currentTrackKey();
  if (seekTrackKey != currentTrackKey()) return;
  dragValue.value = Math.max(0, Math.min(1000, event.detail.value)) / 1000 * player.duration;
}
function onSeekChange(event: UniSliderChangeEvent): void {
  const valid = seekTrackKey.length == 0 || seekTrackKey == currentTrackKey();
  seekTrackKey = "";
  dragValue.value = -1;
  if (valid && player.duration > 0) player.seek(Math.max(0, Math.min(1000, event.detail.value)) / 1000 * player.duration);
}
watch(() => currentTrackKey(), () => { dragValue.value = -1; });
// ── 收藏 / 播放模式 / 队列 ───────────────────────────────────────────────
/**
 * 红心口径与播放页一致：player.isLiked = 「这首歌在任意一个自建歌单里」。
 * 因此点击不能简单取反（取反要先决定从哪个歌单摘掉），走与播放页同一个
 * 歌单选择器；没有任何歌单时先提示去新建。
 */
const liked = computed((): boolean => {
  const cur = player.current;
  return cur != null && player.isLiked(cur);
});

function toggleLike(): void {
  const cur = player.current;
  if (cur == null) return;
  if (!player.canPickPlaylist()) {
    qtShowToast({ title: "还没有歌单，请先新建", icon: "none" });
    return;
  }
  player.showPlaylistPickerFor(cur);
}

/** 播放模式图标与播放页 modeIconName() 同口径（random→shuffle，single→repeat-1） */
const modeIcon = computed((): string => {
  if (player.mode == "random") return "shuffle";
  if (player.mode == "single") return "repeat-1";
  return "repeat";
});

function cycleMode(): void {
  player.cycleMode();
  qtShowToast({ title: "播放模式：" + player.modeLabel(), icon: "none" });
}

/** The window-sized owner opens its queue; this button never changes pages. */
function openQueue(): void {
  emit("queue");
}

// ── 音量 ─────────────────────────────────────────────────────────────────
// 音量用原生 <slider>（宽度由 .pbar-vol-slider 的 CSS 控制），不再自绘轨道，
// 所以没有「左边界/宽度常量要与 CSS 同步」的负担。

const volPercent = ref(Math.round(audioPlayer.getVolume() * 100));
const muted = ref(audioPlayer.getMuted());

/**
 * 图标名用「函数 + return 字面量」而不是三元表达式：
 * tools/check-uvue.mjs 的 indirectIcons() 只认 `return "xxx"` 形式的间接引用，
 * 写成三元会被判成 UNUSED 图标而让 npm run check 失败（与 modeIconName() 同法）。
 */
function volumeIconName(): string {
  if (muted.value || volPercent.value <= 0) return "volume-mute";
  return "volume";
}

/**
 * 音量（原生 slider）：拖动中只改内存里的 volPercent（原生控件自己重绘），
 * 松手才 writeVolume——每帧都写一次持久化键会掉帧（同 player 页拖进度的手感要求）。
 * muted 与 volPercent 联动：拖到 >0 自动解除静音，拖到 0 自动变静音图标。
 */
function onVolChanging(event: UniSliderChangeEvent): void {
  const next = Math.round(event.detail.value);
  if (next < 0 || next > 100) return;
  volPercent.value = next;
}
function onVolChange(event: UniSliderChangeEvent): void {
  const next = Math.round(event.detail.value);
  volPercent.value = next < 0 ? 0 : next > 100 ? 100 : next;
  audioPlayer.setVolume(volPercent.value / 100);
  if (volPercent.value > 0 && muted.value) {
    muted.value = false;
    audioPlayer.setMuted(false);
  }
}
function toggleMute(): void {
  const next = !muted.value;
  muted.value = next;
  audioPlayer.setMuted(next);
  qtShowToast({ title: next ? "已静音" : "取消静音", icon: "none" });
}

/**
 * 从包装层重读音量/静音快照。setup 时的 ref 只是一次性快照，设置在别处被改写
 * （缓存页 resetSettings 等）时 UI 会脱节；订阅 PLAYER_VOLUME_CHANGED_EVENT
 * （applyVolume 广播）重读即可。本组件滑杆自己触发的写入重读回来是幂等 no-op。
 */
function syncVolumeSnapshot(): void {
  const next = Math.round(audioPlayer.getVolume() * 100);
  volPercent.value = next < 0 ? 0 : next > 100 ? 100 : next;
  muted.value = audioPlayer.getMuted();
}

function formatTime(sec: number): string {
  if (sec < 0 || !isFinite(sec)) return "0:00";
  const total = Math.floor(sec);
  const m = Math.floor(total / 60);
  const s = total % 60;
  return m + ":" + (s < 10 ? "0" + s : "" + s);
}
const posText = computed((): string => formatTime(displayProgress.value));
const durText = computed((): string => formatTime(player.duration));

function togglePlay(): void {
  player.toggle();
}
function prevTrack(): void {
  player.previous();
}
function nextTrack(): void {
  player.next(false);
}
function openPlayerPage(): void {
  try {
    const pages = getCurrentPages();
    if (pages.length > 0) {
      const top = pages[pages.length - 1];
      const route = top.route;
      if (route != null && route == "pages/player/index") return;
    }
  } catch (_) {
    // 静默：页面栈读不到时照常跳转播放页（守卫只为防重复进入）
  }
  uni.navigateTo({ url: "/pages/player/index" });
}

onMounted(() => { uni.$on(PLAYER_VOLUME_CHANGED_EVENT, syncVolumeSnapshot); });
onUnmounted(() => { uni.$off(PLAYER_VOLUME_CHANGED_EVENT, syncVolumeSnapshot); });
</script>

<style>
.pbar { position: absolute; right: 0; bottom: 0; z-index: 940; flex-direction: row; align-items: center; padding-left: 16px; padding-right: 16px; border-top-width: 1px; border-top-style: solid; }
.pbar-left { flex-direction: row; align-items: center; flex-shrink: 0; }
.pbar-song { flex-direction: row; align-items: center; min-width: 0; }
.pbar-cover { border-radius: 8px; flex-shrink: 0; }
.pbar-copy { justify-content: center; margin-left: 12px; overflow: hidden; }
.pbar-title { font-weight: 600; }
.pbar-artist { margin-top: 4px; }
.pbar-center { flex-shrink: 0; align-items: center; }
.pbar-controls { flex-direction: row; align-items: center; justify-content: center; }
.pbar-btn { width: 40px; height: 40px; border-radius: 20px; justify-content: center; align-items: center; flex-shrink: 0; }
.pbar-btn-hover { background-color: rgba(127,127,127,0.12); }
.pbar-main { width: 40px; height: 40px; border-radius: 20px; margin-left: 14px; margin-right: 14px; justify-content: center; align-items: center; flex-shrink: 0; }
.pbar-progress { width: 100%; flex-direction: row; align-items: center; height: 28px; }
.pbar-time { text-align: center; flex-shrink: 0; }
.pbar-seek { flex: 1; min-width: 0; height: 28px; margin-left: 8px; margin-right: 8px; }
.pbar-right { flex-direction: row; justify-content: flex-end; align-items: center; flex-shrink: 0; }
.pbar-volume { flex-direction: row; align-items: center; }
.pbar-vol-slider { width: 88px; height: 32px; margin-left: 4px; margin-right: 4px; }
.pbar-slider-track { height: 3px; background-color: rgba(128,128,128,0.24); }
.pbar-slider-active { height: 3px; background-color: #888888; }
.pbar-slider-thumb { width: 12px; height: 12px; background-color: #ffffff; border-width: 1px; border-style: solid; border-color: #888888; }
</style>
