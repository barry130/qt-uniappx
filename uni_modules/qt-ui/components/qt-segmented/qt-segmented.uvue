<template>
  <view ref="rootRef" class="seg" :class="layout.isWide ? 'seg-wide' : ''" :style="rootStyle">
    <view v-if="!scrollable" class="seg-flex">
      <view v-for="(item, index) in list" :key="index" class="seg-item" :class="layout.isWide ? 'seg-item-wide' : ''" :style="itemStyle(index)" @click="select(index)">
        <text class="seg-text" :class="layout.isWide ? 'seg-text-wide' : ''" :style="textStyle(index)">{{ item }}</text>
      </view>
    </view>
    <scroll-view v-else class="seg-scrolllist" direction="horizontal" :show-scrollbar="false" :scroll-left="scrollLeftPx" :style="'height:' + rowHeightPx + 'px;'" @scroll="onScroll">
      <view class="seg-auto" :style="'width:' + autoRowWidth + 'px;'">
        <view v-for="(item, index) in list" :key="index" class="seg-item seg-item-auto" :class="layout.isWide ? 'seg-item-wide seg-item-auto-wide' : ''" :style="itemStyle(index)" @click="select(index)">
          <text class="seg-text" :class="layout.isWide ? 'seg-text-wide' : ''" :style="textStyle(index)">{{ item }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>
<script setup lang="ts">
import { computed, ref, watch, nextTick, onMounted, onUnmounted } from "vue";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { qtFontDual, fontScale } from "@/uni_modules/qt-ui/stores/font-scale";
import { qtSelectionColor, qtSelectionIndex, qtSelectionScrollOffset } from "@/uni_modules/qt-ui/composables/selection";
const props = defineProps<{
  list: string[];
  modelValue: number;
  /** Total horizontal padding in px when positive; replaces the default padding. */
  itemGap?: number;
  /** false keeps equal-width segments; true uses native horizontal scrolling. */
  scrollable?: boolean;
}>();
const emit = defineEmits<{ "update:modelValue": [value: number]; change: [value: number] }>();
const layout = useQtLayout();
const theme = useThemeStore();
const rootRef = ref<UniElement | null>(null);
const selectedColor = computed((): string => qtSelectionColor(theme.dark));
const selectedIndex = computed((): number => qtSelectionIndex(props.modelValue, props.list.length));
const unit = computed((): number => layout.windowWidth / 750);
const itemGap = computed((): number => Math.max(0, props.itemGap ?? 0));
// The inline itemGap padding overrides CSS; never add both in the estimate.
const autoPadPx = computed((): number => itemGap.value > 0 ? itemGap.value : layout.isWide ? 24 : 48 * unit.value);
const rowHeightPx = computed((): number => layout.isWide ? 36 : Math.ceil(60 * unit.value));
const viewportPx = ref(0);
const boxStarts = ref<number[]>([]);
const boxWidths = ref<number[]>([]);
const measuredContent = ref(0);
const scrollLeftPx = ref(0);
let currentLeft = 0;
let mounted = false;
let generation = 0;
let timer = 0;
function labelWidthPx(text: string): number {
  const fontPx = (layout.isWide ? 14 : 26 * unit.value) * fontScale.scale;
  let units = 0;
  for (let i = 0; i < text.length; i++) units += text.charCodeAt(i) > 127 ? 1.06 : 0.82;
  return Math.ceil(units * fontPx);
}
function estimatedBoxWidth(index: number): number { return labelWidthPx(props.list[index]) + autoPadPx.value; }
const autoRowWidth = computed((): number => {
  if (measuredContent.value > 0) return measuredContent.value;
  let sum = 0;
  for (let i = 0; i < props.list.length; i++) sum += estimatedBoxWidth(i);
  return sum;
});
// 非滚动模式的宽度下限。等分宽度的分段器靠父级拉伸拿宽度，一旦父级是 row 容器
// （如统计页「歌曲/歌手/音源」那一行 `.daily-kinds`），`.seg-item` 的 flex:1 基准是 0，
// 整条会被压到接近 0 宽、几个标签的文字互相压住（2026-11-02 反馈页同款坑）。
// 这里按「最长标签宽 + 单项呼吸位」× 项数算出内容宽度，任何父容器下都不会缩没。
const minContentPx = computed((): number => {
  const count = props.list.length;
  if (count <= 0) return 0;
  let widest = 0;
  for (let i = 0; i < count; i++) {
    const width = labelWidthPx(props.list[i]);
    if (width > widest) widest = width;
  }
  const breathing = itemGap.value > 0 ? itemGap.value : layout.isWide ? 28 : 56 * unit.value;
  return Math.ceil(count * (widest + breathing) + (layout.isWide ? 8 : 12 * unit.value));
});
// 根节点样式：滚动模式交给 scroll-view 自己撑，不设下限（否则会顶掉横滑能力）
const rootStyle = computed((): string => {
  let style = 'background-color:' + theme.skin.surfaceMuted + ';';
  if (!props.scrollable) style += 'min-width:' + minContentPx.value + 'px;';
  return style;
});
const selectedOffset = computed((): number => {
  const index = selectedIndex.value;
  if (index < 0) return -1;
  if (boxStarts.value.length == props.list.length) return boxStarts.value[index];
  let sum = 0;
  for (let i = 0; i < index; i++) sum += estimatedBoxWidth(i);
  return sum;
});
function reveal(index: number): void {
  if (!props.scrollable || index < 0 || index >= props.list.length) return;
  let start = 0;
  for (let i = 0; i < index; i++) start += estimatedBoxWidth(i);
  let width = estimatedBoxWidth(index);
  if (boxStarts.value.length == props.list.length) { start = boxStarts.value[index]; width = boxWidths.value[index]; }
  const target = qtSelectionScrollOffset(start, start + width, viewportPx.value, currentLeft, autoRowWidth.value);
  // Reassigning the old binding after a manual drag otherwise does nothing natively.
  const max = Math.max(0, autoRowWidth.value - viewportPx.value);
  const bound = target == scrollLeftPx.value && target != currentLeft && max > 0 ? (target < max ? Math.min(max, target + 0.1) : Math.max(0, target - 0.1)) : target;
  currentLeft = bound;
  scrollLeftPx.value = bound;
}
function cancelMeasure(): void { generation += 1; if (timer != 0) { clearTimeout(timer); timer = 0; } }
function measure(token: number, attempt: number): void {
  if (!mounted || token != generation || !props.scrollable) return;
  const root = rootRef.value;
  const viewport = root != null ? root.querySelector('.seg-scrolllist') : null;
  const row = root != null ? root.querySelector('.seg-auto') : null;
  const items = row != null ? row.querySelectorAll('.seg-item-auto') : [];
  if (viewport == null || row == null || viewport.getBoundingClientRect().width <= 0 || items.length != props.list.length) {
    if (attempt < 3) timer = setTimeout(() => { if (!mounted || token != generation) return; timer = 0; measure(token, attempt + 1); }, 80) as number;
    return;
  }
  viewportPx.value = viewport.getBoundingClientRect().width;
  const origin = row.getBoundingClientRect().left;
  const starts: number[] = [];
  const widths: number[] = [];
  let end = 0;
  for (let i = 0; i < items.length; i++) {
    const box = items[i].getBoundingClientRect();
    if (box.width <= 0) return;
    starts.push(box.left - origin); widths.push(box.width);
    end = Math.max(end, box.right - origin);
  }
  boxStarts.value = starts; boxWidths.value = widths;
  measuredContent.value = end;
  reveal(selectedIndex.value);
}
function scheduleMeasure(): void {
  cancelMeasure();
  if (!mounted || !props.scrollable) return;
  const token = generation;
  nextTick(() => { if (mounted && token == generation) timer = setTimeout(() => { if (!mounted || token != generation) return; timer = 0; measure(token, 0); }, 32) as number; });
}
watch((): string => props.list.join('\u0001') + ':' + itemGap.value + ':' + props.scrollable + ':' + layout.sizeEpoch + ':' + fontScale.scale, () => {
  boxStarts.value = []; boxWidths.value = []; measuredContent.value = 0; viewportPx.value = 0;
  scheduleMeasure();
});
// Selection, viewport, content and font changes all matter, even if start stays zero.
watch((): string => selectedIndex.value + ':' + selectedOffset.value + ':' + viewportPx.value + ':' + autoRowWidth.value + ':' + fontScale.scale, () => { reveal(selectedIndex.value); scheduleMeasure(); }, { immediate: true });
onMounted(() => { mounted = true; scheduleMeasure(); });
onUnmounted(() => { mounted = false; cancelMeasure(); });
function onScroll(e: any): void { if (e.detail != null) currentLeft = Number(e.detail.scrollLeft ?? 0); }
function textStyle(index: number): string { return 'color:' + (selectedIndex.value == index ? selectedColor.value : theme.skin.textSubtle) + ';' + qtFontDual(26, 14); }
function itemStyle(index: number): string {
  let style = selectedIndex.value == index ? 'background-color:' + theme.skin.surface + ';' : '';
  if (itemGap.value > 0) style += 'padding-left:' + itemGap.value / 2 + 'px;padding-right:' + itemGap.value / 2 + 'px;';
  return style;
}
function select(index: number): void {
  reveal(index);
  if (index == selectedIndex.value) return;
  emit('update:modelValue', index); emit('change', index);
}
</script>
<style>
.seg { flex-direction: row; flex-shrink: 0; border-radius: 999rpx; padding: 6rpx; }
.seg-flex { flex-direction: row; flex: 1; }
.seg-scrolllist { flex: 1; }
.seg-auto { flex-direction: row; flex: none; }
.seg-item { flex: 1; height: 60rpx; justify-content: center; align-items: center; border-radius: 999rpx; }
.seg-item-auto { flex: none; padding-left: 24rpx; padding-right: 24rpx; }
.seg-text { font-size: 26rpx; font-weight: 500; }
.seg-wide { padding: 4px; }
.seg-item-wide { height: 36px; }
.seg-item-auto-wide { padding-left: 12px; padding-right: 12px; }
.seg-text-wide { font-size: 14px; }
</style>
