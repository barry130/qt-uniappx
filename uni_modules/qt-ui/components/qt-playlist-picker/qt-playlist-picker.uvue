<template>
  <QtSheet :visible="visible" :title="title" :subtitle="subtitle" @update:visible="onVisibleChange">
    <view class="picker-create" :class="layout.isWide ? 'picker-create-wide' : ''" :style="'border-bottom-color:' + theme.skin.divider + ';'">
      <view class="picker-create-row">
        <input class="picker-new-input" :class="layout.isWide ? 'picker-new-input-wide' : ''" :style="'color:' + theme.skin.text + ';background-color:' + theme.skin.surfaceMuted + ';' + qtFontDual(28, 14)" type="text" :value="newName" @input="onNameInput" @confirm="submitCreate" confirm-type="done" placeholder="输入新歌单名称" :maxlength="20" />
        <QtButton label="新建" icon="folder" variant="secondary" size="sm" :disabled="newName.trim().length == 0" @click="submitCreate" />
      </view>
      <text v-if="createError.length > 0" class="picker-error" :class="layout.isWide ? 'picker-error-wide' : ''" :style="'color:' + selectionColor + ';' + qtFontDual(23, 12)">{{ createError }}</text>
    </view>
    <view v-if="playlists.length == 0" class="picker-empty" :class="layout.isWide ? 'picker-empty-wide' : ''">
      <text :style="'color:' + theme.skin.textMuted + ';' + qtFontDual(26, 14)">还没有歌单，在上方新建一个</text>
    </view>
    <scroll-view v-else class="picker-list" direction="vertical" :style="listStyle" :scroll-into-view="revealAnchor" :show-scrollbar="false">
      <view v-for="(playlist, index) in playlists" :key="playlist.id" :id="itemId(index)">
        <QtOption :label="playlist.name" kind="row" :selected="isSelected(playlist.id)" @select="togglePlaylist(playlist)">
          <template #leading>
            <image v-if="playlist.picUrl && !failedCovers.has(playlist.id)" class="picker-cover" :class="layout.isWide ? 'picker-cover-wide' : ''" :src="playlist.picUrl" mode="aspectFill" @error="onCoverError(playlist.id)" />
            <view v-else class="picker-cover picker-placeholder" :class="layout.isWide ? 'picker-cover-wide' : ''" :style="'background-color:' + theme.skin.coverPlaceholder + ';'">
              <text :style="'color:' + theme.skin.textMuted + ';' + qtFontDual(32, 16)">{{ playlist.name.charAt(0) }}</text>
            </view>
          </template>
          <template #trailing>
            <view class="picker-check" :class="layout.isWide ? 'picker-check-wide' : ''">
              <QtCheckbox :checked="isSelected(playlist.id)" indicator="check" @change="togglePlaylist(playlist)" />
            </view>
          </template>
        </QtOption>
      </view>
    </scroll-view>
    <template #footer>
      <view class="picker-footer" :class="layout.isWide ? 'picker-footer-wide' : ''">
        <template v-if="batchMode">
          <QtButton label="完成" variant="primary" size="sm" @click="close" />
        </template>
        <template v-else>
          <view class="picker-button"><QtButton label="取消" variant="outline" size="sm" @click="close" /></view>
          <QtButton label="确定" variant="primary" size="sm" @click="confirm" />
        </template>
      </view>
    </template>
  </QtSheet>
</template>
<script setup lang="ts">
import { ref, computed, watch } from "vue";
import QtSheet from "@/uni_modules/qt-ui/components/qt-sheet/qt-sheet.uvue";
import QtOption from "@/uni_modules/qt-ui/components/qt-option/qt-option.uvue";
import QtButton from "@/uni_modules/qt-ui/components/qt-button/qt-button.uvue";
import QtCheckbox from "@/uni_modules/qt-ui/components/qt-checkbox/qt-checkbox.uvue";
import { qtSelectionColor } from "@/uni_modules/qt-ui/composables/selection";
import type { Playlist } from "@/types/music";
import { qtFontDual, fontScale } from "@/uni_modules/qt-ui/stores/font-scale";
import { useQtLayout, qtRpx } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtSelectionReveal } from "@/uni_modules/qt-ui/composables/use-qt-selection-reveal";
const props = withDefaults(defineProps<{
  visible: boolean;
  song: any;
  playlists: Playlist[];
  selectedIds: string[];
  title?: string;
  subtitle?: string;
  /** 输入兼容；普通选择已统一 Sheet，不再按窗口坐标定位 popover。 */
  anchorTop?: number;
  batchMode?: boolean;
  /** 宿主负责落盘；返回新歌单，失败返回 null。批量宿主同时收藏所选歌曲。 */
  createPlaylist: (name: string) => Playlist | null;
}>(), { title: "选择歌单", subtitle: "可多选，点确定保存收藏", anchorTop: -1, batchMode: false });
const emit = defineEmits<{
  (e: "update:visible", value: boolean): void;
  (e: "confirm", selectedIds: string[]): void;
  (e: "toggle", playlistId: string): void;
}>();
const layout = useQtLayout();
const theme = useThemeStore();
const selectedPlaylistIds = ref<string[]>([...props.selectedIds]);
const newName = ref("");
const createError = ref("");
const selectionColor = computed((): string => qtSelectionColor(theme.dark));
watch((): boolean => props.visible, (): void => { newName.value = ""; createError.value = ""; });
/** 封面地址加载失败的歌单 id：失败后回落首字占位（口径同 qt-local-mixes onCoverError） */
const failedCovers = ref<Set<string>>(new Set());
function onCoverError(id: string): void {
  failedCovers.value.add(id);
}
const externalSelectionKey = computed((): string => JSON.stringify(props.selectedIds));
const playlistKey = computed((): string => JSON.stringify(props.playlists.map((playlist: Playlist): string => playlist.id + ":" + playlist.name + ":" + playlist.picUrl)));
const revealIndex = ref(-1);
function isSelected(id: string): boolean {
  return (props.batchMode ? props.selectedIds : selectedPlaylistIds.value).includes(id);
}
function refreshRevealIndex(): void {
  let index = -1;
  for (let i = 0; i < props.playlists.length; i++) {
    if (isSelected(props.playlists[i].id)) { index = i; break; }
  }
  revealIndex.value = index;
}
// 外部集合（含原地修改）和重新打开才恢复草稿；取消没有 confirm。
watch((): string => String(props.visible) + ":" + externalSelectionKey.value + ":" + props.batchMode, (): void => {
  selectedPlaylistIds.value = [...props.selectedIds];
  refreshRevealIndex();
}, { immediate: true });
// 不 watch 本地 draft：用户点选不会每次抢滚动；内容/字号/窗口变化才重新定位。
watch((): string => playlistKey.value + ":" + layout.sizeEpoch + ":" + fontScale.scale, (): void => refreshRevealIndex(), { immediate: true });
const { anchor: revealAnchor, itemId } = useQtSelectionReveal(
  (): boolean => props.visible,
  (): number => revealIndex.value,
  (): string => playlistKey.value + ":" + externalSelectionKey.value + ":" + props.batchMode,
);
const listStyle = computed((): string => {
  // 原生 scroll-view 使用有界高度；大字号下仍给 header/footer 留出空间。
  const rowHeight = (layout.isWide ? 64 : qtRpx(128)) * fontScale.scale;
  const preferred = Math.min(layout.isWide ? 300 : qtRpx(600), props.playlists.length * rowHeight);
  const available = Math.max(0, layout.windowHeight * 0.86 - layout.safeBottomPx - (layout.isWide ? 240 : qtRpx(420)) * fontScale.scale);
  return "height:" + Math.min(preferred, available) + "px;";
});
function togglePlaylist(playlist: Playlist): void {
  if (props.batchMode) { emit("toggle", playlist.id); return; }
  const index = selectedPlaylistIds.value.indexOf(playlist.id);
  if (index >= 0) selectedPlaylistIds.value.splice(index, 1);
  else selectedPlaylistIds.value.push(playlist.id);
}
function onNameInput(e: InputEvent): void { newName.value = e.detail.value; createError.value = ""; }
function submitCreate(): void {
  const name = newName.value.trim();
  if (name.length == 0) return;
  if (props.playlists.some((playlist: Playlist): boolean => playlist.name == name)) {
    createError.value = "已有同名歌单，请换个名称";
    return;
  }
  try {
    const created = props.createPlaylist(name);
    if (created == null) { createError.value = "未能新建歌单，请重试"; return; }
    // 单曲只改草稿，确定后才保存歌曲；批量勾选仍由宿主的收藏结果回灌。
    if (!props.batchMode && !selectedPlaylistIds.value.includes(created.id)) selectedPlaylistIds.value.push(created.id);
    newName.value = "";
    createError.value = "";
    refreshRevealIndex();
  } catch (_) {
    createError.value = "未能新建歌单，请重试";
  }
}
function confirm(): void { emit("confirm", [...selectedPlaylistIds.value]); close(); }
function close(): void { emit("update:visible", false); }
function onVisibleChange(value: boolean): void { emit("update:visible", value); }
</script>
<style>
.picker-list { min-height: 0; }
.picker-cover { width: 72rpx; height: 72rpx; border-radius: 12rpx; margin-right: 20rpx; flex-shrink: 0; }
.picker-cover-wide { width: 36px; height: 36px; border-radius: 6px; margin-right: 10px; }
.picker-placeholder { align-items: center; justify-content: center; }
.picker-check { margin-left: 24rpx; flex-shrink: 0; }
.picker-check-wide { margin-left: 12px; }
.picker-create { padding: 24rpx 32rpx; border-bottom-width: 1rpx; border-bottom-style: solid; flex-shrink: 0; }
.picker-create-wide { padding: 14px 20px; border-bottom-width: 1px; }
.picker-create-row { flex-direction: row; align-items: center; }
.picker-error { margin-top: 12rpx; font-size: 23rpx; }
.picker-error-wide { margin-top: 6px; font-size: 12px; }
.picker-empty { padding: 40rpx 32rpx; align-items: center; }
.picker-empty-wide { padding: 24px 20px; }
.picker-footer { flex-direction: row; justify-content: flex-end; align-items: center; padding: 28rpx 32rpx; }
.picker-footer-wide { padding: 14px 20px; }
.picker-button { margin-right: 12px; }
.picker-new-input { flex: 1; min-width: 0; height: 88rpx; margin-right: 20rpx; padding: 0 20rpx; border-radius: 16rpx; }
.picker-new-input-wide { height: 44px; margin-right: 10px; padding: 0 10px; border-radius: 12px; }
</style>
