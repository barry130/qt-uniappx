<template>
  <view v-if="visible" class="picker-mask" @click="close">
    <view
      class="picker-panel"
      :style="panelStyle"
      @click.stop
    >
      <view class="picker-triangle" :class="layout.isWide ? 'picker-triangle-wide' : ''"></view>
      <view class="picker-header" :class="layout.isWide ? 'picker-header-wide' : ''">
        <text class="picker-title" :class="layout.isWide ? 'picker-title-wide' : ''" :style="qtFontDual(32, 16)">{{ title }}</text>
        <text class="picker-header-sub" :class="layout.isWide ? 'picker-header-sub-wide' : ''" :style="qtFontDual(24, 12)">{{ subtitle }}</text>
      </view>
      <scroll-view class="picker-list" :class="layout.isWide ? 'picker-list-wide' : ''" direction="vertical" :show-scrollbar="false">
        <view
          v-for="playlist in playlists"
          :key="playlist.id"
          class="picker-item"
          :class="layout.isWide ? 'picker-item-wide' : ''"
          @click="togglePlaylist(playlist)"
        >
          <view class="picker-item-left">
            <image
              v-if="playlist.picUrl"
              class="picker-item-cover"
              :class="layout.isWide ? 'picker-item-cover-wide' : ''"
              :src="playlist.picUrl"
              mode="aspectFill"
            />
            <view v-else class="picker-item-cover placeholder" :class="layout.isWide ? 'picker-item-cover-wide' : ''">
              <text class="picker-item-cover-text" :class="layout.isWide ? 'picker-item-cover-text-wide' : ''" :style="qtFontDual(32, 16)">{{ playlist.name.charAt(0) }}</text>
            </view>
            <text class="picker-item-name" :class="layout.isWide ? 'picker-item-name-wide' : ''" :style="qtFontDual(28, 14)">{{ playlist.name }}</text>
          </view>
          <view class="picker-item-check" :class="layout.isWide ? 'picker-item-check-wide' : ''">
            <view v-if="selectedPlaylistIds.includes(playlist.id)" class="picker-check-icon" :class="layout.isWide ? 'picker-check-icon-wide' : ''">
              <QtIcon name="check" :size="layout.isWide ? 16 : 28" color="#ffffff" />
            </view>
          </view>
        </view>
      </scroll-view>
      <view class="picker-footer" :class="layout.isWide ? 'picker-footer-wide' : ''">
        <template v-if="batchMode">
          <input
            class="picker-new-input"
            :class="layout.isWide ? 'picker-new-input-wide' : ''"
            type="text"
            :value="newName"
            @input="onNameInput"
            placeholder="新建歌单"
            :maxlength="20"
          />
          <qt-button label="新建" variant="secondary" size="sm" @click="submitCreate" />
          <qt-button label="完成" variant="primary" size="sm" @click="close" />
        </template>
        <template v-else>
          <qt-button label="取消" variant="outline" size="sm" @click="close" />
          <qt-button label="确定" variant="primary" size="sm" @click="confirm" />
        </template>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { ref, computed, watch, nextTick } from 'vue';
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtButton from "@/uni_modules/qt-ui/components/qt-button/qt-button.uvue";
import type { Playlist } from '@/types/music';
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";
import { useQtLayout, qtRpx } from "@/uni_modules/qt-ui/composables/use-qt-layout";

const props = withDefaults(defineProps<{
  visible: boolean;
  song: any; // Song
  playlists: Playlist[];
  selectedIds: string[];
  title?: string;
  subtitle?: string;
  anchorTop?: number; // 像素坐标，来自触发元素；为空则居中偏上
  // 批量模式：点一行不再本地增删 + 确定提交，而是 emit('toggle') 交给宿主
  // （宿主按「整批都已在里面 → 取消收藏，否则收藏」决定增还是删），
  // 底部换成「新建歌单输入行 + 完成」。勾选态仍由 selectedIds 驱动。
  batchMode?: boolean;
}>(), {
  title: '选择歌单',
  subtitle: '选择歌单',
  anchorTop: -1,
  batchMode: false,
});

const emit = defineEmits<{
  (e: 'update:visible', value: boolean): void;
  (e: 'confirm', selectedIds: string[]): void;
  // 批量模式下点某一行歌单（宿主负责增/删，并通过 selectedIds 回灌勾选态）
  (e: 'toggle', playlistId: string): void;
  // 批量模式下点「新建」：宿主建歌单并把已选歌曲收进去
  (e: 'create', name: string): void;
}>();

const layout = useQtLayout();
const selectedPlaylistIds = ref<string[]>([...props.selectedIds]);
/** 批量模式下的新建歌单名称（面板内输入行 —— uni.showModal 的 editable 输入框在 App 端不渲染） */
const newName = ref<string>('');

watch(() => props.selectedIds, (newVal) => {
  selectedPlaylistIds.value = [...newVal];
});

/**
 * 蒙层自身的窗口原点。蒙层 absolute 化后（见样式块注释）锚点不再是窗口，而是
 * frame 内容区/页面容器（原点在状态栏/标题栏之下），而 anchorTop 与居中 left 都是
 * **窗口坐标**（点击事件 detail.y、窗口宽居中），必须减掉蒙层原点才落回原位。
 * 打开时用 createSelectorQuery 量一次蒙层矩形（qt-page-frame 同款写法）；
 * 量不到（rect 为空）保持 0/0，面板略微偏移但仍可用。
 */
const maskOrigin = ref<{ top: number; left: number }>({ top: 0, left: 0 });

function measureMask(): void {
  uni.createSelectorQuery()
    .select(".picker-mask")
    .boundingClientRect((rect: UniNodeInfo | null) => {
      if (rect != null) {
        maskOrigin.value = { top: rect.top, left: rect.left };
      }
    })
    .exec();
}

watch(() => props.visible, (v: boolean) => {
  if (v) nextTick(() => measureMask());
});

/**
 * 面板定位：若给了 anchorTop（px）则该点下方展开；否则屏幕约 28% 处。
 * 输入是窗口坐标，先减蒙层原点换算成蒙层（锚点容器）内坐标。
 *
 * 尺寸口径（2026-10-21 修）：把面板宽度的「浮动档」按 rpx 换算，与面板内的 rpx
 * 样式同源 —— 原来宽度写 `min(screenW - 40, 340)` 而内部字号写死 px，在 720dp
 * 这类窗口上面板撑到 340dp、字还是 14dp，比 375dp 手机上更小。宽屏继续走固定 px
 * 面板（rpx 在宽屏会膨胀数倍，design.md §6.6）。
 */
const panelStyle = computed(() => {
  const screenW = uni.getSystemInfoSync().windowWidth;
  const screenH = uni.getSystemInfoSync().windowHeight;
  const wide = layout.isWide;
  const marginX = wide ? 40 : qtRpx(40);
  const maxW = wide ? 340 : qtRpx(680);
  const panelW = Math.min(screenW - marginX, maxW);
  const defaultY = screenH * 0.28;
  const top = (props.anchorTop >= 0 ? props.anchorTop + (wide ? 10 : qtRpx(20)) : defaultY) - maskOrigin.value.top;
  const left = (screenW - panelW) / 2 - maskOrigin.value.left;
  return 'top:' + Math.round(top) + 'px;left:' + Math.round(left) + 'px;width:' + Math.round(panelW) + 'px;';
});

function togglePlaylist(playlist: Playlist) {
  if (props.batchMode) {
    // 批量模式不在本地改勾选：勾选态的真实来源是「这批歌是否已整批在该歌单里」，
    // 只有宿主（拿到 songs 的那一层）算得出来。本地先改会和宿主回灌的值打架。
    emit('toggle', playlist.id);
    return;
  }
  const index = selectedPlaylistIds.value.indexOf(playlist.id);
  if (index !== -1) {
    selectedPlaylistIds.value.splice(index, 1);
  } else {
    selectedPlaylistIds.value.push(playlist.id);
  }
}

function onNameInput(e: InputEvent): void {
  newName.value = e.detail.value;
}

/**
 * 批量模式「新建」：把名字交给宿主，宿主建歌单 + 把已选歌曲收进去。
 * 这里按下即清空输入框（按钮语义就是「建这一个」）；建失败时宿主弹红字回执
 * （空名 / 重名），用户重打一次 —— 面板内不再回传失败原因，避免多一条状态通路。
 */
function submitCreate(): void {
  const name = newName.value.trim();
  if (name.length == 0) return;
  newName.value = '';
  emit('create', name);
}

function confirm() {
  emit('confirm', selectedPlaylistIds.value);
  close();
}

function close() {
  emit('update:visible', false);
}
</script>

<style scoped>
/*
 * 尺寸口径（2026-10-21 统一）：手机档（!isWide）一律 rpx —— 随窗口线性放大，
 * 720dp 上 1rpx ≈ 0.96dp；宽屏继续固定 px（rpx 在宽屏会膨胀数倍，design.md §6.6）。
 * base 是 rpx（= 375dp 手机上原 px 值 ×2），-wide 是原 px，标准档渲染逐像素不变。
 */
/*
 * 蒙层与面板都 absolute 而不是 fixed：宽屏托管页里 fixed 会被提升到窗口层，
 * 被覆盖层压住、关闭后泄漏（详见 qt-action-sheet 的 .as-mask 注释）。
 * 内联 top/left 都是窗口坐标，而 frame 根（锚点）原点就是窗口原点，坐标不变。
 */
.picker-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 999;
}
.picker-panel {
  position: absolute;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
}
.picker-triangle {
  position: absolute;
  top: -16rpx;
  left: 50%;
  margin-left: -16rpx;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 16rpx solid #ffffff;
}
.picker-triangle-wide {
  top: -8px;
  margin-left: -8px;
  border-left: 8px solid transparent;
  border-right: 8px solid transparent;
  border-bottom: 8px solid #ffffff;
}
.picker-header {
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
  border-bottom-width: 1px; border-bottom-style: solid;
  border-bottom-color: #f0f0f0;
  padding-bottom: 20rpx;
}
.picker-header-wide {
  margin-bottom: 12px;
  padding-bottom: 10px;
}
.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #191d26;
}
.picker-title-wide {
  font-size: 16px;
}
.picker-header-sub {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #6b7385;
}
.picker-header-sub-wide {
  margin-left: 8px;
  font-size: 12px;
}
.picker-list {
  max-height: 600rpx;
}
.picker-list-wide {
  max-height: 300px;
}
.picker-item {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}
.picker-item-wide {
  padding: 10px 0;
}
.picker-item-left {
  flex-direction: row;
  align-items: center;
  flex: 1;
  overflow: hidden;
}
.picker-item-cover {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}
.picker-item-cover-wide {
  width: 36px;
  height: 36px;
  border-radius: 6px;
  margin-right: 10px;
}
.placeholder {
  background: #e0e0e0;
  align-items: center;
  justify-content: center;
}
.picker-item-cover-text {
  font-size: 32rpx;
  color: #666;
}
.picker-item-cover-text-wide {
  font-size: 16px;
}
.picker-item-name {
  font-size: 28rpx;
  color: #191d26;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
}
.picker-item-name-wide {
  font-size: 14px;
}
.picker-item-check {
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
}
.picker-item-check-wide {
  width: 24px;
  height: 24px;
}
.picker-check-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #4CAF50;
  color: #fff;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.picker-check-icon-wide {
  width: 24px;
  height: 24px;
  font-size: 14px;
}
.picker-footer {
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  padding-top: 28rpx;
}
.picker-footer-wide {
  padding-top: 14px;
}
/* 批量模式的「新建歌单」输入行：吃掉剩余宽度，右侧两个按钮固定 */
.picker-new-input {
  flex: 1;
  height: 68rpx;
  margin-right: 20rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
  font-size: 28rpx;
  color: #191d26;
}
.picker-new-input-wide {
  height: 34px;
  margin-right: 10px;
  padding: 0 10px;
  border-radius: 8px;
  font-size: 14px;
}
.picker-btn {
  height: 68rpx;
  padding: 0 36rpx;
  margin-left: 24rpx;
  border-radius: 34rpx;
  background: #f2f3f5;
  color: #596173;
  font-size: 28rpx;
  line-height: 68rpx;
  border: none;
  text-align: center;
}
.picker-btn.primary {
  background: #ff5a6e;
  color: #ffffff;
}
</style>
