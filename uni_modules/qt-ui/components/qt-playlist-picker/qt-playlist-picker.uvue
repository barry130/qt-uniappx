  border-radius: 50%;
  background: #4CAF50;
  color: #fff;
  align-items: center;
  justify-content: center;
  font-size: 14px;
}
.picker-footer {
  flex-direction: row;
  justify-content: flex-end;
  padding-top: 14px;
}
.picker-btn {
  height: 34px;
  padding: 0 18px;
  margin-left: 12px;
  border-radius: 17px;
  background: #f2f3f5;
  color: #596173;
