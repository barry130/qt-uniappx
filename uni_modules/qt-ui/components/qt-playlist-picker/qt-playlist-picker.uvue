  justify-content: space-between;
  padding: 10px 0;
}
.picker-item-left {
  flex-direction: row;
  align-items: center;
  flex: 1;
  overflow: hidden;
}
.picker-item-cover {
  width: 36px;
  height: 36px;
  border-radius: 6px;
