<!--
  宽屏侧边导航 rail（平板 / 横屏 / 车机）
  由 qt-page-frame 在 layout.isWide 时挂载，覆盖 tab 页与所有普通页面；宽屏取代底部
  原生 tabbar，手机竖屏不渲染，仍用原生 tabbar。
  medium（600–899dp）退化为 64px 图标栏；wide/desktop（>=900dp）使用完整 rail
  （品牌与文字），避免中等宽度窗口被导航栏挤占。
  本组件只在宽屏渲染，因此内部尺寸直接用 px。
-->
<template>
  <view class="qsn" :class="compact ? 'qsn-compact' : ''" :style="railStyle">
    <view v-if="!compact" class="qsn-brand">
      <image class="qsn-logo" src="/static/icon/xxxhdpi.png" mode="aspectFill" />
      <view class="qsn-brand-copy">
        <text class="qsn-brand-name" :style="('color:' + theme.skin.text + ';') + qtFontPx(17)">轻听</text>
        <text class="qsn-brand-sub" :style="('color:' + theme.skin.textSubtle + ';') + qtFontPx(11)">你的私人音乐台</text>
      </view>
    </view>
    <image v-else class="qsn-logo qsn-logo-compact" src="/static/icon/xxxhdpi.png" mode="aspectFill" />

    <!-- 矮窗口（横屏手机 / 车机）下菜单项放不下，品牌固定在顶部，菜单区可滚动 -->
    <scroll-view class="qsn-scroll" direction="vertical" :show-scrollbar="false">
      <view class="qsn-group">
        <view
          v-for="tab in tabs"
          :key="tab.page"
          class="qsn-item"
          :hover-class="compact ? 'none' : 'qsn-item-hover'"
          :style="itemActive(tab.page) ? 'background-color:' + theme.skin.accentSoft + ';' : ''"
          @click="goTab(tab.page)"
        >
          <QtIcon :name="tab.icon" :size="compact ? 24 : 20" :color="itemActive(tab.page) ? theme.skin.accent : theme.skin.iconMuted" />
          <text
            v-if="!compact"
            class="qsn-label"
            :style="('color:' + (itemActive(tab.page) ? theme.skin.accent : theme.skin.textSubtle) + ';') + qtFontPx(14)"
          >{{ tab.label }}</text>
          <view v-if="hasDot(tab.page)" class="qsn-dot" />
        </view>
      </view>

      <view class="qsn-divider" :style="'background-color:' + theme.skin.divider + ';'" />

      <view class="qsn-group">
        <view
          v-for="tool in tools"
          :key="tool.page"
          class="qsn-item"
          :hover-class="compact ? 'none' : 'qsn-item-hover'"
          :style="itemActive(tool.page) ? 'background-color:' + theme.skin.accentSoft + ';' : ''"
          @click="goPage(tool.page)"
        >
          <QtIcon :name="tool.icon" :size="compact ? 24 : 20" :color="itemActive(tool.page) ? theme.skin.accent : theme.skin.iconMuted" />
          <text v-if="!compact" class="qsn-label" :style="('color:' + (itemActive(tool.page) ? theme.skin.accent : theme.skin.textSubtle) + ';') + qtFontPx(14)">{{ tool.label }}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup lang="ts">
import { computed } from "vue";
import { useQtLayout, qtStatusBarPx } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import { useSourceStore } from "@/stores/source";
import { useSourceRegistryStore } from "@/stores/source-registry";
import { qtFontPx } from "@/uni_modules/qt-ui/stores/font-scale";
import { qtRailNavigate, qtRailSwitchTab } from "@/uni_modules/qt-ui/composables/qt-nav";
import { qtIsSettingsRoute, qtIsProfileRoute } from "@/uni_modules/qt-ui/composables/qt-page-chrome";

const props = defineProps<{
  /** 当前 tab 页路由，用于高亮（如 /pages/home/index） */
  current?: string;
  /** 需要亮红点的 tab 路由列表（与 current 同格式，如 /pages/profile/index） */
  dots?: string[];
  /**
   * 兼容旧调用方保留（当前已不参与计算）。
   * `pages.json` 全局改成 `navigationStyle: custom` 后，所有页面区都从窗口顶缘
   * 开始（原生导航栏没了），rail 必须恒为状态栏让位，否则品牌 logo 会被状态栏
   * 的时间/信号图标压住。所以下面固定按状态栏高度加 padding-top。
   */
  insetTop?: boolean;
  /**
   * 停靠模式（qt-wide-workspace 覆盖层专用）：作为覆盖层子树里的普通 absolute
   * 元素渲染，随覆盖层一起显隐。
   *
   * 默认的 position:fixed rail 有两个真机实测的问题（都出在被托管工具页自带
   * rail 上）：fixed 节点在 Vapor 下会被提升到窗口层参与 z 序 —— 覆盖层（z 1000
   * 不透明背景）压过 rail（z 900），工具页自带的 rail 整条不可见；覆盖层关闭
   * （visibility:hidden）时 fixed 子节点又不随祖先收起，已创建的各工具页 rail
   * 全部漏在宿主页上，表现为「rail 上四个工具入口同时亮红」。停靠模式四边锚定
   * （top/bottom 显式，全仓蒙层同款可靠写法）留在子树内，两个问题都消失。
   */
  docked?: boolean;
}>();

const layout = useQtLayout();
const theme = useThemeStore();

// rail 工具入口宽屏下走 qt-wide-workspace 就地托管（不再创建原生页面，也就不需要
// 预热页面树；旧的 qt-page-preload.ts 已删除 —— uni.preloadPage 在 uni-app x 不支持，
// 就地托管后宽屏连预热的目标都不存在了）。
const compact = computed((): boolean => layout.sizeClass == "medium");
/** 固定在窗口左缘（不随 qt-page-frame 限宽居中）；停靠模式随覆盖层撑满 */
const railStyle = computed((): string => {
  // 恒加状态栏高度：全站 navigationStyle=custom 后页面区从窗口顶缘起，
  // rail 不主动让位就会被状态栏文字压住（历史实现只在发现的 3 个页面让位）。
  const sb = qtStatusBarPx();
  const base = "padding-top:" + sb + "px;background-color:" + theme.skin.surfaceInset + ";border-right-color:" + theme.skin.divider + ";";
  if (props.docked == true) {
    // 停靠：四边锚定的 absolute（内联压过类里的 fixed），高度随覆盖层撑满。
    // 不能沿用 fixed + 显式 height：见 docked prop 注释（窗口层 z 序 + 漏显隐）。
    return "position:absolute;left:0;top:0;bottom:0;" + base;
  }
  // 高度必须显式给 px：position:fixed 下 top+bottom 双锚拉伸在 Vapor 不可靠
  // （2026-10-24 宽屏 rail 整条消失的根因，同 stats hero 底图），塌成高 0 就不可见
  return "height:" + layout.windowHeight + "px;" + base;
});

type NavItem = { page: string; label: string; icon: string };
const tabs: NavItem[] = [
  { page: "/pages/home/index", label: "发现", icon: "compass" },
  { page: "/pages/profile/index", label: "我的", icon: "user" },
];
// 工具区：每日推荐/歌单广场/排行榜按数据包声明的**功能面**过滤（v4 契约）：
// 所有源都没有该功能时入口整行消失，不留死入口；未声明（旧包）按支持处理。
// 榜单页本身有各源标签且会落到第一个有榜单的源，因此「排行榜」按聚合判断；
// 每日推荐/歌单广场按当前源判断（页面数据取自当前源）。
const ALL_TOOLS: NavItem[] = [
  { page: "/pages/search/index", label: "搜索", icon: "search" },
  { page: "/pages/daily/index", label: "每日新歌", icon: "calendar" },
  { page: "/pages/playlists/index", label: "歌单广场", icon: "disc" },
  { page: "/pages/chart/index", label: "排行榜", icon: "trending" },
  { page: "/pages/settings/index", label: "设置", icon: "settings" },
];
const sourceRegistry = useSourceRegistryStore();
const sourceStore = useSourceStore();
const tools = computed<NavItem[]>(() => {
  const out: NavItem[] = [];
  for (const tool of ALL_TOOLS) {
    if (tool.page == "/pages/daily/index" && !sourceRegistry.supports(sourceStore.current, "latest")) continue;
    if (tool.page == "/pages/playlists/index" && !sourceRegistry.supports(sourceStore.current, "playlists")) continue;
    if (tool.page == "/pages/chart/index" && !sourceRegistry.anySupports("charts")) continue;
    out.push(tool);
  }
  return out;
});

function itemActive(page: string): boolean {
  if (props.current == null) return false;
  if (props.current == page) return true;
  // 设置族 / 我的族在宽屏是三栏：rail 只是第一栏，
  // 用户在 /pages/play-settings、/pages/collection 这类族子页时对应入口必须保持高亮，
  // 否则左侧导航会显示成「什么都没选中」，用户不知道自己还在哪里。
  if (page == "/pages/settings/index" && qtIsSettingsRoute(props.current)) return true;
  if (page == "/pages/profile/index" && qtIsProfileRoute(props.current)) return true;
  return false;
}
function hasDot(page: string): boolean {
  if (props.dots == null) return false;
  const bare = page.charAt(0) == "/" ? page.substring(1) : page;
  // dots 的产生方（qt-page-frame 的 railDots）带开头斜杠，这里对元素也归一一次，
  // 否则 "/pages/profile/index" 对 "pages/profile/index" 恒 indexOf 不到，红点永不显示
  for (let i = 0; i < props.dots.length; i++) {
    const d = props.dots[i];
    if ((d.charAt(0) == "/" ? d.substring(1) : d) == bare) return true;
  }
  return false;
}
function goTab(page: string): void {
  if (props.current == page) return;
  qtRailSwitchTab(page);
}
function goPage(page: string): void {
  if (props.current == page) return;
  qtRailNavigate(page);
}
</script>

<style>
.qsn {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 900;
  width: 208px;
  flex-shrink: 0;
  padding: 14px 10px;
  flex-direction: column;
  align-items: stretch;
  border-right-width: 1px; border-right-style: solid;
}
.qsn-compact {
  width: 64px;
  padding: 14px 8px;
  align-items: center;
}
.qsn-brand {
  flex-direction: row;
  align-items: center;
  padding: 4px 8px 14px;
}
.qsn-logo {
  width: 38px;
  height: 38px;
  border-radius: 12px;
}
.qsn-logo-compact {
  margin-bottom: 14px;
}
.qsn-scroll {
  flex: 1;
  min-height: 0;
}
.qsn-brand-copy {
  margin-left: 10px;
  flex-direction: column;
}
.qsn-brand-name {
  font-size: 17px;
  font-weight: 700;
}
.qsn-brand-sub {
  margin-top: 2px;
  font-size: 11px;
}
.qsn-group {
  flex-direction: column;
}
.qsn-item {
  height: 44px;
  margin-bottom: 2px;
  padding: 0 12px;
  flex-direction: row;
  align-items: center;
  border-radius: 10px;
}
/* 桌面指针反馈：收起成图标轨（compact）时不启用，只图标没有文字时整块变色反而显脏 */
.qsn-item-hover {
  background-color: rgba(255, 255, 255, 0.06);
}
.qsn-dot {
  position: absolute;
  top: 12px;
  right: 10px;
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background-color: #ff4b4b;
}
.qsn-label {
  margin-left: 10px;
  font-size: 14px;
  font-weight: 500;
}
.qsn-divider {
  height: 1px;
  margin: 10px 8px;
}
</style>
