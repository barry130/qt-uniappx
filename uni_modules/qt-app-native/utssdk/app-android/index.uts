/**
 * 强制窗口回归传统布局模式（decorFitsSystemWindows = true）。
 *
 * 背景：三星 One UI（Android 15/16）手势导航下窗口 edge-to-edge 全高、
 * 导航栏 inset 为 0，uni-app x 运行时在这条 inset 路径上存在首屏挂载竞态
 * （S24 Ultra 全屏白屏：首页视图树挂不上，reLaunch 也救不回）；
 * 三键导航 / 分屏模式 inset 稳定，一切正常 —— 见 services/boot-guard.ts
 * 统计上报（SM-S9280 window=412x892）。
 *
 * 这里在启动最早点把窗口拉回"内容区 = 窗口 - 系统栏 inset"的传统模式，
 * 与三键导航等价，绕开坏路径。只能恢复性调用：状态栏/内容重叠要靠页面
 * 自身的 statusBarHeight 让位逻辑（本项目 custom 导航页本来就自行让位）。
 */
export const applyLegacyInsets: ApplyLegacyInsets = function (): boolean {
  try {
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) return false;
    const window = activity.getWindow();
    if (window == null) return false;
    WindowCompat.setDecorFitsSystemWindows(window, true);
    console.log("[AppNative] applyLegacyInsets: decorFitsSystemWindows=true");
    return true;
  } catch (e) {
    console.log("[AppNative] applyLegacyInsets error " + (e != null ? e.toString() : "unknown"));
    return false;
  }
};

/**
 * 重建当前 Activity（首屏守卫最后手段，见 interface.uts）。
 * recreate 会走 onSaveInstanceState/恢复链路；对 uni-app x 而言窗口层整个重来，
 * 首屏挂载竞态随旧窗口一起销毁。
 */
export const recreateActivity: RecreateActivity = function (): boolean {
  try {
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) return false;
    activity.recreate();
    console.log("[AppNative] recreateActivity triggered");
    return true;
  } catch (e) {
    console.log("[AppNative] recreateActivity error " + (e != null ? e.toString() : "unknown"));
    return false;
  }
};

/**
 * 上一次打出去的 readBottomNavInset 诊断行（只在数值变化时打）。
 * 调用方可能以秒级周期轮询（App.uvue 的前台轮询，用于感知用户中途切换
 * 三键 ↔ 手势导航），不加这层去重会把 logcat 刷满。
 */
let lastNavInsetLog = "";

/**
 * 底部导航避让高度（px）：只在「窗口真的把内容画到导航键底下」时回非 0。
 *
 * 背景（2026-10-31 用户反馈：安卓机底部 TabBar 压在三键导航上）：安卓这边
 * uni.getWindowInfo().safeAreaInsets.bottom 同样报 0，靠它让位失效。但安卓
 * 不能像鸿蒙那样无条件拿导航栏 inset —— getRootWindowInsets() 上报的是
 * 「相对窗口的」inset，传统布局（applyLegacyInsets 生效 / 系统已给内容区
 * 让位）下它照样等于导航栏高度，直接加内边距会在所有正常机型上重复叠一次，
 * 胶囊悬空过高。
 *
 * 所以这里先用两个独立信号判断窗口是否已让过位：
 *   1) DecorView 直接子 View 的 paddingBottom —— 传统布局下系统把 inset
 *      以 padding 形式打在内容根上；
 *   2) DecorView 与内容根的高度差 —— 有些实现是缩短子 View 而不是加 padding。
 * 任一成立即认为「已让位」，回 0；两个都不成立才是真 edge-to-edge
 * （含 Android 15+ 对 targetSdk 35 强制 e2e、以及运行时把 decorFits 改回
 * false 的情况），回真实导航栏高度。
 *
 * 失败方向刻意选「回 0」：读不到几何时保持现状，宁可少让位也不重复叠。
 */
export const readBottomNavInset: ReadBottomNavInset = function (onResult: (px: number) => void): void {
  try {
    // getRootWindowInsets 需要 API 23+；更低版本保持现状（回 0）
    if (Build.VERSION.SDK_INT < 23) {
      onResult(0);
      return;
    }
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) {
      onResult(0);
      return;
    }
    const window = activity.getWindow();
    if (window == null) {
      onResult(0);
      return;
    }
    const decor: View = window.getDecorView();
    if (decor == null) {
      onResult(0);
      return;
    }
    const rootInsets: WindowInsets | null = decor.getRootWindowInsets();
    if (rootInsets == null) {
      // 首帧 inset 尚未分发：回 0，等 App.uvue 的 onShow / 延时重读
      onResult(0);
      return;
    }
    const compat = WindowInsetsCompat.toWindowInsetsCompat(rootInsets);
    const barBottom = compat.getInsets(WindowInsetsCompat.Type.navigationBars()).bottom;
    // 手势导航（无按键栏）时 navigationBars 的 bottom 恒 0，但屏幕最底下仍有一条
    // 系统手势指示条区域 —— 2026-10-31 用户反馈「没有下面导航栏的时候，tab 也应该
    // 保持之前那样上浮一点」：只认 navigationBars 的话手势机让位量回 0，悬浮胶囊
    // 贴在屏幕最底边。mandatorySystemGestures 表达的正是「系统手势一定要吞掉的底部
    // 条带」，三键导航下它为 0（已被 navigationBars 覆盖），手势导航下≈指示条高度，
    // 两者取大即「底部真正不可用的高度」，与鸿蒙 TYPE_NAVIGATION_INDICATOR 选型一致。
    const gestureBottom = compat.getInsets(WindowInsetsCompat.Type.mandatorySystemGestures()).bottom;
    const navBottom = barBottom > gestureBottom ? barBottom : gestureBottom;
    if (navBottom <= 0) {
      onResult(0);
      return;
    }
    const decorHeight = decor.getHeight();
    const contentRoot: View | null = (decor as ViewGroup).getChildAt(0);
    if (decorHeight <= 0 || contentRoot == null) {
      onResult(0);
      return;
    }
    const padBottom = contentRoot.getPaddingBottom();
    const heightGap = decorHeight - contentRoot.getHeight();
    const systemMadeRoom = padBottom >= navBottom - 2 || heightGap >= navBottom - 2;
    // 符号编码（见 interface.uts）：正=需要让位；负=读到了但系统已让过位
    const px = systemMadeRoom ? -navBottom : navBottom;
    const diag = "bar=" + barBottom + " gesture=" + gestureBottom
      + " nav=" + navBottom + " padBottom=" + padBottom
      + " decorH=" + decorHeight + " contentH=" + contentRoot.getHeight()
      + " madeRoom=" + systemMadeRoom + " -> " + px;
    if (diag != lastNavInsetLog) {
      lastNavInsetLog = diag;
      console.log("[AppNative] readBottomNavInset " + diag);
    }
    onResult(px);
  } catch (e) {
    console.log("[AppNative] readBottomNavInset error " + (e != null ? e.toString() : "unknown"));
    onResult(0);
  }
};

/** 打开系统浏览器 */
export const openExternalUrl: OpenExternalUrl = (url: string): boolean => {
  if (url == null || url.length == 0) return false;
  try {
    const intent = new Intent();
    intent.setAction(Intent.ACTION_VIEW);
    intent.setData(Uri.parse(url));
    // 从应用拉起外部浏览器，加 NEW_TASK 标志避免因任务栈问题被系统拒绝
    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);

    // 优先用当前 Activity 启动
    const activity = UTSAndroid.getUniActivity();
    if (activity != null) {
      activity.startActivity(intent);
      return true;
    }
    // Activity 不可用（如启动早期）：改用应用上下文启动
    const context = UTSAndroid.getAppContext();
    if (context != null) {
      context.startActivity(intent);
      return true;
    }
  } catch (e) {
    console.log("[AppNative] openExternalUrl error", e);
  }
  return false;
};

/**
 * 打开本应用的系统通知设置页。
 * API 26+ 直达通知页；失败（部分国产 ROM 不支持该 Action）或更低版本时降级到应用详情页。
 */
export const openNotificationSettings: OpenNotificationSettings = function (): boolean {
  try {
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) return false;
    const pkg = activity.getPackageName();
    if (Build.VERSION.SDK_INT >= 26) {
      try {
        const intent = new Intent();
        intent.setAction("android.settings.APP_NOTIFICATION_SETTINGS");
        intent.putExtra("android.provider.extra.APP_PACKAGE", pkg);
        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
        activity.startActivity(intent);
        return true;
      } catch (e) {
        console.log("[AppNative] APP_NOTIFICATION_SETTINGS unsupported, fallback", e);
      }
    }
    const fallback = new Intent();
    fallback.setAction("android.settings.APPLICATION_DETAILS_SETTINGS");
    fallback.setData(Uri.parse("package:" + pkg));
    fallback.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
    activity.startActivity(fallback);
    return true;
  } catch (e) {
    console.log("[AppNative] openNotificationSettings error", e);
    return false;
  }
};

// ==================== 后台保活引导（电池优化白名单 / 自启动 / 应用详情） ====================

/**
 * 是否已加入电池优化白名单。
 *
 * 语义边界：查询失败（系统服务取不到）时返回 true。理由——这个值只用于决定
 * 是否给用户弹「后台可能被限制」的引导，误报未授权会打扰用户，漏报最多是
 * 少一次提示；而后台取链失败本身还有别的兜底（前台服务、预取）。
 */
export const isIgnoringBatteryOptimizations: IsIgnoringBatteryOptimizations = function (): boolean {
  try {
    // Android 6.0（API 23）才引入 Doze/电池优化，更低版本不存在这个概念
    if (Build.VERSION.SDK_INT < 23) return true;
    const context = UTSAndroid.getAppContext();
    if (context == null) return true;
    const pm = context.getSystemService(Context.POWER_SERVICE) as PowerManager;
    if (pm == null) return true;
    return pm.isIgnoringBatteryOptimizations(context.getPackageName());
  } catch (e) {
    console.log("[AppNative] isIgnoringBatteryOptimizations error " + (e != null ? e.toString() : "unknown"));
    return true;
  }
};

/** 通用兜底：本应用的系统详情设置页（所有 ROM 都有） */
export const openAppDetailsSettings: OpenAppDetailsSettings = function (): boolean {
  try {
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) return false;
    const intent = new Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, Uri.parse("package:" + activity.getPackageName()));
    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
    activity.startActivity(intent);
    return true;
  } catch (e) {
    console.log("[AppNative] openAppDetailsSettings error " + (e != null ? e.toString() : "unknown"));
    return false;
  }
};

/**
 * 打开系统「电池优化」列表页。
 *
 * 用 ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS（列表页）而不是
 * ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS（直达确认弹窗）：后者要求清单里
 * 声明 REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 权限，而本插件目录下没有
 * AndroidManifest.xml（见 qt-audio-player 的对照），且该权限受 Google Play 政策限制。
 * 列表页零权限，用户在列表里找到本应用改成「不优化」即可。
 */
export const openBatteryOptimizationSettings: OpenBatteryOptimizationSettings = function (): boolean {
  try {
    const activity = UTSAndroid.getUniActivity();
    if (activity == null) return false;
    const pkg = activity.getPackageName();
    if (Build.VERSION.SDK_INT >= 23) {
      try {
        const intent = new Intent(Settings.ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS);
        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
        activity.startActivity(intent);
        return true;
      } catch (e) {
        console.log("[AppNative] IGNORE_BATTERY_OPTIMIZATION_SETTINGS unsupported, fallback", e);
      }
    }
    // 低版本 / ROM 不认：退应用详情页
    return openAppDetailsSettings();
  } catch (e) {
    console.log("[AppNative] openBatteryOptimizationSettings error " + (e != null ? e.toString() : "unknown"));
    return false;
  }
};

/**
 * 打开厂商「自启动 / 后台运行管理」页。
 *
 * 自启动是国产 ROM 的私有能力，AOSP 没有通用 action；逐个试各家私有 Activity，
 * 全部失败时退应用详情页（用户至少能从「权限」里找到后台相关开关）。
 * 私有 Activity 名来自各 ROM 社区共识，跨版本可能改名，所以每个都单独 try，
 * 认不到就继续下一个，绝不因为一个 ROM 变了就整个功能失效。
 */
export const openAutoStartSettings: OpenAutoStartSettings = function (): boolean {
  const activity = UTSAndroid.getUniActivity();
  if (activity == null) return false;
  const pkg = activity.getPackageName();
  const brand = (Build.MANUFACTURER + " " + Build.BRAND).toLowerCase();

  // 每个 ROM 的候选页按「越精确越好」排序；命中即返回
  const targets: string[][] = [];
  if (brand.indexOf("xiaomi") >= 0 || brand.indexOf("redmi") >= 0) {
    targets.push(["com.miui.securitycenter", "com.miui.permcenter.autostart.AutoStartManagementActivity"]);
  } else if (brand.indexOf("huawei") >= 0 || brand.indexOf("honor") >= 0) {
    targets.push(["com.huawei.systemmanager", "com.huawei.systemmanager.startupmgr.ui.StartupNormalAppListActivity"]);
    targets.push(["com.huawei.systemmanager", "com.huawei.systemmanager.optimize.process.ProtectActivity"]);
  } else if (brand.indexOf("oppo") >= 0 || brand.indexOf("realme") >= 0 || brand.indexOf("oneplus") >= 0) {
    targets.push(["com.coloros.safecenter", "com.coloros.safecenter.permission.startup.StartupAppListActivity"]);
    targets.push(["com.coloros.safecenter", "com.coloros.safecenter.startupapp.StartupAppListActivity"]);
    targets.push(["com.oppo.safe", "com.oppo.safe.permission.startup.StartupAppListActivity"]);
  } else if (brand.indexOf("vivo") >= 0 || brand.indexOf("iqoo") >= 0) {
    targets.push(["com.vivo.permissionmanager", "com.vivo.permissionmanager.activity.BgStartUpManagerActivity"]);
    targets.push(["com.iqoo.secure", "com.iqoo.secure.ui.phoneoptimize.AddWhiteListActivity"]);
    targets.push(["com.iqoo.secure", "com.iqoo.secure.ui.phoneoptimize.BgStartUpManager"]);
  } else if (brand.indexOf("meizu") >= 0) {
    targets.push(["com.meizu.safe", "com.meizu.safe.permission.SmartBGActivity"]);
    targets.push(["com.meizu.safe", "com.meizu.safe.security.SHOW_APPSEC"]);
  } else if (brand.indexOf("samsung") >= 0) {
    targets.push(["com.samsung.android.lool", "com.samsung.android.sm.ui.battery.BatteryActivity"]);
    targets.push(["com.samsung.android.sm", "com.samsung.android.sm.ui.battery.BatteryActivity"]);
  } else if (brand.indexOf("asus") >= 0) {
    targets.push(["com.asus.mobilemanager", "com.asus.mobilemanager.autostart.AutoStartActivity"]);
    targets.push(["com.asus.mobilemanager", "com.asus.mobilemanager.powersaver.PowerSaverSettings"]);
  } else if (brand.indexOf("letv") >= 0 || brand.indexOf("leeco") >= 0) {
    targets.push(["com.letv.android.letvsafe", "com.letv.android.letvsafe.AutobootManageActivity"]);
  } else if (brand.indexOf("nokia") >= 0) {
    targets.push(["com.evenwell.powersaving.g3", "com.evenwell.powersaving.g3.exception.PowerSaverExceptionActivity"]);
  }

  for (let i = 0; i < targets.length; i++) {
    const t = targets[i];
    try {
      const intent = new Intent();
      intent.setComponent(new ComponentName(t[0], t[1]));
      // 各家 extra 名不统一，常见的几个都带上（多带不影响，认不到的 ROM 会忽略）
      intent.putExtra("packagename", pkg);
      intent.putExtra("pkgname", pkg);
      intent.putExtra("extra_pkgname", pkg);
      intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
      activity.startActivity(intent);
      console.log("[AppNative] openAutoStartSettings hit " + t[0] + "/" + t[1]);
      return true;
    } catch (e) {
      // 静默：该 ROM 没这个 Activity（或改名了），继续试下一个
    }
  }
  // 全部落空：退应用详情页，至少让用户能进「权限」
  console.log("[AppNative] openAutoStartSettings 无匹配私有页，退应用详情页");
  return openAppDetailsSettings();
};

/** 退出应用（关闭所有 Activity） */
export const exitAppNative: ExitAppNative = (): boolean => {
  try {
    const activity = UTSAndroid.getUniActivity();
    if (activity != null) {
      activity.finishAffinity();
      return true;
    }
  } catch (e) {
    console.log("[AppNative] exitAppNative error", e);
  }
  return false;
};

/** 安装 APK（FileProvider，兼容 Android 7+） */
export const installApkNative: InstallApkNative = (filePath: string): boolean => {
  if (filePath == null || filePath.length == 0) return false;
  try {
    const context = UTSAndroid.getAppContext();
    if (context == null) return false;
    const file = new File(filePath);
    if (!file.exists()) return false;

    const intent = new Intent();
    intent.setAction(Intent.ACTION_VIEW);
    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
    intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);

    const pkg = context.getPackageName();
    // 依次尝试可用的 FileProvider：
    //  1) 应用自身（nativeResources 中声明的 com.qt.app.fileProvider）
    //  2) uni-app x 运行时内置的 com.qt.app.dc.fileprovider
    // 都不可用时才退回 file://（Android 7+ 会抛 FileUriExposedException）
    const authorities: string[] = [pkg + ".fileProvider", pkg + ".dc.fileprovider"];
    let uri: Uri = Uri.fromFile(file);
    let hit = false;
    for (let i = 0; i < authorities.length; i++) {
      try {
        const u = FileProvider.getUriForFile(context, authorities[i], file);
        if (u != null) {
          uri = u;
          hit = true;
          console.log("[AppNative] installApkNative use authority " + authorities[i]);
          break;
        }
      } catch (e) {
        console.log("[AppNative] installApkNative authority 不可用 " + authorities[i]);
      }
    }
    if (!hit) {
      console.log("[AppNative] installApkNative 无可用 FileProvider，退回 file://");
    }
    intent.setDataAndType(uri, "application/vnd.android.package-archive");
    context.startActivity(intent);
    return true;
  } catch (e) {
    console.log("[AppNative] installApkNative error", e);
    return false;
  }
};

/* ===== 以下合并自 qt-media-store：将临时文件写入公共媒体目录 ===== */

/** 默认子目录（未传 subDir 时使用） */
const DEFAULT_SUB_DIR = "轻听";

/** 已知扩展名（含 apk — 更新 APK 也走此插件） */
const KNOWN_EXTS: string[] = [
	"mp3", "flac", "wav", "m4a", "aac", "ogg", "opus", "ape", "mp4", "wma",
	"apk",
	// 下载同时附带的封面图 / 歌词：必须登记，否则 resolveDisplayName 认不出扩展名，
	// 会兜底成「歌手 - 歌名.jpg.mp3」落进音乐目录。
	"jpg", "jpeg", "png", "webp", "lrc"
];

/** 从文件名中取出小写扩展名（不含点），取不到返回空串 */
function extOf(fileName: string): string {
	const dot = fileName.lastIndexOf(".");
	if (dot < 0 || dot == fileName.length - 1) return "";
	return fileName.substring(dot + 1).toLowerCase();
}

/** 去掉文件名末尾的扩展名（用于 TITLE 为空时兜底展示） */
function stripExt(fileName: string): string {
	const dot = fileName.lastIndexOf(".");
	if (dot <= 0) return fileName;
	return fileName.substring(0, dot);
}

/**
 * 文件名（不含扩展名）降级解析，对齐 qt-pc `local::parse_file_stem`：
 * 按 `" - "` 切**一次**——第 0 段作歌手，其余整体作标题；没有分隔符则
 * 整段作标题、歌手留空。返回 `[歌手, 标题]`。
 *
 * 为什么要和 PC 用同一条规则：同一份 `周杰伦 - 晴天.mp3`，PC 侧标签缺失时
 * 得到 歌手=周杰伦 / 标题=晴天；安卓若只信 MediaStore 的 TITLE（无标签
 * 文件它就是文件名本身），会得到 歌手="" / 标题="周杰伦 - 晴天" —— 本地
 * 优先匹配两端结果完全不同（PC 命中、安卓走在线取链）。
 *
 * 这里的顺序只是**展示用的主读法**：`晴天 - 周杰伦.mp3` 这种「歌名 - 歌手」
 * 的存量文件同样常见，从字符串本身分不出来。匹配层（`services/local-first.ts`
 * 的 `metaMatchesEither`）会把这一对交换后再试一次，解析这里不需要二选一。
 */
function parseFileStem(stem: string): string[] {
	const sep = stem.indexOf(" - ");
	if (sep < 0) {
		const only: string[] = ["", stem.trim()];
		return only;
	}
	const out: string[] = [
		stem.substring(0, sep).trim(),
		stem.substring(sep + 3).trim()
	];
	return out;
}

/** 扩展名 -> MIME，未知扩展名统一按通用二进制处理 */
function mimeOf(ext: string): string {
	if (ext == "apk") return "application/vnd.android.package-archive";
	if (ext == "mp3") return "audio/mpeg";
	if (ext == "flac") return "audio/flac";
	if (ext == "wav") return "audio/wav";
	if (ext == "m4a" || ext == "mp4") return "audio/mp4";
	if (ext == "aac") return "audio/aac";
	if (ext == "ogg" || ext == "opus") return "audio/ogg";
	if (ext == "ape") return "audio/x-ape";
	if (ext == "wma") return "audio/x-ms-wma";
	// 下载同时附带的封面图 / 歌词
	if (ext == "jpg" || ext == "jpeg") return "image/jpeg";
	if (ext == "png") return "image/png";
	if (ext == "webp") return "image/webp";
	// MediaStore 会按 MIME 校正扩展名；text/plain 不认识 .lrc 时会补成 .lrc.txt。
	// 通用类型不指定替代扩展名，保留传入的歌词文件名和 UTF-8 内容。
	if (ext == "lrc") return "application/octet-stream";
	return "application/octet-stream";
}

/** 校验扩展名是否为已知格式 */
function isKnownExt(ext: string): boolean {
	for (let i = 0; i < KNOWN_EXTS.length; i++) {
		if (KNOWN_EXTS[i] == ext) return true;
	}
	return false;
}

/** 文件名兜底：优先用传入文件名；无扩展名或未知则尝试从临时路径推断，否则退回 mp3 */
function resolveDisplayName(fileName: string, tempPath: string): string {
	let name = fileName.replace(/[\\/:*?"<>|]/g, "_").trim();
	if (name.length == 0) name = "music";
	const ext = extOf(name);
	if (isKnownExt(ext)) return name;
	const fromTemp = extOf(tempPath);
	if (isKnownExt(fromTemp)) return name + "." + fromTemp;
	return name + ".mp3";
}

/** 流拷贝 */
function copyStream(input: FileInputStream, output: OutputStream): void {
	const buffer = new ByteArray(8192);
	let count = input.read(buffer);
	while (count > 0) {
		output.write(buffer, 0, count);
		count = input.read(buffer);
	}
	output.flush();
}

/** 同名文件避让：a.mp3 -> a(1).mp3 */
function avoidDuplicate(dir: File, displayName: string): string {
	const dot = displayName.lastIndexOf(".");
	const base = dot > 0 ? displayName.substring(0, dot) : displayName;
	const suffix = dot > 0 ? displayName.substring(dot) : "";
	let candidate = displayName;
	let index = 1;
	while (new File(dir, candidate).exists() && index < 100) {
		candidate = base + "(" + index + ")" + suffix;
		index++;
	}
	return candidate;
}

/** Android 9- 直接写公共目录（需要 WRITE_EXTERNAL_STORAGE） */
function saveLegacy(source: File, dirType: string, displayName: string, mime: string, subDir: string): string {
	const activity = UTSAndroid.getUniActivity();
	if (activity == null) {
		console.log("[MediaStore] legacy: activity 为 null");
		return "";
	}
	const perms = ["android.permission.WRITE_EXTERNAL_STORAGE"];
	if (!UTSAndroid.checkSystemPermissionGranted(activity!, perms)) {
		console.log("[MediaStore] legacy: 缺少 WRITE_EXTERNAL_STORAGE 权限");
		return "";
	}
	const rootType = dirType == "music" ? Environment.DIRECTORY_MUSIC : Environment.DIRECTORY_DOWNLOADS;
	const root = Environment.getExternalStoragePublicDirectory(rootType);
	const dir = new File(root, subDir);
	if (!dir.exists()) dir.mkdirs();
	const finalName = avoidDuplicate(dir, displayName);
	const target = new File(dir, finalName);

	const input = new FileInputStream(source);
	const output = new FileOutputStream(target);
	try {
		copyStream(input, output);
	} finally {
		try { input.close(); } catch (e1) { /* 静默：关流失败不影响复制结果 */ }
		try { output.close(); } catch (e2) { /* 静默：关流失败不影响复制结果 */ }
	}

	// 通知媒体库，让文件管理器能扫描到（同样交给扫描器解析标签，见 saveAbsolute 的说明）
	try {
		const context = UTSAndroid.getAppContext();
		if (context != null) {
			const paths = [target.getAbsolutePath()];
			const mimes = [mime];
			MediaScannerConnection.scanFile(
				context,
				paths.toKotlinList().toTypedArray(),
				mimes.toKotlinList().toTypedArray(),
				null
			);
		}
	} catch (e3) {
		console.log("[MediaStore] legacy: 媒体库登记失败(文件已写入) " + (e3 != null ? e3.toString() : "unknown"));
	}
	const path = target.getAbsolutePath();
	console.log("[MediaStore] legacy 写入成功 " + path);
	return path;
}

/**
 * Android 10+ 通过 MediaStore 写入，无需存储权限。
 * 注意：MediaStore.Audio 集合只允许 Music 等音频类主目录，写 Download 目录必须改用 MediaStore.Downloads 集合；
 * APK 文件也走 MediaStore.Downloads 集合。
 */
function saveScoped(source: File, dirType: string, displayName: string, mime: string, subDir: string): string {
	const context = UTSAndroid.getAppContext();
	if (context == null) {
		console.log("[MediaStore] getAppContext 返回 null");
		return "";
	}
	const resolver = context!.getContentResolver();
	if (resolver == null) {
		console.log("[MediaStore] getContentResolver 返回 null");
		return "";
	}

	const useMusic = dirType == "music";
	const relativePath = (useMusic ? Environment.DIRECTORY_MUSIC : Environment.DIRECTORY_DOWNLOADS) + "/" + subDir + "/";
	const collection = useMusic
		? MediaStore.Audio.Media.EXTERNAL_CONTENT_URI
		: MediaStore.Downloads.EXTERNAL_CONTENT_URI;

	const values = new ContentValues();
	values.put(MediaStore.MediaColumns.DISPLAY_NAME, displayName);
	values.put(MediaStore.MediaColumns.MIME_TYPE, mime);
	values.put(MediaStore.MediaColumns.RELATIVE_PATH, relativePath);
	values.put(MediaStore.MediaColumns.IS_PENDING, 1);

	const itemUri = resolver.insert(collection, values);
	if (itemUri == null) {
		console.log("[MediaStore] insert 返回 null，relativePath=" + relativePath);
		return "";
	}

	const output = resolver.openOutputStream(itemUri!);
	if (output == null) {
		try { resolver.delete(itemUri!, null, null); } catch (e1) { /* 静默：清刚插入的空条目失败无妨，该 URI 本就无效 */ }
		console.log("[MediaStore] openOutputStream 返回 null");
		return "";
	}

	const input = new FileInputStream(source);
	try {
		copyStream(input, output!);
	} finally {
		try { input.close(); } catch (e2) { /* 静默：关流失败不影响拷贝结果 */ }
		try { output!.close(); } catch (e3) { /* 静默：关流失败不影响拷贝结果 */ }
	}

	const done = new ContentValues();
	done.put(MediaStore.MediaColumns.IS_PENDING, 0);
	resolver.update(itemUri!, done, null, null);

	// 优先返回真实文件绝对路径
	let result = itemUri!.toString();
	try {
		const columns = ["_data"];
		const cursor = resolver.query(itemUri!, columns.toKotlinList().toTypedArray(), null, null, null);
		if (cursor != null) {
			try {
				if (cursor!.moveToFirst()) {
					const path = cursor!.getString(0);
					if (path != null && path!.length > 0) result = path!;
				}
			} finally {
				cursor!.close();
			}
		}
	} catch (e4) {
		console.log("[MediaStore] 查询真实路径失败，返回 URI");
	}

	console.log("[MediaStore] 写入成功 " + result + " -> " + relativePath + displayName);
	return result;
}

/**
 * 写入用户自定义的绝对目录（下载设置 → 更改位置 选出来的）。
 *
 * 这里**故意绕开 MediaStore**，用 java.io.File 直写：自定义目录可能在 Download 之外
 * （比如 SD 卡、Documents、自己建的目录），MediaStore 的 RELATIVE_PATH 只认
 * Download/DCIM/Music 等几个白名单主目录，塞不进去。代价是需要「所有文件访问」
 * （MANAGE_EXTERNAL_STORAGE，Android 11+ 由用户在系统设置里开；Android 10 及以下
 * 有 WRITE_EXTERNAL_STORAGE 就够）。没有权限时直接返回空串，调用方降级到固定目录，
 * 不让下载整体失败。
 *
 * 写完后同样往媒体库登记一次，否则第三方文件管理器要等重启才看得到新文件。
 */
function saveAbsolute(source: File, dirPath: string, displayName: string, mime: string): string {
	// 权限预检：Android 11+ 必须「所有文件访问」，否则 FileOutputStream 会抛
	// FileNotFoundException(EACCES)，报错信息对用户毫无意义，不如提前拦下来。
	const sdk = Build.VERSION.SDK_INT;
	let allowed = false;
	if (sdk >= 30) {
		allowed = Environment.isExternalStorageManager();
	} else {
		const activity = UTSAndroid.getUniActivity();
		allowed = activity != null && UTSAndroid.checkSystemPermissionGranted(activity!, ["android.permission.WRITE_EXTERNAL_STORAGE"]);
	}
	if (!allowed) {
		console.log("[MediaStore] 自定义目录缺少存储权限，dir=" + dirPath);
		return "";
	}

	const dir = new File(dirPath);
	if (!dir.exists() && !dir.mkdirs()) {
		console.log("[MediaStore] 自定义目录创建失败 dir=" + dirPath);
		return "";
	}
	if (!dir.isDirectory() || !dir.canWrite()) {
		console.log("[MediaStore] 自定义目录不可写 dir=" + dirPath);
		return "";
	}

	const finalName = avoidDuplicate(dir, displayName);
	const target = new File(dir, finalName);

	const input = new FileInputStream(source);
	const output = new FileOutputStream(target);
	try {
		copyStream(input, output);
	} finally {
		try { input.close(); } catch (e1) { /* 静默：关流失败不影响复制结果 */ }
		try { output.close(); } catch (e2) { /* 静默：关流失败不影响复制结果 */ }
	}

	// 通知媒体库（音频才有意义；封面/歌词登记失败无所谓，不影响文件本身）。
	// 走 MediaScannerConnection 而不是手工 insert：手工 insert 只能塞进
	// DISPLAY_NAME / MIME_TYPE / DATA，TITLE、ARTIST、DURATION、IS_MUSIC 全是 NULL，
	// 而且记录一旦存在，扫描器就不会再补标签 —— 于是这些歌在别的播放器里显示成
	// 空标题、被「只显示音乐」类过滤掉。扫描器会真正解析文件头，标签齐全。
	try {
		const context = UTSAndroid.getAppContext();
		if (context != null && mime.indexOf("audio/") == 0) {
			const paths = [target.getAbsolutePath()];
			const mimes = [mime];
			MediaScannerConnection.scanFile(
				context,
				paths.toKotlinList().toTypedArray(),
				mimes.toKotlinList().toTypedArray(),
				null
			);
		}
	} catch (e3) {
		console.log("[MediaStore] 自定义目录：媒体库登记失败(文件已写入) " + (e3 != null ? e3.toString() : "unknown"));
	}

	const path = target.getAbsolutePath();
	console.log("[MediaStore] 自定义目录写入成功 " + path);
	return path;
}

/**
 * 检查/申请写公共目录的权限。
 * Android 10+ 用 MediaStore，无需权限，直接 resolve true；
 * Android 9- 需要 WRITE_EXTERNAL_STORAGE：已授权 resolve true，
 * 未授权时拉起系统权限弹窗并在回调里 resolve 最终结果（同意 true / 拒绝 false）。
 *
 * 改成 Promise 的原因：老实现弹窗后立刻返回 false，导致**第一次下载**必然落到私有目录，
 * 用户要再点一次才会进公共目录。现在等回调，第一次点下载就能直接进公共目录。
 */
export const ensurePublicDirPermission: EnsurePublicDirPermission = function (): Promise<boolean> {
	return new Promise<boolean>((resolve: (value: boolean) => void, reject: (err: any) => void) => {
		const sdk = Build.VERSION.SDK_INT;
		if (sdk >= 29) {
			resolve(true);
			return;
		}
		const activity = UTSAndroid.getUniActivity();
		if (activity == null) {
			resolve(false);
			return;
		}
		const perms = ["android.permission.WRITE_EXTERNAL_STORAGE"];
		if (UTSAndroid.checkSystemPermissionGranted(activity!, perms)) {
			resolve(true);
			return;
		}
		UTSAndroid.requestSystemPermission(activity!, perms, function (allRight: boolean, granted: string[]) {
			console.log("[MediaStore] 存储权限申请结果 " + allRight);
			resolve(allRight);
		}, function (doNotAskAgain: boolean, granted: string[]) {
			console.log("[MediaStore] 存储权限被拒绝 doNotAskAgain=" + doNotAskAgain);
			resolve(false);
		});
	});
}

export const saveToPublicMedia: SaveToPublicMedia = function (
	tempPath: string,
	dirType: string,
	fileName: string,
	subDir?: string,
	absDir?: string
): Promise<string> {
	return new Promise<string>((resolve: (value: string) => void, reject: (err: any) => void) => {
		try {
			// tempFilePath 可能是 file:// 或 unifile://sandbox/... 形式，统一转成绝对路径
			let realPath = tempPath;
			if (realPath.indexOf("file://") == 0) realPath = realPath.substring(7);
			let source = new File(realPath);
			if (!source.exists()) {
				const converted = UTSAndroid.convert2AbsFullPath(tempPath);
				if (converted.length > 0) {
					source = new File(converted);
					realPath = converted;
				}
			}
			if (!source.exists()) {
				console.log("[MediaStore] 源文件不存在 tempPath=" + tempPath + " realPath=" + realPath);
				resolve("");
				return;
			}

			const displayName = resolveDisplayName(fileName, realPath);
			const mime = mimeOf(extOf(displayName));

			// 用户自定义目录优先：非空时忽略 dirType/subDir，直接写绝对路径
			const custom = absDir != null && absDir!.length > 0 ? absDir! : "";
			if (custom.length > 0) {
				console.log("[MediaStore] 自定义目录 dir=" + custom + " name=" + displayName);
				resolve(saveAbsolute(source, custom, displayName, mime));
				return;
			}

			const dir = subDir != null && subDir.length > 0 ? subDir : DEFAULT_SUB_DIR;
			const sdk = Build.VERSION.SDK_INT;
			console.log("[MediaStore] sdk=" + sdk + " dirType=" + dirType + " subDir=" + dir + " name=" + displayName + " mime=" + mime);

			if (sdk >= 29) {
				resolve(saveScoped(source, dirType, displayName, mime, dir));
				return;
			}
			resolve(saveLegacy(source, dirType, displayName, mime, dir));
		} catch (e) {
			console.log("[MediaStore] 写入失败 " + (e != null ? e.toString() : "unknown"));
			resolve("");
		}
	});
};

/** 真正执行 MediaStore 音频扫描（调用前需已具备读取权限） */
function doScanAudio(): LocalAudioItem[] {
	const items: LocalAudioItem[] = [];
	try {
		const context = UTSAndroid.getAppContext();
		if (context == null) return items;
		// projection 传 null 返回全部列，再用 getColumnIndex 定位（UTSArray 与 Kotlin Array<String> 类型不兼容，不能显式传列数组）
		//
		// 这里**故意不做 IS_MUSIC 过滤**：MediaStore 的 is_music 是「目录启发式」的产物，
		// 文件只要落在 Ringtones/ 之类的目录名下就是 0，哪怕它本身是首完整的歌；反过来
		// 应用自己的按钮音效却常常是 1。更要命的是 SQL 三值逻辑：媒体库里手工插入或
		// 尚未补全标签的行 is_music 为 NULL，`NULL != 0` 求值为 NULL（假），会被整行丢掉 ——
		// 用户自己放进下载目录的歌就是这么消失的。所以这里返回完整音频池，
		// 「系统音」的取舍交给页面（默认排除，并提供「包含系统音」开关，切换无需重扫）。
		const sortOrder = MediaStore.Audio.Media.DATE_ADDED + " DESC";
		const cursor = context.getContentResolver().query(
			MediaStore.Audio.Media.EXTERNAL_CONTENT_URI,
			null,
			null,
			null,
			sortOrder
		);
		if (cursor == null) return items;
		const idxId = cursor.getColumnIndex(MediaStore.Audio.Media._ID);
		const idxTitle = cursor.getColumnIndex(MediaStore.Audio.Media.TITLE);
		const idxArtist = cursor.getColumnIndex(MediaStore.Audio.Media.ARTIST);
		const idxAlbum = cursor.getColumnIndex(MediaStore.Audio.Media.ALBUM);
		const idxDuration = cursor.getColumnIndex(MediaStore.Audio.Media.DURATION);
		const idxSize = cursor.getColumnIndex(MediaStore.Audio.Media.SIZE);
		const idxMtime = cursor.getColumnIndex(MediaStore.Audio.Media.DATE_MODIFIED);
		const idxPath = cursor.getColumnIndex(MediaStore.Audio.Media.DATA);
		const idxName = cursor.getColumnIndex(MediaStore.MediaColumns.DISPLAY_NAME);
		const idxIsMusic = cursor.getColumnIndex(MediaStore.Audio.Media.IS_MUSIC);
		while (cursor.moveToNext()) {
			const id = cursor.getLong(idxId);
			const titleRaw = cursor.getString(idxTitle) ?? "";
			const nameRaw = idxName >= 0 ? (cursor.getString(idxName) ?? "") : "";
			const artistRaw = cursor.getString(idxArtist) ?? "";
			const album = cursor.getString(idxAlbum) ?? "";
			const durationMs = cursor.getLong(idxDuration);
			const sizeBytes = cursor.getLong(idxSize);
			const modified = cursor.getLong(idxMtime);
			const path = cursor.getString(idxPath) ?? "";
			// is_music 只作为附加信息带出去（-1 = 媒体库没有该列或为 NULL，即「未知」），
			// 不参与过滤：我们自己的下载记录就是 NULL，不能当成「非歌曲」。
			const isMusic = idxIsMusic >= 0 && !cursor.isNull(idxIsMusic) ? cursor.getInt(idxIsMusic) : -1;
			// 标题/歌手：标签有就用标签，缺哪一个才用文件名解析补 —— 与 PC 端
			// `local::build_row` 的逐字段回落同一口径（不是「标签整体失败才降级」）。
			// 时长也可能为 NULL/0，那种行仍然列出来，只是时长显示为 0。
			const stem = stripExt(nameRaw);
			const stemParts = parseFileStem(stem);
			const stemSinger = stemParts[0];
			const stemTitle = stemParts[1];
			const artist = artistRaw == "<unknown>" ? "" : artistRaw.trim();
			// 无标签文件的 TITLE 就是文件名本身（MediaStore 的行为）：这种「伪标签」
			// 按文件名派生处理，否则标题会带着「歌手 - 」前缀，跟 PC 的标题对不上。
			const titleFromStem = titleRaw.length == 0 || titleRaw.trim() == stem;
			let title = titleFromStem ? stemTitle : titleRaw;
			if (title.length == 0) title = stemTitle;
			if (title.length == 0) continue;
			const singer = artist.length > 0 ? artist : stemSinger;
			const item: LocalAudioItem = {
				id: "local_" + id.toString(),
				title: title,
				singer: singer,
				album: album,
				// 不取整：PC 侧时长是 f64 秒（symphonia 报的 269.808…），这里
				// floor 会让同一首歌两端最多差近 1 秒，3 秒护栏被无谓吃掉
				duration: Math.max(durationMs, 0) / 1000,
				uri: "content://media/external/audio/media/" + id.toString(),
				path: path,
				size: sizeBytes,
				mtime: modified,
				isMusic: isMusic
			};
			items.push(item);
		}
		cursor.close();
	} catch (e) {
		console.log("[LocalAudio] 扫描失败 " + (e != null ? e.toString() : "unknown"));
	}
	console.log("[LocalAudio] 扫描完成 " + items.length + " 首");
	return items;
}

export const scanLocalAudio: ScanLocalAudio = function (onResult: (items: LocalAudioItem[]) => void): void {
	const activity = UTSAndroid.getUniActivity();
	if (activity == null) {
		onResult([]);
		return;
	}
	// targetSdkVersion >= 33 时权限库强制要求 READ_MEDIA_* 细分权限，
	// 即使设备系统低于 Android 13 也不能传 READ_EXTERNAL_STORAGE（会抛 IllegalArgumentException）
	const perms = ["android.permission.READ_MEDIA_AUDIO"];
	if (UTSAndroid.checkSystemPermissionGranted(activity, perms)) {
		onResult(doScanAudio());
		return;
	}
	try {
		UTSAndroid.requestSystemPermission(activity, perms, function (allRight: boolean, granted: string[]) {
			console.log("[LocalAudio] 音频权限申请结果 " + allRight);
			onResult(allRight ? doScanAudio() : []);
		}, function (doNotAskAgain: boolean, granted: string[]) {
			console.log("[LocalAudio] 音频权限被拒 doNotAskAgain=" + doNotAskAgain);
			onResult([]);
		});
	} catch (e) {
		// 权限框架异常时也必须回调，避免页面停留在“扫描中”
		console.log("[LocalAudio] 音频权限申请异常 " + (e != null ? e.toString() : "unknown"));
		onResult([]);
	}
};

// Android 11+ 分区存储：删除第三方公共媒体（非本应用写入的文件）时，
// ContentResolver.delete 会抛 RecoverableSecurityException。正确做法是
// Android 11+ 分区存储：第三方公共媒体（非本应用写入的文件）无写/删权限，ContentResolver.delete
// 会抛 RecoverableSecurityException，File.delete 也删不动。要删第三方文件需先开通「所有文件
// 访问」权限（MANAGE_EXTERNAL_STORAGE，由用户在系统设置里开启）。createDeleteRequest 的系统
// 确认框虽更优雅，但其返回的 IntentSender 在 UTS SDK 中被认定为 PendingIntent、无法编译，故改用
// 全部文件访问 + File.delete 方案（不依赖 IntentSender/集合类型，编译稳定、删得彻底）。
// 仅在一次运行里引导一次「所有文件访问」设置页，避免反复打断。
let manageAccessPrompted = false;

export const deleteLocalMedia: DeleteLocalMedia = (items: LocalAudioItem[]): DeleteLocalMediaResult => {
	const result: DeleteLocalMediaResult = { deleted: 0, pending: 0, failed: 0 };
	const context = UTSAndroid.getAppContext();
	if (context == null) {
		result.failed = items.length;
		return result;
	}
	// 是否已开通「所有文件访问」（API 30+，决定能否删第三方公共媒体文件）
	const hasManage = Build.VERSION.SDK_INT >= 30 && Environment.isExternalStorageManager();
	for (let i = 0; i < items.length; i++) {
		const it = items[i];
		let removed = false;
		// 1) 应用自有的音频：按 content URI 删 MediaStore 条目（会连磁盘文件一起删）
		if (it.uri != null && it.uri.length > 0) {
			try {
				const rows = context.getContentResolver().delete(Uri.parse(it.uri), null, null);
				if (rows > 0) removed = true;
			} catch (e) {
				// 静默：第三方公共媒体分区存储无删除权限，靠第 2 步 File.delete
			}
		}
		// 2) 按绝对路径删文件：已开通「所有文件访问」时第三方文件也能删
		if (!removed && it.path != null && it.path.length > 0) {
			try {
				const f = new File(it.path);
				if (f.exists() && f.delete()) removed = true;
			} catch (e) {
				console.log("[LocalAudio] File.delete 失败 " + (e != null ? e.toString() : "unknown"));
			}
		}
		if (removed) result.deleted++;
		else result.failed++;
	}
	// 3) 有删不掉、且系统支持、又还没开「所有文件访问」→ 引导去系统设置开一次
	if (result.failed > 0 && Build.VERSION.SDK_INT >= 30 && !hasManage && !manageAccessPrompted) {
		manageAccessPrompted = true;
		let opened = false;
		try {
			const activity = UTSAndroid.getUniActivity();
			if (activity != null) {
				try {
					activity.startActivity(new Intent(Settings.ACTION_MANAGE_ALL_FILES_ACCESS_PERMISSION));
					opened = true;
				} catch (e1) {
					// 个别 ROM 不认该入口：退回应用详情页，用户可手动开「所有文件访问」
					try {
						activity.startActivity(new Intent(
							Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
							Uri.parse("package:" + context.getPackageName())
						));
						opened = true;
					} catch (e2) {
						opened = false;
					}
				}
			}
		} catch (e) {
			opened = false;
		}
		if (opened) {
			result.pending = result.failed;
			result.failed = 0;
		}
	}
	return result;
};

// ==================== 按路径批量删除媒体文件（下载管理） ====================

/**
 * 按 DATA 列（_data）在指定 MediaStore 集合里反查 content URI 并删除。
 * 下载记录只持久化了绝对路径（saveToPublicMedia 返回的就是 DATA 路径），
 * 删除时按路径反查条目，删条目会连磁盘文件一起删掉。
 * @returns 删掉的行数（0 = 该集合里没有这个路径）
 */
function deleteByDataPath(collection: Uri, path: string, context: Context): number {
	try {
		const args = [path];
		const cursor = context.getContentResolver().query(
			collection,
			null,
			MediaStore.MediaColumns.DATA + " = ?",
			args.toKotlinList().toTypedArray(),
			null
		);
		if (cursor == null) return 0;
		try {
			if (cursor!.moveToFirst()) {
				// _ID 的字面值在所有集合里都是 "_id"，沿用 doScanAudio 的列名与 URI 拼法
				const idxId = cursor!.getColumnIndex(MediaStore.Audio.Media._ID);
				const id = cursor!.getLong(idxId);
				const itemUri = Uri.parse(collection.toString() + "/" + id.toString());
				return context.getContentResolver().delete(itemUri, null, null);
			}
		} finally {
			cursor!.close();
		}
		return 0;
	} catch (e) {
		console.log("[MediaStore] 按路径反查删除失败 " + (e != null ? e.toString() : "unknown"));
		return 0;
	}
}

export const deleteMediaByPath: DeleteMediaByPath = (paths: string[]): DeleteLocalMediaResult => {
	const result: DeleteLocalMediaResult = { deleted: 0, pending: 0, failed: 0 };
	const context = UTSAndroid.getAppContext();
	if (context == null) {
		result.failed = paths.length;
		return result;
	}
	for (let i = 0; i < paths.length; i++) {
		let raw = paths[i];
		if (raw == null || raw.length == 0) {
			result.failed++;
			continue;
		}
		// file:// / unifile://sandbox/... 统一转成绝对路径（与 saveToPublicMedia 同规则）
		let abs = raw;
		if (abs.indexOf("file://") == 0) abs = abs.substring(7);
		let f = new File(abs);
		if (!f.exists()) {
			const converted = UTSAndroid.convert2AbsFullPath(raw);
			if (converted.length > 0) {
				f = new File(converted);
				abs = converted;
			}
		}
		let removed = false;
		// 1) MediaStore 反查删除（API 29+ 在 Downloads 集合，API 28- 落在 Audio 集合）。
		//    只删本应用写入的文件：自有条目无分区存储限制，不会抛 RecoverableSecurityException。
		if (Build.VERSION.SDK_INT >= 29) {
			if (deleteByDataPath(MediaStore.Downloads.EXTERNAL_CONTENT_URI, abs, context) > 0) removed = true;
		} else {
			if (deleteByDataPath(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, abs, context) > 0) removed = true;
		}
		// 2) File.delete 兜底（条目反查不到、或已删但文件残留时）
		if (!removed) {
			try {
				if (f.exists() && f.delete()) removed = true;
			} catch (e) {
				console.log("[MediaStore] File.delete 失败 " + (e != null ? e.toString() : "unknown"));
			}
		}
		if (removed) result.deleted++;
		else result.failed++;
	}
	console.log("[MediaStore] 按路径删除完成 " + result.deleted + "/" + paths.length);
	return result;
};

/** pickJsFile 用的 Activity result 请求码（避开运行时已占用的区间，过滤时严格比对） */
// 必须显式标 Int：UTS 字面量默认推断 number（编译为 Kotlin Number），
// startActivityForResult / onAppActivityResult 的 requestCode 都是 Int，
// 不标会在 705 行报「实际类型为 Number，预期类型为 Int」（error17）
const PICK_JS_FILE_REQUEST: Int = 40011;
/** 一次只允许一个选择会话：后点的顶掉先点的（回调置空防串扰） */
let pickJsFileCallback: ((result: PickFileResult) => void) | null = null;
/** onAppActivityResult 只注册一次 */
let pickJsFileListenerReady = false;

/**
 * 打开系统文件选择器（ACTION_OPEN_DOCUMENT），选中后经 contentResolver 读回
 * UTF-8 全文。选择器只接受 JavaScript MIME，读取前还须校验显示名以 .js 结尾，
 * 避免文件管理器错误归类时读入其他文件。包内容再由上层 installFromText
 * 校验。ACTION_OPEN_DOCUMENT 返回的 content URI 只有
 * 一次性读权限，所以必须在这里把内容读出来回传（不能把 URI 存着以后用）。
 */
export const pickJsFile: PickJsFile = function (onResult: (result: PickFileResult) => void): void {
	const activity = UTSAndroid.getUniActivity();
	if (activity == null) {
		onResult({ ok: false, name: "", content: "", message: "窗口未就绪，请稍后重试" } as PickFileResult);
		return;
	}
	if (!pickJsFileListenerReady) {
		pickJsFileListenerReady = true;
		UTSAndroid.onAppActivityResult((requestCode: Int, resultCode: Int, data?: Intent) => {
			if (requestCode != PICK_JS_FILE_REQUEST) return;
			const cb = pickJsFileCallback;
			pickJsFileCallback = null;
			if (cb == null) return;
			// Activity.RESULT_OK = -1；取消/关闭都按「用户取消」处理
			if (resultCode != -1 || data == null) {
				cb({ ok: false, name: "", content: "", message: "已取消选择" } as PickFileResult);
				return;
			}
			const uri = data.getData();
			if (uri == null) {
				cb({ ok: false, name: "", content: "", message: "未选择文件" } as PickFileResult);
				return;
			}
			try {
				const resolver = activity.getContentResolver();
				// 显示名用于后缀校验，无法确认类型时不读取。
				let name = "";
				try {
					const cursor = resolver.query(uri, null, null, null, null);
					if (cursor != null && cursor.moveToFirst()) {
						const idx = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME);
						if (idx >= 0) name = cursor.getString(idx);
					}
					if (cursor != null) cursor.close();
				} catch (e) {
					// 静默：读显示名失败由下面后缀校验兜底拒绝
				}
				if (!name.toLowerCase().endsWith(".js") || name.length <= 3) {
					cb({ ok: false, name: name, content: "", message: "请选择 .js 格式的音源文件" } as PickFileResult);
					return;
				}
				const reader = new BufferedReader(new InputStreamReader(resolver.openInputStream(uri), "UTF-8"));
				let text = "";
				let overflow = false;
				while (true) {
					const line = reader.readLine();
					if (line == null) break;
					text += line;
					text += "\n";
					// 防御：音源包撑死几 MB，超 16MB 当作选错文件直接放弃
					if (text.length > 16 * 1024 * 1024) {
						overflow = true;
						break;
					}
				}
				reader.close();
				if (overflow) {
					cb({ ok: false, name: name, content: "", message: "文件过大（超过 16MB），不是音源包" } as PickFileResult);
					return;
				}
				if (text.length == 0) {
					cb({ ok: false, name: name, content: "", message: "文件内容为空" } as PickFileResult);
					return;
				}
				cb({ ok: true, name: name, content: text, message: "" } as PickFileResult);
			} catch (e) {
				console.log("[AppNative] pickJsFile read error " + (e != null ? e.toString() : "unknown"));
				cb({ ok: false, name: "", content: "", message: "读取文件失败" } as PickFileResult);
			}
		});
	}
	try {
		const intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
		intent.addCategory(Intent.CATEGORY_OPENABLE);
		intent.setType("application/javascript");
		const mimeTypes: string[] = ["application/javascript", "text/javascript", "application/x-javascript", "text/x-javascript", "application/ecmascript", "text/ecmascript"];
		intent.putExtra(Intent.EXTRA_MIME_TYPES, mimeTypes.toKotlinList().toTypedArray());
		pickJsFileCallback = onResult;
		activity.startActivityForResult(intent, PICK_JS_FILE_REQUEST);
	} catch (e) {
		pickJsFileCallback = null;
		console.log("[AppNative] pickJsFile launch error " + (e != null ? e.toString() : "unknown"));
		onResult({ ok: false, name: "", content: "", message: "无法打开文件选择器" } as PickFileResult);
	}
};

// ==================== 权限状态查询（设置页「权限管理」） ====================
//
// Android 的权限分三类，查询方式完全不同，页面拿不到统一口径，所以在这里收敛：
//   1) 普通权限（INTERNET / FOREGROUND_SERVICE* / WAKE_LOCK）：安装即授予，
//      系统不提供（也不需要）运行时查询，恒 applicable + granted；
//   2) 运行时权限（POST_NOTIFICATIONS / READ_MEDIA_AUDIO / WRITE_EXTERNAL_STORAGE）：
//      走 UTSAndroid.checkSystemPermissionGranted，但各自有生效的版本区间
//      （WRITE_EXTERNAL_STORAGE 只到 Android 9，另外两个从 Android 13 起）；
//   3) 特殊权限（所有文件访问 / 悬浮窗 / 安装未知应用）：系统不把它们当运行时
//      权限，checkSystemPermissionGranted 永远返回 false，必须走各自 API
//      （Environment.isExternalStorageManager / Settings.canDrawOverlays /
//      PackageManager.canRequestPackageInstalls）。

/** 普通权限：安装即授予，无需也不可运行时查询 */
const NORMAL_PERMISSIONS: string[] = [
	"android.permission.INTERNET",
	"android.permission.FOREGROUND_SERVICE",
	"android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
	"android.permission.WAKE_LOCK",
];

/** 运行时权限：走 checkSystemPermissionGranted（生效版本区间另判） */
const RUNTIME_PERMISSIONS: string[] = [
	"android.permission.POST_NOTIFICATIONS",
	"android.permission.READ_MEDIA_AUDIO",
	"android.permission.WRITE_EXTERNAL_STORAGE",
];

export const queryPermissionStates: QueryPermissionStates = function (ids: string[]): PermissionState[] {
	const out: PermissionState[] = [];
	const sdk = Build.VERSION.SDK_INT;
	for (let i = 0; i < ids.length; i++) {
		const id = ids[i];
		const state: PermissionState = { id: id, applicable: true, granted: false, unknown: false } as PermissionState;

		// 1) 普通权限
		if (NORMAL_PERMISSIONS.indexOf(id) >= 0) {
			state.granted = true;
			out.push(state);
			continue;
		}

		// 2) 特殊权限：各自专属 API，查不到时标 unknown（页面显示「无法确定」）
		if (id == "android.permission.MANAGE_EXTERNAL_STORAGE") {
			// 「所有文件访问」Android 11+ 才有这个概念
			state.applicable = sdk >= 30;
			if (state.applicable) {
				try {
					state.granted = Environment.isExternalStorageManager();
				} catch (e) {
					state.unknown = true;
				}
			}
			out.push(state);
			continue;
		}
		if (id == "android.permission.SYSTEM_ALERT_WINDOW") {
			// 悬浮窗 Android 6.0 起才需要用户授权，之前版本安装即授予
			state.applicable = sdk >= 23;
			if (state.applicable) {
				try {
					const ctx = UTSAndroid.getAppContext();
					if (ctx == null) {
						state.unknown = true;
					} else {
						state.granted = Settings.canDrawOverlays(ctx);
					}
				} catch (e) {
					state.unknown = true;
				}
			}
			out.push(state);
			continue;
		}
		if (id == "android.permission.REQUEST_INSTALL_PACKAGES") {
			// 「安装未知应用」按来源应用授权，Android 8.0 起才有
			state.applicable = sdk >= 26;
			if (state.applicable) {
				try {
					const ctx = UTSAndroid.getAppContext();
					if (ctx == null) {
						state.unknown = true;
					} else {
						const pm: PackageManager = ctx.getPackageManager();
						state.granted = pm.canRequestPackageInstalls();
					}
				} catch (e) {
					state.unknown = true;
				}
			}
			out.push(state);
			continue;
		}

		// 3) 运行时权限：先判当前系统版本上是否还适用，再查授权
		if (RUNTIME_PERMISSIONS.indexOf(id) >= 0) {
			let applicable = true;
			if (id == "android.permission.POST_NOTIFICATIONS") {
				applicable = sdk >= 33;
			} else if (id == "android.permission.READ_MEDIA_AUDIO") {
				applicable = sdk >= 33;
			} else if (id == "android.permission.WRITE_EXTERNAL_STORAGE") {
				// manifest 里声明了 maxSdkVersion=28：Android 10+ 走分区存储，此权限不再申请
				applicable = sdk <= 28;
			}
			state.applicable = applicable;
			if (!applicable) {
				out.push(state);
				continue;
			}
			const activity = UTSAndroid.getUniActivity();
			if (activity == null) {
				// 窗口未就绪：宁可显示「无法确定」，也不要误报「未授权」引导用户去设置
				state.unknown = true;
				out.push(state);
				continue;
			}
			try {
				const perms: string[] = [id];
				state.granted = UTSAndroid.checkSystemPermissionGranted(activity, perms);
			} catch (e) {
				state.unknown = true;
			}
			out.push(state);
			continue;
		}

		// 4) 未识别的 id：不猜，交给页面显示「无法确定」
		state.unknown = true;
		out.push(state);
	}
	return out;
};

export const openPermissionSettings: OpenPermissionSettings = function (id: string): boolean {
	const activity = UTSAndroid.getUniActivity();
	if (activity == null) return false;
	const pkgUri = Uri.parse("package:" + activity.getPackageName());

	// 1) 特殊权限：能直达就直达（个别 ROM 不认这些入口，落到最后的应用详情页）
	if (id == "android.permission.MANAGE_EXTERNAL_STORAGE" && Build.VERSION.SDK_INT >= 30) {
		try {
			activity.startActivity(new Intent(Settings.ACTION_MANAGE_ALL_FILES_ACCESS_PERMISSION));
			return true;
		} catch (e) {
			// 静默：该 ROM 不认此入口，继续往下试
		}
	}
	if (id == "android.permission.SYSTEM_ALERT_WINDOW") {
		try {
			activity.startActivity(new Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION, pkgUri));
			return true;
		} catch (e) {
			// 静默：该 ROM 不认此入口，继续往下试
		}
	}
	if (id == "android.permission.REQUEST_INSTALL_PACKAGES" && Build.VERSION.SDK_INT >= 26) {
		try {
			activity.startActivity(new Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES, pkgUri));
			return true;
		} catch (e) {
			// 静默：该 ROM 不认此入口，继续往下试
		}
	}
	// 通知：与 openNotificationSettings 同口径，先试本应用通知页
	if (id == "android.permission.POST_NOTIFICATIONS") {
		try {
			const intent = new Intent("android.settings.APP_NOTIFICATION_SETTINGS");
			intent.putExtra("android.provider.extra.APP_PACKAGE", activity.getPackageName());
			activity.startActivity(intent);
			return true;
		} catch (e) {
			// 静默：该 ROM 不认此入口，落到应用详情页兜底
		}
	}

	// 2) 运行时权限与兜底：应用详情页（权限清单就在里面，用户可逐条开关）
	try {
		activity.startActivity(new Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS, pkgUri));
		return true;
	} catch (e) {
		console.log("[AppNative] openPermissionSettings error " + (e != null ? e.toString() : "unknown"));
		return false;
	}
};

// ==================== 下载目录选择（下载设置 → 更改位置） ====================

/** pickDirectory 用的 Activity result 请求码（与 pickJsFile 分开，避免串扰） */
const PICK_DIR_REQUEST: Int = 40012;
/** 一次只允许一个目录选择会话 */
let pickDirCallback: ((result: PickDirectoryResult) => void) | null = null;
/** 目录选择的 onAppActivityResult 只注册一次 */
let pickDirListenerReady = false;

/**
 * 把 ACTION_OPEN_DOCUMENT_TREE 返回的 document URI 反解成真实绝对路径。
 *
 * tree URI 形如 content://com.android.externalstorage.documents/tree/primary%3ADownload%2FQtMusic，
 * DocumentsContract.getTreeDocumentId 解出 "primary:Download/QtMusic"：冒号前是卷标识
 * （primary = 内置存储，其余是 SD 卡卷 UUID），冒号后是卷内相对路径。
 *
 * 反解真实路径而不是长期持有 URI，是为了后续用 java.io.File 直写（见 saveAbsolute 的注释）。
 * 拿不到映射时返回空串，调用方会提示用户改选内置存储。
 */
function treeUriToPath(uri: Uri): string {
	const docId = DocumentsContract.getTreeDocumentId(uri);
	if (docId == null || docId.length == 0) return "";
	const sep = docId.indexOf(":");
	if (sep < 0) return "";
	const volume = docId.substring(0, sep);
	const relative = docId.substring(sep + 1);

	let base = "";
	if (volume == "primary") {
		base = Environment.getExternalStorageDirectory().getAbsolutePath();
	} else {
		// SD 卡 / U 盘：卷标识就是 /storage 下的目录名
		base = "/storage/" + volume;
	}
	if (base.length == 0) return "";
	if (relative.length == 0) return base;
	return base + "/" + relative;
}

/**
 * 打开系统文件管理器选一个目录（ACTION_OPEN_DOCUMENT_TREE）。
 *
 * 只回传路径、不申请持久化 URI 授权（takePersistableUriPermission）：本项目写文件走
 * java.io.File 直写，权限由「所有文件访问」提供，不依赖 URI 授权，也就没有「重启后
 * 授权失效、下载静默失败」的坑。调用方需要在调用前确保已获得该权限。
 */
export const pickDirectory: PickDirectory = function (onResult: (result: PickDirectoryResult) => void): void {
	const activity = UTSAndroid.getUniActivity();
	if (activity == null) {
		onResult({ ok: false, path: "", name: "", message: "窗口未就绪，请稍后重试" } as PickDirectoryResult);
		return;
	}
	if (!pickDirListenerReady) {
		pickDirListenerReady = true;
		UTSAndroid.onAppActivityResult((requestCode: Int, resultCode: Int, data?: Intent) => {
			if (requestCode != PICK_DIR_REQUEST) return;
			const cb = pickDirCallback;
			pickDirCallback = null;
			if (cb == null) return;
			// Activity.RESULT_OK = -1；取消/关闭都按「用户取消」处理
			if (resultCode != -1 || data == null) {
				cb({ ok: false, path: "", name: "", message: "已取消选择" } as PickDirectoryResult);
				return;
			}
			const uri = data.getData();
			if (uri == null) {
				cb({ ok: false, path: "", name: "", message: "未选择目录" } as PickDirectoryResult);
				return;
			}
			try {
				const path = treeUriToPath(uri!);
				if (path.length == 0) {
					cb({ ok: false, path: "", name: "", message: "无法解析该目录，请改选内置存储" } as PickDirectoryResult);
					return;
				}
				// 显示名取路径最后一段（文档树拿不到友好的目录名）
				let name = path;
				const slash = path.lastIndexOf("/");
				if (slash >= 0 && slash < path.length - 1) name = path.substring(slash + 1);
				cb({ ok: true, path: path, name: name, message: "" } as PickDirectoryResult);
			} catch (e) {
				console.log("[AppNative] pickDirectory resolve error " + (e != null ? e.toString() : "unknown"));
				cb({ ok: false, path: "", name: "", message: "解析目录失败" } as PickDirectoryResult);
			}
		});
	}
	try {
		const intent = new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
		// 部分 ROM 不指定这两项会只显示「最近」，看不到完整目录树
		intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
		intent.addFlags(Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
		pickDirCallback = onResult;
		activity.startActivityForResult(intent, PICK_DIR_REQUEST);
	} catch (e) {
		pickDirCallback = null;
		console.log("[AppNative] pickDirectory launch error " + (e != null ? e.toString() : "unknown"));
		onResult({ ok: false, path: "", name: "", message: "无法打开文件管理器" } as PickDirectoryResult);
	}
};

// 自定义目录 URI 只对鸿蒙有意义：Android 选完目录后反解成真实路径直接写文件，
// 不需要「启动时把 URI 喂回原生」这一步，空实现。
export const setCustomDirUri: SetCustomDirUri = function (uri: string): void {
};

// ==================== 音频标签内嵌（下载内嵌封面/歌词） ====================

/** 读文件的最多 maxLen 字节（不足则全量）。经 Base64 桥转 Uint8Array：UTS 对
 *  kotlin ByteArray 的元素级访问没有可靠先例（既有代码只把 ByteArray 当整块流缓冲），
 *  而 android.util.Base64.encodeToString 是稳定静态通道；分片避免中途产生巨型中间串。
 *
 *  ⚠️ 分片**必须逐片解码再按字节拼装**：多片各自带 `=` 填充后连成一个大 base64 串是
 *  非法输入（填充只允许出现在末尾），一次性解码会整体失败。2026-10-25 真机实测：118KB
 *  封面 = 2 片，`pad` 累计 4 > 2 → base64Decode 返回**空数组** → looksLikeImage 判否 →
 *  APIC 静默丢失（这首歌标题/歌词都在、就是没封面），而 FLAC 的 1MB/16MB 前缀阶梯
 *  更是必然多片，等于 FLAC 内嵌从来不可能成功。 */
function readFileBytes(path: string, maxLen: number): Uint8Array | null {
	try {
		const file = new File(path);
		if (!file.exists()) return null;
		const input = new FileInputStream(path);
		try {
			const CHUNK = 65536;
			const bufSize = maxLen < CHUNK ? maxLen : CHUNK;
			const buffer = new ByteArray(bufSize.toInt());
			const parts: Array<Uint8Array> = [];
			let total = 0;
			for (;;) {
				const n = input.read(buffer);
				if (n <= 0) break;
				// 尾块截成精确长度再编码，避免把旧缓冲内容混进去
				const encoded = n == bufSize
					? Base64.encodeToString(buffer, Base64.NO_WRAP)
					: Base64.encodeToString(Arrays.copyOfRange(buffer, 0, n), Base64.NO_WRAP);
				const piece = base64Decode(encoded);
				if (piece.length == 0) {
					console.log("[AppNative] readFileBytes 分片解码失败 path=" + path + " offset=" + total + " n=" + n);
					return null;
				}
				parts.push(piece);
				total += piece.length;
				if (total >= maxLen) break;
			}
			if (total == 0) return null;
			const out = new Uint8Array(total);
			let p = 0;
			for (let i = 0; i < parts.length; i++) {
				const part = parts[i];
				for (let j = 0; j < part.length; j++) {
					out[p] = part[j];
					p++;
				}
			}
			return out;
		} finally {
			input.close();
		}
	} catch (e) {
		console.log("[AppNative] readFileBytes 失败: " + (e != null ? e.toString() : "unknown"));
		return null;
	}
}

/** Uint8Array → FileOutputStream（同样走 Base64 桥） */
function writeBytes(output: FileOutputStream, bytes: Uint8Array): void {
	output.write(Base64.decode(base64Encode(bytes), Base64.NO_WRAP));
}

/** 从源文件 [from, to) 区间按流拷贝到 output（java→java，不经 UTS 元素层） */
function copyRange(output: FileOutputStream, srcPath: string, from: number, to: number): boolean {
	const input = new FileInputStream(srcPath);
	try {
		let skipped = 0;
		while (skipped < from) {
			const n = input.skip((from - skipped).toLong()).toInt();
			if (n <= 0) return false;
			skipped += n;
		}
		const buffer = new ByteArray(262144);
		let left = to - from;
		while (left > 0) {
			const want = left < 262144 ? left : 262144;
			const n = input.read(buffer, 0, want.toInt());
			if (n <= 0) return false;
			output.write(buffer, 0, n);
			left -= n;
		}
		return true;
	} finally {
		input.close();
	}
}

/** 魔数校验：只认 JPEG/PNG（防把 HTML 错误页/占位图嵌进音频） */
function looksLikeImage(bytes: Uint8Array): boolean {
	if (bytes.length < 4) return false;
	const b0 = bytes[0] & 0xff;
	const b1 = bytes[1] & 0xff;
	if (b0 == 0xff && b1 == 0xd8) return true; // JPEG
	if (b0 == 0x89 && b1 == 0x50) return true; // PNG
	return false;
}

/** mp3 旧标签可能叠了多重 ID3 / 大 APIC：64B → 1MB → 16MB 前缀阶梯重试 */
function planMp3WithPrefixLadder(src: string, data: EmbedTagsData): Mp3Plan | null {
	const prefix64 = readFileBytes(src, 64);
	if (prefix64 != null) {
		const plan = planMp3(prefix64, data);
		if (plan != null) return plan;
	}
	const prefix1m = readFileBytes(src, 1024 * 1024);
	if (prefix1m != null) {
		const plan = planMp3(prefix1m, data);
		if (plan != null) return plan;
	}
	const prefix16m = readFileBytes(src, 16 * 1024 * 1024);
	if (prefix16m != null) {
		const plan = planMp3(prefix16m, data);
		if (plan != null) return plan;
	}
	return null;
}

/** flac 元数据区可能含大 PADDING/旧封面：1MB → 16MB 前缀阶梯；保留成功前缀供块头复用 */
type FlacPlanWithPrefix = {
	plan: FlacPlan;
	prefix: Uint8Array;
};

function planFlacWithPrefixLadder(src: string, data: EmbedTagsData): FlacPlanWithPrefix | null {
	const prefix1m = readFileBytes(src, 1024 * 1024);
	if (prefix1m != null) {
		const plan = planFlac(prefix1m, data);
		if (plan != null) {
			const r: FlacPlanWithPrefix = { plan: plan, prefix: prefix1m };
			return r;
		}
	}
	const prefix16m = readFileBytes(src, 16 * 1024 * 1024);
	if (prefix16m != null) {
		const plan = planFlac(prefix16m, data);
		if (plan != null) {
			const r: FlacPlanWithPrefix = { plan: plan, prefix: prefix16m };
			return r;
		}
	}
	return null;
}

/**
 * 内嵌标签（见 interface.uts 的 EmbedAudioTags 契约）。
 * 失败/不支持 resolve 原绝对路径；成功 resolve .embed.<ext> 副本路径。
 */
export const embedAudioTags: EmbedAudioTags = function (audioTempPath: string, opts: EmbedTagsOptions): Promise<string> {
	return new Promise<string>((resolve: (value: string) => void) => {
		resolve(embedAudioTagsSync(audioTempPath, opts));
	});
};

/**
 * uni 文件 URI → 真实绝对路径。
 *
 * 为什么必须有这一步：`uni.env.USER_DATA_PATH` 在 Android 上是 `unifile://usr`，
 * 下载停靠点（.part）与内嵌时的封面临时文件都挂在那里；而 `java.io.File` 不认这个
 * scheme，`new File("unifile://usr//qt-download-parts/x.part").exists()` 恒为 false，
 * 内嵌于是**静默**退回同目录文件（2026-10-25 MuMu 实测：日志里只有一句
 * 「内嵌未生效（格式不支持或失败），走原件」，原生侧一个字都没打）。
 *
 * 规则与 saveToPublicMedia 对齐：先剥 file://，能直接 stat 到就用；否则交
 * UTSAndroid.convert2AbsFullPath；再兜底按 uni 私有目录约定把 `unifile://usr`
 * 映射到应用 filesDir（= qt-app-native dataDir() 返回的同一目录）。
 */
function resolveRealPath(path: string): string {
	let p = path;
	if (p.indexOf("file://") == 0) p = p.substring(7);
	if (p.length > 0 && new File(p).exists()) return p;
	const converted = UTSAndroid.convert2AbsFullPath(path);
	if (converted.length > 0 && new File(converted).exists()) return converted;
	if (p.indexOf("unifile://usr") == 0) {
		const ctx = UTSAndroid.getAppContext();
		if (ctx != null) {
			const dir = ctx.filesDir;
			if (dir != null) {
				let rest = p.substring(13);
				while (rest.indexOf("/") == 0) rest = rest.substring(1);
				return dir.getAbsolutePath() + "/" + rest;
			}
		}
	}
	if (converted.length > 0) return converted;
	return p;
}

function embedAudioTagsSync(audioTempPath: string, opts: EmbedTagsOptions): string {
	const ext = opts.ext;
	if (audioTempPath.length == 0 || (ext != "mp3" && ext != "flac")) return audioTempPath;
	let copyPath = "";
	let copyReal = "";
	try {
		const realSrc = resolveRealPath(audioTempPath);
		const file = new File(realSrc);
		if (!file.exists()) {
			console.log("[AppNative] embed 源文件不存在 src=" + audioTempPath + " real=" + realSrc);
			return audioTempPath;
		}
		const totalLen = file.length().toInt();
		if (totalLen < 128) return audioTempPath;
		// 封面字节（带魔数校验，失败按无封面处理）
		let coverBytes: Uint8Array | null = null;
		if (opts.coverTempPath.length > 0) {
			const raw = readFileBytes(resolveRealPath(opts.coverTempPath), 4 * 1024 * 1024);
			if (raw != null && looksLikeImage(raw)) coverBytes = raw;
		}
		const data: EmbedTagsData = {
			title: opts.title,
			artist: opts.artist,
			album: opts.album,
			lrcText: opts.lrcText,
			coverBytes: coverBytes,
			coverMime: opts.coverMime,
		};
		if (ext == "mp3") {
			const plan = planMp3WithPrefixLadder(realSrc, data);
			if (plan == null) {
				console.log("[AppNative] embed mp3 计划失败 src=" + realSrc + " len=" + totalLen);
				return audioTempPath;
			}
			copyPath = audioTempPath + ".embed." + ext;
			copyReal = realSrc + ".embed." + ext;
			const output = new FileOutputStream(copyReal);
			try {
				writeBytes(output, plan.newTag);
				if (!copyRange(output, realSrc, plan.oldTagSize, totalLen)) {
					output.close();
					new File(copyReal).delete();
					return audioTempPath;
				}
			} finally {
				output.close();
			}
			return copyPath;
		}
		const flac = planFlacWithPrefixLadder(realSrc, data);
		if (flac == null) {
			console.log("[AppNative] embed flac 计划失败 src=" + realSrc + " len=" + totalLen);
			return audioTempPath;
		}
		copyPath = audioTempPath + ".embed." + ext;
		copyReal = realSrc + ".embed." + ext;
		const output = new FileOutputStream(copyReal);
		try {
			// fLaC 魔数
			const magic = new Uint8Array(4);
			magic[0] = 0x66;
			magic[1] = 0x4c;
			magic[2] = 0x61;
			magic[3] = 0x43;
			writeBytes(output, magic);
			writeBytes(output, flac.plan.streamInfo);
			// 保留块：块头 4B 从前缀取（last 位清零——它不再是最后一块），数据区从源文件搬运
			const spans = flac.plan.keptSpans;
			for (let i = 0; i < spans.length; i++) {
				const head = new Uint8Array(4);
				const off = spans[i].headerOffset;
				head[0] = flac.prefix[off] & 0x7f;
				head[1] = flac.prefix[off + 1];
				head[2] = flac.prefix[off + 2];
				head[3] = flac.prefix[off + 3];
				writeBytes(output, head);
				if (!copyRange(output, realSrc, off + 4, off + 4 + spans[i].dataLen)) {
					output.close();
					new File(copyReal).delete();
					return audioTempPath;
				}
			}
			writeBytes(output, flac.plan.vorbisComment);
			const pic = flac.plan.picture;
			if (pic != null) writeBytes(output, pic);
			if (!copyRange(output, realSrc, flac.plan.audioOffset, totalLen)) {
				output.close();
				new File(copyReal).delete();
				return audioTempPath;
			}
		} finally {
			output.close();
		}
		return copyPath;
	} catch (e) {
		console.log("[AppNative] embedAudioTags 失败: " + (e != null ? e.toString() : "unknown"));
		if (copyReal.length > 0) {
			try {
				new File(copyReal).delete();
			} catch (e2) {
				// 静默：清理残留副本失败只占一个临时文件位
			}
		}
		return audioTempPath;
	}
}

// ---------------------------------------------------------------------------
// 内嵌标签「读取侧」（与上方写入侧对偶；解析逻辑在 ../read-embed.uts 纯字节层）
// ---------------------------------------------------------------------------

/** 上一次写出的封面缓存文件绝对路径：重复读取先删它，避免 cache 目录堆积 */
let lastCoverCachePath = "";

/** 封面缓存自增序号：与 Date.now() 一起构成唯一文件名，防同毫秒覆盖 */
let coverCacheSeq = 0;

/** 封面字节 → cache 目录缓存文件，返回绝对路径（失败返回空串，调用方按无封面走） */
function writeCoverCache(bytes: Uint8Array, mime: string): string {
	try {
		if (lastCoverCachePath.length > 0) {
			try {
				new File(lastCoverCachePath).delete();
			} catch (e1) {
				// 静默：旧封面缓存删除失败不阻塞新缓存写出
			}
			lastCoverCachePath = "";
		}
		const ctx = UTSAndroid.getAppContext();
		if (ctx == null) return "";
		const cacheDir = ctx.getCacheDir();
		if (cacheDir == null) return "";
		const ext = mime.indexOf("png") >= 0 ? "png" : "jpg";
		coverCacheSeq++;
		const path = cacheDir.getAbsolutePath() + "/qt-embed-cover-" + Date.now() + "-" + coverCacheSeq + "." + ext;
		const output = new FileOutputStream(path);
		try {
			writeBytes(output, bytes);
		} finally {
			output.close();
		}
		lastCoverCachePath = path;
		return path;
	} catch (e) {
		console.log("[AppNative] writeCoverCache 失败: " + (e != null ? e.toString() : "unknown"));
		return "";
	}
}

/**
 * content:// URI → 前 maxLen 字节。MediaStore 扫出来的本地歌曲只有 content:// URI
 * （Android 10+ 分区存储没有直接文件路径），读内嵌标签必须走 ContentResolver 流。
 * 分片读法与 readFileBytes 同构（ByteArray → Base64 桥 → Uint8Array），失败返回 null。
 */
function readPrefixFromContent(uriText: string, maxLen: number): Uint8Array | null {
	try {
		const ctx = UTSAndroid.getAppContext();
		if (ctx == null) return null;
		const resolver = ctx.getContentResolver();
		if (resolver == null) return null;
		const input: InputStream | null = resolver.openInputStream(Uri.parse(uriText));
		if (input == null) return null;
		try {
			const CHUNK = 65536;
			const bufSize = maxLen < CHUNK ? maxLen : CHUNK;
			const buffer = new ByteArray(bufSize.toInt());
			const parts: Array<Uint8Array> = [];
			let total = 0;
			for (;;) {
				const n = input.read(buffer);
				if (n <= 0) break;
				const encoded = n == bufSize
					? Base64.encodeToString(buffer, Base64.NO_WRAP)
					: Base64.encodeToString(Arrays.copyOfRange(buffer, 0, n), Base64.NO_WRAP);
				const piece = base64Decode(encoded);
				if (piece.length == 0) {
					console.log("[AppNative] readPrefixFromContent 分片解码失败 uri=" + uriText + " offset=" + total + " n=" + n);
					return null;
				}
				parts.push(piece);
				total += piece.length;
				if (total >= maxLen) break;
			}
			if (total == 0) return null;
			const out = new Uint8Array(total);
			let p = 0;
			for (let i = 0; i < parts.length; i++) {
				const part = parts[i];
				for (let j = 0; j < part.length; j++) {
					out[p] = part[j];
					p++;
				}
			}
			return out;
		} finally {
			input.close();
		}
	} catch (e) {
		console.log("[AppNative] readPrefixFromContent 失败: " + (e != null ? e.toString() : "unknown"));
		return null;
	}
}

function readEmbeddedTagsSync(filePath: string): EmbeddedReadResult | null {
	if (filePath.length == 0) return null;
	try {
		// 封面与歌词固定写在文件头的标签区（写入侧 planMp3/planFlac 的产物），
		// 1MiB 前缀必然覆盖（大 APIC 场景由字节层「截断降级」处理：歌词照出、封面置空）
		let prefix: Uint8Array | null = null;
		if (filePath.indexOf("content://") == 0) {
			prefix = readPrefixFromContent(filePath, 1024 * 1024);
		} else {
			const realPath = resolveRealPath(filePath);
			const file = new File(realPath);
			if (!file.exists()) return null;
			if (file.length().toInt() < 32) return null;
			prefix = readFileBytes(realPath, 1024 * 1024);
		}
		if (prefix == null) return null;
		let read: EmbeddedRead | null = readMp3Embedded(prefix);
		if (read == null) read = readFlacEmbedded(prefix);
		if (read == null) return null;
		let coverPath = "";
		const cover = read.coverBytes;
		if (cover != null) {
			coverPath = writeCoverCache(cover, read.coverMime);
		}
		const result: EmbeddedReadResult = { coverPath: coverPath, lrcText: read.lrcText };
		return result;
	} catch (e) {
		console.log("[AppNative] readEmbeddedTags 失败: " + (e != null ? e.toString() : "unknown"));
		return null;
	}
}

/**
 * 读取本地音频文件头部的内嵌标签（契约见 interface.uts 的 ReadEmbeddedTags）。
 * mp3 → ID3v2 封面+歌词；flac → PICTURE+VORBIS_COMMENT；其余格式/无标签 → null。
 */
export const readEmbeddedTags: ReadEmbeddedTags = function (filePath: string): EmbeddedReadResult | null {
	return readEmbeddedTagsSync(filePath);
};

// ==================== WebView Cookie 读取（网页登录 v17） ====================

/** 主线程 Handler（CookieManager.getInstance() 需要有 Looper 的线程） */
let gWebCookieHandler: Handler | null = null;
function webCookieHandler(): Handler {
	const h = gWebCookieHandler;
	if (h != null) return h;
	const created = new Handler(Looper.getMainLooper());
	gWebCookieHandler = created;
	return created;
}

/** 把「逐 URL 读 Cookie 后回值」做成 Runnable（qt-js-engine webview.uts 的 V8MainTask 同款） */
class WebCookieTask implements Runnable {
	private urls: string[];
	private resolve: (value: string[]) => void;

	constructor(urls: string[], resolve: (value: string[]) => void) {
		this.urls = urls;
		this.resolve = resolve;
	}

	override run(): void {
		const out: string[] = [];
		try {
			const cm = CookieManager.getInstance();
			for (let i = 0; i < this.urls.length; i++) {
				const c = cm.getCookie(this.urls[i]);
				if (c != null && c.length > 0) out.push(c);
			}
		} catch (e) {
			// CookieManager 初始化失败：按「本轮没读到」处理，调用方下一轮轮询再试
			console.log("[AppNative] getWebCookies 失败: " + (e != null ? e.toString() : "unknown"));
		}
		this.resolve(out);
	}
}

/**
 * 读取系统 WebView Cookie 库中一批 URL 的 Cookie（契约见 interface.uts 的 GetWebCookies）。
 * 统一 post 到主线程执行：CookieManager.getInstance() 首次初始化在无 Looper 的线程
 * 会抛「Can't create handler inside thread that has not called Looper.prepare()」，
 * 而 UTS 插件函数跑在 JS 逻辑线程，不能假设它有 Looper。
 */
export const getWebCookies: GetWebCookies = function (urls: string[]): Promise<string[]> {
	return new Promise<string[]>((resolve: (value: string[]) => void, _reject: (err: any) => void) => {
		webCookieHandler().post(new WebCookieTask(urls, resolve));
	});
};
