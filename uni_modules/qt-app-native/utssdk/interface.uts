/**
 * qt-app-native 插件接口定义
 *
 * Vapor 模式下 services/*.uts 属于 JS 逻辑层，运行时没有 UTSAndroid / android 全局对象，
 * 只有 uni_modules UTS 插件会编译进原生层，才能访问 Android 原生 API。
 * 因此打开系统浏览器、退出应用、安装 APK 等原生能力都收敛在本插件。
 */

/**
 * 打开系统浏览器（Android 隐式 Intent / iOS UIApplication）
 * @param url 外部链接，必须 http/https 开头
 * @returns 成功拉起浏览器返回 true；失败返回 false（由调用方降级处理）
 */
export type OpenExternalUrl = (url: string) => boolean;

/**
 * 退出应用
 * @returns Android 成功关闭 Activity 返回 true；不可用时返回 false（调用方降级为提示）
 */
export type ExitAppNative = () => boolean;

/**
 * 安装 APK（Android，经 FileProvider 兼容 Android 7+）
 * @param filePath APK 本地文件绝对路径
 * @returns 成功拉起安装页返回 true；失败返回 false（调用方降级为提示保存路径）
 */
export type InstallApkNative = (filePath: string) => boolean;

/**
 * 将临时文件写入公共媒体目录（Android MediaStore；iOS 不支持返回空）
 * @param tempPath 临时文件路径（uni.downloadFile 结果）
 * @param dirType 目录类型：download=Download 根目录 / music=Music 根目录
 * @param fileName 完整文件名，必须带真实扩展名（如 "周杰伦 - 晴天.flac" 或 "轻听_v3.1.0.apk"）
 * @param subDir 公共根目录下的子目录（可含层级），不传时默认 "轻听"
 * @param absDir 用户自定义的绝对目录（来自 pickDirectory）。非空时**忽略** dirType/subDir，
 *   直接写入该目录；Android 需要「所有文件访问」权限，否则写入失败 resolve 空字符串。
 *   鸿蒙 / iOS 没有自定义目录能力，该参数被忽略。
 * @returns 成功 resolve 真实文件路径（或 content:// URI）；失败 resolve 空字符串
 */
export type SaveToPublicMedia = (tempPath: string, dirType: string, fileName: string, subDir?: string, absDir?: string) => Promise<string>;

/**
 * 确保具备写公共目录的权限。
 * Android 10+（API 29+）走 MediaStore 无需任何权限，直接 resolve true；
 * Android 9-（API 28-）需要 WRITE_EXTERNAL_STORAGE：已授权 resolve true，未授权时拉起系统权限弹窗并 resolve false。
 * 鸿蒙需要 READ_WRITE_DOWNLOAD_DIRECTORY：未授权时拉起系统权限弹窗，用户同意后 resolve true。
 * iOS 不支持公共目录，恒 resolve false。
 * @returns 是否已具备写入能力
 */
export type EnsurePublicDirPermission = () => Promise<boolean>;

/**
 * 打开本应用的系统通知设置页。
 * Android 8+（API 26+）走 Settings.ACTION_APP_NOTIFICATION_SETTINGS 直达通知页；
 * 更低版本降级到应用详情页（Settings.ACTION_APPLICATION_DETAILS_SETTINGS）。
 * iOS 不支持（无对应公开 API），恒返回 false。
 * @returns 成功拉起设置页返回 true；失败返回 false（调用方降级为提示）
 */
export type OpenNotificationSettings = () => boolean;

/**
 * 是否已加入系统「电池优化」白名单（即被系统判定为「不优化」，允许后台自由运行）。
 *
 * Android：API 23+ 查 PowerManager.isIgnoringBatteryOptimizations；API 22- 没有电池优化
 * 机制，视为已放行；系统服务取不到时**保守返回 true**（宁可少提示，也不要误报未授权）。
 * iOS / H5：无此概念，恒返回 true（调用方据此不展示引导）。
 * @returns 是否已放行后台运行
 */
export type IsIgnoringBatteryOptimizations = () => boolean;

/**
 * 打开系统「电池优化」设置页，让用户手动把本应用改成「不优化」。
 *
 * Android：API 23+ 走 Settings.ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS（列表页，
 * 无需任何权限；不用 ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 的直达弹窗，
 * 那个 action 需要在清单里声明 REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 权限，
 * 且被 Google Play 政策限制，本插件不带清单文件）；失败降级到应用详情页。
 * iOS / H5：不支持，返回 false。
 * @returns 是否成功拉起设置页
 */
export type OpenBatteryOptimizationSettings = () => boolean;

/**
 * 打开厂商「自启动 / 后台运行管理」设置页。
 *
 * 自启动开关是国产 ROM 的私有能力，没有 AOSP 通用入口：这里按 Build.MANUFACTURER/BRAND
 * 逐个尝试小米/华为(荣耀)/OPPO(vivo 系)/vivo/魅族/三星/华硕/乐视/诺基亚的私有 Activity，
 * 全部失败时降级到应用详情页（至少能进「权限」）。iOS / H5：返回 false。
 * @returns 是否成功拉起某个设置页
 */
export type OpenAutoStartSettings = () => boolean;

/**
 * 打开本应用的系统详情设置页（所有 ROM 都有的通用兜底入口，用户可从这里进权限/电池）。
 * iOS / H5：返回 false。
 * @returns 是否成功拉起设置页
 */
export type OpenAppDetailsSettings = () => boolean;

/**
 * 本地扫描到的单曲（Android MediaStore 音频库）。
 * uri 为 content:// 媒体地址，可直接交给播放器（ExoPlayer/InnerAudio 均原生支持）。
 */
export type LocalAudioItem = {
	id: string;
	title: string;
	singer: string;
	album: string;
	/** 秒 */
	duration: number;
	uri: string;
	/** 文件绝对路径（用于按目录分组） */
	path: string;
	/** 文件大小（字节）；旧版本缓存的数据可能没有该字段，判定时按未知处理 */
	size?: number;
	/** 修改时间（秒，Android DATE_MODIFIED）；旧版本缓存的数据可能没有该字段，排序时按未知处理 */
	mtime?: number;
	/**
	 * 媒体库的 is_music 标记：1=音乐，0=非音乐，-1=媒体库没有该列或为 NULL（未知）。
	 *
	 * 注意它**不能**用来判断「是不是系统音」：Android 的 is_music 是目录启发式的产物，
	 * 落在 Ringtones/ 下的完整歌曲同样是 0，而应用按钮音效常常是 1。默认过滤按路径做，
	 * 该字段仅作诊断/展示用途。旧版本缓存的数据没有该字段，读取时按 -1 处理。
	 */
	isMusic?: number;
};

/**
 * 扫描本地音频。内部先检查/申请读取音频权限（Android 13+ READ_MEDIA_AUDIO，低版本 READ_EXTERNAL_STORAGE），
 * 授权后扫描并回调结果；拒绝授权回调空数组。结果按加入时间倒序。
 */
export type ScanLocalAudio = (onResult: (items: LocalAudioItem[]) => void) => void;

export type DeleteLocalMediaResult = {
	/** 直接删除成功（MediaStore 条目删掉，或 File.delete 删掉磁盘文件）的数量 */
	deleted: number;
	/** 已发起系统「删除确认」对话框、待用户同意后由系统删除的数量（结果异步） */
	pending: number;
	/** 删除失败、未发起任何删除操作的数量 */
	failed: number;
};

/**
 * 删除若干本地文件（同时删 MediaStore 记录）。统一入口，单曲也可传一个元素的数组。
 *
 * Android：
 *  - 应用自有的音频先按 content URI 删 MediaStore 条目（会连磁盘文件一起删）；
 *  - 第三方公共媒体受分区存储限制，直接删会抛 RecoverableSecurityException：需要
 *    MANAGE_EXTERNAL_STORAGE「所有文件访问」权限后用 File.delete() 删；未授权时本
 *    函数会在一次运行里引导一次系统「所有文件访问」设置页，并把删不掉的条目计入
 *    pending（需用户去系统设置开启后重试）；
 *  - 再按绝对路径 File.delete() 兜底。
 * iOS：本地音频库恒为空，此入口实际不会命中，恒返回全部 failed。
 */
export type DeleteLocalMedia = (items: LocalAudioItem[]) => DeleteLocalMediaResult;

/**
 * 按文件绝对路径批量删除若干媒体文件（下载管理用：下载记录只持久化了路径，没有 LocalAudioItem）。
 * 统一入口，单个文件也可传一个元素的数组。
 *
 * Android：应用自有文件（本应用通过 MediaStore 写入的下载文件）按 DATA 列反查
 * Downloads/Audio 集合的 content URI 后 ContentResolver.delete 删条目（连磁盘文件一起删），
 * 再按 File.delete() 兜底；本应用写入的文件无分区存储限制，不会触发
 * RecoverableSecurityException，因此与 deleteLocalMedia 不同，**不引导**「所有文件访问」设置页。
 * 鸿蒙：直接 fileIo.unlinkSync 按路径删（公共下载目录需已持有 READ_WRITE_DOWNLOAD_DIRECTORY，
 * 下载时已申请；私有目录文件不受影响）。
 * iOS：不支持，恒返回全部 failed。
 */
export type DeleteMediaByPath = (paths: string[]) => DeleteLocalMediaResult;

/**
 * 强制窗口回归传统布局模式（decorFitsSystemWindows = true）。
 *
 * 针对 Samsung One UI（Android 15/16）手势导航下 edge-to-edge 全高窗口 +
 * 导航栏 inset 为 0 时，uni-app x 运行时首屏挂载竞态（S24 Ultra 全屏白屏，
 * 见 services/boot-guard.ts 与统计上报）。等价于三键导航下的窗口行为。
 * 需在 App 启动最早点调用（Activity 已就绪）；iOS 无此概念，恒返回 false。
 * @returns 应用成功返回 true；Activity/Window 不可用或平台不支持返回 false
 */
export type ApplyLegacyInsets = () => boolean;

/**
 * 重建当前 Activity（recreate）。
 *
 * 首屏守卫的最后手段：reLaunch 只重建页面、不重建窗口，窗口级竞态（如 S24 Ultra
 * 手势导航白屏）必须重建 Activity 才能恢复。重建后 App onLaunch 不再触发、
 * 页面栈清空回到首页。iOS 无等价 API，恒返回 false。
 * @returns 已触发重建返回 true；Activity 不可用或平台不支持返回 false
 */
export type RecreateActivity = () => boolean;

/** 系统文件选择器的结果 */
export type PickFileResult = {
	/** 选中并成功读回内容 */
	ok: boolean;
	/** 文件的显示名（查不到时为空） */
	name: string;
	/** 文件全文（UTF-8 文本；读取失败为空） */
	content: string;
	/** 失败/取消原因（用户取消时 ok=false） */
	message: string;
};

/**
 * 打开系统文件选择器选一个 .js 文件并读回全文。
 * Android 走 ACTION_OPEN_DOCUMENT + contentResolver，只列出 JavaScript MIME，
 * 并在读取前校验 .js 后缀（不区分大小写）；内容由调用方继续校验。
 * iOS 恒回调 ok=false（本项目以 Android 为主）。
 */
export type PickJsFile = (onResult: (result: PickFileResult) => void) => void;

/** 系统目录选择器的结果 */
export type PickDirectoryResult = {
	/** 选中并拿到可写目录 */
	ok: boolean;
	/** 选中目录的绝对路径（Android 由 document URI 反解而来；拿不到真实路径时为空） */
	path: string;
	/** 目录显示名（用于界面展示，拿不到时为空） */
	name: string;
	/** 失败/取消原因（用户取消时 ok=false） */
	message: string;
};

/**
 * 打开系统文件管理器选一个目录，供下载落盘使用。
 *
 * Android 走 ACTION_OPEN_DOCUMENT_TREE，把返回的 document URI 通过
 * DocumentsContract.getTreeDocumentId 反解成真实绝对路径（primary:Download/QtMusic
 * → /storage/emulated/0/Download/QtMusic）。反解出真实路径（而不是长期持有 URI）是
 * 有意为之：写文件走 java.io.File 直写，不需要 takePersistableUriPermission，
 * 也就不受「重启后授权失效」影响 —— 代价是必须先拿到「所有文件访问」
 * （MANAGE_EXTERNAL_STORAGE），由调用方在选目录前先引导授权。
 *
 * 鸿蒙走 DocumentViewPicker（selectMode=FOLDER）+ fileShare.persistPermission 持久化
 * 目录授权，回传的是**目录 URI**（不是普通路径）。这是 phone 上唯一能写到公共目录的
 * 路线：`ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY` 是 2in1 专属权限，在 phone 上
 * 系统判 INVALID（hilog：`... not support.` / `result: [2]`），所以系统 Download 目录
 * 在手机上根本写不进去，必须由用户显式选目录并持久化授权。
 * iOS 无公共目录落盘路径，恒回调 ok=false。调用方据此保持固定目录。
 */
export type PickDirectory = (onResult: (result: PickDirectoryResult) => void) => void;

/**
 * 把已保存的自定义目录 URI 喂回原生层（鸿蒙专用）。
 *
 * 为什么需要：原生变量不跨进程，而 `persistPermission` 授予的 URI 授权每次启动都要
 * `activatePermission` 激活一次。JS 侧把 URI 存在 uni storage（qt-download-dir），
 * 启动/进下载页时调这里恢复；空串表示恢复默认目录。
 * 其它平台空实现（Android 存的是真实路径，不经过原生变量）。
 */
export type SetCustomDirUri = (uri: string) => void;

/**
 * 单条权限的当前授权状态（设置页「权限管理」用）。
 *
 * Android 的权限分三类，查询方式完全不同（见 app-android/index.uts 的
 * queryPermissionStates）：普通权限安装即授予、运行时权限走
 * checkSystemPermissionGranted、特殊权限（所有文件访问 / 悬浮窗 / 安装未知
 * 应用）系统不按运行时权限处理，只能走各自 API。iOS 恒 unknown=true。
 */
export type PermissionState = {
	/** 权限标识，与 manifest.json 里声明的串一致（android.permission.XXX） */
	id: string;
	/** 当前系统版本上该权限是否适用（如 WRITE_EXTERNAL_STORAGE 在 Android 9+ 已不再申请） */
	applicable: boolean;
	/** 是否已授权；applicable 为 false 时无意义 */
	granted: boolean;
	/** 查询异常 / 平台不支持时为 true，页面应显示「无法确定」而不是「未授权」 */
	unknown: boolean;
};

/**
 * 查询一批权限的当前授权状态。id 必须与 manifest 声明一致；未识别的 id
 * 返回 unknown=true 而不是抛错（页面不该因为多列一条权限就整页崩）。
 */
export type QueryPermissionStates = (ids: string[]) => PermissionState[];

/**
 * 跳到某条权限对应的系统设置页（能直达就直达，ROM 不认则退回应用详情页）。
 * @returns 已成功发起跳转返回 true；平台不支持或 Activity 不可用返回 false
 */
export type OpenPermissionSettings = (id: string) => boolean;

/** 内嵌标签的写入内容（JS 侧准备好；封面走临时文件路径，避免跨层传大数组） */
export type EmbedTagsOptions = {
	/** 音频扩展名（小写、不带点）。仅 "mp3" / "flac" 走内嵌，其余格式原样返回 */
	ext: string;
	/** 标题；空串 = 不写 */
	title: string;
	/** 歌手；空串 = 不写 */
	artist: string;
	/** 专辑；空串 = 不写 */
	album: string;
	/** LRC 歌词原文（含时间轴）；空串 = 不嵌歌词 */
	lrcText: string;
	/** 封面临时文件路径（file:// 前缀或绝对路径均可）；空串 = 不嵌封面 */
	coverTempPath: string;
	/** 封面 MIME（image/jpeg / image/png；coverTempPath 为空串时忽略） */
	coverMime: string;
};

/**
 * 把标题/歌手/专辑/LRC 歌词/封面内嵌进音频文件的标签区（ID3v2.3 / VorbisComment+PICTURE）。
 *
 * 结果约定（与 saveToPublicMedia 的「失败 resolve 空串」不同，这里是**文件替换语义**）：
 *   - 成功：resolve **新文件**路径——同目录下 "<原名>.embed.<ext>" 副本，原文件不动；
 *     调用方拿到新路径后自行改名/入库/落盘，旧临时文件由调用方决定去留；
 *   - 失败 / 格式不在白名单 / 前缀嗅探不通过：resolve **原路径（去掉 file:// 前缀的绝对路径）**，
 *     调用方继续按无内嵌流程走（侧车兜底由 JS 侧决定）；
 *   - 失败残留的副本由本模块负责清理，不会留半截文件。
 *
 * 实现注意（为什么走 Base64 桥/纯字节层）：标签写入逻辑在 utssdk/embed-bytes.uts，
 * 是与平台无关的纯函数（可进 node 自测）；Android 端经 android.util.Base64 与
 * kotlin ByteArray 互转，避免 UTS 对 ByteArray 元素级写入的兼容风险；鸿蒙端直接
 * fileIo.readSync/writeSync(ArrayBuffer)。
 */
export type EmbedAudioTags = (audioTempPath: string, opts: EmbedTagsOptions) => Promise<string>;
