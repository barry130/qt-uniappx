/** iOS 原生文件、目录授权、标签与登录 WebView。复杂 Foundation/UIKit I/O 由 Swift 混编处理。 */

import { OpenExternalUrl, ExitAppNative, InstallApkNative, SaveToPublicMedia, EnsurePublicDirPermission, OpenNotificationSettings, IsIgnoringBatteryOptimizations, OpenBatteryOptimizationSettings, OpenAutoStartSettings, OpenAppDetailsSettings, LocalAudioItem, ScanLocalAudio, DeleteLocalMedia, DeleteMediaByPath, DeleteLocalMediaResult, ApplyLegacyInsets, RecreateActivity, ReadBottomNavInset, PickFileResult, PickJsFile, PickDirectoryResult, PickDirectory, SetCustomDirUri, PermissionState, QueryPermissionStates, OpenPermissionSettings, EmbedAudioTags, EmbedTagsOptions, EmbeddedReadResult, ReadEmbeddedTags, GetWebCookies, OpenAuthWebView, CloseAuthWebView, StatLocalFile } from "../interface.uts";
import { EmbedTagsData, planMp3, planFlac, base64Encode, base64Decode } from "../embed-bytes.uts";
import { readMp3Embedded, readFlacEmbedded } from "../read-embed.uts";

function parsedObject(json: string): UTSJSONObject | null {
  try { return JSON.parseObject(json); }
  catch (e) { console.log("[AppNative] iOS 返回数据无法解析"); return null; }
}

function readBytes(path: string, limit: number): Uint8Array | null {
  const encoded = QtAppNativeIOS.readPrefix(path, limit);
  return encoded.length > 0 ? base64Decode(encoded) : null;
}

function permissionResults(json: string): PermissionState[] {
  try { return JSON.parse<PermissionState[]>(json) ?? []; }
  catch (e) { console.log("[AppNative] iOS 权限数据无法解析"); return []; }
}

export const openExternalUrl: OpenExternalUrl = (url: string): boolean => {
  return QtAppNativeIOS.openExternalURL(url);
};

export const exitAppNative: ExitAppNative = (): boolean => {
  return false;
};

/** iOS 无主动退到后台的公开 API，设置入口由服务的平台能力判定隐藏。 */
export async function moveAppToBackgroundNative(): Promise<boolean> {
  return false;
}

export const installApkNative: InstallApkNative = (filePath: string): boolean => {
  return false;
};

export const saveToPublicMedia: SaveToPublicMedia = function (
  tempPath: string,
  dirType: string,
  fileName: string,
  subDir?: string,
  absDir?: string
): Promise<string> {
  return new Promise<string>((resolve: (value: string) => void, _reject: (err: any) => void) => {
    if (dirType == "picture") QtAppNativeIOS.savePhoto(tempPath, resolve);
    else QtAppNativeIOS.saveFile(tempPath, dirType, fileName, subDir ?? "", absDir ?? "", resolve);
  });
};

export const ensurePublicDirPermission: EnsurePublicDirPermission = function (): Promise<boolean> {
  return Promise.resolve(QtAppNativeIOS.canWriteDownloads());
};

export const openNotificationSettings: OpenNotificationSettings = function (): boolean {
  return QtAppNativeIOS.openSettings();
};

// iOS 没有 Android 那套 Doze/电池优化白名单概念，恒视为已放行（true），
// 这样调用方在 iOS 上不会弹「后台可能被限制」的引导。
export const isIgnoringBatteryOptimizations: IsIgnoringBatteryOptimizations = function (): boolean {
	return true;
};

// iOS 无对应系统设置页（电池/自启动管理由系统按后台刷新策略自行决定），恒返回 false 由调用方降级。
export const openBatteryOptimizationSettings: OpenBatteryOptimizationSettings = function (): boolean {
	return false;
};

export const openAutoStartSettings: OpenAutoStartSettings = function (): boolean {
	return false;
};

export const openAppDetailsSettings: OpenAppDetailsSettings = function (): boolean {
	return QtAppNativeIOS.openSettings();
};

export const scanLocalAudio: ScanLocalAudio = function (onResult: (items: LocalAudioItem[]) => void): void {
  QtAppNativeIOS.scanAudio((json: string): void => {
    try { onResult(JSON.parse<LocalAudioItem[]>(json) ?? []); }
    catch (e) { console.log("[AppNative] iOS 扫描数据无法解析"); onResult([]); }
  });
};

/** 导入用户在「文件」应用选择的音频，复制到应用 Documents/Imports 后才报告成功。 */
export function importLocalAudio(onResult: (count: number, message: string) => void): void {
  QtAppNativeIOS.pickDocument("audio", (json: string): void => {
    const result = parsedObject(json);
    onResult(result?.getNumber("count") ?? 0, result?.getString("message") ?? "无法导入音频");
  });
}

// iOS 无 Android 系统 inset 概念（安全区由 safeAreaInsets 原生承担），恒返回 false。
export const applyLegacyInsets: ApplyLegacyInsets = function (): boolean {
	return false;
};

// iOS 无 Activity 重建等价 API，恒返回 false。
export const recreateActivity: RecreateActivity = function (): boolean {
	return false;
};

// iOS 底部安全区由 safeAreaInsets 原生承担（uni.getWindowInfo 即真值），恒回 0。
export const readBottomNavInset: ReadBottomNavInset = function (onResult: (px: number, navigationKeys: number) => void): void {
	onResult(0, -1);
};

export const deleteLocalMedia: DeleteLocalMedia = function (items: LocalAudioItem[]): DeleteLocalMediaResult {
  const paths: string[] = [];
  for (let i = 0; i < items.length; i++) paths.push(items[i].uri.length > 0 ? items[i].uri : items[i].path);
  return deleteMediaByPath(paths);
};

export const deleteMediaByPath: DeleteMediaByPath = function (paths: string[]): DeleteLocalMediaResult {
  const deleted = QtAppNativeIOS.deleteFiles(JSON.stringify(paths));
  return { deleted: deleted, pending: 0, failed: paths.length - deleted };
};

export const pickJsFile: PickJsFile = function (onResult: (result: PickFileResult) => void): void {
  QtAppNativeIOS.pickDocument("js", (json: string): void => {
    const result = parsedObject(json);
    onResult({ ok: result?.getBoolean("ok") ?? false, name: result?.getString("name") ?? "",
      content: result?.getString("content") ?? "", message: result?.getString("message") ?? "无法读取文件" } as PickFileResult);
  });
};

export const pickDirectory: PickDirectory = function (onResult: (result: PickDirectoryResult) => void): void {
  QtAppNativeIOS.pickDocument("folder", (json: string): void => {
    const result = parsedObject(json);
    onResult({ ok: result?.getBoolean("ok") ?? false, path: result?.getString("path") ?? "",
      name: result?.getString("name") ?? "", message: result?.getString("message") ?? "无法选择目录" } as PickDirectoryResult);
  });
};

export const setCustomDirUri: SetCustomDirUri = function (uri: string): void {
  QtAppNativeIOS.setCustomDirectory(uri);
};

export const queryPermissionStates: QueryPermissionStates = function (ids: string[]): PermissionState[] {
  return permissionResults(QtAppNativeIOS.queryPermissions(JSON.stringify(ids)));
};

/** 通知状态通过异步系统 API 查询，页面可用此接口刷新，避免阻塞主线程。 */
export function queryPermissionStatesAsync(ids: string[], callback: (states: PermissionState[]) => void): void {
  QtAppNativeIOS.refreshPermissions(JSON.stringify(ids), (json: string): void => { callback(permissionResults(json)); });
}

export const openPermissionSettings: OpenPermissionSettings = function (id: string): boolean {
  return id.indexOf("ios.") == 0 && QtAppNativeIOS.openSettings();
};

type TagPart = { data?: string; offset?: number; length?: number };

export const embedAudioTags: EmbedAudioTags = function (audioTempPath: string, opts: EmbedTagsOptions): Promise<string> {
  return new Promise<string>((resolve: (value: string) => void, _reject: (err: any) => void) => {
    let src = audioTempPath;
    try {
    const ext = opts.ext.toLowerCase();
    if (audioTempPath.indexOf("file://") == 0) src = decodeURIComponent(audioTempPath.substring(7));
    if (ext != "mp3" && ext != "flac") { resolve(src); return; }
    const size = statLocalFile(audioTempPath);
    if (size < 128) { resolve(src); return; }
    const coverSize = opts.coverTempPath.length > 0 ? statLocalFile(opts.coverTempPath) : -1;
    let cover = coverSize > 0 && coverSize <= 4 * 1024 * 1024 ? readBytes(opts.coverTempPath, 4 * 1024 * 1024) : null;
    if (cover != null && !(cover.length > 3 && ((cover[0] == 0xff && cover[1] == 0xd8) ||
        (cover[0] == 0x89 && cover[1] == 0x50 && cover[2] == 0x4e && cover[3] == 0x47)))) cover = null;
    const data: EmbedTagsData = { title: opts.title, artist: opts.artist, album: opts.album, lrcText: opts.lrcText,
      coverBytes: cover, coverMime: opts.coverMime };
    const windows = ext == "mp3" ? [64, 1024 * 1024, 16 * 1024 * 1024] : [1024 * 1024, 16 * 1024 * 1024];
    const parts: TagPart[] = [];
    for (let pass = 0; pass < windows.length; pass++) {
      const prefix = readBytes(audioTempPath, windows[pass]);
      if (prefix == null) continue;
      if (ext == "mp3") {
        const plan = planMp3(prefix, data);
        if (plan == null) continue;
        parts.push({ data: base64Encode(plan.newTag) } as TagPart);
        parts.push({ offset: plan.oldTagSize, length: size - plan.oldTagSize } as TagPart);
      } else {
        const plan = planFlac(prefix, data);
        if (plan == null) continue;
        parts.push({ data: "ZkxhQw==" } as TagPart);
        parts.push({ data: base64Encode(plan.streamInfo) } as TagPart);
        for (let i = 0; i < plan.keptSpans.length; i++) {
          const span = plan.keptSpans[i], at = span.headerOffset;
          const head = new Uint8Array(4);
          head[0] = prefix[at] & 0x7f; head[1] = prefix[at + 1]; head[2] = prefix[at + 2]; head[3] = prefix[at + 3];
          parts.push({ data: base64Encode(head) } as TagPart);
          parts.push({ offset: at + 4, length: span.dataLen } as TagPart);
        }
        parts.push({ data: base64Encode(plan.vorbisComment) } as TagPart);
        if (plan.picture != null) parts.push({ data: base64Encode(plan.picture!) } as TagPart);
        parts.push({ offset: plan.audioOffset, length: size - plan.audioOffset } as TagPart);
      }
      break;
    }
    if (parts.length == 0) { resolve(src); return; }
    QtAppNativeIOS.writeTagCopy(audioTempPath, ext, JSON.stringify(parts), resolve);
    } catch (e) {
      console.log("[AppNative] iOS 标签计划无法生成");
      resolve(src);
    }
  });
};

export const readEmbeddedTags: ReadEmbeddedTags = function (filePath: string): EmbeddedReadResult | null {
  try {
  let window = 1024 * 1024, lastSize = 0, count = 0, found = false;
  let cover: Uint8Array | null = null;
  let mime = "", lyric = "";
  for (let pass = 0; pass < 3; pass++) {
    const prefix = readBytes(filePath, window);
    if (prefix == null || prefix.length <= lastSize) break;
    count = prefix.length; lastSize = count;
    const mp3 = readMp3Embedded(prefix), flac = readFlacEmbedded(prefix);
    if (mp3 == null && flac == null) break;
    found = true;
    if (flac != null && flac.coverBytes != null) { cover = flac.coverBytes; mime = flac.coverMime; }
    else if (mp3 != null && mp3.coverBytes != null) { cover = mp3.coverBytes; mime = mp3.coverMime; }
    if (mp3 != null && mp3.lrcText.length > 0) lyric = mp3.lrcText;
    else if (flac != null && flac.lrcText.length > 0) lyric = flac.lrcText;
    const need = Math.max(mp3?.coverNeed ?? 0, flac?.coverNeed ?? 0);
    if (cover != null || need <= prefix.length || prefix.length >= 8 * 1024 * 1024) break;
    window = Math.min(need + 4096, 8 * 1024 * 1024);
  }
  if (!found) return null;
  return { coverPath: cover == null ? "" : QtAppNativeIOS.cacheCover(base64Encode(cover), mime),
    lrcText: lyric, readBytes: count, coverBytes: cover?.length ?? 0 } as EmbeddedReadResult;
  } catch (e) {
    console.log("[AppNative] iOS 内嵌标签无法读取");
    return null;
  }
};

export const getWebCookies: GetWebCookies = function (urls: string[]): Promise<string[]> {
  return new Promise<string[]>((resolve: (value: string[]) => void, _reject: (err: any) => void) => {
    QtAppNativeIOS.webCookies(JSON.stringify(urls), (json: string): void => {
      try { resolve(JSON.parse<string[]>(json) ?? []); }
      catch (e) { console.log("[AppNative] iOS Cookie 数据无法解析"); resolve([]); }
    });
  });
};

export const openAuthWebView: OpenAuthWebView = (url: string, onClose: (message: string) => void, ua: string): void => {
  QtAppNativeIOS.openAuthWebView(url, ua, onClose);
};

export const closeAuthWebView: CloseAuthWebView = (): void => {
  QtAppNativeIOS.closeAuthWebView();
};

export const statLocalFile: StatLocalFile = (filePath: string): number => {
  return QtAppNativeIOS.statFile(filePath);
};

export function stopDevicePresentation(): void { QtAppNativeIOS.stopPerformance(); }
export function startDevicePresentation(callback: (left: number, top: number, right: number, bottom: number, separating: boolean, tabletop: boolean) => void): void {
  callback(0, 0, 0, 0, false, false);
}
export function readDevicePerformance(callback: (lowMemory: boolean, powerSave: boolean, animationsDisabled: boolean) => void): void {
  QtAppNativeIOS.startPerformance(callback);
  QtAppNativeIOS.readPerformance(callback);
}
export function takeWidgetRoute(): string { return ""; }
