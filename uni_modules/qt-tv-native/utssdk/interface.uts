/** Android TV native seam. Application policy and spatial focus scoring remain in TypeScript. */
export type QtTvDevice = {
  television: boolean;
  leanback: boolean;
  uiModeType: number;
  nativeAvailable: boolean;
};

/** DOWN only; matching UP is consumed natively, never delivered as a second action. */
export type QtTvRemoteEvent = {
  key: string;
  code: number;
  action: string;
  repeat: number;
};

export type QtTvRemoteState = {
  enabled: boolean;
  captureBack: boolean;
  captureMenu: boolean;
  editing: boolean;
};

/** Coordinates use the same logical pixels as UniElement.getBoundingClientRect(). */
export type QtTvCandidate = {
  id: string;
  left: number;
  top: number;
  width: number;
  height: number;
  visible: boolean;
  enabled: boolean;
  input: boolean;
  longPress: boolean;
  /** Nearest scroll/list/swiper ancestor inside scope, or an empty string. */
  scrollGroup: string;
};

export type ReadTvDevice = () => QtTvDevice;
export type QtTvRemoteHandler = (event: QtTvRemoteEvent) => void;
export type StartTvRemote = (handler: QtTvRemoteHandler) => void;
export type SetTvRemoteState = (state: QtTvRemoteState) => void;
export type StopTvRemote = () => void;
export type CollectTvCandidates = (root: UniElement | null) => QtTvCandidate[];
export type HighlightTvElement = (id: string, color: string) => void;
export type ActivateTvElement = (id: string, longPress?: boolean) => void;
export type ScrollTvAncestor = (id: string, direction: string) => boolean;
export type SetTvPresentation = (enabled: boolean) => void;
/** Re-enter the existing Activity back policy after application sheets/handlers had first refusal. */
export type PerformTvBack = () => void;
