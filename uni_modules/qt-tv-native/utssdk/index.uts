// Neutral fallback for platforms without the Android TV native runtime.
import { QtTvDevice, QtTvRemoteHandler, QtTvRemoteState, QtTvCandidate } from "./interface.uts";
export { QtTvDevice, QtTvRemoteEvent, QtTvRemoteHandler, QtTvRemoteState, QtTvCandidate } from "./interface.uts";
export function readTvDevice(): QtTvDevice { return { television: false, leanback: false, uiModeType: 0, nativeAvailable: false }; }
export function startTvRemote(_handler: QtTvRemoteHandler): void {}
export function setTvRemoteState(_state: QtTvRemoteState): void {}
export function stopTvRemote(): void {}
export function collectTvCandidates(_root: UniElement | null): QtTvCandidate[] { return []; }
export function highlightTvElement(_id: string, _color: string): void {}
export function activateTvElement(_id: string, _longPress: boolean = false): void {}
export function scrollTvAncestor(_id: string, _direction: string): boolean { return false; }
export function setTvPresentation(_enabled: boolean): void {}
export function performTvBack(): void {}
