}
/** Scope rect intersected with the decor viewport; the cheap phase-2 prefilter bound. */
function scopeViewport(scope: UniElement): DOMRect | null {
  if (concealed(scope)) return null;
  const activity = scope.getAndroidActivity();
  if (activity == null) return null;
  const density = activity.getResources().getDisplayMetrics().density.toDouble();
  const decor = activity.getWindow().getDecorView();
  const scopeRect = scope.getBoundingClientRect();
  const left = Math.max(scopeRect.left, 0);
  const top = Math.max(scopeRect.top, 0);
  const right = Math.min(scopeRect.right, decor.getWidth().toDouble() / density);
  const bottom = Math.min(scopeRect.bottom, decor.getHeight().toDouble() / density);
  if (right <= left || bottom <= top) return null;
  return new DOMRect(left, top, right - left, bottom - top);
}
/** Logical viewport clipping, including explicit sheet roots and scroll ancestors. */
function clippedRect(element: UniElement, scope: UniElement): DOMRect | null {
  if (concealed(element)) return null;
  const base = scopeViewport(scope);
  if (base == null) return null;
  const rect = element.getBoundingClientRect();
  let left = Math.max(rect.left, base.left);
  let top = Math.max(rect.top, base.top);
  let right = Math.min(rect.right, base.right);
  let bottom = Math.min(rect.bottom, base.bottom);
  let parent = element.parentElement;
  let depth = 0;
  while (parent != null && parent != scope && depth < 96) {
    if (concealed(parent)) return null;
    if (scrollContainer(parent) || parent.style.getPropertyValue("overflow") == "hidden") {
      const bounds = parent.getBoundingClientRect();
      left = Math.max(left, bounds.left); top = Math.max(top, bounds.top);
      right = Math.min(right, bounds.right); bottom = Math.min(bottom, bounds.bottom);
    }
    parent = parent.parentElement; depth++;
  }
  if (right <= left || bottom <= top) return null;
  return new DOMRect(left, top, right - left, bottom - top);
}
function clearRing(): void {
  const observer = ringObserver;
  if (observer != null && observer.isAlive()) observer.removeOnPreDrawListener(ringPreDraw);
  const decor = ringDecor;
  const drawable = ringDrawable;
  if (decor != null && drawable != null) decor.getOverlay().remove(drawable);
  ringObserver = null; ringDecor = null; ringDrawable = null; highlightedId = "";
}
/** Calibrate DOM logical coordinates against a real ancestor, including status/window offsets. */
function ringOffset(scope: UniElement, decor: View, density: number): number[] {
  let anchor: UniElement | null = scope;
  let depth = 0;
  while (anchor != null && depth < 96) {
    const view = anchor.getAndroidView<View>();
    const rect = anchor.getBoundingClientRect();
    if (view != null && Math.abs(view.getWidth().toDouble() / density - rect.width) < 2 && Math.abs(view.getHeight().toDouble() / density - rect.height) < 2) {
      const xy = new IntArray(2); const decorXY = new IntArray(2);
      view.getLocationOnScreen(xy); decor.getLocationOnScreen(decorXY);
      return [xy[0].toDouble() - decorXY[0].toDouble() - rect.left * density, xy[1].toDouble() - decorXY[1].toDouble() - rect.top * density];
    }
    anchor = anchor.parentElement; depth++;
  }
  return [0, 0];
}
function updateRing(): void {
  const scope = candidateScope; const decor = ringDecor; const drawable = ringDrawable;
  const element = candidateElements.get(highlightedId);
  if (scope == null || decor == null || drawable == null || element == null || !inScope(element, scope)) { clearRing(); return; }
  const rect = clippedRect(element, scope);
  if (rect == null) { drawable.setBounds(0, 0, 0, 0); return; }
  const density = decor.getResources().getDisplayMetrics().density.toDouble();
  const offset = ringOffset(scope, decor, density);
  drawable.setBounds(Math.round(rect.left * density + offset[0]).toInt(), Math.round(rect.top * density + offset[1]).toInt(), Math.round(rect.right * density + offset[0]).toInt(), Math.round(rect.bottom * density + offset[1]).toInt());
}
class QtTvRingPreDraw implements ViewTreeObserver.OnPreDrawListener {
  override onPreDraw(): boolean { try { updateRing(); } catch (error) { clearRing(); } return true; }
}
const ringPreDraw = new QtTvRingPreDraw();
function findEditor(view: View | null, depth: number = 0): EditText | null {
  if (view == null || depth > 24) return null;
  if (view instanceof EditText) return view as EditText;
  if (view instanceof ViewGroup) {
    const group = view as ViewGroup;
    for (let index = 0; index < group.getChildCount(); index++) {
      const found = findEditor(group.getChildAt(index.toInt()), depth + 1);
      if (found != null) return found;
