/** HBuilderX 5.34 / Vapor Android native seam; no business state or focus scoring here. */
import { UTSAndroid } from "io.dcloud.uts";
import Activity from "android.app.Activity";
import ActivityInfo from "android.content.pm.ActivityInfo";
import Configuration from "android.content.res.Configuration";
import PackageManager from "android.content.pm.PackageManager";
import Context from "android.content.Context";
import Build from "android.os.Build";
import Handler from "android.os.Handler";
import Looper from "android.os.Looper";
import Runnable from "java.lang.Runnable";
import View from "android.view.View";
import ViewGroup from "android.view.ViewGroup";
import ViewTreeObserver from "android.view.ViewTreeObserver";
import KeyEvent from "android.view.KeyEvent";
import WindowInsets from "android.view.WindowInsets";
import InputMethodManager from "android.view.inputmethod.InputMethodManager";
import EditText from "android.widget.EditText";
import WebView from "android.webkit.WebView";
import Rect from "android.graphics.Rect";
import Color from "android.graphics.Color";
import GradientDrawable from "android.graphics.drawable.GradientDrawable";
import ConcurrentHashMap from "java.util.concurrent.ConcurrentHashMap";
import CEventManager from "io.dcloud.uniappxv.bridge.CEventManager";
import UniPageActivity from "io.dcloud.uniappxv.activity.UniPageActivity";
import { QtTvDevice, QtTvRemoteEvent, QtTvRemoteState, QtTvRemoteHandler, QtTvCandidate } from "../interface.uts";
export { QtTvDevice, QtTvRemoteEvent, QtTvRemoteState, QtTvRemoteHandler, QtTvCandidate } from "../interface.uts";

const SCAN_LIMIT = 512;
type QtTvScanResume = { element: UniElement, index: number };
const mainHandler = new Handler(Looper.getMainLooper());
let remoteHandler: QtTvRemoteHandler | null = null;
let remoteState: QtTvRemoteState = { enabled: false, captureBack: false, captureMenu: false, editing: false };
let remoteGeneration = 0;
let keyRegistered = false;
let lifeRegistered = false;
let presentationEnabled = false;
const ownedKeys = new Set<string>();
const orientations = new Map<Activity, number>();
let candidateElements = new ConcurrentHashMap<string, UniElement>();
let candidateScope: UniElement | null = null;
let ringDecor: View | null = null;
let ringDrawable: GradientDrawable | null = null;
let ringObserver: ViewTreeObserver | null = null;
let highlightedId = "";
let editorView: EditText | null = null;
let editorDecor: View | null = null;
let editorObserver: ViewTreeObserver | null = null;
let editorWasVisible = false;
let editorDismissed = false;

class QtTvUiTask implements Runnable {
  action: () => void = () => {};
  constructor(action: () => void) { this.action = action; }
  override run(): void { this.action(); }
}
function onUi(action: () => void): void {
  if (Looper.myLooper() == Looper.getMainLooper()) action();
  else mainHandler.post(new QtTvUiTask(action));
}
function report(operation: string, error: any | null): void {
  console.log("[QtTvNative] " + operation + ": " + (error != null ? error.toString() : "unknown"));
}
function deviceFor(context: Context | null): QtTvDevice {
  const result: QtTvDevice = { television: false, leanback: false, uiModeType: 0, nativeAvailable: false };
  if (context == null) return result;
  try {
    const type = context.getResources().getConfiguration().uiMode & Configuration.UI_MODE_TYPE_MASK;
    const manager = context.getPackageManager();
    result.television = type == Configuration.UI_MODE_TYPE_TELEVISION;
    result.leanback = manager.hasSystemFeature(PackageManager.FEATURE_LEANBACK) || manager.hasSystemFeature(PackageManager.FEATURE_LEANBACK_ONLY);
    result.uiModeType = type.toDouble(); result.nativeAvailable = true;
  } catch (error) { report("device", error); }
  return result;
}
function currentActivity(): Activity | null { return UTSAndroid.getUniActivity(); }
function keyboardVisible(activity: Activity): boolean {
  try {
    const decor = activity.getWindow().getDecorView();
    if (Build.VERSION.SDK_INT >= 30) {
      const insets = decor.getRootWindowInsets();
      return insets != null && insets.isVisible(WindowInsets.Type.ime());
    }
    const visible = new Rect();
    decor.getWindowVisibleDisplayFrame(visible);
    const density = activity.getResources().getDisplayMetrics().density.toDouble();
    const height = decor.getRootView().getHeight().toDouble();
    return height - visible.height().toDouble() > Math.max(120 * density, height * 0.18);
  } catch (error) { return false; }
}
function detachEditorWatch(): void {
  const observer = editorObserver;
  if (observer != null && observer.isAlive()) observer.removeOnGlobalLayoutListener(editorLayout);
  editorObserver = null; editorView = null; editorDecor = null; editorWasVisible = false;
}
function dismissEditor(activity: Activity): void {
  const focused = activity.getCurrentFocus();
  const editor = editorView != null ? editorView : (focused instanceof EditText ? focused as EditText : null);
  editorDismissed = true; remoteState.editing = false;
  detachEditorWatch();
  if (editor != null) {
    const manager = activity.getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager | null;
    if (manager != null) manager.hideSoftInputFromWindow(editor.getWindowToken(), 0);
    editor.clearFocus(); // Native blur releases the application's input mode as well.
  }
}
class QtTvEditorLayout implements ViewTreeObserver.OnGlobalLayoutListener {
  override onGlobalLayout(): void {
    const decor = editorDecor;
    if (decor == null) return;
    const activity = currentActivity();
    if (activity == null || activity.getWindow().getDecorView() != decor) { detachEditorWatch(); return; }
    const visible = keyboardVisible(activity);
    if (visible) editorWasVisible = true;
    else if (editorWasVisible) dismissEditor(activity);
  }
}
const editorLayout = new QtTvEditorLayout();
function watchEditor(activity: Activity, editor: EditText | null): void {
  if (editor == null) return;
  const decor = activity.getWindow().getDecorView();
  if (editorDecor != decor) {
    detachEditorWatch();
    const observer = decor.getViewTreeObserver(); editorObserver = observer; editorDecor = decor;
    observer.addOnGlobalLayoutListener(editorLayout);
  }
  editorView = editor;
  if (keyboardVisible(activity)) editorWasVisible = true;
}
function nativeEditing(activity: Activity, back: boolean): boolean {
  const visible = keyboardVisible(activity);
  const focused = activity.getCurrentFocus();
  const editor = focused instanceof EditText ? focused as EditText : null;
  // A late JS editing=true or native autofocus after BACK must not trap DPAD in the old editor.
  if (editorDismissed) { if (editor != null || visible) dismissEditor(activity); return false; }
  if (visible) watchEditor(activity, editor);
  else if (editorWasVisible) { dismissEditor(activity); return false; }
  if (back) return visible;
  return remoteState.editing || visible || editor != null;
}
function keyName(code: number): string {
  if (code == 19) return "up";
  if (code == 20) return "down";
  if (code == 21) return "left";
  if (code == 22) return "right";
  if (code == 23 || code == 66 || code == 160) return "ok";
  if (code == 4 || code == 111) return "back";
  if (code == 82) return "menu";
  return ""; // HOME, volume and all MEDIA_* stay with Android / existing Media3 session.
}
function isDirection(key: string): boolean { return key == "up" || key == "down" || key == "left" || key == "right"; }
function ownership(event: KeyEvent): string {
  return event.getDeviceId().toString() + ":" + event.getKeyCode().toString() + ":" + event.getDownTime().toString();
}
class QtTvRemoteDelivery implements Runnable {
  event: QtTvRemoteEvent = { key: "", code: 0, action: "down", repeat: 0 };
  generation: number = 0;
  constructor(event: QtTvRemoteEvent, generation: number) { this.event = event; this.generation = generation; }
  override run(): void {
    const sink = remoteHandler;
    if (sink == null || this.generation != remoteGeneration || !remoteState.enabled) return;
    try { sink(this.event); } catch (error) { report("remote-handler", error); }
  }
}
function deliverRemote(key: string, code: number, repeat: number): void {
  const event: QtTvRemoteEvent = { key: key, code: code, action: "down", repeat: repeat };
  mainHandler.post(new QtTvRemoteDelivery(event, remoteGeneration));
}
function focusedWebView(activity: Activity): boolean {
  let view = activity.getCurrentFocus();
  let depth = 0;
  while (view != null && depth < 32) {
    if (view instanceof WebView) return true;
    const parent = view.getParent();
    view = parent instanceof View ? parent as View : null; depth++;
  }
  return false;
}
class QtTvWindowCallback extends UniActivityWindowCallback {
  constructor() { super(); }
  override dispatchPreKeyEvent(params: UniActivityParams, event: KeyEvent | null): void {
    if (event == null) return;
    const activity = params.activity;
    const token = ownership(event);
    const action = event.getAction();
    if (action == KeyEvent.ACTION_UP) {
      if (ownedKeys.has(token)) { ownedKeys.delete(token); params.returnResult = true; }
      return;
    }
    if (action != KeyEvent.ACTION_DOWN) return;
    const code = event.getKeyCode().toDouble();
    const key = keyName(code);
    if (key.length == 0) return;
    // Keep ownership across mode/page changes until its matching UP; never replay an owned key natively.
    if (ownedKeys.has(token)) {
      params.returnResult = true;
      if (remoteState.enabled && isDirection(key) && activity != null && !focusedWebView(activity) && !nativeEditing(activity, false)) {
        deliverRemote(key, code, event.getRepeatCount().toDouble());
      }
      return;
    }
    if (remoteHandler == null || !remoteState.enabled || activity == null) return;
    // Only new ownership passes through embedded browsers; owned repeats/UP keep their original consumption.
    if (focusedWebView(activity)) return;
    if (key == "back" && !keyboardVisible(activity) && !editorDismissed && (remoteState.editing || activity.getCurrentFocus() instanceof EditText)) {
      // Hardware-keyboard / IME-already-hidden session: first BACK exits the editor, not the page.
      dismissEditor(activity); ownedKeys.add(token); params.returnResult = true; return;
    }
    if (nativeEditing(activity, key == "back")) return;
    if (key == "back" && !remoteState.captureBack) return;
    if (key == "menu" && !remoteState.captureMenu) return;
    if (event.getRepeatCount() > 0) return; // Do not acquire an orphan repeat after an IME/mode transition.
    if (ownedKeys.size >= 64) ownedKeys.clear();
    ownedKeys.add(token);
    params.returnResult = true; // Synchronous native consumption, independent of the JS callback return.
    deliverRemote(key, code, 0);
  }
}
const windowCallback = new QtTvWindowCallback();
function applyPresentation(activity: Activity): void {
  if (!presentationEnabled || activity.isFinishing() || activity.isDestroyed()) return;
  const device = deviceFor(activity);
  if (!device.television && !device.leanback) return;
  if (!orientations.has(activity)) orientations.set(activity, activity.getRequestedOrientation().toDouble());
  if (activity.getRequestedOrientation() != ActivityInfo.SCREEN_ORIENTATION_SENSOR_LANDSCAPE) {
    activity.setRequestedOrientation(ActivityInfo.SCREEN_ORIENTATION_SENSOR_LANDSCAPE);
  }
}
class QtTvLifeCallback extends UniActivityLifeCycleCallback {
  constructor() { super(); }
  override onResume(params: UniActivityParams): void {
    const activity = params.activity;
    if (activity != null) applyPresentation(activity);
  }
  override onPause(params: UniActivityParams): void {
    const activity = params.activity;
    if (activity == null) return;
    if (ringDecor == activity.getWindow().getDecorView()) clearRing();
    if (editorDecor == activity.getWindow().getDecorView()) detachEditorWatch();
  }
  override onDestroy(params: UniActivityParams): void {
    const activity = params.activity;
    if (activity == null) return;
    orientations.delete(activity);
    const scope = candidateScope;
    if (scope != null && scope.getAndroidActivity() == activity) {
      candidateElements.clear(); candidateScope = null; clearRing();
    }
  }
}
const lifeCallback = new QtTvLifeCallback();
function syncLifecycle(): void {
  const needed = remoteHandler != null || presentationEnabled;
  if (needed && !lifeRegistered) { UTSAndroid.onActivityCallback(lifeCallback, null); lifeRegistered = true; }
  if (!needed && lifeRegistered) { UTSAndroid.offActivityCallback(lifeCallback); lifeRegistered = false; }
}
function resolveScope(root: UniElement | null): UniElement | null {
  if (root != null) return root;
  // Native page body is an element; UniPageBody is only its geometry and is not used here.
  const activity = currentActivity();
  if (!(activity instanceof UniPageActivity)) return null;
  const page = (activity as UniPageActivity).page;
  return page != null ? page.bodyElement : null;
}
function inputElement(element: UniElement): boolean {
  const tag = element.tagName.toLowerCase();
  return tag == "input" || tag == "textarea";
}
function attributeDisabled(element: UniElement): boolean {
  const value = element.getAnyAttribute("disabled");
  return value == true || value == "true" || value == "disabled";
}
function concealed(element: UniElement): boolean {
  return !element.isConnected || element.style.getPropertyValue("display") == "none" || element.style.getPropertyValue("visibility") == "hidden" || element.style.getPropertyValue("opacity") == "0";
}
function inScope(element: UniElement, scope: UniElement): boolean {
  let cursor: UniElement | null = element;
  let depth = 0;
  while (cursor != null && depth < 96) { if (cursor == scope) return true; cursor = cursor.parentElement; depth++; }
  return false;
}
function stableId(element: UniElement): string {
  const custom = element.dataset.get("qtTvId");
  const page = element.uniPage;
  const prefix = "tv:" + page.appId.toString() + ":" + page.pageId.toString() + ":";
  if (custom != null && custom.toString().length > 0) return prefix + "custom:" + custom.toString();
  return prefix + "node:" + element.getNodeId().toString();
}
function canTap(element: UniElement): boolean {
  return CEventManager.hasElementEventListener(element, "tap") || CEventManager.hasElementEventListener(element, "click");
}
function canLongPress(element: UniElement): boolean { return CEventManager.hasElementEventListener(element, "longpress"); }
function scrollContainer(element: UniElement): boolean {
  const tag = element.tagName.toLowerCase();
  return tag == "scroll-view" || tag == "list-view" || tag == "swiper" || tag == "nested-scroll-body";
}
function readonlyScrollTarget(element: UniElement): boolean {
  return element.classList.includes("qt-tv-scroll") && scrollContainer(element);
}
function scrollGroupFor(element: UniElement, scope: UniElement): string {
  let ancestor: UniElement | null = readonlyScrollTarget(element) ? element : element.parentElement;
  let depth = 0;
  while (ancestor != null && depth < 96) {
    if (!inScope(ancestor, scope)) break;
    if (scrollContainer(ancestor)) return stableId(ancestor);
    if (ancestor == scope) break;
    ancestor = ancestor.parentElement; depth++;
