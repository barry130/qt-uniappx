}
export function collectTvCandidates(root: UniElement | null): QtTvCandidate[] {
  const result: QtTvCandidate[] = [];
  const scope = resolveScope(root);
  const nextElements = new ConcurrentHashMap<string, UniElement>();
  if (scope == null || concealed(scope)) {
    candidateScope = scope; candidateElements = nextElements;
    onUi(() => { clearRing(); }); return result;
  }
  const queue: UniElement[] = [];
  const deferred: QtTvScanResume[] = [];
  const initial = scope.children;
  let initialIndex = 0;
  while (initialIndex < initial.length) {
    if (queue.length >= SCAN_LIMIT) { deferred.push({ element: scope, index: initialIndex }); break; }
    queue.push(initial[initialIndex]); initialIndex++;
  }
  // Breadth-first preserves later rail/dock siblings. Empty text/image leaves consume no layout budget.
  let visited = 0; let cursor = 0; let inspectedChildren = 0;
  while (cursor < queue.length && visited < SCAN_LIMIT) {
    const element = queue[cursor]; cursor++; visited++;
    if (!visitCandidate(element, scope, nextElements, result)) continue;
    const children = element.children;
    let childIndex = 0;
    while (childIndex < children.length) {
      if (queue.length >= SCAN_LIMIT || inspectedChildren >= SCAN_LIMIT * 8) { deferred.push({ element: element, index: childIndex }); break; }
      const child = children[childIndex]; childIndex++; inspectedChildren++;
      const tag = child.tagName.toLowerCase();
      if ((tag == "text" || tag == "image") && child.children.length == 0 && !canTap(child) && !canLongPress(child)) continue;
      queue.push(child);
    }
  }
  // The fixed budget starves the visible tail of huge non-virtual lists. Phase 2
  // completes exactly what the caps skipped: offscreen wrappers never consume the
  // visible budget, so every refresh re-reaches the current viewport rows and
  // offscreen/removed candidates from the previous pass are evicted by recompute.
  if (cursor < queue.length || deferred.length > 0) {
    const base = scopeViewport(scope);
    if (base != null) {
      let budget = SCAN_LIMIT * 16;
      const phase2: UniElement[] = [];
      let phase2Cursor = 0;
      while (budget > 0 && cursor < queue.length) {
        const element = queue[cursor]; cursor++; budget--;
        if (!quickInView(element, base) || !visitCandidate(element, scope, nextElements, result)) continue;
        expandVisible(element, phase2);
      }
      for (let deferredIndex = 0; deferredIndex < deferred.length && budget > 0; deferredIndex++) {
        const resume = deferred[deferredIndex];
        const children = resume.element.children;
        while (resume.index < children.length && budget > 0) {
          const child = children[resume.index]; resume.index++; budget--;
          const tag = child.tagName.toLowerCase();
          if ((tag == "text" || tag == "image") && child.children.length == 0 && !canTap(child) && !canLongPress(child)) continue;
          if (!quickInView(child, base) || !visitCandidate(child, scope, nextElements, result)) continue;
          expandVisible(child, phase2);
        }
      }
      while (budget > 0 && phase2Cursor < phase2.length) {
        const element = phase2[phase2Cursor]; phase2Cursor++; budget--;
        if (!quickInView(element, base) || !visitCandidate(element, scope, nextElements, result)) continue;
        expandVisible(element, phase2);
      }
    }
  }
  const changedScope = scope != candidateScope;
  // Publish a completed registry; preDraw never sees a transient empty map on same-scope refresh.
  candidateElements = nextElements; candidateScope = scope;
  if (changedScope || (highlightedId.length > 0 && !nextElements.containsKey(highlightedId))) {
    onUi(() => { if (changedScope || !candidateElements.containsKey(highlightedId)) clearRing(); });
  }
  return result;
}
export function highlightTvElement(id: string, color: string): void {
  onUi(() => {
    clearRing();
    const scope = candidateScope; const element = candidateElements.get(id);
    if (id.length == 0 || scope == null || element == null || clippedRect(element, scope) == null) return;
    const activity = scope.getAndroidActivity();
    if (activity == null) return;
    const decor = activity.getWindow().getDecorView();
    const density = decor.getResources().getDisplayMetrics().density.toDouble();
    const drawable = new GradientDrawable();
    let ringColor = Color.parseColor("#57BDD0");
    try { ringColor = Color.parseColor(color); } catch (error) { /* 静默：非法焦点颜色沿用默认青色 */ }
    drawable.setColor(Color.TRANSPARENT); drawable.setCornerRadius((8 * density).toFloat());
    drawable.setStroke(Math.max(2, Math.round(3 * density)).toInt(), ringColor);
    ringDecor = decor; ringDrawable = drawable; highlightedId = id;
    decor.getOverlay().add(drawable);
    const observer = decor.getViewTreeObserver(); ringObserver = observer;
    observer.addOnPreDrawListener(ringPreDraw); updateRing();
  });
}
export function activateTvElement(id: string, longPress: boolean = false): void {
  const element = candidateElements.get(id); const scope = candidateScope;
  if (element == null || scope == null || !inScope(element, scope) || attributeDisabled(element) || clippedRect(element, scope) == null) return;
  onUi(() => {
    try {
      if (!element.isConnected || candidateScope != scope || !inScope(element, scope)) return;
      if (readonlyScrollTarget(element)) return; // Focusable document viewport: OK never creates a business action.
      if (inputElement(element)) { if (!longPress) focusEditor(element); return; }
      if (longPress) { if (canLongPress(element)) element.dispatchEvent(new UniTouchEvent("longpress", [], [])); return; }
      if (!canTap(element)) return;
      const name = CEventManager.hasElementEventListener(element, "tap") ? "tap" : "click";
      // Vapor @tap is a bridge event, not Android View.OnClickListener. Dispatch exactly once.
      element.dispatchEvent(new UniTouchEvent(name, [], []));
    } catch (error) { report("activate", error); }
  });
}
export function scrollTvAncestor(id: string, direction: string): boolean {
  const element = candidateElements.get(id); const scope = candidateScope;
  if (element == null || scope == null || !inScope(element, scope)) return false;
  const horizontal = direction == "left" || direction == "right";
  if (!horizontal && direction != "up" && direction != "down") return false;
  const sign = direction == "left" || direction == "up" ? -1 : 1;
  let ancestor: UniElement | null = readonlyScrollTarget(element) ? element : element.parentElement; let depth = 0;
  while (ancestor != null && depth < 96) {
    if (!inScope(ancestor, scope)) break;
    if (scrollContainer(ancestor)) {
      const rect = ancestor.getBoundingClientRect();
      const extent = horizontal ? ancestor.scrollWidth : ancestor.scrollHeight;
      const viewport = horizontal ? rect.width : rect.height;
      const before = horizontal ? ancestor.scrollLeft : ancestor.scrollTop;
      const after = Math.max(0, Math.min(Math.max(0, extent - viewport), before + sign * viewport * 0.7));
      if (viewport > 0 && Math.abs(after - before) >= 1) {
        const target = ancestor;
        onUi(() => { if (target.isConnected && candidateScope == scope) target.scrollTo(horizontal ? after : target.scrollLeft, horizontal ? target.scrollTop : after); });
        return true;
      }
    }
    if (ancestor == scope) break;
    ancestor = ancestor.parentElement; depth++;
  }
  return false;
}
export function setTvPresentation(enabled: boolean): void {
  presentationEnabled = enabled; syncLifecycle();
  onUi(() => {
    try {
      if (enabled) { const activity = currentActivity(); if (activity != null) applyPresentation(activity); return; }
      orientations.forEach((orientation: number, activity: Activity) => {
        if (!activity.isFinishing() && !activity.isDestroyed()) activity.setRequestedOrientation(orientation.toInt());
      });
      orientations.clear();
    } catch (error) { report("presentation", error); }
  });
}
// Android 13 以下没有公开的返回分发器，androidx 自身的兜底也是调用这个弃用入口；
// 仅静音这一个兼容函数，不屏蔽其余代码的弃用诊断（同 qt-audio-player dlna.uts 先例）。
@Suppress("DEPRECATION")
function activityLegacyBack(activity: Activity): void { activity.onBackPressed(); }
export function performTvBack(): void {
  onUi(() => { const activity = currentActivity(); if (activity != null && !activity.isFinishing()) activityLegacyBack(activity); });
}
