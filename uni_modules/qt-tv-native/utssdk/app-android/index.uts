  }
  return null;
}
function focusEditor(element: UniElement): void {
  editorDismissed = false;
  element.focus();
  const editor = findEditor(element.getAndroidView<View>());
  if (editor == null || !editor.isEnabled()) return;
  const activity = currentActivity();
  if (activity != null) watchEditor(activity, editor);
  editor.requestFocus();
  const manager = editor.getContext().getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager | null;
  if (manager != null) manager.showSoftInput(editor, InputMethodManager.SHOW_IMPLICIT);
}

export function readTvDevice(): QtTvDevice { return deviceFor(UTSAndroid.getAppContext()); }
@UTSJS.keepAlive
export function startTvRemote(handler: QtTvRemoteHandler): void {
  remoteGeneration++; remoteHandler = handler;
  if (!keyRegistered) { UTSAndroid.onActivityCallback(windowCallback, null); keyRegistered = true; }
  syncLifecycle();
}
export function setTvRemoteState(state: QtTvRemoteState): void {
  if (remoteState.enabled && !state.enabled) remoteGeneration++;
  const nextState: QtTvRemoteState = { enabled: state.enabled, captureBack: state.captureBack, captureMenu: state.captureMenu, editing: state.editing };
  remoteState = nextState;
  if (!state.enabled) onUi(() => { clearRing(); detachEditorWatch(); editorDismissed = false; });
}
export function stopTvRemote(): void {
  remoteGeneration++; remoteHandler = null;
  const nextState: QtTvRemoteState = { enabled: false, captureBack: false, captureMenu: false, editing: false };
  remoteState = nextState;
  if (keyRegistered) { UTSAndroid.offActivityCallback(windowCallback); keyRegistered = false; }
  ownedKeys.clear(); candidateElements.clear(); candidateScope = null;
  onUi(() => { clearRing(); detachEditorWatch(); editorDismissed = false; }); syncLifecycle();
}
/** Cheap scope-viewport prefilter; a miss can never hide a node that full clipping would keep. */
function quickInView(element: UniElement, base: DOMRect): boolean {
  const rect = element.getBoundingClientRect();
  return rect.width > 0 && rect.height > 0 && rect.right > base.left && rect.left < base.right && rect.bottom > base.top && rect.top < base.bottom;
}
/** Phase-2 child expansion shares the leaf-skip rule; the queue keeps its own bound. */
function expandVisible(element: UniElement, queue: UniElement[]): void {
  const children = element.children;
  for (let index = 0; index < children.length && queue.length < SCAN_LIMIT; index++) {
    const child = children[index];
    const tag = child.tagName.toLowerCase();
    if ((tag == "text" || tag == "image") && child.children.length == 0 && !canTap(child) && !canLongPress(child)) continue;
    queue.push(child);
  }
}
/** Shared candidate publication for both scan phases; false means the subtree is concealed. */
function visitCandidate(element: UniElement, scope: UniElement, registry: ConcurrentHashMap<string, UniElement>, out: QtTvCandidate[]): boolean {
  if (concealed(element)) return false;
  const rect = element.getBoundingClientRect();
  const input = inputElement(element);
  const longPress = canLongPress(element);
  // Bare stop-propagation/frame targets are excluded, their business descendants are retained.
  if (rect.width > 0 && rect.height > 0 && !element.classList.includes("qt-tv-skip") && (input || canTap(element) || longPress || readonlyScrollTarget(element))) {
    const clip = clippedRect(element, scope);
    if (clip != null) {
      const view = element.getAndroidView<View>();
      const id = stableId(element);
      if (!registry.containsKey(id)) {
        registry.put(id, element);
        const candidate: QtTvCandidate = { id: id, left: rect.left, top: rect.top, width: rect.width, height: rect.height, visible: true, enabled: !attributeDisabled(element) && (view == null || view.isEnabled()), input: input, longPress: longPress, scrollGroup: scrollGroupFor(element, scope) };
        out.push(candidate);
