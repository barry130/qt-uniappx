<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.quietmusic.tv">
    <!-- One package remains installable on phones, tablets, cars and TVs. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <application>
        <!-- HBuilderX 5.34 Vapor entry, verified against the actual libVapor class.
             Keep this alias TV-only: the original phone LAUNCHER is unchanged. -->
        <activity-alias
            android:name="io.quietmusic.tv.Launcher"
            android:targetActivity="io.dcloud.uniappxv.UniAppActivity"
            android:enabled="true"
            android:exported="true"
            android:label="轻听"
            android:banner="@drawable/qt_tv_banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
