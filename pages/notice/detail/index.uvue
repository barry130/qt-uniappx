<template>
  <qt-page-frame :max-width="760">
  <view class="page" :class="[themeStore.dark ? 'page-dark' : '', layout.isWide ? 'page-wide' : '']">
    <scroll-view v-if="notice != null" class="scroll" :class="layout.isWide ? 'scroll-wide' : ''" direction="vertical" :show-scrollbar="false">
      <view class="head" :class="layout.isWide ? 'head-wide' : ''">
        <text class="title" :class="layout.isWide ? 'title-wide' : ''">{{ notice!.title != null && notice!.title!.length > 0 ? notice!.title! : "公告" }}</text>
        <text v-if="notice!.createTime != null && notice!.createTime!.length > 0" class="time" :class="layout.isWide ? 'time-wide' : ''">{{
          notice!.createTime!
        }}</text>
      </view>
      <view class="body" :class="layout.isWide ? 'body-wide' : ''">
        <!-- 富文本正文：统一用 QtRichText（JS 侧同步解析成块 + 行内片段，逐段 <text> 渲染）。
             弃用原生 rich-text mode="native"：部分 ROM 会把 <b> 的字重渗到整个块
             （列表项里「名称加粗」会把整行都变粗），自绘 text 逐 run 设置字重不受影响。
             同时避免原生异步解析导致的“内容后出现”闪现 -->
        <view
          v-if="hasContent"
          class="rich" :class="layout.isWide ? 'rich-wide' : ''"
          :style="'background-color:' + themeStore.skin.surface + ';'"
        >
          <QtRichText
            :html="notice!.content!"
            :color="themeStore.skin.text"
            :font-size="26"
            :line-height="1.7"
            align="left"
          />
        </view>
        <view v-if="hasAction" class="action" :class="layout.isWide ? 'action-wide' : ''" :style="'background-color:' + themeStore.skin.accent + ';'" @tap="goAction">
          <text class="action-text" :class="layout.isWide ? 'action-text-wide' : ''" :style="'color:' + themeStore.skin.onAccent + ';'">查看详情</text>
        </view>
      </view>
    </scroll-view>
    <view v-else class="empty" :class="layout.isWide ? 'empty-wide' : ''">
      <text class="empty-text" :class="layout.isWide ? 'empty-text-wide' : ''">{{ notFound ? "公告不存在或已失效" : "加载中..." }}</text>
    </view>
  </view>
  </qt-page-frame>
</template>

<script setup lang="ts">
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import QtRichText from "@/uni_modules/qt-ui/components/qt-rich-text/qt-rich-text.uvue";
import { ref, computed } from "vue";
import { onLoad } from "@dcloudio/uni-app";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useNoticeStore } from "@/stores/notice";
import { fetchMessageCenter, openNoticeUrl } from "@/services/notice";
import type { Notice } from "@/types/notice";

const themeStore = useThemeStore();
const layout = useQtLayout();
const noticeStore = useNoticeStore();

const notice = ref<Notice | null>(null);
const notFound = ref(false);
const noticeId = ref(0);

// 内容富文本：统一用 QtRichText（JS 侧同步解析成块 + 行内片段），Vapor 下无原生异步解析闪现
const hasContent = computed(() => notice.value != null && notice.value!.content != null && notice.value!.content!.length > 0);
const hasAction = computed(() => notice.value != null && notice.value!.url != null && notice.value!.url!.length > 0);

function goAction(): void {
  const url = notice.value != null ? notice.value!.url : "";
  openNoticeUrl(url);
}

function hasContentValue(n: Notice): boolean {
  return n.content != null && n.content!.length > 0;
}

async function load(): Promise<void> {
  // 已分发公告里找到且内容完整，直接展示（标题+内容一次性渲染，避免分段闪现）
  const fromDispatch = noticeStore.notices.find((n) => n.id == noticeId.value);
  if (fromDispatch != null && hasContentValue(fromDispatch)) {
    notice.value = fromDispatch;
    return;
  }
  // 否则去消息中心取完整数据（内容最全）
  let found = false;
  try {
    const list = await fetchMessageCenter();
    const m = list.find((n) => n.id == noticeId.value);
    if (m != null) {
      notice.value = m;
      found = true;
    }
  } catch (_) {
    // 忽略拉取失败，走到兜底
  }
  if (found) return;
  // 兜底：有公告但内容为空，仍展示标题与基本信息
  if (fromDispatch != null) {
    notice.value = fromDispatch;
    return;
  }
  notFound.value = true;
}

onLoad((options) => {
  const id = options != null ? (options["id"] as string | undefined) : undefined;
  noticeId.value = id != null ? parseInt(id) || 0 : 0;
  load();
});
</script>

<style>
.page {
  flex: 1;
}

.scroll {
  flex: 1;
}
.head {
  padding: 40rpx 40rpx 22rpx;
}
.title {
  color: #191d26;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}
.time {
  margin-top: 16rpx;
  color: #6b7385;
  font-size: 24rpx;
}
.body {
  padding: 24rpx 40rpx 60rpx;
}
/* 蒸汽模式 rich-text native 默认黑底白字，必须显式指定背景/字色（颜色由模板绑定主题令牌） */
.rich { padding: 24rpx; border-radius: 16rpx; line-height: 1.6; }
.action {
  margin-top: 48rpx;
  height: 88rpx;
  justify-content: center;
  align-items: center;
  border-radius: 44rpx;
}
.action-text {
  font-size: 28rpx;
  font-weight: 600;
}
.empty {
  flex: 1;
  justify-content: center;
  align-items: center;
}
.empty-text {
  color: #6b7385;
  font-size: 28rpx;
}

/* Vapor 宽屏：px 覆盖 rpx，1600x900 下避免按窗口比例放大 2.7 倍 */
.page-wide { align-items: center; }
.scroll-wide { width: 640px; }
.head-wide { padding: 24px 8px 12px; }
.title-wide { font-size: 20px; }
.time-wide { margin-top: 8px; font-size: 14px; }
.body-wide { padding: 8px 8px 32px; }
.rich-wide { padding: 12px; border-radius: 12px; }
.action-wide { margin-top: 24px; height: 52px; border-radius: 26px; }
.action-text-wide { font-size: 16px; }
.empty-wide { width: 640px; }
.empty-text-wide { font-size: 16px; }
</style>
