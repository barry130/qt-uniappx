<template>
  <qt-page-frame width-kind="list">
  <view class="page" :class="themeStore.dark ? 'page-dark' : ''">
    <!-- 工具条：未读提示 + 一键已读兜底（未登录时广播公告与登录无关，不展示提示行） -->
    <view v-if="loggedIn" class="toolbar" :class="layout.isWide ? 'toolbar-wide' : ''">
      <text class="toolbar-text" :class="layout.isWide ? 'toolbar-text-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(24, 14)">{{
        unreadLocal > 0 ? unreadLocal + " 条未读" : "全部已读"
      }}</text>
      <view v-if="unreadLocal > 0" class="readall-btn" :class="layout.isWide ? 'readall-btn-wide' : ''" :style="'background-color:' + themeStore.skin.accentSoft + ';'" @tap="onMarkAllRead">
        <text class="readall-btn-text" :class="layout.isWide ? 'readall-btn-text-wide' : ''" :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(23, 13)">一键已读</text>
      </view>
    </view>

    <list-view class="list" :key="listEpochKey" direction="vertical">
      <list-item v-if="loading" class="sk-item">
        <QtSkeletonList kind="notice" :rows="SKELETON_ROWS" />
      </list-item>
      <list-item v-else-if="items.length == 0" class="empty" :class="layout.isWide ? 'empty-wide' : ''">
        <QtIcon name="bell" :size="layout.isWide ? 44 : 72" color="#c3c9d6" />
        <text class="empty-text" :class="layout.isWide ? 'empty-text-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(26, 14)">暂无消息</text>
        <view v-if="!loggedIn" class="login-btn" :class="layout.isWide ? 'login-btn-wide' : ''" :style="'background-color:' + themeStore.skin.accent + ';'" @tap="goLogin">
          <text class="login-btn-text" :class="layout.isWide ? 'login-btn-text-wide' : ''" :style="('color:' + themeStore.skin.onAccent + ';') + qtFontDual(26, 14)">去登录</text>
        </view>
      </list-item>
      <!-- 一条消息一张卡：卡片样式挂在内层 view 上，list-item 只负责行间距与左右留白。
           list-item 不支持 margin（同 pages/download 的 .row 注释），margin 写在它上面会让
           整行按容器满宽计算：卡片右缘溢出屏幕被裁、行与行之间也没有间隙 -->
      <list-item v-for="pair in pairs" :key="pair.key" class="n-row" :class="layout.isWide ? 'n-row-wide' : ''">
        <view class="pair" :class="twoColumn ? 'pair-wide' : ''">
          <view class="cell" :style="cellStyle">
            <QtNoticeCard
              :title="cardTitle(pair.left)"
              :typeText="cardType(pair.left)"
              :typeColor="ntypeColor(pair.left.notice)"
              :read="pair.left.read"
              :top="cardTop(pair.left)"
              @tap="openItem(pair.left)"
            />
          </view>
          <!-- 右格容器恒渲染、内容条件渲染：list-item 复用按子节点数分池，
               条件渲染整个右格会让奇数行的结构签名变化，复用池错配 -->
          <view v-if="twoColumn" class="cell-right" :style="rightCellStyle">
            <QtNoticeCard
              v-if="pair.hasRight"
              :title="cardTitle(pair.right)"
              :typeText="cardType(pair.right)"
              :typeColor="ntypeColor(pair.right.notice)"
              :read="pair.right.read"
              :top="cardTop(pair.right)"
              @tap="openItem(pair.right)"
            />
          </view>
        </view>
      </list-item>
      <list-item class="list-bottom-pad" :class="layout.isWide ? 'list-bottom-pad-wide' : ''"></list-item>
    </list-view>
  </view>
  </qt-page-frame>
</template>
<script setup lang="ts">
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import { ref, computed } from "vue";
import { onShow } from "@dcloudio/uni-app";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtSkeletonList from "@/uni_modules/qt-ui/components/qt-skeleton-list/qt-skeleton-list.uvue";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useNoticeStore } from "@/stores/notice";
import { fetchMessageCenter, noticeTypeLabel, openNoticeUrl, sortNotices } from "@/services/notice";
import { isRead, markAllRead, markRead } from "@/services/notice-read";
import { isLoggedIn } from "@/services/auth";
import { qtTrackPage } from "@/uni_modules/qt-stat";
import type { Notice, NoticeListItem } from "@/types/notice";
import QtNoticeCard from "@/uni_modules/qt-ui/components/qt-notice-card/qt-notice-card.uvue";
import { useQtSongColumns } from "@/uni_modules/qt-ui/composables/use-qt-song-columns";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";

const themeStore = useThemeStore();
const layout = useQtLayout();
const noticeStore = useNoticeStore();

/** 列表项（通知 + 进入页面时的已读快照） */
const items = ref<NoticeListItem[]>([]);
// 初值 true：加载在 onShow 里发起，首帧若按 false 渲染会先闪一下「暂无消息」
const loading = ref(true);
/** 骨架行数：一屏约摸这么多条，只做占位 */
const SKELETON_ROWS = 6;
const loggedIn = computed(() => isLoggedIn());
const unreadLocal = computed(() => {
  let unread = 0;
  for (let i = 0; i < items.value.length; i++) {
    if (!items.value[i].read) unread++;
  }
  return unread;
});

async function load(): Promise<void> {
  // 首次加载才显示“加载中”占位；已有数据时静默刷新，避免返回页面时跳动
  loading.value = items.value.length == 0;
  try {
    if (isLoggedIn()) {
      // 已登录：拉取消息中心（公告 + 反馈/需求通知），已读状态取自本地缓存快照
      // 未读的保持未读：点一条读一条，或用「一键已读」按钮
      const list = sortNotices(await fetchMessageCenter());
      const viewItems: NoticeListItem[] = [];
      for (let i = 0; i < list.length; i++) {
        viewItems.push({ notice: list[i], read: isRead(list[i]) });
      }
      items.value = viewItems;
      // 列表就在手上，直接重算未读数——refreshUnread 会把 unread-count + center 再打一遍
      noticeStore.applyUnreadList(list);
    } else {
      // 游客：展示对游客可见的公告（消息中心渠道），不做已读标记
      if (!noticeStore.loaded) {
        await noticeStore.load();
      }
      const list = sortNotices(noticeStore.dispatch.messageCenter);
      const viewItems: NoticeListItem[] = [];
      for (let i = 0; i < list.length; i++) {
        viewItems.push({ notice: list[i], read: true });
      }
      items.value = viewItems;
    }
  } catch (e) {
    // 保留旧数据，不因刷新失败清空
  } finally {
    loading.value = false;
  }
}

/**
 * 点击通知：
 * - 反馈/需求通知（feedbackId 非空）→ 反馈详情
 * - 配置了跳转链接 → openNoticeUrl
 * - 其余 → 公告详情页
 */
function openItem(item: NoticeListItem): void {
  const n: Notice = item.notice;
  if (isLoggedIn()) {
    if (!item.read) {
      markRead(n.id);
      item.read = true;
      syncUnreadFromItems();
    }
  }
  if (n.feedbackId != null) {
    uni.navigateTo({ url: "/pages/feedback/detail?id=" + n.feedbackId });
    return;
  }
  if (n.url != null && n.url!.length > 0) {
    openNoticeUrl(n.url);
    return;
  }
  uni.navigateTo({ url: "/pages/notice/detail/index?id=" + n.id });
}

/** 当前页面列表同步回 store 重算未读数（零请求；列表页永远持有全量列表） */
function syncUnreadFromItems(): void {
  const arr: Notice[] = [];
  for (let i = 0; i < items.value.length; i++) arr.push(items.value[i].notice);
  noticeStore.applyUnreadList(arr);
}

/** 一键已读（兜底按钮） */
function onMarkAllRead(): void {
  const ids: number[] = [];
  for (let i = 0; i < items.value.length; i++) ids.push(items.value[i].notice.id);
  markAllRead(ids);
  for (let i = 0; i < items.value.length; i++) items.value[i].read = true;
  syncUnreadFromItems();
}

/** 类型标签配色：公告灰 / 反馈蓝 / 需求橙 */
function ntypeColor(n: Notice): string {
  const t = n.noticeType ?? "announce";
  if (t == "feedback") return "#4a7dff";
  if (t == "request") return "#e8890c";
  return "#c4c9d4";
}

function goLogin(): void {
  uni.navigateTo({ url: "/pages/login/index" });
}

/* ---------------- 宽屏两列 ---------------- */
/* 门限按最小列宽判定而不是 sizeClass：MuMu 横屏只有 ~1067dp（wide 档）却够
   420*2+16，按 isDesktop 会误关两列。24 是 .n-row-wide 的左右 padding。 */
const { twoColumn, cellStyle, rightCellStyle } = useQtSongColumns(24, "list");

type NoticePair = { key: string; left: NoticeListItem; right: NoticeListItem; hasRight: boolean };

/** 一条 list-item 承载两张卡。奇数条时右格留空，靠 hasRight 判定，不塞占位卡片 */
const pairs = computed((): NoticePair[] => {
  const src = items.value;
  const out: NoticePair[] = [];
  if (!twoColumn.value) {
    for (let i = 0; i < src.length; i++) {
      out.push({ key: "n" + src[i].notice.id, left: src[i], right: src[i], hasRight: false });
    }
    return out;
  }
  let i = 0;
  while (i < src.length) {
    const has = i + 1 < src.length;
    out.push({ key: "n" + src[i].notice.id, left: src[i], right: has ? src[i + 1] : src[i], hasRight: has });
    i += 2;
  }
  return out;
});

/** 列数变化时重建 list-view：复用池按子节点数分池，列数变了必须换 key */
const listEpochKey = computed((): string => "nv-" + (twoColumn.value ? 2 : 1));

/* 卡片取值 helper：qt-notice-card 只收扁平标量，不信 Notice 类型（qt-ui 组件不依赖业务类型） */
function cardTitle(it: NoticeListItem): string {
  const n = it.notice;
  return n.title != null && n.title!.length > 0 ? n.title! : "公告";
}

/**
 * 类型标签文案：公告类返回空串（组件据此整块不渲染）。
 *
 * 消息中心里九成是公告，标题左边再挂一个灰「公告」标签纯属重复信息，
 * 2026-10-22 用户看着「好丑」。反馈/需求是少数派且点进去去向不同，标签保留。
 */
function cardType(it: NoticeListItem): string {
  const t = it.notice.noticeType ?? "announce";
  if (t == "announce") return "";
  return noticeTypeLabel(t);
}

function cardTop(it: NoticeListItem): boolean {
  return (it.notice.isTop ?? 0) == 1;
}

// 仅用 onShow 加载：首屏与从详情返回时各刷新一次，避免 onLoad+onShow 重复请求导致渲染两次
onShow(() => {
  qtTrackPage("pages/notice/list/index");
  load();
});
</script>

<style>
.page {
  flex: 1;
}

.toolbar {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 4rpx;
}
.toolbar-text {
  font-size: 24rpx;
}
.readall-btn {
  padding: 8rpx 24rpx;
  justify-content: center;
  align-items: center;
  border-radius: 26rpx;
}
.readall-btn-text {
  font-size: 23rpx;
  font-weight: 600;
}
.list {
  flex: 1;
}
.list-bottom-pad {
  height: 30rpx;
}
/* 骨架容器：不能复用 .empty（那里有 140rpx 上下内边距 + 居中，会把骨架压窄） */
.sk-item {
  padding: 0;
  flex-direction: column;
}
.empty {
  padding: 140rpx 32rpx;
  justify-content: center;
  align-items: center;
}
.empty-text {
  margin-top: 20rpx;
  font-size: 26rpx;
}
.login-btn {
  margin-top: 36rpx;
  padding: 16rpx 56rpx;
  justify-content: center;
  align-items: center;
  border-radius: 36rpx;
}
.login-btn-text {
  font-size: 26rpx;
  font-weight: 600;
}
/* list-item 不支持 margin（pages/download 的 .row 注释有同样结论）：卡片之间的间隙与左右留白
   只能写成 list-item 的 padding，写在 margin 上会被忽略——整行仍按容器满宽计算，卡片右缘
   溢出屏幕被裁、行与行之间贴在一起 */
.n-row {
  padding: 20rpx 24rpx 0;
  flex-direction: row;
  align-items: stretch;
}

/* Vapor 宽屏：px 覆盖 rpx，1600x900 下避免按窗口比例放大 2.7 倍 */
.toolbar-wide { padding: 12px 24px 4px; }
.toolbar-text-wide { font-size: 14px; }
.readall-btn-wide { padding: 6px 16px; border-radius: 14px; }
.readall-btn-text-wide { font-size: 13px; }
.list-bottom-pad-wide { height: 16px; }
.empty-wide { padding: 80px 24px; }
.empty-text-wide { margin-top: 10px; font-size: 14px; }
.login-btn-wide { margin-top: 20px; padding: 12px 28px; border-radius: 20px; }
.login-btn-text-wide { font-size: 14px; }
.n-row-wide { padding: 14px 24px 0; }
/* 桌面指针反馈：只在宽屏启用 */
.n-item-hover {
  background-color: rgba(127, 127, 127, 0.10);
}
/* 两列：一列一张卡。align-items:flex-start 让两卡各按内容高度排，
   默认 stretch 会把短卡拉长露出卡片底色空白 */
/* .pair 必须自己占满行宽：.n-row 是 flex row（横向主轴），不写 flex:1 时 .pair 会
   **按内容收缩宽度** —— 卡片各宽各的（标题长的更宽），时间戳被推出屏幕被裁
   （2026-10-19 真机截图报「公告信息的宽度不一致」）。history/local/feedback 的
   行容器是默认 column，.pair 落在交叉轴被默认 stretch 拉满，所以只有本页中招。
   两列时格子宽由脚本定宽内联下发（cellStyle），flex:1 不影响定宽格子。 */
.pair {
  flex: 1;
  flex-direction: column;
}
.pair-wide { flex-direction: row; align-items: flex-start; }
.cell { flex-direction: column; }
.cell-right { flex-direction: column; }
</style>
