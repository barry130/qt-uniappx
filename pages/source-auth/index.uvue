.src-tv-order { flex-shrink: 0; flex-direction: row; align-items: center; margin-left: 12px; }
.src-tv-next { margin-left: 8px; }
/* 44px 命中区由共享拖动组件提供，不接管标题与登录按钮的点击。 */
.src-drag-handle { flex-shrink: 0; align-items: center; justify-content: center; margin-left: 6rpx; }
