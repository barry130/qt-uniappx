  margin-left: 16rpx;
}
.auth-empty {
  padding: 16rpx 0;
}

.scope-row {
  flex-direction: row;
  align-items: center;
  padding: 18rpx 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
}
