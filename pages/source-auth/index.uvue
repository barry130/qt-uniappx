<template>
  <qt-page-frame width-kind="flow" :max-width="720">
    <scroll-view class="auth-scroll" direction="vertical" :show-scrollbar="false">
      <view class="auth-content" :class="layout.isWide ? 'auth-content-wide' : ''">
        <!-- 页头：说明 + 全部折叠/展开（对齐 qt-pc 2026-10-27：每源一张卡、默认折叠） -->
        <view class="page-head" :class="layout.isWide ? 'page-head-wide' : ''">
          <text class="page-desc" :class="layout.isWide ? 'page-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 12)">每个音源一张卡片：登录、两面登录态开关与播放/下载音质全部按源独立。点标题行展开或收起，凭据只保存在本机。</text>
          <text v-if="sourceCards.length > 0" class="head-toggle-all" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 12)" @click="toggleAllCards">{{ anyCardExpanded ? '全部折叠' : '全部展开' }}</text>
        </view>

        <view v-if="sourceCards.length == 0" class="empty auth-empty">
          <text class="empty-text" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 13)">{{ authEmptyText }}</text>
        </view>

        <qt-card
          v-for="(row, idx) in sourceCards"
          :key="'card-' + row.id"
          class="src-card"
          :class="idx == sourceCards.length - 1 ? 'src-card-last' : ''"
          elevated
        >
          <!-- 标题行：chevron + 源名 + 状态标签，点它展开/收起 -->
          <view class="src-head" @click="toggleCard(row.id)">
            <qt-icon :name="isCardExpanded(row.id) ? 'chevron-down' : 'chevron-right'" :size="layout.isWide ? 16 : 26" :color="theme.skin.textMuted" />
            <text class="src-name" :style="('color:' + theme.skin.text + ';') + qtFontDual(27, 15)">{{ row.name }}</text>
            <text v-if="row.orphan" class="src-tag" :style="('color:' + theme.skin.danger + ';') + qtFontDual(21, 11)">{{ registry.ready ? '音源包已卸载' : '音源包未就绪' }}</text>
            <text v-if="row.logged" class="src-tag" :style="('color:' + (row.stale ? theme.skin.danger : theme.skin.textMuted) + ';') + qtFontDual(21, 11)">{{ row.stale ? '凭据已过期' : '已登录' }}</text>
            <text v-else class="src-tag" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(21, 11)">未登录</text>
          </view>

          <view v-if="isCardExpanded(row.id)" class="src-body">
            <!-- 账号行：已登录给同步歌单+退出；未登录给包声明的登录方式 -->
            <view v-if="row.logged" class="src-acc" :style="rowBorderStyle">
              <text class="src-nick" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">{{ row.nickname }}</text>
              <qt-button class="acc-btn" label="同步歌单" variant="outline" size="sm" @click="openSync(row.id, row.name)" />
              <qt-button class="acc-btn" label="退出" variant="ghost" size="sm" @click="logout(row.id, row.name)" />
            </view>
            <view v-else-if="row.qr || row.cookie || row.web || row.sms || row.pwd" class="src-acc" :style="rowBorderStyle">
              <!-- 未登录源最多 5 颗按钮，窄屏一行放不下；这里做「单行横向滚动」而不是换行
                   （用户 2026-10-31：「这个我要的是左右滚动，不是换行」） -->
              <scroll-view class="acc-scroll" :class="layout.isWide ? 'acc-scroll-wide' : ''" direction="horizontal" :show-scrollbar="false">
                <view class="acc-track" :class="layout.isWide ? 'acc-track-wide' : ''" :style="'width:' + accTrackWidth(row) + ';'">
                  <qt-button v-if="row.qr" class="acc-btn" label="扫码登录" variant="secondary" size="sm" :disabled="qrBusy" @click="startQr(row.id, row.name)" />
                  <qt-button v-if="row.cookie" class="acc-btn" label="导入 Cookie" variant="outline" size="sm" @click="openCookieSheet(row.id, row.name)" />
                  <qt-button v-if="row.sms" class="acc-btn" label="短信登录" variant="outline" size="sm" @click="openSmsSheet(row.id, row.name)" />
                  <qt-button v-if="row.pwd" class="acc-btn" label="密码登录" variant="outline" size="sm" @click="openPwdSheet(row.id, row.name)" />
                  <qt-button v-if="row.web" class="acc-btn" label="网页登录" variant="outline" size="sm" @click="openWebLogin(row.id, row.name)" />
                </view>
              </scroll-view>
            </view>
            <view v-else class="src-acc" :style="rowBorderStyle">
              <text class="src-nick" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">该源当前数据包不支持账号登录</text>
            </view>

            <!-- 两面登录态开关（按源；未登录置灰） -->
            <view class="scope-row" :style="rowBorderStyle" @click="toggleCardScope(row, 'meta')">
              <view class="scope-main">
                <text class="scope-key" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">数据请求使用登录态</text>
                <text class="scope-sub" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">搜索、歌单、歌词等数据接口；同步歌单也依赖此项</text>
              </view>
              <qt-switch :model-value="row.useMeta" :disabled="!row.logged" @change="toggleCardScope(row, 'meta')" />
            </view>
            <view class="scope-row" :style="rowBorderStyle" @click="toggleCardScope(row, 'play')">
              <view class="scope-main">
                <text class="scope-key" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">播放请求使用登录态</text>
                <text class="scope-sub" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">在线播放取链（更高音质/会员内容等）；与数据面互不影响</text>
              </view>
              <qt-switch :model-value="row.usePlay" :disabled="!row.logged" @change="toggleCardScope(row, 'play')" />
            </view>

            <!-- 音质行（orphan 残留卡没有档位清单，不渲染） -->
            <view v-if="!row.orphan" class="scope-row" :style="rowBorderStyle" @click="showQualitySheet(row.id, row.name, 'play')">
              <view class="scope-main">
                <text class="scope-key" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">播放音质</text>
                <text class="scope-sub" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">播放该源歌曲时的取址音质；播放页音质菜单会同步改这里</text>
              </view>
              <text class="scope-value" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">{{ row.playQualityLabel }}</text>
            </view>
            <view v-if="!row.orphan" class="scope-row scope-row-last" @click="showQualitySheet(row.id, row.name, 'download')">
              <view class="scope-main">
                <text class="scope-key" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">下载音质</text>
                <text class="scope-sub" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">下载该源歌曲时的目标音质</text>
              </view>
              <text class="scope-value" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">{{ row.downloadQualityLabel }}</text>
            </view>
            <view v-else class="scope-row scope-row-last">
              <view class="scope-main">
                <text class="scope-key" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">音源包已卸载</text>
                <text class="scope-sub" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">安装该源的音源包后恢复音质档位设置</text>
              </view>
            </view>
          </view>
        </qt-card>
      </view>
    </scroll-view>

    <!-- 扫码登录弹层 -->
    <qt-sheet :visible="qrVisible" :title="qrName + ' 扫码登录'" @close="closeQrSheet">
      <scroll-view direction="vertical" :show-scrollbar="false" :style="sheetBodyStyle">
        <text class="sheet-desc" :class="layout.isWide ? 'sheet-desc-wide' : ''" :style="('color:' + qrStatusColor + ';') + qtFontDual(23, 13)">{{ qrStatusText }}</text>
        <view class="qr-wrap" :class="layout.isWide ? 'qr-wrap-wide' : ''" :style="layout.isWide ? 'background-color:#ffffff;border-radius:10px;' : 'background-color:#ffffff;border-radius:16rpx;'">
          <image v-if="qrSrc.length > 0 && !qrImageError" class="qr-img" :class="layout.isWide ? (qrStatus == 'expired' ? 'qr-img-wide qr-img-expired' : 'qr-img-wide') : (qrStatus == 'expired' ? 'qr-img-expired' : '')" :src="qrSrc" mode="aspectFit" @error="onQrImageError" />
          <text v-if="qrImage.length > 0 && qrImageError" class="qr-fallback" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(21, 12)">二维码加载失败，可点「保存二维码」后在相册里查看</text>
        </view>
        <text class="qr-hint" :class="layout.isWide ? 'qr-hint-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(21, 12)">{{ qrHintText }}</text>
        <view class="sheet-btn-row" :class="layout.isWide ? 'sheet-btn-row-wide' : ''">
          <qt-button class="sheet-btn" label="取消" variant="ghost" size="sm" @click="closeQrSheet" />
          <qt-button v-if="qrImage.length > 0 && qrStatus != 'expired'" class="sheet-btn" label="保存二维码" variant="secondary" size="sm" @click="saveQrImage" />
          <qt-button v-if="qrStatus == 'expired'" class="sheet-btn" label="重新生成" variant="secondary" size="sm" @click="regenerateQr" />
        </view>
      </scroll-view>
    </qt-sheet>

    <!-- 导入 Cookie 弹层 -->
    <qt-sheet :visible="cookieVisible" :title="cookieName + ' 导入 Cookie'" :dismissible="!cookieBusy" @close="closeCookieSheet">
      <scroll-view direction="vertical" :show-scrollbar="false" :style="sheetBodyStyle">
        <text class="sheet-desc" :class="layout.isWide ? 'sheet-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">粘贴已登录浏览器的 Cookie 串，会先经官方接口校验，无效不保存</text>
        <textarea
          class="cookie-input"
          :class="layout.isWide ? 'cookie-input-wide' : ''"
          :style="layout.isWide ? cookieInputStyleWide : cookieInputStyle"
          :value="cookieText"
          @input="onCookieInput"
          placeholder="粘贴 Cookie 内容"
          :placeholder-class="layout.isWide ? 'cookie-ph-wide' : 'cookie-ph'"
          :maxlength="8192"
        />
        <text v-if="cookieError.length > 0" class="sheet-error" :class="layout.isWide ? 'sheet-error-wide' : ''" :style="('color:' + theme.skin.danger + ';') + qtFontDual(22, 12)">{{ cookieError }}</text>
        <view class="sheet-btn-row" :class="layout.isWide ? 'sheet-btn-row-wide' : ''">
          <qt-button class="sheet-btn" label="取消" variant="ghost" size="sm" :disabled="cookieBusy" @click="closeCookieSheet" />
          <qt-button class="sheet-btn" label="校验并保存" variant="secondary" size="sm" :disabled="cookieBusy" @click="submitCookie" />
        </view>
      </scroll-view>
    </qt-sheet>
    <!-- 短信验证码登录弹层（v14 契约，目前酷我声明 "sms"） -->
    <qt-sheet :visible="smsVisible" :title="smsName + ' 短信登录'" :dismissible="!smsBusy && !smsSending" @close="closeSmsSheet">
      <scroll-view direction="vertical" :show-scrollbar="false" :style="sheetBodyStyle">
        <text class="sheet-desc" :class="layout.isWide ? 'sheet-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">先填手机号收验证码，再填验证码登录；成功后凭据直接保存到本机，下次打开即可用。</text>
        <input
          class="cookie-input"
          :class="layout.isWide ? 'cookie-input-wide' : ''"
          :style="layout.isWide ? cookieInputStyleWide : cookieInputStyle"
          :value="smsPhone"
          @input="onSmsPhoneInput"
          placeholder="手机号"
          :placeholder-class="layout.isWide ? 'cookie-ph-wide' : 'cookie-ph'"
          :maxlength="20"
        />
        <view class="sheet-btn-row" :class="layout.isWide ? 'sheet-btn-row-wide' : ''">
          <qt-button class="sheet-btn" :label="smsSending ? '发送中…' : (smsKey.length > 0 ? '重新发送' : '发送验证码')" variant="outline" size="sm" :disabled="smsSending" @click="sendSmsCode" />
        </view>
        <input
          class="cookie-input"
          :class="layout.isWide ? 'cookie-input-wide' : ''"
          :style="layout.isWide ? cookieInputStyleWide : cookieInputStyle"
          :value="smsCode"
          @input="onSmsCodeInput"
          placeholder="短信验证码"
          type="number"
          :placeholder-class="layout.isWide ? 'cookie-ph-wide' : 'cookie-ph'"
          :maxlength="8"
        />
        <text v-if="smsHint.length > 0" class="sheet-desc" :class="layout.isWide ? 'sheet-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">{{ smsHint }}</text>
        <text v-if="smsError.length > 0" class="sheet-error" :class="layout.isWide ? 'sheet-error-wide' : ''" :style="('color:' + theme.skin.danger + ';') + qtFontDual(22, 12)">{{ smsError }}</text>
        <view class="sheet-btn-row" :class="layout.isWide ? 'sheet-btn-row-wide' : ''">
          <qt-button class="sheet-btn" label="取消" variant="ghost" size="sm" :disabled="smsBusy || smsSending" @click="closeSmsSheet" />
          <qt-button class="sheet-btn" :label="smsBusy ? '登录中…' : '登录'" variant="secondary" size="sm" :disabled="smsBusy" @click="submitSms" />
        </view>
      </scroll-view>
    </qt-sheet>

    <!-- 账号密码登录弹层（v14 契约，酷我官方客户端形制） -->
    <qt-sheet :visible="pwdVisible" :title="pwdName + ' 密码登录'" :dismissible="!pwdBusy" @close="closePwdSheet">
      <scroll-view direction="vertical" :show-scrollbar="false" :style="sheetBodyStyle">
        <text class="sheet-desc" :class="layout.isWide ? 'sheet-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">用酷我官方客户端的账号密码登录（不是手机号验证码）；成功后凭据直接保存到本机。</text>
        <input
          class="cookie-input"
          :class="layout.isWide ? 'cookie-input-wide' : ''"
          :style="layout.isWide ? cookieInputStyleWide : cookieInputStyle"
          :value="pwdAccount"
          @input="onPwdAccountInput"
          placeholder="账号（手机号 / 邮箱）"
          :placeholder-class="layout.isWide ? 'cookie-ph-wide' : 'cookie-ph'"
          :maxlength="64"
        />
        <input
          class="cookie-input"
          :class="layout.isWide ? 'cookie-input-wide' : ''"
          :style="layout.isWide ? cookieInputStyleWide : cookieInputStyle"
          :value="pwdPassword"
          @input="onPwdPasswordInput"
          placeholder="密码"
          :password="true"
          :placeholder-class="layout.isWide ? 'cookie-ph-wide' : 'cookie-ph'"
          :maxlength="64"
        />
        <text v-if="pwdError.length > 0" class="sheet-error" :class="layout.isWide ? 'sheet-error-wide' : ''" :style="('color:' + theme.skin.danger + ';') + qtFontDual(22, 12)">{{ pwdError }}</text>
        <view class="sheet-btn-row" :class="layout.isWide ? 'sheet-btn-row-wide' : ''">
          <qt-button class="sheet-btn" label="取消" variant="ghost" size="sm" :disabled="pwdBusy" @click="closePwdSheet" />
          <qt-button class="sheet-btn" :label="pwdBusy ? '登录中…' : '登录'" variant="secondary" size="sm" :disabled="pwdBusy" @click="submitPwd" />
        </view>
      </scroll-view>
    </qt-sheet>

    <!-- 同步歌单弹层（v18）：勾选 = 收藏到本地「我的歌单」，取消勾选已收藏的 = 从本地移除，只改本地不碰平台侧 -->
    <qt-sheet :visible="syncVisible" :title="syncName + ' · 同步歌单'" :dismissible="!syncBusy" @close="closeSyncSheet">
      <view>
        <text class="sheet-desc" :class="layout.isWide ? 'sheet-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">拉取平台侧全部歌单并勾选想要的；取消勾选已收藏的会把它从本地移除，不影响平台侧。</text>
        <text v-if="syncLoading" class="sheet-desc" :class="layout.isWide ? 'sheet-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">正在获取平台侧歌单…</text>
        <view v-else-if="syncNeedMetaLogin" class="sync-gate" :class="layout.isWide ? 'sync-gate-wide' : ''" :style="gateBorderStyle">
          <text class="sync-gate-text" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">该账户已登录，但「数据请求使用登录态」是关闭的——读取平台侧歌单需要它把凭据交给数据请求。</text>
          <qt-button class="sync-gate-btn" :label="syncEnabling ? '开启中…' : '开启并重试'" variant="secondary" size="sm" :disabled="syncEnabling" @click="enableMetaAndRetry" />
        </view>
        <text v-else-if="syncError.length > 0" class="sheet-error" :class="layout.isWide ? 'sheet-error-wide' : ''" :style="('color:' + theme.skin.danger + ';') + qtFontDual(22, 12)">{{ syncError }}</text>
        <view v-else-if="syncRows.length == 0" class="sync-empty">
          <text class="empty-text" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 13)">平台侧没有歌单，或该账号还没建过 / 收藏过歌单。</text>
        </view>
        <view v-else class="sync-body">
          <view class="sync-head" @click="toggleSyncAll">
            <qt-checkbox :checked="syncAllChecked" :disabled="syncBusy" size="sm" @change="onSyncAllCheck" />
            <text class="sync-head-text" :style="('color:' + theme.skin.text + ';') + qtFontDual(24, 13)">全选 · 平台侧 {{ syncRows.length }} 个，已收藏 {{ syncFavoritedCount }} 个</text>
          </view>
          <scroll-view class="sync-list" direction="vertical" :show-scrollbar="false" :style="syncListStyle" :scroll-into-view="syncReveal.anchor.value">
            <view v-for="(row, i) in syncRows" :key="'sync-' + row.playlist.id" :id="syncReveal.itemId(i)" class="sync-row" :style="rowBorderStyle" @click="toggleSyncOne(i)">
              <qt-checkbox :checked="syncChecked[i]" :disabled="syncBusy" size="sm" @change="onSyncCheck(i, $event)" />
              <image v-if="row.playlist.picUrl.length > 0" class="sync-pic" :class="layout.isWide ? 'sync-pic-wide' : ''" :src="row.playlist.picUrl" mode="aspectFill" />
              <view v-else class="sync-pic" :class="layout.isWide ? 'sync-pic-wide' : ''" :style="'background-color:' + theme.skin.border + ';'">
                <text class="sync-pic-text" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(20, 11)">歌单</text>
              </view>
              <text class="sync-name" :style="('color:' + theme.skin.text + ';') + qtFontDual(24, 13)">{{ row.playlist.name }}</text>
              <text v-if="row.favorited" class="sync-faved" :style="('color:' + theme.skin.accent + ';') + qtFontDual(20, 11)">已收藏</text>
            </view>
          </scroll-view>
        </view>
        <view class="sheet-btn-row" :class="layout.isWide ? 'sheet-btn-row-wide' : ''">
          <qt-button class="sheet-btn" label="取消" variant="ghost" size="sm" :disabled="syncBusy" @click="closeSyncSheet" />
          <qt-button
            v-if="!syncLoading && !syncNeedMetaLogin && syncError.length == 0 && syncRows.length > 0"
            class="sheet-btn"
            :label="syncBusy ? '同步中…' : '应用更改（' + syncChangeCount + '）'"
            variant="secondary"
            size="sm"
            :disabled="syncBusy || syncChangeCount == 0"
            @click="applySync"
          />
        </view>
      </view>
    </qt-sheet>
    <!-- 按源音质下拉（v12）：选项 = 该源生效档位清单 -->
    <qt-action-sheet
      v-model:visible="qualitySheetVisible"
      :title="qualitySheetTitle"
      :actions="qualitySheetActions"
      :selected-index="qualitySheetSelectedIndex"
      @select="onQualitySheetSelect"
    />
  </qt-page-frame>
</template>
<script setup lang="ts">
import { computed, ref } from "vue";
import { onLoad, onShow, onUnload } from "@dcloudio/uni-app";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import QtCard from "@/uni_modules/qt-ui/components/qt-card/qt-card.uvue";
import QtButton from "@/uni_modules/qt-ui/components/qt-button/qt-button.uvue";
import QtCheckbox from "@/uni_modules/qt-ui/components/qt-checkbox/qt-checkbox.uvue";
import QtSwitch from "@/uni_modules/qt-ui/components/qt-switch/qt-switch.uvue";
import QtSheet from "@/uni_modules/qt-ui/components/qt-sheet/qt-sheet.uvue";
import { useQtSelectionReveal } from "@/uni_modules/qt-ui/composables/use-qt-selection-reveal";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtActionSheet from "@/uni_modules/qt-ui/components/qt-action-sheet/qt-action-sheet.uvue";
import type { SheetAction } from "@/uni_modules/qt-ui/components/qt-action-sheet/qt-action-sheet.uvue";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";
import { qtShowToast } from "@/services/toast";
import { qtConfirm } from "@/services/confirm";
import { useSourceRegistryStore } from "@/stores/source-registry";
import { usePlayerStore } from "@/stores/player";
import { useDownloadsStore } from "@/stores/downloads";
import {
  sourcePlayQualityOf,
  sourceDownloadQualityOf,
  setSourcePlayQuality,
  setSourceDownloadQuality,
} from "@/services/source-quality";
import {
  authQrCreate,
  authQrPoll,
  authImportCookie,
  authSendSms,
  authLoginByPhone,
  authLoginByPassword,
  authCheckUser,
  saveSourceAuthAccount,
  removeSourceAuthAccount,
  readSourceAuthEntries,
  readSourceAuthTogglesFor,
  setSourceAuthToggle,
  mergeCredentialExtras,
  type SourceAuthEntry,
  type SourceAccountPlaylist,
  type SourceAuthLogin,
} from "@/services/source-auth";
import {
  accountSyncPreview,
  collectAccountPlaylists,
  uncollectAccountPlaylists,
  autoSyncMissingAfterLogin,
  type AccountSyncRow,
} from "@/services/source-playlist-sync";
import { isHarmonyOs, saveImageToGallery } from "@/services/app-native";
import { WEB_LOGIN_DONE_EVENT } from "@/services/source-web-login";

/**
 * 音源账号登录页（v9 数据包契约）：账号列表 + 数据/播放两面登录态开关 +
 * 扫码/Cookie 两种登录方式。状态在非响应式的 service（uni storage）里，
 * 用 refreshTick 触发重算（音源包管理页同一套路）；storage 变化经
 * SOURCE_AUTH_CHANGED_EVENT 广播对账。
 * v10：播放面登录态生效时官方档位清单生效（音质选择整体切官方档位，切换
 * 逻辑在 stores/source-registry），本页不再有「官方线路音质」配置卡。
 */
const theme = useThemeStore();
const layout = useQtLayout();
const registry = useSourceRegistryStore();

const refreshTick = ref(0);
/** 校验中判失效的源 id（authCheckUser 返回 null 时加入；重新登录后移除） */
const staleIds = ref<string[]>([]);
/** 进页只做一次凭据有效性校验（网络请求，不跟随 onShow 反复打） */
let didValidate = false;

const player = usePlayerStore();
const downloads = useDownloadsStore();

/**
 * 每源一张卡片（对齐 qt-pc 2026-10-25/10-27 版式）：登录、两面登录态开关与
 * 播放/下载音质全部按源独立；卡片默认折叠，点标题行展开，右上角一键全折/全展。
 * 卡片清单 = 注册表全部源（无 auth 的源如 migu 也有卡，只是没有登录行）；
 * 库里还存着凭据但注册表已没有的源补一张「残留卡」（音源包已卸载，只展示
 * 账号与退出——否则用户只看到一个内部 id 不知道是什么）。
 */
type SourceCardRow = {
  id: string;
  name: string;
  orphan: boolean;
  logged: boolean;
  stale: boolean;
  nickname: string;
  qr: boolean;
  cookie: boolean;
  web: boolean;
  sms: boolean;
  pwd: boolean;
  useMeta: boolean;
  usePlay: boolean;
  playQualityLabel: string;
  downloadQualityLabel: string;
};
function findEntry(entries: SourceAuthEntry[], source: string): SourceAuthEntry | null {
  for (let i = 0; i < entries.length; i++) {
    if (entries[i].source == source) return entries[i];
  }
  return null;
}
/**
 * 未登录源动作区（单行横向滚动）的轨道宽度。
 * 原生 scroll-view 不会按内容撑开（同 design.md 听歌报告页那条教训）：不给显式宽度时
 * 轨道宽度退化成 0/容器宽，按钮被卡片右缘裁掉且滑不动 —— 2026-10-31 真机即此现象
 * （用户「这个我要的是左右滚动，不是换行」）。每颗 qt-button size="sm" 按 220rpx 估，
 * 已含 26rpx 左右内边距与 16rpx 间距（最长的「导入 Cookie」也放得下）。
 */
function accTrackWidth(row: SourceCardRow): string {
  let count = 0;
  if (row.qr) count++;
  if (row.cookie) count++;
  if (row.sms) count++;
  if (row.pwd) count++;
  if (row.web) count++;
  if (count == 0) return "0px";
  const px = layout.isWide
    ? count * 190 + 16
    : Math.round(((count * 220 + 16) / 750) * layout.windowWidth * 100) / 100;
  return String(px) + "px";
}
/** 音质档位展示名：优先该源生效清单（官方/包声明）里的名字，找不到用裸值 */
function qualityLabelOf(id: string, quality: string): string {
  if (quality.length == 0) return quality;
  const list = registry.sourceQualities(id);
  for (let i = 0; i < list.length; i++) {
    if (list[i].id == quality) return list[i].name;
  }
  return quality;
}
const sourceCards = computed((): SourceCardRow[] => {
  void refreshTick.value;
  const entries = readSourceAuthEntries();
  const out: SourceCardRow[] = [];
  const sources = registry.sources;
  for (let i = 0; i < sources.length; i++) {
    const s = sources[i];
    const entry = findEntry(entries, s.id);
    const tg = readSourceAuthTogglesFor(s.id);
    const auth = s.auth;
    out.push({
      id: s.id,
      name: s.name,
      orphan: false,
      logged: entry != null,
      stale: staleIds.value.indexOf(s.id) >= 0,
      nickname: entry != null ? entry.account.user.nickname : "",
      qr: auth != null && auth.methods.indexOf("qrcode") >= 0,
      cookie: auth != null && auth.methods.indexOf("cookie") >= 0,
      web: auth != null && auth.webLogin != null && !isHarmonyOs(),
      // 短信/密码登录（v14 契约，目前只有酷我声明）：按 auth.methods 显隐
      sms: auth != null && auth.methods.indexOf("sms") >= 0,
      pwd: auth != null && auth.methods.indexOf("password") >= 0,
      // 数据面开关缺省常开（与是否登录无关）：登录与否只影响它能不能点，不影响展示值
      useMeta: tg.useMeta,
      usePlay: entry != null && tg.usePlay,
      // 播放音质缺省跟随该源的下载音质（下载缺省 = 音源第二档），两者口径一致
      playQualityLabel: qualityLabelOf(s.id, sourcePlayQualityOf(s.id, sourceDownloadQualityOf(s.id, downloads.downloadQuality))),
      downloadQualityLabel: qualityLabelOf(s.id, sourceDownloadQualityOf(s.id, downloads.downloadQuality)),
    });
  }
  for (let i = 0; i < entries.length; i++) {
    const e = entries[i];
    if (registry.has(e.source)) continue;
    const tg = readSourceAuthTogglesFor(e.source);
    out.push({
      id: e.source,
      name: e.source,
      orphan: true,
      logged: true,
      stale: staleIds.value.indexOf(e.source) >= 0,
      nickname: e.account.user.nickname,
      qr: false,
      cookie: false,
      web: false,
      sms: false,
      pwd: false,
      useMeta: tg.useMeta,
      usePlay: tg.usePlay,
      playQualityLabel: "",
      downloadQualityLabel: "",
    });
  }
  return out;
});
const authEmptyText = computed((): string => {
  void refreshTick.value;
  if (!registry.ready) return "注册表尚未就绪：请稍候或到「设置 → 音源包管理」确认已安装数据包。";
  return "当前数据包没有可用音源，安装数据包后这里会出现各音源的卡片。";
});

// ── 卡片展开/收起（内存态：重进页面回到默认全折叠，PC 同款）──
const expandedIds = ref<string[]>([]);
function isCardExpanded(id: string): boolean {
  return expandedIds.value.indexOf(id) >= 0;
}
function toggleCard(id: string): void {
  const next = expandedIds.value.slice(0);
  const idx = next.indexOf(id);
  if (idx >= 0) next.splice(idx, 1);
  else next.push(id);
  expandedIds.value = next;
}
const anyCardExpanded = computed((): boolean => expandedIds.value.length > 0);
function toggleAllCards(): void {
  if (anyCardExpanded.value) {
    expandedIds.value = [];
    return;
  }
  const all: string[] = [];
  const cards = sourceCards.value;
  for (let i = 0; i < cards.length; i++) all.push(cards[i].id);
  expandedIds.value = all;
}

// ── 按源两面登录态开关 ──
function toggleCardScope(row: SourceCardRow, scope: "meta" | "play"): void {
  if (!row.logged) {
    qtShowToast({ title: "先登录该音源，再开关登录态", icon: "none" });
    return;
  }
  const on = scope == "meta" ? !row.useMeta : !row.usePlay;
  setSourceAuthToggle(row.id, scope, on)
    .then(() => {
      refreshFromStorage();
    })
    .catch((e) => {
      qtShowToast({ title: "开关失败：" + errText(e), icon: "none" });
    });
}

// ── 按源音质（v12）：下拉弹层，选项 = 该源生效档位清单（官方/包声明）──
const qualitySheetVisible = ref(false);
const qualitySheetTitle = ref("");
const qualitySheetActions = ref<SheetAction[]>([]);
const qualitySheetIds = ref<string[]>([]);
const qualitySheetSelectedIndex = ref(-1);
const qualitySheetSource = ref("");
const qualitySheetKind = ref("play");
function showQualitySheet(id: string, name: string, kind: string): void {
  const isPlay = kind == "play";
  const downloadDefault = sourceDownloadQualityOf(id, downloads.downloadQuality);
  const current = isPlay ? sourcePlayQualityOf(id, downloadDefault) : downloadDefault;
  const list = registry.sourceQualities(id);
  const actions: SheetAction[] = [];
  const ids: string[] = [];
  let found = false;
  for (let i = 0; i < list.length; i++) {
    const isCurrent = list[i].id == current;
    if (isCurrent) found = true;
    actions.push({ name: list[i].name });
    ids.push(list[i].id);
  }
  // 落库值不在该源档位清单里（换包/换清单）时保留展示，避免下拉与实际不符（PC 同款）
  if (!found && current.length > 0) {
    actions.unshift({ name: qualityLabelOf(id, current) });
    ids.unshift(current);
  }
  if (actions.length == 0) {
    qtShowToast({ title: "该源没有可用音质档位，请先安装/更新音源包", icon: "none" });
    return;
  }
  qualitySheetTitle.value = name + " · " + (isPlay ? "播放音质" : "下载音质");
  qualitySheetActions.value = actions;
  qualitySheetIds.value = ids;
  qualitySheetSelectedIndex.value = ids.indexOf(current);
  qualitySheetSource.value = id;
  qualitySheetKind.value = kind;
  qualitySheetVisible.value = true;
}
function onQualitySheetSelect(_action: SheetAction, index: number): void {
  const ids = qualitySheetIds.value;
  const source = qualitySheetSource.value;
  if (source.length == 0 || index < 0 || index >= ids.length) return;
  const q = ids[index];
  const isPlay = qualitySheetKind.value == "play";
  const ok = isPlay ? setSourcePlayQuality(source, q) : setSourceDownloadQuality(source, q);
  if (!ok) {
    qtShowToast({ title: "非法的音质设置", icon: "none" });
    return;
  }
  refreshTick.value++;
}

// ── 扫码登录 ──
const qrVisible = ref(false);
const qrBusy = ref(false);
const qrSource = ref("");
const qrName = ref("");
const qrKey = ref("");
const qrImage = ref("");
/** qrImage（base64 data URL）落盘后的绝对路径：<image> 优先吃路径，见 qrImageToPath */
const qrFilePath = ref("");
/** 实际绑定给 <image> 的 src：先 file:// 再裸路径再 data URL，三级自动降级 */
const qrSrc = ref("");
/** 三级都加载失败时的兜底提示（此时仍可从「保存二维码」进相册看） */
const qrImageError = ref(false);
/** waiting / scanned / expired */
const qrStatus = ref("waiting");
let pollTimer: number | null = null;

const qrStatusText = computed((): string => {
  if (qrStatus.value == "scanned") return "已扫码，请在手机上确认";
  if (qrStatus.value == "expired") return "二维码已过期，可重新生成";
  return "打开官方 App 扫码登录";
});
const qrStatusColor = computed((): string => {
  if (qrStatus.value == "scanned") return theme.skin.accent;
  if (qrStatus.value == "expired") return theme.skin.danger;
  return theme.skin.textMuted;
});

/**
 * 扫码提示（v16 契约 auth.qrHint 下发）：QQ 的 ptlogin 码只认手机 QQ 的扫一扫
 * （QQ 音乐 App 扫不了，2026-10-25 用户实测「是让你下载QQ」）。
 * 本机没有第二台设备时，「自己扫自己」不可能，所以补一条同机用法：
 * 先把码存进相册，再用目标 App 的「扫一扫 → 相册」选中它。
 */
const qrHint = ref("");
const qrHintText = computed((): string => {
  const base = qrHint.value.length > 0 ? qrHint.value : "用官方 App 扫一扫";
  return base + "；没有第二台设备时点「保存二维码」，再在该 App 的「扫一扫 → 相册」里选这张图确认";
});

/** 找该源的 qrHint（数据包自述；找不到返回空串，按通用文案） */
function qrHintOf(id: string): string {
  const list = registry.sources;
  for (let i = 0; i < list.length; i++) {
    if (list[i].id != id) continue;
    const caps = list[i].auth;
    if (caps == null) return "";
    const hint = caps.qrHint;
    if (hint == null || hint.length == 0) return "";
    return hint;
  }
  return "";
}

/**
 * 保存二维码到相册：接口给的是 `data:image/png;base64,...`，先按 base64 落成
 * 缓存目录里的 png（FileSystemManager.writeFileSync 的 encoding 支持 base64），
 * 再交给 saveImageToPhotosAlbum 进相册系统。
 */
function saveQrImage(): void {
  // 展示用的那份文件已经是 PNG，直接进相册；没有时再临时解码一次
  let path = qrFilePath.value;
  if (path.length == 0) {
    path = qrImageToPath(qrImage.value);
  }
  if (path.length == 0) {
    qtShowToast({ title: "当前二维码无法保存，请重新生成", icon: "none" });
    return;
  }
  saveImageToGallery(path, "qt-qr-" + Date.now() + ".png").then((saved: string) => {
    if (saved.length > 0) {
      qtShowToast({ title: "已保存到相册：打开手机QQ 的扫一扫 → 相册，选这张图即可确认", icon: "none", duration: 4000 });
    } else {
      qtShowToast({ title: "保存失败，请检查存储空间后重试", icon: "none", duration: 3000 });
    }
  });
}

/** data URL 前缀（各源扫码接口统一返回 PNG base64） */
const QR_IMG_HEAD = "data:image/png;base64,";

/**
 * 把 base64 data URL 落成本地 png，返回文件路径。
 * 安卓真机上 `<image>` 直接吃 data URL 渲染成白框（2026-10-31 用户实测弹层里没有二维码），
 * 落文件按路径加载才可靠；这份文件同时给「保存二维码」复用，不必二次解码。
 */
function qrImageToPath(dataUrl: string): string {
  if (dataUrl.indexOf(QR_IMG_HEAD) != 0) return "";
  const path = uni.env.CACHE_PATH + "/qt-qr-" + Date.now().toString() + ".png";
  try {
    uni.getFileSystemManager().writeFileSync(path, dataUrl.substring(QR_IMG_HEAD.length), "base64");
    return path;
  } catch (e) {
    qtShowToast({ title: "二维码写入文件失败：" + errText(e), icon: "none" });
    return "";
  }
}

function startQr(source: string, name: string): void {
  if (qrBusy.value) return;
  qrBusy.value = true;
  authQrCreate(source)
    .then((session) => {
      qrSource.value = source;
      qrName.value = name;
      qrKey.value = session.key;
      qrImage.value = session.image;
      const qrPath = qrImageToPath(session.image);
      qrFilePath.value = qrPath;
      // 安卓真机：data URL 曾经因宿主没实现 responseEncoding 而是一张坏图；现在
      // 优先落文件路径（本地相册/壁纸同款），失败再 file:// 再回退 data URL
      qrSrc.value = qrPath.length > 0 ? qrPath : session.image;
      qrImageError.value = false;
      qrHint.value = qrHintOf(source);
      qrStatus.value = "waiting";
      qrVisible.value = true;
      startPolling();
    })
    .catch((e) => {
      qtShowToast({ title: "创建二维码失败：" + errText(e), icon: "none" });
    })
    .finally(() => {
      qrBusy.value = false;
    });
}
function regenerateQr(): void {
  const source = qrSource.value;
  const name = qrName.value;
  stopPolling();
  qrVisible.value = false;
  startQr(source, name);
}
function startPolling(): void {
  stopPolling();
  pollTimer = setInterval(() => {
    void pollOnce();
  }, 2000) as unknown as number;
}
function stopPolling(): void {
  if (pollTimer != null) {
    clearInterval(pollTimer);
    pollTimer = null;
  }
}
function pollOnce(): void {
  const source = qrSource.value;
  const key = qrKey.value;
  authQrPoll(source, key)
    .then((r) => {
      if (r.status == "confirmed") {
        stopPolling();
        const user = r.user;
        if (user == null || r.cookie.length == 0) {
          qrStatus.value = "expired";
          return;
        }
        const nickname = user.nickname;
        // confirmed 时随 credential 下发的副键（bili refresh_token）并入 extras 落库
        let extrasJson = "";
        if (r.refreshToken.length > 0) {
          const extras = new UTSJSONObject();
          extras.set("refresh_token", r.refreshToken);
          extrasJson = JSON.stringify(extras);
        }
        saveSourceAuthAccount(source, r.cookie, user, extrasJson)
          .then(() => {
            closeQrSheet();
            removeFromStale(source);
            refreshFromStorage();
            qtShowToast({ title: "已登录：" + nickname, icon: "none" });
            // 登录顺手看一眼平台侧歌单：有本地没有的就提示同步（qrName 不随弹层关闭清空）
            maybeAutoSync(source, qrName.value);
          })
          .catch((e) => {
            qtShowToast({ title: "保存登录失败：" + errText(e), icon: "none" });
          });
        return;
      }
      if (r.status == "expired") {
        stopPolling();
        qrStatus.value = "expired";
        return;
      }
      qrStatus.value = r.status;
    })
    .catch((e) => {
      // 确定性失败继续轮询没有意义（旧包缺入口/引擎下线），停下让用户重新生成；
      // 普通网络抖动保持轮询（下一次 2s 后自然重试）
      const message = errText(e);
      if (message.indexOf("版本过旧") >= 0 || message.indexOf("引擎未就绪") >= 0) {
        stopPolling();
        qrStatus.value = "expired";
        qtShowToast({ title: message, icon: "none" });
      }
    });
}
function closeQrSheet(): void {
  stopPolling();
  qrVisible.value = false;
  qrImage.value = "";
  qrFilePath.value = "";
  qrSrc.value = "";
  qrImageError.value = false;
  qrKey.value = "";
  qrSource.value = "";
}

/** 三级降级：file:// 路径 → 裸绝对路径 → data URL；都失败才显示兜底文案 */
function onQrImageError(): void {
  const src = qrSrc.value;
  if (src.indexOf("file://") == 0 && qrFilePath.value.length > 0) {
    qrSrc.value = qrFilePath.value;
    return;
  }
  if (src != qrImage.value && qrImage.value.length > 0) {
    qrSrc.value = qrImage.value;
    return;
  }
  qrImageError.value = true;
}

// ── 导入 Cookie ──
const cookieVisible = ref(false);
const cookieBusy = ref(false);
const cookieSource = ref("");
const cookieName = ref("");
const cookieText = ref("");
const cookieError = ref("");

function openCookieSheet(source: string, name: string): void {
  cookieSource.value = source;
  cookieName.value = name;
  cookieText.value = "";
  cookieError.value = "";
  cookieVisible.value = true;
}
function onCookieInput(e: InputEvent): void {
  cookieText.value = String((e.detail as any).value ?? "");
}
function closeCookieSheet(): void {
  cookieVisible.value = false;
  cookieText.value = "";
  cookieError.value = "";
}
function submitCookie(): void {
  const source = cookieSource.value;
  const text = cookieText.value.trim();
  if (text.length == 0) {
    cookieError.value = "请粘贴 Cookie 内容";
    return;
  }
  cookieBusy.value = true;
  authImportCookie(source, text)
    .then((user) => {
      if (user == null) {
        cookieError.value = "Cookie 无效或已过期，请检查后重试";
        return;
      }
      const nickname = user.nickname;
      return saveSourceAuthAccount(source, text, user, "").then(() => {
        closeCookieSheet();
        removeFromStale(source);
        refreshFromStorage();
        qtShowToast({ title: "已导入登录：" + nickname, icon: "none" });
        // 与扫码登录同款：导入成功后自动提示同步平台侧歌单
        maybeAutoSync(source, cookieName.value);
      });
    })
    .catch((e) => {
      cookieError.value = "导入失败：" + errText(e);
    })
    .finally(() => {
      cookieBusy.value = false;
    });
}

// ── 短信验证码 / 密码登录（v14 契约，酷我）──
const smsVisible = ref(false);
const smsBusy = ref(false);
const smsSending = ref(false);
const smsSource = ref("");
const smsName = ref("");
const smsPhone = ref("");
const smsCode = ref("");
/** authSendSms 下发的一次性挑战 key（手机号/服务端 tm/设备身份打包），登录必须原样带回 */
const smsKey = ref("");
const smsHint = ref("");
const smsError = ref("");

const pwdVisible = ref(false);
const pwdBusy = ref(false);
const pwdSource = ref("");
const pwdName = ref("");
const pwdAccount = ref("");
const pwdPassword = ref("");
const pwdError = ref("");

/** 登录成功统一收尾：落库 + 清失效标记 + 刷新列表 + 提示 + 顺手看平台侧歌单 */
function saveLoginAndFinish(source: string, name: string, login: SourceAuthLogin, close: () => void): Promise<void> {
  let extrasJson = "";
  if (login.refreshToken.length > 0) {
    const extras = new UTSJSONObject();
    extras.set("refresh_token", login.refreshToken);
    extrasJson = JSON.stringify(extras);
  }
  return saveSourceAuthAccount(source, login.cookie, login.user, extrasJson).then(() => {
    close();
    removeFromStale(source);
    refreshFromStorage();
    qtShowToast({ title: "已登录：" + login.user.nickname, icon: "none" });
    maybeAutoSync(source, name);
  });
}

function openSmsSheet(source: string, name: string): void {
  smsSource.value = source;
  smsName.value = name;
  smsPhone.value = "";
  smsCode.value = "";
  smsKey.value = "";
  smsHint.value = "";
  smsError.value = "";
  smsVisible.value = true;
}
function onSmsPhoneInput(e: InputEvent): void {
  smsPhone.value = String((e.detail as any).value ?? "");
}
function onSmsCodeInput(e: InputEvent): void {
  smsCode.value = String((e.detail as any).value ?? "");
}
function closeSmsSheet(): void {
  smsVisible.value = false;
  smsCode.value = "";
  smsKey.value = "";
  smsHint.value = "";
  smsError.value = "";
}
function sendSmsCode(): void {
  const phone = smsPhone.value.trim();
  if (phone.length < 5) {
    smsError.value = "请填写手机号";
    return;
  }
  smsSending.value = true;
  smsError.value = "";
  authSendSms(smsSource.value, phone)
    .then((challenge) => {
      smsKey.value = challenge.key;
      smsHint.value = challenge.message.length > 0 ? challenge.message : "验证码已发送，请查收短信后填入";
    })
    .catch((e) => {
      smsError.value = "发送失败：" + errText(e);
    })
    .finally(() => {
      smsSending.value = false;
    });
}
function submitSms(): void {
  const code = smsCode.value.trim();
  if (smsKey.value.length == 0) {
    smsError.value = "请先点「发送验证码」";
    return;
  }
  if (code.length == 0) {
    smsError.value = "请填写短信验证码";
    return;
  }
  smsBusy.value = true;
  smsError.value = "";
  authLoginByPhone(smsSource.value, smsKey.value, code)
    .then((login) => saveLoginAndFinish(smsSource.value, smsName.value, login, closeSmsSheet))
    .catch((e) => {
      smsError.value = "登录失败：" + errText(e);
    })
    .finally(() => {
      smsBusy.value = false;
    });
}

function openPwdSheet(source: string, name: string): void {
  pwdSource.value = source;
  pwdName.value = name;
  pwdAccount.value = "";
  pwdPassword.value = "";
  pwdError.value = "";
  pwdVisible.value = true;
}
function onPwdAccountInput(e: InputEvent): void {
  pwdAccount.value = String((e.detail as any).value ?? "");
}
function onPwdPasswordInput(e: InputEvent): void {
  pwdPassword.value = String((e.detail as any).value ?? "");
}
function closePwdSheet(): void {
  pwdVisible.value = false;
  pwdPassword.value = "";
  pwdError.value = "";
}
function submitPwd(): void {
  const account = pwdAccount.value.trim();
  const password = pwdPassword.value;
  if (account.length == 0) {
    pwdError.value = "请填写账号";
    return;
  }
  if (password.length == 0) {
    pwdError.value = "请填写密码";
    return;
  }
  pwdBusy.value = true;
  pwdError.value = "";
  authLoginByPassword(pwdSource.value, account, password)
    .then((login) => saveLoginAndFinish(pwdSource.value, pwdName.value, login, closePwdSheet))
    .catch((e) => {
      pwdError.value = "登录失败：" + errText(e);
    })
    .finally(() => {
      pwdBusy.value = false;
    });
}

// ── 退出登录 ──
function logout(source: string, name: string): void {
  qtConfirm({ title: "退出登录", content: "退出 " + name + " 的登录？已保存的凭据将从本机删除。", danger: true }).then((ok) => {
    if (!ok) return;
    removeSourceAuthAccount(source)
      .then(() => {
        removeFromStale(source);
        refreshFromStorage();
        qtShowToast({ title: "已退出 " + name + " 登录", icon: "none" });
      })
      .catch((e) => {
        qtShowToast({ title: "退出失败：" + errText(e), icon: "none" });
      });
  });
}

// ── 同步歌单（v18：平台侧清单 vs 本地「我的歌单」对账）──
const syncVisible = ref(false);
const syncLoading = ref(false);
const syncEnabling = ref(false);
const syncBusy = ref(false);
const syncNeedMetaLogin = ref(false);
const syncError = ref("");
const syncSource = ref("");
const syncName = ref("");
const syncRows = ref<AccountSyncRow[]>([]);
/** 勾选态，与 syncRows 同序：true = 希望它出现在本地「我的歌单」里 */
const syncChecked = ref<boolean[]>([]);
// 预览默认全勾，只在开层/异步清单或窗口变化时 reveal，用户勾选不触发滚动。
const syncReveal = useQtSelectionReveal(() => syncVisible.value, () => syncRows.value.length > 0 ? 0 : -1, () => syncRows.value.map((row) => row.playlist.id).join('|'));
/** 预览请求序号：一键开启重试 / 关闭弹层时丢弃在途应答 */
let syncLoadSeq = 0;

const syncFavoritedCount = computed((): number => {
  const rows = syncRows.value;
  let n = 0;
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].favorited) n += 1;
  }
  return n;
});
/** 待执行变更数：勾且未收藏（待收藏）+ 未勾且已收藏（待移除） */
const syncChangeCount = computed((): number => {
  const rows = syncRows.value;
  const checked = syncChecked.value;
  let n = 0;
  for (let i = 0; i < rows.length && i < checked.length; i++) {
    if (checked[i] != rows[i].favorited) n += 1;
  }
  return n;
});
const syncAllChecked = computed((): boolean => {
  const checked = syncChecked.value;
  if (checked.length == 0) return false;
  for (let i = 0; i < checked.length; i++) {
    if (!checked[i]) return false;
  }
  return true;
});

/** 打开即预览（账号行按钮 / 登录后自动提示都走这里） */
function openSync(source: string, name: string): void {
  syncSource.value = source;
  syncName.value = name;
  syncVisible.value = true;
  loadSync();
}
function loadSync(): void {
  const seq = ++syncLoadSeq;
  syncLoading.value = true;
  syncError.value = "";
  syncNeedMetaLogin.value = false;
  syncRows.value = [];
  syncChecked.value = [];
  accountSyncPreview(syncSource.value)
    .then((p) => {
      if (seq != syncLoadSeq) return; // 已重发或已关闭，丢弃过期应答
      syncLoading.value = false;
      if (p.needMetaLogin) {
        syncNeedMetaLogin.value = true;
        return;
      }
      if (!p.ok) {
        syncError.value = p.message.length > 0 ? p.message : "获取平台侧歌单失败，请稍后重试";
        return;
      }
      syncRows.value = p.rows;
      // 默认全勾（PC 同款）：勾选 = 希望它在本地，已有的自然不变
      const checked: boolean[] = [];
      for (let i = 0; i < p.rows.length; i++) checked.push(true);
      syncChecked.value = checked;
    })
    .catch((e) => {
      if (seq != syncLoadSeq) return;
      syncLoading.value = false;
      syncError.value = errText(e);
    });
}
function closeSyncSheet(): void {
  if (syncBusy.value) return;
  syncVisible.value = false;
  syncLoadSeq++; // 在途预览应答自然作废
  syncRows.value = [];
  syncChecked.value = [];
  syncError.value = "";
  syncNeedMetaLogin.value = false;
}
/** needMetaLogin 面板的一键开启：开「数据请求使用登录态」后重试预览 */
function enableMetaAndRetry(): void {
  if (syncEnabling.value) return;
  syncEnabling.value = true;
  setSourceAuthToggle(syncSource.value, "meta", true)
    .then(() => {
      syncEnabling.value = false;
      refreshFromStorage();
      loadSync();
    })
    .catch((e) => {
      syncEnabling.value = false;
      qtShowToast({ title: "开启失败：" + errText(e), icon: "none" });
    });
}
function setSyncCheckedAt(i: number, value: boolean): void {
  if (syncBusy.value) return;
  const next = syncChecked.value.slice(0);
  next[i] = value;
  syncChecked.value = next;
}
/** 整行点击翻转勾选（勾选框本体被 qt-checkbox 内部 @click.stop，不会双触发） */
function toggleSyncOne(i: number): void {
  const checked = syncChecked.value;
  if (i < 0 || i >= checked.length) return;
  setSyncCheckedAt(i, !checked[i]);
}
/** 勾选框自身的 change（$event 是它翻转后的目标态） */
function onSyncCheck(i: number, value: boolean): void {
  if (i < 0 || i >= syncChecked.value.length) return;
  setSyncCheckedAt(i, value);
}
function toggleSyncAll(): void {
  if (syncBusy.value) return;
  const nextAll = !syncAllChecked.value;
  const next: boolean[] = [];
  const rows = syncRows.value;
  for (let i = 0; i < rows.length; i++) next.push(nextAll);
  syncChecked.value = next;
}
function onSyncAllCheck(value: boolean): void {
  if (syncBusy.value) return;
  const next: boolean[] = [];
  const rows = syncRows.value;
  for (let i = 0; i < rows.length; i++) next.push(value);
  syncChecked.value = next;
}
/** 应用更改：待收藏 / 待移除两批顺序执行，toast 汇总（部分成功是正常结果） */
function applySync(): void {
  if (syncBusy.value) return;
  const rows = syncRows.value;
  const checked = syncChecked.value;
  const toCollect: SourceAccountPlaylist[] = [];
  const toRemove: SourceAccountPlaylist[] = [];
  for (let i = 0; i < rows.length && i < checked.length; i++) {
    if (checked[i] && !rows[i].favorited) toCollect.push(rows[i].playlist);
    if (!checked[i] && rows[i].favorited) toRemove.push(rows[i].playlist);
  }
  if (toCollect.length == 0 && toRemove.length == 0) return;
  const source = syncSource.value;
  syncBusy.value = true;
  const parts: string[] = [];
  let failed = 0;
  collectAccountPlaylists(source, toCollect)
    .then((r) => {
      failed += r.failed;
      if (r.changed > 0) parts.push("已收藏 " + r.changed + " 个");
      return uncollectAccountPlaylists(source, toRemove);
    })
    .then((r) => {
      failed += r.failed;
      if (r.changed > 0) parts.push("已取消收藏 " + r.changed + " 个");
      syncBusy.value = false;
      const summary = parts.length > 0 ? parts.join("，") + "歌单" : "没有变化";
      if (failed > 0) qtShowToast({ title: summary + "，" + failed + " 个失败可稍后重试", icon: "none" });
      else qtShowToast({ title: summary, icon: "none" });
      closeSyncSheet();
    })
    .catch((e) => {
      syncBusy.value = false;
      qtShowToast({ title: "同步失败：" + errText(e), icon: "none" });
    });
}
/** 登录成功后的自动同步：平台侧有本地没有的歌单 → 直接打开同步弹层。
 *  预览失败一律静默（自动动作不干扰登录反馈），可从账号行手动重试。 */
function maybeAutoSync(source: string, name: string): void {
  autoSyncMissingAfterLogin(source)
    .then((missing) => {
      if (missing.length > 0) openSync(source, name);
    })
    .catch((_) => {
      // 静默：登录反馈优先
    });
}

// ── 网页登录（v17 契约，Android 先行；鸿蒙原生 Cookie 通道未接，不显示入口）──
function openWebLogin(source: string, name: string): void {
  void name;
  uni.navigateTo({ url: "/pages/web-login/index?source=" + source });
}
/** web-login 页登录落库后的回调：触发「登录即自动同步」（与扫码/Cookie 导入同款） */
function onWebLoginDone(payload: any): void {
  const source = payload as string;
  if (source == null || source.length == 0) return;
  refreshFromStorage();
  removeFromStale(source);
  maybeAutoSync(source, registry.label(source));
}

// ── 对账与校验 ──
function refreshFromStorage(): void {
  // v12 起没有全局开关：卡片里的开关/音质都在 sourceCards computed 里按源读取，
  // 这里只需 bump 重算信号
  refreshTick.value++;
}
function removeFromStale(source: string): void {
  const idx = staleIds.value.indexOf(source);
  if (idx >= 0) {
    const next = staleIds.value.slice(0);
    next.splice(idx, 1);
    staleIds.value = next;
  }
}
/** 进页一次性校验已存凭据：失效的标红提示重登（不自动清除，用户可能只是断网）；
 * 包侧轮换出新 cookie（QQ 短期 musickey 保活）时顺手落库——账号页是移动端
 * 最常见的校验窗口，这里补一刀等价于手动触发一轮后台保活。 */
function validateAccounts(): void {
  const entries = readSourceAuthEntries();
  for (let i = 0; i < entries.length; i++) {
    const e = entries[i];
    authCheckUser(e.source, e.account.cookie, e.account.extrasJson)
      .then((r) => {
        // 包侧轮换出新凭据：连同副键合并落库（引擎内存副本随保存同步注入）
        if (r.ok && r.credential.length > 0) {
          const user = r.user != null ? r.user : e.account.user;
          const extrasJson = mergeCredentialExtras(e.account.extrasJson, r.refreshToken);
          return saveSourceAuthAccount(e.source, r.credential, user, extrasJson).then(() => {
            refreshTick.value++;
          });
        }
        if (r.ok && r.user != null) return;
        if (staleIds.value.indexOf(e.source) < 0) {
          const next = staleIds.value.slice(0);
          next.push(e.source);
          staleIds.value = next;
          refreshTick.value++;
        }
      })
      .catch((_) => {
        // 校验失败（断网/引擎未就绪）不动失效标记：宁可漏报也不误报
      });
  }
}
function errText(e: any | null): string {
  const message = e instanceof Error ? e.message : String(e);
  // 引擎/包错误文本可能带整段 URL，截断到可用长度（与全仓日志口径一致）
  return message.length > 120 ? message.slice(0, 120) : message;
}

onShow(() => {
  registry.ensure();
  refreshFromStorage();
  if (!didValidate) {
    didValidate = true;
    validateAccounts();
  }
});
onLoad(() => {
  uni.$on(WEB_LOGIN_DONE_EVENT, onWebLoginDone);
});
onUnload(() => {
  stopPolling();
  uni.$off(WEB_LOGIN_DONE_EVENT, onWebLoginDone);
});

// ── 样式常量（对齐音源包管理页的弹层口径）──
const rowBorderStyle = computed<string>(() => "border-bottom-color:" + theme.skin.divider + ";");
const gateBorderStyle = computed<string>(() => "border-color:" + theme.skin.divider + ";");
const sheetBodyStyle = computed<string>(() => 'max-height:' + Math.max(120, Math.floor(layout.windowHeight * 0.86) - layout.safeBottomPx - (layout.isWide ? 110 : 132)) + 'px;');
const syncListStyle = computed<string>(() => 'height:' + Math.max(80, Math.min(layout.isWide ? 320 : 240, Math.floor(layout.windowHeight * 0.86) - layout.safeBottomPx - (layout.isWide ? 220 : 260))) + 'px;');
const cookieInputStyle = computed<string>(() => "background-color:" + theme.skin.surfaceInset + ";color:" + theme.skin.text + ";border-radius:14rpx;");
const cookieInputStyleWide = computed<string>(() => "background-color:" + theme.skin.surfaceInset + ";color:" + theme.skin.text + ";border-radius:8px;");
</script>

