  border-bottom-style: solid;
}
/* 未登录源的动作区：单行横向滚动（放不下时左右滑，不换行）。
   高度必须容下 qt-button size="sm"（紧凑 88rpx / 宽屏 44px），否则按钮被裁。 */
.acc-scroll {
