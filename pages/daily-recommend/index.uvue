.search-input { flex: 1; min-width: 0; height: 68rpx; font-size: 26rpx; }
.search-input-wide { height: 34px; font-size: 14px; }
.search-clear { width: 44rpx; height: 44rpx; align-items: center; justify-content: center; }
.search-clear-wide { width: 24px; height: 24px; }
.search-ph { color: #9aa0ad; font-size: 26rpx; }
.search-ph-wide { color: #9aa0ad; font-size: 14px; }
.scroll { flex: 1; min-width: 0; min-height: 0; }
.hero-item { padding: 0; }
/* 竖屏 hero 与歌单详情（pages/playlist .hero）完全同款 */
.hero { padding: 40rpx 32rpx; flex-direction: row; border-width: 1px; border-style: solid; border-radius: 24rpx; }
.cover { width: 200rpx; height: 200rpx; border-radius: 20rpx; background-color: rgba(255, 255, 255, 0.2); }
.hero-info { flex: 1; margin-left: 26rpx; justify-content: center; }
.hsk-l2 { margin-top: 12rpx; }
.hsk-l3 { margin-top: 10rpx; }
.title { }
.desc { margin-top: 10rpx; }
.playcount { margin-top: 8rpx; }
.hero-tastes { margin-top: 14rpx; flex-direction: row; }
.style-item { padding: 20rpx 24rpx 0; }
.style-item-wide { padding: 12px 16px 0; }
.style-card { padding: 26rpx; border-width: 1px; border-style: solid; border-radius: 24rpx; flex-direction: column; }
.style-card-wide { padding: 14px; border-radius: 14px; }
.style-title { }
.style-title-wide { }
.style-hint { margin-top: 8rpx; }
.style-hint-wide { margin-top: 4px; }
.style-chips { margin-top: 18rpx; flex-direction: row; flex-wrap: wrap; }
.style-chip { margin: 0 12rpx 12rpx 0; padding: 8rpx 22rpx; border-width: 1px; border-style: solid; border-radius: 26rpx; }
