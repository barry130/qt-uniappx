.whero-play { height: 44px; border-radius: 22px; flex-direction: row; align-items: center; justify-content: center; }
.whero-play-text { margin-left: 6px; }
.whero-acts { margin-top: 10px; flex-direction: row; }
.whero-act { flex: 1; height: 40px; border-width: 1px; border-style: solid; border-radius: 20px; flex-direction: row; align-items: center; justify-content: center; }
.whero-act-gap { margin-left: 10px; }
.whero-act-text { margin-left: 6px; }
.whero-tools { margin-top: 10px; flex-direction: row; justify-content: flex-end; }
.whero-tool { width: 40px; height: 40px; border-width: 1px; border-style: solid; border-radius: 20px; align-items: center; justify-content: center; }
.whero-tool-gap { margin-left: 10px; }
/* 列表顶搜索行（宽屏，点左栏搜索图标后出现）——与 pages/daily 同款 */
.search-item { padding: 20rpx 24rpx 0; }
.search-row { width: 100%; }
.search-row-wide { width: 100%; }
.search-field { flex-direction: row; align-items: center; height: 72rpx; border-radius: 36rpx; border-width: 1px; border-style: solid; padding: 0 24rpx; }
