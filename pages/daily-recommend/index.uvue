<template>
  <!-- 每日推荐（智能推荐页，2026-10-24 移植自 qt-pc DailyRecommendPage）：
       三种引擎模式（纯规则 / 本地模型精选 / 服务端 AI，全局于音乐助手共用，见 services/ai-mode.ts），
       三种口味（心动 / 常听 / 探索）与模式正交。列表默认按推荐顺序渲染（含开场、沉浸、
       收束的编排），排序与搜索为纯前端能力（同歌单详情/每日新歌：标题栏搜索 + 三点排序）。
       骨架 / hero / 吸顶操作条与 pages/daily 同一套模板（详情页一套模板）。 -->
  <qt-page-frame
    width-kind="detail"
    title="每日推荐"
    :header-actions="headerActions"
    :header-title-visible="titleVisible"
    :header-searching="searchOpen"
    :header-search-value="searchQuery"
    header-search-placeholder="搜索标题 / 歌手 / 专辑"
    @headerAction="onHeaderAction"
    @headerSearchInput="onHeaderSearchInput"
    @headerSearchClose="closeSearch"
  >
  <view class="page" :class="[layout.isWide ? 'page-wide' : '', detailSplit ? 'page-split' : '']"
    >
    <!-- 宽屏左栏：封面 + 元信息 + 口味/模式操作（与歌单详情 / 每日新歌同一套主从双栏） -->
    <scroll-view v-if="detailSplit" class="wide-left" :style="wideAsideStyle" direction="vertical" :show-scrollbar="false">
      <view class="whero" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';'">
        <view class="whero-art">
          <QtSkeleton v-if="loading" tone="cover" :width="wideCoverPx" :height="wideCoverPx" radius="12px" />
          <image v-else class="whero-cover" :style="wideCoverStyle" :src="displayPicUrl" mode="aspectFill" />
        </view>
        <template v-if="loading">
          <view class="wsk-l1"><QtSkeleton tone="line" width="160px" height="18px" radius="4px" /></view>
          <view class="wsk-l2"><QtSkeleton tone="line" :width="wideCoverPx" height="13px" radius="4px" /></view>
          <view class="wsk-l3"><QtSkeleton tone="line" :width="wideCoverPx" height="13px" radius="4px" /></view>
          <view class="wsk-l5"><QtSkeleton tone="block" :width="wideCoverPx" height="44px" radius="12px" /></view>
        </template>
        <template v-else>
          <text class="whero-meta" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontPx(12)" :max-lines="1">{{ metaLine }}</text>
          <text class="whero-title" :style="('color:' + themeStore.skin.text + ';') + qtFontPx(18)" :max-lines="2">{{ resultTitle }}</text>
          <text v-if="resultSummary.length > 0" class="whero-desc" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontPx(13)" :max-lines="2">{{ resultSummary }}</text>
          <!-- 口味切换：与模式正交，切换即重新生成（force） -->
          <view class="whero-tastes">
            <QtOption v-for="(t, ti) in DAILY_TASTE_ORDER" :key="'wt-' + ti" kind="chip" :label="DAILY_TASTE_LABEL[t]" :selected="taste == t" @select="pickTaste(t)" />
          </view>
          <view class="whero-actions">
            <qt-batch-bar
              v-if="selecting"
              layout="column"
              :count="selectedCount"
              :total="visibleSongs.length"
              @toggle="toggleSelectAll"
              @download="onBatchDownload"
              @collect="openBatchCollect"
              @cancel="exitSelect"
            />
            <template v-else>
              <QtButton label="播放全部" icon="play" size="sm" @click="playAll" />
              <view class="whero-secondary" :class="wideSecondaryStacked ? 'whero-secondary-stacked' : ''">
                <QtButton label="换一批" icon="refresh" size="sm" variant="ghost" @click="regenerate" />
                <QtButton label="推荐设置" icon="settings" size="sm" variant="ghost" @click="openModeSheet" />
              </view>
            </template>
          </view>
          <view v-if="laneChips.length > 0" class="whero-lanes">
            <view v-for="(lane, li) in laneChips" :key="'wl-' + li" class="lane-chip" :style="'background-color:' + themeStore.skin.surfaceMuted + ';border-color:' + themeStore.skin.border + ';'">
              <text class="lane-chip-text" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontPx(11)">{{ lane }}</text>
            </view>
          </view>
          <text v-if="resultProfileText.length > 0" class="whero-profile" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontPx(11)" :max-lines="2">{{ resultProfileText }}</text>
        </template>
      </view>
    </scroll-view>
    <list-view id="rc-scroll" class="scroll" direction="vertical" :scroll-top="scrollTop" @scroll="onListScroll">
      <!-- 竖屏 hero：同 .hero 外框，内部骨架/成品切换 -->
      <list-item v-if="!detailSplit" class="hero-item">
        <view class="hero" :class="layout.isWide ? 'hero-wide' : ''" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';'">
          <!-- 竖屏 hero 与歌单详情（pages/playlist）同款：方形封面 + 右侧信息区 -->
          <QtSkeleton v-if="loading" tone="cover" :width="layout.isWide ? '112px' : '200rpx'" :height="layout.isWide ? '112px' : '200rpx'" :radius="layout.isWide ? '12px' : '20rpx'" />
          <image v-else class="cover" :class="layout.isWide ? 'cover-wide' : ''" :src="displayPicUrl" mode="aspectFill" />
          <view class="hero-info" :class="layout.isWide ? 'hero-info-wide' : ''">
            <template v-if="loading">
              <QtSkeleton tone="line" :width="layout.isWide ? '140px' : '320rpx'" :height="layout.isWide ? '20px' : '34rpx'" :radius="layout.isWide ? '6px' : '10rpx'" />
              <view class="hsk-l2" :class="layout.isWide ? 'hsk-l2-wide' : ''"><QtSkeleton tone="line" :width="layout.isWide ? '128px' : '252rpx'" :height="layout.isWide ? '14px' : '22rpx'" /></view>
              <view class="hsk-l3" :class="layout.isWide ? 'hsk-l3-wide' : ''"><QtSkeleton tone="line" :width="layout.isWide ? '64px' : '120rpx'" :height="layout.isWide ? '13px' : '20rpx'" /></view>
            </template>
            <template v-else>
              <text class="title" :class="layout.isWide ? 'title-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(35, 20)" :max-lines="2">{{ resultTitle }}</text>
              <text class="desc" :class="layout.isWide ? 'desc-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(23, 14)" :max-lines="2">{{ resultSummary.length > 0 ? resultSummary : metaLine }}</text>
              <text class="playcount" :class="layout.isWide ? 'playcount-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 13)">{{ metaLine }}</text>
              <view class="hero-tastes" :class="layout.isWide ? 'hero-tastes-wide' : ''">
                <QtOption v-for="(t, ti) in DAILY_TASTE_ORDER" :key="'ht-' + ti" kind="chip" :label="DAILY_TASTE_LABEL[t]" :selected="taste == t" @select="pickTaste(t)" />
              </view>
            </template>
          </view>
        </view>
      </list-item>
      <!-- 冷启动风格选择：没有画像时的引导（qt-pc 同款：风格 chips + 按所选生成） -->
      <list-item v-if="!loading && coldStart && styleOptions.length > 0" class="style-item" :class="layout.isWide ? 'style-item-wide' : ''">
        <view class="style-card" :class="layout.isWide ? 'style-card-wide' : ''" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';'">
          <text class="style-title" :class="layout.isWide ? 'style-title-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(30, 16)">你爱听什么风格？</text>
          <text class="style-hint" :class="layout.isWide ? 'style-hint-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 13)">选几个（最多 {{ DAILY_STYLE_SEED_MAX }} 个），按这些风格生成</text>
          <view class="style-chips">
            <QtOption v-for="(opt, oi) in styleOptions" :key="'so-' + oi" kind="chip" :label="opt" :selected="stylePicked.indexOf(opt) >= 0" @select="toggleStyle(opt)" />
          </view>
          <view class="style-go" :class="layout.isWide ? 'style-go-wide' : ''" :style="'background-color:' + themeStore.skin.accentSoft + ';'" @click="applyStyleSeeds">
            <QtIcon name="sparkles" :size="layout.isWide ? 14 : 26" :color="themeStore.skin.accent" />
            <text class="style-go-text" :class="layout.isWide ? 'style-go-text-wide' : ''" :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(25, 14)">按这些风格生成{{ stylePicked.length > 0 ? "（" + stylePicked.length + "）" : "" }}</text>
          </view>
        </view>
      </list-item>
      <!-- 生成中的进度说明（规则模式很快，基本只在本地/服务端 AI 时可见） -->
      <list-item v-if="loading && progressText.length > 0" class="progress-item" :class="layout.isWide ? 'progress-item-wide' : ''">
        <text class="progress-text" :class="layout.isWide ? 'progress-text-wide' : ''" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(23, 13)">{{ progressText }}</text>
      </list-item>
      <list-item v-if="loading" class="sk-item">
        <QtSkeletonList kind="song" :rows="SKELETON_ROWS" />
      </list-item>
      <sticky-section>
        <sticky-header>
        <view v-if="layout.isWide && !loading && songs.length > 0" class="track-toolbar" :class="trackToolbarStacked ? 'track-toolbar-stacked' : ''"
          :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.divider + ';'">
          <view class="track-search" :class="trackToolbarStacked ? 'track-search-stacked' : ''"
            :style="'background-color:' + themeStore.skin.surfaceMuted + ';'">
            <QtIcon name="search" :size="16" :color="themeStore.skin.textMuted" />
            <input class="track-search-input" :value="searchQuery" @input="onSearchInput"
              placeholder="搜索标题 / 歌手 / 专辑" :placeholder-style="'color:' + themeStore.skin.placeholder + ';' + qtFontPx(13)"
              :style="'color:' + themeStore.skin.text + ';' + qtFontPx(13)" />
            <view v-if="searchQuery.length > 0" class="track-search-clear" @click="closeSearch">
              <QtIcon name="close" :size="14" :color="themeStore.skin.textMuted" />
            </view>
          </view>
          <view class="track-toolbar-actions" :class="trackToolbarStacked ? 'track-toolbar-actions-stacked' : ''">
            <QtButton label="排序" icon="sliders" size="sm" variant="ghost" @click="openSortPanel" />
            <QtButton v-if="detailSplit" :label="selecting ? '完成' : '批量'" icon="check" size="sm" variant="ghost" @click="toggleWideSelect" />
          </view>
        </view>

          <view v-if="!loading && !detailSplit && songs.length > 0" id="rc-head" class="list-head" :class="layout.isWide ? 'list-head-wide' : ''" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';'">
            <qt-batch-bar
              v-if="selecting"
              :count="selectedCount"
              :total="visibleSongs.length"
              size="md"
              @toggle="toggleSelectAll"
              @download="onBatchDownload"
              @collect="openBatchCollect"
              @cancel="exitSelect"
            />
            <template v-else>
              <text :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(24, 14)">{{ countText }}</text>
              <view class="head-actions" :class="layout.isWide ? 'head-actions-wide' : ''">
                <view class="head-btn" :class="layout.isWide ? 'head-btn-wide' : ''" :style="'background-color:' + themeStore.skin.surfaceMuted + ';border-color:' + themeStore.skin.border + ';'" @click="openModeSheet">
                  <QtIcon name="settings" :size="layout.isWide ? 16 : 28" :color="themeStore.skin.iconMuted" /><text class="head-btn-text" :class="layout.isWide ? 'head-btn-text-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(24, 14)">{{ modeLabel }}</text>
                </view>
                <view class="head-btn" :class="layout.isWide ? 'head-btn-wide' : ''" :style="'background-color:' + themeStore.skin.surfaceMuted + ';border-color:' + themeStore.skin.border + ';'" @click="regenerate">
                  <QtIcon name="refresh" :size="layout.isWide ? 16 : 28" :color="themeStore.skin.iconMuted" /><text class="head-btn-text" :class="layout.isWide ? 'head-btn-text-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(24, 14)">换一批</text>
                </view>
                <view class="play-all" :class="layout.isWide ? 'play-all-wide' : ''" :style="'background-color:' + themeStore.skin.accentSoft + ';'" @click="playAll">
                  <QtIcon name="play" :size="layout.isWide ? 16 : 28" :color="themeStore.skin.accent" /><text class="play-all-text" :class="layout.isWide ? 'play-all-text-wide' : ''" :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(24, 14)">播放</text>
                </view>
                <view class="head-batch" :class="layout.isWide ? 'head-batch-wide' : ''" :style="'background-color:' + themeStore.skin.surfaceMuted + ';border-color:' + themeStore.skin.border + ';'" @click="enterSelect">
                  <QtIcon name="check" :size="layout.isWide ? 16 : 28" :color="themeStore.skin.iconMuted" />
                </view>
              </view>
            </template>
          </view>
        </sticky-header>
        <!-- 推荐行：序号 + 歌名 + 「歌手 · 推荐理由」；默认推荐顺序，可搜索/前端排序 -->
        <list-item v-for="(song, i) in visibleSongs" :key="song.platform + ':' + song.id" class="rc-item" :class="layout.isWide ? 'rc-item-wide' : ''">
          <view class="rc-row" :class="layout.isWide ? 'rc-row-wide' : ''" :style="'background-color:' + themeStore.skin.surface + ';border-top-color:' + themeStore.skin.divider + ';'" @click="onRowClick(song)">
            <QtCheckbox v-if="selecting" class="rc-check-gap" :class="layout.isWide ? 'rc-check-gap-wide' : ''" :checked="isSelected(qtSongKey(song))" @change="toggleSelect(qtSongKey(song))" />
            <text v-else class="rc-idx" :class="layout.isWide ? 'rc-idx-wide' : ''" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(24, 13)">{{ i + 1 }}</text>
            <image class="rc-cover" :class="layout.isWide ? 'rc-cover-wide' : ''" :style="'background-color:' + themeStore.skin.coverPlaceholder + ';'" :src="song.picUrl" mode="aspectFill" />
            <view class="rc-info" :class="layout.isWide ? 'rc-info-wide' : ''">
              <!-- 平台小签跟在歌名后（与歌单详情 qt-song-row-lite 同款） -->
              <view class="rc-name-row">
                <text class="rc-name" :class="layout.isWide ? 'rc-name-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(29, 17)" :max-lines="1">{{ song.name }}</text>
                <text
                  class="rc-tag" :class="layout.isWide ? 'rc-tag-wide' : ''"
                  :style="('color:' + platformColor(song.platform) + ';border-color:' + platformColor(song.platform) + ';') + qtFontDual(19, 11)"
                  :max-lines="1"
                  >{{ platformShort(song.platform) }}</text
                >
              </view>
              <text class="rc-sub" :class="layout.isWide ? 'rc-sub-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(23, 14)" :max-lines="1">{{ reasonOf(song).length > 0 ? song.singer + " · " + reasonOf(song) : song.singer }}</text>
            </view>
            <view class="rc-more" :class="layout.isWide ? 'rc-more-wide' : ''" @click.stop="openSheet(song)">
              <QtIcon name="more" :size="layout.isWide ? 24 : 40" :color="themeStore.skin.iconMuted" />
            </view>
          </view>
        </list-item>
      </sticky-section>
      <!-- 空态 / 失败态留在 sticky-section 外（鸿蒙约束：section 只能 header + v-for） -->
      <list-item v-if="!loading && filtering && visibleSongs.length == 0" class="empty-item" :class="layout.isWide ? 'empty-item-wide' : ''">
        <text class="empty-text" :class="layout.isWide ? 'empty-text-wide' : ''" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(26, 15)">没有匹配的歌曲</text>
      </list-item>
      <list-item v-if="!loading && errorText.length > 0" class="empty-item" :class="layout.isWide ? 'empty-item-wide' : ''">
        <text class="empty-text" :class="layout.isWide ? 'empty-text-wide' : ''" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(26, 15)">{{ errorText }}</text>
        <view class="empty-retry" :style="'background-color:' + themeStore.skin.accentSoft + ';'" @click="load(true)">
          <text class="empty-retry-text" :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(25, 14)">再试一次</text>
        </view>
      </list-item>
      <list-item v-if="!loading && errorText.length == 0 && songs.length == 0" class="empty-item" :class="layout.isWide ? 'empty-item-wide' : ''">
        <text class="empty-text" :class="layout.isWide ? 'empty-text-wide' : ''" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(26, 15)">今天暂时没有推荐，换一批试试</text>
      </list-item>
      <!-- 底部口径说明（qt-pc 页脚同款文案） -->
      <list-item v-if="!loading && songs.length > 0" class="foot-item" :class="layout.isWide ? 'foot-item-wide' : ''">
        <text class="foot-text" :class="layout.isWide ? 'foot-text-wide' : ''" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(21, 12)">候选来自全部已装音源；心动优先收藏（含收藏歌单）；近 {{ DAILY_HISTORY_DAYS }} 天推过的歌会排到后面，同一歌手不会连着排</text>
      </list-item>
    </list-view>
    <QtBackToTop :visible="showBackToTop" @tap="backToTop" />
    <QtActionSheet v-model:visible="sheetVisible" :title="sheetTitle()" :actions="sheetActions" @select="onSheetSelect" />
    <!-- 三点菜单：单项「更改歌曲排序方式」，点击后打开排序面板 -->
    <QtActionSheet
      v-model:visible="moreMenuVisible"
      title="列表操作"
      :actions="moreMenuActions"
      @select="onMoreMenuSelect"
    />
    <QtSortPanel
      v-model:visible="sortSheetVisible"
      :sort-key="sortKey"
      :sort-desc="sortDesc"
      @select="onSortKeySelect"
      @desc="onSortDescSelect"
    />
    <!-- AI 模式设置：全局三档（规则 / 本地 / 服务端），服务端仅管理员可选；
         模式与音乐助手共用（services/ai-mode.ts），换模式立即重新生成 -->
    <QtActionSheet
      v-model:visible="modeSheetVisible"
      title="AI 模式设置"
      :actions="modeActions"
      :selected-index="modeSelectedIndex"
      @select="onModeSelect"
    />
    <!-- 批量收藏面板：选中歌单的预勾选用「已全量收藏」判定（与每日新歌页同口径） -->
    <QtPlaylistPicker
      v-model:visible="batchPickerVisible"
      :song="null"
      :playlists="player.pickerPlaylists()"
      :selected-ids="batchCheckedIds"
      :batch-mode="true"
      title="收藏到歌单"
      :subtitle="'已选 ' + selectedCount + ' 首'"
      @toggle="onBatchToggle"
      :create-playlist="onBatchCreate"
    />
  </view>
  </qt-page-frame>
</template>
<script setup lang="ts">
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import { ref, computed, onMounted, onUnmounted, watch } from "vue";
import QtSkeletonList from "@/uni_modules/qt-ui/components/qt-skeleton-list/qt-skeleton-list.uvue";
import QtSkeleton from "@/uni_modules/qt-ui/components/qt-skeleton/qt-skeleton.uvue";
import QtButton from "@/uni_modules/qt-ui/components/qt-button/qt-button.uvue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtOption from "@/uni_modules/qt-ui/components/qt-option/qt-option.uvue";
import QtCheckbox from "@/uni_modules/qt-ui/components/qt-checkbox/qt-checkbox.uvue";
import QtActionSheet from "@/uni_modules/qt-ui/components/qt-action-sheet/qt-action-sheet.uvue";
import QtSortPanel from "@/uni_modules/qt-ui/components/qt-sort-panel/qt-sort-panel.uvue";
import type { SheetAction } from "@/uni_modules/qt-ui/components/qt-action-sheet/qt-action-sheet.uvue";
import { useTrackSearch } from "@/composables/use-track-search";
import QtBackToTop from "@/uni_modules/qt-ui/components/qt-back-to-top/qt-back-to-top.uvue";
import QtBatchBar from "@/uni_modules/qt-ui/components/qt-batch-bar/qt-batch-bar.uvue";
import QtPlaylistPicker from "@/uni_modules/qt-ui/components/qt-playlist-picker/qt-playlist-picker.uvue";
import { qtSongKey, useBatchSelect } from "@/uni_modules/qt-ui/composables/use-batch-select";
import { useBatchActions } from "@/composables/use-batch-actions";
import { useSongSheet } from "@/composables/use-song-sheet";
import { usePlayerStore } from "@/stores/player";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout, qtRpx } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { detailLayoutMetrics } from "@/uni_modules/qt-ui/composables/detail-layout";
import { qtContentWidth } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import type { Playlist, Song } from "@/types/music";
import { qtFontPx, qtFontDual, fontScale } from "@/uni_modules/qt-ui/stores/font-scale";
import { qtShowToast } from "@/services/toast";
import { isQtAdmin } from "@/services/music-api";
import { readAiMode as readMode, saveAiMode as saveMode } from "@/services/ai-mode";
import { platformShort, platformColor } from "@/services/platform";
import type { AiEngineMode } from "@/services/ai-mode";
import {
  DAILY_HISTORY_DAYS,
  DAILY_MODE_LABEL,
  DAILY_STYLE_SEED_MAX,
  DAILY_TASTE_LABEL,
  DAILY_TASTE_ORDER,
  clearTodayResult,
  generateDailyRecommend,
  loadTodayResult,
  readTaste,
  saveStyleSeeds,
  saveTaste,
} from "@/services/daily-recommend";
import type { DailyRecommendResult } from "@/services/daily-recommend";
import type { DailyTaste } from "@/services/recommend-types";

const player = usePlayerStore();
const themeStore = useThemeStore();
const layout = useQtLayout();
const detailMetrics = computed(() => detailLayoutMetrics(layout.isWide, qtContentWidth("detail")));
const detailSplit = computed((): boolean => detailMetrics.value.split);
const wideAsideWidth = computed((): number => detailMetrics.value.asideWidthPx);
const wideAsideStyle = computed((): string => "width:" + wideAsideWidth.value + "px;");
/** 封面由共享布局限制宽度与上限，骨架使用同一个值。 */
const wideCoverSize = computed((): number => detailMetrics.value.coverSizePx);
const wideCoverStyle = computed((): string => "width:" + wideCoverSize.value + "px;height:" + wideCoverSize.value + "px;");
const wideCoverPx = computed((): string => wideCoverSize.value + "px");
const wideSecondaryStacked = computed((): boolean => wideAsideWidth.value - 34 < 14 * fontScale.scale * 7 + 2 * (38 + 14 + qtRpx(10)));
const trackToolbarStacked = computed((): boolean => detailMetrics.value.listWidthPx < 420 * fontScale.scale);


// 回到顶部
const scrollTop = ref(0);
const showBackToTop = ref(false);
function onListScroll(e: any) {
  const st = e.detail != null ? Number(e.detail.scrollTop ?? 0) : 0;
  showBackToTop.value = st > 600;
  // 标题栏露头判定：滚过操作条自然位置（headOffset）才算吸顶
  if (!layout.isWide && headOffset.value >= 0) {
    headScrolled.value = st >= headOffset.value;
  }
}
function backToTop() {
  scrollTop.value = scrollTop.value == 0 ? 1 : 0;
  showBackToTop.value = false;
}

/**
 * 标题栏是否显示「每日推荐」：静态不显示（同歌单详情/每日新歌），只有当列表滚到
 * 操作条（sticky-header「共 N 首」那条）吸顶固定后才把标题露出来。阈值实量非估算。
 */
const headOffset = ref(-1);
const headScrolled = ref(false);
const titleVisible = computed<boolean>(() => headScrolled.value);

let headAlive = true;
let headTimers: number[] = [];
function clearHeadTimers(): void {
  for (let i = 0; i < headTimers.length; i++) clearTimeout(headTimers[i]);
  headTimers = [];
}
function retryMeasureHead(attempt: number): void {
  if (!headAlive || attempt >= 5) return;
  headTimers.push(setTimeout(() => { measureHeadOffset(attempt + 1); }, 300) as number);
}
function measureHeadOffset(attempt: number): void {
  if (!headAlive || layout.isWide) return;
  if (loading.value || songs.value.length == 0) { retryMeasureHead(attempt); return; }
  uni.createSelectorQuery()
    .select("#rc-scroll")
    .boundingClientRect((listRect: UniNodeInfo) => {
      const listTop = listRect != null ? listRect.top : 0;
      // 嵌套一次新查询拿操作条位置：不链式 select，避免 Vapor 下多节点链的未知行为
      uni.createSelectorQuery()
        .select("#rc-head")
        .boundingClientRect((headRect: UniNodeInfo) => {
          if (headRect != null && headRect.height > 0) {
            headOffset.value = Math.max(0, Math.round(headRect.top - listTop));
            return;
          }
          retryMeasureHead(attempt);
        })
        .exec();
    })
    .exec();
}

const { sheetVisible, sheetActions, openSheet, onSheetSelect, sheetTitle } = useSongSheet();
const SKELETON_ROWS = 8;

// ==================== 结果状态 ====================
const result = ref<DailyRecommendResult | null>(null);
const loading = ref(true);
const progressText = ref("");
const errorText = ref("");
const taste = ref<DailyTaste>(readTaste());
const stylePicked = ref<string[]>([]);

const songs = computed<Song[]>((): Song[] => {
  // 生成中列表清空（只显示骨架），避免「规则结果 + 骨架」叠在一起
  if (loading.value) return [];
  const r = result.value;
  if (r == null || r.items == null) return [];
  const out: Song[] = [];
  for (let i = 0; i < r.items.length; i++) out.push(r.items[i].song);
  return out;
});
/** 推荐理由：按 platform+id 找回 items 里的 reason */
function reasonOf(song: Song): string {
  const r = result.value;
  if (r == null) return "";
  for (let i = 0; i < r.items.length; i++) {
    const it = r.items[i];
    if (it.song.platform == song.platform && it.song.id == song.id) return it.reason;
  }
  return "";
}
const displayPicUrl = computed((): string => (songs.value.length > 0 ? songs.value[0].picUrl : ""));

// ==================== 列表内搜索 + 前端排序（同 pages/daily） ====================
// 口径照抄 PC 侧 filterTracks（多词 AND，查 标题/歌手/专辑），见 composables/use-track-search
const {
  query: searchQuery,
  visible: filteredSongs,
  filtering,
  onInput: trackSearchInput,
  clear: clearSearch,
} = useTrackSearch(() => songs.value);

/** 实时过滤是 visibleSongs 的整组换血：先回顶再写词（§437 配方） */
function onSearchInput(e: InputEvent): void {
  trackSearchInput(e);
  backToTop();
}

/** 搜索态开关：窄屏 = 框架标题栏原地变搜索框；宽屏输入框常驻列表工具栏 */
const searchOpen = ref(false);
function openSearch(): void {
  if (loading.value || songs.value.length == 0) return;
  searchOpen.value = true;
}
function closeSearch(): void {
  searchOpen.value = false;
  backToTop();
  clearSearch();
}
function toggleWideSelect(): void {
  if (selecting.value) exitSelect();
  else enterSelect();
}
function openSortPanel(): void {
  if (loading.value || songs.value.length == 0) return;
  sortSheetVisible.value = true;
}
/** 框架标题栏搜索框输入（窄屏；宽屏输入框直接走 onSearchInput 包装） */
function onHeaderSearchInput(value: string): void {
  backToTop();
  searchQuery.value = value;
}
function onHeaderAction(name: string): void {
  if (name == "search") { openSearch(); return; }
  if (name == "more-vert") { openMoreMenu(); return; }
}

/** 标题栏右侧动作：搜索 + 三点（数据没加载完不渲染，同每日新歌口径） */
const headerActions = computed<string[]>(() => {
  if (loading.value || songs.value.length == 0) return [];
  return ["search", "more-vert"];
});

/** 排序键：none = 推荐原顺序；其余纯前端排（作用在过滤后的可见集合上） */
const sortKey = ref("none");
const sortDesc = ref(false);

const visibleSongs = computed<Song[]>(() => {
  const list = filteredSongs.value;
  const key = sortKey.value;
  if (key == "none" || list.length < 2) return list;
  const out = list.slice();
  out.sort((a: Song, b: Song): number => {
    let primary = 0;
    if (key == "name") primary = a.name.localeCompare(b.name, "zh-Hans-CN");
    else if (key == "album") primary = a.album.localeCompare(b.album, "zh-Hans-CN");
    else primary = a.singer.localeCompare(b.singer, "zh-Hans-CN");
    if (primary != 0) return primary;
    return a.name.localeCompare(b.name, "zh-Hans-CN");
  });
  if (sortDesc.value) out.reverse();
  return out;
});

/** 操作条计数：过滤态显示「显示 M / N 首」 */
const countText = computed(() =>
  filtering.value
    ? "显示 " + visibleSongs.value.length + " / " + songs.value.length + " 首"
    : "共 " + songs.value.length + " 首"
);

// ==================== 三点弹单项菜单，再进排序面板（与歌单详情同款） ====================
const moreMenuVisible = ref(false);
const moreMenuActions = computed((): SheetAction[] => [{ name: "更改歌曲排序方式" }]);
function openMoreMenu(): void {
  if (loading.value || songs.value.length == 0) return;
  moreMenuVisible.value = true;
}
function onMoreMenuSelect(_action: SheetAction, _index: number): void {
  moreMenuVisible.value = false;
  sortSheetVisible.value = true;
}

const sortSheetVisible = ref(false);
function onSortKeySelect(key: string): void {
  // 排序 = visibleSongs 整组换血：先回顶再改 key（§437 配方）
  backToTop();
  sortKey.value = key;
  if (key == "none") sortDesc.value = false;
}
function onSortDescSelect(desc: boolean): void {
  backToTop();
  sortDesc.value = desc;
}

const resultTitle = computed((): string => {
  const r = result.value;
  return r != null && r.title.length > 0 ? r.title : "每日推荐";
});
const resultSummary = computed((): string => {
  const r = result.value;
  return r != null ? r.summary : "";
});
const resultProfileText = computed((): string => {
  const r = result.value;
  return r != null && r.profileText != null ? r.profileText! : "";
});
const coldStart = computed((): boolean => {
  const r = result.value;
  return r != null && r.coldStart === true;
});
const styleOptions = computed<string[]>((): string[] => {
  const r = result.value;
  if (r == null || r.styleOptions == null) return [];
  const out: string[] = [];
  for (let i = 0; i < r.styleOptions.length; i++) {
    const opt = r.styleOptions[i];
    if (opt != null && opt.name != null) out.push(opt.name);
  }
  return out;
});
const laneChips = computed<string[]>((): string[] => {
  const r = result.value;
  if (r == null || r.styleLanes == null) return [];
  const out: string[] = [];
  for (let i = 0; i < r.styleLanes!.length && i < 5; i++) {
    const lane = r.styleLanes![i];
    out.push(lane.label + " " + lane.count);
  }
  return out;
});
const modeLabel = computed((): string => DAILY_MODE_LABEL[readMode()]);
/** 元信息行：日期 · 模式[ · 模型] · 口味 · 共 N 首 */
const metaLine = computed((): string => {
  const r = result.value;
  if (loading.value) return "生成中…";
  const mode = DAILY_MODE_LABEL[r != null ? r.mode : readMode()];
  const model = r != null && r.model != null && r.model.length > 0 ? " · " + r.model : "";
  const t = DAILY_TASTE_LABEL[taste.value];
  const date = r != null && r.date.length > 0 ? r.date : "";
  const count = songs.value.length > 0 ? " · 共 " + songs.value.length + " 首" : "";
  return date + " · " + mode + model + " · " + t + count;
});

// ==================== 生成 / 加载 ====================
let running = false;
let alive = true;
async function generate(force: boolean, tasteOverride: DailyTaste | null): Promise<void> {
  if (running) return;
  running = true;
  // 列表要整组换血（旧结果清空再填充新结果）：先回顶再动数据（§437 配方）
  scrollTop.value = scrollTop.value == 0 ? 1 : 0;
  showBackToTop.value = false;
  // 新结果换血后旧搜索词/排序口径一并复位（理由文案也随 items 全换）
  closeSearch();
  sortKey.value = "none";
  sortDesc.value = false;
  loading.value = true;
  progressText.value = "";
  errorText.value = "";
  try {
    const r = await generateDailyRecommend({
      force,
      taste: tasteOverride != null ? tasteOverride : taste.value,
      onProgress: (msg: string): void => {
        if (alive) progressText.value = msg;
      },
    });
    if (!alive) return;
    result.value = r;
    if (tasteOverride != null) taste.value = tasteOverride;
    exitSelect();
    if (r.notice != null && r.notice.length > 0) qtShowToast(r.notice);
  } catch (e) {
    if (alive) errorText.value = "生成失败：" + (e instanceof Error ? e.message : String(e));
  } finally {
    running = false;
    if (alive) {
      loading.value = false;
      progressText.value = "";
    }
  }
}
/** 首次进入：先吃当日缓存，没有再生成 */
async function load(force: boolean): Promise<void> {
  if (!force) {
    const cached = await loadTodayResult(readMode(), taste.value);
    if (cached != null) {
      result.value = cached;
      loading.value = false;
      return;
    }
  }
  generate(force, null);
}
/** 换一批（强制重新生成，换 variant 种子） */
function regenerate(): void {
  if (loading.value) return;
  generate(true, null);
}
/** 切口味：保存后强制重生成 */
function pickTaste(next: DailyTaste): void {
  if (loading.value || next == taste.value) return;
  saveTaste(next);
  generate(true, next);
}
/** 冷启动按所选风格生成：必须先清当日缓存（loadTodayResult 会直接命中冷启动旧结果） */
async function applyStyleSeeds(): Promise<void> {
  if (stylePicked.value.length == 0) {
    qtShowToast("先选几个风格");
    return;
  }
  saveStyleSeeds(stylePicked.value);
  await clearTodayResult();
  generate(true, null);
}
function toggleStyle(name: string): void {
  const i = stylePicked.value.indexOf(name);
  if (i >= 0) stylePicked.value.splice(i, 1);
  else if (stylePicked.value.length < DAILY_STYLE_SEED_MAX) stylePicked.value.push(name);
}

// ==================== AI 模式设置 ====================
const modeSheetVisible = ref(false);
/** 服务端 AI 仅管理员可见（qt-pc 同款门禁；规则 / 本地对所有人开放） */
const modeActions = computed<SheetAction[]>((): SheetAction[] => {
  const acts: SheetAction[] = [];
  acts.push({ name: "纯规则（不联网，永远可用）" });
  acts.push({ name: "本地模型精选（模型挂了自动退回规则）" });
  if (isQtAdmin()) acts.push({ name: "服务端 AI（需登录，走 astral）" });
  return acts;
});
const modeSelectedIndex = computed((): number => {
  const m = readMode();
  if (m == "local") return 1;
  if (m == "server" && isQtAdmin()) return 2;
  return m == "rule" ? 0 : -1;
});
function openModeSheet(): void {
  modeSheetVisible.value = true;
}
async function onModeSelect(_action: SheetAction, index: number): Promise<void> {
  const order: AiEngineMode[] = isQtAdmin() ? ["rule", "local", "server"] : ["rule", "local"];
  const next = order[index];
  if (next != readMode()) {
    saveMode(next);
    await clearTodayResult();
    generate(true, null);
  }
}

// ==================== 播放 / 批量 ====================
function playAll(): void {
  // 播放当前可见集合（受搜索/排序影响），与歌单详情口径一致
  if (visibleSongs.value.length == 0) return;
  player.play(visibleSongs.value[0], visibleSongs.value);
}
function onRowClick(song: Song): void {
  if (selecting.value) toggleSelect(qtSongKey(song));
  else player.playSingle(song);
}
const {
  selecting,
  count: selectedCount,
  enter: enterSelect,
  exit: exitSelect,
  isSelected,
  toggle: toggleSelect,
  toggleAll,
  keys: selectedKeys,
} = useBatchSelect();
const batch = useBatchActions();
const batchPickerVisible = ref(false);
/** 已整单收藏的 Playlist id（面板预勾选） */
const batchCheckedIds = computed<string[]>((): string[] => {
  const selected = selectedKeysOf();
  const out: string[] = [];
  const lists = player.pickerPlaylists();
  for (let i = 0; i < lists.length; i++) {
    if (batch.isFullyCollected(lists[i].id, selected)) out.push(lists[i].id);
  }
  return out;
});
function toggleSelectAll(): void {
  toggleAll(visibleSongs.value.map((s: Song): string => qtSongKey(s)));
}
function onBatchDownload(): void {
  batch.batchDownload(selectedKeysOf());
}
function openBatchCollect(): void {
  if (selectedKeysOf().length == 0) return;
  batchPickerVisible.value = true;
}
function selectedKeysOf(): Song[] {
  const out: Song[] = [];
  // R9：以可见集合为准 —— 遍历全量 songs 会把被筛选掉的已选歌也带进批量
  // 下载/收藏（用户没看到的行被悄悄操作）；daily/artist 页同款口径
  for (let i = 0; i < visibleSongs.value.length; i++) {
    if (isSelected(qtSongKey(visibleSongs.value[i]))) out.push(visibleSongs.value[i]);
  }
  return out;
}
function findPlaylistById(playlistId: string): Playlist | null {
  const lists = player.pickerPlaylists();
  for (let i = 0; i < lists.length; i++) {
    if (lists[i].id == playlistId) return lists[i];
  }
  return null;
}
function onBatchToggle(playlistId: string): void {
  const selected = selectedKeysOf();
  if (selected.length == 0) return;
  const target = findPlaylistById(playlistId);
  if (target == null) return;
  batch.toggleCollect(target, selected);
}
function onBatchCreate(name: string): Playlist | null {
  const selected = selectedKeysOf();
  return batch.createAndCollect(selected, name);
}

// 列表一旦有数据就量操作条位置（首帧没渲染出 #rc-head 时 measureHeadOffset 自带重试）
watch(songs, (list: Song[]) => {
  if (list.length > 0) measureHeadOffset(0);
});

// R9 配套：被筛掉的歌退出批量范围（同 daily/artist 页 retainTrackSelection 口径），
// 否则「已选 N」里混着看不见的歌、selectedKeysOf 与计数不一致
watch(visibleSongs, (list: Song[]) => {
  const keys = selectedKeys.value;
  if (keys.length == 0) return;
  const keep: string[] = [];
  for (let i = 0; i < list.length; i++) {
    const key = qtSongKey(list[i]);
    if (keys.indexOf(key) >= 0) keep.push(key);
  }
  if (keep.length != keys.length) selectedKeys.value = keep;
});

onMounted((): void => {
  load(false);
});
onUnmounted((): void => {
  alive = false;
  headAlive = false;
  clearHeadTimers();
});
</script>
<style>
.page { flex: 1; min-height: 0; }
.page-wide { align-items: stretch; padding: 16px 20px 0; }
.wide-left { flex-shrink: 0; margin-right: 16px; padding-bottom: 16px; }
.whero { padding: 16px; flex-direction: column; border-width: 1px; border-style: solid; border-radius: 16px; }
.whero-cover { border-radius: 12px; background-color: rgba(255,255,255,0.2); }
.wsk-l1 { margin-top: 14px; }
.wsk-l2 { margin-top: 10px; }
.wsk-l3 { margin-top: 8px; }
.wsk-l5 { margin-top: 14px; }
.whero-meta { margin-top: 12px; }
.whero-title { margin-top: 14px; font-size: 18px; font-weight: 600; }
.whero-desc { margin-top: 8px; font-size: 13px; line-height: 1.5; }
.whero-lanes { margin-top: 8px; flex-direction: row; flex-wrap: wrap; }
.lane-chip { margin: 3px; padding: 2px 8px; border-width: 1px; border-style: solid; border-radius: 10px; }
.lane-chip-text { color: #737b8e; }
.whero-profile { margin-top: 6px; }
.whero-tastes { margin-top: 10px; flex-direction: row; flex-wrap: wrap; }
.whero-actions { margin-top: 16px; flex-direction: column; align-self: stretch; }

.scroll { flex: 1; min-width: 0; min-height: 0; }
.hero-item { padding: 0; }
/* 竖屏 hero 与歌单详情（pages/playlist .hero）完全同款 */
.hero { padding: 40rpx 32rpx; flex-direction: row; border-width: 1px; border-style: solid; border-radius: 24rpx; }
.cover { width: 200rpx; height: 200rpx; border-radius: 20rpx; background-color: rgba(255, 255, 255, 0.2); }
.hero-info { flex: 1; margin-left: 26rpx; justify-content: center; }
.hsk-l2 { margin-top: 12rpx; }
.hsk-l3 { margin-top: 10rpx; }
.title { font-weight: 600; }
.desc { margin-top: 10rpx; }
.playcount { margin-top: 8rpx; }
.hero-tastes { margin-top: 14rpx; flex-direction: row; flex-wrap: wrap; }
.style-item { padding: 20rpx 0 0; }
.style-item-wide { padding: 12px 0 0; }
.style-card { padding: 26rpx; border-width: 1px; border-style: solid; border-radius: 24rpx; flex-direction: column; }
.style-card-wide { padding: 14px; border-radius: 14px; }
.style-title { }
.style-title-wide { }
.style-hint { margin-top: 8rpx; }
.style-hint-wide { margin-top: 4px; }
.style-chips { margin-top: 18rpx; flex-direction: row; flex-wrap: wrap; }
.style-go { margin-top: 10rpx; height: 72rpx; border-radius: 36rpx; flex-direction: row; align-items: center; justify-content: center; }
.style-go-wide { margin-top: 8px; height: 40px; border-radius: 20px; }
.style-go-text { margin-left: 8rpx; }
.style-go-text-wide { margin-left: 6px; }
.progress-item { padding: 8rpx 40rpx 0; }
.progress-item-wide { padding: 4px 20px 0; }
.progress-text { }
.progress-text-wide { }
.sk-item { padding: 0; }
.list-head { min-height: 96rpx; height: auto; padding: 14rpx 24rpx; border-width: 1px; border-style: solid; border-radius: 24rpx; flex-direction: row; align-items: center; flex-wrap: wrap; }
.head-actions { flex-direction: row; align-items: center; flex-wrap: wrap; justify-content: flex-end; flex: 1; }
.head-btn { margin-left: 14rpx; height: 60rpx; padding: 0 20rpx; border-width: 1px; border-style: solid; border-radius: 30rpx; flex-direction: row; align-items: center; }
.head-btn-text { margin-left: 6rpx; }
.play-all { margin-left: 14rpx; height: 60rpx; padding: 0 26rpx; border-radius: 30rpx; flex-direction: row; align-items: center; }
.play-all-text { margin-left: 6rpx; }
.head-batch { margin-left: 14rpx; width: 60rpx; height: 60rpx; border-width: 1px; border-style: solid; border-radius: 30rpx; align-items: center; justify-content: center; }
.rc-item { padding: 0; }
.rc-item-wide { padding: 0; }
.rc-row { flex-direction: row; align-items: center; min-height: 128rpx; padding: 12rpx 32rpx; border-top-width: 1px; border-top-style: solid; }
.rc-row-wide { min-height: 82px; padding: 10px 24px; }
.rc-check-gap { margin-right: 16rpx; }
.rc-check-gap-wide { margin-right: 8px; }
.rc-idx { width: 48rpx; text-align: center; }
.rc-idx-wide { width: 24px; }
.rc-cover { width: 88rpx; height: 88rpx; border-radius: 12rpx; margin-left: 12rpx; flex-shrink: 0; }
.rc-cover-wide { width: 58px; height: 58px; border-radius: 10px; margin-left: 6px; }
.rc-info { flex: 1; min-width: 0; margin-left: 22rpx; flex-direction: column; }
.rc-info-wide { margin-left: 16px; }
/* 歌名与平台小签同行（与歌单详情 lite-tag 同款布局） */
.rc-name-row { flex-direction: row; align-items: center; }
.rc-name { flex-shrink: 1; min-width: 0; overflow: hidden; font-weight: 500; }
.rc-name-wide { }
/* 平台简写描边小签：不被歌名挤成 0 宽 */
.rc-tag { flex-shrink: 0; margin-left: 12rpx; padding: 0 8rpx; border-width: 1px; border-style: solid; border-radius: 6rpx; }
.rc-tag-wide { margin-left: 8px; padding: 0 5px; border-radius: 4px; }
