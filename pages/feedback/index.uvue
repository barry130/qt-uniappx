<script setup lang="ts">
import { computed } from "vue";
import { onShow } from "@dcloudio/uni-app";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtFontDual, qtFontValuePx } from "@/uni_modules/qt-ui/stores/font-scale";
import { openInBrowser } from "@/services/app-native";
import { OFFICIAL_ISSUE_CNB_URL, OFFICIAL_ISSUE_GITHUB_URL } from "@/services/official-site";
import { qtShowToast } from "@/services/toast";
import { qtTrackPage } from "@/uni_modules/qt-stat";

/**
 * 意见反馈（2026-11-14 起）：两个按钮直达双仓的新建 Issue 页。
 *
 * 为什么改成这样：原来这里是「我的 / 公开」双 Tab 列表 + 提交页，反馈落在后端表里，
 * 只有装了 App 的人看得到，仓库侧完全不可见，也没法被搜索引擎收录、没法跟 PR 关联。
 * Issue 是开源项目唯一的公共追踪面，所以直接把入口指过去。
 *
 * 旧实现整段注释保留在本文件底部（template / script / style 三段各一段注释），
 * 需要恢复时按注释里的说明反注释即可；`pages/feedback/submit` 与 `pages/feedback/detail`
 * 两个路由本轮不动，仍是可编译状态。
 *
 * 不做登录门禁：提 Issue 只依赖浏览器里的仓库账号，App 内登录与否都不影响。
 */
const themeStore = useThemeStore();
const layout = useQtLayout();
function feedbackFont(baseRpx: number, widePx: number): string {
  return qtFontDual(baseRpx, widePx) + (layout.isTv ? "line-height:" + Math.round(qtFontValuePx(widePx) * 1.4) + "px;" : "");
}

/** 卡片描边颜色走主题 border；`border-style: solid` 由 .channel 类提供（Vapor 默认 none） */
const channelStyle = computed((): string => "background-color:" + themeStore.skin.surface + ";border-color:" + themeStore.skin.border + ";" + (layout.isTv ? "min-height:56px;" : ""));
/** 图标底：accentSoft 是 accent 的低饱和底，深浅主题都自带对比 */
const iconStyle = computed((): string => "background-color:" + themeStore.skin.accentSoft + ";");

/**
 * 统一出口。openInBrowser 内部已带降级（打不开时复制链接 + 提示），
 * 这里只兜住它自己抛异常的情况，避免点了没反应。
 */
function openIssue(url: string, label: string): void {
  try {
    openInBrowser(url);
  } catch (e) {
    qtShowToast({ title: "打开 " + label + " 失败，请手动访问仓库", icon: "none" });
  }
}
function openCnbIssue(): void {
  openIssue(OFFICIAL_ISSUE_CNB_URL, "CNB");
}
function openGithubIssue(): void {
  openIssue(OFFICIAL_ISSUE_GITHUB_URL, "GitHub");
}

onShow(() => {
  qtTrackPage("pages/feedback/index");
});

