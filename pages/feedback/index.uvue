<style>
.page {
  flex: 1;
}

.head {
  padding: 44rpx 32rpx 24rpx;
  flex-direction: column;
}
.head-wide { padding: 28px 32px 18px; }
.head-title { font-weight: 700; }
.head-sub { margin-top: 14rpx; line-height: 38rpx; }
.head-sub-wide { margin-top: 8px; line-height: 20px; }

.channels {
  flex-direction: column;
  padding: 8rpx 24rpx 0;
}
.channels-wide { padding: 4px 24px 0; }
/* border-style 必须显式写：Vapor 的默认 border-style 是 none，只写 width 不会出线 */
.channel {
  flex-direction: row;
  align-items: center;
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
  border-width: 1px;
  border-style: solid;
  border-radius: 24rpx;
}
.channel-wide { padding: 16px 18px; margin-bottom: 12px; border-radius: 16px; }
.ch-icon {
  width: 88rpx;
  height: 88rpx;
  margin-right: 22rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}
.ch-icon-wide { width: 44px; height: 44px; margin-right: 14px; border-radius: 14px; }
/* 文字列必须 flex:1 才能把右箭头挤到行尾；标题/副标题各自是 <text>，样式不继承 */
.ch-body {
  flex: 1;
  flex-direction: column;
}
.ch-title { font-weight: 600; }
.ch-desc { margin-top: 8rpx; line-height: 34rpx; }
.ch-desc-wide { margin-top: 4px; line-height: 18px; }

.tip {
  margin: 10rpx 32rpx 0;
  line-height: 34rpx;
}
.tip-wide { margin: 6px 32px 0; line-height: 20px; }

