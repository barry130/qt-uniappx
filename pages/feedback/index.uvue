<!--
  意见反馈页 · 2026-11-14 改版

  新版只做一件事：两个按钮直达双仓的新建 Issue 页（CNB / GitHub）。
  旧版「我的 / 公开」双 Tab 列表 + 提交入口**整段注释保留在本文件内**
  （template 在 </qt-page-frame> 之后、script 在底部、style 在底部），代码未删除。

  恢复旧版的三步：
  1) 反注释下方的「旧版模板」段，并删掉新版两个渠道卡与 head 说明；
  2) 反注释 script 里的「旧版页面逻辑」段，保留 onShow 只留一处（两段各有一个 onShow）；
  3) 反注释 style 里的「旧版样式」段。
  旧版的 /pages/feedback/submit 与 /pages/feedback/detail 两个路由本轮未改动，随时可用。
-->
<template>
<qt-page-frame width-kind="list">
  <view class="page">
    <!-- 页面说明：为什么不再有「我的 / 公开」列表 —— 反馈统一进 Issue，
         理由写在这里，省得以后有人以为是漏掉了历史反馈入口 -->
    <view class="head" :class="layout.isWide ? 'head-wide' : ''">
      <text class="head-title" :style="('color:' + themeStore.skin.text + ';') + feedbackFont(40, 23)">意见反馈</text>
      <text class="head-sub" :class="layout.isWide ? 'head-sub-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + feedbackFont(24, 13)">轻听是开源项目，Bug 与建议统一在 Issue 里跟进 —— 别人遇到同样的问题也能搜到答案。</text>
    </view>

    <!-- 两个渠道卡：结构与 about 页的分组行同口径（图标底 + 标题/副标题 + 右箭头），
         点整行都能开，命中面积按卡片全宽算，不用瞄准文字 -->
    <view class="channels" :class="layout.isWide ? 'channels-wide' : ''">
      <view class="channel" :class="layout.isWide ? 'channel-wide' : ''" :style="channelStyle" @click="openCnbIssue">
        <view class="ch-icon" :class="layout.isWide ? 'ch-icon-wide' : ''" :style="iconStyle">
          <QtIcon name="rocket" :size="layout.isWide ? 20 : 40" :color="themeStore.skin.accent" />
        </view>
        <view class="ch-body">
          <text class="ch-title" :style="('color:' + themeStore.skin.text + ';') + feedbackFont(28, 16)">在 CNB 提交 Issue</text>
          <text class="ch-desc" :class="layout.isWide ? 'ch-desc-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + feedbackFont(22, 12)">国内直连，打开快，不需要额外网络环境</text>
        </view>
        <QtIcon name="chevron-right" :size="layout.isWide ? 16 : 32" :color="themeStore.skin.textSubtle" />
      </view>

      <view class="channel" :class="layout.isWide ? 'channel-wide' : ''" :style="channelStyle" @click="openGithubIssue">
        <view class="ch-icon" :class="layout.isWide ? 'ch-icon-wide' : ''" :style="iconStyle">
          <QtIcon name="globe" :size="layout.isWide ? 20 : 40" :color="themeStore.skin.accent" />
        </view>
        <view class="ch-body">
          <text class="ch-title" :style="('color:' + themeStore.skin.text + ';') + feedbackFont(28, 16)">在 GitHub 提交 Issue</text>
          <text class="ch-desc" :class="layout.isWide ? 'ch-desc-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + feedbackFont(22, 12)">适合已有 GitHub 账号的用户</text>
        </view>
        <QtIcon name="chevron-right" :size="layout.isWide ? 16 : 32" :color="themeStore.skin.textSubtle" />
      </view>
    </view>

    <text class="tip" :class="layout.isWide ? 'tip-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + feedbackFont(22, 12)">提交前先搜一下有没有同类 Issue；附上机型、系统版本、App 版本与复现步骤，定位会快很多。</text>
    <text class="tip" :class="layout.isWide ? 'tip-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + feedbackFont(22, 12)">两个仓库是同一份代码，选一个顺手的即可，重复提交会被合并。</text>
  </view>
  </qt-page-frame>

  <!-- ============ 旧版模板（已停用，代码保留：每行各自在自己的注释里） ============ -->
