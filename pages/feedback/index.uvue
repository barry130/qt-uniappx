<template>
  <qt-page-frame width-kind="list">
  <view class="page" :class="themeStore.dark ? 'page-dark' : ''">
    <!-- 顶部：Tab + 提交按钮 -->
    <view class="topbar" :class="[themeStore.dark ? 'topbar-dark' : '', layout.isWide ? 'topbar-wide' : '']">
      <view class="tabs" :class="layout.isWide ? 'tabs-wide' : ''">
        <view class="tab" :class="[tab == 'mine' ? 'tab-active' : '', layout.isWide ? 'tab-wide' : '']" :style="tab == 'mine' ? 'background-color:' + themeStore.skin.accent + ';' : ''" @tap="switchTab('mine')">
          <text class="tab-text" :class="[tab == 'mine' ? 'tab-text-active' : '', layout.isWide ? 'tab-text-wide' : '']" :style="(tab == 'mine' ? 'color:' + themeStore.skin.onAccent + ';' : '') + qtFontDual(26, 14)">我的</text>
        </view>
        <view class="tab" :class="[tab == 'public' ? 'tab-active' : '', layout.isWide ? 'tab-wide' : '']" :style="tab == 'public' ? 'background-color:' + themeStore.skin.accent + ';' : ''" @tap="switchTab('public')">
          <text class="tab-text" :class="[tab == 'public' ? 'tab-text-active' : '', layout.isWide ? 'tab-text-wide' : '']" :style="(tab == 'public' ? 'color:' + themeStore.skin.onAccent + ';' : '') + qtFontDual(26, 14)">公开</text>
        </view>
      </view>
      <view class="submit-btn" :class="layout.isWide ? 'submit-btn-wide' : ''" :style="'background-color:' + themeStore.skin.accent + ';'" @tap="goSubmit">
        <text class="submit-btn-text" :class="layout.isWide ? 'submit-btn-text-wide' : ''" :style="('color:' + themeStore.skin.onAccent + ';') + qtFontDual(26, 14)">+ 提交反馈</text>
      </view>
    </view>

    <!-- 未登录兜底（正常入口已限制登录，这里防直达） -->
    <view v-if="!loggedIn" class="empty" :class="layout.isWide ? 'empty-wide' : ''">
      <QtIcon name="user" :size="layout.isWide ? 44 : 72" color="#c3c9d6" />
      <text class="empty-text" :class="layout.isWide ? 'empty-text-wide' : ''" :style="qtFontDual(26, 14)">登录后可以提交与查看反馈</text>
      <view class="login-btn" :class="layout.isWide ? 'login-btn-wide' : ''" :style="'background-color:' + themeStore.skin.accent + ';'" @tap="goLogin">
        <text class="login-btn-text" :class="layout.isWide ? 'login-btn-text-wide' : ''" :style="('color:' + themeStore.skin.onAccent + ';') + qtFontDual(27, 14)">去登录</text>
      </view>
    </view>

    <scroll-view
      v-else
      class="list"
      direction="vertical"
      :show-scrollbar="false"
      :scroll-top="scrollTop"
      @scrolltolower="loadMore"
    >
      <view v-if="loading && items.length == 0" class="sk">
        <QtSkeletonList kind="feedback" :rows="SKELETON_ROWS" />
      </view>
      <view v-else-if="items.length == 0" class="empty" :class="layout.isWide ? 'empty-wide' : ''">
        <QtIcon name="feedback" :size="layout.isWide ? 44 : 72" color="#c3c9d6" />
        <text class="empty-text" :class="layout.isWide ? 'empty-text-wide' : ''" :style="qtFontDual(26, 14)">{{ tab == "mine" ? "还没有反馈，说说你的想法吧" : "暂无公开反馈" }}</text>
      </view>

      <view v-for="pair in pairs" :key="pair.key" class="fb-row" :class="twoColumn ? 'fb-row-2' : ''">
        <view class="cell" :style="cellStyle">
          <QtFeedbackCard
            :title="pair.left.title"
            :content="pair.left.content"
            :typeText="feedbackTypeLabel(pair.left.type)"
            :typeColor="feedbackTypeColor(pair.left.type)"
            :statusText="feedbackStatusLabel(pair.left.status)"
            :statusColor="feedbackStatusColor(pair.left.status)"
            :timeText="formatTime(pair.left.createTime)"
            :showPublic="tab == 'mine' && (pair.left.isPublic ?? false)"
            :inColumn="twoColumn"
            @tap="openDetail(pair.left)"
          />
        </view>
        <!-- 右格容器恒渲染、内容条件渲染：奇数条时右格留空，不塞占位卡片 -->
        <view v-if="twoColumn" class="cell-right" :style="rightCellStyle">
          <QtFeedbackCard
            v-if="pair.hasRight"
            :title="pair.right.title"
            :content="pair.right.content"
            :typeText="feedbackTypeLabel(pair.right.type)"
            :typeColor="feedbackTypeColor(pair.right.type)"
            :statusText="feedbackStatusLabel(pair.right.status)"
            :statusColor="feedbackStatusColor(pair.right.status)"
            :timeText="formatTime(pair.right.createTime)"
            :showPublic="tab == 'mine' && (pair.right.isPublic ?? false)"
            :inColumn="twoColumn"
            @tap="openDetail(pair.right)"
          />
        </view>
      </view>

      <view v-if="items.length > 0" class="list-foot" :class="layout.isWide ? 'list-foot-wide' : ''" @tap="loadMore">
        <text class="list-foot-text" :class="layout.isWide ? 'list-foot-text-wide' : ''" :style="qtFontDual(24, 14)">{{ loading ? "加载中..." : (hasMore ? "加载更多" : "没有更多了") }}</text>
      </view>
    </scroll-view>
  </view>
  </qt-page-frame>
</template>
<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import { ref, computed } from "vue";
import { onShow } from "@dcloudio/uni-app";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtSkeletonList from "@/uni_modules/qt-ui/components/qt-skeleton-list/qt-skeleton-list.uvue";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import {
  fetchMyFeedback,
  fetchPublicFeedback,
  feedbackTypeLabel,
  feedbackTypeColor,
  feedbackStatusLabel,
  feedbackStatusColor,
  FEEDBACK_PAGE_SIZE,
} from "@/services/feedback";
import { isLoggedIn } from "@/services/auth";
import { qtTrackPage } from "@/uni_modules/qt-stat";
import type { FeedbackItem, FeedbackPageResult } from "@/types/feedback";
import QtFeedbackCard from "@/uni_modules/qt-ui/components/qt-feedback-card/qt-feedback-card.uvue";
import { useQtSongColumns } from "@/uni_modules/qt-ui/composables/use-qt-song-columns";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";
import { qtNavAnimation } from "@/uni_modules/qt-ui/composables/qt-nav";

const themeStore = useThemeStore();
const layout = useQtLayout();

/** 当前 Tab：我的 / 公开 */
const tab = ref<"mine" | "public">("mine");
const items = ref<FeedbackItem[]>([]);
const total = ref(0);
const pageNum = ref(1);
// 初值 true：加载在 onShow 里发起，首帧若按 false 渲染会先闪一下空态文案
const loading = ref(true);
const loggedIn = computed(() => isLoggedIn());
const hasMore = computed(() => items.value.length < total.value);
/** 骨架卡片数：约一屏量，只做占位 */
const SKELETON_ROWS = 5;

/** 拉取指定 Tab 第 page 页（tab 由调用方快照传入，不读实时 tab） */
async function fetchPage(page: number, whichTab: "mine" | "public"): Promise<FeedbackPageResult> {
  if (whichTab == "mine") {
    return await fetchMyFeedback(page, FEEDBACK_PAGE_SIZE);
  }
  return await fetchPublicFeedback(page, FEEDBACK_PAGE_SIZE);
}

// 列表序号：tab 切换/刷新时旧响应晚到不得写入新 tab（写回前比对）
let listSeq = 0;

/** 滚动位置绑定：回顶用（0/1 交替写入保证每次都真正变化） */
const scrollTop = ref(0);
/**
 * 整组换血前先回顶：scroll-view 停在滚动深处时整组替换数组会整段丢渲染
 * （大块空白带，搜索页 L871 注释与排行榜页均有实证），回顶后替换安全。
 */
function resetListScroll() {
  scrollTop.value = scrollTop.value == 0 ? 1 : 0;
}

/** 刷新到第一页 */
async function refresh(): Promise<void> {
  if (!loggedIn.value) return;
  const seq = ++listSeq;
  const whichTab = tab.value;
  loading.value = true;
  try {
    const res = await fetchPage(1, whichTab);
    if (seq !== listSeq) return;
    pageNum.value = 1;
    total.value = res.total;
    items.value = res.records;
  } catch (e) {
    if (seq !== listSeq) return;
    qtShowToast({ title: (e as Error).message || "加载失败", icon: "none" });
  } finally {
    if (seq === listSeq) loading.value = false;
  }
}

/** 加载下一页（scrolltolower 触发） */
async function loadMore(): Promise<void> {
  if (!loggedIn.value || loading.value || !hasMore.value) return;
  const seq = listSeq;
  const whichTab = tab.value;
  loading.value = true;
  try {
    const next = pageNum.value + 1;
    const res = await fetchPage(next, whichTab);
    if (seq !== listSeq) return;
    pageNum.value = next;
    total.value = res.total;
    items.value = items.value.concat(res.records);
  } catch (e) {
    if (seq !== listSeq) return;
    qtShowToast({ title: (e as Error).message || "加载失败", icon: "none" });
  } finally {
    if (seq === listSeq) loading.value = false;
  }
}

function switchTab(t: "mine" | "public"): void {
  if (tab.value == t) return;
  // tab 切换 = 列表整组换血：先回顶再清数据（见 resetListScroll 注释）
  resetListScroll();
  tab.value = t;
  items.value = [];
  total.value = 0;
  refresh();
}

function openDetail(f: FeedbackItem): void {
  uni.navigateTo({ animationType: qtNavAnimation(), url: "/pages/feedback/detail?id=" + f.id });
}

function goSubmit(): void {
  uni.navigateTo({ animationType: qtNavAnimation(), url: "/pages/feedback/submit" });
}

function goLogin(): void {
  uni.navigateTo({ animationType: qtNavAnimation(), url: "/pages/login/index" });
}

function formatTime(t?: string): string {
  if (t == null || t.length == 0) return "";
  if (t.length >= 16) return t.substring(5, 16);
  return t;
}

/* ---------------- 宽屏两列 ---------------- */
/* 门限按最小列宽判定而不是 sizeClass：横屏 ~1067dp 属 wide 档却够两列，
   按 isDesktop 会误关。24 是 .fb-item-wide 的左右外边距，两列时归零。 */
const { twoColumn, cellStyle, rightCellStyle } = useQtSongColumns(24, "list");

type FeedbackPair = { key: string; left: FeedbackItem; right: FeedbackItem; hasRight: boolean };

/** 一行承载两张卡。奇数条时右格留空，靠 hasRight 判定 */
const pairs = computed((): FeedbackPair[] => {
  const src = items.value;
  const out: FeedbackPair[] = [];
  if (!twoColumn.value) {
    for (let i = 0; i < src.length; i++) {
      out.push({ key: "f" + src[i].id, left: src[i], right: src[i], hasRight: false });
    }
    return out;
  }
  let i = 0;
  while (i < src.length) {
    const has = i + 1 < src.length;
    out.push({ key: "f" + src[i].id, left: src[i], right: has ? src[i + 1] : src[i], hasRight: has });
    i += 2;
  }
  return out;
});

onShow(() => {
  qtTrackPage("pages/feedback/index");
  refresh();
});
</script>

<style>
.page {
  flex: 1;
}

.topbar {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}
.topbar-dark {
}
.tabs {
  flex-direction: row;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 36rpx;
  padding: 6rpx;
}
.tab {
  padding: 12rpx 36rpx;
  border-radius: 30rpx;
}
.tab-active {
}
.tab-text {
  color: #596173;
  font-size: 26rpx;
  font-weight: 500;
}
.tab-text-active {
  font-weight: 600;
}
.submit-btn {
  padding: 14rpx 28rpx;
  justify-content: center;
  align-items: center;
  border-radius: 36rpx;
}
.submit-btn-text {
  font-size: 26rpx;
  font-weight: 600;
}
.list {
  flex: 1;
}
.fb-item {
  margin: 20rpx 24rpx 0;
  padding: 28rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.62);
  border-width: 1px; border-style: solid;
  border-color: rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
}
.fb-item-dark {
  background-color: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.12);
}
.list-foot {
  padding: 24rpx 0 40rpx;
  justify-content: center;
  align-items: center;
}
.list-foot-text {
  color: #6b7385;
  font-size: 24rpx;
}
.empty {
  padding: 140rpx 32rpx;
  justify-content: center;
  align-items: center;
}
/* 骨架容器：卡片自带外边距，这里只管纵向排列 */
.sk {
  flex-direction: column;
}
.empty-text {
  margin-top: 20rpx;
  color: #6b7385;
  font-size: 26rpx;
}
.login-btn {
  margin-top: 36rpx;
  padding: 18rpx 64rpx;
  justify-content: center;
  align-items: center;
  border-radius: 40rpx;
}
.login-btn-text {
  font-size: 27rpx;
  font-weight: 600;
}

/* Vapor 宽屏：px 覆盖 rpx，1600x900 下避免按窗口比例放大 2.7 倍 */
.topbar-wide { padding: 12px 24px; }
.tabs-wide { border-radius: 18px; padding: 3px; }
.tab-wide { padding: 8px 20px; border-radius: 15px; }
.tab-text-wide { font-size: 14px; }
.submit-btn-wide { padding: 9px 18px; border-radius: 18px; }
.submit-btn-text-wide { font-size: 14px; }
/* 桌面指针反馈 */
.fb-item-hover {
  background-color: rgba(127, 127, 127, 0.10);
}
/* 两列时卡片外边距归零：列宽已扣掉页面留白与列间距 */
.fb-item-wide { margin: 14px 24px 0; padding: 20px; border-radius: 14px; }
.list-foot-wide { padding: 12px 0 20px; }
.list-foot-text-wide { font-size: 14px; }
.empty-wide { padding: 80px 24px; }
.empty-text-wide { margin-top: 10px; font-size: 14px; }
.login-btn-wide { margin-top: 20px; padding: 12px 32px; border-radius: 22px; }
.login-btn-text-wide { font-size: 14px; }
/* 两列：align-items:flex-start 让两卡各按内容高度排，
   默认 stretch 会把短卡拉长露出卡片底色空白 */
.fb-row { flex-direction: column; }
/* 两列：align-items:flex-start 让两卡各按内容高度排，默认 stretch 会把短卡拉长 */
.fb-row-2 { flex-direction: row; align-items: flex-start; justify-content: center; }
.cell { flex-direction: column; }
.cell-right { flex-direction: column; }
</style>
