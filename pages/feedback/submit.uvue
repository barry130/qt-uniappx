<template>
  <qt-page-frame width-kind="form">
  <view class="page" :class="layout.isWide ? 'page-wide' : ''">
    <scroll-view class="scroll" :class="layout.isWide ? 'scroll-wide' : ''" :style="wideScrollStyle" direction="vertical" :show-scrollbar="false">
      <!-- 类型选择 -->
      <view class="card" :class="layout.isWide ? 'card-wide' : ''" :style="cardStyle">
        <text class="label" :class="layout.isWide ? 'label-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(27, 16)">反馈类型</text>
        <QtSegmented
          class="type-seg" :class="[[layout.isWide ? 'type-seg-wide' : ''], layout.isWide ? 'type-seg-wide' : '']"
          
          :list="['问题', '需求']"
          :modelValue="typeIndex"
          @change="onTypeChange"
        />
        <text class="hint" :class="layout.isWide ? 'hint-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12)">{{ type == "issue" ? "功能异常、体验问题等" : "新功能、改进建议等" }}</text>
      </view>

      <!-- 标题 -->
      <view class="card" :class="layout.isWide ? 'card-wide' : ''" :style="cardStyle">
        <text class="label" :class="layout.isWide ? 'label-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(27, 16)">标题</text>
        <view class="field-row" :class="layout.isWide ? 'field-row-wide' : ''" :style="rowStyle">
          <input
            :value="title"
            @input="onTitleInput"
            class="field-input" :class="[[layout.isWide ? 'field-input-wide' : ''], layout.isWide ? 'field-input-wide' : '']"
            :style="inputStyle"
            :placeholder-style="'color:' + themeStore.skin.placeholder + ';'"
            placeholder="一句话描述您的问题或需求"
            :placeholder-class="layout.isWide ? 'field-ph-wide' : 'field-ph'"
            :maxlength="128"
          />
        </view>
        <text class="hint" :class="layout.isWide ? 'hint-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12)">{{ title.length }}/128</text>
      </view>

      <!-- 内容 -->
      <view class="card" :class="layout.isWide ? 'card-wide' : ''" :style="cardStyle">
        <text class="label" :class="layout.isWide ? 'label-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(27, 16)">内容</text>
        <view class="textarea-row" :class="layout.isWide ? 'textarea-row-wide' : ''" :style="rowStyle">
          <textarea
            :value="content"
            @input="onContentInput"
            class="field-textarea" :class="[[layout.isWide ? 'field-textarea-wide' : ''], layout.isWide ? 'field-textarea-wide' : '']"
            :style="inputStyle"
            :placeholder-style="'color:' + themeStore.skin.placeholder + ';'"
            placeholder="详细描述，例如：在哪个页面、做了什么操作、出现了什么情况"
            :placeholder-class="layout.isWide ? 'field-ph-wide' : 'field-ph'"
            :maxlength="5000"
          />
        </view>
        <text class="hint" :class="layout.isWide ? 'hint-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12)">{{ content.length }}/5000</text>
      </view>

      <!-- 联系方式（选填） -->
      <view class="card" :class="layout.isWide ? 'card-wide' : ''" :style="cardStyle">
        <text class="label" :class="layout.isWide ? 'label-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(27, 16)">联系方式（选填）</text>
        <view class="field-row" :class="layout.isWide ? 'field-row-wide' : ''" :style="rowStyle">
          <input
            :value="contact"
            @input="onContactInput"
            class="field-input" :class="[[layout.isWide ? 'field-input-wide' : ''], layout.isWide ? 'field-input-wide' : '']"
            :style="inputStyle"
            :placeholder-style="'color:' + themeStore.skin.placeholder + ';'"
            placeholder="邮箱 / QQ / 微信，方便回访"
            :placeholder-class="layout.isWide ? 'field-ph-wide' : 'field-ph'"
            :maxlength="64"
          />
        </view>
      </view>

      <view class="submit-wrap" :class="layout.isWide ? 'submit-wrap-wide' : ''">
        <qt-button label="提交反馈" size="lg" :disabled="submitting" @click="doSubmit" />
        <text class="privacy" :class="layout.isWide ? 'privacy-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12)">提交后设备信息与版本号将一并上传，便于定位问题</text>
      </view>
    </scroll-view>
  </view>
  </qt-page-frame>
</template>
<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import { ref, computed, onUnmounted } from "vue";
import { onLoad } from "@dcloudio/uni-app";
import QtSegmented from "@/uni_modules/qt-ui/components/qt-segmented/qt-segmented.uvue";
import QtButton from "@/uni_modules/qt-ui/components/qt-button/qt-button.uvue";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtContentWidth } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { submitFeedback } from "@/services/feedback";
import { qtTrackPage } from "@/uni_modules/qt-stat";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";

const themeStore = useThemeStore();
const layout = useQtLayout();
// 皮肤令牌：卡片底与描边 / 输入行底 / 输入文字。
// 这些原先由手写的深色覆盖类写死成 graphite 色值，换 linen/aurora 等皮肤时不跟着变；
// 本仓库没有 CSS 变量，只能内联输出 skin 令牌。
const cardStyle = computed((): string => "background-color:" + themeStore.skin.surface + ";border-color:" + themeStore.skin.border + ";");
const rowStyle = computed((): string => "background-color:" + themeStore.skin.surfaceMuted + ";");
const inputStyle = computed((): string => "color:" + themeStore.skin.text + ";");

/**
 * 宽屏表单宽度改由 use-qt-widths 的 form 档给出（560-720），不再写死 420px。
 * 420px 是改造前按「手机拉宽一点」估的，桌面端一行只能放两个字，比手机还挤。
 */
const wideScrollStyle = computed((): string => layout.isWide ? "width:" + qtContentWidth("form") + "px;" : "");

const typeIndex = ref(0);
const type = computed(() => (typeIndex.value == 1 ? "request" : "issue"));
const title = ref("");
const content = ref("");
const contact = ref("");
const submitting = ref(false);
/** 提交成功后延迟返回的定时器：页面卸载时必须清掉，避免在已注销的实例上触发回调 */
let submitNavTimer: number | null = null;

function onTypeChange(index: number): void {
  typeIndex.value = index;
}

function onTitleInput(e: InputEvent): void {
  title.value = String((e.detail as any).value ?? "");
}
function onContentInput(e: InputEvent): void {
  content.value = String((e.detail as any).value ?? "");
}
function onContactInput(e: InputEvent): void {
  contact.value = String((e.detail as any).value ?? "");
}

async function doSubmit(): Promise<void> {
  if (submitting.value) return;
  const t = title.value.trim();
  const c = content.value.trim();
  if (t.length == 0) {
    qtShowToast({ title: "请填写标题", icon: "none" });
    return;
  }
  if (c.length == 0) {
    qtShowToast({ title: "请填写内容", icon: "none" });
    return;
  }
  submitting.value = true;
  try {
    await submitFeedback(type.value, t, c, contact.value.trim());
    qtShowToast({ title: "提交成功", icon: "success" });
    submitNavTimer = setTimeout(() => {
      uni.navigateBack({});
    }, 600) as number;
  } catch (e) {
    qtShowToast({ title: (e as Error).message || "提交失败", icon: "none" });
  } finally {
    submitting.value = false;
  }
}

onLoad(() => {
  qtTrackPage("pages/feedback/submit");
});
onUnmounted(() => {
  if (submitNavTimer != null) {
    clearTimeout(submitNavTimer);
    submitNavTimer = null;
  }
});
</script>

<style>
.page {
  flex: 1;
}

.scroll {
  flex: 1;
}
.card {
  margin: 20rpx 24rpx 0;
  padding: 28rpx 24rpx;
  border-width: 1px; border-style: solid;
  border-radius: 20rpx;
}
.label {
  font-size: 27rpx;
  font-weight: 600;
}
.type-seg {
  margin-top: 18rpx;
}
.field-row {
  margin-top: 18rpx;
  flex-direction: row;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
}
.textarea-row {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
}
.field-input {
  flex: 1;
  height: 88rpx;
  font-size: 27rpx;
}
.field-textarea {
  width: 100%;
  height: 240rpx;
  font-size: 27rpx;
  line-height: 1.5;
}
.field-ph {
  font-size: 26rpx;
}
.hint {
  margin-top: 12rpx;
  font-size: 22rpx;
}
.submit-wrap {
  padding: 40rpx 48rpx 60rpx;
}
/* 提交按钮样式由 qt-button 组件承担（accent 跟随主题皮肤），此处的 .submit/.submit-wide 为遗留死样式已移除 */
.privacy {
  margin-top: 20rpx;
  font-size: 22rpx;
  text-align: center;
}

/* Vapor 宽屏：px 覆盖 rpx，1600x900 下避免按窗口比例放大 2.7 倍 */
.page-wide { align-items: center; }
.scroll-wide { width: 420px; }
.card-wide { width: 420px; margin: 14px 0 0; padding: 20px; border-radius: 14px; }
.label-wide { font-size: 16px; }
.type-seg-wide { margin-top: 12px; }
.hint-wide { margin-top: 8px; font-size: 12px; }
.field-row-wide { margin-top: 12px; height: 52px; padding: 0 18px; border-radius: 12px; }
.textarea-row-wide { margin-top: 12px; padding: 14px 18px; border-radius: 12px; }
.field-input-wide { height: 52px; font-size: 16px; }
.field-textarea-wide { height: 140px; font-size: 15px; }
.field-ph-wide { font-size: 15px; }
.submit-wrap-wide { padding: 24px 0 40px; }
.privacy-wide { margin-top: 10px; font-size: 12px; }
</style>
