<template>
  <qt-page-frame width-kind="flow">
    <view class="page">
      <scroll-view class="list" :class="layout.isWide ? 'list-wide' : ''" direction="vertical" :show-scrollbar="false">
        <view class="content" :class="layout.isWide ? 'content-wide' : ''">
          <view class="brand" :class="layout.isWide ? 'brand-wide' : ''">
            <image class="logo-img" :class="layout.isWide ? 'logo-img-wide' : ''" src="/static/icon/xxxhdpi.png" mode="aspectFill" />
            <text class="name" :class="layout.isWide ? 'name-wide' : ''" :style="textStyle + qtFontDual(36, 26)">轻听</text>
            <text class="version" :class="layout.isWide ? 'version-wide' : ''" :style="mutedStyle + qtFontDual(24, 14)">版本 {{ version }}</text>
            <text class="slogan" :class="layout.isWide ? 'slogan-wide' : ''" :style="mutedStyle + qtFontDual(24, 14)">用音乐连接每一刻</text>
          </view>

          <!-- 宽屏两列：关于页只有两组 5 行，单列在 1920 下会拉成 1312px 的窄条。
               两列时左列「应用与服务」(3 行)，右列「了解轻听」(2 行)，
               分组在数据层切开（qtSplitByHeight），不用 flex-wrap（两组高度不等会走锯齿）。 -->
          <view v-if="twoColumn" class="cols">
            <view class="col" :style="colStyle">
              <view v-for="g in columns[0]" :key="g.id">
                <text class="section-label section-label-wide" :style="mutedStyle + qtFontDual(22, 12)">{{ g.title }}</text>
                <view class="group group-wide" :style="groupStyle">
                  <view v-for="(c, ci) in g.cells" :key="c.key" class="cell cell-wide" :class="ci == g.cells.length - 1 ? 'cell-no-border' : ''" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="c.go">
                    <view class="icon-wrap icon-wrap-wide" :style="iconStyle">
                      <QtIcon :name="c.icon" :size="20" :color="theme.skin.accent" />
                    </view>
                    <text class="cell-title" :style="textStyle + qtFontDual(28, 16)">{{ c.title }}</text>
                    <text v-if="c.value.length > 0" class="cell-value cell-value-wide" :style="mutedStyle + qtFontDual(23, 13)">{{ c.value }}</text>
                    <QtIcon name="chevron-right" :size="16" :color="theme.skin.iconMuted" />
                  </view>
                </view>
              </view>
            </view>
            <view class="col col-right" :style="colStyle">
              <view v-for="g in columns[1]" :key="g.id">
                <text class="section-label section-label-wide" :style="mutedStyle + qtFontDual(22, 12)">{{ g.title }}</text>
                <view class="group group-wide" :style="groupStyle">
                  <view v-for="(c, ci) in g.cells" :key="c.key" class="cell cell-wide" :class="ci == g.cells.length - 1 ? 'cell-no-border' : ''" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="c.go">
                    <view class="icon-wrap icon-wrap-wide" :style="iconStyle">
                      <QtIcon :name="c.icon" :size="20" :color="theme.skin.accent" />
                    </view>
                    <text class="cell-title" :style="textStyle + qtFontDual(28, 16)">{{ c.title }}</text>
                    <text v-if="c.value.length > 0" class="cell-value cell-value-wide" :style="mutedStyle + qtFontDual(23, 13)">{{ c.value }}</text>
                    <QtIcon name="chevron-right" :size="16" :color="theme.skin.iconMuted" />
                  </view>
                </view>
              </view>
            </view>
          </view>

          <!-- 竖屏 / 中等宽度：单列（原样） -->
          <view v-else>
            <view v-for="g in groups" :key="g.id">
              <text class="section-label" :class="layout.isWide ? 'section-label-wide' : ''" :style="mutedStyle + qtFontDual(22, 12)">{{ g.title }}</text>
              <view class="group" :class="layout.isWide ? 'group-wide' : ''" :style="groupStyle">
                <view v-for="(c, ci) in g.cells" :key="c.key" class="cell" :class="[layout.isWide ? 'cell-wide' : '', ci == g.cells.length - 1 ? 'cell-no-border' : '']" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="c.go">
                  <view class="icon-wrap" :class="layout.isWide ? 'icon-wrap-wide' : ''" :style="iconStyle">
                    <QtIcon :name="c.icon" :size="layout.isWide ? 20 : 32" :color="theme.skin.accent" />
                  </view>
                  <text class="cell-title" :style="textStyle + qtFontDual(28, 16)">{{ c.title }}</text>
                  <text v-if="c.value.length > 0" class="cell-value" :class="layout.isWide ? 'cell-value-wide' : ''" :style="mutedStyle + qtFontDual(23, 13)">{{ c.value }}</text>
                  <QtIcon name="chevron-right" :size="layout.isWide ? 16 : 24" :color="theme.skin.iconMuted" />
                </view>
              </view>
            </view>
          </view>

          <text class="footer" :class="layout.isWide ? 'footer-wide' : ''" :style="mutedStyle + qtFontDual(22, 12)">© 2026 轻听音乐</text>
        </view>
      </scroll-view>
      <qt-upgrade-popup
        v-model:visible="popupVisible"
        :info="popupInfo"
        @closed="onPopupClosed"
      />
    </view>
  </qt-page-frame>
</template>

<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtContentWidth, qtSplitByHeight, QT_GUTTER_PX } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { computed, ref, onMounted } from "vue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import qtUpgradePopup from "@/uni_modules/qt-ui/components/qt-upgrade-popup/qt-upgrade-popup.uvue";
import type { AppUpdateInfo } from "@/services/upgrade";
import {
  checkAppUpdate,
  consumePendingUpdate,
} from "@/services/upgrade";
import { openInBrowser } from "@/services/app-native";
import { useDisclaimerStore } from "@/stores/disclaimer";
import { getVersionText } from "@/services/app-version";
import {
  OFFICIAL_AGREEMENT_URL,
  OFFICIAL_FEEDBACK_URL,
  OFFICIAL_PRIVACY_URL,
  OFFICIAL_SITE_URL,
} from "@/services/official-site";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";

const layout = useQtLayout();
const theme = useThemeStore();
const textStyle = computed((): string => "color:" + theme.skin.text + ";");
const mutedStyle = computed((): string => "color:" + theme.skin.textMuted + ";");
const groupStyle = computed((): string => "background-color:" + theme.skin.surface + ";border-color:" + theme.skin.border + ";");
const cellStyle = computed((): string => "border-bottom-color:" + theme.skin.divider + ";");
const iconStyle = computed((): string => "background-color:" + theme.skin.accentSoft + ";");

// 版本信息运行时从 manifest.json（uni.getAppBaseInfo）读取，发版无需改这里
const version = getVersionText();
const updateText = ref("点击检查");
const popupVisible = ref(false);
const popupInfo = ref<AppUpdateInfo | null>(null);

/**
 * 关于页的两组入口。原本是 42 行手写模板，两组结构完全相同（图标 + 标题 + 可选行尾值 + 箭头），
 * 改成数据驱动是为了**两列**：两列必须在数据层切开，模板层写死就只有单列。
 */
type AboutCell = { key: string; icon: string; title: string; value: string; go: () => void };
type AboutGroup = { id: string; title: string; cells: AboutCell[] };

const groups = computed((): AboutGroup[] => [
  {
    id: "app",
    title: "应用与服务",
    cells: [
      { key: "update", icon: "refresh", title: "检查更新", value: updateText.value, go: checkUpdate },
      { key: "agreement", icon: "info", title: "用户协议", value: "", go: openAgreement },
      { key: "privacy", icon: "lock", title: "隐私政策", value: "", go: openPrivacy },
      { key: "disclaimer", icon: "alert", title: "使用前请先阅读", value: "", go: openDisclaimer },
    ],
  },
  {
    id: "intro",
    title: "了解轻听",
    cells: [
      { key: "project", icon: "globe", title: "项目介绍与开源地址", value: "", go: openProjectIntro },
      { key: "feedback", icon: "feedback", title: "意见反馈", value: "", go: openFeedback },
    ],
  },
]);
//
// 两列门限按**可用宽度**判，不按窗口宽度判：三栏模式下窗口仍是 1280 但右栏只有约 400，
// 若按窗口判会算出两列各 320 直接横向溢出。判据 = 内容列宽减两侧留白与中间间距后
// 仍能放下两个最小分组列宽（420 × 2）。三栏收窄后自然退回单列。
//
const twoColumn = computed((): boolean => qtContentWidth("flow") - QT_GUTTER_PX * 2 - 16 >= 420 * 2);

/** 组高近似：行高 64px + 分组标题 14+8+12 */
const columns = computed((): [AboutGroup[], AboutGroup[]] => {
  const list = groups.value;
  const heights = list.map((g: AboutGroup): number => g.cells.length * 64 + 34);
  return qtSplitByHeight<AboutGroup>(list, heights);
});

/** 两列列宽：`flex-shrink:0` 必须写，否则两列按内容 min-content 比例收缩 → 不等宽 */
const colStyle = computed<string>(() => {
  const inner = qtContentWidth("flow") - QT_GUTTER_PX * 2 - 16;
  const w = Math.floor(inner / 2);
  return "width:" + (w > 320 ? w : 320) + "px;flex-shrink:0;";
});

onMounted(() => {
  // 启动检查发现新版本后，由 App.uvue 跳转过来，这里自动弹出升级弹窗
  const pending = consumePendingUpdate();
  if (pending != null) {
    updateText.value = "发现新版本";
    popupInfo.value = pending;
    popupVisible.value = true;
  }
});

function checkUpdate(): void {
  updateText.value = "检查中...";
  checkAppUpdate()
    .then((info) => {
      if (info != null) {
        updateText.value = "发现新版本";
        popupInfo.value = info;
        popupVisible.value = true;
      } else {
        updateText.value = "已是最新版本";
        qtShowToast({ title: "已是最新版本", icon: "none" });
      }
    })
    .catch(() => {
      updateText.value = "点击检查";
      qtShowToast({ title: "检查更新失败", icon: "none" });
    });
}

function onPopupClosed(): void {
  popupVisible.value = false;
  updateText.value = "点击检查";
}

/** 官网条款页（系统浏览器打开）：用户协议与隐私政策拆成两页，各自一个入口 */
function openAgreement(): void {
  openInBrowser(OFFICIAL_AGREEMENT_URL);
}

function openPrivacy(): void {
  openInBrowser(OFFICIAL_PRIVACY_URL);
}

/** 项目介绍与开源地址（官网首页：三个仓库的 GitHub / CNB 入口都在上面） */
function openProjectIntro(): void {
  openInBrowser(OFFICIAL_SITE_URL);
}

/** 意见反馈：官网的 GitHub / CNB 渠道 Issue 与 PR 页 */
function openFeedback(): void {
  openInBrowser(OFFICIAL_FEEDBACK_URL);
}

/**
 * 重新查看首次启动的免责声明：只展示，不写接受记录（要重新读满秒数）。
 * 正文由后台下发，离线时取不到 —— 提示一句，别留个点了没反应的死按钮。
 */
function openDisclaimer(): void {
  useDisclaimerStore()
    .reopen()
    .then((shown: boolean) => {
      if (!shown) {
        qtShowToast({ title: "暂时取不到声明内容，请检查网络后重试", icon: "none" });
      }
    })
    .catch(() => {
      qtShowToast({ title: "暂时取不到声明内容，请检查网络后重试", icon: "none" });
    });
}
</script>

<style>
.page {
  flex: 1;
  min-height: 0;
}
.list {
  flex: 1;
  padding: 16rpx 0 40rpx;
}
.list-wide { padding: 12px 0 24px; }
.content {
  margin-left: 24rpx;
  margin-right: 24rpx;
}
.content-wide { margin-left: 24px; margin-right: 24px; }
/* 两列容器：列内各自纵向堆叠，顶端对齐（默认 stretch 会把矮的那列拉高） */
.cols {
  flex-direction: row;
  align-items: flex-start;
  justify-content: center;
}
.col {
  flex-direction: column;
}
.col-right {
  margin-left: 16px;
}
.brand {
  padding: 20rpx 24rpx 12rpx;
  align-items: center;
}
.brand-wide {
  padding: 14px 20px 8px;
}
.logo-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
}
.logo-img-wide {
  width: 72px;
  height: 72px;
  border-radius: 18px;
}
.name {
  margin-top: 22rpx;
  font-weight: 700;
}
.name-wide {
  margin-top: 12px;
}
.version {
  margin-top: 8rpx;
}
.version-wide {
  margin-top: 6px;
}
.slogan {
  margin-top: 20rpx;
  text-align: center;
}
.slogan-wide {
  margin-top: 12px;
}
.section-label {
  margin: 20rpx 8rpx 12rpx;
  font-weight: 500;
}
.section-label-wide {
  margin: 14px 4px 8px;
}
.group {
  border-radius: 24rpx;
  overflow: hidden;
  border-width: 1px;
  border-style: solid;
}
.group-wide {
  border-radius: 14px;
}
.cell {
  min-height: 96rpx;
  padding: 12rpx 32rpx;
  flex-direction: row;
  align-items: center;
  border-bottom-width: 1px;
  border-bottom-style: solid;
}
/* 桌面指针反馈：只在宽屏启用（手机上 hover-class 会在点按瞬间闪一下） */
.cell-hover {
  background-color: rgba(255, 255, 255, 0.06);
}
.cell-no-border {
  border-bottom-width: 0;
}
.cell-wide {
  min-height: 64px;
  padding: 10px 24px;
}
.icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}
.icon-wrap-wide {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  margin-right: 12px;
}
.cell-title {
  flex: 1;
  font-weight: 500;
}
.cell-value {
  margin-left: 12rpx;
  margin-right: 10rpx;
  flex-shrink: 1;
  text-align: right;
}
.cell-value-wide {
  margin-left: 8px;
  margin-right: 6px;
}
.footer {
  margin-top: 44rpx;
  text-align: center;
}
.footer-wide {
  margin-top: 28px;
}
</style>
