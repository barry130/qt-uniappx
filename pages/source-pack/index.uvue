  margin-top: 4rpx;
  font-size: 24rpx;
}

/* 聚合搜索音源下拉多选：展开后的药丸 wrap（点摘要行开合，药丸点击即切换） */
.ag-wrap {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  padding: 18rpx 0 20rpx;
  border-bottom-width: 1px;
  border-bottom-style: solid;
}
