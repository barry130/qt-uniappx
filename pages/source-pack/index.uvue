  padding: 10px 0 12px;
}

/* 分隔线由 QtOption 自己画（.qo-row 的 border-bottom + theme.skin.divider）；
   外层再画一条会在行间出现两条线、且行尾多出 18rpx 的细缝（2026-11-02 审阅） */
.pack-row {
  flex-direction: row;
  align-items: center;
  padding: 18rpx 0;
}
