<template>
  <qt-page-frame width-kind="flow" :max-width="720">
    <scroll-view class="pack-scroll" direction="vertical" :show-scrollbar="false">
      <view class="pack-content" :class="layout.isWide ? 'pack-content-wide' : ''">
        <!-- 官网教程入口置顶强调（2026-11-02 用户要求，对齐 qt-pc 设置页「如何设置音源」置顶条）：
             accent 弱化底 + accent 半透明描边 + 「查看教程」胶囊，和下面的信息卡明显区分；
             整条可点，点开就是官网教程页（装包方式 / 换源 / 音质 / 故障速查都在那一页）。 -->
        <view class="guide-banner" :class="layout.isWide ? 'guide-banner-wide' : ''" :style="guideBannerStyle" @click="openSourceSetupGuide">
          <QtIcon class="guide-banner-icon" name="globe" :size="layout.isWide ? 20 : 38" :color="theme.skin.accent" />
          <view class="guide-banner-main">
            <view class="guide-banner-head">
              <text class="guide-banner-title" :style="('color:' + theme.skin.accent + ';') + qtFontDual(28, 15)">如何设置音源包</text>
              <text class="guide-banner-tag" :class="layout.isWide ? 'guide-banner-tag-wide' : ''" :style="guideBannerTagStyle">{{ guideBannerTag }}</text>
            </view>
            <text class="guide-banner-sub" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 12)">三种安装方式、换源、音质与装不上排查</text>
          </view>
          <view class="guide-banner-cta" :class="layout.isWide ? 'guide-banner-cta-wide' : ''" :style="guideBannerCtaStyle">
            <text class="guide-banner-cta-text" :style="('color:' + theme.skin.accent + ';') + qtFontDual(22, 12)">查看教程</text>
            <QtIcon name="chevron-right" :size="layout.isWide ? 16 : 26" :color="theme.skin.accent" />
          </view>
        </view>

        <qt-card class="pack-card" title="当前状态" description="数据包决定搜索/歌单/歌词的数据来源；播放包决定在线播放取链。" elevated>
          <view class="status-row" :style="rowBorderStyle">
            <QtIcon class="status-icon" name="disc" :size="layout.isWide ? 20 : 32" :color="theme.skin.accent" />
            <view class="status-main">
              <text class="status-key" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">数据包</text>
              <text class="status-value" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ metaStatusText() }}</text>
            </view>
          </view>
          <view class="status-row" :style="rowBorderStyle">
            <QtIcon class="status-icon" name="music" :size="layout.isWide ? 20 : 32" :color="theme.skin.accent" />
            <view class="status-main">
              <text class="status-key" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">播放包</text>
              <text class="status-value" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ playStatusText() }}</text>
            </view>
          </view>
          <view class="status-row status-row-last">
            <QtIcon class="status-icon" name="info" :size="layout.isWide ? 20 : 32" :color="theme.skin.iconMuted" />
            <view class="status-main">
              <text class="status-key" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">引擎</text>
              <text class="status-value" :style="('color:' + (engineFailed() ? theme.skin.danger : theme.skin.textMuted) + ';') + qtFontDual(24, 14)">{{ engineStatusText() }}</text>
            </view>
          </view>
          <!-- 音源账号入口已移到设置页 qt-settings-overview（2026-10-28 用户决定） -->
        </qt-card>

        <qt-card class="pack-card" title="聚合搜索音源" description="搜索页「聚合搜索」参与合并的音源；全不选 = 全部音源。改动立即生效，搜索页会自动刷新进行中的聚合结果。">
          <view class="status-row" :style="rowBorderStyle" @click="agOpen = !agOpen">
            <QtIcon class="status-icon" name="headset" :size="layout.isWide ? 20 : 32" :color="theme.skin.accent" />
            <view class="status-main">
              <text class="status-key" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">参与聚合的音源</text>
              <text class="status-value" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ agSummary }}</text>
            </view>
            <QtIcon name="chevron-down" :size="layout.isWide ? 18 : 28" :color="theme.skin.textMuted" />
          </view>
          <view v-if="agOpen" class="ag-wrap" :class="layout.isWide ? 'ag-wrap-wide' : ''" :style="rowBorderStyle">
            <QtOption kind="chip" label="全部" :selected="agAllSelected" @select="agUseAll" />
            <QtOption v-for="row in agRows" :key="'ag-' + row.id" kind="chip" :label="row.name" :selected="row.on" @select="agToggle(row.id)" />
          </view>
        </qt-card>

        <qt-card class="pack-card" title="数据包" description="多包共存、各启用其一；卸载后在线搜索/歌单/歌词及在线播放不可用，本地音乐不受影响。">
          <view v-if="metaRows.length == 0" class="pack-empty">
            <text class="pack-empty-text" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">未安装任何数据包，可从下方「安装音源包」入口安装；未装时仅本地音乐可用。</text>
          </view>
          <view v-for="row in metaRows" :key="'m-' + row.id" class="pack-row">
            <QtOption class="pack-row-main" kind="row" :label="row.name" :description="row.sub" :selected="row.active" @select="!row.active && runSourceActivate(row.id)" />
            <qt-button v-if="row.id.length > 0" class="pack-row-btn" label="卸载" variant="ghost" size="sm" @click="runSourceUninstall(row.id)" />
          </view>
        </qt-card>

        <qt-card class="pack-card" title="播放包" description="播放包不内置（版权原因）：未安装时在线播放不可用，本地音乐与数据功能互不影响。">
          <view v-if="playRows.length == 0" class="pack-empty">
            <text class="pack-empty-text" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">未安装任何播放包，可从下方「安装音源包」入口安装。</text>
          </view>
          <view v-for="row in playRows" :key="'p-' + row.id" class="pack-row">
            <QtOption class="pack-row-main" kind="row" :label="row.name" :description="row.sub" :selected="row.active" @select="!row.active && runSourceActivate(row.id)" />
            <qt-button class="pack-row-btn" label="卸载" variant="ghost" size="sm" @click="runSourceUninstall(row.id)" />
          </view>
        </qt-card>

        <qt-card class="pack-card" title="可用更新" description="各包自述更新地址 + 官方清单双渠道发现；仅提示，确认后才更新。">
          <view class="check-row">
            <qt-button class="check-btn" label="检查更新" variant="outline" size="sm" @click="runSourceCheck" />
            <text class="check-hint" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 12)">更新前会做装载自检，失败自动回滚。</text>
          </view>
          <view v-if="offerRows.length == 0" class="pack-empty">
            <text class="pack-empty-text" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">当前没有待应用的更新。</text>
          </view>
          <view v-for="row in offerRows" :key="'u-' + row.id" class="pack-row" :class="row.last ? 'pack-row-last' : ''">
            <view class="pack-row-main">
              <text class="pack-row-name" :style="('color:' + theme.skin.accent + ';') + qtFontDual(27, 15)">{{ row.label }}</text>
            </view>
            <qt-button class="pack-row-btn" label="更新" variant="secondary" size="sm" @click="runSourceApplyUpdate(row.id)" />
          </view>
        </qt-card>

        <qt-card class="pack-card pack-card-last" title="安装音源包" description="数据包 / 播放包机制一致：单文件 .js，首行自述身份（kind/id/版本），同 id 新版本原地替换。">
          <view class="install-row">
            <qt-button class="install-btn" label="从链接安装" variant="secondary" size="sm" @click="openUrlSheet" />
            <qt-button class="install-btn" label="从本地文件安装" variant="outline" size="sm" @click="runSourceInstallFile" />
          </view>
          <text class="install-hint" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 12)">链接需为 https 直链；本地安装支持微信/QQ/网盘下载的 .js 文件。装完不抢已有生效位，首个包自动生效。</text>
        </qt-card>
      </view>
    </scroll-view>

    <!-- 从链接安装：页内输入弹层（uni.showModal 的 editable 输入框在 App 端不渲染） -->
    <QtSheet v-model:visible="urlSheetVisible" title="从链接安装" subtitle="粘贴音源包 .js 文件的 https 直链" @close="closeUrlSheet">
      <view class="url-body" :class="layout.isWide ? 'url-body-wide' : ''">
        <input
          class="url-input"
          :class="layout.isWide ? 'url-input-wide' : ''"
          :style="layout.isWide ? urlInputStyleWide : urlInputStyle"
          :value="urlSheetValue"
          @input="onUrlSheetInput"
          placeholder="https://example.com/pack.js"
          :placeholder-class="layout.isWide ? 'url-ph-wide' : 'url-ph'"
          :maxlength="2048"
          :focus="urlSheetVisible"
        />
        <text v-if="urlSheetError.length > 0" class="url-error" :class="layout.isWide ? 'url-error-wide' : ''" :style="('color:' + theme.skin.danger + ';') + qtFontDual(22, 12)">{{ urlSheetError }}</text>
        <view class="url-btn-row" :class="layout.isWide ? 'url-btn-row-wide' : ''">
          <qt-button class="url-btn" label="取消" variant="ghost" size="sm" @click="closeUrlSheet" />
          <qt-button class="url-btn" label="下载并校验" variant="secondary" size="sm" @click="submitUrlSheet" />
        </view>
      </view>
    </QtSheet>
  </qt-page-frame>
</template>
<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import { qtConfirm } from "@/services/confirm";
import { computed, ref } from "vue";
import { onShow, onUnload } from "@dcloudio/uni-app";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import QtCard from "@/uni_modules/qt-ui/components/qt-card/qt-card.uvue";
import QtButton from "@/uni_modules/qt-ui/components/qt-button/qt-button.uvue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtOption from "@/uni_modules/qt-ui/components/qt-option/qt-option.uvue";
import QtSheet from "@/uni_modules/qt-ui/components/qt-sheet/qt-sheet.uvue";
import { useThemeStore, qtAccentRgba } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { engineStatus, engineVersion, lastEngineError, loadedPlayPackId, playPackReady } from "@/services/source-engine";
import { packsOfKind, activePack, activeMetaPack, packById, isOfficialPackId, PACK_KIND_META, PACK_KIND_PLAY } from "@/services/source-bundle-fs";
import { verifyOfficialSignature } from "@/services/pack-signature";
import type { SourcePackMeta } from "@/services/source-bundle-fs";
import { discoverUpdates, applyUpdate, installFromText, downloadPackText, uninstallPack, activatePack, pickSmokeSongs, pendingUpdates, syncSourceUpdateBadge, offerLabel } from "@/services/source-update";
import type { PackUpdateOffer } from "@/services/source-update";
import { parsePackHeader, UNSUPPORTED_PACK_MESSAGE, isJsPackFileName } from "@/services/source-pack-header";
import { openInBrowser, pickJsFile } from "@/services/app-native";
import { OFFICIAL_SOURCE_SETUP_URL } from "@/services/official-site";
import { useSourceUpdateStore } from "@/stores/source-update";
import { useSourceRegistryStore } from "@/stores/source-registry";
import { platformLabel } from "@/services/platform";
import { readAggregateSources, saveAggregateSources, AGGREGATE_SOURCES_CHANGED_EVENT } from "@/services/aggregate-sources";
import { beginLoading, finishLoading } from "@/services/ui-loading";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";

/**
 * 音源包管理独立页（v3 统一包模型）：当前状态 / 数据包 / 播放包 /
 * 可用更新 / 安装入口五块。状态都在非响应式的 service 里，用 refreshTick 做一次
 * 重算触发（与设置页摘要行同一套路），任何操作完成后 bump 一下即可整页刷新。
 */
const theme = useThemeStore();
const layout = useQtLayout();
const sourceUpdateStore = useSourceUpdateStore();
const sourceRegistry = useSourceRegistryStore();
const refreshTick = ref(0);

// ── 聚合搜索音源白名单（对齐 qt-pc 设置页「聚合搜索音源」）──
// null = 全部；勾选状态读 storage，操作后 refreshTick 触发重算并广播给搜索页。
type AgRow = { id: string; name: string; on: boolean; last: boolean };
const agOpen = ref(false);
const agRows = computed((): AgRow[] => {
  void refreshTick.value;
  const ids = sourceRegistry.sourceIds();
  const wl = readAggregateSources();
  const out: AgRow[] = [];
  for (let i = 0; i < ids.length; i++) {
    out.push({
      id: ids[i],
      name: platformLabel(ids[i]),
      on: wl == null ? true : wl.indexOf(ids[i]) != -1,
      last: i == ids.length - 1,
    });
  }
  return out;
});
const agAllSelected = computed((): boolean => {
  void refreshTick.value;
  return readAggregateSources() == null;
});
/** 摘要行文案：全部音源 / 已选 N/M（收起时一眼看出当前范围） */
const agSummary = computed((): string => {
  const rows = agRows.value;
  if (agAllSelected.value || rows.length == 0) return "全部音源";
  let on = 0;
  for (let i = 0; i < rows.length; i++) {
    if (rows[i].on) on++;
  }
  return on > 0 ? "已选 " + on + " / " + rows.length : "全部音源";
});
// ── 音源账号入口已移到设置页 qt-settings-overview（2026-10-28 用户决定），本页不再持有任何账号摘要 ──
function agUseAll(): void {
  saveAggregateSources([]);
  refreshTick.value++;
  uni.$emit(AGGREGATE_SOURCES_CHANGED_EVENT);
}
function agToggle(id: string): void {
  const ids = sourceRegistry.sourceIds();
  const current = readAggregateSources();
  let next: string[] = [];
  if (current == null) {
    // 「全部」里去掉一个：从全量 id 里剔除
    for (let i = 0; i < ids.length; i++) {
      if (ids[i] != id) next.push(ids[i]);
    }
  } else {
    next = current.slice(0);
    const idx = next.indexOf(id);
    if (idx != -1) next.splice(idx, 1);
    else next.push(id);
  }
  // 全不选 = 全部音源（services/aggregate-sources.ts 的归一语义）
  saveAggregateSources(next);
  refreshTick.value++;
  uni.$emit(AGGREGATE_SOURCES_CHANGED_EVENT);
}

/** 聚合音源药丸样式（展开区）：选中 accent 底，未选中描边 */
const agPillStyle = computed<string>(() => "border-color:" + theme.skin.divider + ";");
const agPillOnStyle = computed<string>(() => "background-color:" + theme.skin.accent + ";border-color:" + theme.skin.accent + ";");

type PackRow = { id: string; name: string; sub: string; active: boolean; last: boolean };
type OfferRow = { id: string; label: string; last: boolean };

/** 行底分隔线颜色（主题切换时随 skin 重算） */
const rowBorderStyle = computed<string>(() => "border-bottom-color:" + theme.skin.divider + ";");

/**
 * 置顶教程条的强调底色与描边（随皮肤联动）：底色用 accentSoft，描边用半透明 accent，
 * 比下面的纯白 qt-card 明显跳出来一档，但不会像整块实心 accent 那样抢过页面主体。
 */
const guideBannerStyle = computed<string>(() => "background-color:" + theme.skin.accentSoft + ";border-color:" + qtAccentRgba(theme.skin, 0.35) + ";");
/** 置顶教程条的角标：accent 实底 + onAccent 文字，是全页唯一的强对比小块 */
const guideBannerTagStyle = computed<string>(() => "background-color:" + theme.skin.accent + ";color:" + theme.skin.onAccent + ";" + qtFontDual(19, 11));
/** 「查看教程」胶囊的描边（半透明 accent，比角标弱一档，避免两处都在喊） */
const guideBannerCtaStyle = computed<string>(() => "border-color:" + qtAccentRgba(theme.skin, 0.5) + ";");
/** 角标文案跟着安装状态走：包没装齐时提醒「还没装完」，都装齐了就只是「推荐先看」 */
const guideBannerTag = computed((): string => {
  void refreshTick.value;
  return activeMetaPack() == null || activePack() == null ? "还没装齐" : "推荐先看";
});

/** 数据包行：已安装数据包（不设「停用」入口，不用就卸载）；last 行不带分隔线 */
const metaRows = computed((): PackRow[] => {
  const _tick = refreshTick.value;
  const meta = activeMetaPack();
  const rows: PackRow[] = [];
  const list = packsOfKind(PACK_KIND_META);
  for (let i = 0; i < list.length; i++) {
    const p = list[i];
    rows.push({ id: p.id, name: p.name, sub: packSubText(p, ""), active: meta != null && meta.id == p.id, last: i == list.length - 1 } as PackRow);
  }
  return rows;
});

/** 播放包行：生效中 = 引擎已热装载且就是它；生效位是它但未热装载 = 待生效 */
const playRows = computed((): PackRow[] => {
  const _tick = refreshTick.value;
  const active = activePack();
  const list = packsOfKind(PACK_KIND_PLAY);
  const rows: PackRow[] = [];
  for (let i = 0; i < list.length; i++) {
    const p = list[i];
    const isActive = active != null && active.id == p.id;
    const live = isActive && playPackReady() && loadedPlayPackId() == p.id;
    rows.push({ id: p.id, name: p.name, sub: packSubText(p, isActive && !live ? "待生效" : ""), active: isActive, last: i == list.length - 1 } as PackRow);
  }
  return rows;
});

/** 包行次要信息：版本 · 来源 · 日期 ·（生效状态）·（上次失败） */
function packSubText(p: SourcePackMeta, status: string): string {
  const parts: string[] = ["v" + p.versionName];
  const src = installSourceLabel(p.installSource);
  if (src.length > 0) parts.push(src);
  parts.push(shortDate(p.updatedAt));
  if (status.length > 0) parts.push(status);
  const sub = parts.join(" · ");
  if (p.lastError.length > 0) {
    return sub + "\n上次失败：" + truncateText(p.lastError, 30);
  }
  return sub;
}

function installSourceLabel(s: string): string {
  if (s == "url") return "链接安装";
  if (s == "file") return "本地安装";
  if (s == "manifest") return "官方渠道";
  return "";
}

/** 毫秒时间戳 → 短日期（同年省年份） */
function shortDate(ms: number): string {
  if (ms <= 0) return "";
  const d = new Date(ms);
  const now = new Date();
  const md = (d.getMonth() + 1 < 10 ? "0" : "") + (d.getMonth() + 1) + "-" + (d.getDate() < 10 ? "0" : "") + d.getDate();
  return d.getFullYear() == now.getFullYear() ? md : d.getFullYear() + "-" + md;
}

function truncateText(s: string, max: number): string {
  return s.length > max ? s.substring(0, max) + "…" : s;
}

const offerRows = computed((): OfferRow[] => {
  const _tick = refreshTick.value;
  const offers = pendingUpdates();
  const rows: OfferRow[] = [];
  for (let i = 0; i < offers.length; i++) {
    rows.push({ id: offers[i].targetId, label: offerLabel(offers[i]), last: i == offers.length - 1 } as OfferRow);
  }
  return rows;
});

function metaStatusText(): string {
  const _tick = refreshTick.value;
  const meta = activeMetaPack();
  return meta == null ? "未安装（在线搜索/歌单/歌词及在线播放不可用）" : meta.name + " v" + meta.versionName + "（生效中）";
}

function playStatusText(): string {
  const _tick = refreshTick.value;
  const active = activePack();
  if (active == null) {
    return engineStatus() == "failed" ? "未安装（引擎异常）" : "未安装（在线播放不可用）";
  }
  const live = playPackReady() && loadedPlayPackId() == active.id;
  return active.name + " v" + active.versionName + (live ? "（生效中）" : "（待生效）");
}

function engineFailed(): boolean {
  return engineStatus() == "failed";
}

function engineStatusText(): string {
  const _tick = refreshTick.value;
  const version = engineVersion();
  const base = version.length > 0 ? "引擎 v" + version : "引擎待启动";
  if (engineFailed() && lastEngineError().length > 0) {
    return base + " · 异常：" + lastEngineError();
  }
  return base;
}

function refreshSourceUi(): void {
  refreshTick.value++;
  sourceUpdateStore.refresh();
  syncSourceUpdateBadge();
}

/** 打开官网「如何设置音源包」教程（系统浏览器）：三种安装方式、换源、音质与排查都在那一页 */
function openSourceSetupGuide(): void {
  openInBrowser(OFFICIAL_SOURCE_SETUP_URL);
}

onShow(() => {
  sourceUpdateStore.refresh();
  sourceRegistry.ensure(); // 聚合音源行需要注册表清单（未就绪时空列表，就绪后 refreshTick 重算）
  refreshTick.value++;
  checkClipboardPackLink();
});

/**
 * 页面级操作令牌：onUnload 时作废，在途的异步回调（下载 / 验签 / applyUpdate /
 * 引擎重载）回来后先验令牌，失效就静默收手，不再碰页面与 loading。
 *
 * 这页的所有操作都是「弹 loading → 秒级 await → 收 loading」，用户在这期间按返回
 * 会直接销毁页面。框架的 uni-showLoading 内部对已销毁页面调 show/hide 会抛空指针
 * （NativeLoading.updateUI index.kt:84），所以令牌是这里的第一道防线，
 * ui-loading.uts 是第二道。
 */
let pageAlive: boolean = true;

onUnload(() => {
  pageAlive = false;
});

/** 剪贴板里已提示过的链接（同一链接一次会话只提示一次） */
let lastPromptedClip = "";

/** 端口号字符串 → 数值；非法（空/非数字/越界/0）返回 -1，逐字符累加避免 parseInt 的宽松解析 */
function portValue(port: string): number {
  let n = 0;
  for (let i = 0; i < port.length; i++) {
    const c = port.charCodeAt(i);
    if (c < 48 || c > 57) return -1;
    n = n * 10 + (c - 48);
    if (n > 65535) return -1;
  }
  return n >= 1 ? n : -1;
}

/** 常规主机名校验：每段非空、仅字母数字连字符、不以连字符开头结尾；至少两段或 localhost */
function isValidHostName(host: string): boolean {
  if (host.length == 0) return false;
  if (host == "localhost") return true;
  const labels = host.split(".");
  if (labels.length < 2) return false;
  for (let i = 0; i < labels.length; i++) {
    const lab = labels[i];
    if (lab.length == 0 || lab.startsWith("-") || lab.endsWith("-")) return false;
    for (let j = 0; j < lab.length; j++) {
      const c = lab.charCodeAt(j);
      const ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45;
      if (!ok) return false;
    }
  }
  return true;
}

/**
 * 严格校验音源包直链，返回错误文案；空串 = 通过。
 * 规则：**仅 https** 直链（明文 http 可被中间人替换包全文，而装包 = 注入代码到
 * 引擎 realm 执行，故不做兜底，与服务层 isSecurePackLink / downloadToTemp 同口径）；
 * 无空格/换行/制表；长度 ≤2048；主机合法（域名 ≥2 段、
 * localhost、IPv6 [..]，可带端口 1-65535）；路径以 / 开始、以 .js 结尾
 * （? 查询串和 # 锚点截断后再判）。剪贴板粗判与输入弹层共用这一套。
 */
function validatePackLink(raw: string): string {
  const t = raw.trim();
  if (t.length == 0) return "链接不能为空";
  if (t.length > 2048) return "链接过长（上限 2048 字符）";
  if (t.indexOf(" ") >= 0 || t.indexOf("\n") >= 0 || t.indexOf("\r") >= 0 || t.indexOf("\t") >= 0) {
    return "链接里不能包含空格或换行";
  }
  const isHttps = t.startsWith("https://");
  if (!isHttps) return "只支持 https:// 直链（明文 http 已禁用）";
  const rest = t.substring("https://".length);
  // 主机段：到第一条 / ? # 为止
  let hostEnd = rest.length;
  const slash = rest.indexOf("/");
  const q1 = rest.indexOf("?");
  const h1 = rest.indexOf("#");
  if (slash >= 0 && slash < hostEnd) hostEnd = slash;
  if (q1 >= 0 && q1 < hostEnd) hostEnd = q1;
  if (h1 >= 0 && h1 < hostEnd) hostEnd = h1;
  const hostPort = rest.substring(0, hostEnd);
  if (hostPort.length == 0) return "缺少主机名";
  // 主机与端口拆分：IPv6 走 [..] / [..]:port；否则最后一个冒号是端口分隔
  if (hostPort.startsWith("[")) {
    const close = hostPort.indexOf("]");
    if (close < 1) return "主机名不合法";
    const after = hostPort.substring(close + 1);
    if (after.length > 0) {
      if (!after.startsWith(":")) return "主机名不合法";
      if (portValue(after.substring(1)) < 0) return "端口不合法";
    }
  } else {
    let host = hostPort;
    const colon = hostPort.indexOf(":");
    if (colon >= 0) {
      host = hostPort.substring(0, colon);
      if (portValue(hostPort.substring(colon + 1)) < 0) return "端口不合法";
    }
    if (!isValidHostName(host)) return "主机名不合法";
  }
  // 路径：截掉 # 和 ? 后必须以 / 开始、.js 结尾
  let pathPart = rest.substring(hostEnd);
  const hashIdx = pathPart.indexOf("#");
  if (hashIdx >= 0) pathPart = pathPart.substring(0, hashIdx);
  const qIdx = pathPart.indexOf("?");
  if (qIdx >= 0) pathPart = pathPart.substring(0, qIdx);
  if (!pathPart.startsWith("/") || !pathPart.endsWith(".js")) {
    return "路径需以 / 开始且指向 .js 文件";
  }
  return "";
}

/** 粗判剪贴板内容是否是音源包直链：与输入弹层同一套严格规则 */
function looksLikePackUrl(s: string): boolean {
  return validatePackLink(s).length == 0;
}

/** 进页检测剪贴板：像音源包直链就提示一键安装（读取失败静默——部分系统限制后台读） */
function checkClipboardPackLink(): void {
  uni.getClipboardData({
    success: (res) => {
      const data = res.data != null ? res.data : "";
      if (!looksLikePackUrl(data)) return;
      const link = data.trim();
      if (link == lastPromptedClip) return;
      lastPromptedClip = link;
            qtConfirm({
        title: "检测到音源包链接",
        content: "剪贴板里有一个音源包直链：\n" + truncateText(link, 60) + "\n\n是否下载并安装？",
        confirmText: "安装",
        cancelText: "忽略",
      }).then((ok: boolean) => {
          if (ok) installFromLink(link);
      });
    },
    fail: (_e) => {},
  });
}

/** 从 https 直链安装：严格校验 → 下载全文 → 安装预览确认 → 统一安装管线 */
function installFromLink(url: string): void {
  const vErr = validatePackLink(url);
  if (vErr.length > 0) {
    qtShowToast({ title: vErr, icon: "none" });
    return;
  }
  const link = url.trim();
  const token = beginLoading("下载中");
  downloadPackText(link).then((text) => {
    finishLoading(token);
    if (text.length == 0) {
      qtShowToast({ title: "下载失败，请检查链接是否可直连", icon: "none" });
      return;
    }
    confirmAndInstall(text, "url", link);
  }).catch(() => {
    finishLoading(token);
    qtShowToast({ title: "下载失败，请重试", icon: "none" });
  });
}

/**
 * 安装预览：解析包头给用户过目再装（信息透明 + 官方 id 防仿冒）。
 * 自称 play-official/meta-official 的包先做 ed25519 签名校验：
 * 通过 → 预览标注「官方签名校验通过」正常安装（官方包也走直链/本地分发，
 *        签名通过即证明官方原版，不再按渠道加摩擦）；
 * 不通过 → 直接拒绝（文件被篡改或冒充，服务层还会再拦一道）。
 * 第三方包不需要签名，走原预览。manifest 渠道更新不经过这里。
 */
async function confirmAndInstall(text: string, source: string, ref: string): Promise<void> {
  const header = parsePackHeader(text);
  if (header == null) {
    // 带上收到内容的开头：链接装失败时用户能直接看出拉回来的是不是网页/空壳
    //（例如直链不通被网关回了个 HTML 错误页，安卓与鸿蒙的网络栈行为可能不同）
    const head = text.length > 60 ? text.substring(0, 60) + "…" : text;
    qtConfirm({
      title: "无法安装",
      content: UNSUPPORTED_PACK_MESSAGE + (text.length > 0 ? "\n\n收到内容开头：" + head : ""),
      showCancel: false,
    });
    return;
  }
  const kindLabel = header.kind == "meta" ? "数据包" : header.kind == "play" ? "播放包" : "未知类型（" + header.kind + "）";
  const refLine = ref.length > 0 ? "来源：" + truncateText(ref, 50) + "\n" : "";
  let content = "类型：" + kindLabel + "\n名称：" + (header.name.length > 0 ? header.name : header.id) + "\n版本：" + header.versionName + "（" + header.versionCode + "）\nid：" + header.id + "\n" + refLine;
  let confirmText = "安装";
  if (isOfficialPackId(header.id)) {
    const sigToken = beginLoading("校验签名");
    const check = await verifyOfficialSignature(text);
    finishLoading(sigToken);
    if (!check.ok) {
            qtConfirm({
        title: "官方包校验失败",
        content: "该文件自称官方" + (header.kind == "meta" ? "数据" : "播放") + "包，但签名校验未通过：" + check.message + "。可能不是官方原版或已被篡改，已拒绝安装。",
        showCancel: false,
      });
      return;
    }
    content += "✓ 官方签名校验通过\n";
  }
    qtConfirm({
    title: "安装音源包",
    content: content,
    confirmText: confirmText,
    cancelText: "取消",
    // R10-B：安装是重操作（写注册表+smoke 校验），必须给用户留取消入口；
    // 这里曾经 showCancel:false——cancelText 写了却不渲染，用户只能硬着头皮装
    showCancel: true,
  }).then((ok: boolean) => {
      if (!ok) return;
      const installToken = beginLoading("安装中");
      pickSmokeSongs().then((songs) => {
        return installFromText(text, songs, source, ref);
      }).then((r) => {
        finishLoading(installToken);
        if (!pageAlive) return;
        refreshSourceUi();
                qtConfirm({
          title: r.ok ? "安装完成" : "安装失败",
          content: r.message,
          showCancel: false,
        });
      }).catch(() => {
        finishLoading(installToken);
        if (!pageAlive) return;
        qtShowToast({ title: "安装失败，请重试", icon: "none" });
      });
  });
}

/** URL 输入弹层状态（uni.showModal 的 editable 在 App 端不出输入框，改页内弹层） */
const urlSheetVisible = ref(false);
const urlSheetValue = ref("");
const urlSheetError = ref("");

/** 弹层卡片底色与圆角（主题切换随 skin 重算；宽窄屏圆角基准不同） */
const urlCardStyle = computed<string>(() => "background-color:" + theme.skin.surfaceStrong + ";border-radius:24rpx;");
const urlCardStyleWide = computed<string>(() => "background-color:" + theme.skin.surfaceStrong + ";border-radius:14px;");
/** 输入框填充底色 + 文字色 */
const urlInputStyle = computed<string>(() => "background-color:" + theme.skin.surfaceInset + ";color:" + theme.skin.text + ";border-radius:14rpx;");
const urlInputStyleWide = computed<string>(() => "background-color:" + theme.skin.surfaceInset + ";color:" + theme.skin.text + ";border-radius:8px;");

/** 「从链接安装」入口：打开页内输入弹层（点遮罩或「取消」关闭） */
function openUrlSheet(): void {
  urlSheetValue.value = "";
  urlSheetError.value = "";
  urlSheetVisible.value = true;
}

function closeUrlSheet(): void {
  urlSheetVisible.value = false;
}

function onUrlSheetInput(e: InputEvent): void {
  urlSheetValue.value = e.detail.value;
  if (urlSheetError.value.length > 0) urlSheetError.value = "";
}

/** 提交：严格校验不过就在弹层里红字提示，过了关层走 installFromLink */
function submitUrlSheet(): void {
  const vErr = validatePackLink(urlSheetValue.value);
  if (vErr.length > 0) {
    urlSheetError.value = vErr;
    return;
  }
  urlSheetVisible.value = false;
  installFromLink(urlSheetValue.value);
}

/** 从本地 .js 文件安装（系统选择器；content URI 一次性读权限，原生侧读完带回全文） */
function runSourceInstallFile(): void {
  pickJsFile().then((picked) => {
    if (!picked.ok || picked.content.length == 0) {
      if (picked.message.length > 0) qtShowToast({ title: picked.message, icon: "none" });
      return;
    }
    if (!isJsPackFileName(picked.name)) {
      qtShowToast({ title: "请选择 .js 格式的音源文件", icon: "none" });
      return;
    }
    confirmAndInstall(picked.content, "file", picked.name);
  });
}

/** 检查更新：双渠道发现（force 跳过节流），发现到新版逐条列出、可一键全部更新 */
function runSourceCheck(): void {
  const checkToken = beginLoading("检查更新");
  discoverUpdates(true).then((offers) => {
    finishLoading(checkToken);
    if (!pageAlive) return;
    refreshSourceUi();
    if (offers.length == 0) {
      qtShowToast({ title: "所有音源包都已是最新版本", icon: "none" });
      return;
    }
    const lines: string[] = [];
    for (let i = 0; i < offers.length; i++) lines.push(offerLabel(offers[i]));
        qtConfirm({
      title: "发现 " + offers.length + " 个可用更新",
      content: lines.join("\n") + "\n\n是否立即下载并更新？（更新前会做装载自检，失败自动回滚）",
      confirmText: "全部更新",
      cancelText: "暂不",
    }).then((ok: boolean) => {
        if (!ok) return;
        runSourceApplyAll(offers);
    });
  }).catch(() => {
    finishLoading(checkToken);
    if (!pageAlive) return;
    qtShowToast({ title: "检查失败", icon: "none" });
  });
}

/** 依次应用一组更新（复用单条管线，含下载/校验/生效/回滚） */
async function runSourceApplyAll(offers: PackUpdateOffer[]): Promise<void> {
  let token = beginLoading("更新中");
  try {
    const songs = await pickSmokeSongs();
    for (let i = 0; i < offers.length; i++) {
      if (!pageAlive) return;
      const r = await applyUpdate(offers[i], songs);
      finishLoading(token);
      if (!pageAlive) return;
      refreshSourceUi();
      qtShowToast({ title: r.message, icon: "none", duration: 3000 });
      if (i < offers.length - 1) {
        token = beginLoading("更新中（" + (i + 2) + "/" + offers.length + "）");
      }
    }
  } catch (_) {
    finishLoading(token);
    if (!pageAlive) return;
    qtShowToast({ title: "更新失败，请重试", icon: "none" });
  } finally {
    // 兜底：任何提前 return / 异常路径都保证 loading 被收掉（页面已销毁则静默跳过）
    finishLoading(token);
  }
}

/** 应用单条可用更新（更新列表逐条「更新」按钮走这里） */
function runSourceApplyUpdate(id: string): void {
  const offers = pendingUpdates();
  let target: PackUpdateOffer | null = null;
  for (let i = 0; i < offers.length; i++) {
    if (offers[i].targetId == id) target = offers[i];
  }
  if (target == null) {
    qtShowToast({ title: "该更新已处理", icon: "none" });
    return;
  }
  const list: PackUpdateOffer[] = [target as PackUpdateOffer];
  runSourceApplyAll(list);
}

/** 启用一个已落盘的包（meta 重装引擎槽 / play 热装载 + 冒烟自检） */
function runSourceActivate(id: string): void {
  const actToken = beginLoading("启用中");
  pickSmokeSongs().then((songs) => {
    return activatePack(id, songs);
  }).then((r) => {
    finishLoading(actToken);
    if (!pageAlive) return;
    refreshSourceUi();
        qtConfirm({
      title: "启用音源包",
      content: r.message,
      showCancel: false,
    });
  }).catch(() => {
    finishLoading(actToken);
    if (!pageAlive) return;
    qtShowToast({ title: "启用失败", icon: "none" });
  });
}

/** 卸载一个包：生效中的播放包卸载后在线取链不可用；生效中的数据包卸载后数据面下线 */
function runSourceUninstall(id: string): void {
  const p = packById(id);
  if (p == null) {
    qtShowToast({ title: "该包已不存在", icon: "none" });
    return;
  }
  const active = activePack();
  const meta = activeMetaPack();
  const wasActive = (active != null && active.id == id) || (meta != null && meta.id == id);
  let consequence = "";
  if (p.kind == PACK_KIND_META) {
    consequence = wasActive ? "这是当前生效的数据包，卸载后在线搜索/歌单/歌词及在线播放将不可用（本地音乐不受影响）。" : "";
  } else {
    consequence = wasActive ? "这是当前生效的播放包，卸载后在线播放将不可用（本地音乐不受影响）。" : "";
  }
  const label = (p.kind == PACK_KIND_META ? "数据包" : "播放包") + " " + p.name + " v" + p.versionName;
    qtConfirm({
    title: "卸载音源包",
    content: "卸载「" + label + "」？" + consequence + "需要时可再从链接或本地文件安装。",
    confirmText: "卸载",
    cancelText: "取消",
  }).then((ok: boolean) => {
      if (!ok) return;
      const unToken = beginLoading("卸载中");
      uninstallPack(id).then((r) => {
        finishLoading(unToken);
        if (!pageAlive) return;
        refreshSourceUi();
        qtShowToast({ title: r.ok ? "已卸载" : r.message, icon: "none" });
      }).catch(() => {
        finishLoading(unToken);
        if (!pageAlive) return;
        qtShowToast({ title: "卸载失败，请重试", icon: "none" });
      });
  });
}
</script>
<style>
