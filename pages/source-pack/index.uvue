  line-height: 1.6;
}
/* 置顶教程条：整条可点，视觉上先从信息卡里跳出来（弱化 accent 底 + 半透明 accent 描边） */
.guide-banner {
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 22rpx 22rpx;
  border-width: 1px;
  border-style: solid;
  border-radius: 20rpx;
}
.guide-banner-wide {
  margin-bottom: 14px;
  padding: 13px 15px;
  border-radius: 12px;
}
.guide-banner-icon {
  margin-right: 16rpx;
}
.guide-banner-main {
  flex-direction: column;
  flex: 1;
  padding-right: 14rpx;
}
.guide-banner-head {
  flex-direction: row;
  align-items: center;
}
.guide-banner-title {
  font-size: 28rpx;
  font-weight: 600;
}
.guide-banner-tag {
  margin-left: 12rpx;
  padding: 3rpx 12rpx;
  border-radius: 10rpx;
}
.guide-banner-tag-wide {
  margin-left: 8px;
  padding: 2px 8px;
  border-radius: 6px;
}
.guide-banner-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
}
.guide-banner-cta {
  flex-direction: row;
  align-items: center;
  padding: 8rpx 14rpx;
  border-width: 1px;
  border-style: solid;
  border-radius: 24rpx;
}
