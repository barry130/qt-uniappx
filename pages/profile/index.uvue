<template>
  <qt-page-frame width-kind="grid" inset-top :refresh-key="refreshKey">
    <!-- 宽屏三栏（与设置页族同一套机制，2026-10-19 起）：中栏的「我的」总览由框架
         渲染，本页 slot 里自己的那一份在 wideSplit 时隐藏，只留宽屏工具托管层
         与（宽屏自隐的）竖屏 tab bar，右栏在进入子页前保持空态（同设置总览页）。
         竖屏 / 宽屏但内容列不足 876 时退回整页总览，观感与三栏化之前完全一致。 -->
    <view class="page" :style="pageRootStyle">
      <qt-profile-overview v-if="!wideSplit" :refresh-key="refreshKey" />
      <QtTabBar current="pages/profile/index" :dots="updateDotPaths" />
    </view>
    <!-- 宽屏 rail 工具入口的就地托管层（详见 qt-wide-workspace.ts），与首页那一份互斥渲染。
         2026-10-25 教训：不能挪到页面根做多根节点 —— 字节码模板渲染器直接
         std::runtime_error 崩溃（unsupported component sharedData source）。 -->
    <qt-wide-workspace host-route="/pages/profile/index" />
  </qt-page-frame>
</template>

<script setup lang="ts">
import { ref, computed } from "vue";
import { onShow, onBackPress } from "@dcloudio/uni-app";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import QtProfileOverview from "@/uni_modules/qt-ui/components/qt-profile-overview/qt-profile-overview.uvue";
import QtWideWorkspace from "@/uni_modules/qt-ui/components/qt-wide-workspace/qt-wide-workspace.uvue";
import QtTabBar from "@/uni_modules/qt-ui/components/qt-tab-bar/qt-tab-bar.uvue";
import { useQtTabBarSync } from "@/uni_modules/qt-ui/composables/use-qt-tab-bar";
import { useQtLayout, qtStatusBarPx } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtSplitActive } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { useDownloadsStore } from "@/stores/downloads";
import { useSourceUpdateStore } from "@/stores/source-update";
import { qtTrackPage } from "@/uni_modules/qt-stat";
import { qtCloseWideTool, qtWideWorkspaceRefresh } from "@/uni_modules/qt-ui/composables/qt-wide-workspace";
import { qtSwitchTab } from "@/uni_modules/qt-ui/composables/qt-nav";

/**
 * 「我的」hub 页（2026-10-19 起与设置页族同一套三栏逻辑）。
 *
 * UI 与数据全部在 qt-profile-overview 里：宽屏三栏模式下同一份总览还要出现在
 * 我的族子页（收藏/本地/下载/最近播放/听歌报告/音乐助手/反馈/关于/个人信息）的
 * 中间栏，两处必须是同一份实时数据（昵称/头像/签到/计数），抄两份必然漂移。
 * 本页只负责「宿主」该做的事：onShow 递增 refreshKey 通知总览重新对账，
 * 以及返回键（先关宽屏就地托管工具页，再回首页 tab）。
 */
const refreshKey = ref(0);
const layout = useQtLayout();
const downloads = useDownloadsStore();
const sourceUpdateStore = useSourceUpdateStore();

// 宽屏隐藏原生 tabbar（左侧 rail 取代），竖屏显示
useQtTabBarSync();
// 自绘导航后内容需自行让出状态栏；不再自己给 rail 让位 —— 框架的内容列已经把
// rail 扣掉了（qtContentWidth），页面再加 padding-left 会变成双重让位。
const pageRootStyle = computed<string>(() => "padding-top:" + (qtStatusBarPx() + 12) + "px;");
// 「我的」tab / 设置行红点：音源包有新包待生效时亮。
// rail 红点由 qt-page-frame 统一提供给 rail（见其 railDots），页面不再自己算；
// updateDotPaths 只留给竖屏的原生 tabBar 用。
const updateDotPaths = computed<string[]>(() => sourceUpdateStore.updatePending ? ["pages/profile/index"] : []);
// 宽屏三栏启用时框架在中栏代渲染总览，本页 slot 里自己的那一份不再画（避免双份并存）
const wideSplit = computed((): boolean => qtSplitActive(layout.isWide));

onShow(() => {
  qtTrackPage("pages/profile/index");
  // 宽屏托管覆盖层的可见性里有非响应式 qtTopRoute()，回宿主的瞬间强制重估一次
  qtWideWorkspaceRefresh();
  refreshKey.value = refreshKey.value + 1;
  downloads.restore();
  sourceUpdateStore.refresh();
});
// profile 是第二个 tab：返回键先关掉宽屏就地托管的工具页，再回到首页 tab
onBackPress((options: OnBackPressOptions): boolean => {
  if (options.from != "backbutton") return false;
  if (qtCloseWideTool()) return true;
  qtSwitchTab("/pages/home/index");
  return true;
});
</script>

<style>
.page {
  flex: 1;
  min-height: 0;
  flex-direction: column;
}
</style>
