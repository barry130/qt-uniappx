.skin-desc { margin-top: 8rpx; font-size: 21rpx; }
.skin-check { position: absolute; right: 18rpx; top: 18rpx; }
.wallpaper-preview { height: 250rpx; position: relative; overflow: hidden; border-radius: 18rpx; margin-bottom: 20rpx; }
.wallpaper-image { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.wallpaper-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.wallpaper-content { position: relative; z-index: 2; padding: 30rpx; justify-content: flex-end; flex: 1; }
.wallpaper-title { margin-top: 24rpx; font-size: 34rpx; font-weight: 700; }
