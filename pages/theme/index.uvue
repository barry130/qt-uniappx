.custom-label-wide { width: 64px; }
.custom-actions-wide { margin-top: 8px; }
.custom-button-wide { margin-right: 10px; }
.picker-panel-wide { margin-top: 10px; margin-bottom: 12px; padding: 14px; border-radius: 12px; }
.picker-head-wide { margin-bottom: 12px; }
.picker-block-wide { margin-bottom: 12px; }
.picker-rail-wide { height: 26px; border-radius: 8px; }
