<template>
  <qt-page-frame :full-width="true">
    <view class="page">
      <!-- 手机封面与歌词共用背景和前景，切换视图不换底色；宽屏保留媒体配色。 -->
      <view class="shade" :style="'background-color:' + (portraitPlayerMode ? portraitPalette.surface : theme.skin.mediaScrim) + ';'"></view>

      <view class="nav" :class="layout.isWide ? 'nav-wide' : ''" :style="navStyle">
        <view class="nav-btn" :class="layout.isWide ? 'nav-btn-wide' : ''" @click="back"><QtIcon name="chevron-left" :size="layout.isWide ? 20 : 32" :color="playerInk" /></view>
        <!-- 2026-10 用户定稿（m15536）：手机端导航中间不再显示「歌名 - 歌手 / 平台 + 码率」
             （信息挪到封面下方的曲名块），右上角由「更多」改为分享；宽屏导航中间本来就留白，
             标题在左列曲名块里，右栏整列给歌词，不需要导航标题。 -->
        <view class="nav-title-area" :class="layout.isWide ? 'nav-title-area-wide' : ''"></view>
        <view v-if="!layout.isWide" class="nav-btn" @click="shareCurrent"><QtIcon name="share" :size="32" :color="playerInk" /></view>
        <view v-else class="nav-btn" :class="layout.isWide ? 'nav-btn-wide' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="openMore"><QtIcon name="more" :size="20" :color="playerInk" /></view>
      </view>

      <view v-if="layout.isWide" class="wide-stage" :style="wideStageStyle">
        <view class="wide-body">
        <view class="wide-left">
          <view class="cover-card" :style="coverFadeStyle + wideCoverBoxStyle + 'background-color:' + theme.skin.mediaControl + ';border-color:' + theme.skin.mediaBorder + ';box-shadow:0 18px 46px ' + theme.skin.shadow + ';'">
            <view class="disc-spin">
              <image v-if="art() != ''" class="cover-img" :style="wideCoverImageStyle + 'background-color:' + theme.skin.mediaControl + ';'" :src="art()" mode="aspectFill" />
              <view v-else class="cover-img cover-empty" :style="wideCoverImageStyle + 'background-color:' + theme.skin.mediaControl + ';'"><QtIcon name="music" :size="Math.floor(wideCoverSize / 4)" :color="theme.skin.mediaMuted" /></view>
            </view>
          </view>
          <!-- 曲名块挪到封面下方（2026-10-25 用户定稿：参考网易云 Pad，左列 = 唱片 + 曲名，
               右列整列给歌词）。宽度与封面卡同宽，标题/歌手/平台签随卡片左对齐 -->
          <view class="track-head track-head-under" :style="'width:' + (wideCoverSize + 20) + 'px;'">
            <view class="track-copy">
              <!-- 两行口径（2026-10-25 用户定的）：第一行 歌名 - 歌手，第二行 平台 + 码率 -->
              <text class="track-title" :style="('color:' + theme.skin.mediaText + ';') + qtFontPx(18)" :max-lines="1">{{ name() }} - {{ artistText() }}</text>
              <!-- 宽屏同款「平台 + 码率」行（与竖屏 .nav-meta-row 同构，只是 px 口径） -->
              <view v-if="hasMeta()" class="track-meta-row">
                <text v-if="platformKey() != ''" class="track-meta-badge" :style="('background-color:' + platformColor(platformKey()) + ';color:#ffffff;') + qtFontPx(10)">{{ platformShortName() }}</text>
                <text v-if="bitrateKbps > 0" class="track-meta-bitrate" :style="('color:' + theme.skin.mediaMuted + ';') + qtFontPx(11)">{{ bitrateKbps }} kbps</text>
              </view>
            </view>
          </view>
        </view>

        <view class="wide-right mid" :style="'background-color:' + theme.skin.mediaSurface + ';border-color:' + theme.skin.mediaBorder + ';'" @touchstart="onTouchStart" @touchend="onTouchEnd">
          <scroll-view class="lyric lyric-viewport" direction="vertical" :scroll-top="lyricScrollTop" :scroll-with-animation="lyricScrollAnimated" :show-scrollbar="false" @scroll="onLyricUserScroll" @touchstart="onLyricScrollTouchStart">
            <view :style="'height:' + lyricPadStyle"></view>
            <view v-for="(line, index) in lyricLines" :key="index" class="lyric-line lyric-line-wide" :style="lineOpacityStyle(index)" @click.stop="onLyricLineTap(line, index)" @longpress.stop="copyLyric(line, index)">
              <!-- 逐行歌词顺序：词 / 罗马音 / 译文 / 滚动提示条。罗马音更贴近主行（与 PC PlayingPage.tsx:381 同口径） -->
              <view v-if="isKaraokeLine(line, index)" class="lrc-karaoke lrc-karaoke-wide">
                <view v-for="(word, wi) in line.words" :key="wi" class="lrc-karaoke-item lrc-karaoke-item-wide">
                  <text class="lrc-karaoke-word lrc-karaoke-word-wide" :style="karaokeWordStyle(wi)">{{ karaokeText(word.text) }}</text>
                  <view v-if="wi == karaokeWordIndex" class="lrc-karaoke-fill lrc-karaoke-fill-wide" :style="karaokeFillStyle()">
                    <text class="lrc-karaoke-word lrc-karaoke-word-wide" :style="karaokeLitStyle()">{{ karaokeText(word.text) }}</text>
                  </view>
                </view>
              </view>
              <text v-else class="lrc lrc-wide" :style="lrcStyle(index)" :class="index == activeLyric ? 'lrc-active' : ''" >{{ line.text }}</text>
              <text v-if="hasRoma(line)" class="lrc-roma lrc-roma-wide" :style="lrcRomaStyle(index)">{{ line.romanization }}</text>
              <text v-if="hasTr(line)" class="lrc-tr lrc-tr-wide" :style="lrcTrStyle(index)" :class="index == activeLyric ? 'lrc-tr-active' : ''" >{{ line.translation }}</text>
              <view v-if="lyricTimesVisible && index == lyricTargetIndex" class="lrc-scroll-hint lrc-scroll-hint-wide" :style="'background-color:' + theme.skin.mediaControl + ';'">
                <text class="lrc-hint-time lrc-hint-time-wide" :style="('color:' + theme.skin.mediaText + ';') + qtFontDual(24, 12)">{{ format(line.time) }}</text>
                <QtIcon name="play" :size="14" :color="theme.skin.mediaText" />
              </view>
            </view>
            <view v-if="lyricLines.length == 0" class="lyric-empty lyric-empty-wide"><text class="lrc-empty lrc-empty-wide" :style="qtFontDual(26, 15)">纯音乐，请欣赏</text></view>
            <view :style="'height:' + lyricPadStyle"></view>
          </scroll-view>
        </view>
        </view>

        <!-- 宽屏没有竖屏那条工具图标行，所以这一行只能落在进度条上方（右侧歌词面板与播放栏之间） -->
        <view v-if="lyricVisible" class="lyric-tools-row lyric-tools-row-wide" :class="wideShort ? 'lyric-tools-row-short' : ''">
          <view class="lyric-tool lyric-tool-wide" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="openOffset">
            <QtIcon name="sliders" :size="13" :color="currentOffsetMs != 0 ? theme.skin.accent : theme.skin.mediaMuted" />
            <text class="lyric-tool-text lyric-tool-text-wide" :style="('color:' + (currentOffsetMs != 0 ? theme.skin.accent : theme.skin.mediaMuted) + ';') + qtFontDual(22, 11)">{{ offsetButtonText() }}</text>
          </view>
          <!-- 搜索歌词入口常驻偏移旁边（与 qt-pc LyricSearchButton / PlayingPage.tsx:172-183 同口径）：
               原来的 v-else-if="noLyricYet" 门控只在「取不到词」时放行，而词挂错版本（有词但不对）
               时压根没有入口，只能盯着错词。无词时仍用 accent 强调，保留原来的提示强度。 -->
          <view v-if="lyricPicked" class="lyric-tool lyric-tool-wide" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="resetLyricPick">
            <QtIcon name="refresh" :size="13" :color="theme.skin.accent" />
            <text class="lyric-tool-text lyric-tool-text-wide" :style="('color:' + theme.skin.accent + ';') + qtFontDual(22, 11)">恢复自动</text>
          </view>
          <view class="lyric-tool lyric-tool-wide" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="openLyricSearch">
            <QtIcon name="search" :size="13" :color="noLyricYet ? theme.skin.accent : theme.skin.mediaMuted" />
            <text class="lyric-tool-text lyric-tool-text-wide" :style="('color:' + (noLyricYet ? theme.skin.accent : theme.skin.mediaMuted) + ';') + qtFontDual(22, 11)">搜索歌词</text>
          </view>
          <!-- 桌面歌词：参考网易云/QQ 音乐 Pad 播放页把「桌面歌词」放在歌词工具组里。
               之前只有「设置 - 桌面歌词」一个入口，平板上翻两层才找得到，属于 Parity 缺口。 -->
          <view class="lyric-tool lyric-tool-wide" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="toggleDesktopLyric">
            <QtIcon name="type" :size="13" :color="lyricOn ? theme.skin.accent : theme.skin.mediaMuted" />
            <text class="lyric-tool-text lyric-tool-text-wide" :style="('color:' + (lyricOn ? theme.skin.accent : theme.skin.mediaMuted) + ';') + qtFontDual(22, 11)">桌面歌词</text>
          </view>
        </view>

        <view class="progress-row progress-row-wide" :class="wideShort ? 'progress-row-short' : ''">
          <text class="prog-time prog-time-wide" :style="qtFontDual(20, 11)">{{ format(displayProgress) }}</text>
          <view class="prog-range" :class="layout.isWide ? 'prog-range-wide' : ''" @touchstart="onProgTouchStart" @touchmove="onProgTouchMove" @touchend="onProgTouchEnd" @touchcancel="onProgTouchCancel">
            <view class="prog-track prog-track-wide" :style="'background-color:' + theme.skin.mediaControl + ';'"></view>
            <view class="prog-fill prog-fill-wide" :style="'width:' + progPct() + '%;background-color:' + theme.skin.mediaText + ';'"></view>
            <view class="prog-thumb prog-thumb-wide" :style="'left:' + progThumbLeft() + 'px;background-color:' + theme.skin.mediaText + ';'"></view>
          </view>
          <text class="prog-time prog-time-wide" :style="qtFontDual(20, 11)">{{ format(player.duration) }}</text>
        </view>

          <!-- 横屏：左翼模式 / 中间播放键 / 右翼工具组，两翼等宽（flex:1）
               才能让播放键落在正中；工具组按设置增减时也不会把播放键带偏 -->
          <view class="controls controls-wide" :class="wideShort ? 'controls-short' : ''">
            <view class="control-wing control-wing-left">
              <view class="control-side" :class="wideShort ? 'control-side-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="cycleMode"><QtIcon :name="modeIconName()" :size="22" :color="theme.skin.mediaMuted" /></view>
            </view>
            <view class="control-center-wide">
              <view class="control-side" :class="wideShort ? 'control-side-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="player.previous()"><QtIcon name="skip-back" :size="24" :color="theme.skin.mediaMuted" /></view>
              <view class="icon-main icon-main-wide center-play" :class="wideShort ? 'icon-main-short' : ''" :style="'background-color:' + theme.skin.mediaText + ';'" @click="player.toggle()"><QtIcon :name="player.playing ? 'pause' : 'play'" :size="24" :color="theme.skin.mediaSurface" /></view>
              <view class="control-side" :class="wideShort ? 'control-side-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="player.next()"><QtIcon name="skip-forward" :size="24" :color="theme.skin.mediaMuted" /></view>
            </view>
            <view class="control-wing control-wing-right">
              <view class="control-tools-wide">
                <view v-if="toolVisible('like')" class="tool-btn" :class="wideShort ? 'tool-btn-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="openPicker($event)"><QtIcon :name="liked ? 'heart-fill' : 'heart'" :size="17" :color="liked ? theme.skin.danger : theme.skin.mediaMuted" /></view>
                <view v-if="toolVisible('download')" class="tool-btn" :class="wideShort ? 'tool-btn-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="doDownload"><QtIcon name="download" :size="17" :color="theme.skin.mediaMuted" /></view>
                <view v-if="toolVisible('artist')" class="tool-btn" :class="wideShort ? 'tool-btn-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="openArtistPage"><QtIcon name="user" :size="17" :color="theme.skin.mediaMuted" /></view>
                <view v-if="toolVisible('quality')" class="tool-btn" :class="wideShort ? 'tool-btn-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="switchQuality"><QtIcon name="music" :size="17" :color="theme.skin.mediaMuted" /></view>
                <view v-if="toolVisible('dislike')" class="tool-btn" :class="wideShort ? 'tool-btn-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="openDislikeSheet"><QtIcon name="ban" :size="17" :color="dislikedCurrent ? theme.skin.danger : theme.skin.mediaMuted" /></view>
                <view v-if="toolVisible('speed')" class="tool-btn" :class="wideShort ? 'tool-btn-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="cycleRate"><QtIcon name="gauge" :size="17" :color="theme.skin.mediaMuted" /></view>
                <view v-if="toolVisible('sleep')" class="tool-btn" :class="wideShort ? 'tool-btn-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="openSleep"><QtIcon name="clock" :size="17" :color="sleepActive ? theme.skin.accent : theme.skin.mediaMuted" /></view>
                <view v-if="toolVisible('share')" class="tool-btn" :class="wideShort ? 'tool-btn-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="shareCurrent"><QtIcon name="share" :size="17" :color="theme.skin.mediaMuted" /></view>
                <view v-if="toolVisible('equalizer')" class="tool-btn" :class="wideShort ? 'tool-btn-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="openEqualizer"><QtIcon name="sliders" :size="17" :color="theme.skin.mediaMuted" /></view>
                <view v-if="toolVisible('source')" class="tool-btn" :class="wideShort ? 'tool-btn-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="openSourceSwitch()"><QtIcon name="refresh" :size="17" :color="theme.skin.mediaMuted" /></view>
                <view class="tool-btn" :class="wideShort ? 'tool-btn-short' : ''" :style="'background-color:' + theme.skin.mediaControl + ';'" @click="openQueue"><QtIcon name="list" :size="17" :color="theme.skin.mediaMuted" /></view>
              </view>
            </view>
          </view>
      </view>

      <view v-else class="portrait-stage mid" @touchstart="onTouchStart" @touchend="onTouchEnd">
        <!-- 参考唱机：底座/转轮/传动带与银白唱臂静止，只有圆盘和实际封面转动。
             材质为透明 PNG；全部部件落在同一预算画布内，无原生阴影命中区。 -->
        <view v-if="!showLyric && portraitCoverSizeRpx > 0" class="disc-wrap" :style="portraitDiscWrapStyle">
          <image class="turntable-layer" src="/uni_modules/qt-ui/static/player-turntable/deck.png" mode="aspectFit" />
          <view class="disc-plate" :style="portraitDiscPlateStyle" @click="onDiscTap" @longpress="previewCover">
            <view class="disc-spin" ref="discSpinRef" :style="discSpinStyle">
              <image class="turntable-record" src="/uni_modules/qt-ui/static/player-turntable/record.png" mode="aspectFit" />
              <image v-if="art() != ''" class="disc-img-round" :style="portraitDiscImgStyle" :src="art()" mode="aspectFill" />
              <view v-else class="disc-img-round disc-img-empty" :style="portraitDiscImgStyle + 'background-color:' + theme.skin.coverPlaceholder + ';'"><QtIcon name="music" :size="Math.floor(portraitTurntable.coverRpx * 0.25)" :color="playerMuted" /></view>
            </view>
          </view>
          <image class="turntable-layer" src="/uni_modules/qt-ui/static/player-turntable/arm.png" mode="aspectFit" />
        </view>

        <!-- 两行高度优先于唱片尺寸；两个跑马灯实例各自测量和滚动，尾部控件不参与位移。 -->
        <view v-if="!showLyric" class="track-block" :style="portraitTrackStyle">
          <view class="track-row" :style="portraitTitleRowStyle">
            <QtMarquee :text="name()" :size-rpx="38" :size-px="24" :weight="600" :color="playerInk" :width-px="portraitTitleWidthPx" :active="pageVisible" />
            <text v-if="platformKey() != ''" class="track-badge" :style="portraitBadgeStyle + qtFontDual(18, 11)">{{ platformShortName() }}</text>
            <view class="track-like" @click="openPicker($event)">
              <QtIcon :name="liked ? 'heart-fill' : 'heart'" :size="36" :color="liked ? theme.skin.danger : playerMuted" />
            </view>
          </view>
          <view class="track-row track-row-artist" :style="portraitArtistRowStyle" @click="openArtistPage">
            <QtMarquee :text="artistText()" :size-rpx="28" :size-px="15" :weight="400" :color="playerInk" :width-px="portraitArtistWidthPx" :active="pageVisible" />
            <view class="track-artist-arrow"><QtIcon name="chevron-right" :size="24" :color="playerMuted" /></view>
            <!-- 本次播放实际用的是本地文件（本地曲库歌，或在线歌被本地优先命中）才显示 -->
            <text v-if="playingLocalFile" class="track-badge" :style="portraitLocalBadgeStyle + qtFontDual(20, 12)">本地文件</text>
          </view>
          <!-- 当前歌词复用已有时间轴；保留单行高度，切歌/空歌词不改变底部布局。 -->
          <view class="track-row track-row-lyric" :style="portraitLyricRowStyle" @click.stop="toggleLyric">
            <QtMarquee :text="portraitCurrentLyric" :size-rpx="26" :size-px="14" :weight="400" :color="playerMuted" :width-px="portraitLyricWidthPx" :active="pageVisible" />
          </view>
        </view>

        <scroll-view v-if="showLyric" class="lyric lyric-viewport" :style="portraitLyricStyle" direction="vertical" :scroll-top="lyricScrollTop" :scroll-with-animation="lyricScrollAnimated" :show-scrollbar="false" @click="toggleLyric" @scroll="onLyricUserScroll" @touchstart="onLyricScrollTouchStart">
          <view :style="'height:' + lyricPadStyle"></view>
          <view v-for="(line, index) in lyricLines" :key="index" class="lyric-line" :style="lineOpacityStyle(index)" @click.stop="onLyricLineTap(line, index)" @longpress.stop="copyLyric(line, index)">
            <!-- 同上顺序：词 / 罗马音 / 译文 / 滚动提示条 -->
            <view v-if="isKaraokeLine(line, index)" class="lrc-karaoke">
              <view v-for="(word, wi) in line.words" :key="wi" class="lrc-karaoke-item">
                <text class="lrc-karaoke-word" :style="karaokeWordStyle(wi)">{{ karaokeText(word.text) }}</text>
                <view v-if="wi == karaokeWordIndex" class="lrc-karaoke-fill" :style="karaokeFillStyle()">
                  <text class="lrc-karaoke-word" :style="karaokeLitStyle()">{{ karaokeText(word.text) }}</text>
                </view>
              </view>
            </view>
            <text v-else class="lrc" :style="lrcStyle(index)" :class="index == activeLyric ? 'lrc-active' : ''" >{{ line.text }}</text>
            <text v-if="hasRoma(line)" class="lrc-roma" :style="lrcRomaStyle(index)">{{ line.romanization }}</text>
            <text v-if="hasTr(line)" class="lrc-tr" :style="lrcTrStyle(index)" :class="index == activeLyric ? 'lrc-tr-active' : ''" >{{ line.translation }}</text>
            <view v-if="lyricTimesVisible && index == lyricTargetIndex" class="lrc-scroll-hint" :style="'background-color:' + playerRail + ';'">
              <text class="lrc-hint-time" :style="('color:' + playerInk + ';') + qtFontDual(24, 14)">{{ format(line.time) }}</text>
              <QtIcon name="play" :size="18" :color="playerInk" />
            </view>
          </view>
          <view v-if="lyricLines.length == 0" class="lyric-empty"><text class="lrc-empty" :style="('color:' + playerMuted + ';') + qtFontDual(26, 14)">纯音乐，请欣赏</text></view>
          <view :style="'height:' + lyricPadStyle"></view>
        </scroll-view>

        <!-- 封面态在歌手下显示单行当前歌词；点唱片或该行进入完整歌词视图。 -->

        <!-- 歌词工具行：切到歌词视图才出现，位于工具图标行上方（原来常驻右上角太挤，
             放到进度条正上方又太贴近播放栏，所以再往上提一行） -->
        <view v-if="lyricVisible" class="lyric-tools-row" :class="layout.isWide ? 'lyric-tools-row-wide' : ''">
          <view class="lyric-tool" :class="layout.isWide ? 'lyric-tool-wide' : ''" :style="'background-color:' + playerRail + ';'" @click="openOffset">
            <QtIcon name="sliders" :size="layout.isWide ? 13 : 24" :color="currentOffsetMs != 0 ? theme.skin.accent : playerMuted" />
            <text class="lyric-tool-text" :class="layout.isWide ? 'lyric-tool-text-wide' : ''" :style="('color:' + (currentOffsetMs != 0 ? theme.skin.accent : playerMuted) + ';') + qtFontDual(22, 11)">{{ offsetButtonText() }}</text>
          </view>
          <view v-if="lyricPicked" class="lyric-tool" :class="layout.isWide ? 'lyric-tool-wide' : ''" :style="'background-color:' + playerRail + ';'" @click="resetLyricPick">
            <QtIcon name="refresh" :size="layout.isWide ? 13 : 24" :color="theme.skin.accent" />
            <text class="lyric-tool-text" :class="layout.isWide ? 'lyric-tool-text-wide' : ''" :style="('color:' + theme.skin.accent + ';') + qtFontDual(22, 11)">恢复自动</text>
          </view>
          <!-- 同上（宽屏那处）：搜索歌词常驻偏移旁边，不再只在无词时出现 -->
          <view class="lyric-tool" :class="layout.isWide ? 'lyric-tool-wide' : ''" :style="'background-color:' + playerRail + ';'" @click="openLyricSearch">
            <QtIcon name="search" :size="layout.isWide ? 13 : 24" :color="noLyricYet ? theme.skin.accent : playerMuted" />
            <text class="lyric-tool-text" :class="layout.isWide ? 'lyric-tool-text-wide' : ''" :style="('color:' + (noLyricYet ? theme.skin.accent : playerMuted) + ';') + qtFontDual(22, 11)">搜索歌词</text>
          </view>
        </view>

        <!-- 进度条（用户 m15536）：条本身保持原样，下面一行换成「已播 | 当前实际音质 + 码率 | 总时长」，
             原来固定的「极高音质」文案去掉（那不是实际请求的音质）。 -->
        <view class="progress-row">
          <view class="prog-range" :class="layout.isWide ? 'prog-range-wide' : ''" @touchstart="onProgTouchStart" @touchmove="onProgTouchMove" @touchend="onProgTouchEnd" @touchcancel="onProgTouchCancel">
            <view class="prog-track" :style="'background-color:' + playerRail + ';'"></view>
            <view class="prog-fill" :style="'width:' + progPct() + '%;background-color:' + playerInk + ';'"></view>
            <view class="prog-thumb" :style="'left:' + progThumbLeft() + 'px;background-color:' + playerInk + ';'"></view>
          </view>
        </view>

        <view class="prog-meta-row" :style="'height:' + portraitMetrics.metaRowRpx + 'rpx;'">
          <text class="prog-time" :style="('color:' + playerMuted + ';') + qtFontDual(20, 12)">{{ format(displayProgress) }}</text>
          <text class="prog-quality" :style="('color:' + playerMuted + ';') + qtFontDual(20, 12)">{{ qualityMetaText() }}</text>
          <text class="prog-time" :style="('color:' + playerMuted + ';') + qtFontDual(20, 12)">{{ format(player.duration) }}</text>
        </view>

        <view class="controls">
          <view class="control-hit" @click="cycleMode"><QtIcon :name="modeIconName()" :size="36" :color="playerMuted" /></view>
          <view class="control-hit" @click="player.previous()"><QtIcon name="skip-back" :size="44" :color="playerInk" /></view>
          <view class="icon-main" @click="player.toggle()"><QtIcon :name="player.playing ? 'pause' : 'play'" :size="60" :color="playerInk" /></view>
          <view class="control-hit" @click="player.next()"><QtIcon name="skip-forward" :size="44" :color="playerInk" /></view>
          <view class="control-hit" @click="openQueue"><QtIcon name="list" :size="36" :color="playerMuted" /></view>
        </view>

        <!-- 最下面一行（用户 m17053）：展示项 + 三个点**等分整行宽度**（原来是左挤一堆、
             靠 spacer 顶到右边，用户嫌难看）。每一项 flex:1，四舍五入等宽。 -->
        <view class="bar-row">
          <view v-for="tool in barTools" :key="tool.id" class="bar-hit" @click="onBarTool(tool.id)">
            <QtIcon :name="tool.icon" :size="34" :color="barIconColor(tool.id)" />
          </view>
          <view class="bar-hit bar-more" @click="openBarSheet"><QtIcon name="more" :size="34" :color="playerMuted" /></view>
        </view>
      </view>

      <!-- 「三个点」弹层（用户 m17053 语义修正）：不再当「显隐开关」用，而是
           **功能直达菜单** —— 所有工具（含未展示在底行的）都能在这里直接触发；
           底行展示哪些仍由 设置·播放页展示设置 管。行尾状态点=该工具当前是否展示在底行。 -->
      <QtSheet v-model:visible="barSheetOpen" title="更多功能" :subtitle="'底行展示 ' + barTools.length + '/' + PLAYER_BAR_MAX_VISIBLE + '，可在设置里改'">
          <scroll-view direction="vertical" :show-scrollbar="false" :style="'height:' + Math.floor(layout.windowHeight * 0.55) + 'px;'">
            <view v-for="tool in barSheetTools" :key="tool.id" class="bar-sheet-row" :style="'border-bottom-color:' + theme.skin.divider + ';'" @click="onBarSheetTool(tool.id)">
              <QtIcon class="bar-sheet-icon" :name="tool.icon" :size="30" :color="barIconColor(tool.id) == playerMuted ? theme.skin.iconMuted : barIconColor(tool.id)" />
              <view class="bar-sheet-texts">
                <text class="bar-sheet-label" :style="('color:' + theme.skin.text + ';') + qtFontDual(27, 15)">{{ tool.label }}</text>
                <text class="bar-sheet-hint" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(21, 12)">{{ tool.hint }}</text>
              </view>
              <view v-if="playerBar.isVisible(tool.id)" class="bar-sheet-dot" :style="'background-color:' + theme.skin.accent + ';'"></view>
            </view>
          </scroll-view>
      </QtSheet>

      <view v-if="queueOpen" class="mask" :style="'background-color:' + theme.skin.scrim + ';'" :class="layout.isWide ? 'mask-wide mask-queue-wide' : ''" @click="queueOpen = false">
        <view class="sheet" :style="sheetSlideStyle + 'background-color:' + theme.skin.mediaSurface + ';border-color:' + theme.skin.mediaBorder + ';' + queueDrawerWideStyle" :class="layout.isWide ? 'sheet-wide sheet-queue-wide' : ''">
          <view class="sheet-handle" :style="'background-color:' + theme.skin.mediaControl + ';'" :class="layout.isWide ? 'sheet-handle-wide sheet-handle-drawer-wide' : ''"></view>
          <view class="sheet-head" :class="layout.isWide ? 'sheet-head-wide' : ''">
            <text class="sheet-title" :style="('color:' + theme.skin.mediaText + ';') + qtFontDual(30, 17)" :class="layout.isWide ? 'sheet-title-wide' : ''">播放列表</text>
            <text class="sheet-count" :style="('color:' + theme.skin.mediaMuted + ';') + qtFontDual(22, 12)" :class="layout.isWide ? 'sheet-count-wide' : ''">{{ player.queue.length }} 首</text>
            <view class="sheet-actions">
              <QtIcon class="sheet-act" name="trash" :size="layout.isWide ? 18 : 34" :color="theme.skin.mediaMuted" @click="clearQueue" />
              <QtIcon class="sheet-act" name="close" :size="layout.isWide ? 18 : 34" :color="theme.skin.mediaMuted" @click="queueOpen = false" />
            </view>
          </view>
          <scroll-view class="sheet-list" direction="vertical" :show-scrollbar="false" :scroll-top="queueScrollTop" @scroll="onQueueScroll">
            <view class="queue-spacer" :style="'height:' + queueContentHeight + 'px;'">
              <view
                v-for="row in queueWindow"
                :key="row.key"
                class="queue-row"
                :style="isCurrent(row.song) ? 'top:' + row.top + 'px;background-color:' + theme.skin.mediaControl + ';' : 'top:' + row.top + 'px;'"
                :class="[isCurrent(row.song) ? 'queue-row-active' : '', layout.isWide ? 'queue-row-wide' : '']"
                @click="playAt(row.index)"
                @longpress="queueActions(row.song)"
              >
                <text class="queue-index" :style="('color:' + (isCurrent(row.song) ? theme.skin.danger : theme.skin.mediaMuted) + ';') + qtFontDual(22, 12)" :class="[isCurrent(row.song) ? 'queue-index-active' : '', layout.isWide ? 'queue-index-wide' : '']">{{ row.index + 1 }}</text>
                <view class="queue-info" :class="layout.isWide ? 'queue-info-wide' : ''">
                  <text class="queue-name" :style="('color:' + theme.skin.mediaText + ';') + qtFontDual(27, 15)" :class="[isCurrent(row.song) ? 'queue-name-active' : '', layout.isWide ? 'queue-name-wide' : '']" :max-lines="1">{{ row.song.name }}</text>
                  <text class="queue-meta" :style="('color:' + theme.skin.mediaMuted + ';') + qtFontDual(21, 11)" :class="layout.isWide ? 'queue-meta-wide' : ''" :max-lines="1">{{ row.song.singer }}</text>
                </view>
                <QtIcon class="queue-move" name="arrow-up" :size="layout.isWide ? 18 : 30" :color="theme.skin.mediaMuted" @click.stop="moveUp(row.index)" />
                <QtIcon class="queue-move" name="arrow-down" :size="layout.isWide ? 18 : 30" :color="theme.skin.mediaMuted" @click.stop="moveDown(row.index)" />
                <QtIcon class="queue-move" name="close" :size="layout.isWide ? 18 : 30" :color="theme.skin.mediaMuted" @click.stop="removeAt(row.index)" />
              </view>
            </view>
            <view v-if="player.queue.length == 0" class="lyric-empty"><text :style="qtFontDual(26, 14)">队列为空</text></view>
          </scroll-view>
        </view>
      </view>

      <!-- 歌词偏移弹层：拖动只改草稿（offsetDraftMs），松手才写存储并通知桌面歌词 -->
      <QtSheet v-model:visible="offsetOpen" title="歌词偏移" :subtitle="offsetScopeText" @close="closeOffset">
          <view class="offset-body" :class="layout.isWide ? 'offset-body-wide' : ''">
            <text class="offset-value" :style="('color:' + theme.skin.text + ';') + qtFontDual(46, 28)" :class="layout.isWide ? 'offset-value-wide' : ''">{{ offsetText(offsetDraftMs) }}</text>
            <!-- 滑块：圆点用脚本算出的 left（仓内禁用 left:50% 那类写法），轨道高度/圆点
                 尺寸与 .offset-track / .offset-thumb 严格同步，改样式要一起改 offsetThumbLeft() -->
            <view class="offset-track" @touchstart="onOffsetTouchStart" @touchmove="onOffsetTouchMove" @touchend="onOffsetTouchEnd" @touchcancel="onOffsetTouchCancel">
              <view class="offset-rail" :style="'background-color:' + theme.skin.surfaceStrong + ';'"></view>
              <view class="offset-thumb" :class="layout.isWide ? 'offset-thumb-wide' : ''" :style="'left:' + offsetThumbLeft() + 'px;background-color:' + theme.skin.text + ';'"></view>
            </view>
            <view class="offset-scale">
              <text class="offset-scale-text" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(20, 11)">-10s</text>
              <text class="offset-scale-text" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(20, 11)">0</text>
              <text class="offset-scale-text" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(20, 11)">+10s</text>
            </view>
            <view class="offset-steps">
              <view class="offset-step" :style="'background-color:' + theme.skin.surfaceStrong + ';'" @click="nudgeOffset(-LYRIC_OFFSET_STEP_MS)">
                <text class="offset-step-text" :style="('color:' + theme.skin.text + ';') + qtFontDual(24, 14)">-100ms</text>
              </view>
              <view class="offset-step" :style="'background-color:' + theme.skin.surfaceStrong + ';'" @click="nudgeOffset(LYRIC_OFFSET_STEP_MS)">
                <text class="offset-step-text" :style="('color:' + theme.skin.text + ';') + qtFontDual(24, 14)">+100ms</text>
              </view>
              <view class="offset-step" :style="'background-color:' + theme.skin.surfaceStrong + ';'" @click="resetOffset">
                <text class="offset-step-text" :style="('color:' + theme.skin.text + ';') + qtFontDual(24, 14)">恢复默认</text>
              </view>
            </view>
            <text class="offset-note" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(21, 12)">歌词比声音快时调正（延后）；歌词比声音慢时调负（提前）。</text>
            <text class="offset-note" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(21, 12)">按曲目保存；调 0 即恢复继承全局默认。</text>
          </view>
      </QtSheet>

      <!-- 「搜索歌词」弹层：候选来自四源聚合搜索，选中后把那首候选的歌词接到当前歌上。
           入口常驻在偏移旁边（见上面两处工具行），无词和有词但挂错版本都能修 -->
      <QtSheet v-model:visible="lyricSearchOpen" title="搜索歌词" :subtitle="lyricSearchKeyword">
          <view v-if="lyricSearchLoading" class="lyric-empty"><text class="lrc-empty" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(26, 14)">正在搜索…</text></view>
          <scroll-view v-else direction="vertical" :show-scrollbar="false" :style="'height:' + Math.floor(layout.windowHeight * 0.55) + 'px;'">
            <view
              v-for="(cand, index) in lyricSearchCandidates"
              :key="cand.platform + ':' + cand.id + ':' + index"
              class="cand-row"
              :class="layout.isWide ? 'cand-row-wide' : ''"
              :style="'background-color:' + theme.skin.surfaceStrong + ';'"
              @click="pickLyricCandidate(cand)"
            >
              <view class="cand-info">
                <text class="cand-name" :style="('color:' + theme.skin.text + ';') + qtFontDual(27, 15)" :class="layout.isWide ? 'cand-name-wide' : ''" :max-lines="1">{{ cand.name }}</text>
                <text class="cand-meta" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(21, 11)" :class="layout.isWide ? 'cand-meta-wide' : ''" :max-lines="1">{{ candMeta(cand) }}</text>
              </view>
              <text class="cand-badge" :style="('background-color:' + platformColor(cand.platform) + ';color:#ffffff;') + qtFontDual(18, 11)">{{ platformShort(cand.platform) }}</text>
            </view>
            <view v-if="lyricSearchCandidates.length == 0" class="lyric-empty"><text class="lrc-empty" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(26, 14)">没有找到可选的歌曲</text></view>
          </scroll-view>
      </QtSheet>

      <qt-action-sheet v-model:visible="sheetVisible" :title="sheetTitle" :actions="sheetActions" :selected-index="sheetSelectedIndex" @select="onSheetSelect" />
      <QtPlaylistPicker v-model:visible="showPicker" :song="currentSong" :playlists="player.pickerPlaylists()" :selected-ids="getSelectedPlaylistIds(currentSong)" :anchor-top="pickerAnchorTop" title="加入 / 移出歌单" @confirm="handlePickerConfirm" />
    </view>
  </qt-page-frame>
</template>
<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import { qtConfirm } from "@/services/confirm";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import { useQtLayout, qtRpx } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtSheetWidth } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { ref, computed, watch, nextTick, getCurrentInstance, onMounted, onUnmounted } from "vue";
import { onLoad, onShow, onHide, onUnload } from "@dcloudio/uni-app";
import QtMarquee from "@/uni_modules/qt-ui/components/qt-marquee/qt-marquee.uvue";
import { portraitPlayerMetrics } from "@/uni_modules/qt-ui/composables/player-presentation";
import { turntableMetrics } from "@/uni_modules/qt-ui/composables/turntable-presentation";
import type { SheetAction } from "@/uni_modules/qt-ui/components/qt-action-sheet/qt-action-sheet.uvue";
import QtActionSheet from "@/uni_modules/qt-ui/components/qt-action-sheet/qt-action-sheet.uvue";
import QtSheet from "@/uni_modules/qt-ui/components/qt-sheet/qt-sheet.uvue";
import { QT_SLEEP_OPTIONS, QT_PLAYBACK_RATES, qtSleepSelectedIndex } from "@/services/player-setting-options";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtPlaylistPicker from "@/uni_modules/qt-ui/components/qt-playlist-picker/qt-playlist-picker.uvue";
import { usePlayerStore } from "@/stores/player";
import { useDownloadsStore } from "@/stores/downloads";
import { PLAYER_BAR_MAX_VISIBLE, PLAYER_BAR_TOOLS, type PlayerBarToolMeta, playerBarCounted as playerBarCountedShared, playerBarFixed, usePlayerBarStore } from "@/stores/player-bar";
import { useDislikesStore } from "@/stores/dislikes";
import { useSourceRegistryStore } from "@/stores/source-registry";
import { useShareCardStore } from "@/stores/share-card";
import { findSourceCandidates, peekSourceCandidates } from "@/services/source-switch";
import { useThemeStore, turntablePalette } from "@/uni_modules/qt-ui/stores/theme";
import { audioPlayer } from "@/services/audio-player";
import { musicApi, isQtAdmin, MusicApi } from "@/services/music-api";
import { useLyricOffsetStore, LYRIC_OFFSET_MAX_MS, LYRIC_OFFSET_STEP_MS } from "@/stores/lyric-offset";
import { desktopLyric } from "@/services/desktop-lyric";
import { platformShort, platformColor } from "@/services/platform";
import { isHarmonyOs } from "@/services/app-native";
import { localFileSizeOf, localFirstDiagnose } from "@/services/local-first";
import { collectDupMessage, type CollectDupConflict } from "@/services/collect-dup";
import { qtDiag } from "@/services/diag";
import { beginLoading, finishLoading } from "@/services/ui-loading";
import { qtTrackPage } from "@/uni_modules/qt-stat";
import type { Song, LyricLine } from "@/types/music";

const player = usePlayerStore();
const downloads = useDownloadsStore();
const playerBar = usePlayerBarStore();
const dislikes = useDislikesStore();
const sourceRegistry = useSourceRegistryStore();
const shareCard = useShareCardStore();
const theme = useThemeStore();
const fontScale = useFontScaleStore();
const pageVisible = ref(true);
const showLyric = ref(false);
const queueOpen = ref(false);
// Cover and lyrics share one phone palette; wide mode and sheets retain their media colors.
const portraitPlayerMode = computed((): boolean => !layout.isWide);
const portraitPalette = computed(() => turntablePalette(theme.skin, theme.dark));
const playerInk = computed((): string => portraitPlayerMode.value ? portraitPalette.value.text : theme.skin.mediaText);
const playerMuted = computed((): string => portraitPlayerMode.value ? portraitPalette.value.muted : theme.skin.mediaMuted);
const playerRail = computed((): string => portraitPlayerMode.value ? portraitPalette.value.rail : theme.skin.mediaControl);

/**
 * 歌词偏移（页内弹层）。正数 = 歌词延后出现，与 qt-pc / utils/lrc.uts 的
 * `progress - offsetSec` 同口径；值本身只存在 stores/lyric-offset.ts 里，本页只做编辑。
 * 拖动过程中只更新 offsetDraftMs 预览，松手（touchend）才提交 —— 与进度条拖动的
 * 口径一致（pages/desktop-lyric/index.uvue 的拖动条同理），避免每个 move 事件都写一次 KV。
 */
const lyricOffset = useLyricOffsetStore();
const offsetOpen = ref(false);
// 切歌淡入：只动 opacity，不动 layout（Vapor 下改 width/height 会打断布局）。
// 320ms/ease-out 沿用 use-qt-reveal 的 QT_REVEAL_TRANSITION —— 仓库唯一的过渡时长口径。
const coverShown = ref<boolean>(true);
// 弹层上滑入：transform 过渡在 pages/playlists/index.uvue:1044 有真机先例
const sheetIn = ref<boolean>(true);
function armSheet(): void {
  sheetIn.value = false;
  setTimeout(() => {
    sheetIn.value = true;
  }, 16);
}
const offsetDragging = ref(false);
const offsetDraftMs = ref(0);
/** 偏移轨道实测几何（px）：拖动时不能每帧调 uni.getWindowInfo()，测一次缓存起来 */
const offsetTrackWidth = ref(0);
/** 「搜索歌词」弹层：候选来自 musicApi.searchLyricCandidates（四源聚合搜索结果）。
    入口常驻在偏移按钮旁边，无词、以及「有词但挂错版本」都能进。 */
const lyricSearchOpen = ref(false);
const lyricSearchLoading = ref(false);
const lyricSearchAdopting = ref(false);
const lyricSearchCandidates = ref<Song[]>([]);
const lyricSearchKeyword = ref("");
/**
 * 手选来源的无响应依赖计数器：hasPickedLyric 读的是 music-api 里的普通对象，
 * 不是响应式数据，改完（选中 / 恢复自动）必须手动 ++ 才能让模板重算。
 */
const lyricPickVersion = ref(0);

/**
 * 当前播放曲目的生效偏移（秒）。统一在这里取，四处调用点（取行 / 逐字染色 / 点行跳转）
 * 才不会有谁漏减。取的是 **当前播放的歌** 而不是 lyricOffset.activeKey —— 后者是编辑
 * 上下文，用户可能在播放页给别的歌设偏移（切歌后 setActive 才跟上）。
 */
function lyricOffsetSec(): number {
  return lyricOffset.offsetSecFor(player.current);
}

/**
 * 偏移值的展示文本：正数带 +，零值显示「0」。
 *
 * 小数位按实际粒度决定，不能一律 toFixed(1)：滑块吸附 50ms，0.05s 会被四舍五入成
 * 「0.1s」、0.15s 显示成「0.2s」，用户用 ±100ms 按钮累加时会对不上账。
 */
function offsetText(ms: number): string {
  if (ms == 0) return "0";
  const sign = ms > 0 ? "+" : "-";
  const abs = Math.abs(ms);
  if (abs % 1000 == 0) return sign + (abs / 1000) + "s";
  if (abs % 100 == 0) return sign + (abs / 1000).toFixed(1) + "s";
  return sign + (abs / 1000).toFixed(2) + "s";
}

/** 歌词工具行上偏移按钮的文案：没设过就是入口名，设过就显示当前值 */
function offsetButtonText(): string {
  const ms = currentOffsetMs.value;
  if (ms == 0) return "歌词偏移";
  return "偏移 " + offsetText(ms);
}

/**
 * 歌词是否正在取（切歌瞬间 lyricLines 还是空的，不能把这当成「这首歌没有词」）。
 * 初值 true：模板首次渲染发生在 onMounted 之前，那时 loadLyric 还没跑、lyricLines 是空的，
 * 初值 false 会让常驻的「搜索歌词」入口先按「无词」显示强调色、再跳回普通色。
 * 取词结束（含取不到词）才置 false。
 */
const lyricLoading = ref(true);

/** 仅用于 .stop 阻止事件冒泡到遮罩（必须给一个真实处理函数，不能留空） */
function noop(): void {}

/** 当前播放曲目的生效偏移（毫秒）：入口按钮上显示，用户一眼能看出这首歌是否设过 */
const currentOffsetMs = computed((): number => lyricOffset.offsetMsFor(player.current));
/** 偏移弹层副标题：区分「这首歌的覆盖」与「全局默认」 */
const offsetScopeText = computed((): string => (player.current != null ? "按曲目保存" : "全局默认"));
/**
 * 当前歌是否「没有正式歌词」（只剩占位行）。
 * 不能只看 lyricLines.length == 0：loadLyric 取不到词时会主动落地一行占位文本
 * （「纯音乐，请欣赏」/「暂无歌词」），长度恒 ≥ 1。取词中也不算「无词」，
 * 否则每次切歌入口都会闪一下。
 */
const noLyricYet = computed((): boolean => {
  if (lyricLoading.value) return false;
  const lines = lyricLines.value;
  if (lines.length == 0) return true;
  if (lines.length > 1) return false;
  const text = lines[0].text;
  return text == "纯音乐，请欣赏" || text == "暂无歌词";
});
/** 是否给当前歌手选过歌词来源（hasPickedLyric 读的是普通对象，靠 lyricPickVersion 驱动重算） */
const lyricPicked = computed((): boolean => {
  const _ = lyricPickVersion.value;
  const current = player.current;
  return current != null && musicApi.hasPickedLyric(current);
});

/* ---------- 歌词偏移弹层 ---------- */

/** 偏移轨道实测几何（px）；弹层是 v-if 动态创建的，测量必须等 nextTick */
let offsetLeft = 0;
let offsetTrackTimer: number | null = null;
let offsetUnitPx = qtRpx(1);
/** 量不到时的常量兜底，必须与 .offset-body / .offset-body-wide 的 padding 保持一致 */
let offsetFallbackWidth = 0;
let offsetFallbackLeft = 0;
const OFFSET_BODY_PAD_RPX = 40;
const OFFSET_BODY_PAD_PX = 28;
/** 滑块吸附粒度（毫秒）：比 ±100ms 按钮更细，但不足以让手指抖动产生 3ms 这种无意义值 */
const OFFSET_SNAP_MS = 50;

function refreshOffsetFallback(): void {
  offsetUnitPx = qtRpx(1);
  const info = uni.getWindowInfo();
  if (layout.isWide) {
    const sheetW = qtSheetWidth("drawer");
    offsetFallbackWidth = Math.max(0, sheetW - OFFSET_BODY_PAD_PX * 2);
    offsetFallbackLeft = (info.windowWidth - sheetW) / 2 + OFFSET_BODY_PAD_PX;
  } else {
    offsetFallbackWidth = Math.max(0, info.windowWidth - OFFSET_BODY_PAD_RPX * 2 * offsetUnitPx);
    offsetFallbackLeft = OFFSET_BODY_PAD_RPX * offsetUnitPx;
  }
}
/** 轨道宽度（px）：优先用实测值，未测到时按样式常量推算 */
function offsetTrackWidthPx(): number {
  if (offsetTrackWidth.value > 0) return offsetTrackWidth.value;
  if (offsetFallbackWidth <= 0) refreshOffsetFallback();
  return offsetFallbackWidth;
}
/** 轨道左边界（px）：优先用实测值，未测到时按样式常量推算 */
function offsetTrackLeftPx(): number {
  if (offsetTrackWidth.value > 0) return offsetLeft;
  if (offsetFallbackWidth <= 0) refreshOffsetFallback();
  return offsetFallbackLeft;
}
/** 圆点 left（px）：0ms 落在正中，-MAX 在左端、+MAX 在右端（尺寸与 .offset-thumb 同步） */
function offsetThumbLeft(): number {
  const width = offsetTrackWidthPx();
  if (width <= 0) return 0;
  const frac = (offsetDraftMs.value + LYRIC_OFFSET_MAX_MS) / (LYRIC_OFFSET_MAX_MS * 2);
  const fill = Math.max(0, Math.min(1, frac)) * width;
  const size = layout.isWide ? 22 : 36 * offsetUnitPx;
  return Math.max(0, Math.min(width - size, fill - size / 2));
}
/** 手指横坐标 → 偏移毫秒（吸附到 OFFSET_SNAP_MS 档） */
function offsetFromClientX(clientX: number): number {
  const width = offsetTrackWidthPx();
  if (width <= 0) return offsetDraftMs.value;
  const frac = Math.max(0, Math.min(1, (clientX - offsetTrackLeftPx()) / width));
  const snapped = Math.round(((frac * 2 - 1) * LYRIC_OFFSET_MAX_MS) / OFFSET_SNAP_MS) * OFFSET_SNAP_MS;
  return Math.max(-LYRIC_OFFSET_MAX_MS, Math.min(LYRIC_OFFSET_MAX_MS, snapped));
}
function measureOffsetTrack(): void {
  measureOffsetTrackRetry(0);
}
/** 同进度条轨道：弹层刚插入时量不到宽度，最多重试 3 次，期间先用常量兜底定位 */
function measureOffsetTrackRetry(attempt: number): void {
  if (!pageAlive) return;
  refreshOffsetFallback();
  const query = uni.createSelectorQuery();
  query
    .select(".offset-track")
    .boundingClientRect((rect: UniNodeInfo) => {
      if (rect != null && rect.width > 0) {
        offsetLeft = rect.left;
        offsetTrackWidth.value = rect.width;
        return;
      }
      if (attempt < 3) {
        offsetTrackTimer = setTimeout(() => {
          measureOffsetTrackRetry(attempt + 1);
        }, 120) as number;
      }
    })
    .exec();
}
/**
 * 偏移提交后的统一收尾：通知桌面歌词 + 立即重算高亮。
 *
 * 桌面歌词只在进度回调里更新，而 services/desktop-lyric.uts 的 onProgress 首行是
 * 「进度和上次差不到 0.1s 就直接 return」—— 暂停时进度不动，改完偏移悬浮窗不会有
 * 任何反应，用户会以为功能没生效。必须显式 notifyOffsetChanged 让它作废
 * lastProgress/lastLineIndex 并立即重推一次当前行。
 */
function afterOffsetChange(): void {
  // 逐字填充的锚点必须先作废：偏移是在 applyKaraokeFill 内部才减掉的，
  // 而 stepKaraoke 收到的是**原始进度**——改偏移时原始进度并没有动，
  // 于是「只进不退」的下限会把填充冻在旧位置，直到原始进度爬过它才恢复。
  // resetKaraoke 把 anchorLine 归 -1，紧跟的 updateLyricScroll(true) 会
  // 用新偏移重新对表；两步在同一个 tick 内同步完成，不会闪一帧。
  resetKaraoke();
  desktopLyric.notifyOffsetChanged();
  updateLyricScroll(true);
}
function commitOffset(ms: number): void {
  offsetDraftMs.value = ms;
  lyricOffset.setActiveMs(ms);
  afterOffsetChange();
}
function openOffset(): void {
  // 编辑上下文切到当前播放曲目：这个入口改的就是「这首歌」的偏移。
  // 传 null 会退化成编辑全局默认，那不是本入口的语义。
  lyricOffset.setActive(player.current);
  offsetDraftMs.value = lyricOffset.activeMs();
  offsetTrackWidth.value = 0;
  offsetOpen.value = true;
  armSheet();
  nextTick(() => {
    measureOffsetTrack();
  });
}
function closeOffset(): void {
  offsetOpen.value = false;
}
function onOffsetTouchStart(event: UniTouchEvent): void {
  const touch = event.touches[0];
  if (touch == null) return;
  measureOffsetTrack();
  offsetDragging.value = true;
  // 拖动期间只改草稿，松手才写 KV：每个 move 都落一次存储既慢也没必要
  offsetDraftMs.value = offsetFromClientX(touch.clientX);
}
function onOffsetTouchMove(event: UniTouchEvent): void {
  if (!offsetDragging.value) return;
  const touch = event.touches[0];
  if (touch == null) return;
  offsetDraftMs.value = offsetFromClientX(touch.clientX);
}
function onOffsetTouchEnd(event: UniTouchEvent): void {
  if (!offsetDragging.value) return;
  const changed = event.changedTouches;
  const touch = changed != null && changed.length > 0 ? changed[0] : null;
  const value = touch != null ? offsetFromClientX(touch.clientX) : offsetDraftMs.value;
  offsetDragging.value = false;
  commitOffset(value);
}
/** 触摸被系统打断（来电、手势冲突）：不提交半途的值，显示回到已保存值 */
function onOffsetTouchCancel(): void {
  if (!offsetDragging.value) return;
  offsetDragging.value = false;
  offsetDraftMs.value = lyricOffset.activeMs();
}
function nudgeOffset(deltaMs: number): void {
  offsetDraftMs.value = lyricOffset.nudgeActive(deltaMs);
  afterOffsetChange();
}
function resetOffset(): void {
  lyricOffset.resetActive();
  // 归零 = 删掉本曲覆盖 → 重新读出来的是继承的全局值，显示要跟着变
  offsetDraftMs.value = lyricOffset.activeMs();
  afterOffsetChange();
}

/* ---------- 「搜索歌词」弹层（入口常驻偏移旁边） ---------- */

/** 候选行副标题：专辑名可能为空，空的时候不要留一个孤零零的分隔点 */
function candMeta(cand: Song): string {
  if (cand.album != null && cand.album.length > 0) return cand.singer + " · " + cand.album;
  return cand.singer;
}

async function openLyricSearch(): Promise<void> {
  const current = player.current;
  if (current == null) return;
  if (lyricSearchLoading.value) return;
  lyricSearchOpen.value = true;
  lyricSearchLoading.value = true;
  lyricSearchCandidates.value = [];
  // 与 music-api 内部的取词口径一致（歌手 歌名），页面上用来展示「搜的是什么」
  lyricSearchKeyword.value = current.singer.length > 0 ? current.singer + " " + current.name : current.name;
  try {
    lyricSearchCandidates.value = await musicApi.searchLyricCandidates(current);
  } catch (_) {
    lyricSearchCandidates.value = [];
  } finally {
    lyricSearchLoading.value = false;
  }
}

/**
 * 手选来源取词成功后把歌词换到页面上。
 *
 * 不能调 ensureLyric()：它第一行是 `if (key == loadedKey) return;`，当前歌早就加载过，
 * loadedKey 等于当前 key，调了等于什么都没发生。adoptLyricFor 已经把结果写进了
 * music-api 的歌词缓存，所以这里同步重读四件套重建即可（与 loadLyric() 命中预热缓存
 * 那条分支同一套写法），不发任何请求。
 */
function applyAdoptedLyric(current: Song): void {
  const parsed = buildLyricLines(
    musicApi.cachedLyricWordByWord(current),
    musicApi.cachedLyric(current),
    musicApi.cachedLyricTranslation(current),
    musicApi.cachedLyricRomanization(current)
  );
  qtDiag("[QT Lyric] 手选来源落地 " + current.name + " → " + parsed.length + " 行");
  applyLyricLines(parsed.length == 0 ? [{ time: 0, text: "纯音乐，请欣赏" }] : parsed);
  // 桌面歌词是独立跟随的：它有自己的 loadedKey（同样只看 platform:id），换来源后
  // 歌没变、key 也没变，不同步通知的话悬浮窗会一直停在旧来源的歌词上
  desktopLyric.notifyLyricChanged();
}

async function pickLyricCandidate(cand: Song): Promise<void> {
  const current = player.current;
  if (current == null || cand == null) return;
  if (lyricSearchAdopting.value) return;
  lyricSearchAdopting.value = true;
  const actToken = beginLoading("正在获取歌词…");
  try {
    const text = await musicApi.adoptLyricFor(current, cand);
    finishLoading(actToken);
    // 取词期间切了歌：候选词属于旧歌。手选取词是异步的，等回来时若已换曲，
    // 应用会让新歌先亮一拍旧歌的词（封面态单行歌词直接放大到用户眼前）。
    const nowSong = player.current;
    if (nowSong == null || nowSong.id != current.id || nowSong.platform != current.platform) return;
    // hasPickedLyric 读的是普通对象，改完必须手动 ++ 才能让入口按钮重算
    lyricPickVersion.value++;
    if (text.length == 0) {
      // 这首候选也没词：保留弹层让用户接着挑，且**不要**用空串覆盖现有歌词
      qtShowToast({ title: "这首候选也没有歌词", icon: "none" });
      return;
    }
    lyricSearchOpen.value = false;
    applyAdoptedLyric(current);
  } catch (_) {
    finishLoading(actToken);
    qtShowToast({ title: "获取歌词失败，请稍后再试", icon: "none" });
  } finally {
    lyricSearchAdopting.value = false;
  }
}

/** 取消手选，回到「按原平台自动取词」 */
function resetLyricPick(): void {
  const current = player.current;
  if (current == null) return;
  musicApi.clearLyricPick(current);
  lyricPickVersion.value++;
  // clearLyricPick 已把原歌的四段缓存与「已问过」标记清掉（否则 ensureLyric 会命中
  // 手选源的词、或在 TTL 内被「问过」标记直接短路）。但 ensureLyric 第一行是
  // `if (key == loadedKey) return;`，当前歌的页内标记还在，所以必须先清掉它，
  // 再让它重新走一次完整取词 —— 只清 music-api 那侧，按钮点了会毫无反应。
  loadedKey = "";
  ensureLyric();
  // 同上：恢复自动后桌面歌词也要跟着回到原平台的词
  desktopLyric.notifyLyricChanged();
  qtShowToast({ title: "已恢复自动取词", icon: "none" });
}

/** 仅当账号具备轻听管理权限时，才展示「播放地址」调试入口（权限由 /me 缓存，进入页面时刷新） */
const showPlayUrlEntry = ref(isQtAdmin());
/**
 * 工具按钮开关（设置 → 播放页按钮）：关掉的按钮整行不渲染。
 * 「播放链接」还额外要求 qt_admin 权限，两者都满足才出现。
 */
function toolVisible(id: string): boolean {
  if (id == "playUrl" && !showPlayUrlEntry.value) return false;
  return playerBar.isVisible(id);
}
/**
 * 手机播放页最下面那一行（用户 m15536）：只放「设置 → 播放页展示设置」里勾选的项，
 * 最多 PLAYER_BAR_MAX_VISIBLE 个。收藏 / 分享 / 歌手是固定常驻项（入口分别在曲名块、
 * 右上角、歌手行），既不在这一行渲染，也不占名额。播放链接仍要求 qt_admin。
 */
const barSheetOpen = ref(false);
function barToolList(onlyVisible: boolean): PlayerBarToolMeta[] {
  const out: PlayerBarToolMeta[] = [];
  for (let i = 0; i < PLAYER_BAR_TOOLS.length; i++) {
    const tool = PLAYER_BAR_TOOLS[i];
    if (playerBarFixed(tool.id)) continue;
    if (tool.adminOnly && !showPlayUrlEntry.value) continue;
    if (onlyVisible && !playerBar.isVisible(tool.id)) continue;
    out.push(tool);
  }
  return out;
}
const barTools = computed((): PlayerBarToolMeta[] => barToolList(true));
const barSheetTools = computed((): PlayerBarToolMeta[] => barToolList(false));
/**
 * 「三个点」菜单（用户 m17053）：行点击 = **直接执行该功能**（与底行按钮同一分发），
 * 不再当显隐开关 —— 所有工具（含没展示在底行的）都能从这里直达。
 * 行尾小圆点只是状态提示：亮 = 该工具当前展示在底行；改展示集去 设置→播放页展示设置。
 */
function onBarSheetTool(id: string): void {
  barSheetOpen.value = false;
  onBarTool(id);
}
/** 这一行图标的状态色（m18202：底行在 scrim 上统一提为 mediaText 纯白，开启态才用状态色） */
function barIconColor(id: string): string {
  if (id == "dislike") return dislikedCurrent.value ? theme.skin.danger : playerMuted.value;
  if (id == "sleep") return sleepActive.value ? theme.skin.accent : playerMuted.value;
  if (id == "speed") return rateIndex.value != 1 ? theme.skin.accent : playerMuted.value;
  return playerMuted.value;
}
/** 这一行按钮的点击分发（与旧 action-row 的点击目标完全一致，只是改由配置驱动） */
function onBarTool(id: string): void {
  if (id == "download") doDownload();
  else if (id == "quality") switchQuality();
  else if (id == "dislike") openDislikeSheet();
  else if (id == "speed") cycleRate();
  else if (id == "sleep") openSleep();
  else if (id == "equalizer") openEqualizer();
  else if (id == "source") openSourceSwitch();
  else if (id == "playUrl") showPlayUrl();
}
function openBarSheet(): void {
  barSheetOpen.value = true;
}
/**
 * 进度条下面那一行中间的值：当前**实际**请求的音质名 + 实测码率（用户 m15536）。
 * 音质取 player.effQualityOf（= 该源播放音质设置，缺省跟随下载音质），不是固定文案；
 * 名字查源注册表的音质清单，查不到就退回原始档位 id（如 "320"），不留空白。
 */
function qualityMetaText(): string {
  const song = player.current;
  if (song == null) return "";
  const eff = player.effQualityOf(song);
  let label = eff;
  const list = sourceRegistry.sourceQualities(song.platform);
  for (let i = 0; i < list.length; i++) {
    if (list[i].id == eff) {
      label = list[i].name;
      break;
    }
  }
  if (label.length == 0) label = "未知音质";
  if (bitrateKbps.value > 0) return label + " · " + bitrateKbps.value + "kbps";
  return label;
}
/**
 * 播放列表滚动与定位：scroll-view + 自制窗口虚拟化。
 *
 * 为什么不用 list-view：实机（MuMu / 蒸汽模式 5.25）实测，list-view 的
 * scroll-top 赋值只改组件状态、内容纹丝不动，scroll-into-view 则滚到错误位置
 * 后动画中途冻结，@scroll 回报值与视觉位置也对不上 —— 官方文档亦承认
 * "受限于 list-item 回收复用，scroll-into-view 可能无法准确滚动到指定位置"。
 * 绑定式定位在回收列表上没有可靠路径。
 *
 * scroll-view + scroll-top 是本 App 歌词区长期验证 1:1 可靠的机制，故借用它，
 * 配合窗口虚拟化保住几千条数据下的性能：内容高度 = 行数 × 行高（一个撑高容器），
 * 行绝对定位在 index × 行高处，只渲染可视区上下若干行；定位 = 纯数学，
 * 打开弹层前把 scroll-top 写成 当前下标 × 行高 即可，无累积误差、无时序竞态。
 */
const queueScrollTop = ref(0);
/** @scroll 回报的当前滚动位置，窗口计算的基准 */
const queueScrollValue = ref(0);
/** 窗口内渲染的行（可视区 ± QUEUE_WINDOW_MARGIN 行） */
const queueWindow = ref<QueueRow[]>([]);
/** 视口上下各多渲染的行数，吸收快速滑动的渲染延迟 */
const QUEUE_WINDOW_MARGIN = 10;
/** 粗略视口高度（px）：窗口覆盖用，不必精确 */
const QUEUE_VIEWPORT_ESTIMATE = 800;

type QueueRow = { index: number; song: Song; key: string; top: number };

// 状态栏安全区高度（rpx），避免自定义导航完全置顶被状态栏遮挡
const statusBarRpx = ref(0);
// 宽屏判定：qt-ui 布局状态（横屏/窗口 >= 720dp 视为宽屏）
const layout = useQtLayout();
const wideStageWidth = computed<number>(() => Math.min(layout.windowWidth - 36, 1120));
/**
 * 横屏矮窗（手机横屏、车机矮窗等 windowHeight < 520，即 use-qt-layout 的 isShort）。
 *
 * 为什么必须单独处理：isWide 的判据是「宽 >= 900 或 横屏且宽 >= 600」，所以手机横屏
 * （如 780×360）也会落进宽屏分支，但宽屏舞台的留白是按 pad 设计的。原来封面尺寸写的是
 * `windowHeight - 108` 且下限 112 —— 780×360 时算出 240，而「顶部留白 + 底部三行控件」
 * 之后实际只剩一百多 px，封面卡（240+20）直接盖住进度行和控制行。
 * 现在的口径是「先扣掉顶部留白、底部三行、底部留白，剩下的才是封面卡能占的高度」，
 * 封面尺寸永远由这个剩余空间反算，窗再矮也不会溢出；矮窗额外收紧三行的外边距。
 */
const wideShort = computed((): boolean => layout.isShort);
/** 底部三行占位：歌词工具行 34+6 / 进度行 32+12 / 控制行 46+8 = 138 */
const WIDE_BOTTOM_ROWS_PX = 138;
/** 矮窗收紧后：歌词工具行 34+2 / 进度行 28+6 / 控制行 42+4 = 116（见 -short 规则） */
const WIDE_SHORT_BOTTOM_ROWS_PX = 116;
const WIDE_PAD_BOTTOM_PX = 14;
const WIDE_SHORT_PAD_BOTTOM_PX = 8;
const widePadBottom = computed<number>((): number => wideShort.value ? WIDE_SHORT_PAD_BOTTOM_PX : WIDE_PAD_BOTTOM_PX);
/** 顶部留白：与 navStyle 的导航高度同源（矮窗导航也收窄，见 navStyle），否则封面会钻到按钮下面 */
const widePadTop = computed<number>((): number => wideShort.value ? statusBarPx() + 44 : 60);
/** 封面卡最大边长（含内边距 20）：pad 上维持原来的 240px 封面观感 */
const WIDE_COVER_CARD_MAX_PX = 260;
/** 封面卡最小边长：再小就没法看封面了，宁可让 wide-body 溢出（极矮窗的最后兜底） */
const WIDE_COVER_CARD_MIN_PX = 108;
/** 封面下方曲名块占位（两行口径：标题 24 + 平台行 16 + 间距 8 ≈ 48；矮窗字号不变取同值） */
const WIDE_TRACK_HEAD_PX = 48;
const wideBodyHeight = computed<number>((): number => {
  const rows = wideShort.value ? WIDE_SHORT_BOTTOM_ROWS_PX : WIDE_BOTTOM_ROWS_PX;
  return layout.windowHeight - widePadTop.value - widePadBottom.value - rows - WIDE_TRACK_HEAD_PX;
});
const wideCoverSize = computed<number>((): number => {
  const card = Math.max(WIDE_COVER_CARD_MIN_PX, Math.min(WIDE_COVER_CARD_MAX_PX, wideBodyHeight.value));
  return card - 20; // 20 = .cover-card 的 padding 10 × 2
});
const wideStageStyle = computed<string>((): string => "width:" + wideStageWidth.value + "px;padding-top:" + widePadTop.value + "px;padding-bottom:" + widePadBottom.value + "px;");
const wideCoverBoxStyle = computed<string>(() => "width:" + (wideCoverSize.value + 20) + "px;height:" + (wideCoverSize.value + 20) + "px;");
const wideCoverImageStyle = computed<string>(() => "width:" + wideCoverSize.value + "px;height:" + wideCoverSize.value + "px;");
const coverFadeStyle = computed<string>(() => "opacity:" + (coverShown.value ? "1" : "0") + ";transition:opacity 0.32s ease-out;");
const sheetSlideStyle = computed<string>(() => "transform:translateY(" + (sheetIn.value ? "0" : "40px") + ");transition:transform 0.24s ease-out;");
/**
 * 播放列表在宽屏走「右侧抽屉」而不是居中弹窗：宽度用 drawer 档（420px），
 * 高度整屏铺满、贴内容区右缘。播放页宽屏本身就是左封面 + 右歌词的双栏，
 * 再居中压一块 560px 会同时遮住两栏，看起来像弹了无关窗口。
 * 居中弹窗（modal 档）留给歌词偏移、搜索歌词这类「短小确认」浮层。
 */
const queueDrawerWideStyle = computed<string>(() => layout.isWide ? "width:" + qtSheetWidth("drawer") + "px;" : "");
/** 歌词视口当前是否展示：宽屏右侧歌词面板常驻，竖屏看 showLyric。
    歌词的测量与自动跟随滚动一律以此为准 —— 之前错用竖屏的 showLyric 门控，宽屏歌词不跟随、定位错乱。 */
const lyricVisible = computed((): boolean => layout.isWide || showLyric.value);

/** 桌面歌词开关状态：与 services/desktop-lyric 的真相同步（onShow 里重读一次） */
const lyricOn = ref(desktopLyric.isEnabled());

/**
 * 桌面歌词开关（播放页入口）。
 *
 * 逻辑与 pages/desktop-lyric/index.uvue 的 toggleEnabled 一致，但这里只做「开/关」，
 * 授权引导仍交给设置页（那里有各机型的详细路径文案），避免同一段长文案维护两份。
 * 鸿蒙走系统渲染、不需要悬浮窗权限（hasPermission 恒 true），所以 hasPermission
 * 分支天然只在安卓生效。
 */
function toggleDesktopLyric(): void {
  if (lyricOn.value) {
    desktopLyric.disable();
    lyricOn.value = false;
    qtShowToast({ title: "已关闭桌面歌词", icon: "none" });
    return;
  }
  if (!desktopLyric.hasPermission()) {
    qtConfirm({
      title: "需要悬浮窗权限",
      content: "桌面歌词需要「悬浮窗 / 显示在其他应用上层」权限。\n点「去开启」跳到系统权限页，开启后返回即可再次点击。\n详细机型路径见「设置 → 桌面歌词」。",
      confirmText: "去开启",
    }).then((ok: boolean) => {
      if (!ok) return;
      const opened = desktopLyric.requestPermission();
      if (!opened) {
        qtShowToast({ title: "没能打开系统设置页，请到「权限管理 → 悬浮窗」手动开启", icon: "none" });
      }
    });
    return;
  }
  const ok = desktopLyric.enable();
  lyricOn.value = desktopLyric.isEnabled();
  if (!ok) {
    qtShowToast({
      title: isHarmonyOs() ? "当前系统不支持桌面歌词" : "开启失败，请重试",
      icon: "none",
    });
  }
}
// 内联尺寸统一收敛：宽屏下用绝对 px（rpx 在宽屏会被放大 2.7 倍），手机端保持 rpx
const navStyle = computed((): string => {
  // 导航高度必须 = 状态栏(padding-top) + 内容高，否则按钮上下溢出会被 Android 裁掉
  if (!layout.isWide) return "height:" + (statusBarRpx.value + 96) + "rpx;padding-top:" + statusBarRpx.value + "rpx;";
  const sb = statusBarPx();
  // 矮窗（手机横屏/车机）收窄到 44：宽屏舞台的顶部留白按同一个值算（见 widePadTop），
  // 两处必须同步，否则封面要么钻到按钮下面、要么白留一条缝
  return "height:" + (sb + (wideShort.value ? 44 : 52)) + "px;padding-top:" + sb + "px;";
});
/** Budget the song/singer/current-lyric rows and fixed controls first; only the disc can shrink. */
const portraitUnit = computed((): number => Math.max(layout.windowWidth, 1) / 750);
const portraitMetrics = computed(() => portraitPlayerMetrics(
  layout.windowWidth, layout.windowHeight, statusBarRpx.value * portraitUnit.value,
  layout.safeBottomPx, fontScale.scale
));
const portraitCoverSizeRpx = computed((): number => portraitMetrics.value.discRpx);
const portraitTurntable = computed(() => turntableMetrics(portraitCoverSizeRpx.value));
const portraitCoverStyle = computed((): string => "margin-top:" + (statusBarRpx.value + portraitMetrics.value.artTopRpx) + "rpx;width:" + portraitTurntable.value.widthRpx.toFixed(2) + "rpx;height:" + portraitTurntable.value.heightRpx.toFixed(2) + "rpx;");
const portraitTrackStyle = computed((): string => "min-height:" + (portraitMetrics.value.titleRowRpx + portraitMetrics.value.artistRowRpx + portraitMetrics.value.lyricRowRpx + 16) + "rpx;");
const portraitTitleRowStyle = computed((): string => "height:" + portraitMetrics.value.titleRowRpx + "rpx;");
const portraitArtistRowStyle = computed((): string => "height:" + portraitMetrics.value.artistRowRpx + "rpx;");
const portraitLyricRowStyle = computed((): string => "height:" + portraitMetrics.value.lyricRowRpx + "rpx;");
const portraitLyricWidthPx = computed((): number => 658 * portraitUnit.value);
const portraitBadgeWidthRpx = computed((): number => Math.ceil(platformShortName().length * 18 * fontScale.scale + 20));
const portraitBadgeStyle = computed((): string => "width:" + portraitBadgeWidthRpx.value + "rpx;background-color:" + platformColor(platformKey()) + ";color:" + theme.skin.mediaText + ";");
const portraitTitleWidthPx = computed((): number => {
  const badge = platformKey().length > 0 ? portraitBadgeWidthRpx.value + 12 : 0;
  return Math.max(1, (658 - 72 - 18 - badge) * portraitUnit.value);
});
const portraitArtistWidthPx = computed((): number => {
  // 658 = 整行预算；箭头 24 + 间距 10；「本地文件」标签可见时再让出 标签宽+12
  const badge = playingLocalFile.value ? portraitLocalBadgeWidthRpx.value + 12 : 0;
  return Math.max(1, (624 - badge) * portraitUnit.value);
});
/** 本次播放是不是本地文件：本地曲库歌，或在线歌被本地优先命中（下载账本/曲库扫描）。
 *  命中发生在原生层取链回调里，比切歌那一帧晚——localFirstUsed 是普通 Map，
 *  computed 追踪不到它，必须读 store 的版本号 localFirstTick 建立响应式依赖。 */
const playingLocalFile = computed((): boolean => {
  const cur = player.current;
  if (cur == null) return false;
  const tick = player.localFirstTick;
  if (tick < 0) return false;
  return cur.platform == "local" || player.localFirstPathOf(cur).length > 0;
});
const portraitLocalBadgeWidthRpx = computed((): number => Math.ceil(4 * 20 * fontScale.scale + 20));
const portraitLocalBadgeStyle = computed((): string => "width:" + portraitLocalBadgeWidthRpx.value + "rpx;background-color:" + playerRail.value + ";color:" + playerInk.value + ";");
/** Native material images share one canvas; the rotating wrapper is record-sized and centered. */
const portraitDiscWrapStyle = computed((): string => portraitCoverStyle.value + "position:relative;align-self:center;");
const portraitDiscPlateStyle = computed((): string => {
  const m = portraitTurntable.value;
  return "position:absolute;left:" + m.recordLeftRpx.toFixed(2) + "rpx;top:" + m.recordTopRpx.toFixed(2) + "rpx;width:" + m.recordRpx.toFixed(2) + "rpx;height:" + m.recordRpx.toFixed(2) + "rpx;border-radius:" + (m.recordRpx / 2).toFixed(2) + "rpx;";
});
const portraitDiscImgStyle = computed((): string => {
  const m = portraitTurntable.value;
  const off = (m.recordRpx - m.coverRpx) / 2;
  return "position:absolute;left:" + off.toFixed(2) + "rpx;top:" + off.toFixed(2) + "rpx;width:" + m.coverRpx.toFixed(2) + "rpx;height:" + m.coverRpx.toFixed(2) + "rpx;border-radius:" + (m.coverRpx / 2).toFixed(2) + "rpx;";
});
/* 唱片慢转（2026-11 美化，用户 m18202）：播放中转、暂停即停，真实黑胶只有唱臂静止。
   animate API 与 qt-marquee.uvue 同款（UniElement.animate，项目内已验证），
   cancel 即停；恢复时重开一轮（角度归零，视觉差异可忽略）。
   切到歌词视图时唱片 v-if 卸载，返回后按 playing 状态补启动。 */
const discSpinRef = ref<UniElement | null>(null);
let discSpinAnim: UniAnimation | null = null;
/* 转动状态仅用于切换原生动画与静止 transform；隐藏/卸载时统一取消动画。
   这不是旧文字重影原因的运行时证明。 */
const discSpinActive = ref(false);
function stopDiscSpin(): void {
  if (discSpinAnim != null) {
    try {
      discSpinAnim!.cancel();
    } catch (e) {
      // 静默：自然结束的动画再 cancel 抛异常属正常
    }
  }
  discSpinAnim = null;
  discSpinActive.value = false;
}
function startDiscSpin(): void {
  if (discSpinAnim != null) return;
  const el = discSpinRef.value;
  if (el == null) return;
  try {
    discSpinAnim = el.animate(
      [{ transform: "rotate(0deg)" }, { transform: "rotate(360deg)" }],
      { duration: 16000, iterations: Infinity, easing: "linear" }
    );
    discSpinActive.value = true;
  } catch (e) {
    // 静默：个别基座不支持动画时盘面静止即可，不影响功能
    discSpinAnim = null;
    discSpinActive.value = false;
  }
}
/* 转动中留空（transform 交给 animate 驱动），停转时强制归零 —— 见 stopDiscSpin 注释 */
const discSpinStyle = computed((): string => (discSpinActive.value ? "" : "transform:none;"));
function syncDiscSpin(): void {
  if (pageVisible.value && player.playing && !showLyric.value && !layout.isWide) startDiscSpin();
  else stopDiscSpin();
}
// A mode/ref replacement must cancel the old node before starting the new record.
watch(discSpinRef, () => {
  stopDiscSpin();
  nextTick(() => syncDiscSpin());
});
watch(() => layout.isWide, () => {
  stopDiscSpin();
  nextTick(() => syncDiscSpin());
});
watch(() => player.playing, () => syncDiscSpin());
watch(showLyric, () => {
  nextTick(() => syncDiscSpin());
});
onMounted(() => {
  nextTick(() => syncDiscSpin());
});
// （歌词预览区已删：previewGapStyle/previewFontStyle/previewTrFontStyle 一并移除，用户 m16808。）
// 竖屏歌词视口同样要避开导航（导航底 = 状态栏 + 96rpx，舞台 padding 只有 96rpx）
const portraitLyricStyle = computed((): string => "margin-top:" + (statusBarRpx.value + 8) + "rpx;");
function statusBarPx(): number {
  try {
    const info = uni.getWindowInfo();
    return Math.round(info.statusBarHeight > 0 ? info.statusBarHeight : 0);
  } catch (_) {
    return 0;
  }
}
/**
 * 队列行距：手机端 .queue-row 固定 104rpx，宽屏 60px。保留浮点精度；
 * 行的 top 全部由 index × 行距独立算出（绝对定位），不存在逐行累积误差。
 */
function queueStridePx(): number {
  if (layout.isWide) return 60;
  try {
    return qtRpx(104);
  } catch (_) {
    return 52;
  }
}
/** 撑出真实内容高度的容器：几千条也只是一个数字，不产生节点 */
const queueContentHeight = computed((): number => Math.ceil(player.queue.length * queueStridePx()));

/** 依据当前滚动位置重建窗口：只渲染可视区 ± QUEUE_WINDOW_MARGIN 的行 */
function rebuildQueueWindow(): void {
  const queue = player.queue;
  if (queue.length == 0) {
    queueWindow.value = [];
    return;
  }
  const stride = queueStridePx();
  const first = Math.max(0, Math.floor(queueScrollValue.value / stride) - QUEUE_WINDOW_MARGIN);
  const last = Math.min(queue.length - 1, Math.ceil((queueScrollValue.value + QUEUE_VIEWPORT_ESTIMATE) / stride) + QUEUE_WINDOW_MARGIN);
  const rows: QueueRow[] = [];
  for (let i = first; i <= last; i++) {
    const song = queue[i];
    if (song == null) continue;
    rows.push({ index: i, song: song, key: song.platform + ":" + song.id + ":" + i, top: Math.round(i * stride) });
  }
  queueWindow.value = rows;
}

function onQueueScroll(e: any): void {
  const st = e.detail != null ? Number(e.detail.scrollTop ?? 0) : 0;
  const prevFirst = Math.floor(queueScrollValue.value / queueStridePx());
  queueScrollValue.value = st;
  // 窗口首行没变就不重建，避免高频 scroll 触发无意义的 diff
  if (queueWindow.value.length == 0 || Math.floor(st / queueStridePx()) != prevFirst) {
    rebuildQueueWindow();
  }
}

/** 把列表滚到第 index 行（scroll-view 的 scroll-top 与视觉 1:1，纯数学定位） */
function scrollQueueToIndex(index: number): void {
  if (index < 0 || index >= player.queue.length) return;
  const target = Math.round(index * queueStridePx());
  queueScrollValue.value = target;
  queueScrollTop.value = target;
  rebuildQueueWindow();
}

/**
 * 弹层打开期间跟随正在播放的歌：切歌、自动下一首、拖动行或增删后，
 * 当前行的下标一变就把列表重新定位过去；没在打开时不打扰。
 */
watch(
  (): number => player.currentIndex(),
  (index: number) => {
    if (!queueOpen.value || index < 0) return;
    scrollQueueToIndex(index);
  }
);
/** 队列增删/拖动会整组替换数组，窗口里的行号随之偏移，必须重建 */
watch(
  (): Song[] => player.queue,
  () => {
    if (!queueOpen.value) return;
    rebuildQueueWindow();
  }
);
const lyricViewportHeightPx = ref(0);
const lyricPadPx = ref(0);
const lyricPadStyle = computed((): string => {
  // 上下留白必须取实际 scroll-view 视口的一半，而不是播放器整体高度的一半。
  // 这样首行和末行都能滚到同一个视觉中心。
  if (lyricPadPx.value > 0) return Math.round(lyricPadPx.value) + "px";
  return layout.isWide ? "120px" : lyricPadRpx.value + "rpx";
});
const lyricLines = ref<LyricLine[]>([]);
// Identity belongs to the applied data, not to the most recently requested song.
const lyricLinesKey = ref("");
/**
 * 逐字填充的当前词下标（-1 = 当前行没有逐字数据）。整词粒度的**阶跃**量：
 * 只在唱到下一个词时变一次，与旧的 karaokeSungCount 一样廉价。
 *
 * 与旧实现的区别：旧实现把颜色做成亮/暗两态、整词一次性变色，观感是「一个字一个字蹦」。
 * 现在同一时刻只有**正在唱的那一个词**是部分填充的，所以视觉上是一条连续的推进边界。
 */
const karaokeWordIndex = ref(-1);
/**
 * 正在唱的那个词的填充百分比（0..100，0.1 步进）——**唯一按帧刷新的状态**。
 *
 * 量化到 0.1%（与 qt-pc LyricWindow.tsx:495 的 `Math.round(fillRatio * 1000) / 10` 同口径）：
 * 同一档位不重复写 ref，避免整行重绘。
 */
const karaokeFillPct = ref(0);
/**
 * 逐字填充的插值基准，与 qt-pc 的 positionAnchorValue / positionAnchorMs 同构
 * （qt-pc/src/stores/player.ts:242-258 的 interpolatedPositionMs，由
 *  qt-pc/src/hooks/useInterpolatedPosition.ts 每帧读取）。
 *
 * 三条硬规则，缺一条就会出现「当前字前后摆动」：
 *  ① 锚点**只前进**。进度源允许回退（stores/player.ts:430 的 `t >= this.progress - 0.3`
 *     就是「真实位置追上来之前允许落后 0.3 秒」），若照单全收，每次 progress 回来都会把
 *     已经外推到的位置往前拽回，而帧内又继续往前推 —— 一来一回就是肉眼看到的摆动。
 *     小幅回退一律忽略，只有大幅度回跳（往回拖进度条、单曲循环回跳）才重新对表。
 *  ② 帧内只用**帧时钟**外推，且锚点时刻也用同一个帧时钟记录。qt-pc 用 performance.now()
 *     进出同一把单调时钟；这里没有 performance.now，就用 rAF 回调的 timestamp，
 *     绝不在锚点用 Date.now()、外推用 timestamp（两把时钟混用本身就是抖动的来源）。
 *  ③ 展示值**只进不退**（karaokeLastShown 兜底），换行/换歌/回跳时显式重置下限。
 *
 * 定时器生命周期照抄 uni_modules/qt-ui/components/qt-mini-player/qt-mini-player.uvue:66-91。
 */
let karaokeAnchorLine = -1;
/** 当前锚点进度（秒）与锚点时刻（帧时钟毫秒；-1 = 尚未在帧内打点） */
let karaokeBaseProgress = 0;
let karaokeBaseAt = -1;
/** 上一帧真正展示出去的进度：只进不退的兜底下限 */
let karaokeLastShown = 0;
let karaokeRafTimer: number | null = null;
/**
 * 同一行内允许忽略的进度回退量（秒）。
 * 进度源本身允许回退（stores/player.ts:430 用 `t >= this.progress - 0.3` 放行最多 0.3 秒），
 * 这点回退若照单全收就会把外推位置往回拽。0.5 秒足够盖住抖动，又远小于
 * 「单曲循环回到行首」「往回拖进度条」这类真实回跳，不会把该重对表的情况误判掉。
 */
const KARAOKE_REWIND_TOLERANCE_SEC = 0.5;
const activeLyric = ref(0);
const lyricScrollTop = ref(0);
/** 歌词滚动是否带动画：拖动进度条预览时关掉，避免动画被后续 move 事件反复打断（卡顿来源之一） */
const lyricScrollAnimated = ref(true);

// 歌词行副文本的空值守卫全部收进脚本：romanization/translation 是可选字段，
// 模板里 && 不保证短路（两边都求值），内联 `x != null && x.length` 会炸（09-30 账目）
// （歌词预览区 lyricContext/previewSubHas/previewSubText 已删：用户 m16808 这个页面的歌词不需要了，
//   hasRoma/hasTr 仍被歌词页正文使用，保留。）
function hasRoma(line: LyricLine): boolean {
  return line.romanization != null && line.romanization.length > 0;
}
function hasTr(line: LyricLine): boolean {
  return line.translation != null && line.translation.length > 0;
}
const dragging = ref(false);
const dragValue = ref(0);
/** 自定义进度条：轨道位置与宽度（px），用于把手指坐标换算成进度秒数 */
let progLeft = 0;
let progTrackTimer: number | null = null;
const progWidth = ref(0);
/** rpx -> px 换算系数（圆点像素定位用），setup 期即可确定，不依赖异步测量 */
let progUnit = qtRpx(1);
/**
 * 轨道左右两侧的固定占位（rpx），与样式常量一致：
 * .progress-row margin 24 + border 1 + padding 30 + .prog-time 76 + .prog-range margin 12。
 * boundingClientRect 是异步查询，页面首帧或从后台恢复后可能返回 0 宽度，
 * 旧实现此时把圆点算成 left:0 甩回起点（与填充条错位），故用该常量兜底推算几何。
 */
const PROG_SIDE_RPX = 24 + 1 + 30 + 76 + 12;
const rates: number[] = QT_PLAYBACK_RATES;
const rateIndex = ref(1);
const sheetVisible = ref(false);
const sheetTitle = ref("");
const sheetActions = ref<SheetAction[]>([]);
const sheetSelectedIndex = ref(-1);
let sheetSelectHandler: ((action: SheetAction, index: number) => void) | null = null;
const showPicker = ref(false);
const currentSong = ref<Song | null>(null);
const pickerAnchorTop = ref(-1);

function openPickerFor(song: Song | null, event: any): void {
  if (song == null) return;
  currentSong.value = song;
  // 取点击坐标（像素），作为下拉面板展开锚点
  if (event != null && event.detail != null) {
    pickerAnchorTop.value = event.detail.y;
  } else if (event != null && event.touches != null && event.touches.length > 0) {
    pickerAnchorTop.value = event.touches[0].clientY;
  } else {
    pickerAnchorTop.value = -1;
  }
  showPicker.value = true;
}

function openPicker(event: any): void {
  openPickerFor(player.current, event);
}

/** 点收藏类入口：没有自建歌单时提示，否则弹歌单选择器 */
function pickPlaylistFor(song: Song | null, event: any): void {
  if (!player.canPickPlaylist()) {
    qtShowToast({ title: "还没有歌单，请先新建", icon: "none" });
    return;
  }
  openPickerFor(song, event);
}

function getSelectedPlaylistIds(song: Song | null): string[] {
  if (song == null) return [];
  return player.pickerSelectedIds(song);
}

function handlePickerConfirm(selectedIds: string[]): void {
  const song = currentSong.value;
  if (song == null) return;
  // 统一由 store 处理：id=local 映射为加入/移出喜欢列表（同步服务器），其余为本地歌单增删
  applyPickerSelectionWithDupCheck(song, selectedIds);
}

/**
 * 收藏前先查「同名不同源」：把要加入的歌单分成「有冲突」和「没冲突」两拨，
 * 没冲突的那拨直接放行，有冲突的逐个弹确认（用户点「继续收藏」才真的加）。
 *
 * 确认是异步的，所以这里先把最终要生效的 id 集合算出来再一次性 apply，
 * 避免中间态把歌加进去了又撤回来。
 */
function applyPickerSelectionWithDupCheck(song: Song, selectedIds: string[]): void {
  const currentIds = player.pickerSelectedIds(song);
  const addIds: string[] = [];
  for (let i = 0; i < selectedIds.length; i++) {
    if (currentIds.indexOf(selectedIds[i]) < 0) addIds.push(selectedIds[i]);
  }
  const check = player.collectDupConflicts(song, addIds);
  if (check.conflicts.length == 0) {
    finishPickerSelection(song, selectedIds);
    return;
  }
  const finalIds: string[] = [];
  for (let i = 0; i < check.passed.length; i++) finalIds.push(check.passed[i]);
  for (let i = 0; i < selectedIds.length; i++) {
    const id = selectedIds[i];
    if (addIds.indexOf(id) < 0 && check.passed.indexOf(id) < 0) finalIds.push(id);
  }
  confirmDups(song, check.conflicts, finalIds);
}

/** 依次弹冲突确认，用户确认的歌单 id 追加进 pendingIds，全部问完才提交 */
function confirmDups(song: Song, conflicts: CollectDupConflict[], pendingIds: string[]): void {
  if (conflicts.length == 0) {
    finishPickerSelection(song, pendingIds);
    return;
  }
  const first = conflicts[0];
  const rest: CollectDupConflict[] = [];
  for (let i = 1; i < conflicts.length; i++) rest.push(conflicts[i]);
    qtConfirm({
    title: '同名歌曲提示',
    content: collectDupMessage(first.playlistName, first.dups),
    confirmText: '继续收藏',
    cancelText: '取消',
  }).then((ok: boolean) => {
      const ids: string[] = [];
      for (let i = 0; i < pendingIds.length; i++) ids.push(pendingIds[i]);
      if (ok) ids.push(first.playlistId);
      confirmDups(song, rest, ids);
  });
}

function finishPickerSelection(song: Song, selectedIds: string[]): void {
  const changed = player.applyPickerSelection(song, selectedIds);
  qtShowToast({
    title: changed ? '已更新收藏' : '未做更改',
    icon: 'none'
  });
}

function openActionSheet(title: string, actions: SheetAction[], select: (action: SheetAction, index: number) => void, selectedIndex: number = -1): void {
  sheetTitle.value = title;
  sheetActions.value = actions;
  sheetSelectedIndex.value = selectedIndex;
  sheetSelectHandler = select;
  sheetVisible.value = true;
}

function onSheetSelect(action: SheetAction, index: number): void {
  const handler = sheetSelectHandler;
  sheetSelectHandler = null;
  if (handler != null) handler(action, index);
}
/**
 * 宽屏歌词面板基准字号（实际渲染 = 本值 × 0.7 px，见 lrcStyle / karaokeFontSize）。
 *
 * 为什么是常量而不是 ref：这里原先留了半套配置 —— onMounted 从
 * uni.getStorageSync("qt-lyric-font-size") 回读，但全仓（含 git 历史）从无一处写入该 key，
 * 读到的永远是空、字号永远是初值。qt-pc 的播放页同样没有字号控制（只有桌面歌词窗口有，
 * 那是另一个独立开关），两端行为一致，所以直接收敛成固定值。
 * 日后真要做可调，请连 UI 一起加，不要再留「只读不写」的一半。
 */
const WIDE_LYRIC_FONT = 27;
/** 竖屏歌词页字号；宽屏面板行高固定 44px，维持原字号避免双语行溢出 */
const PORTRAIT_LYRIC_FONT = 38;
let lyricCenter = 300;
const lyricPadRpx = ref(300);
let lyricUnit = 0.5;
let touchStartX = 0;
let touchStartY = 0;
// 手势起点落在歌词滚动区（全屏/宽屏/竖屏歌词列表）时置位：
// 竖直拖动是在滚歌词，不是「下滑返回」，在 onTouchEnd 里据此跳过返回。
let touchFromLyricScroll = false;
/** 手势起点落在播放进度条上：横向长拖是拖动进度，不能当成左右滑切歌 */
let touchFromProg = false;
/** 最近一次手指落在歌词区的时间。只有它之后短时间内到达的 @scroll 才算「用户手动滚动」：
    程序化滚动的动画收尾、目标越界被原生钳位后的回弹，都会在 1 秒窗口外送达且位置远离目标，
    之前会被误判成手动滑动并反复刷新 4 秒抑制，自动跟随就再也回不来（有歌词但不定位）。 */
let lyricTouchAt = 0;
function onLyricScrollTouchStart(): void {
  touchFromLyricScroll = true;
  lyricTouchAt = Date.now();
}

const displayProgress = computed(() =>
  dragging.value ? dragValue.value : player.progress
);

let loadedKey = "";
let lyricLoadGeneration = 0;
function lyricRequestIsCurrent(key: string, generation: number): boolean {
  const current = player.current;
  return pageAlive && current != null && generation == lyricLoadGeneration
    && key == loadedKey && key == current.id + ":" + current.platform;
}

/** Reuse the existing playback/seek-preview clock and lyric offset; never start a second timer or full-list measurements. */
const portraitCurrentLyric = computed((): string => {
  const current = player.current;
  if (current == null) return "";
  const currentKey = current.id + ":" + current.platform;
  if (lyricLoading.value || lyricLinesKey.value != currentKey) return "歌词加载中…";
  const index = activeLyricIndex(lyricLines.value, displayProgress.value, lyricOffsetSec());
  if (index < 0 || index >= lyricLines.value.length) return "";
  const text = lyricLines.value[index].text.trim();
  // A timed blank is an instrumental pause: do not look ahead and display future words.
  return text;
});

function cycleRate(): void {
  rateIndex.value = (rateIndex.value + 1) % rates.length;
  const rate = rates[rateIndex.value];
  audioPlayer.changeRate(rate);
  qtShowToast({ title: "默认倍速 " + rate + "x", icon: "none" });
}
/** 用当前生效倍速回填下标（设置页也能改倍速，返回本页时需重新对齐显示） */
function syncRateIndex(): void {
  const rate = audioPlayer.rate;
  for (let index = 0; index < rates.length; index++) {
    if (Math.abs(rates[index] - rate) < 0.01) {
      rateIndex.value = index;
      return;
    }
  }
}

function openSleep(): void {
  const actions: SheetAction[] = QT_SLEEP_OPTIONS.map((opt) => ({ name: opt.name }));
  openActionSheet("定时关闭", actions, (_action, index) => {
    setSleep(QT_SLEEP_OPTIONS[index].minutes);
  }, qtSleepSelectedIndex(player.sleepStopAfterCurrent, player.sleepEndTime, player.sleepRequestedMinutes));
}
function setSleep(minutes: number): void {
  player.setSleep(minutes);
  if (minutes == 0) {
    qtShowToast({ title: "已关闭定时", icon: "none" });
  } else if (minutes == 90) {
    qtShowToast({ title: "播放完当前歌曲后退出应用", icon: "none" });
  } else {
    qtShowToast({ title: minutes + " 分钟后退出应用", icon: "none" });
  }
}

/** 定时关闭是否生效（-1=当前曲目后 / >0=剩余时间），生效时按钮染强调色 */
const sleepActive = computed(() => player.sleepEndTime != 0);

/** 当前歌曲是否命中屏蔽规则（dislikes 是 reactive 单例，规则变化自动重算） */
const dislikedCurrent = computed(() => {
  const current = player.current;
  if (current == null) return false;
  return dislikes.isDisliked(current);
});

/** 分享当前歌曲（shareCard.open 内部自处理空曲目） */
function shareCurrent(): void {
  const current = player.current;
  if (current == null) return;
  shareSong(current);
}

function openEqualizer(): void {
  uni.navigateTo({ url: "/pages/equalizer/index" });
}

/**
 * 屏蔽当前歌曲 / 歌手（与长按歌单行的屏蔽入口同语义）：
 * 行文案按当前规则状态切换「屏蔽 / 取消屏蔽」，避免「已屏蔽过」的二义性。
 */
function openDislikeSheet(): void {
  const current = player.current;
  if (current == null) return;
  const songBanned = dislikes.hasSongRule(current);
  const singerBanned = dislikes.hasSingerRule(current.singer);
  const actions: SheetAction[] = [
    { name: songBanned ? "取消屏蔽这首歌" : "屏蔽这首歌" },
    { name: singerBanned ? "取消屏蔽该歌手" : "屏蔽该歌手" },
  ];
  openActionSheet(current.name + " - " + current.singer, actions, (_action, index) => {
    let done = false;
    if (index == 0) {
      done = songBanned ? dislikes.unbanSong(current) : dislikes.banSong(current);
    } else {
      done = singerBanned ? dislikes.unbanSinger(current.singer) : dislikes.banSinger(current.singer);
    }
    qtShowToast({ title: done ? "已更新屏蔽" : "没有变化", icon: "none" });
  });
}

/** 换源搜索进行中标记：防止连点并发打多轮聚合搜索 */
const sourceSwitchLoading = ref(false);

/**
 * 换源：当前源不支持该歌曲时，聚合搜索其他源里同一首歌并弹层展示。
 * 选中后原地替换当前曲目字段并重播（与音质切换兜底同款 in-place 先例）。
 *
 * 结果有进程内缓存（10 分钟）：同一首歌第二次打开直接弹列表，不再打搜索、
 * 也不再闪「正在搜索…」（见 services/source-switch.ts）。
 * force = 忽略缓存重搜（长按/重新搜索入口用）。
 */
async function openSourceSwitch(force: boolean = false): Promise<void> {
  const current = player.current;
  if (current == null) return;
  if (sourceSwitchLoading.value) return;
  // 命中缓存：同步弹列表，连 showLoading 都不弹（弹了会闪一下）
  if (!force) {
    const cached = peekSourceCandidates(current);
    if (cached != null) {
      if (cached.length == 0) {
        qtShowToast({ title: "其他音源没有找到匹配的歌曲", icon: "none" });
        return;
      }
      showSourceCandidates(cached);
      return;
    }
  }
  sourceSwitchLoading.value = true;
  const switchToken = beginLoading("正在搜索其他音源…");
  try {
    const candidates = await findSourceCandidates(current, 1, 5, force);
    finishLoading(switchToken);
    if (candidates.length == 0) {
      qtShowToast({ title: "其他音源没有找到匹配的歌曲", icon: "none" });
      return;
    }
    showSourceCandidates(candidates);
  } catch (_) {
    finishLoading(switchToken);
    qtShowToast({ title: "搜索失败，请稍后再试", icon: "none" });
  } finally {
    sourceSwitchLoading.value = false;
  }
}

/** 把候选铺成 ActionSheet：名称带歌手与平台短名，选中就地替换当前曲目 */
function showSourceCandidates(candidates: Song[]): void {
  const actions: SheetAction[] = candidates.map((c) => ({
    name: c.name + " - " + c.singer + "（" + platformShort(c.platform) + "）",
  }));
  openActionSheet("换源", actions, (_action, index) => {
    applySourceCandidate(candidates[index]);
  });
}

/** 原地替换当前曲目为候选（保留播放位置），url 清空让播放链路重新获取 */
function applySourceCandidate(candidate: Song): void {
  const current = player.current;
  if (current == null || candidate == null) return;
  current.id = candidate.id;
  current.name = candidate.name;
  current.singer = candidate.singer;
  current.album = candidate.album;
  current.picUrl = candidate.picUrl;
  current.platform = candidate.platform;
  current.url = "";
  current.musicId = candidate.musicId;
  if (candidate.duration != null) current.duration = candidate.duration;
  player.play(current, player.queue, true);
}

function lrcStyle(index: number): string {
  // 高亮行只加粗变色不放大：放大会让行高随高亮位置漂移，实测行高失效
  const base = layout.isWide ? WIDE_LYRIC_FONT : PORTRAIT_LYRIC_FONT;
  // 宽屏下 rpx 被放大约 2.7 倍，改用绝对 px（按 750 设计稿折算：1rpx≈0.7px）
  const unit = layout.isWide ? "px" : "rpx";
  const scale = layout.isWide ? 0.7 : 1;
  return "font-size:" + Math.round(base * scale * fontScale.scale) + unit + ";color:" + (index == activeLyric.value ? playerInk.value : playerMuted.value) + ";";
}
function lrcTrStyle(index: number): string {
  // 翻译行固定用弱色：主句高亮时翻译也不抢眼（双语主/译层级对照目标样式）。
  // 翻译相对主句缩得更多（-12），对齐参考样式的主/译 0.7 比例
  const base = layout.isWide ? WIDE_LYRIC_FONT : PORTRAIT_LYRIC_FONT;
  const size = base - 12;
  const unit = layout.isWide ? "px" : "rpx";
  const scale = layout.isWide ? 0.7 : 1;
  return "font-size:" + Math.round(size * scale * fontScale.scale) + unit + ";color:" + playerMuted.value + ";";
}
/** 罗马音：与译文同字号同色系（都排在主句之下的副文本），不再单独分一档 */
function lrcRomaStyle(index: number): string {
  const base = layout.isWide ? WIDE_LYRIC_FONT : PORTRAIT_LYRIC_FONT;
  const size = base - 12;
  const unit = layout.isWide ? "px" : "rpx";
  const scale = layout.isWide ? 0.7 : 1;
  // 手机读音提示跟随共享前景，不能把白色带入浅灰背景；宽屏高亮仍保持原色。
  const color = layout.isWide && index == activeLyric.value
    ? "rgba(255,255,255,0.60)"
    : (index == activeLyric.value ? playerInk.value : playerMuted.value);
  return "font-size:" + Math.round(size * scale * fontScale.scale) + unit + ";color:" + color + ";";
}

// ===== 逐字卡拉 OK 渲染 =====
/**
 * 为什么不是 PC 端那套 `linear-gradient(90deg, currentColor X%, …)` + `background-clip: text`：
 * 1. `linear-gradient` / `background-image` 属 Web-only CSS，qt-uniappx/AGENTS.md 明令禁止
 *    （Vapor 编译会整条属性丢掉，染色直接消失而不是降级）；
 * 2. `background-clip: text` 在 uni-app x 的 <text> 上没有对应实现，且本仓所有 .uvue 里
 *    也从未出现过 <text> 嵌套 <text>（无法逐字套一层 span 再裁背景）。
 * 所以采用**逐词 <text> + 按进度切颜色**的方案：每个词一个 <text>，唱过（含正在唱）的词
 * 用高亮色、未唱的用弱色。粒度是「整词」而非「半字」，但这是当前 Vapor 渲染下唯一确定
 * 能落地的做法（颜色走内联字面值，不碰任何 Web-only 属性）。
 *
 * 另外只给**当前高亮行**渲染逐字：一是非当前行逐字没有意义（永远全弱色，观感与普通行一样，
 * 却多几十个 <text> 节点，60+ 行整表重绘会拖慢滚动）；二是与 PC PlayingPage.tsx:365 同口径。
 */
function isKaraokeLine(line: LyricLine, index: number): boolean {
  return index == activeLyric.value && line.words != null && line.words!.length > 0;
}
/**
 * 逐字字体（与 lrcStyle / .lrc 完全同口径）：宽屏 WIDE_LYRIC_FONT × 0.7 px、竖屏 PORTRAIT_LYRIC_FONT rpx。
 *
 * 为什么必须写在**每个词的 <text>** 上，而不能像原来那样写在行容器 <view> 上：
 * app-uvue 的样式不继承（官方 CSS 文档「样式不继承」：父子组件属性隔离，父元素样式不影响子元素），
 * 写在 <view> 上的 font-size 对子 <text> 完全无效 —— 逐字行的每个词因此一直回落到
 * css reset 的默认 16px，比普通行（.lrc-wide 16px / 竖屏 38rpx）还小，这就是「逐字播放时字体很小」。
 * 用 computed 缓存：字形串只在 layout/字号变化时重算，不再每次渲染给每个词拼一遍。
 */
const karaokeFontSize = computed((): string => {
  const base = layout.isWide ? WIDE_LYRIC_FONT : PORTRAIT_LYRIC_FONT;
  const scale = layout.isWide ? 0.7 : 1;
  return Math.round(base * scale * fontScale.scale) + (layout.isWide ? "px" : "rpx");
});
/**
 * 单个词的底色样式（未唱部分）：已唱完的词（下标 < karaokeWordIndex）= 高亮色，
 * 未唱/正在唱的词 = 弱色 —— 正在唱的词由上层填充层盖住它的左半部分，底色仍是弱色。
 * font-size 必须写在这里（<text> 节点上）；font-weight 由 .lrc-karaoke-word 这个 class 提供。
 */
function karaokeWordStyle(wordIndex: number): string {
  const sung = wordIndex < karaokeWordIndex.value;
  return "font-size:" + karaokeFontSize.value + ";"
    + "color:" + (sung ? playerInk.value : playerMuted.value) + ";";
}
/** 填充层的高亮字样式：与底色层**同字号同字重**，否则字形宽度不等、裁剪边界会错位 */
function karaokeLitStyle(): string {
  return "font-size:" + karaokeFontSize.value + ";color:" + playerInk.value + ";";
}
/**
 * 填充层宽度：按当前词的已唱比例裁掉右侧。
 *
 * 为什么不照抄 PC 的整行渐变：Vapor 不支持 `background-clip: text`（也没有 <text> 嵌套 <text>），
 * 所以改成「每个词两层同字文本上下叠，上层按宽度裁」——PC 的 LyricWindow.tsx 用
 * `linear-gradient` + `background-clip:text` 做的事，这里用 overflow:hidden + width 等价实现。
 *
 * 宽度用**百分比**：相对当前词外层的 `.lrc-karaoke-item`，而该容器的宽度恰好等于这个词的
 * 自然宽度（flex 行内收缩到内容宽）。所以不需要任何测量就能精确贴合——换字号、换主题、
 * 中英文混排都不会错位。AGENTS.md 禁的是 `max-width:100%`，百分比宽度本身无限制
 * （pages/download/index.uvue:17 的进度条就是 `width:' + progress + '%'`）。
 * 量化到 0.1%：与 qt-pc 的 `Math.round(fillRatio * 1000) / 10` 同口径，同档位不重复写 ref。
 */
function karaokeFillStyle(): string {
  return "width:" + karaokeFillPct.value + "%;";
}
/**
 * 逐字文本渲染：把词内的普通空格换成不间断空格（U+00A0）。
 *
 * 每个词是一个独立的 <text> 节点、且 `white-space: nowrap` 只保留词内空格却会吃掉
 * 行首/行尾的普通空格（浏览器与 Vapor 的排版引擎都如此）。音源包给的时间轴形如
 * `(0,500)I (500,300)believe `——空格挂在词的**尾部**，于是渲染时全被裁掉，
 * 真机上「I believe this has to have a meaning」显示成
 * 「Ibelievethistohaveameaning」。NBSP 不参与裁切也不参与折行，词间距得以保住。
 */
function karaokeText(text: string): string {
  const nbsp = String.fromCharCode(160);
  const parts = text.split(" ");
  let out = "";
  for (let i = 0; i < parts.length; i++) {
    if (i > 0) out = out + nbsp;
    out = out + (parts[i] as string);
  }
  return out;
}
/**
 * 帧内插值：与 qt-pc 的 interpolatedPositionMs 同构 ——
 * 位置 = 锚点值 + (帧时钟 - 锚点时刻) × 倍速，每帧都从锚点重算（不是逐帧累加，避免漂移）。
 *
 * 帧时钟统一用 rAF 回调的 timestamp，与锚点打点同源；绝不在锚点用 Date.now()、外推用
 * timestamp —— 两把时钟混用本身就是抖动的来源，qt-pc 全程只用 performance.now()。
 */
const karaokeRafStep = (timestamp: number) => {
  karaokeRafTimer = null;
  if (!pageAlive || karaokeAnchorLine < 0) return;
  if (!player.playing) {
    // 暂停：本帧不再续订（省电），但**必须把帧时钟打点作废**。
    // 否则恢复播放后的第一帧会拿「上一帧到现在」的整段暂停时长去外推，
    // elapsed 可能是几十秒，填充会瞬间冲到当前行末尾并锁死在那儿。
    // 归 -1 表示下一帧重新打点，暂停期间的位置由进度回调本身维持。
    karaokeBaseAt = -1;
    if (karaokeLastShown > karaokeBaseProgress) karaokeBaseProgress = karaokeLastShown;
    return;
  }
  // 本锚点还没有帧时钟打点（刚被 stepKaraoke 对过表 / 刚从暂停恢复）：用当前帧打点，elapsed 从 0 起算
  if (karaokeBaseAt < 0) karaokeBaseAt = timestamp;
  const elapsed = timestamp - karaokeBaseAt;
  if (elapsed > 0) {
    const rate = audioPlayer.rate;
    let next = karaokeBaseProgress + (elapsed / 1000) * (rate > 0 ? rate : 1);
    // 只进不退（见字段注释 ③）：进度源允许回退最多 0.3 秒，照单全收就会看到填充往回缩
    if (next < karaokeLastShown) next = karaokeLastShown;
    applyKaraokeFill(karaokeAnchorLine, next);
  }
  karaokeRafTimer = requestAnimationFrame(karaokeRafStep);
};
function startKaraokeRaf(): void {
  if (karaokeRafTimer != null) return;
  if (!player.playing) return;
  // 拖动进度条期间按墙钟外推是错的（音频并没有在走）：预览位置由 applyLyricPreview
  // 每次 move 直接写入，这里不开外推，免得填充层自己往前爬
  if (dragging.value) return;
  karaokeRafTimer = requestAnimationFrame(karaokeRafStep);
}
function stopKaraokeRaf(): void {
  const timer = karaokeRafTimer;
  if (timer != null) {
    cancelAnimationFrame(timer);
  }
  karaokeRafTimer = null;
  // 帧时钟打点必须一起作废：停表期间（暂停/拖动/切到封面态）rAF 不再跑，
  // 若把旧 timestamp 留着，恢复播放后的第一帧会拿「上一帧到现在」的整段间隔
  // （可能几秒甚至几分钟）去外推，填充瞬间冲到行尾。归 -1 = 下一帧重新打点。
  karaokeBaseAt = -1;
}
/** 按 (行, 进度秒) 重算「正在唱的词」与「该词的已唱比例」，只在值真的变了时写 ref */
function applyKaraokeFill(lineIndex: number, progressSec: number): void {
  // 只进不退：进度源本身允许回退最多 0.3 秒（stores/player.ts:430），照单全收会让填充往回缩。
  // 前进由 rAF 的插值负责，汇报值只用来对表 —— 所以这里一旦落后就贴住上限不动。
  let shown = progressSec;
  if (shown < karaokeLastShown) shown = karaokeLastShown;
  karaokeLastShown = shown;
  const line = lyricLines.value[lineIndex];
  if (line == null || line.words == null || line.words!.length == 0) return;
  const words = line.words!;
  // 偏移在函数内部统一减一次，调用方传原始进度即可，避免多处各减一遍漏掉一处
  const elapsedMs = (shown - lyricOffsetSec() - line.time) * 1000;
  const progress = wordProgressAt(words, elapsedMs);
  if (progress.index != karaokeWordIndex.value) karaokeWordIndex.value = progress.index;
  // ratio 就是「当前这个词唱了多少」；行未开唱时 wordProgressAt 给 {index:0, ratio:0}
  const pct = Math.round(progress.ratio * 1000) / 10;
  if (pct != karaokeFillPct.value) karaokeFillPct.value = pct;
}
/** 清空逐字填充（非逐字行 / 换歌 / 离开歌词视图）：停止外推并撤掉填充层 */
function resetKaraoke(): void {
  karaokeAnchorLine = -1;
  karaokeBaseProgress = 0;
  karaokeBaseAt = -1;
  karaokeLastShown = 0;
  stopKaraokeRaf();
  if (karaokeWordIndex.value != -1) karaokeWordIndex.value = -1;
  if (karaokeFillPct.value != 0) karaokeFillPct.value = 0;
}

// 页面存活标志（onUnmounted 置 false）。
// 不能只靠清定时器句柄：框架路由（reLaunch/redirectTo/navigateBack）是先 closeWebview
// 销毁原生页、再 unmountPage 跑 onUnmounted，中间那段窗口原生 UniPage 已反注册而本页
// 脚本还在；此时 createSelectorQuery().exec() 会走到 $nativePage.waitNativeRender，
// 桥调用带着已反注册的 instanceId → "UTS instance N is not registered"（真机堆栈：
// Bridge.onJSTimerFired ← Bridge$scheduleJSTimer$runnable$1.run ← Handler.handleCallback
// ← Looper.loop ← ActivityThread.main）。所以测量重试的回调进场先判这个标志。
let pageAlive = true;

/** 歌词视口高度测量重试预算（与行高测量同理：量不到就整首歌都用估算几何） */
let lyricCenterRetry = 0;
let lyricCenterTimer: number | null = null;
const LYRIC_CENTER_MAX_RETRY = 4;

function measureLyricCenter(): void {
  if (!pageAlive) return;
  lyricUnit = qtRpx(1);
  const query = uni.createSelectorQuery();
  query
    .select(".lyric-viewport")
    .boundingClientRect((rect: UniNodeInfo) => {
      if (!pageAlive) return;
      if (rect != null && rect.height > 0) {
        lyricCenterRetry = 0;
        lyricViewportHeightPx.value = Math.round(rect.height);
        lyricCenter = Math.round(rect.height / 2);
        lyricPadPx.value = Math.max(0, Math.round(rect.height / 2));
        // 保留 rpx 值作为未完成测量时的首帧兜底。实际渲染使用 lyricPadPx，
        // 不再把播放器整体高度或状态栏高度混入歌词视口。
        const hRpx = Math.round(rect.height / lyricUnit);
        lyricPadRpx.value = Math.max(0, Math.round(hRpx / 2));
        // 留白高度先提交到原生布局，再下发滚动，避免按旧内容高度钳位。
        nextTick(() => {
          if (pageAlive && lyricVisible.value) updateLyricScroll(true);
        });
        return;
      }
      // 量不到视口高度（节点还没渲染出来 / 布局未完成）：滚动目标的留白、视口高度、
      // 以及「行高估算兜底」会全部走估算几何。原来只测一次，失败一次就整首歌都偏，
      // 所以这里补几次重试（切到歌词视图 / 旋转时会重置预算）。
      if (!lyricVisible.value) return;
      if (lyricCenterRetry < LYRIC_CENTER_MAX_RETRY) {
        lyricCenterRetry++;
        lyricCenterTimer = setTimeout(() => { measureLyricCenter(); }, 120) as number;
      } else {
        qtDiag("[QT Lyric] 视口测量失败：rect=" + (rect != null ? Math.round(rect.height) : -1) + "，退回估算几何");
      }
    })
    .exec();
}
// 行高自适应（长句换行 + 双语），滚动定位优先用实测的每行高度。
// 未测量完成时按估算行高兜底，首帧之后实测值到达即纠正。
const lyricLineHeightsPx = ref<number[]>([]);
let lyricMeasureSeq = 0;
let lyricMeasureRetry = 0;
let lyricMeasureTimer: number | null = null;
const LYRIC_MEASURE_MAX_RETRY = 4;

/** 实测每行高度：selectAll 拿所有 .lyric-line 的 rect，整批有效才采纳 */
function measureLyricLineHeights(): void {
  if (!pageAlive) return;
  const seq = ++lyricMeasureSeq;
  const query = uni.createSelectorQuery();
  query
    .selectAll(".lyric-line")
    .boundingClientRect((rects: UniNodeInfo[]) => {
      if (seq != lyricMeasureSeq) return;
      const hs: number[] = [];
      let ok = rects.length > 0 && rects.length == lyricLines.value.length;
      for (let i = 0; i < rects.length; i++) {
        const h = (rects[i] as UniNodeInfo).height;
        if (!(h > 0)) {
          ok = false;
          break;
        }
        hs.push(h);
      }
      if (!ok) {
        // 一个 rect 都没拿到 = 歌词区当前没渲染（竖屏还没切到歌词视图）或布局未完成。
        // 这种情况**不能**当成「行高已失效」：这份实测值是本首歌唯一有效的一份，
        // 丢掉就只能全程退回估算行高，累计偏移偏大 → 滚动目标越界被原生钳位 →
        // 歌词停在错误位置不再跟随（真机复现：微光，播放进度走歌词不动）。
        // 只有「测到了但行数对不上」才是真的失效（换歌/字号变化），那时清空才正确。
        if (rects.length > 0 && lyricLineHeightsPx.value.length > 0) lyricLineHeightsPx.value = [];
        if (lyricMeasureRetry < LYRIC_MEASURE_MAX_RETRY) {
          lyricMeasureRetry++;
          lyricMeasureTimer = setTimeout(() => {
            lyricMeasureTimer = null;
            measureLyricLineHeights();
          }, 120);
        } else {
          // 重试耗尽仍测不到行高 → 之后只能退回估算行高定位（每条 110rpx，比实测偏大），
          // 累计偏移偏大、滚动目标越界被原生钳位，表现就是「歌词不跟着进度走」。
          qtDiag("[QT Lyric] 行高测量失败：rects=" + rects.length + " 期望=" + lyricLines.value.length + "，退回估算行高");
        }
        return;
      }
      lyricMeasureRetry = 0;
      const hadHeights = lyricLineHeightsPx.value.length > 0;
      lyricLineHeightsPx.value = hs;
      if (!hadHeights) {
        qtDiag("[QT Lyric] 行高实测成功：" + hs.length + " 行，首行 " + Math.round(hs[0]!) + "px");
      }
      if (lyricVisible.value) updateLyricScroll(true);
    })
    .exec();
}

/** 行高与累计偏移（实测优先，估算兜底），供滚动定位与反推共用 */
function lyricLineMetrics(): { offsets: number[]; heights: number[] } {
  const lines = lyricLines.value;
  const measured = lyricLineHeightsPx.value;
  const fallback = layout.isWide ? 44 : 110 * lyricUnit;
  const offsets: number[] = [];
  const heights: number[] = [];
  let acc = 0;
  for (let i = 0; i < lines.length; i++) {
    offsets.push(acc);
    const h = i < measured.length && measured[i]! > 0 ? measured[i]! : fallback;
    heights.push(h);
    acc += h;
  }
  return { offsets, heights };
}

// 边缘渐隐：行中心距视口中心超过 LYRIC_FADE_FULL 开始变淡，到 LYRIC_FADE_ZERO 全透明。
// 视口上缘贴标题栏、下缘贴操作栏，这两条边带（用户圈红的区域）不再停留可见歌词；
// 中部照常展示。自动跟随和手动滚动都按原生回报的实际位置算，目标不代表已经滚到。
const lyricLineOpacity = ref<number[]>([]);
let lyricActualScrollTop = 0;
let lyricOpacityTimer: number | null = null;
const LYRIC_FADE_FULL = 0.68;
const LYRIC_FADE_ZERO = 0.86;
let lyricOpacityLastAt = 0;
function computeLyricOpacity(scrollTop: number): void {
  const lines = lyricLines.value;
  // 估算行高只能用于定位；用它隐藏节点会把首帧中实际可见的后续歌词也隐藏。
  if (lines.length == 0 || lyricViewportHeightPx.value <= 0 || lyricLineHeightsPx.value.length != lines.length) {
    lyricLineOpacity.value = [];
    return;
  }
  const viewportHeight = lyricViewportHeightPx.value;
  const pad = lyricPadPx.value;
  const { offsets, heights } = lyricLineMetrics();
  // 与 lyricTargetFromScrollTop 相同的换算：scrollTop → 视口中心对应的内容坐标
  const viewCenter = scrollTop + viewportHeight / 2 - pad;
  const full = viewportHeight / 2 * LYRIC_FADE_FULL;
  const zero = viewportHeight / 2 * LYRIC_FADE_ZERO;
  const ops: number[] = [];
  for (let i = 0; i < lines.length; i++) {
    const d = Math.abs(offsets[i]! + heights[i]! / 2 - viewCenter);
    let o = 1.0;
    if (d >= zero) o = 0.0;
    else if (d > full) o = 1.0 - (d - full) / (zero - full);
    ops.push(Math.round(o * 100.0) / 100.0);
  }
  lyricLineOpacity.value = ops;
}
function lineOpacityStyle(index: number): string {
  const arr = lyricLineOpacity.value;
  // 显式恢复为 1，避免原生节点复用时保留上一次的透明度。
  const o = index < arr.length ? arr[index]! : 1;
  return "opacity:" + o.toFixed(2) + ";";
}

// 精确居中：第 index 行中心滚到视口正中央（px）。
function lyricScrollValue(index: number): number {
  const viewportHeight = lyricViewportHeightPx.value > 0
    ? lyricViewportHeightPx.value
    : (layout.isWide ? 240 : lyricPadRpx.value * lyricUnit * 2);
  const pad = lyricPadPx.value > 0 ? lyricPadPx.value : viewportHeight / 2;
  const { offsets, heights } = lyricLineMetrics();
  const h = index < heights.length ? heights[index]! : 0;
  const center = index < offsets.length ? offsets[index]! + h / 2 : 0;
  // scrollTop 是相对内容顶部的偏移：扣掉视口中心后，目标行中心才会落在屏幕中心。
  const target = pad + center - viewportHeight / 2;
  const contentHeight = pad * 2 + center + h / 2;
  const maxScroll = Math.max(0, contentHeight - viewportHeight);
  // 末行定位时严格限制在 scroll-view 可滚动范围内，避免原生组件把位置直接归零。
  return Math.max(0, Math.min(target, maxScroll));
}
// 用户手动滚动歌词的检测：程序化滚动（scroll-with-animation 也会触发 @scroll）
// 在时间窗口内忽略，窗口外的 @scroll 视为用户手动滑动 —— 4 秒内暂停自动居中跟随，
// 让用户可以自由滑到任意歌词行（点击行跳转后立即恢复跟随）。
let lyricProgrammaticUntil = 0;
let lyricUserScrollAt = 0;
/** 最近一次下发给原生 scroll-view 的目标位置：同值重复下发原生侧不会动（用来兜底重发），
    也用来识别动画尾声事件 */
let lyricLastTarget = 0;
/** 跟随滚动被「用户手动滑动」挡下过一次：4 秒窗口一结束就由进度心跳补一次归位 */
let lyricScrollPending = false;
// 时间戳仅手动滚动期间显示，滚动停止 4 秒后隐藏。
// 展示形态仿 QQ 音乐：不在每行挂时间，而是目标行（最接近视口中心的行）整行
// 覆盖一条半透明高亮条 —— 时间贴条最左、播放图标贴条最右，点击该行即跳转。
const lyricTimesVisible = ref(false);
const lyricTargetIndex = ref(-1);
let lyricTimesTimer: number | null = null;
function hideLyricTimes(): void {
  if (lyricTimesTimer != null) {
    clearTimeout(lyricTimesTimer);
    lyricTimesTimer = null;
  }
  lyricTimesVisible.value = false;
  lyricTargetIndex.value = -1;
}
function onLyricUserScroll(e: any): void {
  if (!pageAlive) return;
  const now = Date.now();
  const top = e != null && e.detail != null ? Number(e.detail.scrollTop ?? 0) : 0;
  lyricActualScrollTop = top;
  // 自动滚动也必须刷新渐隐；用户手势门控只负责暂停跟随和显示时间提示。
  if (lyricOpacityTimer != null) {
    clearTimeout(lyricOpacityTimer);
    lyricOpacityTimer = null;
  }
  if (now - lyricOpacityLastAt >= 80) {
    lyricOpacityLastAt = now;
    computeLyricOpacity(top);
  } else {
    // 保留最后一个事件，动画结束不能停留在倒数一帧的透明度。
    lyricOpacityTimer = setTimeout(() => {
      lyricOpacityTimer = null;
      if (!pageAlive) return;
      lyricOpacityLastAt = Date.now();
      computeLyricOpacity(lyricActualScrollTop);
    }, 80 - (now - lyricOpacityLastAt)) as number;
  }
  if (now <= lyricProgrammaticUntil) return;
  // 手指不在歌词区（且近 3 秒内也没落过）的 @scroll 不是用户滑动：直接忽略。
  if (now - lyricTouchAt > 3000) return;
  // 动画尾声事件：窗口期外才送达、但位置仍贴着程序化目标 —— 不是用户滑动。
  // 进度时钟起来后渲染更频繁，动画可能拖过 1 秒窗口；若把它误判成手动滑动，
  // 4 秒抑制会被反复刷新，自动跟随就再也回不来（歌词停在偏离中心的位置）。
  if (Math.abs(top - lyricLastTarget) < 4) return;
  lyricUserScrollAt = now;
  lyricTimesVisible.value = true;
  lyricTargetIndex.value = lyricTargetFromScrollTop(top);
  if (lyricTimesTimer != null) clearTimeout(lyricTimesTimer);
  lyricTimesTimer = setTimeout(() => {
    lyricTimesTimer = null;
    if (!pageAlive) return;
    lyricTimesVisible.value = false;
    lyricTargetIndex.value = -1;
  }, 4000);
}
/** 由 scrollTop 反推最接近视口中心的歌词行（几何与 lyricScrollValue 严格互逆） */
function lyricTargetFromScrollTop(scrollTop: number): number {
  const lines = lyricLines.value;
  if (lines.length == 0) return -1;
  const viewportHeight = lyricViewportHeightPx.value > 0
    ? lyricViewportHeightPx.value
    : (layout.isWide ? 240 : lyricPadRpx.value * lyricUnit * 2);
  const pad = lyricPadPx.value > 0 ? lyricPadPx.value : viewportHeight / 2;
  const centerOffset = scrollTop + viewportHeight / 2 - pad;
  const { offsets, heights } = lyricLineMetrics();
  for (let i = 0; i < offsets.length; i++) {
    if (centerOffset < offsets[i]! + heights[i]!) return i;
  }
  return lines.length - 1;
}
/** 程序化滚动统一入口：记录窗口期，避免把自身的动画误判为手动滑动 */
function setLyricScrollTop(value: number, skipOpacity = false): void {
  lyricProgrammaticUntil = Date.now() + 1000;
  lyricLastTarget = value;
  // 目标可能尚未到达或被原生布局钳位，渐隐只使用已经回报的实际位置。
  if (!skipOpacity) computeLyricOpacity(lyricActualScrollTop);
  if (lyricScrollTop.value == value) {
    // scroll-top 是单向绑定：值不变原生侧不会滚动。用户手动滑走后实际位置已偏离，
    // 需要先挪 1px 再归位，原生才会真正滚回去（用户滑走后恢复跟随就靠这一步）
    lyricScrollTop.value = value + 1;
    nextTick(() => {
      lyricScrollTop.value = value;
    });
    return;
  }
  lyricScrollTop.value = value;
}
/**
 * 逐字填充推进：把「当前唱到哪个词、这个词唱了多少」写进 karaokeWordIndex / karaokeFillPct。
 *
 * 两个 ref 的分工：词下标是**阶跃**量（一首歌只变几十次），填充比例是**连续**量（每帧都可能变）。
 * 分开存是为了让「跨词」这类结构性变化与「同一词内推进」这类纯数值变化互不牵连——
 * 后者只重算填充层的 width，不重建任何节点。
 *
 * 对表规则（锚点语义与 qt-pc interpolatedPositionMs 一致，但多了抗回退）：
 * - 换行 → 无条件重锚；
 * - 同一行内**正常回报** → 只往前对表：新锚点取 `max(报告值, 展示值)`。
 *   报告值只允许把锚点往前推，绝不允许把锚点往回拽。展示值此刻通常已经
 *   被帧内插值推到报告值前面（报告 100ms 粒度 + 链路延迟），若照报告值重锚，
 *   画面就会被往回拽一次、下一帧再往前推 —— 一来一回正是「前后摆动」。
 *   反过来若直接忽略报告值、只认展示值，则帧内插值与音频之间的缓慢漂移无法校正，
 *   所以取 max：落后时吃报告值追上去，领先时保持不动。
 * - 同一行内**大幅回跳**（往回拖进度条 / 单曲循环回跳）→ 重锚并放开只进不退的下限。
 * 非逐字行一律 resetKaraoke()，保证换歌/换行后不会残留上一行的填充层。
 */
function stepKaraoke(lineIndex: number, progressSec: number): void {
  const line = lyricLines.value[lineIndex];
  if (line == null || line.words == null || line.words!.length == 0) {
    resetKaraoke();
    return;
  }
  if (dragging.value) {
    // 拖动进度条预览：位置完全由手指决定，来回拖是正常操作，绝不能被「只进不退」挡住，
    // 也不开插值（音频没在走）。无条件重锚并把展示下限压到当前预览位置。
    karaokeAnchorLine = lineIndex;
    karaokeBaseProgress = progressSec;
    karaokeBaseAt = -1;
    karaokeLastShown = progressSec;
    applyKaraokeFill(lineIndex, progressSec);
    return;
  }
  if (lineIndex != karaokeAnchorLine) {
    // 换行：无条件重锚，展示下限也跟着落到新行起点
    karaokeAnchorLine = lineIndex;
    karaokeBaseProgress = progressSec;
    karaokeBaseAt = -1;
    karaokeLastShown = progressSec;
  } else if (progressSec < karaokeLastShown - KARAOKE_REWIND_TOLERANCE_SEC) {
    // 真回跳：重锚并放开下限，让填充能往后走
    karaokeBaseProgress = progressSec;
    karaokeBaseAt = -1;
    karaokeLastShown = progressSec;
  } else {
    // 同一行内正常回报：只往前对表（见函数注释），向后一律不动
    const base = progressSec > karaokeLastShown ? progressSec : karaokeLastShown;
    if (base > karaokeBaseProgress) {
      // 值前移 + 时刻作废（下一帧重新打点），两者必须成对更新：
      // 只改值不改时刻，下一帧算出的 elapsed 会把「上一锚点到现在」的时间再加一遍
      karaokeBaseProgress = base;
      karaokeBaseAt = -1;
    }
  }
  applyKaraokeFill(lineIndex, progressSec);
  startKaraokeRaf();
}

function updateLyricScroll(force: boolean): void {
  const lines = lyricLines.value;
  if (lines.length == 0) {
    return;
  }
  // 拖动进度条期间：高亮行与滚动位置完全交给 previewBySeconds/applyLyricPreview。
  // 必须在「按 player.progress 重算 activeLyric」之前就返回 —— 进度时钟每 100ms 触发本函数，
  // 若先按 player.progress（拖动时它仍是旧位置）改写 activeLyric，就会和拖动预览来回抢，
  // 三行预览歌词表现为反复抖动（拖动进度条时的抖动来源）。
  if (dragging.value) {
    return;
  }
  let index = 0;
  const progress = player.progress;
  // 偏移（正 = 歌词延后出现）在这里体现为「用 progress - offsetSec 去比时间轴」，
  // 与 utils/lrc.uts 的 activeLyricIndex / desktop-lyric.uts 同口径。
  // 只改比较对象，不动 lines[i].time（改了会让点行跳转 seek 到错误位置）。
  const offsetSec = lyricOffsetSec();
  // 不能 break：单行时间异常（乱序/被误解析成很大的值）时 break 会把高亮钉死在前一行
  for (let i = 0; i < lines.length; i++) {
    if (lines[i].time <= progress - offsetSec) index = i;
  }
  if (index != activeLyric.value) activeLyric.value = index;
  // 逐字填充推进 + 刷新墙钟锚点，必须在歌词可见时才算：竖屏还没切到歌词视图时，
  // 算出来的填充只换来一轮无用重绘（也没必要为此开 rAF）。
  // 拖动期间本函数在上面已 return，预览由 applyLyricPreview 单独推进。
  // 这里传原始进度：偏移由 stepKaraoke 内部减，重复减会算成两倍偏移。
  if (lyricVisible.value) {
    stepKaraoke(index, displayProgress.value);
  } else {
    // 歌词不可见（竖屏封面态）：撤掉填充层并停掉 rAF，别让定时器空转
    resetKaraoke();
    return;
  }
  // 用户刚手动滑过（非 force）时不抢滚动位置；错过的归位记下来，窗口一结束就补上
  const userScrolling = !force && Date.now() - lyricUserScrollAt < 4000;
  if (userScrolling) {
    lyricScrollPending = true;
    return;
  }
  const target = lyricScrollValue(index);
  // 目标没变就不重复下发：反复触发同值滚动只会打断正在进行的滚动动画
  if (!force && !lyricScrollPending && target == lyricLastTarget) {
    return;
  }
  lyricScrollPending = false;
  setLyricScrollTop(target);
}

function back(): void {
  uni.navigateBack({});
}
function art(): string {
  const current = player.current;
  // 在播本地文件有内嵌封面就用它（coverOf 内部回落到 song.picUrl）
  return current != null ? player.coverOf(current) : "";
}
function name(): string {
  const current = player.current;
  return current != null ? current.name : "";
}
function artistText(): string {
  const current = player.current;
  if (current == null) return "";
  // 只显示歌手，不带专辑（用户 m17489：不要后面的专辑，且「歌手 - 专辑」太长会把文字挤得被吞）
  return current.singer.trim().length > 0 ? current.singer : "未知歌手";
}
function platformKey(): string {
  const current = player.current;
  return current != null ? current.platform : "";
}
function platformShortName(): string {
  return platformShort(platformKey());
}
/**
 * 当前曲目的实测码率（kbps；0 = 还不知道，整行不显示）。
 *
 * 数据来源是「取链时 Range 预检实测到的文件字节数」（musicApi.actualBitrateOf，
 * 口径与 qt-pc 播放控制栏一致：size*8/时长/1000，缺一项就空着，绝不写 0 kbps）。
 * 那份 size 只有 resolvePlayUrl 成功的那一刻才落库（music-api.ts 的 urlSize），
 * 所以首帧必然是 0，必须靠 watch 补算 —— 不能写成 computed：urlSize 是普通 Map，
 * 没有任何响应式依赖可以追踪。
 */
const bitrateKbps = ref(0);
/**
 * 实测码率（用户 m17053「320K 后面对应的 kbps 没有显示」）：
 * ①本地优先命中（在线歌播磁盘文件 / 纯本地歌）：stat 本地文件字节数 ×8/时长，
 *   显示的是**实际在播文件**的真实码率（本地文件是哪档就是哪档，与名义档位无关）。
 *   本地命中必须排最前：urlSize 里可能挂着这首上一轮在线播的残留值，先看在线
 *   值会把本地命中显示成在线码率（m22743「歌单点播还是在线」的用户观感来源）；
 * ②在线取链：musicApi.actualBitrateOf（urlSize 表，取链成功/HEAD 探到后就有值）；
 * ③都没量到（歌还没起播 / 文件 stat 失败）：显示 0，这一行只显示音质名。
 */
function refreshBitrate(): void {
  const current = player.current;
  if (current == null) {
    bitrateKbps.value = 0;
    return;
  }
  // 本地优先命中（在线歌播磁盘文件 / 纯本地歌）优先看：此刻实际在播的就是这个
  // 文件，urlSize 里那份在线预检值（该曲上一轮在线播残留/旧版歌单页预取链灌入）
  // 不代表「现在在播什么」。先看在线值会把本地命中显示成在线码率，像「还是在线」
  // （m22743）——顺序必须是：本地在播文件 > 在线预检值。
  const localPath = current.platform == "local" ? player.resolvedUrlOf(current) : player.localFirstPathOf(current);
  if (localPath != null && localPath.length > 0 && !localPath.startsWith("http")) {
    const duration = current.duration;
    if (duration <= 0) {
      bitrateKbps.value = 0;
      return;
    }
    localFileSizeOf(localPath)
      .then((size: number) => {
        // 异步回来时可能已切歌：校验还是同一首再落值，避免旧值盖新歌
        const now = player.current;
        if (now == null || now.platform + ":" + now.id != current.platform + ":" + current.id) return;
        bitrateKbps.value = size > 0 ? Math.round((size * 8) / duration / 1000) : 0;
      })
      .catch(() => {});
    return;
  }
  // 在线取链：urlSize 预检实测值
  const online = musicApi.actualBitrateOf(current, player.effQualityOf(current));
  bitrateKbps.value = online > 0 ? online : 0;
}
/** 平台与码率都没有时，这一行整个不渲染（不留空行）。 */
function hasMeta(): boolean {
  return platformKey().length > 0 || bitrateKbps.value > 0;
}

/**
 * 码率的「晚到值」兜底（用户 m17489「有时后面的 kpbs 会不显示」）。
 *
 * 这条链上 size 有四个来源，**没有一个和播放状态同步**：
 *  ① 音源包取链时随地址回报（现在 music-api 写完就广播，见 URL_SIZE_EVENT）；
 *  ② 老包不回报 → 宿主 HEAD 探测（异步，几百毫秒到数秒）；
 *  ③ 本地优先命中：命中发生在取链回调里（stores/player.ts 的 localFirstUsed.set），
 *     比切歌那一帧晚，页面首算时 localFirstPathOf 还是空串，而它**不发任何事件**；
 *  ④ iPhone/本地曲库：stat 文件（异步）。
 * 只在切歌 / 音质变 / playing 翻真这三个时刻算一次，就会漏掉 ③② 这两条晚到路径，
 * 表现就是「同一首歌这会有码率、那会只有音质名」。这里改成：每次触发先算一次，
 * 再在随后几秒内补算几拍，任一拍量到就停（bitrateKbps > 0 即视为已量到）。
 * 定时器在 onUnload 清掉，页面反复进出不叠。
 */
let bitrateSettleTimers: number[] = [];
function stopBitrateSettle(): void {
  for (let i = 0; i < bitrateSettleTimers.length; i++) {
    clearTimeout(bitrateSettleTimers[i]);
  }
  bitrateSettleTimers = [];
}
function refreshBitrateSettled(): void {
  stopBitrateSettle();
  refreshBitrate();
  const delays: number[] = [400, 1200, 2600, 5000];
  for (let i = 0; i < delays.length; i++) {
    bitrateSettleTimers.push(
      setTimeout(() => {
        if (bitrateKbps.value <= 0) refreshBitrate();
      }, delays[i]) as unknown as number
    );
  }
}
// 切歌、换音质：立刻重算，随后几拍补算（此时多半还是 0，靠补算兜底）
watch((): Song | null => player.current, (): void => {
  refreshBitrateSettled();
});
watch((): string => player.quality, (): void => {
  refreshBitrateSettled();
});
// 切歌：封面从透明淡入（旧封面同帧消失，视觉上是一次干净的换图）。
// 只挂在换歌上：首次进页 / 恢复播放不改 coverShown，避免无谓的重绘。
watch((): string => (player.current == null ? "" : player.current.id), (id: string, prev: string): void => {
  if (prev == null || prev == "" || id == prev) {
    return;
  }
  coverShown.value = false;
  setTimeout(() => {
    coverShown.value = true;
  }, 16);
});
// 真正拿到 size 的时刻：取链成功 → 原生起播 → playing 翻真。playing 只在状态切换时
// 变，比盯 progress（秒级心跳）省，又能覆盖「首帧 0、起播后才知道」这条时序。
// immediate：歌已在播时才进播放页（最常见的打开方式），playing 不会再翻转，
// 普通 watch 一次都不触发，「xxx kbps」就永远不显示 —— 进页立刻补算一次。
watch(
  (): boolean => player.playing,
  (playing: boolean): void => {
    if (playing) refreshBitrateSettled();
  },
  { immediate: true }
);
// 老音源包不回报 size 时，宿主会 HEAD 探测兜底（music-api.probeUrlSize），
// 探到就广播这条事件 —— 听到后重算一次，kpbs 行才能在起播一两秒内补出来。
// 具名函数：onUnload 里要按同一引用 $off，页面反复进出不能叠监听器。
function onUrlSizeProbed(): void {
  refreshBitrate();
}
uni.$on(MusicApi.URL_SIZE_EVENT, onUrlSizeProbed);
function format(seconds: number): string {
  const min = Math.floor(seconds / 60);
  const sec = Math.floor(seconds % 60);
  return min + ":" + (sec < 10 ? "0" : "") + sec;
}
/** 自定义进度条：拖拽过程中预演进度并联动歌词滚动 */
function applyLyricPreview(seconds: number): void {
  const lines = lyricLines.value;
  let index = 0;
  // 拖动预览与 updateLyricScroll 同口径：偏移体现为 seconds - offsetSec。
  // 松手后 player.seek(seconds) 是不加偏移的（用户拖到的位置就是他要听的位置），
  // 所以预览也必须按 seconds - offsetSec 取行，否则松手瞬间高亮会跳一行。
  const offsetSec = lyricOffsetSec();
  // 同 updateLyricScroll：不 break，异常时间行不能影响其它行的取用
  for (let i = 0; i < lines.length; i++) {
    if (lines[i].time <= seconds - offsetSec) index = i;
  }
  activeLyric.value = index;
  if (!lyricVisible.value) return;
  // 拖动预览也要跟着走逐字染色：拖动时 updateLyricScroll 在上面已 return，
  // 这里补一次推进，松手前就能看到目标位置的唱词状态
  // 传原始 seconds：偏移由 stepKaraoke 内部减，重复减会算成两倍偏移
  stepKaraoke(index, seconds);
  // 预览只挪位置、不重算边缘渐隐：60+ 行整表重算 + 重绘是拖动卡顿的主因
  setLyricScrollTop(lyricScrollValue(index), true);
}
/** 拖动进度条期间的歌词预览：move 事件限频，避免每个事件都触发歌词整表重渲染 */
let lyricPreviewAt = 0;
function previewBySeconds(seconds: number): void {
  dragValue.value = seconds;
  const now = Date.now();
  if (now - lyricPreviewAt < 90) return;
  lyricPreviewAt = now;
  applyLyricPreview(seconds);
}
/** 进度条填充百分比（0..100） */
function progPct(): number {
  const d = player.duration;
  if (d <= 0) return 0;
  const p = displayProgress.value;
  return Math.max(0, Math.min(100, (p / d) * 100));
}
/** 依据手指横向位置换算成秒（0..duration） */
function progFromClientX(clientX: number): number {
  if (player.duration <= 0) return 0;
  const width = progTrackWidth();
  if (width <= 0) return 0;
  const frac = Math.max(0, Math.min(1, (clientX - progTrackLeft()) / width));
  return frac * player.duration;
}
/** 常量兜底几何：只在测量时机刷新，避免拖动进度条时每帧调 uni.getWindowInfo() */
let progFallbackWidth = 0;
let progFallbackLeft = 0;
function refreshProgFallback(): void {
  progUnit = qtRpx(1);
  const info = uni.getWindowInfo();
  progFallbackWidth = Math.max(0, info.windowWidth - PROG_SIDE_RPX * 2 * progUnit);
  progFallbackLeft = PROG_SIDE_RPX * progUnit;
}
/** 轨道宽度（px）：优先用实测值，未测到时按样式常量推算 */
function progTrackWidth(): number {
  if (progWidth.value > 0) return progWidth.value;
  if (progFallbackWidth <= 0) refreshProgFallback();
  return progFallbackWidth;
}
/** 轨道左边界（px）：优先用实测值，未测到时按样式常量推算 */
function progTrackLeft(): number {
  if (progWidth.value > 0) return progLeft;
  if (progFallbackWidth <= 0) refreshProgFallback();
  return progFallbackLeft;
}
/** 圆点 left（px），圆心对齐填充终点；读响应式 ref，模板调用会被追踪依赖 */
function progThumbLeft(): number {
  const d = player.duration;
  if (d <= 0) return 0;
  const width = progTrackWidth();
  if (width <= 0) return 0;
  const fillPx = (displayProgress.value / d) * width;
  const size = layout.isWide ? 14 : 16 * progUnit; // 16rpx 小圆点（m18202 细化，参考图极细进度条），宽屏 14px
  // 两端夹紧，保证圆点始终在轨道内且圆心贴住填充终点
  return Math.max(0, Math.min(width - size, fillPx - size / 2));
}
function measureProgTrack(): void {
  measureProgTrackRetry(0);
}
/**
 * 测量轨道几何。页面首帧/从后台恢复时 boundingClientRect 可能返回 0 宽度，
 * 这里最多重试 3 次；期间圆点先用常量推算的几何定位，不会停在起点。
 */
function measureProgTrackRetry(attempt: number): void {
  if (!pageAlive) return;
  refreshProgFallback();
  const query = uni.createSelectorQuery();
  query
    .select(".prog-range")
    .boundingClientRect((rect: UniNodeInfo) => {
      if (rect != null && rect.width > 0) {
        progLeft = rect.left;
        progWidth.value = rect.width;
        return;
      }
      if (attempt < 3) {
        progTrackTimer = setTimeout(() => {
          measureProgTrackRetry(attempt + 1);
        }, 120) as number;
      }
    })
    .exec();
}
function onProgTouchStart(event: UniTouchEvent): void {
  const touch = event.touches[0];
  if (touch == null) return;
  measureProgTrack();
  dragging.value = true;
  touchFromProg = true;
  // 拖动期间歌词直接定位不做滚动动画：动画会被后续 move 事件反复打断，视觉上就是卡顿
  lyricScrollAnimated.value = false;
  lyricPreviewAt = 0;
  previewBySeconds(progFromClientX(touch.clientX));
}
function onProgTouchMove(event: UniTouchEvent): void {
  if (!dragging.value) return;
  const touch = event.touches[0];
  if (touch == null) return;
  previewBySeconds(progFromClientX(touch.clientX));
}
function onProgTouchEnd(event: UniTouchEvent): void {
  if (!dragging.value) return;
  const changed = event.changedTouches;
  const touch = changed != null && changed.length > 0 ? changed[0] : null;
  const value = touch != null ? progFromClientX(touch.clientX) : dragValue.value;
  dragging.value = false;
  lyricScrollAnimated.value = true;
  lyricPreviewAt = 0;
  // 落点立即定位，不等 seek 回传进度：否则会先跳回旧位置再被进度时钟纠正，看着像闪一下
  applyLyricPreview(value);
  player.seek(value);
  // 拖动期间跳过了渐隐重算，这里按最终位置补一次
  computeLyricOpacity(lyricActualScrollTop);
}
/** 触摸被系统打断（来电、手势冲突）：必须复位拖动态，否则进度条与歌词跟随会一直卡住 */
function onProgTouchCancel(): void {
  if (!dragging.value) return;
  dragging.value = false;
  touchFromProg = false;
  lyricScrollAnimated.value = true;
  lyricPreviewAt = 0;
  computeLyricOpacity(lyricActualScrollTop);
}
function seekBy(seconds: number): void {
  if (player.duration <= 0) return;
  const target = Math.min(player.duration, Math.max(0, player.progress + seconds));
  player.seek(target);
  updateLyricScroll(true);
}
function toggleLyric(): void {
  showLyric.value = !showLyric.value;
  if (showLyric.value) {
    // v-if 切换后再测量，直接测量会拿到封面节点的尺寸或 0 高度。
    // 必须重置重试预算：竖屏没看歌词时 onMounted 那次测量拿不到 .lyric-line 节点，
    // 会把 4 次重试耗光；这里若不重置就只剩一次机会，失败即退回估算行高 → 歌词不再跟随。
    lyricMeasureRetry = 0;
    lyricCenterRetry = 0;
    lyricMeasureSeq++;
    lyricViewportHeightPx.value = 0;
    lyricPadPx.value = 0;
    lyricLineHeightsPx.value = [];
    lyricLineOpacity.value = [];
    nextTick(() => {
      measureLyricCenter();
      measureLyricLineHeights();
    });
  }
}
function cycleMode(): void {
  // 模式状态、原生循环策略和持久化统一由 Store 维护，页面只负责触发与反馈。
  player.cycleMode();
  qtShowToast({ title: "播放模式：" + player.modeLabel(), icon: "none" });
}
const liked = computed(() => {
  const current = player.current;
  return current != null && player.isLiked(current);
});
function previewCover(): void {
  const current = player.current;
  if (current == null) return;
  const pic = player.coverOf(current);
  if (pic.length == 0) {
    qtShowToast({ title: "暂无封面", icon: "none" });
    return;
  }
  uni.previewImage({
    urls: [pic],
    current: pic,
    indicator: "none",
  });
}
function toggleLike(): void {
  // 不再有内置的「我喜欢的歌曲」，点红心就是挑一个自建歌单收进去
  if (!player.canPickPlaylist()) {
    qtShowToast({ title: "还没有歌单，请先新建", icon: "none" });
    return;
  }
  openPicker(null);
}
function doDownload(): void {
  const current = player.current;
  if (current != null) downloads.download(current);
}
function openArtistPage(): void {
  const current = player.current;
  if (current == null) return;
  // 曲目上没有歌手 id，只能走名字搜索闭环（包内没有 id 时自动退回）
  uni.navigateTo({
    url:
      "/pages/artist/index?name=" +
      encodeURIComponent(current.singer) +
      "&platform=" +
      current.platform,
  });
}
async function showPlayUrl(): Promise<void> {
  const current = player.current;
  if (current == null) return;
  // 本地播放有两类来源，都得按「本地」展示，不能显示音源线路：
  // ① 本地曲目（platform == "local"，见 pushTimeline 的本地分支）；
  // ② 在线歌被本地优先解析链命中（localFirstPathOf 有值）——这时 platform 还是
  //    原平台（kg/qq…），播的却是磁盘文件，线路名会照上一条在线曲目的残留显示。
  const localFirstPath = player.localFirstPathOf(current);
  const local = current.platform == "local" || localFirstPath.length > 0;
  // 地址从 player 的展示副本读（song.url 出于「不带病续播」不会持久化真实地址，
  // 直接读它永远是空、会误报「暂无播放地址」——见 player.resolvedUrlOf）
  const url = player.resolvedUrlOf(current);
  if (url == null || url.length == 0) {
    qtShowToast({ title: local ? "本地文件地址缺失" : "暂无播放地址", icon: "none" });
    return;
  }
  // 管理员调试：这条地址是**音源包里哪条源**取到的（取链命中时随地址一起记，
  // 见 musicApi.playUrlLine）。显示「未知」= 走的是包内缓存命中或旧包（应答没有
  // line 字段），不代表没记录。复制仍然只复制地址本身，方便直接拿去播放器验证。
  const line = local ? "本地歌曲（不走音源取链）" : musicApi.playUrlLine(current, player.effQualityOf(current));
  let content = "音源线路：" + (line.length > 0 ? line : "未知") + "\n\n" + url;
  // 在线歌附带本地优先诊断：开关/账本条数/①身份/②元数据三关/⑤曲库逐段复跑，
  // 「下载了还是在线」当场看报告，不用再来回猜（本地优先关了也能看到关的状态）。
  if (!local) {
    try {
      const diag = await localFirstDiagnose(current);
      if (diag.length > 0) content += "\n\n" + diag;
    } catch (_) {
      // 静默：诊断失败不影响弹窗本身，地址照常展示
    }
    // 会话层补充：为什么这次还是走了在线（已直推 / 已回退 / 开关关了）——
    // 上面的诊断只讲「文件层面能不能用」，讲不到播放器这次实际用了什么
    const note = player.localFirstSessionNote(current);
    if (note.length > 0) content += "\n" + note;
  } else {
    // 本地曲目附内嵌标签诊断：「有歌词、没封面」时一眼看出是文件里本来没图、
    // 还是读取/截断出了问题（见 player.embeddedDiagOf）
    const embeddedDiag = player.embeddedDiagOf(current);
    if (embeddedDiag.length > 0) content += "\n\n" + embeddedDiag;
  }
  qtConfirm({
    title: local ? "本地文件地址" : "当前播放地址",
    content: content,
    confirmText: "复制",
    cancelText: "取消",
  }).then((ok: boolean) => {
    if (ok) {
      uni.setClipboardData({
        data: url,
        success: () => {
          qtShowToast({ title: local ? "已复制文件地址" : "已复制播放地址", icon: "none" });
        },
      });
    }
  });
}
// 跨源兜底候选清单来自数据包注册表（音质切换失败时按序尝试其他源）
const SOURCES = computed<string[]>(() => sourceRegistry.sourceIds());

function modeIconName(): string {
  if (player.mode == "random") return "shuffle";
  if (player.mode == "single") return "repeat-1";
  return "repeat";
}

async function switchQuality(): Promise<void> {
  const current = player.current;
  if (current == null) return;
  // 音质档位来自数据包注册表，并按当前歌曲的平台收敛（v5 契约：包侧声明了
  // 该源可用档位，如 B 站无真无损就不展示 flac；未声明 = 全部档位）
  //（未装包为空 → 提示去设置页安装）
  const qualities = sourceRegistry.sourceQualities(current.platform);
  if (qualities.length == 0) {
    qtShowToast({ title: "请先在 设置→音源包管理 安装数据包", icon: "none" });
    return;
  }
  // 红色选择对齐实际生效档位；未知档位不误选首项，命令索引仍对应 qualities。
  const effQ = player.effQualityOf(current);
  const qActions: SheetAction[] = qualities.map((q) => ({ name: q.name }));
  const qualitySelectedIndex = qualities.findIndex((q) => q.id == effQ);
  openActionSheet("选择音质", qActions, async (_action, index) => {
    const quality = qualities[index].id;
    try {
      // 直接为当前歌曲获取新音质，不修改全局 player.quality
      const newUrl = await musicApi.playUrl(current, quality);
      if (newUrl.length == 0) {
        qtShowToast({ title: "该音质暂不可用", icon: "none" });
        return;
      }
      current.url = newUrl;
      // 落地平台独立播放档位（v12）：这个源以后都用这档，后续取链（懒解析/
      // 预热/地址失效重取）经 player.effQualityOf 自动取到它
      player.setSourceQuality(quality);
      qtShowToast({
        title: "音质已切换为 " + qualities[index].name,
        icon: "none",
      });
      // 重新播放当前歌曲（保持当前播放进度）
      player.play(current, player.queue, true);
      return;
    } catch (_) {
      // 如果当前平台不支持该音质，尝试从其他平台搜索替换
      const others = SOURCES.value.filter((s) => s != current.platform);
      for (let i = 0; i < others.length; i++) {
        const target = others[i];
        try {
          const keyword = current.name + " " + current.singer;
          const results = await musicApi.search(keyword, target as any, "song", 1, 1);
          if (results.length > 0) {
            const picked = results[0];
            // 保留原歌曲元数据，替换为其他平台版本
            current.id = picked.id;
            current.name = picked.name;
            current.singer = picked.singer;
            current.album = picked.album;
            current.picUrl = picked.picUrl;
            current.platform = picked.platform;
            current.url = "";
            current.musicId = picked.musicId;
            if (picked.duration != null) current.duration = picked.duration;
            const newUrl = await musicApi.playUrl(current, quality);
            if (newUrl.length > 0) {
              current.url = newUrl;
              // 换源成功：给**新**平台落独立档位（current.platform 已替换成
              // 换源结果，setSourceQuality 写的就是新平台的表项）
              player.setSourceQuality(quality);
              qtShowToast({ title: "已切换至" + platformShortName() + " " + quality, icon: "none" });
              player.play(current, player.queue, true);
              return;
            }
          }
        } catch (_) {
          // 静默：取链失败落到下方「未找到可替代的歌曲」提示
        }
      }
      qtShowToast({ title: "未找到可替代的歌曲", icon: "none" });
    }
  }, qualitySelectedIndex);
}

function onDiscTap(): void {
  // 封面单击切换歌词/封面；收藏通过底部心形按钮操作，避免快速点击误触发收藏
  toggleLyric();
}
function onTouchStart(event: UniTouchEvent): void {
  const touch = event.touches[0];
  if (touch != null) {
    touchStartX = touch.clientX;
    touchStartY = touch.clientY;
  }
}
function onTouchEnd(event: UniTouchEvent): void {
  const changed = event.changedTouches;
  if (changed == null || changed.length == 0) return;
  const touch = changed[0];
  const dx = touch.clientX - touchStartX;
  const dy = touch.clientY - touchStartY;
  const fromLyricScroll = touchFromLyricScroll;
  touchFromLyricScroll = false;
  const fromProg = touchFromProg;
  touchFromProg = false;
  // 进度条拖动是横向长拖，必须挡在滑切歌判断之前，否则拖到一半会跳下一首
  if (fromProg) return;
  if (Math.abs(dx) < 60 && Math.abs(dy) < 60) return;
  if (Math.abs(dx) > Math.abs(dy)) {
    // 歌词页不切歌：竖屏歌词模式整页禁用左右滑切歌；歌词滚动区（宽屏歌词面板）
    // 的手势起点同样不切歌，避免想滚歌词时误切上一首/下一首。
    // 封面页保留左右滑切歌。
    // （歌词预览区已删：用户 m16808 这个页面的歌词不需要了。）
    if (!layout.isWide && showLyric.value) return;
    if (fromLyricScroll) return;
    if (dx < -60) player.next();
    else if (dx > 60) player.previous();
  } else if (dy > 90) {
    // 歌词滚动区内的竖直拖动是滚动歌词，不触发下滑返回
    if (!fromLyricScroll) back();
  }
}
function seekToLine(line: LyricLine): void {
  // 点行跳转要跳到「这行歌词真正该出现的那一刻」，所以是 line.time + 偏移
  // （与 PC 侧 PlayingPage.tsx:196 `seekTo(ms + lyricOffset.offsetMs)` 同口径）。
  // 注意：这与进度条 seek 的规则相反 —— onProgTouchEnd/seekBy 里绝不能加偏移，
  // 用户拖到的位置就是他要听的位置。一个加一个不加是设计如此，不是笔误。
  player.seek(line.time + lyricOffsetSec());
  // 点击行跳转：隐藏时间戳、清除手动滚动抑制，立即居中到该行并恢复自动跟随
  lyricUserScrollAt = 0;
  hideLyricTimes();
  updateLyricScroll(true);
}
/** 点击歌词行：仅手动滚动期间高亮的目标行跳转播放位置；
    其他行的点击视为「回到封面页」（宽屏歌词面板常驻、无封面页概念，忽略） */
function onLyricLineTap(line: LyricLine, index: number): void {
  if (lyricTimesVisible.value && index == lyricTargetIndex.value) {
    seekToLine(line);
    return;
  }
  if (!layout.isWide) toggleLyric();
}
function copyLyric(line: LyricLine, index: number): void {
  const current = player.current;
  const songName = current != null ? current.name : "";
  const singer = current != null ? current.singer : "";
  const time = format(line.time);
  let text = "[" + time + "] " + line.text;
  if (line.translation != null && line.translation.length > 0) {
    text += "（" + line.translation + "）";
  }
  text += "（《" + songName + "》 - " + singer + "，来自轻听音乐）";
  uni.setClipboardData({
    data: text,
    success: () => {
      qtShowToast({ title: "已复制歌词", icon: "none" });
    },
  });
}
function openMore(): void {
  const current = player.current;
  if (current == null) return;
  const downloaded = downloads.has(current);
  const currentRate = rates[rateIndex.value];
  const actions: SheetAction[] = [
    { name: "下一首播放" },
    { name: liked.value ? "取消收藏" : "收藏" },
    { name: "加入播放队列" },
    { name: downloaded ? "已在下载列表" : "下载到本地", disabled: downloaded },
    { name: "分享" },
    { name: "倍速: " + currentRate + "x" },
    { name: "定时关闭" },
    { name: "查看歌手" },
  ];
  openActionSheet(current.name + " - " + current.singer, actions, (_action, index) => {
    if (index == 0) player.playNext(current);
    else if (index == 1) toggleLike();
    else if (index == 2) player.addToQueue(current);
    else if (index == 3 && !downloaded) downloads.download(current);
    else if (index == 4) shareSong(current);
    else if (index == 5) cycleRate();
    else if (index == 6) openSleep();
    else if (index == 7)
      uni.navigateTo({
        url:
          "/pages/artist/index?name=" +
          encodeURIComponent(current.singer) +
          "&platform=" +
          current.platform,
      });
  });
}
function shareSong(song: Song): void {
  shareCard.open(song);
}
function openQueue(): void {
  const index = player.currentIndex();
  // 挂载前写死初始位置（歌词区同款时机）：scroll-view 首次布局即落在当前行，
  // 窗口也先按这个位置算好，弹层一打开当前行就在可视区内
  if (index >= 0) {
    queueScrollValue.value = index * queueStridePx();
    queueScrollTop.value = Math.round(index * queueStridePx());
  } else {
    queueScrollValue.value = 0;
    queueScrollTop.value = 0;
  }
  rebuildQueueWindow();
  queueOpen.value = true;
  armSheet();
}
function isCurrent(item: Song): boolean {
  const current = player.current;
  return (
    current != null &&
    item.id == current.id &&
    item.platform == current.platform
  );
}
function queueActions(song: Song): void {
  const liked = player.isLiked(song);
  const actions: SheetAction[] = [
    { name: "下一首播放" },
    {
      name: liked ? "取消收藏" : "加入歌单",
      color: liked ? theme.skin.danger : undefined,
    },
    { name: "从队列移除" },
    { name: "查看歌手" },
  ];
  openActionSheet(song.name + " - " + song.singer, actions, (_action, index) => {
    if (index == 0) {
      player.playNext(song);
    } else if (index == 1) {
      pickPlaylistFor(song, null);
    } else if (index == 2) {
      const queue = player.queue;
      for (let i = 0; i < queue.length; i++) {
        if (queue[i].id == song.id && queue[i].platform == song.platform) {
          removeAt(i);
          break;
        }
      }
    } else if (index == 3) {
      uni.navigateTo({
        url:
          "/pages/artist/index?name=" +
          encodeURIComponent(song.singer) +
          "&platform=" +
          song.platform,
      });
    }
  });
}
function playAt(index: number): void {
  if (index >= 0 && index < player.queue.length)
    player.play(player.queue[index]);
}
function removeAt(index: number): void {
  const queue = player.queue;
  if (index < 0 || index >= queue.length) return;
  const current = player.current;
  const isRemovingCurrent =
    current != null &&
    queue[index].id == current.id &&
    queue[index].platform == current.platform;
  const next: Song[] = [];
  for (let i = 0; i < queue.length; i++) {
    if (i != index) next.push(queue[i]);
  }
  player.queue = next;
  if (isRemovingCurrent && next.length > 0) {
    const playIndex = index >= next.length ? next.length - 1 : index;
    player.play(next[playIndex]);
  } else if (next.length == 0) {
    // 队列清空且当前曲已被移除：彻底停播（旧写法只清 UI 状态，音频会继续响）
    player.stop();
  } else {
    // 删的不是当前曲：无损同步原生时间线（不打断播放），自动衔接不再放已删的歌
    player.syncTimeline();
  }
  player.persist();
}

function moveUp(index: number): void {
  const queue = player.queue;
  if (index <= 0 || index >= queue.length) return;
  const next: Song[] = [];
  for (let i = 0; i < queue.length; i++) {
    if (i == index - 1) next.push(queue[index] as Song);
    else if (i == index) next.push(queue[index - 1] as Song);
    else next.push(queue[i] as Song);
  }
  player.queue = next;
  // 无损同步原生时间线，排序变化对自动衔接/媒体键立即生效
  player.syncTimeline();
  player.persist();
}

function moveDown(index: number): void {
  const queue = player.queue;
  if (index < 0 || index >= queue.length - 1) return;
  const next: Song[] = [];
  for (let i = 0; i < queue.length; i++) {
    if (i == index) next.push(queue[index + 1] as Song);
    else if (i == index + 1) next.push(queue[index] as Song);
    else next.push(queue[i] as Song);
  }
  player.queue = next;
  player.syncTimeline();
  player.persist();
}

function clearQueue(): void {
  player.stop();
  queueOpen.value = false;
}

import { parseLrc, parseWordByWordLrc, mergeRomanization, wordProgressAt, activeLyricIndex } from "@/utils/lrc";
import { qtFont, qtFontPx, qtFontDual, useFontScaleStore } from "@/uni_modules/qt-ui/stores/font-scale";

/**
 * 全局字号倍率（设置页「文字大小」小/标准/大）。
 *
 * 歌词字号不能走模板内联的 qtFont*：它们是运行时按「宽窄 + 主/译/罗马音层级」算出来的，
 * 基准值与 0.7 的宽屏折算都写在这些函数里，所以倍率只能在这里乘进去 —— 乘在最后一步
 * （Math.round(base * scale * fontScale.scale)），保证「标准」档与改动前逐位一致。
 */


/**
 * 歌词行构建：有逐字（音源包 wordByWord）就按逐字行渲染（自带时间轴，行文本由词拼出），
 * 否则解析普通 LRC —— 老包/中文歌没有逐字，走的是后者，行为与改动前完全一致。
 * 罗马音最后按时间戳就近合并（±500ms，与译文同口径，见 utils/lrc.mergeRomanization）。
 */
function buildLyricLines(
  wordByWord: string,
  text: string,
  translation: string,
  romanization: string
): LyricLine[] {
  let lines: LyricLine[] = [];
  if (wordByWord.length > 0) {
    lines = parseWordByWordLrc(wordByWord);
    if (lines.length > 0 && translation.length > 0) {
      // 逐字行不自带译文（译文是另一条 LRC）：按时间戳就近补挂，口径与 parseLrc 一致
      const trs = parseLrc(translation, "");
      for (let i = 0; i < lines.length; i++) {
        const line = lines[i]!;
        for (let j = 0; j < trs.length; j++) {
          const tr = trs[j]!;
          if (Math.abs(tr.time - line.time) < 0.05) {
            line.translation = tr.text;
            break;
          }
        }
      }
    }
  }
  // 逐字解析出 0 行（格式意外/源返回空）：退回普通 LRC，不能让歌词整片消失
  if (lines.length == 0) lines = parseLrc(text, translation);
  if (romanization.length > 0) lines = mergeRomanization(lines, romanization);
  return lines;
}

async function loadLyric(): Promise<void> {
  const current = player.current;
  if (current == null) return;
  // 代次：每进一次本函数 +1。watch(embeddedLyric) 强制重载、恢复自动取词、快速切歌
  // 都可能在前一次 await 未回时再进这里 —— 旧请求回来时只要代次对不上就整批作废
  // （词与 loading 复位都不得落地），否则新歌会先亮一拍旧歌的词
  // （封面态歌手下的单行当前歌词把这类竞态直接放大到用户眼前）。
  const generation = ++lyricLoadGeneration;
  lyricLoading.value = true;
  // loadedKey 是播放页自己的「当前已加载哪首歌」标记，格式必须与 ensureLyric() 里一致
  // （同为 id:platform），否则两处算出的 key 永不相等，切歌过期判断会失效。
  // 注意这与 services/music-api.ts 的歌词缓存键格式（platform:id）**故意不同**：
  // 那个键用于查缓存，这个只用于比对「是不是同一首」，两者不需要也无法统一。
  const key = current.id + ":" + current.platform;
  // 在播本地文件自带内嵌歌词（本地曲目 / 下载歌 / 本地优先命中的在线歌）：直接用它，
  // 不再打在线取词 —— 文件里那份与音频是同一份词，最准也最省一次请求。
  // 内嵌词是切歌时同步读好的（syncSongExtras），进页即命中；本地优先是异步补读的，
  // 补到之后由 watch(player.embeddedLyric) 再触发一次本函数。
  const embeddedLrc = player.embeddedLyricOf(current);
  if (embeddedLrc.length > 0) {
    const parsedEmbedded = buildLyricLines("", embeddedLrc, "", "");
    qtDiag("[QT Lyric] " + current.name + "（" + key + "）命中本地文件内嵌词 " + embeddedLrc.length
      + " 字符 → " + parsedEmbedded.length + " 行");
    applyLyricLines(parsedEmbedded.length == 0 ? [{ time: 0, text: "纯音乐，请欣赏" }] : parsedEmbedded);
    lyricLoading.value = false;
    return;
  }
  // 取播放地址时已预热过歌词（musicApi.playUrl → prefetchLyric），命中缓存就**同步落地**：
  // 首次打开播放页直接出词，没有「先空一拍再补上」的断续感，也不再多发一次请求。
  const cached = musicApi.cachedLyric(current);
  if (cached.length > 0) {
    const parsedCached = buildLyricLines(
      musicApi.cachedLyricWordByWord(current),
      cached,
      musicApi.cachedLyricTranslation(current),
      musicApi.cachedLyricRomanization(current)
    );
    qtDiag("[QT Lyric] " + current.name + "（" + key + "）命中预热缓存 " + cached.length
      + " 字符 → " + parsedCached.length + " 行");
    applyLyricLines(parsedCached.length == 0 ? [{ time: 0, text: "纯音乐，请欣赏" }] : parsedCached);
    // 同步分支也必须复位：noLyricYet 靠它区分「还没取到词」与「这首歌没词」，
    // 若留 true，会把「无词」强调色一直挂在常驻的「搜索歌词」入口上
    lyricLoading.value = false;
    return;
  }
  let lines: LyricLine[] | null = null;
  try {
    const text = await musicApi.lyrics(current);
    const translation = await musicApi.lyricTranslation(current);
    // 新字段（音源包 2026-10 起）：老包没有 → 空串 → buildLyricLines 走普通 LRC 路径
    const wordByWord = await musicApi.lyricWordByWord(current);
    const romanization = await musicApi.lyricRomanization(current);
    // 取词期间切了歌 / embedded 补读又触发了一次本函数：本次结果作废
    // （新一次加载会自己落地），否则上一首的歌词会盖到新歌上
    if (lyricRequestIsCurrent(key, generation)) {
      const parsed = buildLyricLines(wordByWord, text, translation, romanization);
      lines = parsed.length == 0 ? [{ time: 0, text: "纯音乐，请欣赏" }] : parsed;
      // 「歌词不跟随进度」全靠这两条日志判定：文本空/解析 0 行 = 数据侧；
      // 文本正常却不跟随 = 行高测量侧（配 measureLyricLineHeights 的失败日志）。
      qtDiag("[QT Lyric] " + current.name + "（" + key + "）文本 " + text.length + " 字符 / 翻译 "
        + translation.length + " 字符 / 逐字 " + wordByWord.length + " 字符 / 罗马音 "
        + romanization.length + " 字符 → " + lines.length + " 行");
    }
  } catch (e) {
    qtDiag("[QT Lyric] 播放页取词异常：" + (e != null ? e.toString() : ""));
    if (lyricRequestIsCurrent(key, generation)) lines = [{ time: 0, text: "暂无歌词" }];
  }
  // 只有仍是最新代次才能复位 loading：老请求带着旧代次回来若复位，
  // 会把新一次取词的 loading 抹掉，封面态歌词行会在「加载中」被提前掐灭
  if (generation == lyricLoadGeneration) lyricLoading.value = false;
  if (lines == null) return;
  applyLyricLines(lines);
}

/** 歌词落地：滚动位置归零，作废上一首的实测行高，并在布局完成后重新测量定位 */
function applyLyricLines(lines: LyricLine[]): void {
  lyricLinesKey.value = loadedKey;
  lyricLines.value = lines;
  // 换歌后上一首的实测行高必须作废：行数/换行不同会让累计偏移整体错位，
  // 滚动目标越界被原生钳位，歌词就停在错误位置不再跟随（重启 App 才恢复）。
  lyricLineHeightsPx.value = [];
  lyricLineOpacity.value = [];
  lyricMeasureSeq++;
  lyricMeasureRetry = 0;
  lyricCenterRetry = 0;
  activeLyric.value = 0;
  lyricUserScrollAt = 0;
  lyricTouchAt = 0;
  lyricScrollPending = false;
  // 换歌后上一首的逐字填充必须归零：残留的词下标/填充比例会让新歌词第一行
  // 立刻带着上一首的填充边界，并且 rAF 还在按旧锚点外推
  resetKaraoke();
  hideLyricTimes();
  setLyricScrollTop(0);
  // 歌词是异步插入的，等待 scroll-view 完成布局后重新测量并定位当前进度。
  nextTick(() => {
    if (lyricVisible.value) {
      measureLyricCenter();
      measureLyricLineHeights();
    }
  });
}

function ensureLyric(): void {
  const current = player.current;
  if (current == null) return;
  const key = current.id + ":" + current.platform;
  if (key == loadedKey) return;
  loadedKey = key;
  // 封面由 <image> 组件渲染（Fresco 框架自动管理回收），切歌时无需手动处理
  loadLyric();
}

/**
 * 宽屏底栏「队列」入口带 ?queue=1 进来时直接展开队列抽屉。
 *
 * 为什么用 query 而不是事件：底栏挂在 qt-page-frame 上，而播放页是 full-width
 * （showPlayerBar 恒为 false），所以点队列时播放页还没挂载，事件必丢。
 * query 由 onLoad 接住，是唯一可靠的时机。
 *
 * 注意 onLoad 的入参是普通对象、不是 UTSJSONObject —— 必须下标取值，
 * 调 option.get(...) 在真机上会抛 `option.get is not a function`（本仓多页已踩过）。
 */
onLoad((option: Record<string, string> | null) => {
  if (option == null) return;
  const flag = option["queue"] as string | undefined;
  if (flag == null || flag != "1") return;
  // 队列抽屉的行高/窗口按实测几何算，等首帧布局完成再开，否则会落在 0 行高
  nextTick(() => {
    openQueue();
  });
});

onUnload(() => {
  pageVisible.value = false;
  stopDiscSpin();
  uni.$off(MusicApi.URL_SIZE_EVENT, onUrlSizeProbed);
  // 码率补算的补拍定时器跨过销毁时点会对着已卸载页写 ref，显式清掉
  stopBitrateSettle();
});

onHide(() => {
  pageVisible.value = false;
  stopDiscSpin();
});

onShow(() => {
  pageVisible.value = true;
  nextTick(() => syncDiscSpin());
  qtTrackPage("pages/player/index");
  // 注册表是氛围底色/音质档位/跨源候选的来源，冷启动直接进播放页时也要拉一次
  sourceRegistry.ensure();
  // 每次进入刷新调试入口可见性（角色缓存在登录/我的页拉取 /me 时更新）
  showPlayUrlEntry.value = isQtAdmin();
  // 每次进入重读工具按钮开关（设置页改完返回要立即生效）。
  // 必须带上名额口径：非管理员的「播放链接」不渲染、不占名额，否则它会把
  // 刚开的第 5 个按钮从白名单里挤掉（表现为「设置了，返回又没了」）。
  playerBar.restore((id: string): boolean => playerBarCountedShared(id, showPlayUrlEntry.value));
  // 设置页也能改倍速，返回时对齐本页显示
  syncRateIndex();
  // 设置页也能开关桌面歌词，返回时对齐本页图标高亮
  lyricOn.value = desktopLyric.isEnabled();
  // 返回播放页时立即从底层播放器同步一次进度，避免进度条停在起点后再跳变
  player.syncProgressNow();
  // 页面隐藏期间（后台播放）拿不到布局，重新进入时再测一次轨道宽度，
  // 否则圆点会按 0 宽度算出 left:0 停在起点，与填充条不一致
  nextTick(() => {
    measureProgTrack();
  });
});

onMounted(() => {
  syncRateIndex();
  // 状态栏高度换算为 rpx（750 设计稿）
  const info = uni.getWindowInfo();
  if (info.statusBarHeight > 0) {
    statusBarRpx.value = Math.round(info.statusBarHeight / qtRpx(1));
  }
  ensureLyric();
  nextTick(() => {
    measureProgTrack();
    // 歌词视图没展示时竖屏没有 .lyric-line 节点（v-if），测了只会白耗重试预算，
    // 导致之后切到歌词视图只剩一次测量机会。宽屏歌词常驻，此门控恒为真、行为不变。
    if (lyricVisible.value) {
      measureLyricCenter();
      measureLyricLineHeights();
    }
  });
  watch(
    () => {
      const c = player.current;
      return c != null ? c.id + ":" + c.platform : "";
    },
    () => {
      // 切歌后偏移编辑上下文要跟着换：否则用户在新歌上点「歌词偏移」，
      // 弹层里改的仍是上一首的覆盖值（setActive 只影响编辑目标，
      // 生效值一直是 offsetSecFor(player.current)，播放本身不会串）
      lyricOffset.setActive(player.current);
      ensureLyric();
    }
  );
  watch(() => player.progress, () => updateLyricScroll(false));
  // 本地优先命中的在线歌：内嵌标签是取链回调里异步补读的（进页那一刻还没有），
  // 补到内嵌词后要把已经挂在屏幕上的在线词换掉。只在「当前曲」的内嵌词到位时重载，
  // key 不匹配（别的歌的）直接忽略，避免无谓重取。
  watch(() => player.embeddedLyric, (text: string) => {
    const c = player.current;
    if (c == null || text.length == 0) return;
    if (player.embeddedLyricOf(c).length == 0) return;
    // ensureLyric 认 loadedKey 会直接短路，这里必须绕过它强制重载（内嵌词比在线词准）
    loadedKey = c.id + ":" + c.platform;
    loadLyric();
  });
  watch(() => layout.windowWidth + ":" + layout.windowHeight, () => {
    // 旋转/分屏后轨道几何与常量兜底都要重算，否则圆点会按旧宽度定位
    progWidth.value = 0;
    refreshProgFallback();
    // 视口尺寸变了，行高与留白全部作废，给一次完整的重试预算
    lyricMeasureRetry = 0;
    lyricCenterRetry = 0;
    lyricMeasureSeq++;
    lyricViewportHeightPx.value = 0;
    lyricPadPx.value = 0;
    lyricLineHeightsPx.value = [];
    lyricLineOpacity.value = [];
    nextTick(() => {
      measureLyricCenter();
      measureLyricLineHeights();
      measureProgTrack();
    });
  });
});

onUnmounted(() => {
  pageAlive = false;
  stopDiscSpin();
  // 逐字填充的 rAF 必须显式取消：虽然回调进场会判 pageAlive 直接返回，但句柄留着会一直
  // 参加下一帧的回调队列，页面已经销毁还在空转（qt-mini-player.uvue:86-91 同款处理）。
  stopKaraokeRaf();
  const mt = lyricMeasureTimer;
  if (mt != null) {
    clearTimeout(mt);
  }
  lyricMeasureTimer = null;
  const ct = lyricCenterTimer;
  if (ct != null) {
    clearTimeout(ct);
  }
  lyricCenterTimer = null;
  if (lyricOpacityTimer != null) clearTimeout(lyricOpacityTimer);
  lyricOpacityTimer = null;
  const pt = progTrackTimer;
  if (pt != null) {
    clearTimeout(pt);
  }
  progTrackTimer = null;
  const lt = lyricTimesTimer;
  if (lt != null) {
    clearTimeout(lt);
  }
  lyricTimesTimer = null;
  // 偏移弹层的轨道测量重试：离开页面后回调里的桥调用会抛 "UTS instance is not registered"
  const ot = offsetTrackTimer;
  if (ot != null) {
    clearTimeout(ot);
  }
  offsetTrackTimer = null;
});
</script>
<style>
.page { flex: 1; min-height: 0; position: relative; flex-direction: column; }
/* 唯一背景层：手机封面与歌词共用随明暗切换的配色，不叠加歌词专用压暗层；宽屏保留媒体背景。 */
.shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.nav { position: absolute; left: 0; top: 0; right: 0; height: 96rpx; padding-left: 24rpx; padding-right: 24rpx; flex-direction: row; align-items: center; z-index: 5; }
/* 宽屏左右内边距必须换 px：24rpx 在 1138dp 上≈36px，按钮会离边缘太远 */
.nav-wide { padding-left: 24px; padding-right: 24px; }
.nav-btn { width: 68rpx; height: 68rpx; align-items: center; justify-content: center; border-radius: 20rpx; }
.nav-btn-wide { width: 40px; height: 40px; border-radius: 12px; }
/* 标题栏：area 必须 stretch，title/artist 才能拿到确定的宽度，text-overflow: ellipsis 才会生效。
   之前 align-items: center 下子节点按内容宽度撑开并居中，长标题整行比可用宽度还宽，
   溢出后被屏幕两端裁掉——既没有省略号，歌名开头也被切掉。 */
.nav-title-area { flex: 1; min-width: 0; margin-left: 20rpx; align-items: stretch; }
.nav-title-row { flex-direction: row; align-items: center; justify-content: center; min-width: 0; }
.nav-title { min-width: 0; flex-shrink: 1; font-size: 31rpx; font-weight: 700; text-overflow: ellipsis; }
/* text-align: center 而不是把 align-items 改回 center：element 仍占满整行宽度
   （这样 text-overflow: ellipsis 才生效），只是文字在行内居中。
   若改用 align-items: center，子节点会退回内容宽度，长文本又会溢出被裁。 */
/* 平台 + 码率行：第二行居中，与「歌名 - 歌手」解耦（歌名再长也压不掉它） */
.nav-meta-row { margin-top: 8rpx; flex-direction: row; align-items: center; justify-content: center; }
.nav-meta-badge { flex-shrink: 0; padding: 3rpx 10rpx; border-radius: 8rpx; font-size: 18rpx; }
.nav-meta-bitrate { margin-left: 10rpx; flex-shrink: 0; font-size: 20rpx; }

.lyric { flex: 1; min-height: 0; }
/* 歌词行：正常播放只显示歌词；手动滚动时目标行覆盖一条高亮提示条（时间在左、播放图标在右） */
.lyric-line { padding: 20rpx 0; align-items: center; justify-content: center; position: relative; }
.lrc { width: 100%; text-align: center; }
.lrc-active { font-weight: 700; }
/* 逐字行：一行 <view> 横向排列若干「词容器」，靠 flex-wrap 换行（不能用 Web-only 的渐变裁字） */
.lrc-karaoke { width: 100%; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: center; }
/* 词容器：宽度恰好等于该词文本的自然宽度，作为填充层的定位基准（width:NN% 就是按它算的）。
   flex-shrink: 0 + 文本 nowrap：词无论在底层还是填充层都必须保持同一宽度，
   一旦被压缩或被折行，两层字形宽度就不等，裁剪边界会歪。 */
.lrc-karaoke-item { position: relative; flex-direction: row; align-items: center; flex-shrink: 0; }
.lrc-karaoke-word { font-weight: 700; flex-shrink: 0; white-space: nowrap; }
/* 填充层：与底层同字同宽的高亮文本，按已唱比例裁掉右侧（Vapor 无 background-clip:text 的等价做法）。
   高度撑满词容器（top/bottom:0），内部文本同样垂直居中，保证与底层文字完全重合。 */
.lrc-karaoke-fill { position: absolute; left: 0; top: 0; bottom: 0; flex-direction: row; align-items: center; overflow: hidden; }
/* 罗马音：与译文同字号同色系，排在主句之下的第二行副文本 */
.lrc-roma { width: 100%; margin-top: 4rpx; text-align: center; }
.lrc-tr { width: 100%; margin-top: 4rpx; text-align: center; }
.lrc-tr-active { }
.lyric-empty { height: 300rpx; align-items: center; justify-content: center; }
.lrc-empty { font-size: 26rpx; }

/* 上下留白由 wideStageStyle 内联给出（矮窗要收紧），这里只管左右 */
.wide-stage { flex: 1; min-height: 0; flex-direction: column; padding-left: 18px; padding-right: 18px; }
.wide-body { flex: 1; min-height: 0; flex-direction: row; align-items: stretch; justify-content: center; }
.wide-left { align-items: center; justify-content: center; flex-shrink: 0; }
.cover-card { padding: 10px; align-items: center; justify-content: center; border-width: 1px; border-style: solid; border-radius: 18px; }
.cover-img { border-radius: 12px; }
.cover-empty { align-items: center; justify-content: center; }
.disc-spin { width: 100%; height: 100%; align-items: center; justify-content: center; }
.wide-right { flex: 1; min-width: 0; height: 100%; margin-left: 18px; padding: 14px; flex-direction: column; border-width: 1px; border-style: solid; border-radius: 16px; overflow: hidden; }
.track-head { flex-direction: row; align-items: flex-start; }
/* 曲名块在封面下方：左对齐卡宽（宽度由模板内联给出），与封面卡之间留 12px */
.track-head-under { margin-top: 12px; }
.track-copy { flex: 1; min-width: 0; }
.track-title { font-size: 18px; line-height: 24px; font-weight: 700; }
.track-artist { margin-top: 5px; font-size: 12px; }
/* 宽屏「平台 + 码率」行：与竖屏 .nav-meta-row 同构，px 口径 */
.track-meta-row { margin-top: 7px; flex-direction: row; align-items: center; }
.track-meta-badge { flex-shrink: 0; padding: 2px 7px; border-radius: 5px; font-size: 10px; }
.track-meta-bitrate { margin-left: 7px; flex-shrink: 0; font-size: 11px; }
.control-tools-wide { flex-direction: row; align-items: center; }
.tool-btn { width: 38px; height: 38px; margin-left: 8px; align-items: center; justify-content: center; border-radius: 10px; }
.queue-preview { flex: 1; min-height: 0; margin-top: 12px; padding: 10px; background-color: rgba(255,255,255,0.05); border-radius: 11px; overflow: hidden; }
.preview-head { flex-direction: row; align-items: center; justify-content: space-between; }
.preview-title { color: rgba(255,255,255,0.82); font-size: 12px; font-weight: 700; }
.preview-count { font-size: 11px; }
.preview-row { height: 32px; flex-direction: row; align-items: center; }
.preview-row-active { background-color: rgba(255,255,255,0.07); border-radius: 7px; }
.preview-index { width: 18px; color: rgba(255,255,255,0.34); font-size: 11px; text-align: center; }
.preview-index-active { color: #f2b8ba; }
.preview-info { flex: 1; min-width: 0; margin-left: 5px; }
.preview-name { color: rgba(255,255,255,0.74); font-size: 11px; text-overflow: ellipsis; }
.preview-name-active { font-weight: 700; }
.preview-meta { margin-top: 1px; color: rgba(255,255,255,0.36); font-size: 11px; text-overflow: ellipsis; }
.preview-empty { height: 70px; align-items: center; justify-content: center; }
.preview-empty-text { color: rgba(255,255,255,0.40); font-size: 11px; }
.preview-more { height: 28px; flex-direction: row; align-items: center; justify-content: center; }
.preview-more-text { margin-right: 3px; color: rgba(255,255,255,0.56); font-size: 11px; }

/* 歌词工具行：竖屏时落在工具图标行上方（播放栏的上面的上面），只在歌词视图出现 */
.lyric-tools-row { height: 60rpx; margin-top: 8rpx; padding: 0 24rpx; flex-direction: row; align-items: center; justify-content: flex-end; }
.lyric-tools-row-wide { height: 34px; margin-top: 6px; padding: 0 8px; }
.lyric-tool { height: 52rpx; padding: 0 22rpx; margin-left: 16rpx; flex-direction: row; align-items: center; border-radius: 26rpx; }
.lyric-tool-wide { height: 32px; padding: 0 12px; margin-left: 8px; border-radius: 16px; }
.lyric-tool-text { margin-left: 8rpx; font-size: 22rpx; }
.lyric-tool-text-wide { margin-left: 4px; font-size: 11px; }

/* Compact footer rhythm: reduce empty row padding, not draggable/button hit areas. */
.progress-row { height: 64rpx; flex-shrink: 0; margin-top: 4rpx; padding: 0 12rpx; flex-direction: row; align-items: center; }
.prog-time { width: 76rpx; font-size: 20rpx; text-align: center; }
/* A thin visible rail within a much larger draggable region. */
.prog-range { position: relative; flex: 1; height: 64rpx; margin: 0; }
.prog-range-wide { height: 32px; margin: 0 6px; }
.prog-track { position: absolute; left: 0; top: 30rpx; right: 0; height: 4rpx; border-radius: 2rpx; }
.prog-fill { position: absolute; left: 0; top: 30rpx; height: 4rpx; border-radius: 2rpx; }
.prog-thumb { position: absolute; top: 24rpx; width: 16rpx; height: 16rpx; border-radius: 8rpx; }
.controls { height: 96rpx; flex-shrink: 0; margin-top: 4rpx; padding: 0 12rpx; flex-direction: row; align-items: center; justify-content: space-between; }
.control-hit { width: 80rpx; height: 88rpx; flex-shrink: 0; align-items: center; justify-content: center; }
.icon-main { width: 96rpx; height: 96rpx; flex-shrink: 0; border-radius: 48rpx; align-items: center; justify-content: center; }
.action-row { height: 88rpx; margin-top: auto; padding: 0 40rpx; flex-direction: row; align-items: center; justify-content: space-between; }
/* 工具键命中区：图标 38rpx（19dp）太小，外套 60rpx（30dp）方块；11 个 × 60 + 左右 40 = 700rpx，在 670rpx 内容宽内正好一排放下 */
.action-hit { width: 60rpx; height: 60rpx; align-items: center; justify-content: center; }

.portrait-stage { flex: 1; min-height: 0; padding: 96rpx 34rpx 28rpx; }
.portrait-cover { width: 460rpx; height: 460rpx; align-self: center; padding: 16rpx; align-items: center; justify-content: center; border-width: 1px; border-style: solid; border-radius: 34rpx; }
.disc-img { width: 428rpx; height: 428rpx; border-radius: 26rpx; }
.disc-img-empty { align-items: center; justify-content: center; }
/* 唱片封面（用户 m15535）：盘面/纹路/中央封面/唱臂的几何全在脚本里算（随长屏缩放），
   这里只留不随尺寸变的布局属性，避免两处各写一份数值又对不上 */
.disc-wrap { align-self: center; flex-shrink: 0; }
.disc-plate { align-items: center; justify-content: center; }
.turntable-layer { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
.turntable-record { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
.disc-spin { width: 100%; height: 100%; align-items: center; justify-content: center; }
/* Text has a nonzero, scaled minimum height; disc geometry reserves it before growing. */
.track-block { flex: 1; flex-shrink: 0; margin-top: 28rpx; margin-bottom: 16rpx; padding: 0 12rpx; justify-content: flex-end; }
.track-row { flex-direction: row; align-items: center; flex-shrink: 0; }
.track-row-artist { margin-top: 8rpx; opacity: 0.8; }
.track-row-lyric { margin-top: 8rpx; }
.track-artist-arrow { width: 24rpx; flex-shrink: 0; flex-direction: row; align-items: center; margin-left: 10rpx; }
.track-badge { margin-left: 12rpx; flex-shrink: 0; padding: 3rpx 0; border-radius: 6rpx; text-align: center; }
.track-like { margin-left: auto; width: 72rpx; height: 72rpx; flex-shrink: 0; align-items: center; justify-content: center; }
/* 进度条下面那一行：已播时间 | 当前实际音质 + 码率 | 总时长 */
.prog-meta-row { height: 40rpx; flex-shrink: 0; padding: 0 12rpx; flex-direction: row; align-items: center; justify-content: space-between; }
.prog-quality { flex: 1; text-align: center; }
/* Secondary functions remain quieter than transport controls; hit areas stay large. */
.bar-row { height: 88rpx; flex-shrink: 0; margin-top: 0rpx; padding: 0 12rpx; flex-direction: row; align-items: center; }
.bar-hit { flex: 1; height: 88rpx; align-items: center; justify-content: center; }
/* 更多弹层：比通用 sheet 矮（一行行开关，最多 8 项） */
.sheet-bar { height: 52%; }
.bar-sheet-row { height: 112rpx; margin: 0 24rpx; padding: 0 12rpx; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-style: solid; }
.bar-sheet-icon { margin-right: 20rpx; }
/* 行尾状态点（用户 m17053）：亮=该工具当前展示在底行，仅状态提示，不再当开关 */
.bar-sheet-dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; margin-left: 12rpx; }
.bar-sheet-texts { flex: 1; min-width: 0; }
.bar-sheet-label { font-size: 27rpx; }
.bar-sheet-hint { margin-top: 4rpx; font-size: 21rpx; }
/* 歌词预览区样式已删（用户 m16808） */
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; justify-content: flex-end; z-index: 999; }
.sheet { height: 70%; border-radius: 32rpx 32rpx 0 0; border-width: 1px; border-style: solid; }
.sheet-handle { width: 72rpx; height: 8rpx; margin-top: 16rpx; margin-bottom: 12rpx; border-radius: 4rpx; align-self: center; }
.sheet-head { height: 96rpx; padding: 0 34rpx; flex-direction: row; align-items: center; }
.sheet-title { font-size: 30rpx; font-weight: 700; }
.sheet-count { margin-left: 14rpx; font-size: 22rpx; }
.sheet-actions { margin-left: auto; flex-direction: row; align-items: center; }
.sheet-act { margin-left: 22rpx; }
.sheet-list { flex: 1; }
/* 偏移弹层：比通用 sheet 矮很多（只有一条滑块 + 一排按钮），宽屏下也收窄成对话框宽度 */
.offset-body { padding: 10rpx 40rpx 40rpx; align-items: center; }
.offset-value { font-size: 46rpx; font-weight: 700; }
/* 轨道自身就是测量对象（offsetTrackWidth/offsetThumbLeft 读它），左右不留内边距，
   这样 boundingClientRect.left 与 offsetFromClientX 的换算基准天然一致 */
.offset-track { position: relative; width: 100%; height: 30rpx; margin-top: 34rpx; }
.offset-rail { position: absolute; left: 0; right: 0; top: 10rpx; height: 10rpx; border-radius: 5rpx; }
/* 圆点尺寸必须与 offsetThumbLeft() 里的 size 一致，改这里要同步改脚本 */
.offset-thumb { position: absolute; top: 0; width: 36rpx; height: 36rpx; border-radius: 18rpx; }
.offset-scale { width: 100%; margin-top: 14rpx; flex-direction: row; align-items: center; justify-content: space-between; }
.offset-scale-text { font-size: 20rpx; }
.offset-steps { margin-top: 30rpx; flex-direction: row; align-items: center; justify-content: center; }
.offset-step { height: 64rpx; margin: 0 10rpx; padding: 0 26rpx; align-items: center; justify-content: center; border-radius: 32rpx; }
.offset-step-text { font-size: 24rpx; }
.offset-note { margin-top: 20rpx; font-size: 21rpx; text-align: center; line-height: 30rpx; }
/* 候选行：左侧歌名/歌手，右侧平台角标 */
.cand-row { height: 112rpx; margin: 0 34rpx 14rpx; padding: 0 24rpx; flex-direction: row; align-items: center; border-radius: 18rpx; }
.cand-info { flex: 1; min-width: 0; overflow: hidden; }
.cand-name { font-size: 27rpx; text-overflow: ellipsis; }
.cand-meta { margin-top: 5rpx; font-size: 21rpx; text-overflow: ellipsis; }
.cand-badge { margin-left: 14rpx; flex-shrink: 0; padding: 4rpx 12rpx; border-radius: 10rpx; font-size: 18rpx; }
.queue-spacer { position: relative; width: 100%; }
.queue-row { position: absolute; left: 0; right: 0; height: 104rpx; padding: 0 34rpx; flex-direction: row; align-items: center; }
.queue-row-active { }
.queue-index { width: 48rpx; font-size: 22rpx; text-align: center; }
.queue-index-active { color: #f2b8ba; }
.queue-info { flex: 1; min-width: 0; margin-left: 16rpx; overflow: hidden; }
.queue-name { font-size: 27rpx; text-overflow: ellipsis; }
.queue-name-active { font-weight: 700; }
.queue-meta { margin-top: 5rpx; font-size: 21rpx; text-overflow: ellipsis; }
.queue-move { margin-left: 12rpx; }

.nav-title-area-wide { align-items: flex-start; margin-left: 14px; }
.lyric-line-wide { padding: 9px 0; }
.lrc-scroll-hint {
  position: absolute; left: 16rpx; right: 16rpx; top: 0; bottom: 0;
  flex-direction: row; align-items: center; justify-content: space-between;
  padding-left: 24rpx; padding-right: 24rpx; border-radius: 16rpx;
}
.lrc-hint-time { font-size: 24rpx; }
.lrc-scroll-hint-wide { left: 8px; right: 8px; padding-left: 12px; padding-right: 12px; border-radius: 8px; }
.lrc-hint-time-wide { font-size: 12px; }
.lrc-wide { font-size: 16px; }
.lrc-karaoke-wide { }
.lrc-karaoke-word-wide { }
.lrc-karaoke-item-wide { }
.lrc-karaoke-fill-wide { }
.lrc-roma-wide { margin-top: 1px; }
.lrc-tr-wide { margin-top: 1px; font-size: 12px; }
.lyric-empty-wide { height: 160px; }
.lrc-empty-wide { font-size: 15px; }
.progress-row-wide { height: 32px; margin: 12px 8px 0; padding: 0 8px; }
.prog-time-wide { width: 46px; font-size: 11px; }
.prog-track-wide { top: 13px; height: 5px; border-radius: 3px; }
.prog-fill-wide { top: 13px; height: 5px; border-radius: 3px; }
.prog-thumb-wide { width: 20px; height: 20px; top: 6px; border-radius: 10px; }
.controls-wide { height: 46px; margin: 8px 8px 0; padding: 0 8px; }
.control-side { width: 36px; height: 36px; align-items: center; justify-content: center; border-radius: 10px; }
/* 横屏两翼等宽（flex:1）+ 中间播放键固定宽度 → 播放键恒在正中 */
.control-wing { flex: 1; flex-direction: row; align-items: center; }
.control-wing-left { justify-content: flex-start; }
.control-wing-right { justify-content: flex-end; }
.control-center-wide { flex-direction: row; align-items: center; }
.center-play { margin: 0 14px; }
.icon-main-wide { width: 42px; height: 42px; border-radius: 21px; }
/* 横屏矮窗（windowHeight < 520，见 wideShort）：三行控件收紧，给封面腾出高度。
   与 -wide 同级（单类选择器），靠书写顺序覆盖，所以必须排在上面那批 -wide 之后。
   数值与 WIDE_SHORT_BOTTOM_ROWS_PX = 116 严格对应：34+2 / 28+6 / 42+4。 */
.lyric-tools-row-short { height: 34px; margin-top: 2px; }
.progress-row-short { height: 36px; margin-top: 6px; }
.controls-short { height: 42px; margin-top: 4px; }
.control-side-short { width: 36px; height: 36px; border-radius: 10px; }
.icon-main-short { width: 38px; height: 38px; border-radius: 19px; }
.tool-btn-short { width: 36px; height: 36px; margin-left: 6px; border-radius: 9px; }
.mask-wide { justify-content: center; align-items: center; }
/* 播放列表在宽屏改成右侧抽屉：贴内容区右缘、整高、左侧直角。
   原来和偏移/搜索弹层一样居中 560px，播放页本身已经是左右双栏，
   居中的第三块浮层把歌词区和封面区同时遮住，看起来像弹了个无关窗口。 */
.mask-queue-wide { justify-content: flex-end; align-items: stretch; }
.sheet-wide { height: 76%; border-radius: 16px; }
.sheet-queue-wide { height: 100%; border-radius: 0; border-width: 0; border-style: solid; border-left-width: 1px; }
.sheet-handle-drawer-wide { display: none; }
.offset-body-wide { padding: 8px 28px 26px; }
.offset-value-wide { font-size: 28px; }
.offset-thumb-wide { width: 22px; height: 22px; border-radius: 11px; }
.cand-row-wide { height: 62px; margin: 0 24px 8px; padding: 0 16px; border-radius: 12px; }
.cand-name-wide { font-size: 15px; }
.cand-meta-wide { margin-top: 3px; font-size: 11px; }
.sheet-handle-wide { width: 56px; height: 5px; margin-top: 10px; margin-bottom: 8px; border-radius: 3px; }
.sheet-head-wide { height: 56px; padding: 0 24px; }
.sheet-title-wide { font-size: 17px; }
.sheet-count-wide { margin-left: 10px; font-size: 12px; }
.queue-row-wide { height: 60px; padding: 0 24px; }
.queue-index-wide { width: 28px; font-size: 12px; }
.queue-info-wide { margin-left: 12px; }
.queue-name-wide { font-size: 15px; }
.queue-meta-wide { margin-top: 3px; font-size: 11px; }
