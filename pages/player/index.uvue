.portrait-stage { flex: 1; min-height: 0; padding: 96rpx 34rpx 34rpx; }
.portrait-cover { width: 460rpx; height: 460rpx; align-self: center; padding: 16rpx; align-items: center; justify-content: center; border-width: 1px; border-radius: 34rpx; }
.disc-img { width: 428rpx; height: 428rpx; border-radius: 26rpx; }
.disc-img-empty { align-items: center; justify-content: center; }
.lyric-preview { flex: 1; min-height: 0; align-items: center; justify-content: center; padding: 16rpx 40rpx 0; }
.lyric-preview-line { margin-top: 24rpx; }
.lyric-preview-text { font-size: 30rpx; text-align: center; }
.lyric-preview-active { font-weight: 600; font-size: 36rpx; }
.lyric-preview-tr { color: rgba(255,255,255,0.28); font-size: 22rpx; text-align: center; margin-top: 4rpx; }
.lyric-preview-tr-active { }
.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; justify-content: flex-end; z-index: 999; }
.sheet { height: 70%; border-radius: 32rpx 32rpx 0 0; border-width: 1px; }
.sheet-handle { width: 72rpx; height: 8rpx; margin-top: 16rpx; margin-bottom: 12rpx; border-radius: 4rpx; align-self: center; }
.sheet-head { height: 96rpx; padding: 0 34rpx; flex-direction: row; align-items: center; }
.sheet-title { font-size: 30rpx; font-weight: 700; }
.sheet-count { margin-left: 14rpx; font-size: 22rpx; }
.sheet-actions { margin-left: auto; flex-direction: row; align-items: center; }
.sheet-act { margin-left: 22rpx; }
.sheet-list { flex: 1; }
.queue-spacer { position: relative; width: 100%; }
.queue-row { position: absolute; left: 0; right: 0; height: 104rpx; padding: 0 34rpx; flex-direction: row; align-items: center; }
.queue-row-active { }
