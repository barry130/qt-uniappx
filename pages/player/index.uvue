/* 进度条下面显示时间与实测码率；来源和音质在歌曲信息标签中切换。 */
.prog-meta-row { flex-shrink: 0; flex-direction: row; align-items: center; justify-content: space-between; }
.prog-quality { flex: 1; text-align: center; }
/* Secondary functions remain quieter than transport controls; hit areas stay large. */
.bar-row { flex-shrink: 0; margin-top: 6px; flex-direction: row; align-items: center; border-top-width: 1px; border-top-style: solid; }
.compact-icon-button { width: 68rpx; height: 68rpx; align-items: center; justify-content: center; }
