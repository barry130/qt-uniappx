// Do not key this only on isWide: compact→compact and wide→wide resizes also change geometry.
watch(() => layout.paneWidth + ":" + layout.windowWidth + ":" + layout.paneHeight + ":" + layout.isWide + ":" + layout.safeBottomPx + ":" + fontScale.scale, () => resetQueueViewport());
watch(queueOpen, () => resetQueueViewport());

function onQueueTouchStart(): void {
  queueOpeningIndex = -1;
  queueTouchSeq++;
  queueScrollSeq++;
}
function onQueueScroll(e: any): void {
  const raw = e.detail != null ? Number(e.detail.scrollTop ?? 0) : 0;
  const st = Math.max(0, isFinite(raw) ? raw : 0);
  const prevFirst = Math.floor(queueScrollValue.value / queueStridePx());
  queueScrollValue.value = st;
