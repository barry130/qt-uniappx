.preview-more { height: 28px; flex-direction: row; align-items: center; justify-content: center; }
.preview-more-text { margin-right: 3px; color: rgba(255,255,255,0.56); font-size: 10px; }

.progress-row { height: 58rpx; margin-top: 14rpx; padding: 0 24rpx; flex-direction: row; align-items: center; }
.prog-time { width: 76rpx; font-size: 18rpx; text-align: center; }
.prog-range { position: relative; flex: 1; height: 30rpx; margin: 0 12rpx; }
.prog-range-wide { height: 22px; margin: 0 6px; }
.prog-track { position: absolute; left: 0; top: 10rpx; right: 0; height: 10rpx; border-radius: 5rpx; }
.prog-fill { position: absolute; left: 0; top: 10rpx; height: 10rpx; border-radius: 5rpx; }
.prog-thumb { position: absolute; top: 0; width: 30rpx; height: 30rpx; border-radius: 15rpx; }
.controls { height: 128rpx; margin-top: 8rpx; padding: 0 30rpx; flex-direction: row; align-items: center; justify-content: space-between; }
