<template>
  <qt-page-frame :full-width="true">
    <view class="page">
      <view class="shade" :style="'background-color:' + playerSurface + ';'"></view>
      <image v-if="mediaBackgroundImage.length > 0" class="shade" :style="'width:' + layout.paneWidth + 'px;height:' + layout.paneHeight + 'px;'" :src="mediaBackgroundImage" mode="scaleToFill" />
      <image v-if="playerBackgroundImage.length > 0" class="shade" :style="'width:' + layout.paneWidth + 'px;height:' + layout.paneHeight + 'px;'" :src="playerBackgroundImage" mode="aspectFill" @error="backgroundFailed = playerBackgroundImage" />
      <view v-if="playerBackgroundImage.length > 0" class="shade" :style="'background-color:' + (theme.dark ? 'rgba(12,18,27,0.85)' : 'rgba(255,255,255,0.86)') + ';'"></view>

      <view class="nav" :class="layout.isWide ? 'nav-wide' : ''" :style="navStyle">
        <!-- 返回键与全站 qt-page-frame 标准返回一致（44/22、主文字色），不随页面沉浸配色缩小变淡。 -->
        <view class="nav-btn" :class="layout.isWide ? 'nav-btn-wide' : 'nav-btn-back'" @click="back"><QtIcon name="chevron-left" :size="layout.isWide ? 22 : 44" :color="playerInk" /></view>
        <!-- 三个主入口在四种风格、横竖屏中保持位置，歌曲信息留在内容区。 -->
        <view class="nav-title-area" :class="layout.isWide ? 'nav-title-area-wide' : ''">
          <scroll-view v-if="tv.enabled" class="player-tv-tools" direction="horizontal" :show-scrollbar="false" :style="'height:' + qtTvTokens().controlPx + 'px;'">
            <view v-if="tvSeekEditing" class="player-tv-tools-row player-tv-seek-editor">
              <QtButton data-qt-tv-id="player-progress-back" label="后退 10 秒" variant="outline" size="sm" @click="adjustTvSeek(-10)" />
              <view class="player-tv-tools-gap"></view>
              <text class="player-tv-seek-value" :style="'color:' + playerInk + ';' + qtFontDual(22, 14)">进度预览 {{ format(displayProgress) }} / {{ format(player.duration) }}</text>
              <view class="player-tv-tools-gap"></view>
              <QtButton data-qt-tv-id="player-progress-forward" label="前进 10 秒" variant="outline" size="sm" @click="adjustTvSeek(10)" />
              <view class="player-tv-tools-gap"></view>
              <QtButton data-qt-tv-id="player-progress-cancel" label="取消" variant="outline" size="sm" @click="cancelTvSeek()" />
              <view class="player-tv-tools-gap"></view>
              <QtButton data-qt-tv-id="player-progress-confirm" label="确定" size="sm" @click="confirmTvSeek" />
            </view>
            <view v-else class="player-tv-tools-row">
              <QtButton data-qt-tv-id="player-cover-switch" :label="tvShowingCover ? '歌词' : '封面'" variant="outline" size="sm" @click="toggleTvCover" />
              <view class="player-tv-tools-gap"></view>
              <QtButton data-qt-tv-id="player-cover-preview" label="预览封面" variant="outline" size="sm" :disabled="player.current == null" @click="previewCover" />
              <view class="player-tv-tools-gap"></view>
              <QtButton data-qt-tv-id="player-progress-seek" label="调整进度" variant="outline" size="sm" :disabled="!tvSeekAvailable" @click="startTvSeek" />
            </view>
          </scroll-view>
        </view>
        <!-- 手机保持点封面/歌词空白互切；电视另有可见入口，不改保存的播放风格。 -->
        <view class="nav-btn" :class="layout.isWide ? 'nav-btn-wide' : ''" @click="styleOpen = true">
          <QtIcon name="sliders" :size="layout.isWide ? 20 : 32" :color="playerMuted" />
          <text class="nav-action-label" :style="'color:' + playerMuted + ';' + qtFontDual(18, 10)">风格</text>
        </view>
        <view v-if="dlnaSupported()" class="nav-btn" :class="layout.isWide ? 'nav-btn-wide' : ''" @click="openDlna">
          <QtIcon name="cast" :size="layout.isWide ? 20 : 32" :color="casting ? theme.skin.accent : playerMuted" />
          <text class="nav-action-label" :style="'color:' + playerMuted + ';' + qtFontDual(18, 10)">{{ casting ? '已连接' : '投屏' }}</text>
        </view>
        <view class="nav-btn" :class="layout.isWide ? 'nav-btn-wide' : ''" @click="shareCurrent">
          <QtIcon name="share" :size="layout.isWide ? 20 : 32" :color="playerMuted" />
          <text class="nav-action-label" :style="'color:' + playerMuted + ';' + qtFontDual(18, 10)">分享</text>
        </view>
      </view>

      <view v-if="layout.isWide" class="wide-stage" :style="wideStageStyle">
        <view class="wide-body">
        <scroll-view class="wide-left" direction="vertical" :show-scrollbar="wideMetrics.leftContentHeightPx > wideMetrics.bodyHeightPx" :style="'width:' + wideArtColumnPx + 'px;'">
          <view class="wide-left-inner" :style="wideLeftContentStyle">
          <view v-if="playingStyle.style == 'classic' && !(tv.enabled && tvCoverShown) && wideArtPx > 0" class="wide-vinyl" :style="wideArtStyle" @longpress="previewCover">
            <view class="disc-spin" ref="discSpinRef" :style="discSpinStyle">
              <view v-for="ring in [0.08, 0.15, 0.22, 0.30]" :key="ring" class="vinyl-groove" :style="vinylRingStyle(ring)"></view>
              <image v-if="art() != ''" class="vinyl-label" :style="wideVinylLabelStyle" :src="art()" mode="aspectFill" @error="onArtError" />
              <QtIcon v-else name="music" :size="48" color="#b6b6b6" />
              <view class="vinyl-spindle"></view>
            </view>
          </view>
          <view v-else-if="(playingStyle.style == 'gallery' || (tv.enabled && tvCoverShown)) && wideArtPx > 0" class="gallery-art" :style="wideArtStyle + coverFadeStyle" @click="previewCover">
            <image v-if="art() != ''" class="gallery-image" :src="art()" mode="aspectFill" @error="onArtError" />
            <QtIcon v-else name="music" :size="60" :color="playerMuted" />
          </view>
          <view class="wide-track-block" :style="'margin-top:' + (!immersiveLyrics && wideArtPx > 0 ? 16 : 0) + 'px;'">
            <QtPlayingTrack :name="name()" :artist="artistText()" :source-label="playbackSourceLabel" :liked="liked" :active="pageVisible" :width-px="wideMetrics.trackWidthPx" :ink="playerInk" :muted="playerMuted" :rail="playerRail" @collect="openPicker" @artist="openArtistPage" @source="openPlaybackSource()" />
          </view>
          </view>
        </scroll-view>

        <view v-if="!tv.enabled || !tvCoverShown" class="wide-right mid" @touchstart="onTouchStart" @touchend="onTouchEnd">
          <scroll-view direction="horizontal" class="lyric-tools-scroll" :style="wideLyricToolsStyle" :show-scrollbar="false">
          <view class="lyric-tools-row-wide" :class="wideShort ? 'lyric-tools-row-short' : ''">
          <QtButton v-if="tv.enabled" data-qt-tv-id="player-lyric-browse" :label="tvLyricBrowsing ? '恢复跟随' : '浏览歌词'" variant="outline" size="sm" :disabled="lyricLoading || noLyricYet" @click="toggleTvLyricBrowsing" />
          <view v-if="tv.enabled" class="player-tv-tools-gap"></view>
          <QtButton v-if="tv.enabled" data-qt-tv-id="player-lyric-copy" label="复制歌词" variant="outline" size="sm" :disabled="lyricLoading || noLyricYet" @click="copyTvLyric" />
          <view class="lyric-tool lyric-tool-wide" @click="openOffset">
            <QtIcon name="sliders" :size="13" :color="currentOffsetMs != 0 ? theme.skin.accent : playerMuted" />
            <text class="lyric-tool-text lyric-tool-text-wide" :style="('color:' + (currentOffsetMs != 0 ? theme.skin.accent : playerMuted) + ';') + qtFontDual(22, 11)">{{ offsetButtonText() }}</text>
          </view>
          <!-- 搜索歌词入口常驻偏移旁边（与 qt-pc LyricSearchButton / PlayingPage.tsx:172-183 同口径）：
               原来的 v-else-if="noLyricYet" 门控只在「取不到词」时放行，而词挂错版本（有词但不对）
               时压根没有入口，只能盯着错词。无词时仍用 accent 强调，保留原来的提示强度。 -->
          <view v-if="lyricPicked" class="lyric-tool lyric-tool-wide" @click="resetLyricPick">
            <QtIcon name="refresh" :size="13" :color="theme.skin.accent" />
            <text class="lyric-tool-text lyric-tool-text-wide" :style="('color:' + theme.skin.accent + ';') + qtFontDual(22, 11)">恢复自动</text>
          </view>
          <view class="lyric-tool lyric-tool-wide" @click="openLyricSearch">
            <QtIcon name="search" :size="13" :color="noLyricYet ? theme.skin.accent : playerMuted" />
            <text class="lyric-tool-text lyric-tool-text-wide" :style="('color:' + (noLyricYet ? theme.skin.accent : playerMuted) + ';') + qtFontDual(22, 11)">搜索歌词</text>
          </view>
          <!-- 桌面歌词：参考网易云/QQ 音乐 Pad 播放页把「桌面歌词」放在歌词工具组里。
               之前只有「设置 - 桌面歌词」一个入口，平板上翻两层才找得到，属于 Parity 缺口。 -->
          <view class="lyric-tool lyric-tool-wide" @click="toggleDesktopLyric">
            <QtIcon name="type" :size="13" :color="lyricOn ? theme.skin.accent : playerMuted" />
            <text class="lyric-tool-text lyric-tool-text-wide" :style="('color:' + (lyricOn ? theme.skin.accent : playerMuted) + ';') + qtFontDual(22, 11)">桌面歌词</text>
          </view>
          <!-- 字号：与偏移/搜索歌词同一行工具组。按钮文案直接带当前档位（100%），
               不额外弹提示就能看出「我现在是放大还是默认」，非默认档用 accent 着色。 -->
          <view class="lyric-tool lyric-tool-wide" @click="openLyricSize">
            <QtIcon name="edit" :size="13" :color="lyricSize.isCustom() ? theme.skin.accent : playerMuted" />
            <text class="lyric-tool-text lyric-tool-text-wide" :style="('color:' + (lyricSize.isCustom() ? theme.skin.accent : playerMuted) + ';') + qtFontDual(22, 11)">字号 {{ lyricSizeText() }}</text>
          </view>
          </view>
          </scroll-view>
          <QtFocusLyrics v-if="immersiveLyrics" :lines="lyricLines" :active-index="activeLyric" :position="displayProgress - lyricOffsetSec()" :rhythm="playingStyle.style == 'rhythm'" :align-start="playingStyle.style != 'rhythm'" :ink="playerInk" :muted="playerMuted" :size-scale="lyricSize.scale" :height-px="wideFocusHeight" :loading="lyricLoading" @copy="copyLyric" />
          <scroll-view v-if="!immersiveLyrics" class="lyric lyric-viewport" direction="vertical" :scroll-top="lyricScrollTop" :scroll-with-animation="lyricScrollAnimated && !qtPerformance.reduceMotion" :show-scrollbar="false" @scroll="onLyricUserScroll" @touchstart="onLyricScrollTouchStart">
            <view :style="'height:' + lyricPadStyle"></view>
            <view v-for="(line, index) in lyricLines" :key="index" class="lyric-line lyric-line-wide" :data-qt-tv-id="tv.enabled ? 'player-lyric:' + lyricLinesKey + ':' + index : ''" :class="galleryLyrics ? 'lyric-line-gallery lyric-line-gallery-wide' : ''" :style="lineOpacityStyle(index)" @click.stop="onLyricLineTap(line, index)" @longpress.stop="copyLyric(line, index)">
              <!-- 逐行歌词顺序：词 / 罗马音 / 译文 / 滚动提示条。罗马音更贴近主行（与 PC PlayingPage.tsx:381 同口径） -->
              <view v-if="isKaraokeLine(line, index)" class="lrc-karaoke lrc-karaoke-wide" :class="galleryLyrics ? 'lrc-karaoke-start' : ''">
                <view v-for="(word, wi) in line.words" :key="wi" class="lrc-karaoke-item lrc-karaoke-item-wide">
                  <text class="lrc-karaoke-word lrc-karaoke-word-wide" :style="karaokeWordStyle(wi)">{{ karaokeText(word.text) }}</text>
                  <view v-if="wi == karaokeWordIndex" class="lrc-karaoke-fill lrc-karaoke-fill-wide" :style="karaokeFillStyle()">
                    <text class="lrc-karaoke-word lrc-karaoke-word-wide" :style="karaokeLitStyle()">{{ karaokeText(word.text) }}</text>
                  </view>
                </view>
              </view>
              <text v-else class="lrc lrc-wide" :style="lrcStyle(index)" :class="index == activeLyric ? 'lrc-active' : ''" >{{ line.text }}</text>
              <text v-if="hasRoma(line)" class="lrc-roma lrc-roma-wide" :style="lrcRomaStyle(index)">{{ line.romanization }}</text>
              <text v-if="hasTr(line)" class="lrc-tr lrc-tr-wide" :style="lrcTrStyle(index)" :class="index == activeLyric ? 'lrc-tr-active' : ''" >{{ line.translation }}</text>
              <view v-if="lyricSeekable && lyricTimesVisible && index == lyricTargetIndex" class="lrc-scroll-hint lrc-scroll-hint-wide" :style="'background-color:' + playerRail + ';'">
                <text class="lrc-hint-time lrc-hint-time-wide" :style="('color:' + playerInk + ';') + qtFontDual(24, 12)">{{ format(line.time) }}</text>
                <QtIcon name="play" :size="14" :color="playerInk" />
              </view>
            </view>
            <view v-if="lyricLines.length == 0" class="lyric-empty lyric-empty-wide"><text class="lrc-empty lrc-empty-wide" :style="'color:' + playerMuted + ';' + qtFontDual(26, 15)">{{ lyricLoading ? '正在加载歌词' : '纯音乐，请欣赏' }}</text></view>
            <view :style="'height:' + lyricPadStyle"></view>
          </scroll-view>
        </view>
        </view>

        <view class="wide-footer" :style="'background-color:' + playerFooter + ';border-top-color:' + playerRail + ';'">
        <view class="progress-row-wide" :class="wideShort ? 'progress-row-short' : ''" :style="wideProgressStyle">
          <text class="prog-time prog-time-wide" :style="'color:' + playerMuted + ';' + qtFontDual(20, 11)">{{ format(displayProgress) }}</text>
          <view class="prog-range" :class="layout.isWide ? 'prog-range-wide' : ''" @touchstart="onProgTouchStart" @touchmove="onProgTouchMove" @touchend="onProgTouchEnd" @touchcancel="onProgTouchCancel">
            <view class="prog-track prog-track-wide" :style="'background-color:' + playerRail + ';'"></view>
            <view class="prog-fill prog-fill-wide" :style="'width:' + progPct() + '%;background-color:' + playerAccent + ';'"></view>
            <view class="prog-thumb prog-thumb-wide" :style="'left:' + progThumbLeft() + 'px;background-color:' + playerAccent + ';'"></view>
          </view>
          <text class="prog-time prog-time-wide" :style="'color:' + playerMuted + ';' + qtFontDual(20, 11)">{{ format(player.duration) }}</text>
        </view>

          <!-- Five main controls stay centered; configured tools wrap into another row when needed. -->
          <view class="controls-wide" :class="[wideShort ? 'controls-short' : '', wideControlsStacked ? 'controls-stacked' : '']" :style="wideControlsStyle">
            <view class="control-wing control-wing-left" :class="wideControlsStacked ? 'control-wing-left-stacked' : ''" :style="wideTransportStyle">
              <image v-if="!wideControlsStacked && art() != ''" class="footer-cover" :src="art()" mode="aspectFill" />
              <view v-if="!wideControlsStacked" class="footer-copy">
                <text :style="'color:' + playerInk + ';' + qtFontPx(13)" :max-lines="1">{{ name() }}</text>
                <text :style="'color:' + playerMuted + ';' + qtFontPx(11)" :max-lines="1">{{ artistText() }}</text>
              </view>
            </view>
            <view class="control-center-wide" :style="wideTransportStyle + 'width:' + wideMetrics.transportWidthPx + 'px;'">
              <view class="control-side" @click="cycleMode"><QtIcon :name="modeIconName()" :size="22" :color="playerMuted" /></view>
              <view class="control-side" :class="wideShort ? 'control-side-short' : ''" :style="'margin-left:' + wideMetrics.controlGapPx + 'px;'" @click="player.previous()"><QtIcon name="skip-back" :size="24" :color="playerMuted" /></view>
              <view class="icon-main icon-main-wide" :class="wideShort ? 'icon-main-short' : ''" :style="'margin-left:' + wideMetrics.controlGapPx + 'px;width:' + wideMetrics.mainSizePx + 'px;height:' + wideMetrics.mainSizePx + 'px;background-color:' + playerControl + ';'" @click="player.toggle()"><QtIcon :name="player.playing ? 'pause' : 'play'" :size="26" :color="playerControlInk" /></view>
              <view class="control-side" :class="wideShort ? 'control-side-short' : ''" :style="'margin-left:' + wideMetrics.controlGapPx + 'px;'" @click="player.next()"><QtIcon name="skip-forward" :size="24" :color="playerMuted" /></view>
              <view class="control-side" :style="'margin-left:' + wideMetrics.controlGapPx + 'px;'" @click="openQueue"><QtIcon name="list" :size="22" :color="playerMuted" /></view>
            </view>
            <view class="control-wing control-wing-right" :class="wideControlsStacked ? 'control-wing-right-stacked' : ''" :style="wideToolsWingStyle">
              <view class="control-tools-wide">
                <view v-for="(tool, index) in barTools" :key="tool.id" class="tool-btn" :class="wideShort ? 'tool-btn-short' : ''" :style="'margin-left:' + (index == 0 ? 0 : wideMetrics.toolGapPx) + 'px;'" @click="onBarTool(tool.id)"><QtIcon :name="tool.icon" :size="18" :color="barIconColor(tool.id)" /></view>
                <view class="tool-btn" :class="wideShort ? 'tool-btn-short' : ''" :style="'margin-left:' + (barTools.length > 0 ? wideMetrics.toolGapPx : 0) + 'px;'" @click="openBarSheet"><QtIcon name="more" :size="18" :color="playerMuted" /></view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view v-else class="portrait-stage mid" :style="portraitStageStyle" @touchstart="onTouchStart" @touchend="onTouchEnd">
        <view class="portrait-content">
        <scroll-view v-if="!showLyric && !immersiveLyrics" class="portrait-cover-scroll" direction="vertical" :show-scrollbar="false">
        <!-- 参考唱机：底座/转轮/传动带与银白唱臂静止，只有圆盘和实际封面转动。
             材质为透明 PNG；全部部件落在同一预算画布内，无原生阴影命中区。 -->
        <view v-if="playingStyle.style == 'classic' && !(tv.enabled && tvCoverShown) && !showLyric && portraitCoverSizeRpx > 0" class="disc-wrap" :style="portraitDiscWrapStyle">
          <image class="turntable-layer" :style="portraitTurntableStyles.canvasSize" src="/uni_modules/qt-ui/static/player-turntable/deck.png" mode="aspectFit" />
          <view class="disc-plate" :style="portraitDiscPlateStyle" @click="onDiscTap" @longpress="previewCover">
            <view class="disc-spin" ref="discSpinRef" :style="portraitTurntableStyles.recordSize + discSpinStyle">
              <image class="turntable-record" :style="portraitTurntableStyles.recordSize" src="/uni_modules/qt-ui/static/player-turntable/record.png" mode="aspectFit" />
              <image v-if="art() != ''" class="disc-img-round" :style="portraitDiscImgStyle" :src="art()" mode="aspectFill" @error="onArtError" />
              <view v-else class="disc-img-round disc-img-empty" :style="portraitDiscImgStyle + 'background-color:' + theme.skin.coverPlaceholder + ';'"><QtIcon name="music" :size="Math.floor(portraitTurntable.coverRpx * 0.25)" :color="playerMuted" /></view>
            </view>
          </view>
          <image class="turntable-layer" :style="portraitTurntableStyles.canvasSize" src="/uni_modules/qt-ui/static/player-turntable/arm.png" mode="aspectFit" />
        </view>

        <view v-if="(playingStyle.style == 'gallery' || (tv.enabled && tvCoverShown)) && !showLyric && portraitCoverSizeRpx > 0" class="gallery-art portrait-gallery" :style="portraitGalleryStyle" @click="toggleLyric" @longpress="previewCover">
          <image v-if="art() != ''" class="gallery-image" :src="art()" mode="aspectFill" @error="onArtError" />
          <QtIcon v-else name="music" :size="72" :color="playerMuted" />
        </view>
        <!-- 双行歌名、歌手与实际来源共用组件，切风格不影响收藏和来源入口。 -->
        <view v-if="!showLyric && !immersiveLyrics" class="track-block" :style="portraitTrackStyle">
          <QtPlayingTrack :name="name()" :artist="artistText()" :source-label="playbackSourceLabel" :liked="liked" :active="pageVisible" :width-px="portraitMetrics.trackWidthPx" :ink="playerInk" :muted="playerMuted" :rail="playerRail" @collect="openPicker" @artist="openArtistPage" @source="openPlaybackSource()" />
          <!-- 当前歌词复用已有时间轴；保留单行高度，切歌/空歌词不改变底部布局。 -->
          <view class="track-row track-row-lyric" :style="portraitLyricRowStyle" @click.stop="toggleLyric">
            <QtMarquee :text="portraitCurrentLyric" :size-rpx="26" :size-px="14" :weight="400" :color="playerMuted" :width-px="portraitLyricWidthPx" :active="pageVisible" />
          </view>
        </view>
        </scroll-view>
        <scroll-view v-if="immersiveLyrics || showLyric" class="compact-focus-heading" direction="vertical" :show-scrollbar="false" :style="'height:' + portraitMetrics.headingHeightPx + 'px;'">
          <QtPlayingTrack :compact="true" :cover="art()" :name="name()" :artist="artistText()" :source-label="playbackSourceLabelFull" :liked="liked" :active="pageVisible" :width-px="portraitMetrics.trackWidthPx" :ink="playerInk" :muted="playerMuted" :rail="playerRail" @collect="openPicker" @artist="openArtistPage" @source="openPlaybackSource()" @cover-error="onArtError" />
        </scroll-view>
        <QtFocusLyrics v-if="immersiveLyrics" :lines="lyricLines" :active-index="activeLyric" :position="displayProgress - lyricOffsetSec()" :rhythm="playingStyle.style == 'rhythm'" :align-start="playingStyle.style != 'rhythm'" :ink="playerInk" :muted="playerMuted" :size-scale="lyricSize.scale" :height-px="compactFocusHeight" :loading="lyricLoading" @copy="copyLyric" />

        <scroll-view v-if="showLyric && !immersiveLyrics" class="lyric lyric-viewport" :style="portraitLyricStyle" direction="vertical" :scroll-top="lyricScrollTop" :scroll-with-animation="lyricScrollAnimated && !qtPerformance.reduceMotion" :show-scrollbar="false" @click="onLyricBackgroundTap" @scroll="onLyricUserScroll" @touchstart="onLyricScrollTouchStart">
          <view :style="'height:' + lyricPadStyle"></view>
          <view v-for="(line, index) in lyricLines" :key="index" class="lyric-line" :data-qt-tv-id="tv.enabled ? 'player-lyric:' + lyricLinesKey + ':' + index : ''" :class="galleryLyrics ? 'lyric-line-gallery' : ''" :style="lineOpacityStyle(index)" @click.stop="onLyricLineTap(line, index)" @longpress.stop="copyLyric(line, index)">
            <!-- 同上顺序：词 / 罗马音 / 译文 / 滚动提示条 -->
            <view v-if="isKaraokeLine(line, index)" class="lrc-karaoke" :class="galleryLyrics ? 'lrc-karaoke-start' : ''">
              <view v-for="(word, wi) in line.words" :key="wi" class="lrc-karaoke-item">
                <text class="lrc-karaoke-word" :style="karaokeWordStyle(wi)">{{ karaokeText(word.text) }}</text>
                <view v-if="wi == karaokeWordIndex" class="lrc-karaoke-fill" :style="karaokeFillStyle()">
                  <text class="lrc-karaoke-word" :style="karaokeLitStyle()">{{ karaokeText(word.text) }}</text>
                </view>
              </view>
            </view>
            <text v-else class="lrc" :style="lrcStyle(index)" :class="index == activeLyric ? 'lrc-active' : ''" >{{ line.text }}</text>
            <text v-if="hasRoma(line)" class="lrc-roma" :style="lrcRomaStyle(index)">{{ line.romanization }}</text>
            <text v-if="hasTr(line)" class="lrc-tr" :style="lrcTrStyle(index)" :class="index == activeLyric ? 'lrc-tr-active' : ''" >{{ line.translation }}</text>
            <view v-if="lyricSeekable && lyricTimesVisible && index == lyricTargetIndex" class="lrc-scroll-hint" :style="'background-color:' + playerRail + ';'">
              <text class="lrc-hint-time" :style="('color:' + playerInk + ';') + qtFontDual(24, 14)">{{ format(line.time) }}</text>
              <QtIcon name="play" :size="18" :color="playerInk" />
            </view>
          </view>
          <view v-if="lyricLines.length == 0" class="lyric-empty"><text class="lrc-empty" :style="('color:' + playerMuted + ';') + qtFontDual(26, 14)">{{ lyricLoading ? '正在加载歌词' : '纯音乐，请欣赏' }}</text></view>
          <view :style="'height:' + lyricPadStyle"></view>
        </scroll-view>
        </view>

        <!-- 封面态在歌手下显示单行当前歌词；点唱片或该行进入完整歌词视图。 -->

        <!-- 歌词工具行：切到歌词视图才出现，位于工具图标行上方（原来常驻右上角太挤，
             放到进度条正上方又太贴近播放栏，所以再往上提一行） -->
        <scroll-view v-if="showLyric || immersiveLyrics" class="lyric-tools-scroll" direction="horizontal" :show-scrollbar="false" :style="compactLyricToolsStyle">
        <view class="lyric-tools-row" :style="compactLyricToolsStyle">
          <QtButton v-if="tv.enabled" data-qt-tv-id="player-lyric-browse" :label="tvLyricBrowsing ? '恢复跟随' : '浏览歌词'" variant="outline" size="sm" :disabled="lyricLoading || noLyricYet" @click="toggleTvLyricBrowsing" />
          <view v-if="tv.enabled" class="player-tv-tools-gap"></view>
          <QtButton v-if="tv.enabled" data-qt-tv-id="player-lyric-copy" label="复制歌词" variant="outline" size="sm" :disabled="lyricLoading || noLyricYet" @click="copyTvLyric" />
          <view class="lyric-tool" :class="layout.isWide ? 'lyric-tool-wide' : ''" @click="openOffset">
            <QtIcon name="sliders" :size="layout.isWide ? 13 : 24" :color="currentOffsetMs != 0 ? theme.skin.accent : playerMuted" />
            <text class="lyric-tool-text" :class="layout.isWide ? 'lyric-tool-text-wide' : ''" :style="('color:' + (currentOffsetMs != 0 ? theme.skin.accent : playerMuted) + ';') + qtFontDual(22, 11)">{{ offsetButtonText() }}</text>
          </view>
          <view v-if="lyricPicked" class="lyric-tool" :class="layout.isWide ? 'lyric-tool-wide' : ''" @click="resetLyricPick">
            <QtIcon name="refresh" :size="layout.isWide ? 13 : 24" :color="theme.skin.accent" />
            <text class="lyric-tool-text" :class="layout.isWide ? 'lyric-tool-text-wide' : ''" :style="('color:' + theme.skin.accent + ';') + qtFontDual(22, 11)">恢复自动</text>
          </view>
          <!-- 同上（宽屏那处）：搜索歌词常驻偏移旁边，不再只在无词时出现 -->
          <view class="lyric-tool" :class="layout.isWide ? 'lyric-tool-wide' : ''" @click="openLyricSearch">
            <QtIcon name="search" :size="layout.isWide ? 13 : 24" :color="noLyricYet ? theme.skin.accent : playerMuted" />
            <text class="lyric-tool-text" :class="layout.isWide ? 'lyric-tool-text-wide' : ''" :style="('color:' + (noLyricYet ? theme.skin.accent : playerMuted) + ';') + qtFontDual(22, 11)">搜索歌词</text>
          </view>
          <!-- 字号（与宽屏那处同款）：竖屏歌词行更挤，用户最需要的就是这一档 -->
          <view class="lyric-tool" :class="layout.isWide ? 'lyric-tool-wide' : ''" @click="openLyricSize">
            <QtIcon name="edit" :size="layout.isWide ? 13 : 24" :color="lyricSize.isCustom() ? theme.skin.accent : playerMuted" />
            <text class="lyric-tool-text" :class="layout.isWide ? 'lyric-tool-text-wide' : ''" :style="('color:' + (lyricSize.isCustom() ? theme.skin.accent : playerMuted) + ';') + qtFontDual(22, 11)">字号 {{ lyricSizeText() }}</text>
          </view>
        </view>
        </scroll-view>

        <!-- 进度条（用户 m15536）：条本身保持原样，下面一行换成「已播 | 当前实际音质 + 码率 | 总时长」，
             原来固定的「极高音质」文案去掉（那不是实际请求的音质）。 -->
        <view class="progress-row" :style="'height:' + portraitMetrics.progressRowPx + 'px;'">
          <view class="prog-range" :style="'height:' + portraitMetrics.progressRowPx + 'px;'" @touchstart="onProgTouchStart" @touchmove="onProgTouchMove" @touchend="onProgTouchEnd" @touchcancel="onProgTouchCancel">
            <view class="prog-track" :style="'background-color:' + playerRail + ';'"></view>
            <view class="prog-fill" :style="'width:' + progPct() + '%;background-color:' + playerAccent + ';'"></view>
            <view class="prog-thumb" :style="'left:' + progThumbLeft() + 'px;background-color:' + playerAccent + ';'"></view>
          </view>
        </view>

        <view class="prog-meta-row" :style="'height:' + portraitMetrics.metaRowPx + 'px;'">
          <text class="prog-time" :style="('color:' + playerMuted + ';') + qtFontDual(20, 12)">{{ format(displayProgress) }}</text>
          <text class="prog-quality" :style="('color:' + playerMuted + ';') + qtFontDual(20, 12)">{{ bitrateKbps > 0 ? bitrateKbps + ' kbps' : '' }}</text>
          <text class="prog-time" :style="('color:' + playerMuted + ';') + qtFontDual(20, 12)">{{ format(player.duration) }}</text>
        </view>

        <view class="controls" :style="'height:' + portraitMetrics.controlsRowPx + 'px;'">
          <view class="control-hit" @click="cycleMode"><QtIcon :name="modeIconName()" :size="36" :color="playerMuted" /></view>
          <view class="control-hit" @click="player.previous()"><QtIcon name="skip-back" :size="44" :color="playerMuted" /></view>
          <view class="icon-main" :style="'background-color:' + playerControl + ';width:' + portraitMetrics.mainWidthPx + 'px;height:' + portraitMetrics.mainSizePx + 'px;border-radius:' + (playingStyle.style == 'classic' ? 18 : 24) + 'px;'" @click="player.toggle()"><QtIcon :name="player.playing ? 'pause' : 'play'" :size="56" :color="playerControlInk" /></view>
          <view class="control-hit" @click="player.next()"><QtIcon name="skip-forward" :size="44" :color="playerMuted" /></view>
          <view class="control-hit" @click="openQueue"><QtIcon name="list" :size="36" :color="playerMuted" /></view>
        </view>

        <!-- 最下面一行（用户 m17053）：展示项 + 三个点**等分整行宽度**（原来是左挤一堆、
             靠 spacer 顶到右边，用户嫌难看）。每一项 flex:1，四舍五入等宽。 -->
        <view class="bar-row" :style="'height:' + portraitMetrics.toolRowPx + 'px;border-top-color:' + playerRail + ';'">
          <view v-for="tool in barTools" :key="tool.id" class="bar-hit" @click="onBarTool(tool.id)">
            <QtIcon :name="tool.icon" :size="34" :color="barIconColor(tool.id)" />
            <text class="bar-label" :style="'color:' + playerMuted + ';' + qtFontDual(18, 10)" :max-lines="1">{{ tool.label }}</text>
          </view>
          <view class="bar-hit bar-more" @click="openBarSheet"><QtIcon name="more" :size="34" :color="playerMuted" /><text class="bar-label" :style="'color:' + playerMuted + ';' + qtFontDual(18, 10)">更多</text></view>
        </view>
      </view>

      <!-- 「三个点」弹层（用户 m17053 语义修正）：不再当「显隐开关」用，而是
           **功能直达菜单** —— 所有工具（含未展示在底行的）都能在这里直接触发；
           底行展示哪些仍由 设置·播放页展示设置 管。行尾状态点=该工具当前是否展示在底行。 -->
      <QtSheet v-model:visible="barSheetOpen" title="更多功能" :subtitle="'底行展示 ' + barTools.length + '/' + PLAYER_BAR_MAX_VISIBLE + '，可在设置里改'">
          <scroll-view direction="vertical" :show-scrollbar="false" :style="'height:' + Math.floor(layout.paneHeight * 0.55) + 'px;'">
            <view v-for="tool in barSheetTools" :key="tool.id" class="bar-sheet-row" :style="'border-bottom-color:' + theme.skin.divider + ';'" @click="onBarSheetTool(tool.id)">
              <QtIcon class="bar-sheet-icon" :name="tool.icon" :size="30" :color="barIconColor(tool.id) == playerMuted ? theme.skin.iconMuted : barIconColor(tool.id)" />
              <view class="bar-sheet-texts">
                <text class="bar-sheet-label" :style="('color:' + theme.skin.text + ';') + qtFontDual(27, 15)">{{ tool.label }}</text>
                <text class="bar-sheet-hint" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(21, 12)">{{ tool.hint }}</text>
              </view>
              <view v-if="playerBar.isVisible(tool.id)" class="bar-sheet-dot" :style="'background-color:' + theme.skin.accent + ';'"></view>
            </view>
          </scroll-view>
      </QtSheet>

      <!-- 升降调弹层（底行工具 pitch）：与播放设置页共用 qt-pitch-controls，服务回执与能力门控同口径 -->
      <QtPitchControls :visible="pitchSheetVisible" :value="sheetPitch" :supported="pitchSupported" @update:visible="pitchSheetVisible = $event" @change="changePitch" />

      <view v-if="queueOpen" class="mask qt-tv-skip" :style="qtFixedPaneStyle() + 'background-color:' + theme.skin.scrim + ';'" :class="layout.isWide ? 'mask-wide mask-queue-wide' : ''" @click="queueOpen = false">
        <view ref="tvQueuePanel" class="sheet qt-tv-skip" :style="sheetSlideStyle + 'background-color:' + theme.skin.sheetSurface + ';border-color:' + theme.skin.border + ';' + queueDrawerWideStyle" :class="layout.isWide ? 'sheet-wide sheet-queue-wide' : ''" @click.stop>
          <view class="sheet-handle" :style="'background-color:' + theme.skin.surfaceMuted + ';'" :class="layout.isWide ? 'sheet-handle-wide sheet-handle-drawer-wide' : ''"></view>
          <view class="sheet-head" :class="layout.isWide ? 'sheet-head-wide' : ''">
            <text class="sheet-title" :style="('color:' + theme.skin.text + ';') + qtFontDual(30, 17)" :class="layout.isWide ? 'sheet-title-wide' : ''">播放列表</text>
            <text class="sheet-count" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 12)" :class="layout.isWide ? 'sheet-count-wide' : ''">{{ player.queue.length }} 首</text>
            <view class="sheet-actions">
              <QtIcon class="sheet-act" name="trash" :size="layout.isWide ? 18 : 34" :color="theme.skin.textMuted" @click="clearQueue" />
              <QtIcon class="sheet-act" name="close" :size="layout.isWide ? 18 : 34" :color="theme.skin.textMuted" @click="queueOpen = false" />
            </view>
          </view>
          <scroll-view class="sheet-list queue-list-viewport" direction="vertical" :show-scrollbar="false" :scroll-top="queueScrollTop" :scroll-with-animation="false" @scroll="onQueueScroll" @touchstart="onQueueTouchStart">
            <view class="queue-spacer" :style="'height:' + queueContentHeight + 'px;'">
              <view
                v-for="row in queueWindow"
                :key="row.key"
                class="queue-row"
                :data-qt-tv-id="'player-queue:' + row.key"
                :style="queueRowStyle + (isCurrent(row.song) && isCurrentQueueRow(row) ? 'top:' + row.top + 'px;background-color:' + theme.skin.mediaControl + ';' : 'top:' + row.top + 'px;')"
                :class="[isCurrentQueueRow(row) ? 'queue-row-active' : '', layout.isWide ? 'queue-row-wide' : '']"
                @click="queueRowAction(row, 'play')"
                @longpress="queueActions(row)"
              >
                <text class="queue-index" :style="('color:' + (isCurrentQueueRow(row) ? theme.skin.danger : theme.skin.textMuted) + ';') + qtFontDual(22, 12)" :class="[isCurrentQueueRow(row) ? 'queue-index-active' : '', layout.isWide ? 'queue-index-wide' : '']">{{ row.index + 1 }}</text>
                <view class="queue-info" :class="layout.isWide ? 'queue-info-wide' : ''">
                  <text class="queue-name" :style="('color:' + theme.skin.text + ';') + qtFontDual(27, 15)" :class="[isCurrentQueueRow(row) ? 'queue-name-active' : '', layout.isWide ? 'queue-name-wide' : '']" :max-lines="1">{{ row.song.name }}</text>
                  <text class="queue-meta" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(21, 11)" :class="layout.isWide ? 'queue-meta-wide' : ''" :max-lines="1">{{ row.song.singer }}</text>
                </view>
                <QtIcon class="queue-move" name="arrow-up" :size="layout.isWide ? 18 : 30" :color="theme.skin.textMuted" @click.stop="queueRowAction(row, 'up')" />
                <QtIcon class="queue-move" name="arrow-down" :size="layout.isWide ? 18 : 30" :color="theme.skin.textMuted" @click.stop="queueRowAction(row, 'down')" />
                <QtIcon class="queue-move" name="close" :size="layout.isWide ? 18 : 30" :color="theme.skin.textMuted" @click.stop="queueRowAction(row, 'remove')" />
                <view v-if="tv.enabled" class="queue-tv-more" @click.stop>
                  <QtButton :data-qt-tv-id="'player-queue-more:' + row.key" label="更多" icon="more" variant="outline" size="sm" @click="queueActions(row)" />
                </view>
              </view>
            </view>
            <view v-if="player.queue.length == 0" class="lyric-empty"><text :style="'color:' + theme.skin.textMuted + ';' + qtFontDual(26, 14)">队列为空</text></view>
          </scroll-view>
        </view>
      </view>

      <!-- 歌词偏移弹层：拖动只改草稿（offsetDraftMs），松手才写存储并通知桌面歌词 -->
      <QtSheet v-model:visible="offsetOpen" title="歌词偏移" :subtitle="offsetScopeText" @close="closeOffset">
        <scroll-view class="offset-scroll" direction="vertical" :show-scrollbar="false" :style="offsetViewportStyle">
          <view class="offset-body" :class="layout.isWide ? 'offset-body-wide' : ''">
            <text class="offset-value" :style="('color:' + theme.skin.text + ';') + qtFontDual(46, 28)" :class="layout.isWide ? 'offset-value-wide' : ''">{{ offsetText(offsetDraftMs) }}</text>
            <!-- Touch mapping and thumb geometry share the measured track, never window-scaled wide rpx. -->
            <view class="offset-track" :class="layout.isWide ? 'offset-track-wide' : ''" @touchstart="onOffsetTouchStart" @touchmove="onOffsetTouchMove" @touchend="onOffsetTouchEnd" @touchcancel="onOffsetTouchCancel">
              <view class="offset-rail" :class="layout.isWide ? 'offset-rail-wide' : ''" :style="'background-color:' + theme.skin.surfaceStrong + ';'"></view>
              <view class="offset-thumb" :class="layout.isWide ? 'offset-thumb-wide' : ''" :style="'left:' + offsetThumbLeft() + 'px;background-color:' + theme.skin.text + ';'"></view>
            </view>
            <view class="offset-scale" :class="layout.isWide ? 'offset-scale-wide' : ''">
              <text class="offset-scale-text" :class="layout.isWide ? 'offset-scale-text-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(20, 11)">-10s</text>
              <text class="offset-scale-text" :class="layout.isWide ? 'offset-scale-text-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(20, 11)">0</text>
              <text class="offset-scale-text" :class="layout.isWide ? 'offset-scale-text-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(20, 11)">+10s</text>
            </view>
            <view class="offset-steps" :class="layout.isWide ? 'offset-steps-wide' : ''">
              <view class="offset-step" :class="layout.isWide ? 'offset-step-wide' : ''" :style="'background-color:' + theme.skin.surfaceStrong + ';'" @click="nudgeOffset(-LYRIC_OFFSET_STEP_MS)">
                <text class="offset-step-text" :class="layout.isWide ? 'offset-step-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(24, 14)">-100ms</text>
              </view>
              <view class="offset-step" :class="layout.isWide ? 'offset-step-wide' : ''" :style="'background-color:' + theme.skin.surfaceStrong + ';'" @click="nudgeOffset(LYRIC_OFFSET_STEP_MS)">
                <text class="offset-step-text" :class="layout.isWide ? 'offset-step-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(24, 14)">+100ms</text>
              </view>
              <view class="offset-step" :class="layout.isWide ? 'offset-step-wide' : ''" :style="'background-color:' + theme.skin.surfaceStrong + ';'" @click="resetOffset">
                <text class="offset-step-text" :class="layout.isWide ? 'offset-step-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(24, 14)">恢复默认</text>
              </view>
            </view>
            <text class="offset-note" :class="layout.isWide ? 'offset-note-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(21, 12)">歌词比声音快时调正（延后）；歌词比声音慢时调负（提前）。</text>
            <text class="offset-note" :class="layout.isWide ? 'offset-note-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(21, 12)">按曲目保存；调 0 即恢复继承全局默认。</text>
          </view>
        </scroll-view>
      </QtSheet>

      <!-- 歌词字号弹层：只给档位按钮、不做滑条 —— 字号是可枚举的 7 档（70%~130%），
           滑条能拖出 103% 这种既无法复现、也和 store 的 0.1 量化口径冲突的值。
           版式直接复用偏移弹层的 offset-* 类（同一套 value / steps / note 尺寸），
           免得为一张只有三个按钮的弹层再抄一份 px 与宽屏覆盖。 -->
      <QtSheet v-model:visible="sizeOpen" title="歌词字号" :subtitle="lyricSizeText()" @close="closeLyricSize">
        <view class="offset-body" :class="layout.isWide ? 'offset-body-wide' : ''">
          <!-- 预览行直接按当前倍率渲染：调完立刻能看出差别，不用退出去看歌词区 -->
          <text class="size-preview" :class="layout.isWide ? 'size-preview-wide' : ''" :style="('color:' + theme.skin.text + ';font-weight:600;font-size:' + lyricPreviewPx + 'px;')">{{ lyricPreviewText() }}</text>
          <view class="offset-steps" :class="layout.isWide ? 'offset-steps-wide' : ''">
            <view class="offset-step" :class="layout.isWide ? 'offset-step-wide' : ''" :style="'background-color:' + theme.skin.surfaceStrong + ';'" @click="nudgeLyricSize(-LYRIC_SIZE_STEP)">
              <text class="offset-step-text" :class="layout.isWide ? 'offset-step-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(24, 14)">A-</text>
            </view>
            <view class="offset-step" :class="layout.isWide ? 'offset-step-wide' : ''" :style="'background-color:' + theme.skin.surfaceStrong + ';'" @click="resetLyricSize">
              <text class="offset-step-text" :class="layout.isWide ? 'offset-step-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(24, 14)">恢复默认</text>
            </view>
            <view class="offset-step" :class="layout.isWide ? 'offset-step-wide' : ''" :style="'background-color:' + theme.skin.surfaceStrong + ';'" @click="nudgeLyricSize(LYRIC_SIZE_STEP)">
              <text class="offset-step-text" :class="layout.isWide ? 'offset-step-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(24, 14)">A+</text>
            </view>
          </view>
          <text class="offset-note" :class="layout.isWide ? 'offset-note-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(21, 12)">{{ lyricSizeHint() }}</text>
        </view>
      </QtSheet>

      <!-- 「搜索歌词」弹层：候选来自四源聚合搜索，选中后把那首候选的歌词接到当前歌上。
           入口常驻在偏移旁边（见上面两处工具行），无词和有词但挂错版本都能修 -->
      <QtSheet v-model:visible="lyricSearchOpen" title="搜索歌词" :subtitle="lyricSearchKeyword">
          <view v-if="lyricSearchLoading" class="lyric-empty"><text class="lrc-empty" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(26, 14)">正在搜索…</text></view>
          <scroll-view v-else direction="vertical" :show-scrollbar="false" :style="'height:' + Math.floor(layout.paneHeight * 0.55) + 'px;'">
            <view
              v-for="(cand, index) in lyricSearchCandidates"
              :key="cand.platform + ':' + cand.id + ':' + index"
              class="cand-row"
              :class="layout.isWide ? 'cand-row-wide' : ''"
              :style="'background-color:' + theme.skin.surfaceStrong + ';'"
              @click="pickLyricCandidate(cand)"
            >
              <view class="cand-info">
                <text class="cand-name" :style="('color:' + theme.skin.text + ';') + qtFontDual(27, 15)" :class="layout.isWide ? 'cand-name-wide' : ''" :max-lines="1">{{ cand.name }}</text>
                <text class="cand-meta" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(21, 11)" :class="layout.isWide ? 'cand-meta-wide' : ''" :max-lines="1">{{ candMeta(cand) }}</text>
              </view>
              <text class="cand-badge" :style="('background-color:' + platformColor(cand.platform) + ';color:#ffffff;') + qtFontDual(18, 11)">{{ platformShort(cand.platform) }}</text>
            </view>
            <view v-if="lyricSearchCandidates.length == 0" class="lyric-empty"><text class="lrc-empty" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(26, 14)">没有找到可选的歌曲</text></view>
          </scroll-view>
      </QtSheet>

      <QtPlayingStyleSheet v-model:visible="styleOpen" :cover="art()" />
      <QtPlaybackSourceSheet v-model:visible="playbackSourceOpen" :source="playbackSourceId" :quality="playbackQualityId" :local="playingLocalFile" :podcast="playingPodcast" :file-text="playbackFileText" :section="playbackSourceSection" @source="onPlaybackSourcePicked" @quality="onPlaybackQualityPicked" />
      <qt-action-sheet v-model:visible="sheetVisible" :title="sheetTitle" :actions="sheetActions" :selected-index="sheetSelectedIndex" @select="onSheetSelect" />
      <QtPlaylistPicker v-model:visible="showPicker" :song="currentSong" :playlists="player.pickerPlaylists()" :selected-ids="getSelectedPlaylistIds(currentSong)" :anchor-top="pickerAnchorTop" title="加入 / 移出歌单" :create-playlist="createPickerPlaylist" @confirm="handlePickerConfirm" />
    </view>
  </qt-page-frame>
</template>
<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import { dlnaSupported, openDlna, dlnaUiState } from "@/services/dlna";
const castUi = dlnaUiState();
const casting = computed((): boolean => castUi.state.value != null && castUi.state.value!.target == "dlna");
const castCanSeek = computed((): boolean => !casting.value || castUi.state.value!.canSeek);
import { qtConfirm } from "@/services/confirm";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import { qtPerformance } from "@/uni_modules/qt-ui/composables/use-qt-performance";
import { qtFixedPaneStyle, useQtLayout, qtRpx } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtSheetWidth } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { ref, computed, watch, nextTick, getCurrentInstance, onMounted, onBeforeUnmount } from "vue";
import { onLoad, onShow, onHide, onUnload } from "@dcloudio/uni-app";
import QtPlayingStyleSheet from "@/uni_modules/qt-ui/components/qt-playing-style-sheet/qt-playing-style-sheet.uvue";
import QtPlayingTrack from "@/uni_modules/qt-ui/components/qt-playing-track/qt-playing-track.uvue";
import { useCoverPalette } from "@/uni_modules/qt-ui/composables/use-cover-palette";
import type { MediaPalette } from "@/uni_modules/qt-ui/services/media-palette";
import QtPlaybackSourceSheet from "@/uni_modules/qt-ui/components/qt-playback-source-sheet/qt-playback-source-sheet.uvue";
import QtFocusLyrics from "@/uni_modules/qt-ui/components/qt-focus-lyrics/qt-focus-lyrics.uvue";
import { usePlayingStyle } from "@/uni_modules/qt-ui/stores/playing-style";
import { resolvePlayingBackground, playingBackgroundColor } from "@/uni_modules/qt-ui/composables/playing-style";
import QtMarquee from "@/uni_modules/qt-ui/components/qt-marquee/qt-marquee.uvue";
import { portraitPlayerMetrics, widePlayerMetrics, playerQueueMetrics, playerQueueWindow, playerQueueAnchorScroll, playerOffsetMetrics, playerOffsetThumbLeft, playerOffsetFromClientX } from "@/uni_modules/qt-ui/composables/player-presentation";
import { playingTrackMetrics } from "@/uni_modules/qt-ui/composables/playing-track-metrics";
import { turntableMetrics, turntableStyles } from "@/uni_modules/qt-ui/composables/turntable-presentation";
import { lyricFocusAt, lyricTextFocusStyle } from "@/uni_modules/qt-ui/composables/lyric-presentation";
import type { SheetAction } from "@/uni_modules/qt-ui/components/qt-action-sheet/qt-action-sheet.uvue";
import QtActionSheet from "@/uni_modules/qt-ui/components/qt-action-sheet/qt-action-sheet.uvue";
import QtSheet from "@/uni_modules/qt-ui/components/qt-sheet/qt-sheet.uvue";
import QtPitchControls from "@/uni_modules/qt-ui/components/qt-pitch-controls/qt-pitch-controls.uvue";
import { QT_SLEEP_OPTIONS, QT_PLAYBACK_RATES, qtSleepSelectedIndex } from "@/services/player-setting-options";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtButton from "@/uni_modules/qt-ui/components/qt-button/qt-button.uvue";
import { useQtTv, useQtTvRemote, qtTvFocus, qtTvTokens, qtTvHasModal } from "@/uni_modules/qt-ui/composables/use-qt-tv";
import { qtTopRoute } from "@/uni_modules/qt-ui/composables/qt-page-chrome";
import { useQtTvModal } from "@/uni_modules/qt-ui/composables/use-qt-tv-modal";
import QtPlaylistPicker from "@/uni_modules/qt-ui/components/qt-playlist-picker/qt-playlist-picker.uvue";
import { usePlayerStore } from "@/stores/player";
import { useDownloadsStore } from "@/stores/downloads";
import { PLAYER_BAR_MAX_VISIBLE, PLAYER_BAR_TOOLS, type PlayerBarToolMeta, playerBarCounted as playerBarCountedShared, playerBarFixed, usePlayerBarStore } from "@/stores/player-bar";
import { useDislikesStore } from "@/stores/dislikes";
import { useSourceRegistryStore } from "@/stores/source-registry";
import { useShareCardStore } from "@/stores/share-card";
import { findSourceCandidates, peekSourceCandidates } from "@/services/source-switch";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { audioPlayer, audioCapabilities, PLAYER_CAPABILITIES_CHANGED_EVENT, PLAYER_PITCH_CHANGED_EVENT } from "@/services/audio-player";
import { musicApi, isQtAdmin, MusicApi } from "@/services/music-api";
import { useLyricOffsetStore, LYRIC_OFFSET_MAX_MS, LYRIC_OFFSET_STEP_MS } from "@/stores/lyric-offset";
import { useLyricSizeStore, LYRIC_SIZE_STEP, LYRIC_SIZE_MIN, LYRIC_SIZE_MAX } from "@/stores/lyric-size";
import { desktopLyric } from "@/services/desktop-lyric";
import { platformLabel, platformShort, platformColor } from "@/services/platform";
import { SOURCE_QUALITIES_CHANGED_EVENT } from "@/services/source-quality";
import { isHarmonyOs } from "@/services/app-native";
import { localFileSizeOf, localFirstDiagnose } from "@/services/local-first";
import { savePreferredSource, preferredSource } from "@/services/preferred-source";
import { sourceEnabled } from "@/services/source-policy";
import { qtDiag } from "@/services/diag";
import { beginLoading, finishLoading } from "@/services/ui-loading";
import { qtTrackPage } from "@/uni_modules/qt-stat";
import type { Song, LyricLine, Playlist } from "@/types/music";

const player = usePlayerStore();
const downloads = useDownloadsStore();
const playerBar = usePlayerBarStore();
const dislikes = useDislikesStore();
const sourceRegistry = useSourceRegistryStore();
const shareCard = useShareCardStore();
const theme = useThemeStore();
const fontScale = useFontScaleStore();
const pageVisible = ref(true);
const tv = useQtTv();
const tvLyricBrowsing = ref(false);
const tvCoverShown = ref(false);
let tvLyricSongKey = "";
let tvLyricStyle = "";
let tvLyricDataGeneration = -1;
let tvLyricRevealSeq = 0;
let tvLyricMoveAt = 0;
const showLyric = ref(false);
const queueOpen = ref(false);
const playingStyle = usePlayingStyle();
const styleOpen = ref(false);
const playbackSourceOpen = ref(false);
const playbackSourceSection = ref("source");
const playbackMetadataTick = ref(0);
const backgroundFailed = ref("");
const immersiveLyrics = computed((): boolean => (playingStyle.style == "rhythm" || playingStyle.style == "focus") && !tvLyricBrowsing.value && !(tv.enabled && tvCoverShown.value));
const galleryLyrics = computed((): boolean => playingStyle.style == "gallery");
const backgroundKind = computed((): string => resolvePlayingBackground(playingStyle.style, playingStyle.background));
const mediaPalette = useCoverPalette(() => art(), () => pageVisible.value && backgroundKind.value == "cover" && qtPerformance.expensiveEffects);
const activeMediaPalette = computed((): MediaPalette | null => backgroundKind.value == "cover" && qtPerformance.expensiveEffects && mediaPalette.value?.cover == art() ? mediaPalette.value : null);
const mediaBackgroundImage = computed((): string => activeMediaPalette.value?.background ?? "");
const playerBackgroundImage = computed((): string => {
  const image = backgroundKind.value == "image" ? playingStyle.image : backgroundKind.value == "theme" ? theme.skin.backgroundImage : "";
  return !qtPerformance.expensiveEffects || image == backgroundFailed.value ? "" : image;
});
const playerDarkMood = computed((): boolean => ["burgundy", "midnight", "forest"].includes(backgroundKind.value));
const playerSurface = computed((): string => activeMediaPalette.value?.surface ?? (playerDarkMood.value ? playingBackgroundColor(backgroundKind.value) : theme.skin.background));
const playerInk = computed((): string => activeMediaPalette.value?.ink ?? (playerDarkMood.value ? "#fff8f4" : theme.skin.text));
const playerMuted = computed((): string => activeMediaPalette.value?.muted ?? (playerDarkMood.value ? "#c9c4d0" : theme.skin.textMuted));
const playerRail = computed((): string => activeMediaPalette.value?.rail ?? (playerDarkMood.value ? "rgba(255,255,255,0.12)" : theme.skin.surfaceMuted));
const playerFooter = computed((): string => activeMediaPalette.value != null || playerDarkMood.value || theme.dark ? "rgba(0,0,0,0.12)" : "rgba(255,255,255,0.72)");
const playerAccent = computed((): string => activeMediaPalette.value?.accent ?? playerInk.value);
const playerControl = computed((): string => activeMediaPalette.value?.accent ?? (playerDarkMood.value ? playerInk.value : theme.skin.accent));
const playerControlInk = computed((): string => activeMediaPalette.value?.controlInk ?? (playerDarkMood.value ? playerSurface.value : theme.skin.onAccent));

function syncPlayerStatusBar(): void {
  if (!pageVisible.value) return;
  uni.setNavigationBarColor({
    frontColor: activeMediaPalette.value != null || playerDarkMood.value || theme.dark ? "#ffffff" : "#000000",
    backgroundColor: playerSurface.value,
    // The next onShow reapplies the style if a page transition has already removed the target.
    fail: () => {},
  });
}

/**
 * 歌词偏移（页内弹层）。正数 = 歌词延后出现，与 qt-pc / utils/lrc.uts 的
 * `progress - offsetSec` 同口径；值本身只存在 stores/lyric-offset.ts 里，本页只做编辑。
 * 拖动过程中只更新 offsetDraftMs 预览，松手（touchend）才提交 —— 与进度条拖动的
 * 口径一致（pages/desktop-lyric/index.uvue 的拖动条同理），避免每个 move 事件都写一次 KV。
 */
const lyricOffset = useLyricOffsetStore();
const offsetOpen = ref(false);
/**
 * 歌词字号（页内弹层）。与偏移不同，字号是**全局偏好**而不是按曲目：用户调的是
 * 自己的阅读舒适度，切歌再调一遍是负担，所以直接落 stores/lyric-size.ts 的单档。
 * 值本身只存在 store 里，本页只做编辑与乘算 —— 三个渲染口径
 * （普通行 lrcStyle / 译文与罗马音 lrcTrStyle+lrcRomaStyle / 逐字 karaokeFontSize）
 * 与沉浸式 QtFocusLyrics 的 sizeScale 全部读同一个倍率，改一处即全页一致。
 */
const lyricSize = useLyricSizeStore();
const sizeOpen = ref(false);
// 切歌淡入：只动 opacity，不动 layout（Vapor 下改 width/height 会打断布局）。
// 320ms/ease-out 沿用 use-qt-reveal 的 QT_REVEAL_TRANSITION —— 仓库唯一的过渡时长口径。
const coverShown = ref<boolean>(true);
// 弹层上滑入：transform 过渡在 pages/playlists/index.uvue:1044 有真机先例
const sheetIn = ref<boolean>(true);
let sheetEnterTimer: number | null = null;
let coverEnterTimer: number | null = null;
function armSheet(): void {
  if (!pageAlive) return;
  if (sheetEnterTimer != null) clearTimeout(sheetEnterTimer);
  sheetIn.value = false;
  const timer = setTimeout(() => {
    if (!pageAlive || sheetEnterTimer != timer) return;
    sheetEnterTimer = null;
    sheetIn.value = true;
  }, 16) as number;
  sheetEnterTimer = timer;
}
const offsetDragging = ref(false);
const offsetDraftMs = ref(0);
/** 偏移轨道实测几何（px）：拖动时不能每帧调 uni.getWindowInfo()，测一次缓存起来 */
const offsetTrackWidth = ref(0);
/** 「搜索歌词」弹层：候选来自 musicApi.searchLyricCandidates（四源聚合搜索结果）。
    入口常驻在偏移按钮旁边，无词、以及「有词但挂错版本」都能进。 */
const lyricSearchOpen = ref(false);
const lyricSearchLoading = ref(false);
const lyricSearchAdopting = ref(false);
const lyricSearchCandidates = ref<Song[]>([]);
const lyricSearchKeyword = ref("");
/**
 * 手选来源的无响应依赖计数器：hasPickedLyric 读的是 music-api 里的普通对象，
 * 不是响应式数据，改完（选中 / 恢复自动）必须手动 ++ 才能让模板重算。
 */
const lyricPickVersion = ref(0);

/**
 * 当前播放曲目的生效偏移（秒）。统一在这里取，四处调用点（取行 / 逐字染色 / 点行跳转）
 * 才不会有谁漏减。取的是 **当前播放的歌** 而不是 lyricOffset.activeKey —— 后者是编辑
 * 上下文，用户可能在播放页给别的歌设偏移（切歌后 setActive 才跟上）。
 */
function lyricOffsetSec(): number {
  return lyricOffset.offsetSecFor(player.current);
}

/**
 * 偏移值的展示文本：正数带 +，零值显示「0」。
 *
 * 小数位按实际粒度决定，不能一律 toFixed(1)：滑块吸附 50ms，0.05s 会被四舍五入成
 * 「0.1s」、0.15s 显示成「0.2s」，用户用 ±100ms 按钮累加时会对不上账。
 */
function offsetText(ms: number): string {
  if (ms == 0) return "0";
  const sign = ms > 0 ? "+" : "-";
  const abs = Math.abs(ms);
  if (abs % 1000 == 0) return sign + (abs / 1000) + "s";
  if (abs % 100 == 0) return sign + (abs / 1000).toFixed(1) + "s";
  return sign + (abs / 1000).toFixed(2) + "s";
}

/** 歌词工具行上偏移按钮的文案：没设过就是入口名，设过就显示当前值 */
function offsetButtonText(): string {
  const ms = currentOffsetMs.value;
  if (ms == 0) return "歌词偏移";
  return "偏移 " + offsetText(ms);
}

/**
 * 歌词是否正在取（切歌瞬间 lyricLines 还是空的，不能把这当成「这首歌没有词」）。
 * 初值 true：模板首次渲染发生在 onMounted 之前，那时 loadLyric 还没跑、lyricLines 是空的，
 * 初值 false 会让常驻的「搜索歌词」入口先按「无词」显示强调色、再跳回普通色。
 * 取词结束（含取不到词）才置 false。
 */
const lyricLoading = ref(true);

/** 仅用于 .stop 阻止事件冒泡到遮罩（必须给一个真实处理函数，不能留空） */
function noop(): void {}

/** 当前播放曲目的生效偏移（毫秒）：入口按钮上显示，用户一眼能看出这首歌是否设过 */
const currentOffsetMs = computed((): number => lyricOffset.offsetMsFor(player.current));
watch(currentOffsetMs, (offset: number) => {
  const current = player.current;
  if (current != null) audioPlayer.setCarLyricOffset(current.platform + ":" + current.id, offset);
});
/** 偏移弹层副标题：区分「这首歌的覆盖」与「全局默认」 */
const offsetScopeText = computed((): string => (player.current != null ? "按曲目保存" : "全局默认"));
/**
 * 当前歌是否「没有正式歌词」（只剩占位行）。
 * 不能只看 lyricLines.length == 0：loadLyric 取不到词时会主动落地一行占位文本
 * （「纯音乐，请欣赏」/「暂无歌词」），长度恒 ≥ 1。取词中也不算「无词」，
 * 否则每次切歌入口都会闪一下。
 */
const noLyricYet = computed((): boolean => {
  if (lyricLoading.value) return false;
  const lines = lyricLines.value;
  if (lines.length == 0) return true;
  if (lines.length > 1) return false;
  const text = lines[0].text;
  return text == "纯音乐，请欣赏" || text == "暂无歌词";
});
/** 是否给当前歌手选过歌词来源（hasPickedLyric 读的是普通对象，靠 lyricPickVersion 驱动重算） */
const lyricPicked = computed((): boolean => {
  const _ = lyricPickVersion.value;
  const current = player.current;
  return current != null && musicApi.hasPickedLyric(current);
});

/* ---------- 歌词偏移弹层 ---------- */

/** 偏移轨道实测几何（px）；弹层是 v-if 动态创建的，测量必须等 nextTick */
let offsetLeft = 0;
let offsetTrackTimer: number | null = null;
let offsetTrackSeq = 0;
const offsetGeometry = computed(() => playerOffsetMetrics(layout.paneWidth, layout.paneHeight, layout.isWide, qtSheetWidth("drawer"), layout.safeBottomPx, fontScale.scale, layout.windowWidth));
const offsetViewportStyle = computed((): string => "height:" + offsetGeometry.value.viewportPx + "px;");
/** 滑块吸附粒度（毫秒）：比 ±100ms 按钮更细，但不足以让手指抖动产生 3ms 这种无意义值 */
const OFFSET_SNAP_MS = 50;

/** Always reactive fallback: same-mode resizes must not retain old width/left/unit caches. */
function offsetTrackWidthPx(): number {
  return offsetTrackWidth.value > 0 ? offsetTrackWidth.value : offsetGeometry.value.trackWidthPx;
}
function offsetTrackLeftPx(): number {
  return offsetTrackWidth.value > 0 ? offsetLeft : layout.paneLeft + offsetGeometry.value.trackLeftPx;
}
function offsetThumbLeft(): number {
  return playerOffsetThumbLeft(offsetDraftMs.value, LYRIC_OFFSET_MAX_MS, offsetTrackWidthPx(), offsetGeometry.value.thumbSizePx);
}
function offsetFromClientX(clientX: number): number {
  return playerOffsetFromClientX(clientX, offsetTrackLeftPx(), offsetTrackWidthPx(), LYRIC_OFFSET_MAX_MS, OFFSET_SNAP_MS, offsetDraftMs.value);
}
function invalidateOffsetTrack(): void {
  offsetTrackSeq++;
  if (offsetTrackTimer != null) clearTimeout(offsetTrackTimer);
  offsetTrackTimer = null;
  offsetTrackWidth.value = 0;
  offsetLeft = 0;
}
function measureOffsetTrack(): void {
  offsetTrackSeq++;
  if (offsetTrackTimer != null) clearTimeout(offsetTrackTimer);
  offsetTrackTimer = null;
  measureOffsetTrackRetry(0, offsetTrackSeq);
}
function measureOffsetTrackRetry(attempt: number, seq: number): void {
  if (!pageAlive || !offsetOpen.value || seq != offsetTrackSeq) return;
  uni.createSelectorQuery().select(".offset-track").boundingClientRect((rect: UniNodeInfo) => {
    if (!pageAlive || !offsetOpen.value || seq != offsetTrackSeq) return;
    if (rect != null && isFinite(rect.width) && isFinite(rect.left) && rect.width > 0) {
      offsetLeft = rect.left;
      offsetTrackWidth.value = rect.width;
      return;
    }
    if (attempt < 3) offsetTrackTimer = setTimeout(() => measureOffsetTrackRetry(attempt + 1, seq), 120) as number;
  }).exec();
}

/**
 * 偏移提交后的统一收尾：通知桌面歌词 + 立即重算高亮。
 *
 * 桌面歌词只在进度回调里更新，而 services/desktop-lyric.uts 的 onProgress 首行是
 * 「进度和上次差不到 0.1s 就直接 return」—— 暂停时进度不动，改完偏移悬浮窗不会有
 * 任何反应，用户会以为功能没生效。必须显式 notifyOffsetChanged 让它作废
 * lastProgress/lastLineIndex 并立即重推一次当前行。
 */
function afterOffsetChange(): void {
  // 逐字填充的锚点必须先作废：偏移是在 applyKaraokeFill 内部才减掉的，
  // 而 stepKaraoke 收到的是**原始进度**——改偏移时原始进度并没有动，
  // 于是「只进不退」的下限会把填充冻在旧位置，直到原始进度爬过它才恢复。
  // resetKaraoke 把 anchorLine 归 -1，紧跟的 updateLyricScroll(true) 会
  // 用新偏移重新对表；两步在同一个 tick 内同步完成，不会闪一帧。
  resetKaraoke();
  desktopLyric.notifyOffsetChanged();
  updateLyricScroll(true);
}
function commitOffset(ms: number): void {
  offsetDraftMs.value = ms;
  lyricOffset.setActiveMs(ms);
  afterOffsetChange();
}
function openOffset(): void {
  // 编辑上下文切到当前播放曲目：这个入口改的就是「这首歌」的偏移。
  // 传 null 会退化成编辑全局默认，那不是本入口的语义。
  lyricOffset.setActive(player.current);
  offsetDraftMs.value = lyricOffset.activeMs();
  invalidateOffsetTrack();
  offsetOpen.value = true;
  armSheet();
}
function closeOffset(): void {
  offsetDragging.value = false;
  invalidateOffsetTrack();
  offsetOpen.value = false;
}
/** 字号变化由几何 watcher 作废旧行高，布局重测成功后再强制居中。
 * 此处只重置逐字状态，不用上一档行高下发滚动或渐隐，否则后半首会整屏错位。
 */
function applyLyricSize(): void {
  resetKaraoke();
}
function openLyricSize(): void {
  sizeOpen.value = true;
  armSheet();
}
function closeLyricSize(): void {
  sizeOpen.value = false;
}
/** 只有倍率真的变了才重置逐字状态。
 * 已经顶到 160% 再点 A+（或 100% 再点「恢复默认」）时倍率不变、几何 watcher 不触发，
 * 若照样 resetKaraoke，暂停中的逐字填充会被清掉且没有进度回调来补，当前行会一直空着。
 */
function nudgeLyricSize(delta: number): void {
  const before = lyricSize.scale;
  if (lyricSize.nudge(delta) != before) applyLyricSize();
}
function resetLyricSize(): void {
  const before = lyricSize.scale;
  if (lyricSize.reset() != before) applyLyricSize();
}
/** 字号弹层主值：百分比（100% = 默认档）+ 是否顶到两端 */
function lyricSizeText(): string {
  return lyricSize.percent() + "%";
}
function lyricSizeHint(): string {
  // 文案里的上下限直接取 store 常量：改档位时只有一处要改，不会出现文案与夹取不一致
  if (!lyricSize.canGrow()) return "已到最大字号（" + Math.round(LYRIC_SIZE_MAX * 100) + "%）";
  if (!lyricSize.canShrink()) return "已到最小字号（" + Math.round(LYRIC_SIZE_MIN * 100) + "%）";
  return "字号只影响歌词，不改变界面其它文字。";
}
/** 弹层里那行预览的字号（px）：按当前倍率实时渲染，等于所见即所得 */
const lyricPreviewPx = computed((): number => Math.round((layout.isWide ? 26 : 30) * lyricSize.scale));
/**
 * 预览文本优先用**当前高亮那一行真歌词**：空行/纯音乐时退回固定文案。
 * 拿真词做预览才能暴露「放大后长句会不会换行」这种真问题，固定短句看不出来。
 */
function lyricPreviewText(): string {
  const lines = lyricLines.value;
  const index = activeLyric.value;
  if (index >= 0 && index < lines.length) {
    const text = lines[index].text.trim();
    if (text.length > 0) return text;
  }
  return "歌词字号预览";
}

function onOffsetTouchStart(event: UniTouchEvent): void {
  const touch = event.touches[0];
  if (touch == null) return;
  measureOffsetTrack();
  offsetDragging.value = true;
  // 拖动期间只改草稿，松手才写 KV：每个 move 都落一次存储既慢也没必要
  offsetDraftMs.value = offsetFromClientX(touch.clientX);
}
function onOffsetTouchMove(event: UniTouchEvent): void {
  if (!offsetDragging.value) return;
  const touch = event.touches[0];
  if (touch == null) return;
  offsetDraftMs.value = offsetFromClientX(touch.clientX);
}
function onOffsetTouchEnd(event: UniTouchEvent): void {
  if (!offsetDragging.value) return;
  const changed = event.changedTouches;
  const touch = changed != null && changed.length > 0 ? changed[0] : null;
  const value = touch != null ? offsetFromClientX(touch.clientX) : offsetDraftMs.value;
  offsetDragging.value = false;
  commitOffset(value);
}
/** 触摸被系统打断（来电、手势冲突）：不提交半途的值，显示回到已保存值 */
function onOffsetTouchCancel(): void {
  if (!offsetDragging.value) return;
  offsetDragging.value = false;
  offsetDraftMs.value = lyricOffset.activeMs();
}
function nudgeOffset(deltaMs: number): void {
  offsetDraftMs.value = lyricOffset.nudgeActive(deltaMs);
  afterOffsetChange();
}
function resetOffset(): void {
  lyricOffset.resetActive();
  // 归零 = 删掉本曲覆盖 → 重新读出来的是继承的全局值，显示要跟着变
  offsetDraftMs.value = lyricOffset.activeMs();
  afterOffsetChange();
}

/* ---------- 「搜索歌词」弹层（入口常驻偏移旁边） ---------- */

/** 候选行副标题：专辑名可能为空，空的时候不要留一个孤零零的分隔点 */
function candMeta(cand: Song): string {
  if (cand.album != null && cand.album.length > 0) return cand.singer + " · " + cand.album;
  return cand.singer;
}

async function openLyricSearch(): Promise<void> {
  const current = player.current;
  if (current == null) return;
  if (lyricSearchLoading.value) return;
  lyricSearchOpen.value = true;
  lyricSearchLoading.value = true;
  lyricSearchCandidates.value = [];
  // 与 music-api 内部的取词口径一致（歌手 歌名），页面上用来展示「搜的是什么」
  lyricSearchKeyword.value = current.singer.length > 0 ? current.singer + " " + current.name : current.name;
  try {
    lyricSearchCandidates.value = await musicApi.searchLyricCandidates(current);
  } catch (_) {
    lyricSearchCandidates.value = [];
  } finally {
    lyricSearchLoading.value = false;
  }
}

/**
 * 手选来源取词成功后把歌词换到页面上。
 *
 * 不能调 ensureLyric()：它第一行是 `if (key == loadedKey) return;`，当前歌早就加载过，
 * loadedKey 等于当前 key，调了等于什么都没发生。adoptLyricFor 已经把结果写进了
 * music-api 的歌词缓存，所以这里同步重读四件套重建即可（与 loadLyric() 命中预热缓存
 * 那条分支同一套写法），不发任何请求。
 */
function applyAdoptedLyric(current: Song): void {
  player.refreshCarLyric();
  const parsed = buildLyricLines(
    musicApi.cachedLyricWordByWord(current),
    musicApi.cachedLyric(current),
    musicApi.cachedLyricTranslation(current),
    musicApi.cachedLyricRomanization(current)
  );
  qtDiag("[QT Lyric] 手选来源落地 " + current.name + " → " + parsed.length + " 行");
  applyLyricLines(parsed.length == 0 ? [{ time: 0, text: "纯音乐，请欣赏" }] : parsed);
  // 桌面歌词是独立跟随的：它有自己的 loadedKey（同样只看 platform:id），换来源后
  // 歌没变、key 也没变，不同步通知的话悬浮窗会一直停在旧来源的歌词上
  desktopLyric.notifyLyricChanged();
}

async function pickLyricCandidate(cand: Song): Promise<void> {
  const current = player.current;
  if (current == null || cand == null) return;
  if (lyricSearchAdopting.value) return;
  lyricSearchAdopting.value = true;
  const actToken = beginLoading("正在获取歌词…");
  try {
    const text = await musicApi.adoptLyricFor(current, cand);
    finishLoading(actToken);
    // 取词期间切了歌：候选词属于旧歌。手选取词是异步的，等回来时若已换曲，
    // 应用会让新歌先亮一拍旧歌的词（封面态单行歌词直接放大到用户眼前）。
    const nowSong = player.current;
    if (nowSong == null || nowSong.id != current.id || nowSong.platform != current.platform) return;
    // hasPickedLyric 读的是普通对象，改完必须手动 ++ 才能让入口按钮重算
    lyricPickVersion.value++;
    if (text.length == 0) {
      // 这首候选也没词：保留弹层让用户接着挑，且**不要**用空串覆盖现有歌词
      qtShowToast({ title: "这首候选也没有歌词", icon: "none" });
      return;
    }
    lyricSearchOpen.value = false;
    applyAdoptedLyric(current);
  } catch (_) {
    finishLoading(actToken);
    qtShowToast({ title: "获取歌词失败，请稍后再试", icon: "none" });
  } finally {
    lyricSearchAdopting.value = false;
  }
}

/** 取消手选，回到「按原平台自动取词」 */
function resetLyricPick(): void {
  const current = player.current;
  if (current == null) return;
  musicApi.clearLyricPick(current);
  player.refreshCarLyric();
  lyricPickVersion.value++;
  // clearLyricPick 已把原歌的四段缓存与「已问过」标记清掉（否则 ensureLyric 会命中
  // 手选源的词、或在 TTL 内被「问过」标记直接短路）。但 ensureLyric 第一行是
  // `if (key == loadedKey) return;`，当前歌的页内标记还在，所以必须先清掉它，
  // 再让它重新走一次完整取词 —— 只清 music-api 那侧，按钮点了会毫无反应。
  loadedKey = "";
  ensureLyric();
  // 同上：恢复自动后桌面歌词也要跟着回到原平台的词
  desktopLyric.notifyLyricChanged();
  qtShowToast({ title: "已恢复自动取词", icon: "none" });
}

/** 仅当账号具备轻听管理权限时，才展示「播放地址」调试入口（权限由 /me 缓存，进入页面时刷新） */
const showPlayUrlEntry = ref(isQtAdmin());
/**
 * 工具按钮开关（设置 → 播放页按钮）：关掉的按钮整行不渲染。
 * 「播放链接」还额外要求 qt_admin 权限，两者都满足才出现。
 */
function toolVisible(id: string): boolean {
  if (casting.value && (id == "speed" || id == "equalizer")) return false;
  if (id == "playUrl" && !showPlayUrlEntry.value) return false;
  return playerBar.isVisible(id);
}
/**
 * 手机播放页最下面那一行（用户 m15536）：只放「设置 → 播放页展示设置」里勾选的项，
 * 最多 PLAYER_BAR_MAX_VISIBLE 个。收藏 / 分享 / 歌手是固定常驻项（入口分别在曲名块、
 * 右上角、歌手行），既不在这一行渲染，也不占名额。播放链接仍要求 qt_admin。
 */
const barSheetOpen = ref(false);
function barToolList(onlyVisible: boolean): PlayerBarToolMeta[] {
  const out: PlayerBarToolMeta[] = [];
  for (let i = 0; i < PLAYER_BAR_TOOLS.length; i++) {
    const tool = PLAYER_BAR_TOOLS[i];
    if (playerBarFixed(tool.id)) continue;
    if (tool.adminOnly && !showPlayUrlEntry.value) continue;
    if (onlyVisible && !playerBar.isVisible(tool.id)) continue;
    out.push(tool);
  }
  return out;
}
const barTools = computed((): PlayerBarToolMeta[] => barToolList(true));
const barSheetTools = computed((): PlayerBarToolMeta[] => barToolList(false));
/**
 * 「三个点」菜单（用户 m17053）：行点击 = **直接执行该功能**（与底行按钮同一分发），
 * 不再当显隐开关 —— 所有工具（含没展示在底行的）都能从这里直达。
 * 行尾小圆点只是状态提示：亮 = 该工具当前展示在底行；改展示集去 设置→播放页展示设置。
 */
function onBarSheetTool(id: string): void {
  barSheetOpen.value = false;
  onBarTool(id);
}
/** 这一行图标的状态色（m18202：底行在 scrim 上统一提为 mediaText 纯白，开启态才用状态色） */
function barIconColor(id: string): string {
  if (id == "dislike") return dislikedCurrent.value ? theme.skin.danger : playerMuted.value;
  if (id == "sleep") return sleepActive.value ? theme.skin.accent : playerMuted.value;
  if (id == "speed") return rateIndex.value != 1 ? theme.skin.accent : playerMuted.value;
  if (id == "pitch") return pitchSupported.value && appliedPitch.value != 0 ? theme.skin.accent : playerMuted.value;
  return playerMuted.value;
}
/** 这一行按钮的点击分发（与旧 action-row 的点击目标完全一致，只是改由配置驱动） */
function onBarTool(id: string): void {
  if (id == "download") doDownload();
  else if (id == "quality") switchQuality();
  else if (id == "dislike") openDislikeSheet();
  else if (id == "speed") cycleRate();
  else if (id == "pitch") showPitchControls();
  else if (id == "sleep") openSleep();
  else if (id == "equalizer") openEqualizer();
  else if (id == "source") openPlaybackSource();
  else if (id == "playUrl") showPlayUrl();
}
function openBarSheet(): void {
  barSheetOpen.value = true;
}

// ==================== 升降调（底行工具 pitch；2026-11-15 用户指定入播放页展示） ====================
// 与播放设置页同一套服务回执口径：setPitch 返回 false 时不确认成功、不发提示；
// 投屏中 / 不支持平台点按只提示原因，不开弹层。显隐走底行 PLAYER_BAR_TOOLS 配置
//（设置→播放页展示设置），这里不做能力显隐 —— 能力随投屏动态翻转，行内按钮突然
// 消失/位移比「点了给原因」更伤操作连续性（与播放设置行「当前平台暂不支持」同口径）。
const sheetPitch = ref(0);
const appliedPitch = ref(0);
const pitchSheetVisible = ref(false);
const pitchSupported = ref(audioCapabilities().pitch);
let pitchListenersActive = false;
function refreshPitchControls(): void {
  if (!pitchListenersActive) return;
  pitchSupported.value = audioCapabilities().pitch;
  appliedPitch.value = audioPlayer.getPitch();
  sheetPitch.value = appliedPitch.value;
}
function showPitchControls(): void {
  if (!pitchListenersActive) return;
  if (!pitchSupported.value) {
    qtShowToast({ title: casting.value ? "DLNA 接收设备使用原调播放" : "当前平台暂不支持升降调", icon: "none" });
    return;
  }
  refreshPitchControls();
  pitchSheetVisible.value = true;
}
function changePitch(value: number): void {
  if (!pitchListenersActive || !pitchSheetVisible.value) return;
  if (!pitchSupported.value) { pitchSheetVisible.value = false; return; }
  if (!audioPlayer.setPitch(value)) {
    // 服务拒绝（如投屏瞬间被切走）：回读生效值，显示与真实状态保持一致
    appliedPitch.value = audioPlayer.getPitch();
    sheetPitch.value = appliedPitch.value;
    return;
  }
  refreshPitchControls();
}
function onPitchChanged(value: number): void {
  if (!pitchListenersActive) return;
  appliedPitch.value = value;
  sheetPitch.value = value;
}
function startPitchListeners(): void {
  if (pitchListenersActive) return;
  pitchListenersActive = true;
  uni.$on(PLAYER_PITCH_CHANGED_EVENT, onPitchChanged);
  uni.$on(PLAYER_CAPABILITIES_CHANGED_EVENT, refreshPitchControls);
  refreshPitchControls();
}
function stopPitchListeners(): void {
  pitchSheetVisible.value = false;
  if (!pitchListenersActive) return;
  pitchListenersActive = false;
  uni.$off(PLAYER_PITCH_CHANGED_EVENT, onPitchChanged);
  uni.$off(PLAYER_CAPABILITIES_CHANGED_EVENT, refreshPitchControls);
}
onMounted(startPitchListeners);
onShow(startPitchListeners);
onHide(stopPitchListeners);
onUnload(stopPitchListeners);
onBeforeUnmount(stopPitchListeners);
/**
 * 播放列表滚动与定位：scroll-view + 自制窗口虚拟化。
 *
 * 为什么不用 list-view：实机（MuMu / 蒸汽模式 5.25）实测，list-view 的
 * scroll-top 赋值只改组件状态、内容纹丝不动，scroll-into-view 则滚到错误位置
 * 后动画中途冻结，@scroll 回报值与视觉位置也对不上 —— 官方文档亦承认
 * "受限于 list-item 回收复用，scroll-into-view 可能无法准确滚动到指定位置"。
 * 绑定式定位在回收列表上没有可靠路径。
 *
 * scroll-view + scroll-top 是本 App 歌词区长期验证 1:1 可靠的机制，故借用它，
 * 配合窗口虚拟化保住几千条数据下的性能：内容高度 = 行数 × 行高（一个撑高容器），
 * 行绝对定位在 index × 行高处，只渲染可视区上下若干行；定位 = 纯数学，
 * 首次挂载可能在内容高度提交前钳位 scroll-top；正高度测量后需重发定位，
 * 不能把已写入的目标值当成原生已经到达的位置。
 */
const queueScrollTop = ref(0);
/** @scroll 回报的当前滚动位置，窗口计算的基准 */
const queueScrollValue = ref(0);
/** 窗口内渲染的行（可视区 ± QUEUE_WINDOW_MARGIN 行） */
const queueWindow = ref<QueueRow[]>([]);
/** 视口上下各多渲染的行数，吸收快速滑动的渲染延迟 */
const QUEUE_WINDOW_MARGIN = 10;
/** Only a valid measurement for the current window may override the first-frame estimate. */
const queueViewportMeasuredPx = ref(0);
let queueMeasureSeq = 0;
let queueMeasureTimer: number | null = null;
let queueScrollSeq = 0;
let queueScrollPendingSeq = -1;
let queueScrollPendingTarget = -1;
let queueTouchSeq = 0;
/** Keep the opening intent if native layout reports zero before the first measurement. */
let queueOpeningIndex = -1;
let queueAnchorKey = "";
let queueAnchorIndex = 0;
let queueAnchorFraction = 0;

type QueueRow = { index: number; song: Song; key: string; songKey: string; top: number };
type QueueOccurrence = { key: string; song: Song };
let queueOccurrenceSequence = 0;
let queueOccurrences: QueueOccurrence[] = [];
let queueOccurrenceSnapshot: Song[] = [];
let queueCurrentOccurrence = "";
let queueCurrentSong: Song | null = null;
let queueCurrentRevision = -1;
/** Identity is an occurrence, never a song ID or its current virtualized index. */
function syncQueueOccurrences(): void {
  const queue = player.queue;
  if (queue.length == queueOccurrenceSnapshot.length && queue.every((song: Song, index: number): boolean => song === queueOccurrenceSnapshot[index])) return;
  const oldCounts = new Map<Song, number>();
  const nextCounts = new Map<Song, number>();
  const oldEntries = new Map<Song, QueueOccurrence>();
  for (const entry of queueOccurrences) {
    oldCounts.set(entry.song, (oldCounts.get(entry.song) ?? 0) + 1);
    oldEntries.set(entry.song, entry);
  }
  for (const song of queue) nextCounts.set(song, (nextCounts.get(song) ?? 0) + 1);
  const next: QueueOccurrence[] = [];
  for (const song of queue) {
    // External edits cannot identify which identical-reference duplicate disappeared.
    // Invalidate ambiguous old actions instead of silently assigning them to another occurrence.
    const retained = oldCounts.get(song) == 1 && nextCounts.get(song) == 1 ? oldEntries.get(song) : null;
    next.push(retained ?? { key: "entry:" + (++queueOccurrenceSequence), song });
  }
  queueOccurrences = next;
  queueOccurrenceSnapshot = queue.slice();
}
function queueRowIndex(row: QueueRow): number {
  syncQueueOccurrences();
  const index = queueOccurrences.findIndex((entry: QueueOccurrence): boolean => entry.key == row.key && entry.song === row.song);
  if (index < 0 || row.songKey != row.song.platform + ":" + row.song.id) return -1;
  return index;
}
function currentQueueOccurrenceIndex(): number {
  syncQueueOccurrences();
  const current = player.current;
  const revision = player.playbackRevision();
  const retained = queueOccurrences.findIndex((entry: QueueOccurrence): boolean => entry.key == queueCurrentOccurrence);
  if (current !== queueCurrentSong || revision != queueCurrentRevision || retained < 0) {
    const index = player.currentIndex();
    queueCurrentOccurrence = index >= 0 && index < queueOccurrences.length ? queueOccurrences[index].key : "";
    queueCurrentSong = current;
    queueCurrentRevision = revision;
    return index;
  }
  return retained;
}
function commitQueueOccurrences(next: Song[], entries: QueueOccurrence[]): void {
  // Preserve known occurrence moves/deletions before synchronous store watchers run.
  queueOccurrences = entries;
  queueOccurrenceSnapshot = next.slice();
  player.queue = next;
}
async function queueRowAction(row: QueueRow, action: string): Promise<void> {
  if (!pageAlive || !pageVisible.value || !queueOpen.value) return;
  const index = queueRowIndex(row);
  if (index < 0) return;
  if (action == "play") {
    const pending = player.play(player.queue[index]);
    const revision = player.playbackRevision();
    await pending;
    if (!pageAlive || !pageVisible.value || !queueOpen.value || revision != player.playbackRevision()
      || queueRowIndex(row) < 0 || !samePlaybackSong(player.current, row.song)) return;
    queueCurrentOccurrence = row.key;
    queueCurrentSong = player.current;
    queueCurrentRevision = revision;
    rebuildQueueWindow();
  } else if (action == "up") moveUp(index);
  else if (action == "down") moveDown(index);
  else if (action == "remove") removeAt(index);
}

// 断点、横屏和物理折叠屏区统一由 qt-ui 布局快照提供。
const layout = useQtLayout();
const tvShowingCover = computed((): boolean => tvCoverShown.value || (!layout.isWide && !showLyric.value && !immersiveLyrics.value));
watch(() => layout.paneWidth + ":" + layout.paneHeight + ":" + layout.isWide + ":" + layout.safeBottomPx + ":" + fontScale.scale, () => {
  invalidateOffsetTrack();
  offsetDragging.value = false;
  if (offsetOpen.value) nextTick(() => measureOffsetTrack());
});
watch(offsetOpen, (open: boolean) => {
  invalidateOffsetTrack();
  if (open) nextTick(() => measureOffsetTrack());
});
const wideShort = computed((): boolean => layout.isShort);
/** The same configured tools and more entry are used on phone and tablet. */
const wideToolCount = computed((): number => barTools.value.length + 1);
const tvNavExtraPx = computed((): number => tv.enabled ? Math.max(0, qtTvTokens().controlPx - 52) : 0);
const wideMetrics = computed(() => {
  const base = widePlayerMetrics(layout.paneWidth, layout.paneHeight, statusBarPx(), layout.safeBottomPx,
    wideShort.value, wideToolCount.value, fontScale.scale);
  const toolsExtra = tv.enabled ? Math.max(0, qtTvTokens().controlPx - base.lyricHeightPx) : 0;
  const track = playingTrackMetrics(base.trackWidthPx, layout.windowWidth, true, wideShort.value, fontScale.scale, playbackSourceLabel.value, false, name(), artistText());
  const result = widePlayerMetrics(layout.paneWidth, Math.max(0, layout.paneHeight - tvNavExtraPx.value - toolsExtra), statusBarPx(), layout.safeBottomPx,
    wideShort.value, wideToolCount.value, fontScale.scale, track.heightPx);
  return { ...result, padTopPx: result.padTopPx + tvNavExtraPx.value, lyricHeightPx: result.lyricHeightPx + toolsExtra };
});
const wideStageWidth = computed((): number => wideMetrics.value.stageWidthPx);
const wideControlsStacked = computed((): boolean => wideMetrics.value.stacked);
const wideStageStyle = computed((): string => "width:" + wideStageWidth.value + "px;padding-top:" + wideMetrics.value.padTopPx + "px;padding-bottom:" + wideMetrics.value.padBottomPx + "px;");
const wideLyricToolsStyle = computed((): string => "height:" + wideMetrics.value.lyricHeightPx + "px;margin-top:" + wideMetrics.value.lyricMarginPx + "px;");
const wideProgressStyle = computed((): string => "height:" + wideMetrics.value.progressHeightPx + "px;margin-top:" + wideMetrics.value.progressMarginPx + "px;");
const wideControlsStyle = computed((): string => "height:" + wideMetrics.value.controlsHeightPx + "px;margin-top:" + wideMetrics.value.controlsMarginPx + "px;");
const wideTransportStyle = computed((): string => "height:" + wideMetrics.value.controlsRowPx + "px;");
const wideToolsWingStyle = computed((): string => "height:" + (wideControlsStacked.value ? wideMetrics.value.toolsRowPx - 6 : wideMetrics.value.controlsRowPx) + "px;");
const wideArtColumnPx = computed((): number => wideMetrics.value.artColumnPx);
const wideLeftContentStyle = computed((): string => "width:" + wideArtColumnPx.value + "px;height:" + wideMetrics.value.leftContentHeightPx + "px;");
const wideArtPx = computed((): number => wideMetrics.value.coverCardPx);
const wideArtStyle = computed((): string => "width:" + wideArtPx.value + "px;height:" + wideArtPx.value + "px;");
const wideVinylLabelStyle = computed((): string => "width:" + wideArtPx.value * 0.56 + "px;height:" + wideArtPx.value * 0.56 + "px;border-radius:" + wideArtPx.value * 0.28 + "px;");
function vinylRingStyle(inset: number): string {
  const offset = wideArtPx.value * inset;
  return "left:" + offset + "px;top:" + offset + "px;right:" + offset + "px;bottom:" + offset + "px;border-radius:" + wideArtPx.value / 2 + "px;";
}
const wideFocusHeight = computed((): number => Math.max(0, wideMetrics.value.bodyHeightPx - wideMetrics.value.lyricHeightPx - wideMetrics.value.lyricMarginPx));
const compactFocusHeight = computed((): number => portraitMetrics.value.focusHeightPx);
const compactLyricToolsStyle = computed((): string => "height:" + Math.max(tv.enabled ? qtTvTokens().controlPx : 44, Math.ceil(22 * portraitUnit.value * fontScale.scale * 1.4 + 12)) + "px;");
const portraitGalleryStyle = computed((): string => "margin-top:" + portraitMetrics.value.artTopRpx + "rpx;width:" + portraitCoverSizeRpx.value + "rpx;height:" + portraitCoverSizeRpx.value + "rpx;");
const coverFadeStyle = computed<string>(() => qtPerformance.reduceMotion ? "opacity:1;" : "opacity:" + (coverShown.value ? "1" : "0") + ";transition:opacity 0.32s ease-out;");
const sheetSlideStyle = computed<string>(() => qtPerformance.reduceMotion ? "transform:translateY(0);" : "transform:translateY(" + (sheetIn.value ? "0" : "40px") + ");transition:transform 0.24s ease-out;");
/**
 * 播放列表在宽屏走「右侧抽屉」而不是居中弹窗：宽度用 drawer 档（420px），
 * 高度整屏铺满、贴内容区右缘。播放页宽屏本身就是左封面 + 右歌词的双栏，
 * 再居中压一块 560px 会同时遮住两栏，看起来像弹了无关窗口。
 * 居中弹窗（modal 档）留给歌词偏移、搜索歌词这类「短小确认」浮层。
 */
const queueDrawerWideStyle = computed((): string => (layout.isWide ? "width:" + qtSheetWidth("drawer") + "px;" : "") + "height:" + queueMetrics.value.panelHeightPx + "px;padding-bottom:" + layout.safeBottomPx + "px;");
/** 歌词视口当前是否展示：宽屏右侧歌词面板常驻，竖屏看 showLyric。
    歌词的测量与自动跟随滚动一律以此为准 —— 之前错用竖屏的 showLyric 门控，宽屏歌词不跟随、定位错乱。 */
const lyricVisible = computed((): boolean => !immersiveLyrics.value && (layout.isWide || showLyric.value));
/** 经典唱片与专辑画廊都用同一套可滚动完整歌词：手动滚动后点目标行即跳转播放。
    律动 / 纯净歌词是定行沉浸视图（QtFocusLyrics），不参与滚动跳转。 */
const lyricSeekable = computed((): boolean => (playingStyle.style == "classic" || playingStyle.style == "gallery" || tvLyricBrowsing.value) && lyricVisible.value);

/** 桌面歌词开关状态：与 services/desktop-lyric 的真相同步（onShow 里重读一次） */
const lyricOn = ref(desktopLyric.isEnabled());

/**
 * 桌面歌词开关（播放页入口）。
 *
 * 逻辑与 pages/desktop-lyric/index.uvue 的 toggleEnabled 一致，但这里只做「开/关」，
 * 授权引导仍交给设置页（那里有各机型的详细路径文案），避免同一段长文案维护两份。
 * 鸿蒙走系统渲染、不需要悬浮窗权限（hasPermission 恒 true），所以 hasPermission
 * 分支天然只在安卓生效。
 */
function toggleDesktopLyric(): void {
  if (lyricOn.value) {
    desktopLyric.disable();
    lyricOn.value = false;
    qtShowToast({ title: "已关闭桌面歌词", icon: "none" });
    return;
  }
  if (!desktopLyric.hasPermission()) {
    qtConfirm({
      title: "需要悬浮窗权限",
      content: "桌面歌词需要「悬浮窗 / 显示在其他应用上层」权限。\n点「去开启」跳到系统权限页，开启后返回即可再次点击。\n详细机型路径见「设置 → 桌面歌词」。",
      confirmText: "去开启",
    }).then((ok: boolean) => {
      if (!ok) return;
      const opened = desktopLyric.requestPermission();
      if (!opened) {
        qtShowToast({ title: "没能打开系统设置页，请到「权限管理 → 悬浮窗」手动开启", icon: "none" });
      }
    });
    return;
  }
  const ok = desktopLyric.enable();
  lyricOn.value = desktopLyric.isEnabled();
  if (!ok) {
    qtShowToast({
      title: isHarmonyOs() ? "当前系统不支持桌面歌词" : "开启失败，请重试",
      icon: "none",
    });
  }
}
// 内联尺寸统一收敛：宽屏下用绝对 px（rpx 在宽屏会被放大 2.7 倍），手机端保持 rpx
const navStyle = computed((): string => {
  // 导航高度必须 = 状态栏(padding-top) + 内容高，否则按钮上下溢出会被 Android 裁掉
  if (!layout.isWide) return "height:" + (statusBarPx() + 52 + tvNavExtraPx.value) + "px;padding-top:" + statusBarPx() + "px;";
  const sb = statusBarPx();
  // 带文字的三个入口共用 52px 导航占位，必须与 wideMetrics.padTopPx 同步。
  return "height:" + (sb + 52 + tvNavExtraPx.value) + "px;padding-top:" + sb + "px;";
});
/** Budget the song/singer/current-lyric rows and fixed controls first; only the disc can shrink. */
const portraitUnit = computed((): number => Math.max(layout.windowWidth, 1) / 750);
const portraitStageStyle = computed((): string => "margin-bottom:" + layout.safeBottomPx + "px;padding-top:" + portraitMetrics.value.padTopPx + "px;padding-bottom:" + portraitMetrics.value.padBottomPx + "px;padding-left:" + portraitMetrics.value.padSidePx + "px;padding-right:" + portraitMetrics.value.padSidePx + "px;");
const portraitMetrics = computed(() => {
  const oldToolsHeight = Math.max(44, Math.ceil(22 * portraitUnit.value * fontScale.scale * 1.4 + 12));
  const toolsExtra = tv.enabled ? Math.max(0, qtTvTokens().controlPx - oldToolsHeight) : 0;
  const result = portraitPlayerMetrics(layout.paneWidth, Math.max(0, layout.paneHeight - tvNavExtraPx.value - toolsExtra), statusBarPx(),
    layout.safeBottomPx, fontScale.scale, layout.windowWidth, playbackSourceLabel.value,
    tv.enabled && tvCoverShown.value ? "gallery" : playingStyle.style, name(), artistText());
  return { ...result, padTopPx: result.padTopPx + tvNavExtraPx.value };
});
const portraitCoverSizeRpx = computed((): number => portraitMetrics.value.discRpx);
const portraitTurntable = computed(() => turntableMetrics(portraitCoverSizeRpx.value));
const portraitTurntableStyles = computed(() => turntableStyles(portraitTurntable.value, portraitUnit.value));
const portraitTrackStyle = computed((): string => "margin-top:" + portraitMetrics.value.trackTopRpx + "rpx;margin-bottom:" + portraitMetrics.value.trackBottomRpx + "rpx;");
const portraitLyricRowStyle = computed((): string => "height:" + portraitMetrics.value.lyricRowPx + "px;");
const portraitLyricWidthPx = computed((): number => Math.max(0, portraitMetrics.value.trackWidthPx - 24));
/** 本次播放是不是本地文件：本地曲库歌，或在线歌被本地优先命中（下载账本/曲库扫描）。
 *  命中发生在原生层取链回调里，比切歌那一帧晚——localFirstUsed 是普通 Map，
 *  computed 追踪不到它，必须读 store 的版本号 localFirstTick 建立响应式依赖。 */
const playingLocalFile = computed((): boolean => {
  const cur = player.current;
  if (cur == null) return false;
  const tick = player.localFirstTick;
  if (tick < 0) return false;
  return cur.platform == "local" || player.localFirstPathOf(cur).length > 0;
});
const playingPodcast = computed((): boolean => player.current != null && player.current.platform == "podcast");
const playbackRequestedQuality = computed((): string => {
  const tick = playbackMetadataTick.value;
  const generation = sourceRegistry.qualityGeneration;
  const current = player.current;
  if (current == null || tick < 0 || generation < 0) return "";
  return player.effQualityOf(current);
});
const playbackInfo = computed(() => {
  const tick = playbackMetadataTick.value;
  const current = player.current;
  return current == null || tick < 0 ? null : musicApi.playbackInfoOf(current, playbackRequestedQuality.value, player.resolvedUrlOf(current));
});
const playbackSourceId = computed((): string => playingLocalFile.value ? "local" : playbackInfo.value?.source.platform ?? "");
const playbackQualityId = computed((): string => {
  return playingLocalFile.value || playingPodcast.value ? "" : playbackInfo.value?.quality ?? "";
});
function playbackQualityLabel(source: string, quality: string): string {
  const list = sourceRegistry.sourceQualities(source);
  const match = list.find(item => item.id == quality) ?? sourceRegistry.qualities.find(item => item.id == quality);
  return match != null ? match.name : quality;
}
/**
 * 来源胶囊文案（用户 m15536：原「网易云音乐 · 母带 24bit」太长，占掉半个行）。
 * 平台名用注册表短名（网易/QQ/酷狗…），音质去掉内部空格（母带 24bit → 母带24bit），
 * 中间点不再加两侧空格；信息不丢，宽度明显收窄。
 */
const playbackSourceLabel = computed((): string => {
  if (player.current == null) return "播放来源";
  if (playingLocalFile.value) return "本地";
  if (playingPodcast.value) return "播客";
  let label = platformShort(playbackSourceId.value);
  if (label.length == 0 || label == "未知") label = platformLabel(playbackSourceId.value);
  const quality = playbackQualityLabel(playbackSourceId.value, playbackQualityId.value).split(" ").join("");
  return label + (quality.length > 0 ? "·" + quality : "");
});
/** 歌词页标题第二行要「平台 + 音质全称、不滚动」，这里用全名而不是上面的短名。 */
const playbackSourceLabelFull = computed((): string => {
  if (player.current == null) return "播放来源";
  if (playingLocalFile.value) return "本地文件";
  if (playingPodcast.value) return "播客音频";
  const label = platformLabel(playbackSourceId.value);
  const quality = playbackQualityLabel(playbackSourceId.value, playbackQualityId.value);
  return label + (quality.length > 0 ? " · " + quality : "");
});
const playbackFileText = computed((): string => {
  const details = bitrateKbps.value > 0 ? "实测码率 " + bitrateKbps.value + " kbps" : "";
  return details;
});
/** Native material images share one canvas; the rotating wrapper is record-sized and centered. */
const portraitDiscWrapStyle = computed((): string => portraitTurntableStyles.value.canvasSize + "position:relative;align-self:center;margin-top:" + (portraitMetrics.value.artTopRpx * portraitUnit.value).toFixed(2) + "px;");
const portraitDiscPlateStyle = computed((): string => portraitTurntableStyles.value.plate + "background-color:" + theme.skin.coverPlaceholder + ";");
const portraitDiscImgStyle = computed((): string => portraitTurntableStyles.value.cover);
/* 唱片慢转（2026-11 美化，用户 m18202）：播放中转、暂停即停，真实黑胶只有唱臂静止。
   animate API 与 qt-marquee.uvue 同款（UniElement.animate，项目内已验证），
   cancel 即停；恢复时重开一轮（角度归零，视觉差异可忽略）。
   切到歌词视图时唱片 v-if 卸载，返回后按 playing 状态补启动。 */
const discSpinRef = ref<UniElement | null>(null);
let discSpinAnim: UniAnimation | null = null;
/* 转动状态仅用于切换原生动画与静止 transform；隐藏/卸载时统一取消动画。
   这不是旧文字重影原因的运行时证明。 */
const discSpinActive = ref(false);
function stopDiscSpin(): void {
  if (discSpinAnim != null) {
    try {
      discSpinAnim!.cancel();
    } catch (e) {
      // 静默：自然结束的动画再 cancel 抛异常属正常
    }
  }
  discSpinAnim = null;
  discSpinActive.value = false;
}
function startDiscSpin(): void {
  if (discSpinAnim != null) return;
  const el = discSpinRef.value;
  if (el == null) return;
  try {
    discSpinAnim = el.animate(
      [{ transform: "rotate(0deg)" }, { transform: "rotate(360deg)" }],
      { duration: 16000, iterations: Infinity, easing: "linear" }
    );
    discSpinActive.value = true;
  } catch (e) {
    // 静默：个别基座不支持动画时盘面静止即可，不影响功能
    discSpinAnim = null;
    discSpinActive.value = false;
  }
}
/* 转动中留空（transform 交给 animate 驱动），停转时强制归零 —— 见 stopDiscSpin 注释 */
const discSpinStyle = computed((): string => (discSpinActive.value ? "" : "transform:none;"));
function syncDiscSpin(): void {
  if (!qtPerformance.reduceMotion && pageVisible.value && player.playing && playingStyle.style == "classic" && (layout.isWide || !showLyric.value)) startDiscSpin();
  else stopDiscSpin();
}
// A mode/ref replacement must cancel the old node before starting the new record.
watch(discSpinRef, () => {
  stopDiscSpin();
  nextTick(() => syncDiscSpin());
});
watch(() => layout.isWide, () => {
  stopDiscSpin();
  nextTick(() => syncDiscSpin());
});
watch(() => player.playing, () => syncDiscSpin());
watch(() => qtPerformance.reduceMotion, () => syncDiscSpin());
watch(showLyric, () => {
  nextTick(() => syncDiscSpin());
});
onMounted(() => {
  nextTick(() => syncDiscSpin());
});
// （歌词预览区已删：previewGapStyle/previewFontStyle/previewTrFontStyle 一并移除，用户 m16808。）
// 竖屏歌词视口同样要避开导航（导航底 = 状态栏 + 96rpx，舞台 padding 只有 96rpx）
const portraitLyricStyle = computed((): string => "margin-top:8px;");
function statusBarPx(): number {
  if (layout.paneTop > 0) return 0;
  try {
    const info = uni.getWindowInfo();
    return Math.round(info.statusBarHeight > 0 ? info.statusBarHeight : 0);
  } catch (_) {
    return 0;
  }
}
const queueMetrics = computed(() => playerQueueMetrics(layout.paneWidth, layout.paneHeight, layout.isWide, layout.safeBottomPx, fontScale.scale, layout.windowWidth));
const queueViewportPx = computed((): number => queueViewportMeasuredPx.value > 0 ? queueViewportMeasuredPx.value : queueMetrics.value.viewportPx);
const queueRowStyle = computed((): string => "height:" + queueMetrics.value.stridePx + "px;");
function queueStridePx(): number { return queueMetrics.value.stridePx; }
/** Same geometry as the row height and absolute tops, including same-isWide width/font changes. */
const queueContentHeight = computed((): number => Math.ceil(player.queue.length * queueMetrics.value.stridePx));

function captureQueueAnchor(): void {
  const stride = queueStridePx();
  queueAnchorIndex = Math.max(0, Math.min(player.queue.length - 1, Math.floor(queueScrollValue.value / stride)));
  const song = player.queue[queueAnchorIndex];
  syncQueueOccurrences();
  queueAnchorKey = song == null ? "" : queueOccurrences[queueAnchorIndex].key;
  queueAnchorFraction = Math.max(0, Math.min(1, queueScrollValue.value / stride - queueAnchorIndex));
}
/** Re-publish unchanged commands only after content has committed; old ticks cannot win. */
function publishQueueScroll(target: number, replay: boolean = false): void {
  // Current-index and queue-array watchers can converge in one flush at a clamped tail.
  // Preserve the same pending target instead of canceling its not-yet-committed 1px bump.
  if (queueOpen.value && queueScrollPendingSeq == queueScrollSeq && queueScrollPendingTarget == target) return;
  const seq = ++queueScrollSeq;
  const measureSeq = queueMeasureSeq;
  queueScrollPendingSeq = -1;
  queueScrollPendingTarget = -1;
  if (!replay || !queueOpen.value || queueScrollTop.value != target) {
    queueScrollTop.value = target;
    return;
  }
  // Integer pixels survive native rounding, including an already clamped last-row target.
  queueScrollPendingSeq = seq;
  queueScrollPendingTarget = target;
  queueScrollTop.value = target > 0 ? Math.max(0, target - 1) : 1;
  nextTick(() => {
    if (!pageAlive || !queueOpen.value || seq != queueScrollSeq || measureSeq != queueMeasureSeq) return;
    queueScrollPendingSeq = -1;
    queueScrollPendingTarget = -1;
    queueScrollTop.value = target;
  });
}
function restoreQueueAnchor(): void {
  syncQueueOccurrences();
  const keys = queueOccurrences.map((entry: QueueOccurrence): string => entry.key);
  const target = playerQueueAnchorScroll(keys, queueAnchorKey, queueAnchorIndex, queueAnchorFraction, queueStridePx(), queueViewportPx.value);
  queueScrollValue.value = target;
  rebuildQueueWindow();
  publishQueueScroll(target);
}
/** Only render the actual viewport plus the existing overscan margin. Every rebuild refreshes row.top. */
function rebuildQueueWindow(): void {
  syncQueueOccurrences();
  const queue = player.queue;
  const stride = queueStridePx();
  const window = playerQueueWindow(queue.length, stride, queueViewportPx.value, queueScrollValue.value, QUEUE_WINDOW_MARGIN);
  if (window.scrollPx != queueScrollValue.value) {
    queueScrollValue.value = window.scrollPx;
    queueScrollTop.value = window.scrollPx;
  }
  const rows: QueueRow[] = [];
  for (let i = window.first; i <= window.last; i++) {
    const song = queue[i];
    if (song == null) continue;
    rows.push({ index: i, song: song, key: queueOccurrences[i].key, songKey: song.platform + ":" + song.id, top: Math.round(i * stride) });
  }
  queueWindow.value = rows;
  captureQueueAnchor();
}
function measureQueueViewport(seq: number, attempt: number = 0, touchSeq: number = queueTouchSeq): void {
  if (!pageAlive || !queueOpen.value || seq != queueMeasureSeq) return;
  uni.createSelectorQuery().select(".queue-list-viewport").boundingClientRect((rect: UniNodeInfo) => {
    if (!pageAlive || !queueOpen.value || seq != queueMeasureSeq) return;
    if (rect != null && isFinite(rect.height) && rect.height > 0) {
      queueViewportMeasuredPx.value = rect.height;
      if (touchSeq != queueTouchSeq) {
        // A late layout reply may update geometry, never seize a gesture that began later.
        rebuildQueueWindow();
        return;
      }
      let target = queueScrollValue.value;
      if (queueOpeningIndex >= 0) {
        target = playerQueueWindow(player.queue.length, queueStridePx(), queueViewportPx.value, queueOpeningIndex * queueStridePx(), 0).scrollPx;
      } else {
        syncQueueOccurrences();
        const keys = queueOccurrences.map((entry: QueueOccurrence): string => entry.key);
        target = playerQueueAnchorScroll(keys, queueAnchorKey, queueAnchorIndex, queueAnchorFraction, queueStridePx(), queueViewportPx.value);
