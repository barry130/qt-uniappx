<template>
  <qt-page-frame width-kind="detail">
  <view class="page">
    <scroll-view class="scroll" direction="vertical" :scroll-top="scrollTop" @scroll="onListScroll">
      <!-- 紧凑报告封面，说明从右上角展开；底图显式绑定像素宽度。 -->
      <view id="stats-hero" class="hero" :class="layout.isWide ? 'hero-wide' : ''" :style="'background-color:' + heroBaseColor + ';'">
        <image
          v-if="heroCover != ''"
          class="hero-bg"
          :style="'width:' + heroBgWidth + 'px;height:' + heroBgHeight + 'px;'"
          :src="heroCover" mode="aspectFill"
        />
        <view v-if="heroCover != ''" class="hero-scrim" :style="'width:' + heroBgWidth + 'px;height:' + heroBgHeight + 'px;'"></view>
        <view class="hero-body">
          <view class="hero-toolbar">
            <text :style="('color:' + heroMutedColor + ';') + qtFontDual(21, 12)">全部听歌记录</text>
            <view class="report-help" @click="openDetail('info', '')">
              <text :style="('color:' + heroMutedColor + ';') + qtFontDual(21, 12)">统计说明</text>
              <QtIcon name="chevron-right" :size="layout.isWide ? 14 : 22" :color="heroMutedColor" />
            </view>
          </view>
          <text class="hero-title" :style="('color:' + heroTitleColor + ';') + qtFontDual(58, 32)">听歌报告</text>
          <text class="hero-sub" :style="('color:' + heroMutedColor + ';') + qtFontDual(24, 13)">{{ heroSub }}</text>
          <view class="hero-tag" :style="'background-color:' + heroTagBg + ';'">
            <text class="hero-tag-text" :style="('color:' + heroTitleColor + ';') + qtFontDual(21, 12)">{{ heroTag }}</text>
          </view>
        </view>
      </view>

      <view class="duration-card" :class="layout.isWide ? 'duration-card-wide' : ''" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';'">
        <view class="duration-heading">
          <QtIcon name="clock" :size="layout.isWide ? 18 : 30" :color="themeStore.skin.accent" />
          <text class="duration-label" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(24, 14)">累计播放时长</text>
        </view>
        <view class="duration-line">
          <text class="duration-number" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(60, 34)">{{ durationValue(stats.totalSeconds) }}</text>
          <text class="duration-unit" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(24, 14)">{{ durationUnit(stats.totalSeconds) }}</text>
        </view>
        <text class="duration-note" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(20, 12)">按实际收听累计，未播完也计入</text>
        <view class="storage-status" @click="openDetail('info', '')">
          <text class="storage-text" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(20, 12)">{{ storageLabel }}</text>
          <QtIcon name="chevron-right" :size="layout.isWide ? 14 : 22" :color="themeStore.skin.textSubtle" />
        </view>
      </view>

      <!-- 数据带：一排四格（图标 + 标签 / 大数字 / 小注），格间用 divider 竖线分隔 -->
      <view
        class="band" :class="layout.isWide ? 'band-wide' : ''"
        :style="('background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';')"
      >
        <view class="stat-cell stat-cell-r" :class="layout.isWide ? 'stat-cell-wide' : ''" :style="'border-color:' + themeStore.skin.divider + ';'">
          <view class="stat-top">
            <QtIcon name="play" :size="layout.isWide ? 14 : 22" :color="themeStore.skin.accent" />
            <text class="stat-label" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(20, 12)">累计播放</text>
          </view>
          <text class="stat-num" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(40, 22)">{{ formatCount(totalPlayed) }}</text>
          <text class="stat-note" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(18, 11)">全部次数</text>
        </view>
        <view class="stat-cell stat-cell-r" :class="layout.isWide ? 'stat-cell-wide' : ''" :style="'border-color:' + themeStore.skin.divider + ';'">
          <view class="stat-top">
            <QtIcon name="heart" :size="layout.isWide ? 14 : 22" :color="themeStore.skin.accent" />
            <text class="stat-label" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(20, 12)">收藏歌曲</text>
          </view>
          <text class="stat-num" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(40, 22)">{{ formatCount(likedCount) }}</text>
          <text class="stat-note" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(18, 11)">本地歌单</text>
        </view>
        <view class="stat-cell stat-cell-r" :class="layout.isWide ? 'stat-cell-wide' : ''" :style="'border-color:' + themeStore.skin.divider + ';'">
          <view class="stat-top">
            <QtIcon name="list" :size="layout.isWide ? 14 : 22" :color="themeStore.skin.accent" />
            <text class="stat-label" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(20, 12)">听过歌曲</text>
          </view>
          <text class="stat-num" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(40, 22)">{{ formatCount(historyCount) }}</text>
          <text class="stat-note" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(18, 11)">去重统计</text>
        </view>
        <view class="stat-cell" :class="layout.isWide ? 'stat-cell-wide' : ''">
          <view class="stat-top">
            <QtIcon name="mic" :size="layout.isWide ? 14 : 22" :color="themeStore.skin.accent" />
            <text class="stat-label" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(20, 12)">常听歌手</text>
          </view>
          <text class="stat-num" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(40, 22)">{{ formatCount(artistTotal) }}</text>
          <text class="stat-note" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(18, 11)">音乐宇宙</text>
        </view>
      </view>

      <!-- 日榜：只统计今天/近 7 天/近 30 天，与下面几张「累计 Top 5」口径不同，所以单独一张卡。
           三个标签都很短，用等分宽度的 segmented 正好一屏放下。 -->
      <view
        v-if="historyCount > 0"
        class="block daily-card" :class="layout.isWide ? 'block-wide' : ''"
        :style="('background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';')"
      >
        <view class="block-head">
          <QtIcon name="trending" :size="layout.isWide ? 15 : 24" :color="themeStore.skin.accent" />
          <text class="block-title" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(26, 15)">{{ dailyTitle }}</text>
          <view class="block-fill"></view>
          <text class="daily-note" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(19, 11)">历史自动归档</text>
        </view>
        <view class="daily-seg" :class="layout.isWide ? 'daily-seg-wide' : ''">
          <qt-segmented :list="dailyLabels" v-model="dailyIndex" />
        </view>
        <view class="daily-kinds">
          <view
            v-for="(label, index) in dailyKindLabels"
            :key="label"
            class="daily-kind" :class="layout.isWide ? 'daily-kind-wide' : ''" :hover-class="layout.isWide ? 'daily-kind-hover' : 'none'"
            :style="('background-color:' + (dailyKind == dailyKindKeys[index] ? themeStore.skin.surfaceMuted : 'transparent') + ';')"
            @click="pickDailyKind(dailyKindKeys[index])"
          >
            <text :style="('color:' + (dailyKind == dailyKindKeys[index] ? themeStore.skin.accent : themeStore.skin.textSubtle) + ';') + qtFontDual(21, 12)">{{ label }}</text>
          </view>
        </view>
        <text class="daily-summary" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(21, 12)">{{ dailySummary }}</text>
        <view v-if="dailyRows.length == 0" class="daily-empty">
          <text :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(21, 12)">{{ dailyEmptyText }}</text>
        </view>
        <view
          v-for="(item, index) in dailyRows"
          :key="item.id"
          class="song-row" :class="layout.isWide ? 'song-row-wide' : ''" :hover-class="layout.isWide ? 'song-row-hover' : 'none'"
          @click="openDailyRow(item)"
        >
          <text class="song-rank" :class="layout.isWide ? 'song-rank-wide' : ''" :style="rankStyle(index)">{{ index + 1 }}</text>
          <image
            v-if="dailyKind == 'songs' && item.song != null"
            class="song-cover" :class="layout.isWide ? 'song-cover-wide' : ''"
            :style="'background-color:' + themeStore.skin.coverPlaceholder + ';'"
            :src="item.song.picUrl" mode="aspectFill"
          />
          <view v-else-if="dailyKind == 'sources'" class="source-badge" :class="layout.isWide ? 'source-badge-wide' : ''" :style="'background-color:' + themeStore.skin.surfaceMuted + ';'">
            <image v-if="sourceIcon(item.id) != ''" style="width:60%;height:60%;" :src="sourceIcon(item.id)" mode="aspectFit" />
            <text v-else :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(22, 12)">{{ artistInitial(item.name) }}</text>
          </view>
          <image
            v-else-if="artistPic(item.name) != ''"
            class="artist-avatar" :class="layout.isWide ? 'artist-avatar-wide' : ''"
            :style="'background-color:' + themeStore.skin.surfaceMuted + ';'"
            :src="artistPic(item.name)" mode="aspectFill"
            @error="artistImageError(item.name)"
          />
          <view v-else class="artist-avatar" :class="layout.isWide ? 'artist-avatar-wide' : ''" :style="'background-color:' + themeStore.skin.surfaceMuted + ';'">
            <text class="artist-initial" :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(26, 14)">{{ artistInitial(item.name) }}</text>
          </view>
          <view class="song-info" :class="layout.isWide ? 'song-info-wide' : ''">
            <text class="song-name" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(25, 14)" :max-lines="1">{{ item.name }}</text>
            <text class="song-meta" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(20, 11)" :max-lines="1">{{ dailyMeta(item) }}</text>
          </view>
          <text class="song-count" :class="layout.isWide ? 'song-count-wide' : ''" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(20, 11)">{{ item.count }} 次</text>
        </view>
      </view>

      <!-- 没有记录时的空态 -->
      <view
        v-if="historyCount == 0"
        class="block empty" :class="layout.isWide ? 'block-wide' : ''"
        :style="('background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';')"
      >
        <QtIcon name="music" :size="layout.isWide ? 28 : 48" :color="themeStore.skin.textSubtle" />
        <text class="empty-title" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(28, 16)">还没有听歌记录</text>
        <text class="empty-sub" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(22, 13)">去发现页随便点一首，报告就会慢慢长出来</text>
      </view>

      <!-- 三张 Top 5 卡排成一排横向滑动：卡宽按窗口算（一屏露出一张多一点，
           右边留着下一张的头提示能滑），三张卡共用同一行高，整排不会高低不齐。
           横向 scroll-view 的内容行在原生端不会自动撑开，必须显式给 px 宽度。 -->
      <scroll-view
        v-if="historyCount > 0"
        class="top-scroll" :class="layout.isWide ? 'top-scroll-wide' : ''"
        direction="horizontal" :show-scrollbar="false"
        :style="'height:' + topRowHeightPx + 'px;'"
      >
        <view class="top-row" :class="layout.isWide ? 'top-row-wide' : ''" :style="'width:' + topRowWidth + 'px;'">
          <!-- Top 5 歌曲 -->
          <view
            v-if="topSongs.length > 0"
            class="top-card" :class="layout.isWide ? 'top-card-wide' : ''"
            :style="('width:' + topCardWidth + 'px;background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';')"
          >
          <view class="block-head">
            <QtIcon name="trending" :size="layout.isWide ? 15 : 24" :color="themeStore.skin.accent" />
            <text class="block-title" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(26, 15)">Top 5 歌曲</text>
            <view class="block-fill"></view>
            <view class="report-link" @click="openDetail('songs', '')"><text :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(21, 12)">全部</text><QtIcon name="chevron-right" :size="layout.isWide ? 14 : 22" :color="themeStore.skin.accent" /></view>
          </view>
          <view
            v-for="(item, index) in topSongs"
            :key="item.song.id + item.song.platform"
            class="song-row" :class="layout.isWide ? 'song-row-wide' : ''" :hover-class="layout.isWide ? 'song-row-hover' : 'none'"
            @click="openDetail('songs', reportSongKey(item.song))"
          >
            <text class="song-rank" :class="layout.isWide ? 'song-rank-wide' : ''" :style="rankStyle(index)">{{ index + 1 }}</text>
            <image
              class="song-cover" :class="layout.isWide ? 'song-cover-wide' : ''"
              :style="'background-color:' + themeStore.skin.coverPlaceholder + ';'"
              :src="item.song.picUrl" mode="aspectFill"
            />
            <view class="song-info" :class="layout.isWide ? 'song-info-wide' : ''">
              <text class="song-name" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(25, 14)" :max-lines="1">{{ item.song.name }}</text>
              <text class="song-meta" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(20, 11)" :max-lines="1">{{ item.song.singer }} · {{ reportDuration(item.seconds) }}</text>
            </view>
            <text class="song-count" :class="layout.isWide ? 'song-count-wide' : ''" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(20, 11)">{{ item.count }} 次</text>
          </view>
        </view>

          <!-- Top 5 歌手 -->
          <view
            v-if="topArtists.length > 0"
            class="top-card" :class="layout.isWide ? 'top-card-wide' : ''"
            :style="('width:' + topCardWidth + 'px;background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';')"
          >
            <view class="block-head">
              <QtIcon name="mic" :size="layout.isWide ? 15 : 24" :color="themeStore.skin.accent" />
              <text class="block-title" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(26, 15)">Top 5 歌手</text>
              <view class="block-fill"></view>
              <view class="report-link" @click="openDetail('artists', '')"><text :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(21, 12)">全部</text><QtIcon name="chevron-right" :size="layout.isWide ? 14 : 22" :color="themeStore.skin.accent" /></view>
          </view>
            <view
              v-for="(item, index) in topArtists"
              :key="item.name"
              @click="openDetail('artists', item.name)"
              class="song-row" :class="layout.isWide ? 'song-row-wide' : ''" :hover-class="layout.isWide ? 'song-row-hover' : 'none'"
            >
              <text class="song-rank" :class="layout.isWide ? 'song-rank-wide' : ''" :style="rankStyle(index)">{{ index + 1 }}</text>
              <image v-if="artistPic(item.name) != ''" class="artist-avatar" :class="layout.isWide ? 'artist-avatar-wide' : ''" :src="artistPic(item.name)" mode="aspectFill" @error="artistImageError(item.name)" />
              <view v-else
                class="artist-avatar" :class="layout.isWide ? 'artist-avatar-wide' : ''"
                :style="'background-color:' + themeStore.skin.accentSoft + ';'"
              >
                <text class="artist-initial" :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(26, 14)">{{ artistInitial(item.name) }}</text>
              </view>
              <view class="song-info" :class="layout.isWide ? 'song-info-wide' : ''">
                <text class="song-name" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(25, 14)" :max-lines="1">{{ item.name }}</text>
                <text class="song-meta" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(20, 11)">{{ item.count }} 次 · {{ reportDuration(item.seconds) }}</text>
              </view>
            </view>
          </view>

          <!-- Top 5 音源：占比来自播放记录里每首歌的 platform，名字走音源注册表 -->
          <view
            v-if="prefRows.length > 0"
            class="top-card" :class="layout.isWide ? 'top-card-wide' : ''"
            :style="('width:' + topCardWidth + 'px;background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';')"
          >
            <view class="block-head">
              <QtIcon name="disc" :size="layout.isWide ? 15 : 24" :color="themeStore.skin.accent" />
              <text class="block-title" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(26, 15)">Top 5 音源</text>
              <view class="block-fill"></view>
              <view class="report-link" @click="openDetail('sources', '')"><text :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(21, 12)">全部</text><QtIcon name="chevron-right" :size="layout.isWide ? 14 : 22" :color="themeStore.skin.accent" /></view>
          </view>
            <view
              v-for="(item, index) in topSources"
              :key="item.id"
              @click="openDetail('sources', item.id)"
              class="song-row" :class="layout.isWide ? 'song-row-wide' : ''" :hover-class="layout.isWide ? 'song-row-hover' : 'none'"
            >
              <text class="song-rank" :class="layout.isWide ? 'song-rank-wide' : ''" :style="rankStyle(index)">{{ index + 1 }}</text>
              <image v-if="sourceIcon(item.id) != ''" class="source-badge" :class="layout.isWide ? 'source-badge-wide' : ''" :src="sourceIcon(item.id)" mode="aspectFit" />
              <view v-else
                class="source-badge" :class="layout.isWide ? 'source-badge-wide' : ''"
                :style="'background-color:' + item.color + ';'"
              >
                <QtIcon name="disc" :size="layout.isWide ? 14 : 22" color="#ffffff" />
              </view>
              <view class="song-info" :class="layout.isWide ? 'song-info-wide' : ''">
                <text class="song-name" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(25, 14)" :max-lines="1">{{ item.name }}</text>
                <text class="song-meta" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(20, 11)">{{ item.pct }}% · {{ item.count }} 次</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view class="pad" :class="layout.isWide ? 'pad-wide' : ''"></view>
    </scroll-view>
    <QtBackToTop :visible="showBackToTop" @tap="backToTop" />
  </view>
    <QtListenDetail v-if="detailKind != ''" :kind="detailKind" :target="detailTarget" :loading-key="loadingKey" @close="closeDetail" @play="playSong" />
  </qt-page-frame>
</template>
<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import { computed, ref, watch } from "vue";
import { onShow, onBackPress } from "@dcloudio/uni-app";
import { useListenStatsStore } from "@/stores/listen-stats";
import QtBackToTop from "@/uni_modules/qt-ui/components/qt-back-to-top/qt-back-to-top.uvue";
import { usePlayerStore } from "@/stores/player";
import { useThemeStore, qtOnAccentRgba } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtContentWidth } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { useSourceRegistryStore } from "@/stores/source-registry";
import { musicApi } from "@/services/music-api";
import { formatBigCount } from "@/services/format";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import type { Song } from "@/types/music";
import QtListenDetail from "@/uni_modules/qt-ui/components/qt-listen-detail/qt-listen-detail.uvue";
import { reportEntries, reportDuration, reportSongKey, reportDayEntries, type ReportEntry } from "@/services/listen-report";
import { listenDayKey, listenDayWindow } from "@/stores/listen-stats";
import QtSegmented from "@/uni_modules/qt-ui/components/qt-segmented/qt-segmented.uvue";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";

const player = usePlayerStore();
const stats = useListenStatsStore();
const failedArtists = ref<string[]>([]);
const detailKind = ref("");
const detailTarget = ref("");
const loadingKey = ref("");
function openDetail(kind: string, target: string): void { detailKind.value = kind; detailTarget.value = target; }
function closeDetail(): void { detailKind.value = ""; detailTarget.value = ""; }
onBackPress((): boolean => { if (detailKind.value == "") return false; closeDetail(); return true; });
onShow(() => {
  // 回页重量 hero 实高：改完字号/旋转后回来底图要跟上新高度
  measureHeroHeight();
  stats.load(player.history, player.playCounts).then(async () => {
    await stats.flush();
    // 近 30 天可能已经有一部分日子被备份进文件，进页面先把窗口补齐再渲染。
    await stats.ensureDays(dailyWindowKeysAll.value);
    // 升级后已有的 Top 5 同样补头像，避免必须再播一次才显示。
    for (let i = 0; i < topArtists.value.length; i++) {
      const name = topArtists.value[i].name;
      for (let j = 0; j < stats.songs.length; j++) {
        if (stats.songs[j].song.singer == name) { await stats.ensureArtistPic(stats.songs[j].song); break; }
      }
    }
    // 日榜「常听歌手」同理：进页面就补，不必等用户切换时间档。
    ensureDailyArtistPics();
  });
});
function artistPic(name: string): string {
  return failedArtists.value.indexOf(name) >= 0 ? "" : stats.artistPic(name);
}
function artistImageError(name: string): void {
  if (failedArtists.value.indexOf(name) < 0) failedArtists.value.push(name);
}
function sourceIcon(id: string): string {
  if (["wyy", "qq", "kw", "kg", "bili"].indexOf(id) >= 0) return "/static/source/" + id + ".png";
  return "";
}
function durationValue(seconds: number): string {
  if (seconds >= 3600) return "" + Math.floor(seconds / 3600);
  if (seconds >= 60) return "" + Math.floor(seconds / 60);
  return "" + Math.floor(seconds);
}
function durationUnit(seconds: number): string {
  if (seconds >= 3600) return "小时 " + Math.floor((seconds % 3600) / 60) + " 分";
  return seconds >= 60 ? "分钟" : "秒";
}
const themeStore = useThemeStore();
const layout = useQtLayout();
const sourceRegistry = useSourceRegistryStore();

// 回到顶部
const scrollTop = ref(0);
const showBackToTop = ref(false);
function onListScroll(e: any) {
  const st = e.detail != null ? Number(e.detail.scrollTop ?? 0) : 0;
  showBackToTop.value = st > 600;
}
function backToTop() {
  scrollTop.value = scrollTop.value == 0 ? 1 : 0;
  showBackToTop.value = false;
}

// 2026-10-19 起全站大数字统一走 services/format.ts（亿/万两档），不再各自换算
const formatCount = formatBigCount;

/** 暂无歌手头像或图片加载失败时，用名字首字占位。 */
function artistInitial(name: string): string {
  if (name.length == 0) return "?";
  return name.substring(0, 1);
}

/** 名次配色：前三用主色，其余用弱化色 */
function rankStyle(index: number): string {
  const color = index < 3 ? themeStore.skin.accent : themeStore.skin.textSubtle;
  return "color:" + color + ";" + qtFontDual(30, 16);
}

// 收藏总数 = 收藏总表里带本地歌单 pid 的歌曲数
const likedCount = computed((): number => {
  let n = 0;
  for (let i = 0; i < player.localPlaylists.length; i++) {
    const pid = player.localPlaylists[i].pid;
    n += player.songsOfPid(pid != null ? pid : "").length;
  }
  return n;
});
const historyCount = computed((): number => stats.songs.length);
const storageLabel = computed((): string => {
  if (!stats.ready) return "正在读取统计存档";
  if (stats.publicSaved) return "公共存档已保存 · 可恢复";
  if (stats.storagePath.length == 0) return "暂存应用目录 · 查看说明";
  return "暂存应用目录 · 待授权迁移";
});
const totalPlayed = computed((): number => {
  let total = 0;
  for (let i = 0; i < stats.songs.length; i++) total += stats.songs[i].count;
  return total;
});

type TopSongEntry = { song: Song; count: number; seconds: number };
type ArtistEntry = { name: string; count: number; seconds: number };
type SourceEntry = { id: string; name: string; count: number };
type PrefEntry = { id: string; name: string; count: number; pct: number; color: string };

// 使用独立统计存档，不受最近播放历史的长度上限或清理操作影响
const topSongs = computed<TopSongEntry[]>(() => reportEntries(stats.songs, "songs", "count").slice(0, 5).map((entry) => ({ song: entry.song!, count: entry.count, seconds: entry.seconds })));
const artistRows = computed<ArtistEntry[]>(() => reportEntries(stats.songs, "artists", "count").map((entry) => ({ name: entry.name, count: entry.count, seconds: entry.seconds })));
const topArtists = computed<ArtistEntry[]>(() => artistRows.value.slice(0, 5));
const artistTotal = computed((): number => artistRows.value.length);

// 听歌来源：按 platform 归并，名字走 sourceRegistry（未加载时回落成音源 id）
const sourceRows = computed<SourceEntry[]>(() => {
  const map = new Map<string, number>();
  for (let i = 0; i < stats.songs.length; i++) {
    const song = stats.songs[i].song;
    if (song == null) continue;
    const id = song.platform;
    if (id == null || id.length == 0) continue;
    const current = map.get(id);
    map.set(id, (current != null ? current : 0) + stats.songs[i].count);
  }
  const pairs: SourceEntry[] = [];
  const keys = Array.from(map.keys());
  for (let i = 0; i < keys.length; i++) {
    const id = keys[i];
    const label = sourceRegistry.label(id);
    const name = label.length > 0 ? label : id.toUpperCase();
    pairs.push({ id, name, count: map.get(id) ?? 0 } as SourceEntry);
  }
  pairs.sort((a, b) => b.count - a.count);
  return pairs;
});

// 分段条配色：与主题无关的中间调，深浅色皮肤下都能分清
const PREF_COLORS = ["#5b8def", "#8b7cf6", "#f0a04b", "#4fc3a1", "#e2607d"];

const prefRows = computed<PrefEntry[]>(() => {
  const list = sourceRows.value;
  let total = 0;
  for (let i = 0; i < list.length; i++) total += list[i].count;
  const rows: PrefEntry[] = [];
  for (let i = 0; i < list.length; i++) {
    const pct = total > 0 ? Math.round((list[i].count / total) * 100) : 0;
    rows.push({
      id: list[i].id,
      name: list[i].name,
      count: list[i].count,
      pct,
      color: PREF_COLORS[i % PREF_COLORS.length],
    } as PrefEntry);
  }
  return rows;
});

// Top 5 音源：按占比取前 5，和歌曲/歌手两张卡同样是 5 行
const topSources = computed<PrefEntry[]>(() => prefRows.value.slice(0, 5));

// 日榜：0 = 今天 / 1 = 近 7 天 / 2 = 近 30 天，三个口径共用同一份按天存档。
// 标签固定三个短词，用等分宽度的 segmented；卡片自身宽度够，不需要 scrollable。
const dailyLabels = ["今天", "近 7 天", "近 30 天"];
const dailyIndex = ref(0);
const dailyKind = ref("songs");
// 三档各自记一份当前看的是歌曲/歌手/音源，来回切档时不会跳回歌曲。
const dailyKinds = ref<string[]>(["songs", "songs", "songs"]);
const dailyWindowsPx = [1, 7, 30];
const dailyKindLabels = ["歌曲", "歌手", "音源"];
const dailyKindKeys = ["songs", "artists", "sources"];
const dailyWindowKeys = computed((): string[] => {
  const count = dailyWindowsPx[dailyIndex.value];
  return listenDayWindow(listenDayKey(Date.now()), count);
});
// 只排除本地起始日之前的残档；已归档的老歌仍算进来，否则会少掉更早那几天。
const dailyWindowKeysAll = computed((): string[] => {
  if (stats.resetAt <= 0) return dailyWindowKeys.value;
  const since = listenDayKey(stats.resetAt);
  const keys: string[] = [];
  for (let i = 0; i < dailyWindowKeys.value.length; i++) if (dailyWindowKeys.value[i] >= since) keys.push(dailyWindowKeys.value[i]);
  return keys;
});
const dailyRowsAll = computed<ReportEntry[]>(() => reportDayEntries(stats.daysIn(dailyWindowKeysAll.value), dailyWindowKeysAll.value, dailyKind.value));
const dailyRows = computed<ReportEntry[]>(() => dailyRowsAll.value.slice(0, 10));
// 汇总只算窗口里真实的播放次数和时长，不受 Top 10 截断影响。
const dailyTotals = computed((): string[] => {
  let count = 0;
  let seconds = 0;
  const keys = dailyWindowKeysAll.value;
  for (let i = 0; i < keys.length; i++) {
    const day = stats.dayAt(keys[i]);
    if (day == null) continue;
    const songKeys = Array.from(day.songs.keys());
    for (let j = 0; j < songKeys.length; j++) {
      const row = day.songs.get(songKeys[j]);
      if (row == null) continue;
      count += row.count;
      seconds += row.seconds;
    }
  }
  return ["" + count, reportDuration(seconds)];
});
const dailySummary = computed((): string => {
  if (dailyRowsAll.value.length == 0) return "";
  return "共 " + dailyTotals.value[0] + " 次播放 · " + dailyTotals.value[1];
});
const dailyEmptyText = computed((): string => "这段时间还没有听歌记录");
const dailyTitle = computed((): string => dailyLabels[dailyIndex.value] + (dailyKind.value == "artists" ? "常听歌手" : dailyKind.value == "sources" ? "常听音源" : "最常播放"));
function dailyMeta(entry: ReportEntry): string {
  if (dailyKind.value == "songs") return (entry.song != null ? entry.song.singer : "") + " · " + reportDuration(entry.seconds);
  if (dailyKind.value == "sources") return entry.tracks + " 首歌 · " + reportDuration(entry.seconds);
  return entry.tracks + " 首歌 · " + reportDuration(entry.seconds);
}
function openDailyRow(entry: ReportEntry): void { openDetail(dailyKind.value, entry.id); }
// 这三个切换点都要写在模板里能取到的地方（<script setup> 顶层即可）。
function pickDailyKind(kind: string): void { dailyKind.value = kind; dailyKinds.value[dailyIndex.value] = kind; }

/**
 * 日榜里的歌手头像。
 *
 * 头像按歌手名存在 artistPics 里，而日榜行只有名字（ReportEntry 的 song 对歌手榜是 null），
 * 所以要回头从累计榜里找一首该歌手的歌，才能交给 ensureArtistPic 去查。
 * 累计榜只按歌曲裁剪、从不按天裁剪，所以即使这天已经归档进备份文件，也仍能在这里找到。
 */
function dailyArtistSong(name: string): Song | null {
  for (let i = 0; i < stats.songs.length; i++) {
    if (stats.songs[i].song.singer == name) return stats.songs[i].song;
  }
  return null;
}
function ensureDailyArtistPics(): void {
  if (dailyKind.value != "artists") return;
  const rows = dailyRowsAll.value;
  for (let i = 0; i < rows.length; i++) {
    const name = rows[i].name;
    if (name.length == 0 || artistPic(name) != "") continue;
    const song = dailyArtistSong(name);
    if (song != null) stats.ensureArtistPic(song);
  }
}
// 切档 / 切歌手标签时补头像：之前只在累计 Top 5 里查过，日榜歌手一直是首字占位。
// 切档同时要把新窗口里被备份掉的日子补读回来，否则近 30 天会只剩最近几天的数据。
watch([dailyIndex, dailyKind], () => {
  stats.ensureDays(dailyWindowKeysAll.value).then(() => { ensureDailyArtistPics(); });
});

// 三张 Top 5 卡共用的尺寸：竖屏卡宽 = 一屏内宽减掉「下一张露头」的那一截，
// 露头量取 52rpx，既能提示可横滑又不会把当前卡挤窄；宽屏三张卡正好并排铺满一行。
// 不能用百分比（父级是横向 scroll-view，百分比会按内容宽度算），必须给 px。
// 宽屏内容列由 qt-page-frame 的连续宽度公式统一给出，见 use-qt-widths.ts。
const topGapPx = computed((): number => layout.isWide ? 16 : Math.round(layout.windowWidth * (16 / 750)));
const topColumnWidth = computed((): number => {
  // 宽屏内容列由框架统一给出（改造前这里写死 min(windowWidth,1360)，与框架的宽度公式对不上，
  // 窗口一超过 1360 三张卡就开始偏左留白）
  if (layout.isWide) return qtContentWidth("detail");
  return layout.windowWidth;
});
const topCardWidth = computed((): number => {
  if (layout.isWide) {
    // 列宽 - 左右 padding 48 - 三张卡各 16 的间距 48
    return Math.max(300, Math.floor((topColumnWidth.value - 96) / 3));
  }
  const win = layout.windowWidth;
  const inner = win - win * (48 / 750);
  return Math.max(180, Math.round(inner - win * (52 / 750)));
});
// 只有真有数据的卡才占位，避免只剩一张卡时行尾拖出一大片空白
const topCardCount = computed((): number => {
  let n = 0;
  if (topSongs.value.length > 0) n++;
  if (topArtists.value.length > 0) n++;
  if (prefRows.value.length > 0) n++;
  return n;
});
const topRowWidth = computed((): number => {
  const n = topCardCount.value > 0 ? topCardCount.value : 1;
  // 小横屏仍横滑，卡片保留可读宽度；大窗口三张并排。
  const padding = layout.isWide ? 48 : layout.windowWidth * (48 / 750);
  return n * (topCardWidth.value + topGapPx.value) + padding;
});
// 横向 scroll-view 在原生端不会按内容撑高，高度必须显式给（同首页歌单架的做法）。
// 竖屏按 CSS rpx 的换算（窗口宽 / 750）折算，宽屏走 -wide 的 px 覆盖值。
const topRowHeightPx = computed((): number => {
  const win = layout.windowWidth;
  if (layout.isWide) return 440;
  // 5 行 × (封面 84rpx + 上下 padding 28rpx) + 标题行 44rpx + 卡内 padding 48rpx + 余量
  return Math.max(Math.round(710 * (win / 750)), 340);
});

// 头部底图：最常播放那首的封面；没有播放记录就不放图，退回 accent 纯色卡
const heroCover = computed((): string => topSongs.value.length > 0 ? topSongs.value[0].song.picUrl : "");
// 底图宽度必须自己算：hero 左右各留 24rpx（不能用 qtRpx，它按 375 基准折算会偏小）；
// 宽屏左右各留 24px，内容列宽由框架统一给出。
const heroBgWidth = computed((): number => {
  const win = layout.windowWidth;
  if (layout.isWide) return qtContentWidth("detail") - 48;
  return Math.round(win - win * (48 / 750));
});
const heroBaseColor = computed((): string => heroCover.value != "" ? "#10141f" : themeStore.skin.accent);
const heroTitleColor = computed((): string => heroCover.value != "" ? "#ffffff" : themeStore.skin.onAccent);
const heroMutedColor = computed((): string => {
  return heroCover.value != "" ? "rgba(255,255,255,0.86)" : qtOnAccentRgba(themeStore.skin, 0.86);
});
const heroTagBg = computed((): string => {
  return heroCover.value != "" ? "rgba(255,255,255,0.18)" : qtOnAccentRgba(themeStore.skin, 0.16);
});
const heroSub = computed((): string => historyCount.value > 0 ? "把听过的歌，重新听一遍" : "还没有开始记录");
const heroTag = computed((): string => "已记录 " + formatCount(historyCount.value) + " 首歌");

// 底图与遮罩要在 Vapor 下铺满整卡：绝对定位的 top+bottom 双锚拉伸与百分比高度都不可靠
// （qt-batch-bar 命中区同款教训），只能给显式像素——宽度按窗口算，高度量一次卡片实高。
const heroBgHeight = ref(0);
let heroMeasureSeq = 0;
function measureHeroHeight(): void {
  if (heroCover.value == "") return;
  const seq = ++heroMeasureSeq;
  uni.createSelectorQuery()
    .select("#stats-hero")
    .boundingClientRect((rect: UniNodeInfo | null) => {
      // 只认最后一次测量：窗口宽度连续变化时，先回来的旧结果直接丢弃
      if (seq != heroMeasureSeq) return;
      if (rect != null && rect.height > 0) heroBgHeight.value = Math.round(rect.height);
    })
    .exec();
}
// 卡片高度由内容行撑出，与封面无关；封面就位后才渲染底图，此刻量准。
watch(heroCover, () => { measureHeroHeight(); });
// 折叠/旋转/分屏改窗口 → hero 宽高都变；进页/回页（含改完字号回来）→ onShow 里量。
watch(() => layout.windowWidth, () => { measureHeroHeight(); });

async function playSong(song: Song): Promise<void> {
  if (loadingKey.value != "") return;
  loadingKey.value = reportSongKey(song);
  try {
    await player.playReportSongs([song]);
  } catch (_) { qtShowToast({ title: "该歌曲暂时无法播放", icon: "none" }); }
  finally { loadingKey.value = ""; }
}

</script>

<style>
.page { flex:1; }
.scroll { flex:1; }

/* 紧凑封面与统计入口 */
.hero { margin:24rpx 24rpx 0; padding:28rpx 32rpx 30rpx; border-radius:32rpx; overflow:hidden; position:relative; }
.hero-bg { position:absolute; left:0; top:0; }
.hero-scrim { position:absolute; left:0; top:0; background-color:rgba(8,11,20,0.54); }
.hero-body { position:relative; }
.hero-title { margin-top:16rpx; font-weight:700; }
.hero-sub { margin-top:12rpx; }
.hero-tag { margin-top:18rpx; align-self:flex-start; padding:10rpx 24rpx; border-radius:999rpx; }
.hero-tag-text { font-weight:500; }

.duration-card { margin:20rpx 24rpx 0; padding:26rpx; border-width:1px; border-style:solid; border-radius:26rpx; }
.duration-card-wide { margin:16px 24px 0; padding:20px; border-radius:16px; }
.duration-heading { flex-direction:row; align-items:center; }
.duration-label { margin-left:12rpx; }
.duration-line { flex-direction:row; align-items:flex-end; margin-top:10rpx; }
.duration-number { font-weight:700; }
.duration-unit { margin-left:12rpx; }
.duration-note { margin-top:8rpx; }
.storage-status { margin-top:18rpx; flex-direction:row; align-items:center; }
.storage-text { flex:1; }
.hero-toolbar { flex-direction:row; justify-content:space-between; align-items:center; }
.report-help { flex-direction:row; align-items:center; padding:8rpx 0 8rpx 16rpx; }
.report-link { flex-direction:row; align-items:center; padding:12rpx 0 12rpx 12rpx; }

/* 数据带：一排四格 */
.band { margin:20rpx 24rpx 0; flex-direction:row; border-width:1px; border-style:solid; border-radius:26rpx; overflow:hidden; }
.stat-cell { flex:1; padding:26rpx 16rpx 24rpx; }
.stat-cell-r { border-right-width:1px; border-right-style:solid; }
.stat-top { flex-direction:row; align-items:center; }
.stat-label { margin-left:8rpx; }
.stat-num { margin-top:12rpx; font-weight:700; }
.stat-note { margin-top:6rpx; }

/* 区块卡 */
.block { margin:20rpx 24rpx 0; padding:26rpx 24rpx; border-width:1px; border-style:solid; border-radius:26rpx; }
.block-head { flex-direction:row; align-items:center; margin-bottom:8rpx; }
.block-title { margin-left:12rpx; font-weight:650; }
.block-fill { flex:1; }

/* 日榜：分段条 + 一行汇总 + 排行 */
.daily-seg { margin-top:12rpx; }
.daily-kinds { flex-direction:row; margin-top:14rpx; }
.daily-kind { padding:8rpx 18rpx; border-radius:999rpx; margin-right:12rpx; }
.daily-kind-wide { padding:6rpx 12rpx; margin-right:8rpx; }
.daily-summary { margin-top:16rpx; }
.daily-empty { padding:36rpx 0 28rpx; align-items:center; }

/* 三张 Top 5 卡：一排横滑，卡与卡之间靠 margin-right，末卡也留（行宽已计入） */
.top-scroll { margin-top:20rpx; flex-grow:0; flex-shrink:0; }
.top-row { flex-direction:row; padding-left:24rpx; padding-right:24rpx; flex-wrap:nowrap; }
.top-card { margin-right:16rpx; padding:24rpx 22rpx; border-width:1px; border-style:solid; border-radius:26rpx; }
.source-badge { width:84rpx; height:84rpx; border-radius:16rpx; margin-left:10rpx; justify-content:center; align-items:center; }

/* 排行行 */
.song-row { flex-direction:row; align-items:center; padding:14rpx 0; }
.song-rank { width:46rpx; text-align:center; font-weight:700; }
.song-cover { width:84rpx; height:84rpx; border-radius:16rpx; margin-left:10rpx; }
.artist-avatar { width:84rpx; height:84rpx; border-radius:42rpx; margin-left:10rpx; justify-content:center; align-items:center; }
.artist-initial { font-weight:700; }
.song-info { flex:1; margin-left:18rpx; overflow:hidden; }
.song-name { font-weight:500; }
.song-meta { margin-top:6rpx; }
.song-count { margin-left:14rpx; }

/* 空态与结尾卡 */
.empty { align-items:center; padding:60rpx 32rpx; }
.empty-title { margin-top:18rpx; font-weight:600; }
.empty-sub { margin-top:10rpx; text-align:center; }
.pad { height:60rpx; }

/* Vapor 宽屏：用 px 覆盖 rpx，避免 1600x900 下按窗口比例放大 */
.hero-wide { margin:20px 24px 0; padding:20px 28px 24px; border-radius:20px; }
.band-wide { margin:16px 24px 0; border-radius:16px; }
.stat-cell-wide { padding:18px 14px; }
.block-wide { margin:16px 24px 0; padding:20px; border-radius:16px; }
.top-scroll-wide { margin-top:16px; }
.top-row-wide { padding-left:24px; padding-right:24px; }
.top-card-wide { margin-right:16px; padding:18px 20px; border-radius:16px; }
.source-badge-wide { width:48px; height:48px; border-radius:10px; margin-left:6px; }
/* 桌面指针反馈：只在宽屏启用 */
.song-row-hover {
  background-color: rgba(127, 127, 127, 0.10);
}
.daily-kind-hover {
  background-color: rgba(127, 127, 127, 0.10);
}
.song-row-wide { padding:10px 0; }
.song-rank-wide { width:28px; }
.song-cover-wide { width:48px; height:48px; border-radius:10px; margin-left:6px; }
.artist-avatar-wide { width:48px; height:48px; border-radius:24px; margin-left:6px; }
.song-info-wide { margin-left:12px; }
.song-count-wide { margin-left:10px; }
.pad-wide { height:40px; }
.daily-seg-wide { margin-top:10px; }
</style>
