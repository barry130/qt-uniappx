<template>
<qt-page-frame current="/pages/home/index" width-kind="grid" inset-top>
    <view class="home-page">
      <view class="home-body">
      <scroll-view class="home-scroll" direction="vertical" :show-scrollbar="false" :scroll-top="scrollTop" @scroll="onListScroll">
        <view class="home-header" :class="layout.isWide ? 'home-header-wide' : ''" :style="headerPadStyle">
          <!-- 头部不放品牌块（2026-10 用户定稿：整块删掉「轻听 / 你的私人音乐台」）。竖屏一行
               原来塞了四块，太挤；现在只留三个控件，顺序 音源、搜索、通知 -->
          <SourceSwitcher class="home-source" @change="ensureLoad" />
          <view class="home-search" :class="[layout.isWide ? 'home-search-wide' : '']" :style="homeSearchStyle" @click="goSearch">
            <QtIcon name="search" :size="layout.isWide ? 16 : 24" :color="themeStore.skin.iconMuted" />
            <text class="home-search-text" :class="[layout.isWide ? 'home-search-text-wide' : '']" :style="('color:' + themeStore.skin.placeholder + ';') + qtFontDual(23, 13)" :max-lines="1">{{ layout.isWide ? '搜索歌曲、歌手、专辑、歌单' : '搜索' }}</text>
          </view>
          <view class="home-bell" :class="[layout.isWide ? 'home-bell-wide' : '']" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';'" @click="goNoticeCenter">
            <QtIcon name="bell" :size="layout.isWide ? 18 : 26" :color="themeStore.skin.icon" />
            <view v-if="noticeStore.unreadCount > 0" class="home-bell-dot" :class="layout.isWide ? 'home-bell-dot-wide' : ''" :style="'background-color:' + themeStore.skin.accent + ';'"><text class="home-bell-dot-text" :class="layout.isWide ? 'home-bell-dot-text-wide' : ''" :style="('color:' + themeStore.skin.onAccent + ';') + qtFontDual(16, 9)">{{ noticeStore.unreadCount > 99 ? "99+" : noticeStore.unreadCount }}</text></view>
          </view>
        </view>
        <qt-notice-bar :notice="barNotice" @closed="barNotice = null" />
        <!-- 失败横条：非模态、不挡操作，点右侧重试整轮 -->
        <view v-if="loadFailed" class="home-fail" :class="layout.isWide ? 'home-fail-wide' : ''" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';'">
          <QtIcon name="alert" :size="26" :color="themeStore.skin.warning" />
          <text class="home-fail-text" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(23, 13)" :max-lines="2">部分内容没加载出来，可能是网络或音源包的问题</text>
          <view class="home-fail-btn" :style="'background-color:' + themeStore.skin.accentSoft + ';'" @click="retryLoad">
            <text class="home-fail-btn-text" :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(22, 12)">重试</text>
          </view>
        </view>
        <!-- 两种音源包都不内置：播放包（版权风险）与数据包（在线搜索/歌单/歌词）都由用户
             在设置页自行安装。没有生效中的播放包时给一条引导条；没有生效中的数据包时弹
             QtMetaPackGuide（下方）。横幅现唤起半屏直装（官方包一键安装，拉不到 offer 才
             退回跳管理页，见 openPackSheetFromBanner），文案同步为「点此直接安装官方包」，
             避免「说去管理页、实际弹半屏」的文不对题；数据包引导仍只指路「音源包管理」页；
             本地音乐照常播放 -->
        <view v-if="sourceUpdateStore.sourceMissing" class="source-tip" :class="layout.isWide ? 'source-tip-wide' : ''" :style="'background-color:' + themeStore.skin.accentSoft + ';'" @click="openPackSheetFromBanner">
          <QtIcon name="music" :size="26" :color="themeStore.skin.accent" />
          <view class="source-tip-copy" :class="layout.isWide ? 'source-tip-copy-wide' : ''">
            <text class="source-tip-title" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(27, 15)" :max-lines="1">未安装播放音源包</text>
            <text class="source-tip-desc" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12)" :max-lines="2">在线播放需要先安装播放音源包，点此直接安装官方包；本地音乐播放不受影响</text>
          </view>
          <QtIcon name="chevron-right" :size="24" :color="themeStore.skin.iconMuted" />
        </view>
        <view v-if="!layout.isWide" class="portrait-home">
          <view v-if="showPlaylists" class="portrait-hero" :style="heroStyle" @click="playFeatured">
            <!-- 底图用今日精选歌单的封面（aspectFill 裁满整张卡），再盖一层 mediaScrim 遮罩，
                 保证白字压在任何封面上都读得清；封面没到货时露出的就是 heroStyle 的 accent 底色。
                 卡片右侧不再放同款缩略图：底图已经是同一张封面，再摆一个方块只是重复。
                 铺满分两层：外层 view 四边 0（与 .hero-scrim 同款，实测能铺满），
                 image 在外层里 width/height:100% —— 见 style 里 .hero-bg-wrap 的注释 -->
            <view v-if="featuredPicUrl != ''" class="hero-bg-wrap">
              <image class="hero-bg" :src="featuredPicUrl" mode="aspectFill" />
            </view>
            <view class="hero-scrim" :style="'background-color:' + themeStore.skin.mediaScrim + ';'"></view>
            <view class="portrait-hero-copy">
              <text class="hero-kicker" :style="('color:rgba(255,255,255,0.72);') + qtFont(20)">今日精选</text>
              <text class="hero-title" :style="('color:#ffffff;line-height:' + 54 * fontScale.scale + 'rpx;') + qtFont(40)" :max-lines="2">{{ featuredName }}</text>
              <text class="hero-desc" :style="('color:rgba(255,255,255,0.78);') + qtFont(22)" :max-lines="1">{{ playlists.length > 0 ? "精选歌单 · 好音乐每日更新" : "好音乐会自动出现" }}</text>
              <view class="hero-play" @click.stop="playFeatured">
                <QtIcon name="disc" :size="28" :color="themeStore.skin.accent" />
                <text class="hero-play-text" :style="('color:' + themeStore.skin.accent + ';') + qtFont(24)">打开歌单</text>
              </view>
            </view>
          </view>
          <view v-if="tileCount > 0" class="quick-grid">
            <!-- 顺序：每日推荐（常驻，纯本地推荐 + 全源搜索，不挑音源能力），其后 每日新歌 / 歌单 / 排行榜
                 （随当前源功能面增减），最后 私人 FM / 播客（常驻，2026-11-03 / 2026-11-04 移植自 qt-pc）。
                 六枚同一个 flex-wrap 网格按 2 枚/行动态换行：前四枚显隐由音源决定，私人 FM/播客 始终跟在
                 它们后面（用户 2026-11-04：不要固定占第三行，跟着动态的排在最后即可）。
                 FM 按口味连播、播客按订阅连播，都是「一直听下去」的流，候选来自本地/收藏/歌单/最近播放
                 + 全部已装音源，不挑当前源能力，所以不挂 show* 开关 -->
            <view class="quick-pill" :style="'width:' + quickPillWidth + 'px;background-color:' + themeStore.skin.accentSoft + ';'" @click="goDailyRecommend">
              <QtIcon name="sparkles" :size="24" :color="themeStore.skin.accent" /><text class="quick-label" :style="('color:' + themeStore.skin.text + ';') + qtFont(24)">每日推荐</text>
            </view>
            <view v-if="showLatest" class="quick-pill" :style="'width:' + quickPillWidth + 'px;background-color:' + themeStore.skin.accentSoft + ';'" @click="showDaily">
              <QtIcon name="calendar" :size="24" :color="themeStore.skin.accent" /><text class="quick-label" :style="('color:' + themeStore.skin.text + ';') + qtFont(24)">每日新歌</text>
            </view>
            <view v-if="showPlaylists" class="quick-pill" :style="'width:' + quickPillWidth + 'px;background-color:' + themeStore.skin.accentSoft + ';'" @click="goPlaylists">
              <QtIcon name="disc" :size="24" :color="themeStore.skin.accent" /><text class="quick-label" :style="('color:' + themeStore.skin.text + ';') + qtFont(24)">歌单</text>
            </view>
            <view v-if="showChartTile" class="quick-pill" :style="'width:' + quickPillWidth + 'px;background-color:' + themeStore.skin.accentSoft + ';'" @click="showChart">
              <QtIcon name="trending" :size="24" :color="themeStore.skin.accent" /><text class="quick-label" :style="('color:' + themeStore.skin.text + ';') + qtFont(24)">排行榜</text>
            </view>
            <view class="quick-pill" :style="'width:' + quickPillWidth + 'px;background-color:' + themeStore.skin.accentSoft + ';'" @click="goRadio">
              <QtIcon name="music" :size="24" :color="themeStore.skin.accent" /><text class="quick-label" :style="('color:' + themeStore.skin.text + ';') + qtFont(24)">私人 FM</text>
            </view>
            <view class="quick-pill" :style="'width:' + quickPillWidth + 'px;background-color:' + themeStore.skin.accentSoft + ';'" @click="goPodcast">
              <QtIcon name="mic" :size="24" :color="themeStore.skin.accent" /><text class="quick-label" :style="('color:' + themeStore.skin.text + ';') + qtFont(24)">播客</text>
            </view>
          </view>
          <view v-if="showLocalMixes" class="section" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';'">
            <!-- 「为你整理」与其他区块同一个白色卡片容器：此前它是裸放在页面里的（无卡底、
                 左右还各多出 26rpx 卡内边距），和下方的推荐歌单/热门榜单/新歌速递对不齐。
                 卡宽与间距由首页按「推荐歌单」同一套计算值传入，卡面尺寸也完全一致 -->
            <QtLocalMixes :mixes="localMixes" :embedded="true" :content-width="portraitSectionInner" :card-width="shelfCardWidth" />
          </view>
          <view v-if="showPlaylists" class="section" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';'">
            <view class="section-head"><view class="section-copy"><text class="section-title" :style="('color:' + themeStore.skin.text + ';') + qtFont(34)">推荐歌单</text></view><view class="section-more" @click="goPlaylists"><text class="section-more-text" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFont(21)">全部</text><QtIcon name="chevron-right" :size="15" :color="themeStore.skin.iconMuted" /></view></view>
            <!-- 骨架屏：横向歌单架是「一行 2.5 张卡横滑」，用 tile 形状 + nowrap，
                 卡宽/间距/架高全部复用真实卡的计算值，数据到达时不会跳一下 -->
            <view v-if="loading && playlists.length == 0" class="shelf-skel" :style="'height:' + shelfHeightPx + 'px;'">
              <QtSkeletonList kind="tile" :nowrap="true" :rows="5" :card-width="shelfCardWidth" :gap="shelfGapPx" />
            </view>
            <scroll-view v-else class="shelf-scroll" direction="horizontal" :show-scrollbar="false" :style="'height:' + shelfHeightPx + 'px;'">
              <view class="shelf-row" :style="'width:' + shelfWidthPx + 'px;'">
                <view v-for="list in homePlaylists" :key="list.id + list.platform" class="shelf-card" :style="'width:' + shelfCardWidth + 'px;margin-right:' + shelfGapPx + 'px;'" :hover-class="layout.isWide ? 'shelf-card-hover' : 'none'" @click="openPlaylist(list)">
                  <image class="shelf-cover" :style="'width:' + shelfCardWidth + 'px;height:' + shelfCardWidth + 'px;background-color:' + themeStore.skin.coverPlaceholder + ';'" :src="list.picUrl" mode="aspectFill" />
                  <text class="shelf-name" :style="('color:' + themeStore.skin.text + ';line-height:' + 42 * fontScale.scale + 'rpx;') + qtFont(32)" :max-lines="2">{{ list.name }}</text>
                  <text class="shelf-count" :style="('color:' + themeStore.skin.textSubtle + ';line-height:' + 30 * fontScale.scale + 'rpx;') + qtFont(23)" :max-lines="1">{{ formatCount(list.playCount) }} 次播放</text>
                </view>
                <view v-if="playlists.length == 0" class="home-empty"><text class="home-empty-text" :style="('color:' + themeStore.skin.textSubtle + ';line-height:' + 30 * fontScale.scale + 'rpx;') + qtFont(23)">暂无推荐内容</text></view>
              </view>
            </scroll-view>
          </view>
          <view v-if="showCharts" class="section" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';'">
            <view class="section-head"><view class="section-copy"><text class="section-title" :style="('color:' + themeStore.skin.text + ';') + qtFont(34)">热门榜单</text></view><view class="section-more" @click="showChart"><text class="section-more-text" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFont(21)">更多</text><QtIcon name="chevron-right" :size="15" :color="themeStore.skin.iconMuted" /></view></view>
            <view class="chart-list">
              <!-- 骨架屏：4 行与 homeCharts 同数，行高/封面/箭头全部由 row 形状对齐 -->
              <QtSkeletonList v-if="loading && charts.length == 0" kind="row" :rows="4" />
              <view v-for="chart in homeCharts" :key="chart.id + chart.platform" class="chart-row" :style="'border-bottom-color:' + themeStore.skin.divider + ';'" :hover-class="layout.isWide ? 'chart-row-hover' : 'none'" @click="openChart(chart)">
                <image class="chart-cover" :style="'background-color:' + themeStore.skin.coverPlaceholder + ';'" :src="chart.picUrl" mode="aspectFill" />
                <view class="chart-info"><text class="chart-name" :style="('color:' + themeStore.skin.text + ';') + qtFont(30)" :max-lines="1">{{ chart.name }}</text><text class="chart-meta" :style="('color:' + themeStore.skin.textMuted + ';') + qtFont(23)" :max-lines="1">{{ chart.description || "热门榜单" }}</text></view>
                <QtIcon name="chevron-right" :size="24" :color="themeStore.skin.iconMuted" />
              </view>
              <view v-if="!loading && charts.length == 0" class="home-empty"><text class="home-empty-text" :style="('color:' + themeStore.skin.textSubtle + ';line-height:' + 30 * fontScale.scale + 'rpx;') + qtFont(23)">暂无榜单</text></view>
            </view>
          </view>
          <view v-if="showLatest" class="section section-last" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';'">
            <view class="section-head"><view class="section-copy"><text class="section-title" :style="('color:' + themeStore.skin.text + ';') + qtFont(34)">新歌速递</text></view></view>
            <view class="song-list">
              <!-- 骨架屏：8 行与 homeSongs 同数 -->
              <QtSkeletonList v-if="loading && songs.length == 0" kind="row" :rows="8" />
              <view v-for="song in homeSongs" :key="song.id + song.platform" class="song-row" :style="'border-bottom-color:' + themeStore.skin.divider + ';'">
                <image class="song-cover" :style="'background-color:' + themeStore.skin.coverPlaceholder + ';'" :src="song.picUrl" mode="aspectFill" />
                <view class="song-info"><text class="song-name" :style="('color:' + themeStore.skin.text + ';') + qtFont(30)" :max-lines="1">{{ song.name }}</text><text class="song-meta" :style="('color:' + themeStore.skin.textMuted + ';') + qtFont(23)" :max-lines="1">{{ song.singer }}{{ song.album.length > 0 ? " · " + song.album : "" }}</text></view>
                <view class="play-hit" @click="play(song)">
                  <view class="play-btn" :style="'background-color:' + themeStore.skin.accentSoft + ';'">
                    <QtIcon name="play" :size="24" :color="themeStore.skin.accent" />
                  </view>
                </view>
              </view>
              <view v-if="!loading && songs.length == 0" class="home-empty"><text class="home-empty-text" :style="('color:' + themeStore.skin.textSubtle + ';line-height:' + 30 * fontScale.scale + 'rpx;') + qtFont(23)">暂无新歌</text></view>
            </view>
          </view>
        </view>
        <view v-else class="wide-home" :style="wideHomeStyle">
          <view class="wide-feature-row" :class="hdHome.featureSplit && showPlaylists ? 'wide-feature-row-split' : ''">
            <view v-if="showPlaylists" class="wide-feature" :style="wideFeatureStyle">
              <view v-if="featuredPicUrl != ''" class="wide-feature-backdrop"><image class="wide-feature-bg" :src="featuredPicUrl" mode="aspectFill" /></view>
              <view class="wide-feature-scrim" :style="'background-color:' + themeStore.skin.mediaScrim + ';'" />
              <image v-if="featuredPicUrl != ''" class="wide-feature-cover" :style="wideFeatureCoverStyle" :src="featuredPicUrl" mode="aspectFill" />
              <view class="wide-feature-copy">
                <text class="wide-feature-kicker" :style="qtFontPx(12)">今日精选</text>
                <text class="wide-feature-title" :style="qtFontPx(23)" :max-lines="2">{{ featuredName }}</text>
                <text class="wide-feature-desc" :style="qtFontPx(13)" :max-lines="1">{{ playlists.length > 0 ? '从一张好歌单，开始今天的音乐' : '正在寻找好音乐' }}</text>
                <view class="wide-feature-actions">
                  <view class="wide-primary" @click="playFeatured"><QtIcon name="disc" :size="16" :color="themeStore.skin.accent" /><text class="wide-primary-text" :style="('color:' + themeStore.skin.accent + ';') + qtFontPx(13)">打开歌单</text></view>
                  <view class="wide-secondary" @click="goPlaylists"><text class="wide-secondary-text" :style="qtFontPx(13)">更多歌单</text><QtIcon name="chevron-right" :size="14" color="#ffffff" /></view>
                </view>
              </view>
            </view>
            <view class="wide-shortcuts" :class="hdHome.featureSplit && showPlaylists ? 'wide-shortcuts-split' : ''" :style="wideShortcutGroupStyle">
              <view v-for="(entry, index) in wideEntries" :key="entry.route" class="wide-shortcut" :class="!hdHome.featureSplit || !showPlaylists ? 'wide-shortcut-inline' : ''" :style="wideShortcutStyle(index)" hover-class="wide-row-hover" @click="openWideEntry(entry.route)">
                <view class="wide-shortcut-icon" :style="'background-color:' + themeStore.skin.accentSoft + ';'"><QtIcon :name="entry.icon" :size="20" :color="themeStore.skin.accent" /></view>
                <view class="wide-shortcut-copy" :class="!hdHome.featureSplit || !showPlaylists ? 'wide-shortcut-copy-inline' : ''"><text class="wide-shortcut-title" :style="('color:' + themeStore.skin.text + ';') + qtFontPx(14)" :max-lines="1">{{ entry.title }}</text><text v-if="hdHome.featureSplit && showPlaylists" class="wide-shortcut-desc" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontPx(12)" :max-lines="1">{{ entry.subtitle }}</text></view>
                <QtIcon v-if="hdHome.featureSplit && showPlaylists" name="chevron-right" :size="14" :color="themeStore.skin.iconMuted" />
              </view>
            </view>
          </view>
          <view v-if="showLocalMixes" class="wide-panel">
            <QtLocalMixes :mixes="localMixes" :embedded="true" :content-width="hdHome.innerPx" :card-width="hdHome.cardPx" />
          </view>
          <view v-if="showPlaylists" class="wide-panel">
            <view class="wide-panel-head"><text class="wide-panel-title" :style="('color:' + themeStore.skin.text + ';') + qtFontPx(20)">推荐歌单</text><view class="section-more" @click="goPlaylists"><text class="wide-more-text" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontPx(13)">全部歌单</text><QtIcon name="chevron-right" :size="14" :color="themeStore.skin.iconMuted" /></view></view>
            <scroll-view class="wide-playlist-scroll" direction="horizontal" :show-scrollbar="false" :style="wideShelfStyle">
              <view class="wide-playlist-row" :style="wideShelfRowStyle">
                <QtSkeletonList v-if="loading && playlists.length == 0" kind="tile" :nowrap="true" :rows="8" :card-width="hdHome.cardPx" :gap="hdHome.cardGapPx" />
                <view v-for="list in homePlaylists" :key="list.id + list.platform" class="wide-playlist-card" :style="'width:' + hdHome.cardPx + 'px;'" hover-class="shelf-card-hover" @click="openPlaylist(list)">
                  <image class="wide-playlist-cover" :style="'width:' + hdHome.cardPx + 'px;height:' + hdHome.cardPx + 'px;background-color:' + themeStore.skin.coverPlaceholder + ';'" :src="list.picUrl" mode="aspectFill" />
                  <text class="wide-playlist-name" :style="('color:' + themeStore.skin.text + ';line-height:' + 20 * fontScale.scale + 'px;') + qtFontPx(14)" :max-lines="2">{{ list.name }}</text>
                  <text class="wide-playlist-count" :style="('color:' + themeStore.skin.textMuted + ';line-height:' + 17 * fontScale.scale + 'px;') + qtFontPx(12)" :max-lines="1">{{ formatCount(list.playCount) }} 次播放</text>
                </view>
                <view v-if="!loading && playlists.length == 0" class="wide-empty"><text class="wide-empty-text" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontPx(12)">暂无推荐内容</text></view>
              </view>
            </scroll-view>
          </view>
          <view v-if="showLatest" class="wide-panel">
            <view class="wide-panel-head"><text class="wide-panel-title" :style="('color:' + themeStore.skin.text + ';') + qtFontPx(20)">新歌速递</text><view class="section-more" @click="showDaily"><text class="wide-more-text" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontPx(13)">更多新歌</text><QtIcon name="chevron-right" :size="14" :color="themeStore.skin.iconMuted" /></view></view>
            <QtSkeletonList v-if="loading && songs.length == 0" kind="row" :rows="6" :columns="hdHome.songColumns" />
            <view v-for="(row, rowIndex) in wideSongRows" :key="'song-row-' + rowIndex" class="wide-song-grid">
              <view v-for="(song, columnIndex) in row" :key="song.id + song.platform" class="wide-song-row" :style="wideMusicCellStyle(columnIndex)" hover-class="wide-row-hover" @click="play(song)">
                <image class="wide-song-cover" :style="'background-color:' + themeStore.skin.coverPlaceholder + ';'" :src="song.picUrl" mode="aspectFill" />
                <view class="wide-song-info"><text class="wide-song-name" :style="('color:' + themeStore.skin.text + ';') + qtFontPx(14)" :max-lines="1">{{ song.name }}</text><text class="wide-song-meta" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontPx(12)" :max-lines="1">{{ song.singer }}</text></view>
                <view class="wide-song-play"><QtIcon name="play" :size="16" :color="themeStore.skin.iconMuted" /></view>
              </view>
            </view>
            <view v-if="!loading && songs.length == 0" class="wide-empty"><text class="wide-empty-text" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontPx(12)">暂无新歌</text></view>
          </view>
          <view v-if="showCharts" class="wide-panel">
            <view class="wide-panel-head"><text class="wide-panel-title" :style="('color:' + themeStore.skin.text + ';') + qtFontPx(20)">热门榜单</text><view class="section-more" @click="showChart"><text class="wide-more-text" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontPx(13)">全部榜单</text><QtIcon name="chevron-right" :size="14" :color="themeStore.skin.iconMuted" /></view></view>
            <QtSkeletonList v-if="loading && charts.length == 0" kind="row" :rows="6" :columns="hdHome.songColumns" />
            <view v-for="(row, rowIndex) in wideChartRows" :key="'chart-row-' + rowIndex" class="wide-song-grid">
              <view v-for="(chart, columnIndex) in row" :key="chart.id + chart.platform" class="wide-chart-row" :style="wideMusicCellStyle(columnIndex) + 'border-bottom-color:' + themeStore.skin.divider + ';'" hover-class="wide-row-hover" @click="openChart(chart)">
                <image class="wide-chart-cover" :style="'background-color:' + themeStore.skin.coverPlaceholder + ';'" :src="chart.picUrl" mode="aspectFill" />
                <view class="wide-chart-info"><text class="wide-chart-name" :style="('color:' + themeStore.skin.text + ';') + qtFontPx(14)" :max-lines="1">{{ chart.name }}</text><text class="wide-chart-meta" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontPx(12)" :max-lines="1">{{ chart.description || '热门榜单' }}</text></view>
                <QtIcon name="chevron-right" :size="16" :color="themeStore.skin.iconMuted" />
              </view>
            </view>
            <view v-if="!loading && charts.length == 0" class="wide-empty"><text class="wide-empty-text" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontPx(12)">暂无榜单</text></view>
          </view>
        </view>
      </scroll-view>
      <QtBackToTop :visible="showBackToTop" @tap="backToTop" />
      <QtTabBar current="pages/home/index" :dots="updateDotPaths" />
      <!-- 三个全屏弹窗（公告 / 升级 / 数据包引导）互斥：只渲染 activePopup 选中的那一个 -->
      <qt-notice-splash v-if="activePopup == 'splash'" :notice="noticeStore.splashNotice" @closed="onSplashClosed" />
      <qt-upgrade-popup v-model:visible="upgradeVisible" :info="upgradeInfo" @closed="onUpgradeClosed" />
      <QtMetaPackGuide :visible="activePopup == 'meta'" @go="goSourcePack" @dismiss="onMetaGuideDismiss" />
      </view>
    </view>
    <!-- 宽屏 rail 工具入口的就地托管层：同窗口换内容，不新建 Activity（没有系统起始窗白帧）。
         详见 qt-wide-workspace.ts。窄屏不渲染（托管状态恒为空）。
         2026-10-25 教训：不能挪到页面根做多根节点 —— 字节码模板渲染器直接
         std::runtime_error 崩溃（unsupported component sharedData source）。 -->
    <qt-wide-workspace host-route="/pages/home/index">
      <!-- 页面槽位（2026-10-27 解耦）：工具页由本宿主页以默认插槽传入
           （qt-ui 不再 import 业务页面）。单活动 pane：qtPaneOn＝当前托管
           路由匹配才挂载，切换即换挂 16~300ms，保活方案真机史见
           composables/qt-wide-workspace.ts 的 qtPaneOn 注释。 -->
      <view v-if="homePaneOn('/pages/search/index')" class="qtww-pane"><SearchPage /></view>
      <view v-if="homePaneOn('/pages/daily-recommend/index')" class="qtww-pane"><DailyRecommendPage /></view>
      <view v-if="homePaneOn('/pages/radio/index')" class="qtww-pane"><RadioPage /></view>
      <view v-if="homePaneOn('/pages/podcast/index')" class="qtww-pane"><PodcastPage /></view>
      <view v-if="homePaneOn('/pages/daily/index')" class="qtww-pane"><DailyPage /></view>
      <view v-if="homePaneOn('/pages/playlists/index')" class="qtww-pane"><PlaylistsPage /></view>
      <view v-if="homePaneOn('/pages/chart/index')" class="qtww-pane"><ChartPage /></view>
      <view v-if="homePaneOn('/pages/settings/index')" class="qtww-pane"><SettingsPage /></view>
    </qt-wide-workspace>
  </qt-page-frame>
</template>
<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import { formatBigCount } from "@/services/format";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import QtWideWorkspace from "@/uni_modules/qt-ui/components/qt-wide-workspace/qt-wide-workspace.uvue";
import SearchPage from "@/pages/search/index.uvue";
import DailyRecommendPage from "@/pages/daily-recommend/index.uvue";
import RadioPage from "@/pages/radio/index.uvue";
import PodcastPage from "@/pages/podcast/index.uvue";
import DailyPage from "@/pages/daily/index.uvue";
import PlaylistsPage from "@/pages/playlists/index.uvue";
import ChartPage from "@/pages/chart/index.uvue";
import SettingsPage from "@/pages/settings/index.uvue";
import QtTabBar from "@/uni_modules/qt-ui/components/qt-tab-bar/qt-tab-bar.uvue";
import { useQtTabBarSync } from "@/uni_modules/qt-ui/composables/use-qt-tab-bar";
import { qtContentWidth } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { qtHdHomeMetrics } from "@/uni_modules/qt-ui/composables/hd-layout";
import { qtRailNavigate } from "@/uni_modules/qt-ui/composables/qt-nav";
import { ref, computed, onMounted, onUnmounted, watch } from "vue";
import { onShow, onHide, onBackPress } from "@dcloudio/uni-app";
import { exitApp, moveAppToBackground } from "@/services/app-native";
import { useHomeBackSettings } from "@/uni_modules/qt-ui/stores/home-back";
import { qtActionSheetState, qtActionSheetCancel } from "@/services/action-sheet";
import SourceSwitcher from "@/uni_modules/qt-ui/components/qt-source-switcher/qt-source-switcher.uvue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtNoticeBar from "@/uni_modules/qt-ui/components/qt-notice-bar/qt-notice-bar.uvue";
import QtNoticeSplash from "@/uni_modules/qt-ui/components/qt-notice-splash/qt-notice-splash.uvue";
import QtBackToTop from "@/uni_modules/qt-ui/components/qt-back-to-top/qt-back-to-top.uvue";
import qtUpgradePopup from "@/uni_modules/qt-ui/components/qt-upgrade-popup/qt-upgrade-popup.uvue";
import QtMetaPackGuide from "@/uni_modules/qt-ui/components/qt-meta-pack-guide/qt-meta-pack-guide.uvue";
import QtLocalMixes from "@/uni_modules/qt-ui/components/qt-local-mixes/qt-local-mixes.uvue";
import QtSkeletonList from "@/uni_modules/qt-ui/components/qt-skeleton-list/qt-skeleton-list.uvue";
import { musicApi } from "@/services/music-api";
import { packsFingerprint, SOURCE_PACKS_CHANGED_EVENT } from "@/services/source-update";
import { ensureLocalStateRestored } from "@/services/source-bundle-fs";
import { usePlayerStore } from "@/stores/player";
import { useSourceStore } from "@/stores/source";
import { useSourceRegistryStore } from "@/stores/source-registry";
import { useSourceUpdateStore } from "@/stores/source-update";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout, qtRpx } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useNoticeStore } from "@/stores/notice";
import { isNoticeBarClosedInSession } from "@/services/notice";
import { consumePendingUpdate, pendingUpdateRef } from "@/services/upgrade";
import { markFirstPageReady } from "@/services/boot-guard";
import type { AppUpdateInfo } from "@/services/upgrade";
import { qtTrackPage } from "@/uni_modules/qt-stat";
import type { Notice } from "@/types/notice";
import type { Playlist, Song } from "@/types/music";
import type { Chart, Source } from "@/services/music-api";
import { qtFontDual, qtFont, qtFontPx, fontScale } from "@/uni_modules/qt-ui/stores/font-scale";
import { logMsgErr } from "@/services/logger";
import { buildLocalMixes, shouldShowLocalMixes, type LocalMix } from "@/services/local-mixes";
import { useListenStatsStore } from "@/stores/listen-stats";
import { qtCloseWideTool, qtPaneOn, qtWideWorkspaceRefresh } from "@/uni_modules/qt-ui/composables/qt-wide-workspace";
import { closePlaybackQueue } from "@/uni_modules/qt-ui/composables/playback-queue-overlay";
import { openPackInstallSheet, PACK_SHEET_UNAVAILABLE } from "@/services/pack-install-sheet";
import { useHomePopupStore } from "@/stores/home-popup";

// 两个 tab 根页都可能存活；只挂属于本宿主的活动工具，深页覆盖不改归属。
function homePaneOn(route: string): boolean {
  return qtPaneOn(route, "/pages/home/index");
}

const player = usePlayerStore();
const homeBackSettings = useHomeBackSettings();
const homeActionSheet = qtActionSheetState();
const sourceStore = useSourceStore();
const sourceUpdateStore = useSourceUpdateStore();
// 「我的」tab 红点：音源包有新包待生效时亮
const updateDotPaths = computed<string[]>(() => sourceUpdateStore.updatePending ? ["pages/profile/index"] : []);
const themeStore = useThemeStore();
const noticeStore = useNoticeStore();
const layout = useQtLayout();
// 首页全屏弹窗占用态镜像的写入端（读取方是启动弹窗队列），见下方 watch(activePopup)
const homePopupStore = useHomePopupStore();
const statsStore = useListenStatsStore();
const localMixes = ref<LocalMix[]>([]);
// “为你整理”有固定的五类合辑，但攒不齐是常态：出场门槛见 shouldShowLocalMixes。
const showLocalMixes = computed<boolean>(() => shouldShowLocalMixes(statsStore.ready, localMixes.value));
/**
 * 白色卡片（.section）的内宽：窗口 − 页面左右 24rpx − 卡片左右 26rpx。
 * 与 shelfCardWidth 里的 inner 完全同式（100/750），所以「为你整理」的横滑架
 * 和「推荐歌单」的卡架左右两端必然对齐。
 */
const portraitSectionInner = computed<number>(() => {
  const win = layout.windowWidth;
  return Math.max(1, Math.round(win - win * (100 / 750)));
});
function refreshLocalMixes(): void {
  const validPids: string[] = [];
  for (let i = 0; i < player.localPlaylists.length; i++) {
    const pid = player.localPlaylists[i].pid;
    if (pid != null && pid.length > 0) validPids.push(pid);
  }
  for (let i = 0; i < player.savedPlaylists.length; i++) {
    const playlist = player.savedPlaylists[i];
    if (playlist.platform != "local") continue;
    const pid = playlist.pid != null && playlist.pid.length > 0 ? playlist.pid : playlist.id;
    if (pid.length > 0 && validPids.indexOf(pid) < 0) validPids.push(pid);
  }
  localMixes.value = buildLocalMixes(statsStore.songs, player.likedSongs, validPids);
}
async function loadLocalMixes(): Promise<void> {
  try {
    await statsStore.load(player.history, player.playCounts);
    await statsStore.flush();
  } catch (_) {
    // 静默：统计加载失败不拦首页本地歌单展示，下次进入会重试
  }
  refreshLocalMixes();
}

// ── 功能面门控（v4 契约）：数据包声明每个源有没有歌单载体/排行榜/新歌流，
//    不支持的功能入口/区块直接不渲染，而不是留一个永远空的死区块
//    （如 B 站没有歌单：今日精选 hero/推荐歌单/歌单磁贴整组隐藏）。
//    未声明（旧包）一律按支持处理，行为与门控上线前完全一致 ──
const sourceRegistry = useSourceRegistryStore();
/** 当前源有歌单载体（今日精选 hero / 推荐歌单区块 / 歌单磁贴） */
const showPlaylists = computed<boolean>(() => sourceRegistry.supports(sourceStore.current, "playlists"));
/** 当前源有排行榜（首页热门榜单区块显示的就是当前源的榜单） */
const showCharts = computed<boolean>(() => sourceRegistry.supports(sourceStore.current, "charts"));
/** 当前源有新歌流（新歌速递区块 / 每日推荐磁贴） */
const showLatest = computed<boolean>(() => sourceRegistry.supports(sourceStore.current, "latest"));
/** 排行榜磁贴看聚合：榜单页有各源标签、会自动落到第一个有榜单的源，
 *  只要还有任何一个源有榜单，磁贴就保留 */
const showChartTile = computed<boolean>(() => sourceRegistry.anySupports("charts"));
/** 可见磁贴数（quickPillWidth 按它折算列宽，隐藏后剩余磁贴平分一行）。
 *  每日推荐 / 私人 FM / 播客 三枚常驻（后两枚 2026-11-03 / 2026-11-04 移植自 qt-pc，纯本地推荐 + 全源搜索，
 *  不挑音源能力），其余按当前源功能面增减；私人 FM / 播客 始终排在最末（用户 2026-11-04 指定）。 */
const tileCount = computed<number>(() => {
  let n = 3;
  if (showLatest.value) n++;
  if (showPlaylists.value) n++;
  if (showChartTile.value) n++;
  return n;
});

const scrollTop = ref(0);
const showBackToTop = ref(false);
// 首页升级弹层延迟展示定时器：页面卸载时必须清掉，防止在已注销的实例上触发回调
let upgradeTimer: number | null = null;
function onListScroll(e: any) {
  const st = e.detail != null ? Number(e.detail.scrollTop ?? 0) : 0;
  showBackToTop.value = st > 600;
}
function backToTop() {
  scrollTop.value = scrollTop.value == 0 ? 1 : 0;
  showBackToTop.value = false;
}

const barNotice = ref<Notice | null>(null);
function applyNoticeBar(): void {
  if (isNoticeBarClosedInSession()) {
    barNotice.value = null;
    return;
  }
  const bars = noticeStore.dispatch.noticeBar.slice();
  if (bars.length == 0) {
    barNotice.value = null;
    return;
  }
  bars.sort((a, b) => (b.createTime ?? "").localeCompare(a.createTime ?? ""));
  barNotice.value = bars[0];
}
function onSplashClosed(hideToday: boolean): void {
  noticeStore.dismissSplash(hideToday);
}

const upgradeVisible = ref(false);
const upgradeInfo = ref<AppUpdateInfo | null>(null);
const upgradeHold = ref(false);
const noticeIdle = computed<boolean>(() => noticeStore.loaded && noticeStore.splashNotice == null);
function tryShowUpgrade(): void {
  const pending = consumePendingUpdate();
  if (pending == null) return;
  upgradeInfo.value = pending;
  if (!noticeIdle.value) {
    upgradeHold.value = true;
    return;
  }
  upgradeHold.value = false;
  upgradeVisible.value = true;
}
watch(pendingUpdateRef, () => tryShowUpgrade());
watch(noticeIdle, () => {
  if (!upgradeHold.value || upgradeVisible.value) return;
  if (upgradeInfo.value != null && noticeIdle.value) {
    upgradeHold.value = false;
    upgradeVisible.value = true;
  }
});
onMounted(() => {
  // 首屏已挂载：解除启动守卫（白屏兜底只针对「首页没挂上」的情况）
  markFirstPageReady();
  tryShowUpgrade();
  upgradeTimer = setTimeout(() => {
    if (!noticeStore.loaded && upgradeInfo.value != null && !upgradeVisible.value) {
      upgradeHold.value = false;
      upgradeVisible.value = true;
    }
  }, 12000) as number;
});
onUnmounted(() => {
  // 页面卸载时清掉遗留定时器，避免在已注销的 UTS 实例上触发原生回调
  if (upgradeTimer != null) {
    clearTimeout(upgradeTimer);
    upgradeTimer = null;
  }
  uni.$off(SOURCE_PACKS_CHANGED_EVENT, onPacksChanged);
  // 占用态放掉：首页销毁（tab 页常驻，这里是防御性收口）时不能让启动弹窗队列
  // 永远等一个不存在的弹窗
  homePopupStore.busy = false;
});
function onUpgradeClosed(): void {
  upgradeVisible.value = false;
  upgradeInfo.value = null;
  upgradeHold.value = false;
}
function goNoticeCenter(): void {
  uni.navigateTo({ url: "/pages/notice/list/index" });
}
watch(() => noticeStore.notices, () => applyNoticeBar());
// 数据包引导弹窗显隐：声明必须先于下方 popupBlocking —— useQtTabBarSync 会
// 立即求值该 computed，声明放页面后部会触发 TDZ 报错
// 「Cannot access 'metaGuideVisible' before initialization」（真机已复现）。
const metaGuideVisible = ref(false);
let metaGuideDismissedInSession = false;
/**
 * 全屏弹窗互斥裁决。
 * qt-notice-splash / qt-upgrade-popup / QtMetaPackGuide 都是 position:fixed +
 * z-index:999 的全屏遮罩，三者同时渲染会叠在一起：点击落在最上层遮罩上只会关掉
 * 那一层，下面那层原样不动，观感就是「两个弹窗重复了、点了没反应」。
 * 优先级：升级 > 公告 > 数据包引导。
 *  - 已弹出的升级不能被抽走（可能正在下载 / 正在拉起安装），沿用原先「升级优先于公告」；
 *  - 公告先于数据包引导（公告可能 dialogClosable=0，必须让用户看到）；
 *  - 数据包引导最后（本会话内点过「暂不」就不再弹，不会长期占位）。
 * 「升级等公告」的正常时序仍由 upgradeHold / noticeIdle 保证，这里只兜住竞态。
 */
const activePopup = computed((): string => {
  if (upgradeVisible.value) return "upgrade";
  if (noticeStore.splashNotice != null) return "splash";
  if (metaGuideVisible.value) return "meta";
  return "none";
});
// 弹层（公告/升级/数据包引导）期间临时隐藏 tabbar；平时宽屏隐藏（rail 取代）、竖屏显示
const popupBlocking = computed<boolean>(() => noticeStore.splashNotice != null || upgradeVisible.value || metaGuideVisible.value);
useQtTabBarSync(popupBlocking);
// activePopup 占用态镜像给启动弹窗队列（services/boot-modal-queue.ts）：队列在放下
// 一个引导前轮询它，首页这三个全屏弹窗在场时电池引导/更新提示/播放包引导都不冒出来。
// 用「页面持续上报、队列轮询读取」而不是让队列直接 watch 本页 computed——队列是
// service，没有组件生命周期，跨模块 watch 的 unwatch 收口比这行 watch 更绕。
// immediate 同步初值；声明必须在 activePopup 之后（上方 metaGuideVisible 同款 TDZ 教训）
watch(
  activePopup,
  (p: string): void => {
    homePopupStore.busy = p != "none";
  },
  { immediate: true }
);

/** 自定义导航页需自行让出状态栏高度 */
function statusBarPx(): number {
  try {
    const info = uni.getWindowInfo();
    return Math.round(info.statusBarHeight > 0 ? info.statusBarHeight : 0);
  } catch (_) {
    return 0;
  }
}
const headerPadStyle = computed((): string => "padding-top:" + (statusBarPx() + (layout.isWide ? 12 : 13)) + "px;");

const playlists = ref<Playlist[]>([]);
const songs = ref<Song[]>([]);
const charts = ref<Chart[]>([]);
// Stable preview arrays: unrelated playback/notice updates need not allocate slices.
const homePlaylists = computed((): Playlist[] => playlists.value.slice(0, 10));
const homeCharts = computed((): Chart[] => charts.value.slice(0, 4));
const homeSongs = computed((): Song[] => songs.value.slice(0, 8));
/**
 * 首屏加载态的响应式镜像（模板要读，`homeLoading` 是普通 let 只用于请求去重）。
 * 初值必须是 true：加载在 onMounted/onShow 里发起，首帧若按 false 渲染会先闪一下
 * 「暂无…」空态再跳到骨架。三个数据源各自到达即上屏，所以骨架按「loading 且该块为空」
 * 逐块撤下，不需要等整轮结束。
 */
const loading = ref(true);
/** 首屏请求失败过就置真：用一条可重试的横条代替「静默空列表 + toast」 */
const loadFailed = ref(false);
let loadedSource = "";
/** 上次加载时的包态指纹：安装/更新/卸载/启停音源包后指纹变化，触发整页重拉 */
let loadedPackFp = "";
// 加载序号：快速切音源时旧音源的慢响应晚到，不得覆盖新音源的首页数据（写回前比对）
let homeLoadSeq = 0;
/** 本轮加载是否仍在飞（onMounted 与 onShow 会前后脚各触发一次 ensureLoad） */
let homeLoading = false;
/** 在飞的那轮是为哪个音源拉的（换源时要立即作废它，不能等收尾） */
let homeLoadingSource = "";
/** 在飞期间包态指纹又变了：等本轮收尾再补拉一次（数据已进缓存，补拉不再发请求） */
let homeReloadPending = false;

async function load(): Promise<void> {
  homeLoading = true;
  homeLoadingSource = sourceStore.current;
  loading.value = true;
  loadFailed.value = false;
  // seq 必须在 try 之外声明：finally 里要用它判断「本轮是否已被新轮顶掉」
  const source = sourceStore.current;
  const seq = ++homeLoadSeq;
  const stale = (): boolean => seq !== homeLoadSeq;
  try {
    // 「新歌」单次响应 400KB 上下（v1/discovery/new/songs 的 limit 被服务端忽略，恒返回 100 首），
    // 原生桥 settleOp → quoteAscii 逐字符转义约 1.2s，且与推荐/榜单共用唯一一条引擎线程 ——
    // 让它先发就会把已经到货的推荐/榜单压在队列后面，所以延后到两块小数据上屏之后再发
    const runLatest = (): Promise<void> =>
      musicApi
        .latest(source as Source, 50, 0)
        .then((list) => {
          if (!stale()) songs.value = list;
        })
        .catch((error) => {
          logMsgErr("[QT Music Home Latest] " + source, error);
          if (!stale()) songs.value = [];
        });
    // 推荐与榜单各自到达即上屏，不设 Promise.all 屏障：结算按响应体大小在引擎线程上排队，
    // 等齐会让先到的小块数据一直压着不显示（实测首屏因此晚 2.5s 上下）
    const chartsTask = musicApi
      .charts(source as Source)
      .then((chartsResult) => {
        if (!stale()) charts.value = chartsResult;
      })
      .catch((error) => {
        logMsgErr("[QT Music Charts] " + source, error);
        if (!stale()) charts.value = [];
      });
    const recsTask = musicApi
      .recommendations(source as Source)
      .then((recs) => {
        if (!stale()) {
          playlists.value = recs;
          // 今日精选每次数据到货才重抽一次：同一轮里封面/标题/点击目标始终是同一个歌单
          pickFeatured(recs);
        }
      })
      .catch((error) => {
        logMsgErr("[QT Music Home Load] " + source, error);
        // 失败不弹 toast：顶部已有可重试横条，toast 只会盖住 hero
        if (!stale()) loadFailed.value = true;
      });
    await Promise.all([recsTask, chartsTask]);
    // 新歌放最后：与原来「无论推荐/榜单成败都拉新歌」一致
    if (!stale()) await runLatest();
  } finally {
    // 只有仍是当前那一轮才收尾：真换源时旧轮已被新轮顶掉（seq 不等），
    // 它不能再把 homeLoading 清掉，否则新轮就失去去重保护
    if (seq == homeLoadSeq) {
      homeLoading = false;
      // 整轮结束才撤骨架：失败的分支数组是空的，若只靠「有数据就撤」会永远转下去
      loading.value = false;
      if (homeReloadPending) {
        homeReloadPending = false;
        load();
      }
    }
  }
}
function retryLoad(): void {
  // loadedSource 也承担在途去重；显式重试必须作废上次失败的尝试标记。
  if (homeLoading) return;
  loadedSource = "";
  loadedPackFp = "";
  ensureLoad();
}
function ensureLoad(): void {
  // 冷启动时本地包态是异步从磁盘恢复的：恢复完成前 packsFingerprint() 恒为空态，
  // 直接拿它比对会让紧随 onMounted 的 onShow 误判「包变了」而再拉一整轮 ——
  // 推荐数据到货两次，今日精选就被重抽两次，首屏 hero 当场换一张（用户看到「加载两次」）。
  // 先等恢复完成，同一进程内的指纹最多只从空态变一次，两处调用自然并成一轮。
  ensureLocalStateRestored()
    .then(() => {
      ensureLoadNow();
    })
    .catch(() => {
      ensureLoadNow();
    });
}
function ensureLoadNow(): void {
  const fp = packsFingerprint();
  if (loadedSource == sourceStore.current && loadedPackFp == fp) return;
  loadedSource = sourceStore.current;
  loadedPackFp = fp;
  // 在飞期间包态又变了（onPacksChanged / onShow 兜底）：不能另起一轮，
  // 原生桥只有一条引擎线程，重复的那份 400KB 响应会把首屏继续压在队列后面 —— 并入在飞的那次。
  // 但真换源（音源不同）必须立刻另起一轮：在飞那轮的数据属于旧音源，不能沿用
  if (homeLoading && homeLoadingSource == sourceStore.current) {
    homeReloadPending = true;
    return;
  }
  homeReloadPending = false;
  playlists.value = [];
  songs.value = [];
  charts.value = [];
  load();
}
/**
 * 音源包变更（安装/更新/卸载/启停）广播：App 层更新弹窗确认时页面收不到
 * onShow，靠事件实时重拉；藏在页面栈底时也照样拉，回到时即已就绪。
 */
function onPacksChanged(): void {
  ensureLoad();
}
/**
 * 数据包安装引导（未装数据包时弹一次的全屏引导）：metaMissing 由
 * sourceUpdateStore 镜像（须等本地状态恢复后刷新），本会话内关掉过就不再弹
 * （onMetaGuideDismiss 置位）。安装动作在设置页完成，这里只指路。
 * （metaGuideVisible / metaGuideDismissedInSession 的声明在本页 setup 顶部）
 */
function onMetaGuideDismiss(): void {
  metaGuideDismissedInSession = true;
  metaGuideVisible.value = false;
}
/**
 * 刷新音源包状态（含「未安装」引导横幅与数据包引导弹窗）。
 * 必须先等本地状态恢复：恢复是异步的，页面 onShow 可能赶在预热之前，
 * 直接判定会把「已安装」误报成「未安装」。
 */
function refreshSourcePackState(): void {
  ensureLocalStateRestored().then(() => {
    sourceUpdateStore.refresh();
    metaGuideVisible.value = sourceUpdateStore.metaMissing && !metaGuideDismissedInSession;
  }).catch(() => {
    sourceUpdateStore.refresh();
  });
}
/**
 * 去音源包管理页装音源包。
 * 直接跳 pages/source-pack/index：引导文案说的就是「在『音源包管理』页安装一次」，
 * 而设置页里的「音源包管理」只是一个入口（见 pages/settings/index.uvue 的说明），
 * 先跳设置页会让人以为「点了没反应」——App.uvue 的「未安装播放音源包」弹窗同样直跳该页。
 * （两者都不是 tab 页，用 navigateTo）
 */
function goSourcePack(): void {
  uni.navigateTo({ url: "/pages/source-pack/index" });
}
/**
 * 横幅点击 → 播放包半屏直装（官方包一键安装）。用户直接点的横幅**不进启动
 * 弹窗队列**：队列是给系统侧引导串行用的，用户点击要立即响应——且首页三个
 * 全屏弹窗在场时横幅本来就被遮罩盖住点不到，无重叠可治。拿不到官方包 offer
 * （离线/无发布/版本被拉黑）时退回老行为：直跳音源包管理页。注意区分收口
 * 结果——「dismissed」是用户主动关掉半屏，不跳转；只有「unavailable」才兜底跳转。
 */
function openPackSheetFromBanner(): void {
  openPackInstallSheet().then((result: string): void => {
    if (result == PACK_SHEET_UNAVAILABLE) goSourcePack();
  });
}
onMounted(() => {
  sourceStore.restore();
  sourceRegistry.ensure();
  ensureLoad();
  refreshSourcePackState();
  applyNoticeBar();
  uni.$on(SOURCE_PACKS_CHANGED_EVENT, onPacksChanged);
});
onShow(() => {
  resetHomeBack();
  qtTrackPage("pages/home/index");
  // 宽屏托管覆盖层的可见性里有非响应式 qtTopRoute()，回宿主的瞬间强制重估一次
  qtWideWorkspaceRefresh();
  sourceStore.restore();
  ensureLoad();
  refreshSourcePackState();
  applyNoticeBar();
  loadLocalMixes();
});
// 首页返回由一个持久化单选偏好控制。关闭弹层/工具不计入退出次数，离开首页重置。
// 退出仍走 stopForExit 保留队列和进度；回到后台只移动原生任务，不能停播。
let lastBackAt = 0;
function resetHomeBack(): void { lastBackAt = 0; }
onHide(resetHomeBack);
watch((): string => homeBackSettings.mode, resetHomeBack);
onBackPress((options: OnBackPressOptions): boolean => {
  // 程序化 navigateBack 不拦截
  if (options.from != "backbutton") return false;
  if (homeActionSheet.visible.value) {
    resetHomeBack();
    qtActionSheetCancel();
    return true;
  }
  if (closePlaybackQueue()) { resetHomeBack(); return true; }
  // 宽屏就地托管的工具页先关：它是覆盖层、不在页面栈里，返回键要一层层退
  if (qtCloseWideTool()) { resetHomeBack(); return true; }
  if (homeBackSettings.mode == "background") {
    resetHomeBack();
    moveAppToBackground();
    return true;
  }
  const now = Date.now();
  if (lastBackAt > 0 && now >= lastBackAt && now - lastBackAt < 2000) {
    resetHomeBack();
    player.stopForExit();
    exitApp();
    return true;
  }
  lastBackAt = now;
  qtShowToast({ title: "再按一次退出应用", icon: "none" });
  return true;
});
async function play(song: Song): Promise<void> {
  // 不预取在线地址：解析桥（onResolveRequest）在起播那一刻才取链，且取链前
  // 先走本地优先（下载账本身份级/跨源元数据级→本地曲库）。在这里预取会把在线
  // urlSize 灌进码率显示，本地命中后还显示在线码率，像「还是在线」（m22743）。
  try {
    await player.playSingle(song);
  } catch (_) {
    // 起播失败：同口径提示，不留无声失败
    qtShowToast({ title: "该歌曲暂时无法播放", icon: "none" });
  }
}
function goSearch(): void { qtRailNavigate("/pages/search/index"); }
function showDaily(): void { qtRailNavigate("/pages/daily/index"); }
function goDailyRecommend(): void { qtRailNavigate("/pages/daily-recommend/index"); }
function goRadio(): void { qtRailNavigate("/pages/radio/index"); }
function goPodcast(): void { qtRailNavigate("/pages/podcast/index"); }
function showChart(): void { qtRailNavigate("/pages/chart/index"); }
function goPlaylists(): void { qtRailNavigate("/pages/playlists/index"); }
function openPlaylist(list: Playlist): void {
  uni.navigateTo({ url: "/pages/playlist/index?id=" + encodeURIComponent(list.id) + "&platform=" + encodeURIComponent(list.platform) });
}
function openChart(chart: Chart): void {
  // 必须带 name/desc/pic：歌单页从 query 里取这三个字段，缺了封面就空、榜单名退化成"排行榜"。
  // （pages/chart/index.uvue 的同类跳转带全了参数，只有这里漏了。）
  uni.navigateTo({
    url:
      "/pages/playlist/index?id=" +
      encodeURIComponent(chart.id) +
      "&platform=" +
      encodeURIComponent(chart.platform) +
      "&type=chart" +
      "&name=" +
      encodeURIComponent(chart.name) +
      "&desc=" +
      encodeURIComponent(chart.description || "") +
      "&pic=" +
      encodeURIComponent(chart.picUrl || ""),
  });
}
/** 今日精选歌单：从推荐列表里随机挑一个，而不是永远取第一个。
 *  随机只在「这一轮推荐数据到货」时抽一次（见 load 的 recsTask），之后滚动/刷新视图
 *  都沿用同一个，避免卡片封面与标题每次重算都对不上。抽中的索引只在本轮数据内有效，
 *  数组被换掉（换源/重拉）时由 pickFeatured 重新收敛到合法范围。 */
const featuredIndex = ref(0);
const featuredName = computed<string>(() => {
  if (playlists.value.length == 0) return "正在准备你的音乐";
  const i = featuredIndex.value;
  return playlists.value[i < playlists.value.length ? i : 0].name;
});
const featuredPicUrl = computed<string>(() => {
  if (playlists.value.length == 0) return "";
  const i = featuredIndex.value;
  return playlists.value[i < playlists.value.length ? i : 0].picUrl || "";
});
/** 上一次抽中的歌单（音源 + 歌单 id）：推荐走 music-api 的 60s 短缓存，
 *  重拉常拿到同一份列表——只要抽中的那个还在前 10 里就继续用它，
 *  否则首屏画完之后 hero 会当场换一张（用户看到「加载两次不一样」）。 */
let featuredSource = "";
let featuredId = "";
/** 本轮推荐到货后确定今日精选；「一次加载只抽一次」由这里保证：
 *  同一音源下已抽中的歌单仍在列表里就沿用（不重抽），换源或它掉出前 10 才重抽。
 *  抽取范围限定在下方歌单架实际展示的前 10 个（homePlaylists 同一区间），
 *  避免 hero 抽到一张架子上根本看不到的歌单。 */
function pickFeatured(list: Playlist[]): void {
  const n = Math.min(10, list.length);
  if (n <= 0) {
    featuredIndex.value = 0;
    return;
  }
  if (featuredSource == sourceStore.current && featuredId.length > 0) {
    for (let i = 0; i < n; i++) {
      if (list[i].id == featuredId) {
        featuredIndex.value = i;
        return;
      }
    }
  }
  const idx = Math.floor(Math.random() * n);
  featuredIndex.value = idx;
  featuredSource = sourceStore.current;
  featuredId = list[idx].id;
}
function playFeatured(): void {
  if (playlists.value.length > 0) openPlaylist(playlists.value[featuredIndex.value < playlists.value.length ? featuredIndex.value : 0]);
}
/**
 * 宽屏内容宽：**由 qt-page-frame 决定**（width-kind="grid" → 900~1600 连续夹紧，
 * 且已扣掉左侧 rail 与两侧 gutter）。
 *
 * 改造前这里自己按 1360 反算，再拿 `qtSideNavPad` 给 rail 让位 —— 页面和框架各算一套
 * 宽度，框架改成连续宽度后必然对不上（页面还按 1360 算，实际内容列可能是 1200）。
 * 现在只读同一个令牌函数，两边永远一致；页面自己不再写 padding-left。
 */
const wideHomeWidth = computed<number>(() => qtContentWidth("grid"));
const homeSearchStyle = computed((): string => {
  const base = "background-color:" + themeStore.skin.surface + ";border-color:" + themeStore.skin.border + ";";
  return base + (layout.isWide ? "flex:none;width:" + Math.max(100, Math.min(480, wideHomeWidth.value - 230)) + "px;" : "");
});
const hdHome = computed(() => qtHdHomeMetrics(wideHomeWidth.value, fontScale.scale));
const wideHomeStyle = computed((): string => "width:" + wideHomeWidth.value + "px;");
const wideFeatureStyle = computed((): string => "width:" + hdHome.value.featurePx + "px;min-height:" + Math.round(196 * Math.max(1, fontScale.scale)) + "px;background-color:" + themeStore.skin.accent + ";");
const wideFeatureCoverStyle = computed((): string => {
  const size = Math.min(136, Math.round(hdHome.value.featurePx * 0.24));
  return "width:" + size + "px;height:" + size + "px;";
});
const wideShortcutGroupStyle = computed((): string => "width:" + (hdHome.value.featureSplit && showPlaylists.value ? hdHome.value.shortcutPx : hdHome.value.innerPx) + "px;");
const wideShelfStyle = computed((): string => "width:" + hdHome.value.innerPx + "px;height:" + Math.ceil(hdHome.value.cardPx + 18 + 57 * fontScale.scale) + "px;");
const wideShelfRowStyle = computed((): string => "width:" + Math.max(hdHome.value.innerPx, (hdHome.value.cardPx + 12) * (loading.value && playlists.value.length == 0 ? 8 : Math.min(10, playlists.value.length))) + "px;");
const wideEntries = [
  { title: "每日推荐", subtitle: "按你的口味发现音乐", icon: "sparkles", route: "/pages/daily-recommend/index" },
  { title: "私人 FM", subtitle: "让喜欢的音乐接着播放", icon: "music", route: "/pages/radio/index" },
  { title: "播客", subtitle: "继续收听你的订阅", icon: "mic", route: "/pages/podcast/index" },
];
function openWideEntry(route: string): void { qtRailNavigate(route); }
function wideShortcutStyle(index: number): string {
  const stacked = hdHome.value.featureSplit && showPlaylists.value;
  const width = stacked ? hdHome.value.shortcutPx : Math.floor((hdHome.value.innerPx - 24) / 3);
  return "width:" + width + "px;min-height:" + Math.round(60 * Math.max(1, fontScale.scale)) + "px;margin-right:" + (!stacked && index < 2 ? 12 : 0) + "px;background-color:" + themeStore.skin.surface + ";";
}
const wideSongRows = computed<Song[][]>(() => {
  const rows: Song[][] = [];
  const list = songs.value.slice(0, hdHome.value.songColumns * 3);
  for (let i = 0; i < list.length; i += hdHome.value.songColumns) rows.push(list.slice(i, i + hdHome.value.songColumns));
  return rows;
});
const wideChartRows = computed<Chart[][]>(() => {
  const rows: Chart[][] = [];
  const list = charts.value.slice(0, hdHome.value.songColumns * 2);
  for (let i = 0; i < list.length; i += hdHome.value.songColumns) rows.push(list.slice(i, i + hdHome.value.songColumns));
  return rows;
});
function wideMusicCellStyle(column: number): string {
  return "width:" + hdHome.value.songPx + "px;min-height:" + Math.ceil(64 * Math.max(1, fontScale.scale)) + "px;margin-right:" + (column < hdHome.value.songColumns - 1 ? 24 : 0) + "px;";
}
/** 横滑架卡间距：与歌单网格同宽 14rpx，卡宽用 px 时它也必须换算成 px 才能对齐。
    换算规则与 qtRpx 一致（1rpx = windowWidth / 750，uni-app x 没有任何封顶），
    但必须显式读 layout.windowWidth，否则这个 computed 没有响应式依赖，
    窗口变化后会被 Vue 缓存住不再重算 */
const shelfGapPx = computed<number>(() => {
  return Math.round(14 * (layout.windowWidth / 750));
});
/**
 * 横滑架卡宽：一行 2.5 张（两张整卡 + 半张露头，提示可以横滑），随窗口宽度实时缩放。
 * 容器内宽 = 窗口 - (页面 24rpx + 卡片 26rpx) * 2 边距，间距含末卡一并计入。
 * 以前这里写死 104px：竖屏页面其余部分都按 rpx 随窗口缩放，长屏手机上只有这排卡不动，
 * 整块显得偏小；卡名 13px / 播放数 11px 也比歌单页的 28rpx 小一号。
 * 现在整句只依赖 win × n / 750 与 qtRpx（两者 2026-10-20 起已同源，且 qtRpx 不再
 * 在宽窗口按 375 基准折算），所以卡宽会跟着窗口一起长。
 */
const shelfCardWidth = computed<number>(() => {
  const win = layout.windowWidth;
  const inner = win - win * (100 / 750);
  const gap = win * (14 / 750);
  return Math.min(Math.round(qtRpx(340)), Math.max(112, Math.floor((inner - gap * 2) / 2.5)));
});
/** 横滑架整行宽度：原生端横向 scroll-view 不自动撑开，必须显式给出 */
const shelfWidthPx = computed<number>(() => {
  const n = playlists.value.length > 0 ? Math.min(10, playlists.value.length) : 1;
  return n * (shelfCardWidth.value + shelfGapPx.value) + 4;
});
/**
 * 横滑架高度：封面 + 名称两行(2×42rpx) + 播放数一行(30rpx) + 间距与底部余量，
 * 与 .shelf-name / .shelf-count 的字号行高一一对应。
 * 矮了会裁掉封面，高了会在卡下留出一大片空白（原先写死 370rpx，长屏上空白尤其明显）。
 */
const shelfHeightPx = computed<number>(() => Math.round(shelfCardWidth.value + qtRpx(26 + 114 * fontScale.scale)));
const heroStyle = computed<string>(() => "background-color:" + themeStore.skin.accent + ";");
/** 快捷磁贴宽：每行固定 2 枚（2026-10-24 起 4 枚改 2 行 2 列，用户嫌一行 4 枚太挤）。
 *  磁贴带 margin-right 14rpx（含行尾），因此每行减 2 份间距；flex-wrap 按 2 枚换行
 *  （2026-11-04 起磁贴共 6 枚常显时排 3 行：原四枚在前，私人 FM / 播客 随后换行）。 */
const quickPillWidth = computed<number>(() => {
  const win = layout.windowWidth;
  const pad = win * (24 / 750);
  const gap = win * (14 / 750);
  return Math.floor((win - pad * 2 - gap * 2) / 2);
});
// 2026-10-19 起全站播放量/大数字统一走 services/format.ts（搜索页曾漏掉万位换算）
const formatCount = formatBigCount;
</script>
<style>
/* 宽屏托管覆盖层的 pane（页面槽位解耦后样式随插槽内容落在本页作用域；
   覆盖层 stage 是 fixed 铺满，pane 四边钉死其上，见 qt-wide-workspace.uvue） */
.qtww-pane {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}
.home-page { flex: 1; min-height: 0; }
.home-body { flex: 1; min-width: 0; min-height: 0; flex-direction: column; }
.home-scroll { flex: 1; min-height: 0; }
/* 失败横条：与 source-tip 同宽同圆角，用「卡片 + 警告图标」而不是大块橙底，
   避免和上方音源包引导条撞色抢视觉重心 */
.home-fail { margin: 0 26rpx 12rpx; padding: 18rpx 22rpx; flex-direction: row; align-items: center; border-width: 1px; border-style: solid; border-radius: 16rpx; }
.home-fail-wide { margin: 0 20px 10px; padding: 10px 14px; border-radius: 10px; }
.home-fail-text { flex: 1; min-width: 0; margin-left: 12rpx; }
.home-fail-btn { margin-left: 16rpx; padding: 0 20rpx; height: 56rpx; align-items: center; justify-content: center; border-radius: 28rpx; }
.home-fail-btn-text { font-weight: 600; }
.home-header { padding: 26rpx 26rpx 18rpx; flex-direction: row; align-items: center; }
.home-search { flex: 1; min-width: 0; height: 88rpx; margin-left: 12rpx; padding: 0 20rpx; flex-direction: row; align-items: center;  border-width: 1px; border-style: solid; border-radius: 16rpx; }
.home-search-text { margin-left: 12rpx; color: #737b8e; font-size: 23rpx; }
.home-bell { position: relative; width: 88rpx; height: 88rpx; margin-left: 12rpx; align-items: center; justify-content: center;  border-width: 1px; border-style: solid; border-radius: 16rpx; }
.home-bell-dot { position: absolute; top: 8rpx; right: 8rpx; min-width: 26rpx; height: 26rpx; padding: 0 6rpx; align-items: center; justify-content: center; background-color: #1f2430; border-radius: 13rpx; }
.home-bell-dot-text { color: #ffffff; font-size: 16rpx; }
.portrait-home { padding: 0 24rpx 140rpx; }
.portrait-hero { position: relative; padding: 36rpx 32rpx; flex-direction: row; align-items: center; border-radius: 28rpx; overflow: hidden; }
/* 底图铺满卡片：外层 .hero-bg-wrap 是 view，绝对定位四边 0 —— 与 .hero-scrim 同款写法，
   实测能铺满整卡（遮罩一直是好的，就是证据）；image 在外层里 width/height:100%，
   拿到的是外层已确定的尺寸（同 pages/theme 的 .wallpaper-image 与 pages/player 的 .bg）。
   历史一：最早用「image 四边 0」，app-uvue 实测 image 的 right:0 不生效，只拿到行内剩余宽度
   （770 宽窗口约 518px），卡片右侧露一条 accent 底色。
   历史二：改成「image 只写上/左/下三边 + 内联 px 宽度」，横向修好了，但 bottom:0 对 image
   同样不生效，高度退化成按宽高比推出的方图（约 330px），「立即播放」那一带约 100px 露出
   被遮罩压暗的 accent 底色 —— 2026-10 用户报的「背景图片没有占满整个屏幕」就是这一条。
   结论：image 的绝对定位只认「左上 + 显式宽高」，不认 right/bottom 拉伸；要拉伸就套一层 view。
   同层里写在后面的兄弟节点后绘制，所以文案自然压在底图与遮罩之上。
   圆角自己再写一遍 28rpx（与 .portrait-hero 同值）：父级虽有 overflow:hidden，
   但绝对定位子节点在原生端不一定被父级圆角裁掉，宁可两层各自带圆角 */
.hero-bg-wrap { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 28rpx; }
.hero-bg { width: 100%; height: 100%; border-radius: 28rpx; }
.hero-scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; border-radius: 28rpx; }
.portrait-hero-copy { position: relative; flex: 1; min-width: 0; }
.hero-kicker { color: rgba(255,255,255,0.72); font-size: 20rpx; font-weight: 700; }
.hero-title { margin-top: 10rpx; color: #ffffff; font-size: 40rpx; line-height: 52rpx; font-weight: 800; }
.hero-desc { margin-top: 10rpx; color: rgba(255,255,255,0.78); font-size: 22rpx; }
.hero-play { margin-top: 24rpx; align-self: flex-start; min-height: 72rpx; padding: 12rpx 28rpx; flex-direction: row; align-items: center; background-color: #ffffff; border-radius: 32rpx; }
.hero-play-text { margin-left: 8rpx; font-size: 24rpx; font-weight: 700; }
.quick-grid { margin-top: 20rpx; flex-direction: row; flex-wrap: wrap; }
/* 私人 FM / 播客磁贴与其余磁贴同一套 .quick-pill 样式、参与同一个 flex-wrap 换行，
   只是排在最末（用户 2026-11-04：跟着前面的动态磁贴排到最后） */
.quick-pill { height: 76rpx; margin-bottom: 14rpx; margin-right: 14rpx; padding: 0 22rpx; flex-direction: row; align-items: center; border-radius: 38rpx; }
.quick-label { margin-left: 12rpx; font-size: 24rpx; font-weight: 600; }
.section { margin-top: 18rpx; padding: 26rpx;  border-width: 1px; border-style: solid; border-radius: 26rpx; }
.section-head { flex-direction: row; align-items: flex-end; justify-content: space-between; }
.section-copy { flex-direction: column; }

.section-title { margin-top: 0; font-size: 34rpx; font-weight: 700; }
/* 尺寸由脚本按窗口宽度算出（shelfCardWidth / shelfHeightPx）：卡宽随窗口缩放，
   字号改用 rpx 与页面其余文本一致——原先写死 104px 卡 + 13px/11px 字，
   在长屏手机上页面其余部分随 rpx 放大、只有这一排不变，看起来就偏小 */
.shelf-scroll { margin-top: 22rpx; }
/* 骨架屏容器：position:relative 是扫光带的定位基准（qt-skeleton-shine 铺满父级）；
   高度由脚本给，与真实歌单架同高，数据到达时不会跳一下 */
.shelf-skel { position: relative; margin-top: 22rpx; overflow: hidden; }
/* 宽屏的 .wide-song-grid / .wide-playlist-grid 是 row+wrap，骨架组件直接当 flex item
   会被压成内容宽（百分比与换行基准全错），必须包一层满宽容器 */
.sk-fill { width: 100%; }
.shelf-row { flex-direction: row; }
.shelf-cover { border-radius: 16rpx; }
.shelf-name { margin-top: 12rpx; font-size: 32rpx; line-height: 42rpx; font-weight: 600; }
.shelf-count { margin-top: 6rpx; font-size: 23rpx; line-height: 30rpx; }
.section-more { flex-direction: row; align-items: center; }
.section-more-text { color: #8a919f; font-size: 21rpx; }
.chart-list { margin-top: 20rpx; }
/* 与 .song-row 同款扁平行：去灰底卡片，只留分隔线（分隔线颜色由模板按主题覆盖） */
.chart-row { height: 136rpx; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-style: solid; }
.chart-cover { width: 92rpx; height: 92rpx; border-radius: 14rpx;  }
.chart-info { flex: 1; min-width: 0; margin-left: 22rpx; }
.chart-name { color: #1b202b; font-size: 30rpx; font-weight: 600; text-overflow: ellipsis; }
.chart-meta { margin-top: 8rpx; color: #737b8e; font-size: 23rpx; text-overflow: ellipsis; }
.song-list { margin-top: 18rpx; }
.song-row { height: 136rpx; flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-style: solid; }
.song-cover { width: 92rpx; height: 92rpx; border-radius: 14rpx;  }
.song-info { flex: 1; min-width: 0; margin-left: 22rpx; }
.song-name { color: #1b202b; font-size: 30rpx; font-weight: 600; text-overflow: ellipsis; }
.song-meta { margin-top: 8rpx; color: #737b8e; font-size: 23rpx; text-overflow: ellipsis; }
/* 播放按钮：整行不可点，唯一入口是这枚圆形按钮。
   白色底 + 细描边 + 极淡投影：新歌速递的行本身就在白色卡片上，
   纯白圆形会融入背景，必须靠描边和投影勾出轮廓才看得清。
   底色是中性表面色（浅白 / 深色半透明白），不绑定任何品牌色，
   换皮肤时靠 .play-btn-dark 跟随深浅色；图标色取 skin.text 跟随皮肤。
   外层 .play-hit 负责 88rpx 触达区，内层 .play-btn 只负责视觉形态。 */
.play-hit { width: 88rpx; height: 88rpx; align-items: center; justify-content: center; }
.play-btn { width: 64rpx; height: 64rpx; border-radius: 32rpx; align-items: center; justify-content: center; }
.home-empty { height: 160rpx; align-items: center; justify-content: center; }
.home-empty-text { color: #929aa8; font-size: 23rpx; }
/* 未安装音源包引导：整条可点，底色取皮肤的 accentSoft，图标/文字色都走皮肤变量 */
.source-tip { flex-direction: row; align-items: center; margin: 12rpx 24rpx 0 24rpx; padding: 20rpx 22rpx; border-radius: 18rpx; }
.source-tip-copy { flex: 1; min-width: 0; margin-left: 18rpx; }
.source-tip-title { font-size: 27rpx; font-weight: 600; }
.source-tip-desc { margin-top: 6rpx; font-size: 22rpx; }
/* 宽屏：.source-tip 只被 sourceMissing 门控，宽屏同样渲染，rpx 会放大 2.7 倍。
   间距按宽屏 px 重给（外壳 .wide-shell 自身已有 16px 内边距，这里不再叠 34px）。 */
.source-tip-wide { margin: 12px 16px 0 16px; padding: 12px 14px; border-radius: 10px; }
.source-tip-copy-wide { margin-left: 10px; }

.home-bell-dot-wide { min-width: 18px; height: 18px; border-radius: 9px; top: 3px; right: 3px; padding-left: 4px; padding-right: 4px; }
.home-bell-dot-text-wide { font-size: 11px; }
.wide-kicker { color: #8a919f; font-size: 11px; font-weight: 700; }
.wide-more-text { color: #8a919f; font-size: 13px; }
.wide-empty { height: 48px; align-items: center; justify-content: center; }
.wide-empty-text { color: #929aa8; font-size: 12px; }
.home-header-wide { padding-left: 16px; padding-right: 16px; padding-bottom: 8px; }
.home-search-wide { height: 40px; border-radius: 10px; margin-left: 10px; padding-left: 14px; padding-right: 14px; }
.home-search-text-wide { margin-left: 8px; font-size: 13px; }
.home-bell-wide { width: 40px; height: 40px; border-radius: 10px; margin-left: 10px; }
.wide-home { align-self: center; padding: 8px 16px 32px; }
.wide-feature-row { flex-direction: column; }
.wide-feature-row-split { flex-direction: row; align-items: stretch; }
.wide-feature { position: relative; padding: 24px; flex-direction: row; align-items: center; border-radius: 16px; overflow: hidden; flex-shrink: 0; }
.wide-feature-backdrop { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.wide-feature-bg { width: 100%; height: 100%; }
.wide-feature-scrim { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.wide-feature-cover { position: relative; border-radius: 10px; margin-right: 24px; flex-shrink: 0; }
.wide-feature-copy { position: relative; flex: 1; min-width: 0; }
.wide-feature-kicker { color: rgba(255,255,255,0.80); font-weight: 500; }
.wide-feature-title { margin-top: 8px; color: #ffffff; font-weight: 700; }
.wide-feature-desc { margin-top: 8px; color: rgba(255,255,255,0.80); }
/* 两个入口共用 44px 触达高度；不要用 min-height + 纵向 padding 撑开原生 flex 行。 */
.wide-feature-actions { margin-top: 18px; min-height: 44px; flex-direction: row; align-items: center; flex-wrap: wrap; flex-shrink: 0; }
.wide-primary { height: 44px; padding: 0 16px; flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; background-color: #ffffff; border-radius: 22px; margin-right: 12px; }
.wide-primary-text { margin-left: 6px; font-weight: 600; }
.wide-secondary { height: 44px; flex-direction: row; align-items: center; justify-content: center; flex-shrink: 0; }
.wide-secondary-text { color: #ffffff; margin-right: 4px; }
.wide-shortcuts { flex-direction: row; margin-top: 12px; }
.wide-shortcuts-split { flex-direction: column; margin-left: 16px; margin-top: 0; justify-content: space-between; }
.wide-shortcut { flex-direction: row; align-items: center; padding: 10px; border-radius: 12px; }
.wide-shortcut-inline { flex-direction: column; justify-content: center; }
.wide-shortcut-icon { width: 36px; height: 36px; border-radius: 10px; align-items: center; justify-content: center; flex-shrink: 0; }
.wide-shortcut-copy { flex: 1; min-width: 0; margin-left: 10px; }
.wide-shortcut-copy-inline { flex: none; margin-left: 0; margin-top: 8px; }
.wide-shortcut-title { font-weight: 600; }
.wide-shortcut-desc { margin-top: 4px; }
.wide-panel { margin-top: 28px; }
.wide-panel-head { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.wide-panel-title { font-weight: 600; }
.wide-playlist-row { flex-direction: row; }
.wide-playlist-card { margin-right: 12px; flex-shrink: 0; }
.wide-playlist-cover { border-radius: 10px; }
.wide-playlist-name { margin-top: 9px; font-weight: 500; }
.wide-playlist-count { margin-top: 4px; }
.wide-song-grid { flex-direction: row; }
.wide-song-row { flex-direction: row; align-items: center; flex-shrink: 0; padding: 6px 0; }
.wide-song-cover { width: 46px; height: 46px; border-radius: 8px; flex-shrink: 0; }
.wide-song-info { flex: 1; min-width: 0; margin-left: 12px; }
.wide-song-play { width: 40px; height: 40px; margin-left: 4px; flex-shrink: 0; justify-content: center; align-items: center; }
.wide-song-name { font-weight: 500; text-overflow: ellipsis; }
.wide-song-meta { margin-top: 5px; text-overflow: ellipsis; }
.wide-chart-row { flex-direction: row; align-items: center; padding: 8px 0; border-bottom-width: 1px; border-bottom-style: solid; flex-shrink: 0; }
.wide-chart-cover { width: 48px; height: 48px; border-radius: 8px; flex-shrink: 0; }
.wide-chart-info { flex: 1; min-width: 0; margin-left: 12px; margin-right: 8px; }
.wide-chart-name { font-weight: 500; text-overflow: ellipsis; }
.wide-chart-meta { margin-top: 5px; text-overflow: ellipsis; }
/* 桌面指针反馈：只在宽屏启用（手机上 hover-class 会在点按瞬间闪一下） */
.shelf-card-hover { background-color: rgba(255, 255, 255, 0.06); border-radius: 12px; }
.chart-row-hover { background-color: rgba(255, 255, 255, 0.06); }
.wide-row-hover { background-color: rgba(255, 255, 255, 0.06); border-radius: 8px; }
