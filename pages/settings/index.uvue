<template>
  <qt-page-frame width-kind="flow" :refresh-key="refreshKey">
    <!-- 设置总览的 UI 与数据全部在 qt-settings-overview 里：
         宽屏三栏模式下，同一份总览还要出现在设置子页的中间栏，两处必须是
         同一份实时数据（音源、倍速、并发、日志占用…），抄两份必然漂移。
         本页只负责「宿主」该做的事：把 onShow 这个事件透传进去重新对账。 -->
    <qt-settings-overview :refresh-key="refreshKey" />
  </qt-page-frame>
</template>

<script setup lang="ts">
import { ref } from "vue";
import { onShow } from "@dcloudio/uni-app";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import QtSettingsOverview from "@/uni_modules/qt-ui/components/qt-settings-overview/qt-settings-overview.uvue";

/**
 * 返回本页时递增，通知总览重新对账（权限 / 工具开关 / 音源包状态 / 桌面歌词 / 日志占用）。
 *
 * 为什么不用页面自己持有那堆 store：中间栏里的同一份总览是框架渲染的，
 * 拿不到页面生命周期，只能由宿主把「页面显示了」这个事件作为属性传下去。
 */
const refreshKey = ref(0);

onShow((): void => {
  refreshKey.value = refreshKey.value + 1;
});
</script>
