.page {
  flex: 1;
}
.list {
  flex: 1;
  padding: 16rpx 0 40rpx;
}
.list-wide {
  padding: 12px 0 24px;
}
.group {
  margin-top: 20rpx;
  margin-left: 24rpx;
  margin-right: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;

  border-width: 1px;

}
.cell {
  height: 96rpx;
  padding: 0 32rpx;
  flex-direction: row;
  align-items: center;
  border-bottom-width: 1px;
}
.cell-no-border {
  border-bottom-width: 0;
}
.cell-icon {
  margin-right: 20rpx;
}
.cell-title {
  flex: 1;

  font-size: 28rpx;
  font-weight: 500;
}
.cell-title-danger {

}
.cell-right {
  flex-direction: row;
  align-items: center;
}
.cell-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background-color: #ff4b4b;
}
.cell-value {

  font-size: 24rpx;
  margin-right: 12rpx;
}
/* 宽屏下 rpx 会随窗口放大膨胀，固定 px 尺寸 */
.group-wide { margin-top: 14px; margin-left: 24px; margin-right: 24px; border-radius: 14px; }
.cell-wide { height: 64px; padding-left: 24px; padding-right: 24px; }
.cell-title-wide { font-size: 17px; }
.cell-value-wide { font-size: 14px; }
.cell-icon-wide { margin-right: 10px; }
</style>
