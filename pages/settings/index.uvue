  padding: 12px 0 24px;
}
.group {
  margin-top: 20rpx;
  margin-left: 24rpx;
  margin-right: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;

  border-width: 1px;

}
.cell {
  height: 96rpx;
  padding: 0 32rpx;
  flex-direction: row;
  align-items: center;
  border-bottom-width: 1px;
}
.cell-no-border {
  border-bottom-width: 0;
}
.cell-icon {
  margin-right: 20rpx;
}
.cell-title {
  flex: 1;

  font-size: 28rpx;
  font-weight: 500;
}
.cell-title-danger {

}
.cell-right {
  flex-direction: row;
  align-items: center;
}
.cell-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background-color: #ff4b4b;
}
.cell-value {

  font-size: 24rpx;
  margin-right: 12rpx;
}
/* 宽屏下 rpx 会随窗口放大膨胀，固定 px 尺寸 */
.group-wide { margin-top: 14px; margin-left: 24px; margin-right: 24px; border-radius: 14px; }
.cell-wide { height: 64px; padding-left: 24px; padding-right: 24px; }
.cell-title-wide { font-size: 17px; }
.cell-value-wide { font-size: 14px; }
.cell-icon-wide { margin-right: 10px; }

/* 自定义缓存上限：页内输入弹层（遮罩 + 居中卡片），宽窄两套尺寸（同 source-pack 的 url 弹层） */
.cache-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background-color: rgba(0, 0, 0, 0.45);
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.cache-card {
  width: 560rpx;
  padding: 32rpx 28rpx 24rpx;
}
.cache-card-wide {
  width: 480px;
  padding: 22px 24px 18px;
}
.cache-title {
  font-size: 30rpx;
  font-weight: 600;
}
.cache-title-wide {
  font-size: 17px;
}
.cache-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
}
.cache-desc-wide {
  margin-top: 4px;
  font-size: 13px;
}
.cache-input {
  margin-top: 22rpx;
  height: 78rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}
.cache-input-wide {
  margin-top: 12px;
  height: 40px;
  padding: 0 12px;
  font-size: 14px;
}
.cache-ph {
  font-size: 24rpx;
  color: #9aa1b0;
}
.cache-ph-wide {
  font-size: 13px;
  color: #9aa1b0;
}
.cache-error {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
}
.cache-error-wide {
  margin-top: 6px;
  font-size: 12px;
}
.cache-btn-row {
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 26rpx;
}
