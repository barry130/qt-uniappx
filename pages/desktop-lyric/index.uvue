  font-size: 12px;
  margin-right: 6px;
}
.cell-value-wide {
  font-size: 14px;
}
/* 控件行：标题在 .cell 里，控件本体在下面这块，左右内边距与 .cell 对齐。
   包裹型内容（色块、字体按钮）用 margin-top 做行间距，末行不会多出下边距 */
.cell-body {
  padding: 1px 16px 5px;
  flex-direction: column;
  border-bottom-width: 1px;
}
.cell-body-wide {
  padding: 2px 24px 10px;
}
