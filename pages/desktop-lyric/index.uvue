}
.switch-on {
  justify-content: flex-end;
}
.switch-dot {
  width: 20px;
  height: 20px;
  border-radius: 10px;
  background-color: #ffffff;
}

/* 实时预览：固定深色底，模拟悬浮窗在壁纸上的观感，颜色判断才准。
   背景层绝对定位铺满整个盒子（含内边距），对应原生 box.setBackgroundColor 覆盖 padding；
   内容层留在常规流里撑高盒子，所以盒子自身不再设内边距 */
.preview-box {
  position: relative;
  border-radius: 9px;
  background-color: #12161d;
}
.preview-box-wide {
  border-radius: 11px;
}
.preview-bg {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
