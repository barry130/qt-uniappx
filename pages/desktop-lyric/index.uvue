  min-height: 64px;
  padding-left: 24px;
  padding-right: 24px;
}
.cell-no-border {
  border-bottom-width: 0;
}
.cell-icon {
  margin-right: 10px;
}
/* 行标题/取值手机字号 = 设置页 rpx / 2（标题 28rpx→14px、取值 24rpx→12px）：
