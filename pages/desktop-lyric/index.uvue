  min-height: 85px;
  padding: 17px 10px;
  align-items: center;
  justify-content: center;
}
.preview-inner-wide {
  min-height: 108px;
  padding: 22px 16px;
}
/* 描边 / 阴影层绝对定位叠在填充层上；填充层留在流里决定行高。
   只给 left + width（不给 right）：偏移是内联 left，若同时钉住 right 会让叠加层
   随偏移量变窄，描边宽度越大字越挤 */
.preview-line {
