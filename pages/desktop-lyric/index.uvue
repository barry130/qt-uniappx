}
.preview-fill {
  width: 100%;
}
.preview-tr {
  width: 100%;
}

/* 描边宽度拖拽条（几何常量与脚本里的 thumbSize() 必须同步） */
.stroke-track {
  position: relative;
  height: 30px;
}
.stroke-track-wide {
  height: 44px;
}
.stroke-rail {
  position: absolute;
  left: 0;
