<template>
  <qt-page-frame width-kind="form" :max-width="760">
    <scroll-view class="form-scroll qt-tv-scroll" direction="vertical" :show-scrollbar="false" style="flex:1;min-height:0px;">
    <view class="page" :class="layout.isWide ? 'page-wide' : ''" :style="layout.isTv ? 'padding-left:0px;padding-right:0px;' : ''">
      <!-- 顶部说明（随 tag 切换） -->
      <view class="hint" :class="layout.isWide ? 'hint-wide' : ''">
        <text class="hint-text" :class="layout.isWide ? 'hint-text-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(24, 14) + tvLine(14)">{{ hintText }}</text>
      </view>

      <!-- 两类导入：拷贝歌曲 / 收藏歌单 -->
      <view class="tag-row" :class="layout.isWide ? 'tag-row-wide' : ''">
        <QtSegmented v-model="modeTag" :list="['收藏歌单', '导入歌曲']" @change="switchMode" />
      </view>

      <!-- 第一步：输入链接 + 选平台 -->
      <view class="card" :class="layout.isWide ? 'card-wide' : ''" :style="cardSkin">
        <text class="step-title" :class="layout.isWide ? 'step-title-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(28, 16) + tvLine(16)">1 · 歌单链接</text>
        <view class="input-row" :class="layout.isWide ? 'input-row-wide' : ''" :style="layout.isTv ? 'flex-direction:column;align-items:stretch;gap:12px;' : ''">
          <input
            v-model="rawInput"
            data-qt-tv-id="playlist:link" :focus="false"
            class="link-input" :class="layout.isWide ? 'link-input-wide' : ''"
            :style="'color:' + themeStore.skin.text + ';background-color:' + themeStore.skin.surfaceInset + ';border-color:' + themeStore.skin.border + ';' + tvFieldStyle"
            :placeholder-style="'color:' + themeStore.skin.placeholder + ';'"
            :placeholder="platIndex == 0 ? '例：https://music.163.com/#/playlist?id=123456 或直接输入歌单 ID' : '输入歌单 ID 或分享链接'"
            confirm-type="done"
          />
          <view data-qt-tv-id="playlist:parse" class="parse-btn" :class="[layout.isWide ? 'parse-btn-wide' : '', parsing || importing ? 'qt-tv-skip' : '']" :style="'background-color:' + themeStore.skin.accent + ';' + tvActionStyle" @click="onParse">
            <text class="parse-btn-text" :class="layout.isWide ? 'parse-btn-text-wide' : ''" :style="('color:' + themeStore.skin.onAccent + ';') + qtFontDual(26, 14) + tvLine(14)">{{ parsing ? "解析中" : "解析" }}</text>
          </view>
        </view>

        <!-- 平台选择：走全站统一的操作表弹层（services/source-sheet），不再内联下拉 -->
        <view class="plat-row" :class="layout.isWide ? 'plat-row-wide' : ''" :style="layout.isTv ? 'flex-direction:column;align-items:stretch;gap:8px;' : ''">
          <text class="plat-label" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(24, 14) + tvLine(14)">平台</text>
          <view data-qt-tv-id="playlist:platform" class="plat-select" :class="layout.isWide ? 'plat-select-wide' : ''" :style="'background-color:' + themeStore.skin.surfaceInset + ';border-color:' + themeStore.skin.border + ';' + tvSelectStyle" @click="openPlatformSheet">
            <text class="plat-select-text" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(26, 14) + tvLine(14)">{{ platLabelText }}</text>
            <QtIcon name="chevron-down" :size="24" :color="themeStore.skin.textMuted" />
          </view>
        </view>
        <text class="plat-hint" :class="layout.isWide ? 'plat-hint-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12) + tvLine(12)">{{ platFormatHint }}</text>
      </view>

      <!-- 第二步（导入歌曲）：预览 + 歌单名 + 导入 -->
      <!-- 第二步（导入歌单）：确认卡用 v-show 而不是 v-if——Vapor 首挂坑是「随大 v-if
           子树首次挂载的原生 input 不可编辑」，页载时就挂好的 input 没这个问题；
           解析完成后只切可见性，不再有首挂/重挂动作（:key 重挂会触发 bytecode
           运行时的「UTS instance is not registered」，2026-09-30 实测） -->
      <view v-show="modeTag == 1 && detail != null" class="card" :class="layout.isWide ? 'card-wide' : ''" :style="cardSkin">
        <text class="step-title" :class="layout.isWide ? 'step-title-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(28, 16) + tvLine(16)">2 · 确认导入</text>
        <text v-if="platNote.length > 0" class="plat-note" :class="layout.isWide ? 'plat-note-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12) + tvLine(12)">{{ platNote }}</text>
        <view class="preview" :class="layout.isWide ? 'preview-wide' : ''">
          <image class="preview-cover" :class="layout.isWide ? 'preview-cover-wide' : ''" :src="detailPicUrl" mode="aspectFill" :style="'background-color:' + themeStore.skin.coverPlaceholder + ';' " />
          <view class="preview-info">
            <text class="preview-name" max-lines="2" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(28, 17) + tvLine(17)">{{ detailName }}</text>
            <text class="preview-sub" max-lines="1" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12) + tvLine(12)">{{ detailPlatformLabel }} · {{ detailTrackCount }} 首</text>
          </view>
        </view>
        <text class="field-label" :class="layout.isWide ? 'field-label-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(24, 13) + tvLine(13)">导入到</text>
        <view class="plat-row target-row" :class="layout.isWide ? 'plat-row-wide target-row-wide' : ''">
          <view data-qt-tv-id="playlist:target" class="plat-select" :class="layout.isWide ? 'plat-select-wide' : ''" :style="'background-color:' + themeStore.skin.surfaceInset + ';border-color:' + themeStore.skin.border + ';' + tvSelectStyle" @click="toggleTargetMenu">
            <text class="plat-select-text" max-lines="1" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(26, 14) + tvLine(14)">{{ targetChoiceText }}</text>
            <QtIcon name="chevron-right" :size="24" :color="themeStore.skin.textMuted" />
          </view>
        </view>
        <scroll-view v-if="targetOpen" ref="targetPanel" class="plat-menu qt-tv-scroll" direction="vertical" :scroll-into-view="targetReveal.anchor.value" :style="'height:' + (layout.isTv ? tvTargetHeight : layout.isWide ? 260 : 220) + 'px;background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';' + (layout.isTv ? 'width:' + Math.max(0, qtContentWidth('form') - 34) + 'px;flex-shrink:0;' : '')">
          <QtOption data-qt-tv-id="playlist:target:new" :id="targetReveal.itemId(0)" kind="row" label="新建歌单" :selected="targetChoice == 0" @select="pickTarget(0)" />
          <QtOption v-for="(pl, i) in existingList" :data-qt-tv-id="'playlist:target:' + pl.id" :id="targetReveal.itemId(i + 1)" :key="pl.id" kind="row" :label="pl.name" :selected="targetChoice == i + 1" @select="pickTarget(i + 1)" />
        </scroll-view>
        <text v-if="targetChoice == 0" class="field-label" :class="layout.isWide ? 'field-label-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(24, 13) + tvLine(13)">歌单名称（留空默认同名）</text>
        <input
          v-if="targetChoice == 0"
          v-model="targetName"
          data-qt-tv-id="playlist:name" :focus="false"
          class="name-input" :class="layout.isWide ? 'name-input-wide' : ''"
          :style="'color:' + themeStore.skin.text + ';background-color:' + themeStore.skin.surfaceInset + ';border-color:' + themeStore.skin.border + ';' + tvFieldStyle"
          :placeholder-style="'color:' + themeStore.skin.placeholder + ';'"
          :placeholder="detailPlaceholder"
          confirm-type="done"
        />
        <view class="plat-row" :class="layout.isWide ? 'plat-row-wide' : ''" :style="layout.isTv ? 'flex-direction:column;align-items:stretch;gap:12px;' : ''">
          <text class="preview-info" :style="'color:' + themeStore.skin.text + ';' + qtFontDual(26, 14) + tvLine(14) + (layout.isTv ? 'margin-left:0px;flex-grow:0;min-width:0px;' : '')">跟随原歌单更新</text>
          <QtSwitch data-qt-tv-id="playlist:follow" v-model="followSource" :disabled="!followAvailable || importing || importDone" />
        </view>
        <text class="plat-hint" :style="'color:' + themeStore.skin.textMuted + ';' + qtFontDual(22, 12) + tvLine(12)">{{ followAvailable ? '本设备每天检查，保留你手动添加和删除的歌曲。' : '来源未确认列表完整，更新数据包后可开启。' }}</text>
        <view data-qt-tv-id="playlist:import" class="main-btn" :class="[layout.isWide ? 'main-btn-wide' : '', importing || importDone ? 'qt-tv-skip' : '']" :style="(importing || importDone ? 'background-color:' + themeStore.skin.surfaceMuted + ';' : 'background-color:' + themeStore.skin.accent + ';') + tvMainStyle" @click="onImport">
          <text class="main-btn-text" :style="('color:' + (importing || importDone ? themeStore.skin.textMuted : themeStore.skin.onAccent) + ';') + qtFontDual(28, 17) + tvLine(17)">{{ importBtnText }}</text>
        </view>
        <text v-if="importProgress.length > 0" class="progress-text" :class="layout.isWide ? 'progress-text-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(24, 13) + tvLine(13)">{{ importProgress }}</text>
      </view>

      <!-- 第二步（收藏歌单）：预览 + 收藏按钮 -->
      <view v-if="modeTag == 0 && detail != null" class="card" :class="layout.isWide ? 'card-wide' : ''" :style="cardSkin">
        <text class="step-title" :class="layout.isWide ? 'step-title-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(28, 16) + tvLine(16)">2 · 确认收藏</text>
        <text v-if="platNote.length > 0" class="plat-note" :class="layout.isWide ? 'plat-note-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12) + tvLine(12)">{{ platNote }}</text>
        <view class="preview" :class="layout.isWide ? 'preview-wide' : ''">
          <image class="preview-cover" :class="layout.isWide ? 'preview-cover-wide' : ''" :src="detail.picUrl" mode="aspectFill" :style="'background-color:' + themeStore.skin.coverPlaceholder + ';' " />
          <view class="preview-info">
            <text class="preview-name" max-lines="2" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(28, 17) + tvLine(17)">{{ detail.name }}</text>
            <text class="preview-sub" max-lines="1" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12) + tvLine(12)">{{ platLabel(detail.platform) }} · {{ detail.tracks != null ? detail.tracks.length : 0 }} 首</text>
          </view>
        </view>
        <view data-qt-tv-id="playlist:collect" class="main-btn" :class="[layout.isWide ? 'main-btn-wide' : '', parsing || importDone ? 'qt-tv-skip' : '']" :style="(importDone ? 'background-color:' + themeStore.skin.surfaceMuted + ';' : 'background-color:' + themeStore.skin.accent + ';') + tvMainStyle" @click="onCollect">
          <text class="main-btn-text" :style="('color:' + (importDone ? themeStore.skin.textMuted : themeStore.skin.onAccent) + ';') + qtFontDual(28, 17) + tvLine(17)">{{ importDone ? "已在收藏中" : "收藏到收藏夹" }}</text>
        </view>
      </view>

      <!-- 全屏锁定层：拉取/导入进行中挡住整页并禁系统返回，防止中途离开留下半截状态 -->
      <view v-if="parsing || importing" class="lock-mask" :style="qtFixedPaneStyle()">
        <scroll-view ref="lockPanel" class="lock-card qt-tv-scroll" :class="layout.isWide ? 'lock-card-wide' : ''" direction="vertical" :show-scrollbar="false" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';' + tvLockStyle">
          <QtLoading :visible="true" :size="44" :color="themeStore.skin.accent" />
          <text class="lock-title" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(28, 17) + tvLine(17)">{{ importing ? "正在导入" : "正在拉取歌单" }}</text>
          <text class="lock-sub" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12) + tvLine(12)">{{ importing ? "共 " + importTotal + " 首歌曲" : "歌单较大时需要几秒，请稍候" }}</text>
        </scroll-view>
      </view>
    </view>
    </scroll-view>
  </qt-page-frame>
</template>
<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import QtLoading from "@/uni_modules/qt-ui/components/qt-loading/qt-loading.uvue";
import QtSegmented from "@/uni_modules/qt-ui/components/qt-segmented/qt-segmented.uvue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtOption from "@/uni_modules/qt-ui/components/qt-option/qt-option.uvue";
import QtSwitch from "@/uni_modules/qt-ui/components/qt-switch/qt-switch.uvue";
import { getSessionEpoch } from "@/services/auth";
import { importWithPlaylistFollow } from "@/services/playlist-follow";
import { useQtSelectionReveal } from "@/uni_modules/qt-ui/composables/use-qt-selection-reveal";
import { ref, computed, watch } from "vue";
import { onLoad, onBackPress } from "@dcloudio/uni-app";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { qtFixedPaneStyle, useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { musicApi } from "@/services/music-api";
import { usePlayerStore } from "@/stores/player";
import { useSourceRegistryStore } from "@/stores/source-registry";
import { showPlatformSheet, PLATFORM_SHEET_AUTO_LABEL } from "@/services/source-sheet";
import { qtTrackPage } from "@/uni_modules/qt-stat";
import type { Playlist } from "@/types/music";
import type { Source } from "@/services/music-api";
import { qtFontDual, qtFontValuePx } from "@/uni_modules/qt-ui/stores/font-scale";
import { qtContentWidth } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { useQtTvModal } from "@/uni_modules/qt-ui/composables/use-qt-tv-modal";

const themeStore = useThemeStore();
const layout = useQtLayout();
function tvLine(base: number): string {
  return layout.isTv ? "line-height:" + Math.ceil(qtFontValuePx(base) * 1.35) + "px;" : "";
}
const tvFieldHeight = computed((): number => Math.max(56, Math.ceil(qtFontValuePx(14) * 1.35) + 16));
const tvFieldStyle = computed((): string => layout.isTv ? "width:" + Math.max(0, qtContentWidth("form") - 34) + "px;height:" + tvFieldHeight.value + "px;min-width:0px;flex-grow:0;flex-shrink:0;font-size:" + qtFontValuePx(14) + "px;" + tvLine(14) : "");
const tvActionStyle = computed((): string => layout.isTv ? "width:" + Math.max(0, qtContentWidth("form") - 34) + "px;height:" + tvFieldHeight.value + "px;margin-left:0px;flex-shrink:0;" : "");
const tvSelectStyle = computed((): string => layout.isTv ? "width:" + Math.max(0, qtContentWidth("form") - 34) + "px;height:" + tvFieldHeight.value + "px;min-width:0px;flex-grow:0;flex-shrink:0;" : "");
const tvMainStyle = computed((): string => layout.isTv ? "width:" + Math.max(0, qtContentWidth("form") - 34) + "px;height:auto;min-height:" + Math.max(56, Math.ceil(qtFontValuePx(17) * 1.35) + 16) + "px;padding-top:8px;padding-bottom:8px;min-width:0px;flex-shrink:0;" : "");
const player = usePlayerStore();
const registry = useSourceRegistryStore();

/** 0 收藏歌单（收藏远程引用）/ 1 导入歌曲（拷贝进自建歌单） */
const modeTag = ref(0);
const rawInput = ref("");
const parsing = ref(false);
const detail = ref<Playlist | null>(null);
const followSource = ref(false);
const followAvailable = computed((): boolean => detail.value != null && detail.value.complete == true);
const targetName = ref("");
const importing = ref(false);
const lockPanel = ref<UniElement | null>(null);
const tvLockStyle = computed((): string => layout.isTv ? "width:" + Math.min(360, Math.max(56, layout.paneWidth - 56)) + "px;height:" + Math.min(240, Math.max(56, layout.paneHeight - 24)) + "px;padding-top:12px;padding-bottom:12px;padding-left:20px;padding-right:20px;flex-shrink:0;" : "");
useQtTvModal(lockPanel, () => parsing.value || importing.value, () => {}, 1800);
const importDone = ref(false);
const importProgress = ref("");
/** 本次导入的总歌数（锁定层文案用） */
const importTotal = ref(0);
/** 平台选择：0 自动识别，其余为数据包注册表声明的音源（顺序同切换器） */
const platIndex = ref(0);
// 音源清单来自数据包注册表：未装包时只剩「自动识别」（链接解析仍可用）
const platLabels = computed<string[]>(() => [PLATFORM_SHEET_AUTO_LABEL].concat(registry.sources.map((s) => s.name)));
/** 选择器上显示的平台名（越界一律回落「自动识别」，换包后清单变短不会显示空白） */
const platLabelText = computed((): string => {
  const list = platLabels.value;
  if (platIndex.value < 0 || platIndex.value >= list.length) return PLATFORM_SHEET_AUTO_LABEL;
  return list[platIndex.value];
});
/** 解析平台与手选不一致时的说明（带链接时域名优先） */
const platNote = ref("");
const platValues = computed<string[]>(() => [""].concat(registry.sourceIds()));

// 拉取/导入进行中禁系统返回（导航栏返回与手势都走这里）
onBackPress((_options: OnBackPressOptions): boolean => {
  return parsing.value || importing.value;
});

const cardSkin = computed(
  (): string =>
    "background-color:" + themeStore.skin.surface + ";border-color:" + themeStore.skin.border + ";"
);
const importBtnText = computed((): string => {
  if (importDone.value) return "导入完成";
  if (importing.value) return "导入中…";
  return targetChoice.value == 0 ? "导入到我的歌单" : "导入到已有歌单";
});
/**
 * 确认卡改成 v-show 常挂载后，detail 为空时模板也会求值。带空值守卫的复杂
 * 表达式（&& + 属性链三元）不能放模板：uvue 模板表达式编译对 && 不保证短路，
 * 两边都求值，页载即崩「reading 'tracks'」（2026-09-30 实测）。全部收进 computed，
 * 脚本层短路可靠，模板只绑简单值。
 */
const detailName = computed((): string => (detail.value != null ? detail.value.name : ""));
const detailPicUrl = computed((): string => (detail.value != null ? detail.value.picUrl : ""));
const detailPlatformLabel = computed((): string =>
  detail.value != null ? platLabel(detail.value.platform) : ""
);
const detailTrackCount = computed((): number => {
  const d = detail.value;
  if (d == null || d.tracks == null) return 0;
  return d.tracks.length;
});
const detailPlaceholder = computed((): string =>
  detail.value != null ? "留空默认同名：" + detail.value.name : "留空默认同名"
);
/** 导入目标下拉：0 新建歌单；i>=1 对应 existingList[i-1]（打开时快照自建歌单列表） */
const targetChoice = ref(0);
const targetOpen = ref(false);
const targetPanel = ref<UniElement | null>(null);
const tvTargetHeight = computed((): number => Math.max(76, Math.min(260, layout.paneHeight - 112)));
useQtTvModal(targetPanel, () => targetOpen.value, () => { targetOpen.value = false; }, 1700);
const existingList = ref<Playlist[]>([]);
const targetReveal = useQtSelectionReveal(() => targetOpen.value, () => targetChoice.value >= 0 && targetChoice.value <= existingList.value.length ? targetChoice.value : -1, () => existingList.value.map((item) => item.id).join('|'));
const targetChoiceText = computed((): string => {
  if (targetChoice.value == 0) return "新建歌单";
  const pl = existingList.value[targetChoice.value - 1];
  return pl != null ? pl.name : "新建歌单";
});

function toggleTargetMenu(): void {
  targetOpen.value = !targetOpen.value;
  if (targetOpen.value) {
    existingList.value = player.pickerPlaylists();
    // 上次选的歌单可能已被删掉，越界就回退到新建
    if (targetChoice.value > existingList.value.length) targetChoice.value = 0;
  }
}

function pickTarget(idx: number): void {
  targetChoice.value = idx;
  targetOpen.value = false;
}
/** 顶部说明：两种模式各有去向，支持的平台固定注明 */
const hintText = computed((): string => {
  const head =
    modeTag.value == 0
      ? "粘贴歌单分享链接或 ID，把远程歌单收藏进收藏夹，歌单内容跟随远程更新。"
      : "粘贴歌单分享链接或 ID，拉取全部歌曲拷贝进我的自建歌单，导入后与远程歌单互不影响。";
  const names = platLabels.value.slice(1);
  return head + (names.length > 0 ? "仅支持" + names.join("、") + "。" : "安装数据包后可选平台。");
});
/** 平台行下方常驻注明：当前选择下该填链接还是歌单 ID */
const platFormatHint = computed((): string => {
  if (platIndex.value == 0) {
    return "输入歌单分享链接，按链接域名自动识别平台；也可以直接填纯数字歌单 ID。";
  }
  return "输入" + platLabels.value[platIndex.value] + "的纯数字歌单 ID；粘贴链接时仍按链接域名识别，以链接为准。";
});

function platLabel(p: string): string {
  return registry.label(p);
}

onLoad(() => {
  qtTrackPage("pages/playlist-import/index");
  // 平台清单来自数据包注册表：装载后刷新可选平台（未装包只剩自动识别）
  registry.ensure();
});

// 换包/注册表加载后清单变短时，把手选平台收回「自动识别」，避免选中越界
watch(() => platValues.value.length, () => {
  if (platIndex.value >= platValues.value.length) platIndex.value = 0;
});

/** 切 tag：清掉上一步的结果，输入与平台选择保留（同一条链接两种去向） */
function switchMode(_index: number): void {
  detail.value = null;
  importDone.value = false;
  importProgress.value = "";
  targetName.value = "";
  targetOpen.value = false;
}

/**
 * 平台选择走全站统一的操作表弹层（services/source-sheet 的 showPlatformSheet）：
 * 首项「自动识别（链接）」，其余为数据包注册表音源，当前项 accent 高亮并自动滚动定位。
 *
 * 原先这里是自绘内联下拉（.plat-select + v-if 的 .plat-menu），与设置页/搜索页/首页
 * 的音源切换长相不一致；2026-10-25 统一口径后全部换成同一套弹层。
 */
function openPlatformSheet(): void {
  const current = platValues.value[platIndex.value] ?? "";
  showPlatformSheet("解析平台", current).then((index: number) => {
    if (index < 0) return; // 取消：保持原选择
    const values = platValues.value;
    if (index >= values.length) return;
    platIndex.value = index;
  });
}

/**
 * 按当前平台选择解析输入；识别不出时不再弹窗，直接提示（可手动选平台后重试）。
 *
 * 2026-10-06：歌单链接解析已下沉到音源包（qt-sources 的 `parseSheet` 入口），
 * 权威实现在包里、两端共用，所以这里必须 `await` —— 同步调用只会拿到 Promise。
 * 拿不到包答案（老包/引擎未就绪/超时）时，music-api 内部回退本地旧版解析。
 */
async function parseInput(): Promise<{ platform: Source; id: string } | null> {
  const text = rawInput.value.trim();
  if (text.length == 0) {
    qtShowToast({ title: "请先粘贴歌单链接", icon: "none" });
    return null;
  }
  const sel = platValues.value[platIndex.value] ?? "";
  const parsed =
    sel.length > 0
      ? await musicApi.parseSheetInput(text, sel as Source)
      : await musicApi.parseSheetInput(text);
  if (parsed == null) {
    qtShowToast({ title: "无法识别歌单ID，可试试在平台里手动选择", icon: "none", duration: 3000 });
    return null;
  }
  return parsed;
}

/** 解析链接 → 拉取歌单详情；导入歌曲做全量预览，收藏歌单做确认页 */
async function onParse(): Promise<void> {
  if (parsing.value || importing.value) return;
  // R8：busy 标志要在第一个 await 之前立起来，否则 parseInput 在途时按钮仍可
  // 连点、并发两次解析；早退路径要复位， finally 只覆盖正常走完的路径
  parsing.value = true;
  const parsed = await parseInput();
  if (parsed == null) {
    parsing.value = false;
    return;
  }
  const sel = platValues.value[platIndex.value] ?? "";
  platNote.value =
    sel.length > 0 && parsed.platform != sel
      ? "已按链接识别为" + platLabel(parsed.platform) + "，未按手选的" + platLabel(sel) + "解析"
      : "";
  detail.value = null;
  importDone.value = false;
  importProgress.value = "";
  try {
    const remote = await musicApi.playlist(parsed.id, parsed.platform);
    detail.value = remote;
    followSource.value = false;
  } catch (e) {
    qtShowToast({ title: (e as Error).message || "歌单获取失败", icon: "none", duration: 3000 });
  } finally {
    parsing.value = false;
  }
}

/** 建歌单 + 批量拷贝：store 批量入口内存去重登记，落库与推送各一次（断网自动补推） */
async function onImport(): Promise<void> {
  if (importing.value || importDone.value) return;
  if (detail.value == null) return;
  const epoch = getSessionEpoch();
  const remote = detail.value;
  const tracks = detail.value.tracks != null ? detail.value.tracks! : [];
  if (tracks.length == 0) {
    qtShowToast({ title: "该歌单没有可导入的歌曲", icon: "none", duration: 3000 });
    return;
  }
  let targetId = "";
  let targetNameShow = "";
  if (targetChoice.value == 0) {
    // 名称留空 = 默认用远程歌单名。不能往输入框预填值：被代码赋过值的 v-model
    // 输入框在 Vapor 重渲染时会把敲进去的字打回旧值，表现为无法输入
    const typed = targetName.value.trim();
    const name = typed.length > 0 ? typed : detail.value.name;
    const created = player.createLocalPlaylist(name, detail.value.picUrl);
    if (created == null) {
      qtShowToast({ title: "已有同名歌单，换个名字吧", icon: "none", duration: 3000 });
      return;
    }
    targetId = created.id;
    targetNameShow = created.name;
  } else {
    const pl = existingList.value[targetChoice.value - 1];
    if (pl == null) {
      qtShowToast({ title: "请选择要导入的歌单", icon: "none" });
      return;
    }
    targetId = pl.id;
    targetNameShow = pl.name;
  }
  importing.value = true;
  importTotal.value = tracks.length;
  // 先让锁定层上屏一帧，再做同步的批量登记（大歌单落库期间 UI 不再响应点击）
  await new Promise<void>((r) => setTimeout(r, 50) as number);
  try {
  if (epoch != getSessionEpoch()) throw new Error("账号已变化，请重试");
  const target = player.localPlaylists.concat(player.savedPlaylists).find((p: Playlist): boolean => p.id == targetId && p.platform == "local");
  if (target == null) throw new Error("目标歌单已删除");
  const added = followSource.value ? importWithPlaylistFollow(target, remote, epoch) : player.importSongsToPlaylist(tracks, targetId);
  importProgress.value = "已导入 " + added + " / " + tracks.length + " 首到「" + targetNameShow + "」";
  importing.value = false;
  importDone.value = true;
  qtShowToast({ title: "已导入 " + added + " 首歌曲", icon: "success" });
  } catch (e) {
    qtShowToast({ title: (e as Error).message, icon: "none" });
  } finally { importing.value = false; }
}

/** 收藏远程歌单（引用式）：已收藏过只提示；成功后跳歌单详情 */
async function onCollect(): Promise<void> {
  if (parsing.value || importDone.value) return;
  if (detail.value == null) return;
  const target = detail.value;
  parsing.value = true;
  try {
    const already = player.isPlaylistSaved(target);
    if (!already) {
      player.toggleSavePlaylist(target);
    }
    parsing.value = false;
    importDone.value = true;
    qtShowToast({
      title: already ? "歌单已在收藏中" : "已收藏到收藏夹",
      icon: "none",
      duration: 3000,
    });
    uni.navigateTo({
      url:
        "/pages/playlist/index?id=" +
        encodeURIComponent(target.id) +
        "&platform=" +
        encodeURIComponent(target.platform) +
        "&type=playlist",
    });
  } catch (e) {
    parsing.value = false;
    qtShowToast({ title: "收藏失败，请稍后再试", icon: "none", duration: 3000 });
  }
}
</script>
<style>
.lock-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background-color: rgba(0, 0, 0, 0.45); align-items: center; justify-content: center; z-index: 999; }
.lock-card { width: 320rpx; border-width: 1px; border-style: solid; border-radius: 20rpx; padding: 40rpx 30rpx; align-items: center; }
.lock-title { margin-top: 20rpx; font-size: 28rpx; font-weight: bold; }
.lock-sub { margin-top: 8rpx; font-size: 22rpx; }
/* 宽屏：320rpx 在 1067dp 窗口约 455px，内边距 57/43px、圆角 28px，遮罩上显得又大又糊 */
.lock-card-wide { width: 360px; padding: 24px 28px; border-radius: 12px; }
.page { flex: 1; padding: 24rpx; }
.page-wide { padding: 16px 24px; }
.hint { margin-bottom: 20rpx; }
.hint-wide { margin-bottom: 12px; }
.hint-text { font-size: 24rpx; line-height: 36rpx; }
.hint-text-wide { font-size: 14px; line-height: 22px; }
.tag-row { margin-bottom: 20rpx; }
.tag-row-wide { margin-bottom: 12px; }
.card { border-width: 1px; border-style: solid; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; }
.card-wide { border-radius: 12px; padding: 16px; margin-bottom: 12px; }
.step-title { font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; }
.step-title-wide { font-size: 16px; margin-bottom: 10px; }
.input-row { flex-direction: row; align-items: center; }
.input-row-wide { margin-bottom: 4px; }
.link-input { flex: 1; height: 72rpx; border-width: 1px; border-style: solid; border-radius: 12rpx; padding: 0 20rpx; font-size: 26rpx; }
.link-input-wide { height: 40px; border-radius: 8px; padding: 0 12px; font-size: 14px; }
.parse-btn { height: 72rpx; border-radius: 12rpx; padding: 0 30rpx; margin-left: 16rpx; align-items: center; justify-content: center; }
.parse-btn-wide { height: 40px; border-radius: 8px; padding: 0 18px; margin-left: 11px; }
.parse-btn-text { font-size: 26rpx; font-weight: bold; }
.parse-btn-text-wide { font-size: 14px; }
.plat-row { flex-direction: row; align-items: center; margin-top: 16rpx; }
.plat-row-wide { margin-top: 10px; }
.plat-label { width: 80rpx; font-size: 24rpx; }
.plat-select { flex: 1; height: 64rpx; border-width: 1px; border-style: solid; border-radius: 12rpx; padding: 0 20rpx; flex-direction: row; align-items: center; justify-content: space-between; }
.plat-select-wide { height: 38px; border-radius: 8px; padding: 0 12px; }
.plat-select-text { font-size: 26rpx; }
.plat-menu { margin-top: 12rpx; border-width: 1px; border-style: solid; border-radius: 12rpx; overflow: hidden; }
/* 桌面指针反馈：只在宽屏启用 */
.plat-option-hover {
  background-color: rgba(127, 127, 127, 0.10);
}
.plat-option { height: 72rpx; padding: 0 20rpx; flex-direction: row; align-items: center; justify-content: space-between; }
.plat-option-line { border-bottom-width: 1px; border-bottom-style: solid; border-bottom-color: rgba(128, 128, 128, 0.2); }
.plat-option-text { font-size: 26rpx; }
.plat-hint { margin-top: 10rpx; font-size: 22rpx; line-height: 32rpx; }
.plat-hint-wide { margin-top: 6px; font-size: 12px; line-height: 18px; }
.plat-note { margin-bottom: 12rpx; font-size: 22rpx; }
.plat-note-wide { margin-bottom: 6px; font-size: 12px; }
.preview { flex-direction: row; align-items: center; margin-bottom: 16rpx; }
.preview-wide { margin-bottom: 10px; }
.preview-cover { width: 96rpx; height: 96rpx; border-radius: 12rpx; }
.preview-cover-wide { width: 56px; height: 56px; border-radius: 8px; }
.preview-info { flex: 1; margin-left: 20rpx; }
.preview-name { font-size: 28rpx; font-weight: bold; }
.preview-sub { margin-top: 6rpx; font-size: 22rpx; }
.field-label { font-size: 24rpx; margin-bottom: 10rpx; }
.field-label-wide { font-size: 13px; margin-bottom: 6px; }
/* 确认卡的目标下拉行：与下方（名称输入或导入按钮）保持一档间距 */
.target-row { margin-bottom: 20rpx; }
.target-row-wide { margin-bottom: 12px; }
.name-input { height: 72rpx; border-width: 1px; border-style: solid; border-radius: 12rpx; padding: 0 20rpx; font-size: 26rpx; margin-bottom: 20rpx; }
.name-input-wide { height: 40px; border-radius: 8px; padding: 0 12px; font-size: 14px; margin-bottom: 12px; }
.main-btn { height: 80rpx; border-radius: 16rpx; align-items: center; justify-content: center; }
.main-btn-wide { height: 44px; border-radius: 10px; }
.main-btn-text { font-size: 28rpx; font-weight: bold; }
.progress-text { margin-top: 16rpx; font-size: 24rpx; }
.progress-text-wide { margin-top: 8px; font-size: 13px; }
</style>
