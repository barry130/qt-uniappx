<template>
  <!-- 播客（2026-11-04 移植自 qt-pc PodcastPage.tsx，m05304）：
       RSS/Atom 的解析与存储全在 services/podcast.ts，播放走播放器队列（队列只放当前这一集，
       避免「下一首」串到音乐）。本页负责：订阅地址输入、订阅/刷新/移除、单集列表、断点续播。 -->
  <qt-page-frame width-kind="list" :max-width="720" title="播客">
    <view class="page" :class="layout.isWide ? 'page-wide' : ''">
      <list-view id="podcast-scroll" class="scroll" direction="vertical" :scroll-top="scrollTop" @scroll="onListScroll" @scrolltolower="loadMoreEpisodes">
        <!-- 订阅区：窄屏标题栏已有「播客」，宽屏时这张卡是主操作区 -->
        <list-item class="hero-item" :class="layout.isWide ? 'hero-item-wide' : ''">
          <view class="hero" :class="layout.isWide ? 'hero-wide' : ''" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';'">
            <view class="hero-title-row">
              <QtIcon name="mic" :size="layout.isWide ? 20 : 40" :color="themeStore.skin.accent" />
              <text class="hero-title" :class="layout.isWide ? 'hero-title-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(36, 22)">播客</text>
            </view>
            <text class="hero-desc" :class="layout.isWide ? 'hero-desc-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(25, 14)">
              粘贴 RSS / Atom 订阅地址就能听：边播边缓存，退出再进来接着上次的位置。
            </text>
            <view class="sub-row" :class="layout.isWide ? 'sub-row-wide' : ''">
              <view class="sub-field" :class="layout.isWide ? 'sub-field-wide' : ''" :style="subFieldStyle">
                <QtIcon name="globe" :size="layout.isWide ? 12 : 24" :color="themeStore.skin.textMuted" />
                <input
                  class="sub-input" :class="layout.isWide ? 'sub-input-wide' : ''"
                  :value="urlInput"
                  @input="onUrlInput"
                  @confirm="onSubscribeTap"
                  placeholder="https://example.com/feed.xml"
                  :placeholder-style="'color:' + themeStore.skin.placeholder + ';' + subscriptionFont"
                  :style="'color:' + themeStore.skin.text + ';' + subscriptionFont"
                />
              </view>
              <view class="sub-btn" :class="layout.isWide ? 'sub-btn-wide' : ''" :style="subscribeStyle" @click="onSubscribeTap">
                <text class="sub-btn-text" :style="'color:' + (busy ? themeStore.skin.textMuted : themeStore.skin.onAccent) + ';' + qtFontDual(25, 14)">{{ busy ? "订阅中…" : "订阅" }}</text>
              </view>
            </view>
          </view>
        </list-item>

        <!-- 提示条：失败原因（服务层原文）与操作结果都不打断收听 -->
        <list-item v-if="errorMsg.length > 0" class="notice-item" :class="layout.isWide ? 'notice-item-wide' : ''">
          <view class="notice" :class="layout.isWide ? 'notice-wide' : ''" :style="'background-color:' + themeStore.skin.surfaceMuted + ';border-color:' + themeStore.skin.border + ';'">
            <QtIcon name="alert" :size="layout.isWide ? 14 : 26" :color="themeStore.skin.danger" />
            <text class="notice-text" :class="layout.isWide ? 'notice-text-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(23, 13)">{{ errorMsg }}</text>
          </view>
        </list-item>
        <list-item v-if="noticeMsg.length > 0 && errorMsg.length == 0" class="notice-item" :class="layout.isWide ? 'notice-item-wide' : ''">
          <view class="notice" :class="layout.isWide ? 'notice-wide' : ''" :style="'background-color:' + themeStore.skin.surfaceMuted + ';border-color:' + themeStore.skin.border + ';'">
            <QtIcon name="info" :size="layout.isWide ? 14 : 26" :color="themeStore.skin.textMuted" />
            <text class="notice-text" :class="layout.isWide ? 'notice-text-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(23, 13)">{{ noticeMsg }}</text>
          </view>
        </list-item>

        <!-- 订阅列表：一行一个订阅，点一下切换下面的单集列表 -->
        <list-item v-if="shows.length > 0" class="sec-head" :class="layout.isWide ? 'sec-head-wide' : ''">
          <text class="sec-title" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(28, 16)">我的订阅</text>
          <text class="sec-sub" :class="layout.isWide ? 'sec-sub-wide' : ''" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(22, 12)">{{ shows.length }} 个 · 点一下切换</text>
        </list-item>
        <list-item v-for="show in shows" :key="show.id" class="show-item" :class="layout.isWide ? 'show-item-wide' : ''">
          <view class="show" :class="layout.isWide ? 'show-wide' : ''" :style="showRowStyle(show.id)" @click="onSelectTap(show.id)">
            <image v-if="show.image.length > 0" class="show-cover" :class="layout.isWide ? 'show-cover-wide' : ''" :src="show.image" mode="aspectFill" />
            <view v-else class="show-cover show-cover-ph" :class="layout.isWide ? 'show-cover-wide' : ''" :style="'background-color:' + themeStore.skin.coverPlaceholder + ';'">
              <QtIcon name="mic" :size="layout.isWide ? 14 : 28" :color="themeStore.skin.textSubtle" />
            </view>
            <view class="show-info" :class="layout.isWide ? 'show-info-wide' : ''">
              <text class="show-name" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(28, 16)" :max-lines="1">{{ show.title }}</text>
              <text class="show-meta" :class="layout.isWide ? 'show-meta-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12)" :max-lines="1">{{ showMeta(show) }}</text>
            </view>
            <view class="show-act" :class="layout.isWide ? 'show-act-wide' : ''" :style="ghostBtnStyle" @click.stop="onRefreshTap(show.id)">
              <QtIcon name="refresh" :size="layout.isWide ? 13 : 24" :color="refreshingId == show.id ? themeStore.skin.accent : themeStore.skin.iconMuted" />
            </view>
            <view class="show-act" :class="layout.isWide ? 'show-act-wide' : ''" :style="ghostBtnStyle" @click.stop="onRemoveTap(show.id)">
              <QtIcon name="trash" :size="layout.isWide ? 13 : 24" :color="themeStore.skin.danger" />
            </view>
          </view>
        </list-item>

        <!-- 空态：还没订阅 -->
        <list-item v-if="shows.length == 0 && !busy && !initialLoading" class="empty-item" :class="layout.isWide ? 'empty-item-wide' : ''">
          <view class="empty" :class="layout.isWide ? 'empty-wide' : ''">
            <QtIcon name="mic" :size="layout.isWide ? 22 : 46" :color="themeStore.skin.textSubtle" />
            <text class="empty-text" :class="layout.isWide ? 'empty-text-wide' : ''" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(24, 13)">还没有订阅任何播客：把常听节目的订阅地址贴到上面</text>
          </view>
        </list-item>

        <!-- 选中订阅：标题 + 简介 + 元信息 -->
        <list-item v-if="hasSelection" class="detail-item" :class="layout.isWide ? 'detail-item-wide' : ''">
          <view class="detail" :class="layout.isWide ? 'detail-wide' : ''" :style="'background-color:' + themeStore.skin.surface + ';border-color:' + themeStore.skin.border + ';'">
            <text class="detail-title" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(32, 18)">{{ selectedTitle }}</text>
            <text v-if="selectedDesc.length > 0" class="detail-desc" :class="layout.isWide ? 'detail-desc-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(23, 13)" :max-lines="4">{{ selectedDesc }}</text>
            <text class="detail-meta" :class="layout.isWide ? 'detail-meta-wide' : ''" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(22, 12)" :max-lines="1">{{ selectedMeta }}</text>
          </view>
        </list-item>

        <!-- 单集列表 -->
        <list-item v-for="ep in visibleEpisodes" :key="ep.id" class="ep-item" :class="layout.isWide ? 'ep-item-wide' : ''">
          <view class="ep" :class="layout.isWide ? 'ep-wide' : ''" :style="epRowStyle(ep)">
            <view
              class="ep-play" :class="layout.isWide ? 'ep-play-wide' : ''"
              :style="'background-color:' + (isCurrentEpisode(ep) ? themeStore.skin.accent : themeStore.skin.surfaceMuted) + ';border-color:' + themeStore.skin.border + ';'"
              @click="onPlayTap(ep)"
            >
              <QtIcon
                :name="isCurrentPlaying(ep) ? 'pause' : 'play'"
                :size="layout.isWide ? 13 : 26"
                :color="isCurrentEpisode(ep) ? themeStore.skin.onAccent : themeStore.skin.iconMuted"
              />
            </view>
            <view class="ep-info" :class="layout.isWide ? 'ep-info-wide' : ''" @click="onPlayTap(ep)">
              <text class="ep-name" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(27, 15)" :max-lines="2">{{ ep.title }}</text>
              <text class="ep-meta" :class="layout.isWide ? 'ep-meta-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12)" :max-lines="1">{{ episodeMeta(ep) }}</text>
            </view>
            <text v-if="isCurrentEpisode(ep)" class="ep-flag" :class="layout.isWide ? 'ep-flag-wide' : ''" :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(21, 11)">{{ player.playing ? "播放中" : "已暂停" }}</text>
          </view>
        </list-item>

        <list-item v-if="hasMoreEpisodes" class="ep-item" :class="layout.isWide ? 'ep-item-wide' : ''">
          <QtButton label="加载更多单集" variant="ghost" size="sm" @click="loadMoreEpisodes" />
        </list-item>

        <!-- 选中了订阅但一集都没有（订阅源里没东西） -->
        <list-item v-if="hasSelection && episodes.length == 0" class="empty-item" :class="layout.isWide ? 'empty-item-wide' : ''">
          <view class="empty" :class="layout.isWide ? 'empty-wide' : ''">
            <QtIcon name="info" :size="layout.isWide ? 20 : 40" :color="themeStore.skin.textSubtle" />
            <text class="empty-text" :class="layout.isWide ? 'empty-text-wide' : ''" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontDual(24, 13)">这个订阅还没有单集，点右上角的刷新试试</text>
          </view>
        </list-item>

        <list-item class="foot-space" :class="layout.isWide ? 'foot-space-wide' : ''" />
      </list-view>
      <QtBackToTop :visible="showBackToTop" @tap="backToTop" />
    </view>
  </qt-page-frame>
</template>

<script setup lang="ts">
import { ref, shallowRef, computed, onMounted, onUnmounted, watch } from "vue";
import type { Song } from "@/types/music";
import {
  PODCAST_PLATFORM,
  addPodcastShow,
  listPodcastEpisodes,
  listPodcastShows,
  podcastEpisodeToSong,
  refreshPodcastShow,
  removePodcastShow,
  savePodcastProgress,
} from "@/services/podcast";
import type { PodcastEpisode, PodcastShow } from "@/services/podcast";
import { usePlayerStore } from "@/stores/player";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtBackToTop from "@/uni_modules/qt-ui/components/qt-back-to-top/qt-back-to-top.uvue";
import QtButton from "@/uni_modules/qt-ui/components/qt-button/qt-button.uvue";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";
import { qtConfirm } from "@/services/confirm";
import { qtShowToast } from "@/services/toast";

/** 进度落盘间隔（qt-pc 同款 5s）：太密会一直写盘，太疏则崩溃/被杀时丢太多 */
const SAVE_INTERVAL_MS = 5000;
/** The input and its placeholder use one responsive, globally scaled font source. */
const subscriptionFont = computed((): string => qtFontDual(25, 14));
/** 心跳里真正写盘的最小位移：一集 300 条单集的 JSON 每 5s 重写一次太浪费，
 *  位置没走出 15s 就先只在内存里记着，暂停/切集/离开页面时再落盘 */
const PROGRESS_WRITE_MIN_MS = 15000;
/** 听到 95% 记「已听完」：单集结尾常是口播/广告，等 100% 才算听完会一直卡在「继续播放」 */
const FINISH_RATIO = 0.95;
/** 进度条位置与原目标相差多少秒以内就不再 seek（省得每次进页面都抖一下） */
const SEEK_TOLERANCE_SEC = 3;
/** 进入页面时自动补拉的最小间隔：15 分钟内拉过的订阅不再重复拉
 *  （喜马拉雅这类大源一次 2.6MB，每次进页面都拉太费流量） */
const AUTO_REFRESH_MIN_INTERVAL_MS = 15 * 60 * 1000;
const EPISODE_BATCH_SIZE = 24;

const player = usePlayerStore();
const themeStore = useThemeStore();
const layout = useQtLayout();

const shows = ref<PodcastShow[]>([]);
const episodes = shallowRef<PodcastEpisode[]>([]);
const episodeLimit = ref(EPISODE_BATCH_SIZE);
const visibleEpisodes = computed((): PodcastEpisode[] => episodes.value.slice(0, episodeLimit.value));
const hasMoreEpisodes = computed((): boolean => episodeLimit.value < episodes.value.length);
const initialLoading = ref(true);
const selectedId = ref("");
const urlInput = ref("");
const busy = ref(false);
const refreshingId = ref("");
const errorMsg = ref("");
const noticeMsg = ref("");
const scrollTop = ref(0);
const showBackToTop = ref(false);

/**
 * 单集索引：key 是音频直链（也就是播放器曲目 id）。
 * 跨订阅累积（qt-pc C16 的同一考虑）——听着 A 的时候切到 B 的节目单，
 * 进度仍然要能落到 A 的那一集上，所以不能只索引当前选中的订阅。
 */
const epByUrl = new Map<string, PodcastEpisode>();

/** 续播目标：起播后播放器把 current 换成这一集、progress 起来之后再 seek 一次 */
let pendingSeekUrl = "";
let pendingSeekSec = 0;
/** 正在跟踪的那一集（播放位置来自 player.progress，单位秒） */
let trackedUrl = "";
let trackedSec = 0;
let saveTimer: number | null = null;
let loadTimer: number | null = null;
let autoRefreshTimer: number | null = null;
let disposed = false;
let lookedUpUrl = "";

const currentUrl = computed((): string => {
  const song = player.current;
  if (song == null) return "";
  return song.platform == PODCAST_PLATFORM ? song.id : "";
});

const selectedShow = computed((): PodcastShow | null => {
  const id = selectedId.value;
  const list = shows.value;
  for (let i = 0; i < list.length; i++) {
    if (list[i].id == id) return list[i];
  }
  return null;
});
// 模板不直接读 selectedShow 的字段：uni-app x 的模板编译器不做可空收窄，
// `selectedShow.title` 会报「Object is possibly null」，所以全部折成安全值。
const hasSelection = computed((): boolean => selectedShow.value != null);
const selectedTitle = computed((): string => {
  const show = selectedShow.value;
  return show == null ? "" : show.title;
});
const selectedDesc = computed((): string => {
  const show = selectedShow.value;
  return show == null ? "" : show.description;
});
const selectedMeta = computed((): string => {
  const show = selectedShow.value;
  if (show == null) return "";
  let out = showMeta(show);
  if (show.lastFetchedAt > 0) out += " · 上次刷新 " + formatDay(show.lastFetchedAt);
  return out;
});

const subFieldStyle = computed((): string => {
  return "background-color:" + themeStore.skin.surfaceMuted + ";border-color:" + themeStore.skin.border + ";";
});
const subscribeStyle = computed((): string => {
  const bg = busy.value ? themeStore.skin.surfaceMuted : themeStore.skin.accent;
  return "background-color:" + bg + ";border-color:" + themeStore.skin.border + ";";
});
const ghostBtnStyle = computed((): string => {
  return "background-color:" + themeStore.skin.surfaceMuted + ";border-color:" + themeStore.skin.border + ";";
});

function pad2(value: number): string {
  return value < 10 ? "0" + value.toString() : value.toString();
}

function formatDay(ms: number): string {
  if (ms <= 0) return "日期未知";
  const d = new Date(ms);
  return d.getFullYear().toString() + "-" + pad2(d.getMonth() + 1) + "-" + pad2(d.getDate());
}

function formatSeconds(seconds: number): string {
  const total = Math.max(0, Math.round(seconds));
  const hours = Math.floor(total / 3600);
  const minutes = Math.floor((total % 3600) / 60);
  const rest = total % 60;
  if (hours > 0) return hours.toString() + ":" + pad2(minutes) + ":" + pad2(rest);
  return minutes.toString() + ":" + pad2(rest);
}

function showMeta(show: PodcastShow): string {
  const author = show.author.length > 0 ? show.author : "未知作者";
  return author + " · " + show.episodeCount.toString() + " 集";
}

function episodeMeta(ep: PodcastEpisode): string {
  let out = formatDay(ep.publishedAt);
  if (ep.durationMs > 0) out += " · " + formatSeconds(ep.durationMs / 1000);
  if (ep.played) return out + " · 已听完";
  const at = Math.round(ep.positionMs / 1000);
  if (at >= 5) return out + " · 继续播放 " + formatSeconds(at);
  return out;
}

function showRowStyle(showId: string): string {
  const selected = showId == selectedId.value;
  const bg = selected ? themeStore.skin.accentSoft : themeStore.skin.surface;
  const border = selected ? themeStore.skin.accent : themeStore.skin.border;
  return "background-color:" + bg + ";border-color:" + border + ";";
}

function epRowStyle(ep: PodcastEpisode): string {
  const bg = isCurrentEpisode(ep) ? themeStore.skin.surfaceStrong : themeStore.skin.surface;
  return "background-color:" + bg + ";border-color:" + themeStore.skin.border + ";";
}

function isCurrentEpisode(ep: PodcastEpisode): boolean {
  return currentUrl.value.length > 0 && currentUrl.value == ep.audioUrl;
}

function isCurrentPlaying(ep: PodcastEpisode): boolean {
  return isCurrentEpisode(ep) && player.playing;
}

function findShow(showId: string): PodcastShow | null {
  const list = shows.value;
  for (let i = 0; i < list.length; i++) {
    if (list[i].id == showId) return list[i];
  }
  return null;
}

/** 只在需要保存播客进度且索引未命中时查找，普通音乐/首次进页不读其他订阅。
 * album 是创建播客 Song 时的节目名，优先查它；旧名字或同名节目仍按 URL 兜底。 */
function findTrackedEpisode(): PodcastEpisode | null {
  const indexed = epByUrl.get(trackedUrl);
  if (indexed != null) return findShow(indexed.showId) == null ? null : indexed;
  if (trackedUrl.length == 0 || lookedUpUrl == trackedUrl) return null;
  lookedUpUrl = trackedUrl;
  const song = player.current;
  const album = song != null && song.id == trackedUrl ? song.album : "";
  const preferred = shows.value.filter((show: PodcastShow): boolean => show.title == album);
  const rest = shows.value.filter((show: PodcastShow): boolean => show.title != album);
  const list = preferred.concat(rest);
  for (let i = 0; i < list.length; i++) {
    const eps = listPodcastEpisodes(list[i].id);
    for (let j = 0; j < eps.length; j++) {
      if (eps[j].audioUrl == trackedUrl) {
        epByUrl.set(trackedUrl, eps[j]);
        return eps[j];
      }
    }
  }
  return null;
}

/**
 * 选一个订阅：单集列表整份换掉，并让索引指向这一批对象
 * （这样进度改动直接落在当前渲染的那几个对象上，列表能立刻刷新）。
 * 选完如果数据已经陈旧，就在后台静默补拉一次最新单集。
 */
function selectShow(showId: string): void {
  const changed = selectedId.value != showId;
  selectedId.value = showId;
  const list = listPodcastEpisodes(showId);
  episodes.value = list;
  if (changed) episodeLimit.value = EPISODE_BATCH_SIZE;
  for (let i = 0; i < list.length; i++) {
    epByUrl.set(list[i].audioUrl, list[i]);
  }
  // 网络解析也让开首屏；快速切走时不再为已卸载页面启动刷新。
  if (autoRefreshTimer != null) clearTimeout(autoRefreshTimer);
  autoRefreshTimer = setTimeout(() => {
    autoRefreshTimer = null;
    if (!disposed && selectedId.value == showId) autoRefreshIfStale(showId);
  }, 350);
}

/**
 * 进入页面/切换订阅时的静默补拉：用户先看到存储里的快照（即时可交互），
 * 拉取完成后列表自动换成最新单集——不点那个小刷新按钮也能拿到最新内容。
 * 失败不打断（弱网下页面刚打开报错很吓人）；手动刷新按钮仍然可用并展示原因。
 */
function autoRefreshIfStale(showId: string): void {
  if (refreshingId.value.length > 0) return;
  const show = findShow(showId);
  if (show == null) return;
  // lastFetchedAt 由 add/refresh 服务层维护；15 分钟内拉过就算新鲜
  if (show.lastFetchedAt > 0 && Date.now() - show.lastFetchedAt < AUTO_REFRESH_MIN_INTERVAL_MS) {
    return;
  }
  void refreshShow(showId, true);
}

/** 重新读订阅列表；`preferId` 是刚订阅/刚刷新的那条，优先选中它 */
function loadShows(preferId: string = ""): void {
  shows.value = listPodcastShows();
  lookedUpUrl = "";
  if (shows.value.length == 0) {
    selectedId.value = "";
    episodes.value = [];
    return;
  }
  const wanted = preferId.length > 0 ? preferId : selectedId.value;
  const target = findShow(wanted) != null ? wanted : shows.value[0].id;
  selectShow(target);
}

function loadMoreEpisodes(): void {
  if (disposed || !hasMoreEpisodes.value) return;
  episodeLimit.value = Math.min(episodes.value.length, episodeLimit.value + EPISODE_BATCH_SIZE);
}

function onListScroll(e: any): void {
  const st = e.detail != null ? Number(e.detail.scrollTop ?? 0) : 0;
  showBackToTop.value = st > 600;
}

function backToTop(): void {
  scrollTop.value = scrollTop.value == 0 ? 1 : 0;
  showBackToTop.value = false;
}

function onUrlInput(e: UniInputEvent): void {
  urlInput.value = e.detail.value;
}

function onSelectTap(showId: string): void {
  if (showId == selectedId.value) return;
  selectShow(showId);
}

function onSubscribeTap(): void {
  void subscribe();
}

async function subscribe(): Promise<void> {
  if (busy.value) return;
  const address = urlInput.value.trim();
  if (address.length == 0) {
    errorMsg.value = "请先填写订阅地址";
    return;
  }
  busy.value = true;
  errorMsg.value = "";
  noticeMsg.value = "";
  try {
    const show = await addPodcastShow(address);
    if (disposed) return;
    urlInput.value = "";
    noticeMsg.value = "已订阅「" + show.title + "」，共 " + show.episodeCount.toString() + " 集";
    loadShows(show.id);
  } catch (e) {
    // 失败原因（HTTP 码、不是 RSS、没找到频道标题……）由服务层给出，原样展示
    if (!disposed) errorMsg.value = (e as Error).message || "订阅失败";
  } finally {
    if (!disposed) busy.value = false;
  }
}

function onRefreshTap(showId: string): void {
  void refreshShow(showId);
}

/**
 * 刷新某个订阅。`silent=true`（自动补拉）时不改提示条：成功只是安静地
 * 换列表，失败也不打断用户（页面刚打开弱网报错很吓人）；
 * 手动刷新（silent=false）成功/失败都提示，原因原样展示。
 */
async function refreshShow(showId: string, silent: boolean = false): Promise<void> {
  if (refreshingId.value.length > 0) return;
  const show = findShow(showId);
  if (show == null) return;
  refreshingId.value = showId;
  if (!silent) {
    errorMsg.value = "";
    noticeMsg.value = "";
  }
  try {
    const next = await refreshPodcastShow(showId);
    if (disposed) return;
    // 刷新会换掉 shows 数组里的对象，但 played/positionMs 由服务层按 id 保留下来
    if (!silent) {
      noticeMsg.value = "「" + next.title + "」已更新，共 " + next.episodeCount.toString() + " 集";
    }
    // 请求期间用户可能已经切到另一档节目，刷新完成不能抢回选择。
    shows.value = listPodcastShows();
    if (selectedId.value == showId) selectShow(showId);
  } catch (e) {
    if (!disposed && !silent) {
      errorMsg.value = (e as Error).message || "刷新失败";
    }
  } finally {
    if (!disposed) refreshingId.value = "";
  }
}

function onRemoveTap(showId: string): void {
  const show = findShow(showId);
  if (show == null) return;
  const title = show.title;
  qtConfirm({
    title: "取消订阅",
    content: "从本机移除「" + title + "」和它的单集记录？音频缓存不会一起删。",
    confirmText: "移除",
    danger: true,
  }).then((ok: boolean) => {
    if (!ok || disposed) return;
    // 移除前先把正在听的那一集进度落盘（订阅没了就找不回这一集了）
    flushTracked(true);
    removePodcastShow(showId);
    noticeMsg.value = "已取消订阅「" + title + "」";
    errorMsg.value = "";
    loadShows();
  });
}

function onPlayTap(ep: PodcastEpisode): void {
  if (isCurrentEpisode(ep)) {
    // 点正在播的这一集 = 播放/暂停（与桌面端一致，不重新起播）
    if (player.playing) player.pause();
    else player.resume();
    return;
  }
  const show = findShow(ep.showId);
  if (show == null) return;
  // 已听完的从头来；否则从上次位置续播（离结尾很近也算听完，从头来更符合直觉）
  let resumeSec = 0;
  if (!ep.played && ep.positionMs > 0) {
    resumeSec = ep.positionMs / 1000;
    const totalSec = ep.durationMs / 1000;
    if (totalSec > 0 && resumeSec >= totalSec * FINISH_RATIO) resumeSec = 0;
  }
  pendingSeekUrl = resumeSec > 0 ? ep.audioUrl : "";
  pendingSeekSec = resumeSec;
  errorMsg.value = "";
  // 队列只放这一集：播客之间「下一首」没有意义，更不能串到音乐队列里
  const song = podcastEpisodeToSong(ep, show);
  void player.play(song, [song]);
}

/**
 * 起播后把进度挪到上次听到的位置。
 * seek 必须等 progress 真的起来（音频就绪、current 确实是这一集）才做，
 * 否则播放器内部还在切源，seek 会被随后的起播覆盖掉。
 */
function applyPendingSeek(): void {
  if (pendingSeekUrl.length == 0) return;
  if (!player.playing) return;
  if (currentUrl.value != pendingSeekUrl) return;
  const target = pendingSeekSec;
  pendingSeekUrl = "";
  pendingSeekSec = 0;
  if (target <= 0) return;
  if (Math.abs(player.progress - target) <= SEEK_TOLERANCE_SEC) return;
  player.seek(target);
}

/** 跟随播放器：发现换集就把上一集最后看到的位置落盘 */
function trackTick(): void {
  const url = currentUrl.value;
  if (url != trackedUrl) {
    flushTracked(false);
    trackedUrl = url;
    trackedSec = 0;
  }
  if (trackedUrl.length > 0) trackedSec = player.progress;
}

/**
 * 把跟踪中的这一集写回存储。
 * `force=false` 时位置没变就跳过（5s 心跳大部分时候无事可做）；
 * 位置为 0 且原本也没听过时也不写——刚起播/换集的瞬间 progress 是 0，
 * 那会把之前存的进度冲掉。
 */
function flushTracked(force: boolean = false): void {
  if (trackedUrl.length == 0) return;
  const ep = findTrackedEpisode();
  if (ep == null) return;
  const positionMs = Math.round(trackedSec * 1000);
  let totalMs = ep.durationMs;
  if (totalMs <= 0 && trackedUrl == currentUrl.value) totalMs = Math.round(player.duration * 1000);
  let played = ep.played;
  if (totalMs > 0 && positionMs >= Math.round(totalMs * FINISH_RATIO)) played = true;
  if (positionMs <= 0 && !played) return;
  if (!force && played == ep.played && Math.abs(positionMs - ep.positionMs) < PROGRESS_WRITE_MIN_MS) return;
  savePodcastProgress(ep.showId, ep.id, positionMs, played);
  ep.positionMs = positionMs;
  ep.played = played;
  // 索引与列表可能是两批对象（切订阅时重建过），按 id 同步回去并让列表重渲染
  const list = episodes.value;
  for (let i = 0; i < list.length; i++) {
    if (list[i].id == ep.id && list[i].showId == ep.showId) {
      list[i].positionMs = positionMs;
      list[i].played = played;
      epByUrl.set(list[i].audioUrl, list[i]);
      episodes.value = list.slice();
      break;
    }
  }
}

onMounted(() => {
  // 先提交页面框架，再读当前订阅，避免阻塞导航切换的第一帧。
  loadTimer = setTimeout(() => {
    loadTimer = null;
    if (disposed) return;
    loadShows();
    initialLoading.value = false;
  }, 32);
  saveTimer = setInterval(() => {
    // 心跳：跟着播放器换集/落进度，页面离开后定时器就没了（进度由进页面/切集兜底）
    trackTick();
    flushTracked(false);
  }, SAVE_INTERVAL_MS);
});

onUnmounted(() => {
  disposed = true;
  if (loadTimer != null) clearTimeout(loadTimer);
  if (autoRefreshTimer != null) clearTimeout(autoRefreshTimer);
  // 离开页面时把最后几秒也存下来，否则这一段进度就白听了
  trackTick();
  flushTracked(true);
  if (saveTimer != null) {
    clearInterval(saveTimer);
    saveTimer = null;
  }
});

watch(
  () => player.progress,
  () => {
    trackTick();
    applyPendingSeek();
  }
);

watch(
  () => player.current,
  () => {
    trackTick();
    applyPendingSeek();
  }
);

watch(
  () => player.playing,
  () => {
    trackTick();
    applyPendingSeek();
    // 暂停 = 一个天然的落盘点（用户切 App / 锁屏前也常是这次暂停），这里强制写盘
    if (!player.playing) flushTracked(true);
  }
);
</script>

