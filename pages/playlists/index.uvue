/* 宽屏：px 覆盖 rpx，避免宽屏下按窗口比例放大 */

.bar-wide { padding-top: 14px; padding-left: 24px; padding-right: 24px; padding-bottom: 10px; }
.sort-bar-wide { padding: 10px 24px 0; }
.cat-rows-wide { padding: 12px 20px 4px; flex-direction: row; align-items: flex-start; flex-shrink: 0; }
