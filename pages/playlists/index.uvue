<template>
  <qt-page-frame width-kind="grid" :header-actions="headerActions" @headerAction="onHeaderAction">
  <view ref="pageElement" class="page">
    <view v-if="layout.isWide" class="category-toolbar">
    <!-- 宽屏只保留紧凑预览；全部分类在工具条下方悬浮，不挤占列表高度。 -->
    <view v-if="sorts.length > 1 && layout.isWide" class="sort-bar" :class="layout.isWide ? 'sort-bar-wide' : ''">
      <QtOption v-for="s in sorts" :key="s.id" kind="chip" :label="s.name" :selected="selectedSort == s.id" @select="selectSort(s.id)" />
    </view>

    <view
      v-if="categories.length > 1 && layout.isWide"
      class="cat-rows-wide"
      :style="'width:' + rowsWidth + 'px;'"
    >
      <view v-for="(row, rowIndex) in visibleCategoryRows" :key="rowIndex" class="cat-row-wide" :style="categoryRowStyle + 'width:' + previewWidth + 'px;'">
        <QtOption v-for="cell in row" :key="cell.id" class="cat-tag-wide" kind="chip" :label="cell.name" :selected="selectedCategory == cell.id" :style="'width:' + cell.width + 'px;'" @select="selectCategory(cell.id)" />
      </view>
      <view class="cat-more-row">
        <view
          class="cat-more" :hover-class="'cat-tag-hover'"
          :style="'border-color:' + theme.skin.divider + ';width:' + catMoreWidth + 'px;height:' + qtOptionChipMinHeightPx() + 'px;'"
          @click="onHeaderAction('grid')"
        >
          <text
            class="cat-more-text" :max-lines="1"
            :style="qtFontDual(24, 13) + 'color:' + theme.skin.textMuted + ';'"
          >{{
            catPanelVisible ? "收起分类" : "全部分类（" + categories.length + "）"
          }}</text>
          <QtIcon
            :name="catPanelVisible ? 'arrow-up' : 'arrow-down'"
            :size="layout.isWide ? 12 : 22"
            :color="theme.skin.textMuted"
          />
        </view>
      </view>
    </view>
    </view>

    <!-- 用 list-view + list-item 承载卡片（App 端原生复用回收）：
         之前是整页 scroll-view + flex-wrap 网格，加载到 150+ 条时所有卡片
         （view + image + text，还带圆角/阴影）都常驻在原生视图树里，滚动必然掉帧。

         结构对齐 App 里其它已验证的 list-view 页面（歌手/搜索/歌单详情）：
         只保留「头部条目 + 一个 v-for + 尾部条目」，中间不再夹 list-item，
         避免原生侧对多段子节点的分组影响触底事件。 -->
    <list-view
      id="pl-scroll"
      :key="'plv-' + columns"
      class="scroll"
      direction="vertical"
      :lower-threshold="200"
      :show-scrollbar="false"
      :scroll-top="scrollTop"
      @scroll="onListScroll"
      @scrollend="onListScroll"
      @scrolltolower="onScrollToLower"
    >
      <!-- 头部条目：上留白 + 首屏（骨架 / 首屏真实行）。
           请求期间由骨架撑起该条目；数据到达后骨架立即卸载、同一条目里的
           首屏真实行接管，避免跨 list-item 的层级与回收问题。两种状态都使用
           skeletonRowCount 行，替换时不改变头部高度。
           骨架整层只此一处，光带也只挂这一处，绝不每块骨架各挂一条。 -->
      <list-item class="head-item">
        <view class="head-inner">
          <view class="pad-top" :class="layout.isWide ? 'pad-top-wide' : ''" />
          <view class="sk-host">
            <!-- 数据落地后直接显示真实首屏。这里曾做逐行淡入，但 Android/Harmony 的
                 list-view 定时器偶发不继续推进，结果骨架层永久盖住前 4 行，只有尾行可见。
                 骨架仅用于请求期间；数据回来便一次性卸载，避免「加载成功却像卡死」。 -->
            <view
              v-for="(row, rowIndex) in headRows"
              :key="'hr' + rowIndex"
              class="grid-row-inner" :class="layout.isWide ? 'grid-row-inner-wide' : ''"
            >
              <view
                v-for="item in row"
                :key="item.platform + ':' + item.id"
                class="card" :class="layout.isWide ? 'card-wide' : ''"
                :style="cardStyle"
                :hover-class="layout.isWide ? 'card-hover' : 'none'"
                @click="openPlaylist(item)"
              >
                <view class="cover-wrap" :style="coverStyle">
                  <image class="cover" :style="coverStyle" :src="item.picUrl" mode="aspectFill" />
                  <view v-if="item.playCount.length > 0" class="cover-badge" :class="layout.isWide ? 'cover-badge-wide' : ''">
                    <QtIcon name="headset" :size="layout.isWide ? 11 : 20" color="#ffffff" />
                    <text class="cover-badge-text" :class="layout.isWide ? 'cover-badge-text-wide' : ''" :style="qtFontDual(20, 11)">{{ formatBigCount(item.playCount) }}</text>
                  </view>
                </view>
                <text class="name" :class="layout.isWide ? 'name-wide' : ''" :max-lines="2" :style="qtFontDual(26, 15) + 'color:' + theme.skin.text + ';'">{{ item.name }}</text>
              </view>
            </view>
            <!-- 骨架仅在请求尚未返回时出现。真实数据一到立即卸载：原生 list-view 下
                 「绝对定位骨架 + 分行 transition」会偶发停在半途中，造成上方一直是灰块。 -->
            <view
              v-if="skeletonOn"
              class="sk-layer"
            >
              <view
                v-for="ri in skeletonRowCount"
                :key="'skr' + ri"
                class="grid-row-inner" :class="layout.isWide ? 'grid-row-inner-wide' : ''"
              >
                <view
                  v-for="ci in columns"
                  :key="'sk' + ri + '-' + ci"
                  class="card" :class="layout.isWide ? 'card-wide' : ''"
                  :style="cardStyle"
                >
                  <view class="sk-cover" :class="layout.isWide ? 'sk-cover-wide' : ''" :style="coverStyle"></view>
                  <view class="sk-line" :class="layout.isWide ? 'sk-line-wide' : ''"></view>
                  <view class="sk-line sk-line-short" :class="layout.isWide ? 'sk-line-short-wide' : ''"></view>
                </view>
              </view>
              <!-- 整页共用一道柔和的斜向光带，1.5s 从左扫到右 -->
              <QtSkeletonShine :visible="shining" />
            </view>
          </view>
        </view>
      </list-item>
      <list-item v-for="(row, tailIndex) in tailRows" :key="'r' + tailIndex" class="grid-row">
        <view class="grid-row-inner" :class="layout.isWide ? 'grid-row-inner-wide' : ''">
          <view
            v-for="item in row"
            :key="item.platform + ':' + item.id"
            class="card" :class="layout.isWide ? 'card-wide' : ''"
            :style="tailItemStyle(tailIndex)"
            :hover-class="layout.isWide ? 'card-hover' : 'none'"
            @click="openPlaylist(item)"
          >
            <view class="cover-wrap" :style="coverStyle">
              <image class="cover" :style="coverStyle" :src="item.picUrl" mode="aspectFill" />
              <view v-if="item.playCount.length > 0" class="cover-badge" :class="layout.isWide ? 'cover-badge-wide' : ''">
                <QtIcon name="headset" :size="layout.isWide ? 11 : 20" color="#ffffff" />
                <text class="cover-badge-text" :class="layout.isWide ? 'cover-badge-text-wide' : ''" :style="qtFontDual(20, 11)">{{ formatBigCount(item.playCount) }}</text>
              </view>
            </view>
            <text class="name" :class="layout.isWide ? 'name-wide' : ''" :max-lines="2" :style="qtFontDual(26, 15) + 'color:' + theme.skin.text + ';'">{{ item.name }}</text>
          </view>
        </view>
      </list-item>
      <!-- 尾部条目：空态 / 加载中 / 已加载全部，底部留白也由它承担 -->
      <list-item class="foot-item">
        <view class="foot-inner" :class="layout.isWide ? 'foot-inner-wide' : ''">
          <text v-if="playlists.length == 0 && !loading" class="empty-text" :class="layout.isWide ? 'empty-text-wide' : ''" :style="qtFontDual(27, 16)">暂无歌单</text>
          <qt-loading v-else-if="loadingMore" :visible="true" :size="44" />
          <text v-else-if="!hasMore" class="foot-text" :class="layout.isWide ? 'foot-text-wide' : ''" :style="qtFontDual(24, 14)">已加载全部</text>
        </view>
      </list-item>
    </list-view>
    <QtBackToTop :visible="showBackToTop" @tap="backToTop" />
    <!-- 保留分类专用的锚定浮层（不使用居中/底部 sheet）：宽屏对齐工具条，
         手机从标题栏下方打开；显式高度的原生滚动区承载全部分类。 -->
    <view
      v-if="catPanelVisible"
      class="cat-mask"
      :style="'background-color:' + (layout.isWide ? 'transparent' : theme.skin.scrim) + ';'"
      @click="closeCatPanel"
    ></view>
    <view
      v-if="catPanelVisible"
      class="cat-panel" :class="layout.isWide ? 'cat-panel-wide' : ''"
      :style="catPanelStyle"
    >
      <!-- 排序位于分类前（切排序不打断选分类），音源只声明一项时不显示。 -->
      <scroll-view
        class="cat-scroll-area"
        direction="vertical"
        :style="'height:' + catPanelHeight + 'px;'"
        :scroll-into-view="catSelectedIndex == 0 && catReveal.anchor.value.length > 0 ? catReveal.itemId(-1) : catReveal.anchor.value"
        :show-scrollbar="true"
      >
        <view v-if="sorts.length > 1 && !layout.isWide" class="cat-sort-row">
          <view v-for="s in sorts" :key="s.id" class="cat-sort-slot">
            <QtOption kind="chip" :label="s.name" :selected="selectedSort == s.id" @select="selectSort(s.id)" />
          </view>
        </view>
        <view v-if="layout.isWide" :id="catReveal.itemId(-1)" class="cat-panel-grid-wide">
          <view v-for="(row, rowIndex) in panelCategoryRows" :key="rowIndex" class="cat-panel-row-wide" :style="categoryRowStyle">
            <QtOption v-for="cell in row" :key="cell.id" :id="catReveal.itemId(categoryIndex(cell.id))" class="cat-panel-chip-wide" kind="chip" :label="cell.name" :selected="selectedCategory == cell.id" :style="'width:' + cell.width + 'px;'" @select="onCatCellTap(cell.id)" />
          </view>
        </view>
        <view v-else :id="catReveal.itemId(-1)" class="cat-grid">
          <view v-for="(row, rowIndex) in compactCategoryRows" :key="rowIndex" class="cat-grid-row">
            <view v-for="(cat, columnIndex) in row" :key="cat.id" :id="catReveal.itemId(rowIndex * catGridColumns + columnIndex)" class="cat-grid-cell" :style="catCellLayout(columnIndex)">
              <QtOption class="cat-grid-option" kind="chip" :label="cat.name" :selected="selectedCategory == cat.id" @select="onCatCellTap(cat.id)" />
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
  </qt-page-frame>
</template>
<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import { ref, computed, onMounted, onUnmounted, watch, nextTick } from "vue";
import { onShow } from "@dcloudio/uni-app";
import { musicApi } from "@/services/music-api";
import { formatBigCount } from "@/services/format";
import { packsFingerprint, SOURCE_PACKS_CHANGED_EVENT } from "@/services/source-update";
import { useSourceStore } from "@/stores/source";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useSourceRegistryStore } from "@/stores/source-registry";
import type { RegistrySort } from "@/services/music-api";
import QtLoading from "@/uni_modules/qt-ui/components/qt-loading/qt-loading.uvue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtOption from "@/uni_modules/qt-ui/components/qt-option/qt-option.uvue";
import { useQtSelectionReveal } from "@/uni_modules/qt-ui/composables/use-qt-selection-reveal";
import QtBackToTop from "@/uni_modules/qt-ui/components/qt-back-to-top/qt-back-to-top.uvue";
import QtSkeletonShine from "@/uni_modules/qt-ui/components/qt-skeleton-shine/qt-skeleton-shine.uvue";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtContentWidth, qtColumnCount, QT_MIN_COLUMN_WIDTH } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { qtTrackError } from "@/uni_modules/qt-stat";
import type { Playlist } from "@/types/music";
import type { Source } from "@/services/music-api";
import { qtFontDual, fontScale } from "@/uni_modules/qt-ui/stores/font-scale";
import { qtOptionChipWidthPx, qtOptionChipMinHeightPx, qtOptionChipRows } from "@/uni_modules/qt-ui/composables/qt-option-metrics";
import { logMsgErr } from "@/services/logger";

type PlaylistCategory = {
  id: string;
  name: string;
};

/** 已计算好宽度的标签单元，用于固定行布局 */
type CategoryCell = {
  id: string;
  name: string;
  width: number;
};

/** 头部条目承载的真实行数：与骨架行数一致，数据到达前后头部高度不变。
 *  取 4 是因为竖屏首屏实际能放下 4 行（3 列 + 封面 1:1）；取 2 时骨架只铺到
 *  首屏上四成，下面一大片空白，看上去不像「正在加载」而像「加载坏了」。 */
const HEAD_ROWS = 4;

const playlists = ref<Playlist[]>([]);
const categories = ref<PlaylistCategory[]>([]);
const selectedCategory = ref("");
/** 当前音源的歌单广场排序选项（v5 契约；数据包未声明 → 空 = 不渲染选择器） */
const sorts = computed((): RegistrySort[] => sourceRegistry.playlistSorts(sourceStore.current));
/** 选中的排序 id（包侧 playlistSorts 声明的 id 原样透传；空串 = 各平台默认） */
const selectedSort = ref("");
/**
 * 初值为 true：onMounted 里的 ensureLoad() 要等分类请求回来才发歌单请求，
 * 若初值为 false，首帧到那一刻之间骨架是关着的，正好闪一下白。
 */
const loading = ref(true);
const loadingMore = ref(false);
const hasMore = ref(true);
const page = ref(1);
const sourceStore = useSourceStore();
const sourceRegistry = useSourceRegistryStore();
// 排序选项就绪/变化后，若当前选中值不在选项里（典型：注册表晚于首次赋值就绪，
// selectedSort 停在空串——排序 chips 会全部没有高亮），回退到第一项。
// 注意必须放在 sourceRegistry 声明之后：immediate 首次执行会同步读 sorts，
// 放前面会踩 TDZ（真机 ReferenceError: Cannot access 'sourceRegistry' before initialization）。
watch(sorts, (list) => {
  if (list.length == 0) return;
  let ok = false;
  for (let i = 0; i < list.length; i++) {
    if (list[i].id == selectedSort.value) ok = true;
  }
  if (!ok) selectedSort.value = list[0].id;
}, { immediate: true });
const layout = useQtLayout();
const theme = useThemeStore();
/**
 * 窄屏栅格直接读全局响应式窗口宽。useQtLayout 每秒/旋转时会刷新它，
 * 不能只在 onMounted 抄一次；否则横竖屏切换后仍按旧宽度算列数和封面宽。
 */
const screenWidth = computed((): number => layout.windowWidth);

// 回到顶部
const scrollTop = ref(0);
const showBackToTop = ref(false);
/** list-view 可视高度（px），@scroll 兜底判断触底用 */
const viewportHeight = ref(0);
/** 兜底触底的判定距离（px）。刻意小于原生的 lower-threshold(200)：
 *  原生事件可用时永远由它先触发，这里只在原生事件失效时做第二道保险 */
const NEAR_BOTTOM_PX = 120;
/** 滚过这么多 px 还没收到原生 scrolltolower，就认为原生事件可疑，上报一次现场 */
const DEEP_SCROLL_PX = 2000;
/** 原生 scrolltolower 是否派发过；没派发过而滚得很深时上报现场 */
let lowerFired = false;
let diagReported = false;
let measureFailReported = false;
/** 本页所有延迟/重试定时器句柄：页面卸载时统一清掉，避免在已注销的实例上触发回调 */
let viewportTimers: number[] = [];
// 页面存活标志（onUnmounted 置 false）。
// 不能只靠上面那份句柄：框架路由（reLaunch/redirectTo/navigateBack）是先 closeWebview
// 销毁原生页、再 unmountPage 跑 onUnmounted，中间那段窗口原生 UniPage 已反注册而本页
// 脚本还在，此时 createSelectorQuery().exec() 会走到 $nativePage.waitNativeRender，
// 桥调用带着已反注册的 instanceId → "UTS instance N is not registered"。
// 所以定时器回调进场先判这个标志。
let viewportAlive = true;

/**
 * 量 list-view 自身高度。
 * Android 上 list-view 偶发不派发 scrolltolower（同一页面的 scroll-view 正常），
 * 所以除了 @scrolltolower，还用 @scroll 的 scrollTop/scrollHeight 自己算一次触底。
 */
function measureViewport(attempt: number = 0): void {
  if (!viewportAlive) return;
  try {
    uni.createSelectorQuery()
      .select("#pl-scroll")
      .boundingClientRect((rect: UniNodeInfo) => {
        if (rect != null && rect.height > 0) {
          viewportHeight.value = rect.height;
          return;
        }
        if (attempt < 3) {
          viewportTimers.push(setTimeout(() => {
            measureViewport(attempt + 1);
          }, 200) as number);
          return;
        }
        // 量不到高度就没有兜底，上报一次（否则线上只看得到"没触发"看不到原因）
        if (viewportHeight.value <= 0 && !measureFailReported) {
          measureFailReported = true;
          qtTrackError("list-view-viewport-measure-failed", "boundingClientRect height=0", "", "/pages/playlists/index");
        }
      })
      .exec();
  } catch (_) {
    // 静默：测量接口抛异常不影响列表渲染，仅丢失返回顶部按钮的显隐优化
  }
}

function onListScroll(e: any) {
  const detail = e != null ? e.detail : null;
  const st = detail != null ? Number(detail.scrollTop ?? 0) : 0;
  showBackToTop.value = st > 600;
  const sh = detail != null ? Number(detail.scrollHeight ?? 0) : 0;
  // 已经滚得很深了、原生 scrolltolower 却一次都没派发过 —— 上报一次现场（去重）
  if (st >= DEEP_SCROLL_PX) reportBottomDiag(st, sh);
  // 兜底触底：scrollHeight 至少要"一屏多"才可信（只比可视区大一点点说明它没统计全量内容，
  // 那种情况宁可不兜底，也不能误判成一直在底部、把整条推荐流一次性拉下来）
  if (viewportHeight.value <= 0 || st <= 0) return;
  if (sh <= viewportHeight.value * 1.2 + 120) return;
  if (st + viewportHeight.value >= sh - NEAR_BOTTOM_PX) loadMore();
}

/** @scrolltolower 原生事件的包装：命中即说明原生事件是好的 */
function onScrollToLower() {
  lowerFired = true;
  loadMore();
}

/**
 * 「滚了很深但原生 scrolltolower 没响过」的现场快照：不是给用户看的错误，
 * 是用来判断 list-view 触底事件到底有没有失效（顺带能看出 scrollHeight 是否可信）。
 */
function reportBottomDiag(scrollTopPx: number, scrollHeightPx: number): void {
  if (lowerFired || diagReported) return;
  diagReported = true;
  qtTrackError(
    "list-view-no-scrolltolower",
    "scrollTop=" + scrollTopPx + " scrollHeight=" + scrollHeightPx + " viewport=" + viewportHeight.value,
    "",
    "/pages/playlists/index"
  );
}
function backToTop() {
  scrollTop.value = scrollTop.value == 0 ? 1 : 0;
  showBackToTop.value = false;
}
/**
 * 整组换血前先回顶：list-view 停在滚动深处时整组替换数组会整段丢渲染
 * （大块空白带，搜索页 L871 注释与排行榜页均有实证），回顶后替换安全。
 * 切分类/切排序/换音源触发 load() 前调用。
 */
function resetListScroll() {
  scrollTop.value = scrollTop.value == 0 ? 1 : 0;
  showBackToTop.value = false;
}
let loadedSource = "";
/** 上次加载时的包态指纹：音源包安装/更新/卸载/启停后变化，分类+列表整页重拉 */
let loadedPackFp = "";

/** 栅格行可用宽（px）：宽屏取内容列宽减 `.grid-row-inner-wide` 的左右 20px */
const gridInnerWidth = computed((): number => {
  if (!layout.isWide) return screenWidth.value - 24 * 2;
  const w = qtContentWidth("grid") - 40;
  return w > 0 ? w : 0;
});
/** 宽屏卡间距（px），与 .grid-row-inner-wide 的内边距口径一致 */
const gridGap = computed((): number => layout.isWide ? 14 : 12);

const columns = computed((): number => {
  // 宽屏列数由「最小卡宽」推导，不再写死 5 列。
  // 改造前固定 5 列 + 卡宽写死 140px：1920px 窗口里 5×140 的卡片贴左排开，
  // 右侧空掉一多半内容列，而且内容列本身还是被旧 qt-page-frame 拉到 1360。
  if (layout.isWide) return qtColumnCount(gridInnerWidth.value, QT_MIN_COLUMN_WIDTH.card, gridGap.value, 8);
  const width = screenWidth.value;
  // 手机档统一最多 3 列（2026-10-24 用户反馈「一行 4 个有点拥挤」，QQ 音乐手机端也是 3 列）：
  // >=560 的平板竖屏同样只排 3 列，不再有 4 列档。
  // 旧逻辑要 width>=420 才有 3 列，360~412px 的常见机型只能排 2 列、卡片过大。
  // 只有极窄屏（<340px）才退回 2 列，避免卡片窄到 <78px。
  if (width >= 340) return 3;
  return 2;
});
const cardWidth = computed((): number => {
  const cols = columns.value;
  const gap = gridGap.value;
  const w = Math.floor((gridInnerWidth.value - gap * cols) / cols);
  if (!layout.isWide) return w;
  // 上限 200：再宽封面就抢了歌单名的主视觉，一行也放不下更多卡
  return w > 200 ? 200 : (w > 96 ? w : 96);
});
const cardStyle = computed(
  (): string =>
    "width:" + cardWidth.value + "px;margin-right:" + gridGap.value + "px;margin-bottom:" + (layout.isWide ? 14 : 18) + "px;"
);
const coverStyle = computed(
  (): string => "width:" + cardWidth.value + "px;height:" + cardWidth.value + "px;"
);

/**
 * 把歌单切成「一行 columns 张」的行数组。
 * list-item 的复用是按条目结构分池的：固定「一行 = columns 张卡」后每行子节点数一致，
 * 回收复用的命中率最高；只保留可视区附近的行，长列表也不会再有成千上万个常驻原生视图。
 */
const playlistRows = computed((): Playlist[][] => {
  const cols = columns.value;
  const rows: Playlist[][] = [];
  if (cols <= 0) return rows;
  const list = playlists.value;
  for (let index = 0; index < list.length; index += cols) {
    rows.push(list.slice(index, index + cols));
  }
  return rows;
});

/**
 * 请求期间固定铺满首屏。竖屏按 4 行（3 列首屏）铺满；宽屏则按各音源
 * 最短常见首页（20 张）和实际列数估算行数。否则 8 列宽屏上 20 张真实数据
 * 只有 3 行、骨架却有 4 行，数据落地会把下方内容突然上提一整行。
 *
 * 数据到达后 skeletonOn 会直接卸载整层，不再依赖原生 list-view 中不可靠的
 * 绝对定位/错峰透明度切换。
 */
const WIDE_SKELETON_ITEMS = 20;
const skeletonRowCount = computed((): number => {
  if (!layout.isWide) return HEAD_ROWS;
  const rows = Math.ceil(WIDE_SKELETON_ITEMS / columns.value);
  return rows < 1 ? 1 : (rows > HEAD_ROWS ? HEAD_ROWS : rows);
});

/**
 * 头部条目与骨架使用同一行数：宽屏列数越多时，首个 list-item 也随之收窄，
 * 避免骨架卸载后因为头部突然多出一行而把后续内容向下推。
 */
const headRows = computed((): Playlist[][] => playlistRows.value.slice(0, skeletonRowCount.value));
/** 其余行仍走 list-item 原生复用池 */
const tailRows = computed((): Playlist[][] => playlistRows.value.slice(skeletonRowCount.value));
/**
 * 骨架层只在「正在加载且没有结果」时挂载。空结果会在 load() 的 finally
 * 清掉 loading，随后由尾部条目显示「暂无歌单」，不会让骨架和空态打架。
 */
const skeletonOn = computed((): boolean => loading.value && playlists.value.length == 0);
/** 光带只在真正等待网络数据时显示。 */
const shining = computed((): boolean => skeletonOn.value);

/** 尾部行走 list-item 原生复用池，只写固定尺寸，避免滚动复用时出现空白行。 */
function tailItemStyle(_tailIndex: number): string {
  return cardStyle.value;
}

/** Preview and floating panel use the same chip metrics, with bounded row gaps. */
const CAT_WIDE_ROWS = 1;
const rowsWidth = computed((): number => qtContentWidth("grid"));
// Reserve the full action width before packing chips so it stays on the same line at every font tier.
const catMoreWidth = computed((): number => qtOptionChipWidthPx("全部分类（" + categories.value.length + "）") + 12);
const previewWidth = computed((): number => Math.max(1, rowsWidth.value - 40 - catMoreWidth.value));
const categoryRows = computed((): CategoryCell[][] =>
  qtOptionChipRows(categories.value, Math.max(1, previewWidth.value - 8), 8));
const visibleCategoryRows = computed((): CategoryCell[][] => categoryRows.value.slice(0, CAT_WIDE_ROWS));
// Native custom-component wrappers otherwise add extra row space beyond the chip.
// Use the shared font-aware line box, never a phone rpx height or a fixed small cap.
const categoryRowStyle = computed((): string => "height:" + (qtOptionChipMinHeightPx() + 8) + "px;");

function categoryFromRaw(item: UTSJSONObject): PlaylistCategory {
  const id = item.get("id");
  const name = item.get("name");
  return {
    id: id != null ? id.toString() : "",
    name: decodeHtmlEntities(name != null ? name.toString() : ""),
  };
}

/**
 * 数据包侧的分类名偶尔带着未解码的 HTML 实体（真机见「R&#38;B」应为「R&B」）。
 * UTS 的 replace 对回调替换支持不稳，手写扫描：命名实体取表，数字/十六进制取码点。
 */
function decodeHtmlEntities(input: string): string {
  if (input.indexOf("&") == -1) return input;
  const named: Map<string, string> = new Map();
  named.set("amp", "&");
  named.set("lt", "<");
  named.set("gt", ">");
  named.set("quot", '"');
  named.set("apos", "'");
  named.set("nbsp", " ");
  let out = "";
  let i = 0;
  while (i < input.length) {
    const ch = input.charAt(i);
    if (ch != "&") {
      out += ch;
      i++;
      continue;
    }
    const semi = input.indexOf(";", i + 1);
    if (semi == -1 || semi - i > 10) {
      out += ch;
      i++;
      continue;
    }
    const body = input.substring(i + 1, semi);
    let decoded: string | null = null;
    if (body.length > 1 && (body.charAt(0) == "#" || body.charAt(0) == "x" || body.charAt(0) == "X")) {
      const digits = body.charAt(0) == "#" ? body.substring(1) : body.substring(1);
      const code = parseInt(digits, body.charAt(0) == "#" ? 10 : 16);
      if (!isNaN(code) && code > 0 && code <= 0x10ffff) decoded = String.fromCharCode(code);
    } else if (named.has(body)) {
      decoded = named.get(body)!;
    }
    if (decoded == null) {
      out += ch;
      i++;
    } else {
      out += decoded!;
      i = semi + 1;
    }
  }
  return out;
}

async function loadCategories(source: Source): Promise<void> {
  const seq = ++categorySeq;
  const raw = await musicApi.playlistCategories(source);
  const next: PlaylistCategory[] = [{ id: "", name: "全部" }];
  for (let index = 0; index < raw.length; index++) {
    const category = categoryFromRaw(raw[index] as UTSJSONObject);
    if (category.id.length == 0 || category.name.length == 0) continue;
    // 「全部」由上面那条空 id 合成项承担：包侧再给一个同义项会出现两个「全部」
    if (category.name == "全部" || category.name == "全部歌单") continue;
    next.push(category);
  }
  if (seq !== categorySeq) return;
  categories.value = next;
}

/** 首屏 / 切换分类后的首页加载 */
// 加载序号：快速切分类/切音源时旧响应晚到不得覆盖新数据（写回前比对）
let loadSeq = 0;
let categorySeq = 0;

async function load(): Promise<void> {
  const seq = ++loadSeq;
  // 切分类/排序/音源的整组换血：先回顶再换数据（见 resetListScroll 注释）
  resetListScroll();
  loading.value = true;
  page.value = 1;
  hasMore.value = true;
  try {
    const list = await musicApi.recommendations(
      sourceStore.current as Source,
      selectedCategory.value,
      1,
      selectedSort.value
    );
    if (seq !== loadSeq) return;
    playlists.value = list;
    // 数据到达后直接由 skeletonOn 卸载骨架。避免 list-view 内错峰动画
    // 在 Android/Harmony 偶发停摆，留下「前四行灰块、尾行已显示」的假死页面。
    // 各平台单页条数不同（网易云/QQ 30 条、酷狗 20 条），
    // 因此只用“空结果”判定到底，不按固定页长推断
    if (list.length == 0) hasMore.value = false;
  } catch (error) {
    logMsgErr("[QT Music Playlists Load] " + sourceStore.current + " " + selectedCategory.value, error);
    if (seq !== loadSeq) return;
    qtShowToast({ title: "歌单加载失败", icon: "none" });
  } finally {
    if (seq === loadSeq) loading.value = false;
  }
}

/** 触底加载下一页，按 platform:id 去重 */
async function loadMore(): Promise<void> {
  if (loading.value || loadingMore.value || !hasMore.value) return;
  if (playlists.value.length == 0) return;
  loadingMore.value = true;
  const seq = loadSeq;
  try {
    const next = page.value + 1;
    const list = await musicApi.recommendations(
      sourceStore.current as Source,
      selectedCategory.value,
      next,
      selectedSort.value
    );
    // 在途期间发生了切分类/切音源（loadSeq 已变）：丢弃旧页，避免串进新列表
    if (seq !== loadSeq) return;
    if (list.length == 0) {
      hasMore.value = false;
      return;
    }
    const seen = new Set<string>();
    for (let index = 0; index < playlists.value.length; index++) {
      const item = playlists.value[index];
      seen.add(item.platform + ":" + item.id);
    }
    let added = 0;
    for (let index = 0; index < list.length; index++) {
      const item = list[index];
      const key = item.platform + ":" + item.id;
      if (!seen.has(key)) {
        seen.add(key);
        playlists.value.push(item);
        added++;
      }
    }
    page.value = next;
    // 整页都是已有项，说明该接口不再返回新数据
    if (added == 0) hasMore.value = false;
  } catch (error) {
    logMsgErr("[QT Music Playlists More] " + sourceStore.current + " p" + page.value, error);
    // R8：晚到的旧请求失败不弹 toast —— 在途切分类/切音源后，旧页的报错会
    // 盖在新列表上误导用户「新列表也失败了」；日志照记供诊断
    if (seq === loadSeq) qtShowToast({ title: "加载更多失败，请重试", icon: "none" });
  } finally {
    loadingMore.value = false;
  }
}

async function ensureLoad(): Promise<void> {
  const fp = packsFingerprint();
  if (loadedSource == sourceStore.current && loadedPackFp == fp) return;
  loadedSource = sourceStore.current;
  loadedPackFp = fp;
  const source = sourceStore.current;
  selectedCategory.value = "";
  // 排序回退到该源声明的第一项（未声明 = 空串 = 各平台默认排序）
  const sortList = sorts.value;
  selectedSort.value = sortList.length > 0 ? sortList[0].id : "";
  playlists.value = [];
  // 也要在这里就点亮 loading：下面 await 分类请求期间还没有人把 loading 置真，
  // 而骨架层的显示条件里有 loading 这一项 —— 漏掉这一句，切音源时从清空列表到
  // load() 真正开跑之间会有一段空窗，骨架不显示，正好闪一下白
  loading.value = true;
  categories.value = [{ id: "", name: "全部" }];
  // 作废在途的旧音源分类请求（loadCategories 写回前按序号比对）
  categorySeq++;
  try {
    await loadCategories(source as Source);
  } catch (error) {
    logMsgErr("[QT Music Playlist Categories] " + source, error);
    if (loadedSource == source) qtShowToast({ title: "分类加载失败", icon: "none" });
  }
  if (loadedSource !== source) return;
  await load();
}

function selectCategory(category: string): void {
  if (selectedCategory.value == category) return;
  selectedCategory.value = category;
  playlists.value = [];
  load();
}

// ==================== 锚定工具条的全部分类浮层 ====================
const headerActions = ["grid"];
const pageElement = ref<UniElement | null>(null);
const catPanelVisible = ref(false);
const toolbarHeight = ref(0);
const pageHeight = ref(0);
const panelTop = computed((): number => layout.isWide ? toolbarHeight.value + 4 : 0);
// Compact page-frame fills the window; wide popovers keep the page's inner padding.
const panelWidth = computed((): number => Math.max(1, layout.isWide ? qtContentWidth("grid") - 40 : layout.windowWidth));
const panelCategoryRows = computed((): CategoryCell[][] =>
  qtOptionChipRows(categories.value, Math.max(1, panelWidth.value - 34), 8));
const catPanelStyle = computed((): string => {
  const wide = layout.isWide;
  return "top:" + panelTop.value + "px;left:" + (wide ? 20 : 0) + "px;width:" + panelWidth.value
    + "px;background-color:" + theme.skin.sheetSurface + ";border-color:" + theme.skin.border
    + ";" + (wide ? "box-shadow:0 6px 20px " + theme.skin.shadow + ";" : "");
});
/** Bound to the actual page, which already reserves the fixed player and safe area. */
const catPanelHeight = computed((): number => {
  const available = (pageHeight.value > 0 ? pageHeight.value : layout.windowHeight * 0.75) - panelTop.value - 14;
  const limit = Math.max(1, Math.min(available, layout.windowHeight * (layout.isWide ? 0.5 : 0.6)));
  if (!layout.isWide) return Math.floor(limit);
  const content = panelCategoryRows.value.length * (qtOptionChipMinHeightPx() + 8) + 24;
  return Math.ceil(Math.min(content, limit));
});
function measureCategoryPanel(): void {
  const root = pageElement.value;
  if (root == null) return;
  const rect = root.getBoundingClientRect();
  const toolbar = root.querySelector(".category-toolbar");
  if (rect.height > 0) pageHeight.value = rect.height;
  if (toolbar != null) {
    const bar = toolbar.getBoundingClientRect();
    toolbarHeight.value = Math.max(0, bar.bottom - rect.top);
  }
}
watch(() => String(layout.sizeEpoch) + ":" + fontScale.scale + ":" + categories.value.length,
  () => { if (catPanelVisible.value) nextTick(measureCategoryPanel); });
const CAT_GRID_MAX_COLS = 3;
const CAT_GRID_GAP_PX = 10;
// Match the panel's two 1px borders and the grid's 14px side padding exactly.
const catGridInnerWidth = computed((): number => Math.max(1, panelWidth.value - 2 - 14 * 2));
/** Keep up to three equal columns, reducing density when the actual labels or font tier need room. */
const catGridColumns = computed((): number => {
  const available = catGridInnerWidth.value;
  let widest = 1;
  const items = categories.value;
  for (let i = 0; i < items.length; i++) {
    widest = Math.max(widest, qtOptionChipWidthPx(items[i].name));
  }
  const count = Math.floor((available + CAT_GRID_GAP_PX) / (widest + CAT_GRID_GAP_PX));
  return Math.max(1, Math.min(CAT_GRID_MAX_COLS, count));
});
const catCellWidth = computed((): number => {
  const columns = catGridColumns.value;
  const inner = catGridInnerWidth.value - CAT_GRID_GAP_PX * (columns - 1);
  return Math.max(1, Math.floor(inner / columns));
});
const compactCategoryRows = computed((): PlaylistCategory[][] => {
  const rows: PlaylistCategory[][] = [];
  const columns = catGridColumns.value;
  for (let i = 0; i < categories.value.length; i += columns) {
    rows.push(categories.value.slice(i, i + columns));
  }
  return rows;
});
function catCellLayout(columnIndex: number): string {
  // Native views own the grid geometry; custom-component wrappers must not trigger extra wrapping.
  const mr = columnIndex == catGridColumns.value - 1 ? 0 : CAT_GRID_GAP_PX;
  return "width:" + catCellWidth.value + "px;margin-right:" + mr + "px;";
}
function categoryIndex(id: string): number {
  for (let i = 0; i < categories.value.length; i++) {
    if (categories.value[i].id == id) return i;
  }
  return -1;
}
const catSelectedIndex = computed((): number => categoryIndex(selectedCategory.value));
const catReveal = useQtSelectionReveal(() => catPanelVisible.value, () => catSelectedIndex.value,
  () => categories.value.map((item) => item.id).join("|"));
function openCatPanel(): void {
  measureCategoryPanel();
  catPanelVisible.value = true;
}
function closeCatPanel(): void { catPanelVisible.value = false; }
function onHeaderAction(_name: string): void {
  if (catPanelVisible.value) closeCatPanel();
  else openCatPanel();
}
function onCatCellTap(id: string): void {
  selectCategory(id);
  closeCatPanel();
}

/** 切换排序（v5 契约：id 原样透传给包侧 recommendations），重新拉第一页 */
function selectSort(sortId: string): void {
  if (selectedSort.value == sortId) return;
  selectedSort.value = sortId;
  playlists.value = [];
  load();
}

function openPlaylist(list: Playlist): void {
  uni.navigateTo({
    url: "/pages/playlist/index?id=" + encodeURIComponent(list.id) + "&platform=" + encodeURIComponent(list.platform),
  });
}

/** 音源包变更广播：App 层更新弹窗确认时收不到 onShow，事件实时重拉 */
function onPacksChanged(): void {
  ensureLoad();
}

onMounted(() => {
  sourceStore.restore();
  sourceRegistry.ensure();
  ensureLoad();
  uni.$on(SOURCE_PACKS_CHANGED_EVENT, onPacksChanged);
  // 首帧 list-view 还没完成布局，晚一点量（measureViewport 内部还有重试）
  viewportTimers.push(setTimeout(() => {
    measureViewport();
  }, 300) as number);
});
onShow(() => {
  sourceStore.restore();
  ensureLoad();
  if (viewportHeight.value <= 0) measureViewport();
});
onUnmounted(() => {
  viewportAlive = false;
  // 页面卸载时清掉全部延迟/重试定时器，避免在已注销的 UTS 实例上触发回调
  for (const t of viewportTimers) {
    if (t != null) clearTimeout(t);
  }
  viewportTimers = [];
  uni.$off(SOURCE_PACKS_CHANGED_EVENT, onPacksChanged);
});

</script>

<style>
.page {
  flex: 1;
  position: relative;
}
/* 排序标签条：一行即可，不参与滚动；样式与分类标签同一套视觉语言 */
.sort-bar {
  flex-direction: row;
  align-items: center;
  padding: 14rpx 28rpx 0;
  flex-grow: 0;
  flex-shrink: 0;
}
.cover-load {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  justify-content: center;
  align-items: center;
  z-index: 10;
}
.bar {
  padding: 22rpx 28rpx 14rpx;
  flex-direction: row;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.62);
  border-width: 1px; border-style: solid;
  border-color: rgba(255, 255, 255, 0.6);
}
/* 分类浮层是页面内容区的同级覆盖层；透明遮罩拦截背景点击，不占列表高度。 */
.category-toolbar { flex-shrink: 0; }
.cat-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; z-index: 30; }
.cat-panel {
  position: absolute;
  border-radius: 0 0 24rpx 24rpx;
  overflow: hidden;
  border-width: 1px;
  border-style: solid;
  z-index: 31;
}
.cat-panel-wide { border-radius: 16px; }
.cat-scroll-area { flex-grow: 0; flex-shrink: 0; }
.cat-sort-row { padding: 14px 14px 0; flex-direction: row; flex-wrap: wrap; }
.cat-sort-slot { flex-shrink: 0; margin-right: 10px; margin-bottom: 4px; }
.cat-grid { padding: 10px 14px 6px; flex-direction: column; }
.cat-grid-row { flex-direction: row; flex-wrap: nowrap; align-items: stretch; flex-shrink: 0; margin-bottom: 10px; }
.cat-grid-cell { flex-shrink: 0; min-width: 0; }
.cat-grid-option { align-self: stretch; justify-content: center; }
.cat-panel-grid-wide { padding: 16px 16px 8px; flex-direction: column; }
.cat-panel-row-wide { flex-direction: row; align-items: flex-start; flex-shrink: 0; }
.cat-panel-chip-wide { margin-right: 8px; margin-bottom: 8px; border-radius: 18px; }
/* list-view 需要明确的高度小于内容高度才会滚动（flex:1 + min-height:0 限定在可视区内） */
.scroll {
  flex: 1;
  min-height: 0;
}
/* 卡片行：list-item 只做复用条目，行内布局交给内层 view
   （flex 行 + 左右留白与旧网格一致，行间距由卡片自身 margin-bottom 提供） */
.grid-row-inner {
  flex-direction: row;
  padding-left: 24px;
  padding-right: 24px;
}
/* 头部/尾部条目：list-item 不支持 margin，间距一律用内层 view 的 padding/height 表达 */
.head-inner {
  flex-direction: column;
}
.foot-inner {
  height: 88rpx;
  padding-bottom: 40rpx;
  justify-content: center;
  align-items: center;
}
.pad-top {
  height: 16rpx;
}
/* 骨架宿主：骨架与真实首屏行都由同一个 list-item 承载。
   请求期间骨架参与文档流；数据到达后它直接卸载，真实首屏以相同行数接管。
   行数由 skeletonRowCount 统一控制，避免宽屏多列时发生整行高度跳变。 */
.sk-host {
  position: relative;
  flex-direction: column;
}
/* 骨架层参与文档流，在请求期间撑起首屏高度；数据回来后由 v-if 直接卸载。
   不用绝对定位叠层：Android/Harmony 的 list-view 上该组合偶发保留灰块。 */
.sk-layer {
  position: relative;
  flex-direction: column;
  pointer-events: none;
}
/* 卡片走 QQ 音乐同款扁平形态：无底无框，封面即卡面，歌单名裸排在封面下 */
.card {
  overflow: visible;
}
.cover-wrap {
  position: relative;
}
.cover {
  background-color: #e6e8ec;
  border-radius: 12rpx;
  overflow: hidden;
}
.cover-badge {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  flex-direction: row;
  align-items: center;
  padding: 4rpx 12rpx;
  background-color: rgba(0, 0, 0, 0.35);
  border-radius: 999rpx;
}
.cover-badge-wide {
  left: 4px;
  top: 4px;
  padding: 1px 7px;
}
.cover-badge-text {
  margin-left: 4rpx;
  color: #ffffff;
  font-size: 20rpx;
}
.cover-badge-text-wide { margin-left: 3px; font-size: 11px; }
/* 骨架屏占位：与 .cover/.name 尺寸对齐，用半透明灰以兼容深浅两种底 */
.sk-cover {
  background-color: rgba(25,29,38,0.18);
  border-radius: 16rpx;
}
.sk-line {
