.whero-act-gap { margin-left: 10px; }
.whero-act-text { margin-left: 6px; font-size: 13px; }
.whero-tools { margin-top: 10px; flex-direction: row; align-self: flex-end; }
.whero-tool { width: 40px; height: 40px; border-radius: 20px; align-items: center; justify-content: center; border-width: 1px; border-style: solid; }
.whero-tool-gap { margin-left: 10px; }

/* 宽屏左右布局：左栏歌手信息 + 右栏歌曲列表（竖屏保持上下） */
.page-wide { flex-direction: row; align-items: stretch; padding: 16px 20px 0; }
.wide-left { width: 272px; flex-shrink: 0; margin-right: 16px; padding-bottom: 16px; }
/* 宽屏左栏宽度已改由 wideAsideStyle 内联给出（窄平板横屏会收窄到 220~272 之间），这里只留兜底 */
.whero { padding: 16px; flex-direction: column; border-width: 1px; border-style: solid; border-radius: 16px; }
.whero-cover { width: 238px; height: 238px; border-radius: 12px; overflow: hidden; align-items: center; justify-content: center; }
