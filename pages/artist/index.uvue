<template>
  <qt-page-frame :max-width="layout.isWide ? 1080 : 860">
  <view class="page" :class="[themeStore.dark ? 'page-dark' : '', layout.isWide ? 'page-wide' : '']">
    <!-- 宽屏左栏：歌手信息（竖屏时隐藏，hero 在列表上方） -->
    <scroll-view v-if="layout.isWide" class="wide-left" direction="vertical" :show-scrollbar="false">
      <view class="whero" :class="themeStore.dark ? 'whero-dark' : ''">
        <view class="wcover" :style="'background-color:' + themeStore.skin.accent + ';'">
          <image v-if="avatarUrl.length > 0" class="wcover-img" :src="avatarUrl" mode="aspectFill" />
          <QtIcon v-else name="mic" :size="60" :color="themeStore.skin.onAccent" />
        </view>
        <text class="wname" :class="themeStore.dark ? 'wname-dark' : ''" :max-lines="2">{{ artist }}</text>
        <text class="wsub" :class="themeStore.dark ? 'wsub-dark' : ''">歌手热门歌曲</text>
      </view>
    </scroll-view>
    <!-- 竖屏 hero：贴顶横幅；宽屏下移入左栏 -->
    <view v-if="!layout.isWide" class="hero" :class="themeStore.dark ? 'hero-dark' : ''">
      <view class="avatar" :style="'background-color:' + themeStore.skin.accent + ';box-shadow:0 10rpx 24rpx ' + qtAccentRgba(themeStore.skin, 0.3) + ';'">
        <image v-if="avatarUrl.length > 0" class="avatar-img" :src="avatarUrl" mode="aspectFill" />
        <QtIcon v-else name="mic" :size="48" :color="themeStore.skin.onAccent" />
      </view>
      <view class="hero-info">
        <text class="name" :class="themeStore.dark ? 'name-dark' : ''" :max-lines="1">{{ artist }}</text>
        <text class="sub" :class="themeStore.dark ? 'sub-dark' : ''">歌手热门歌曲</text>
      </view>
    </view>
    <list-view
      class="scroll"
      :class="layout.isWide ? 'scroll-wide' : ''"
      direction="vertical"
      :lower-threshold="200"
      :scroll-top="scrollTop"
      @scroll="onListScroll"
    >
      <list-item class="head-item">
        <view class="list-head" :class="[themeStore.dark ? 'list-head-dark' : '', layout.isWide ? 'list-head-wide' : '']"
          ><text class="list-title" :class="[themeStore.dark ? 'list-title-dark' : '', layout.isWide ? 'list-title-wide' : '']">热门歌曲 {{ songs.length }} 首{{ finished ? "" : "，加载中" }}</text
            ><view class="play-all" :class="layout.isWide ? 'play-all-wide' : ''" :style="'background-color:' + themeStore.skin.accentSoft + ';'" @click="playAll"
            ><QtIcon name="play" :size="layout.isWide ? 16 : 28" :color="themeStore.skin.accent" /><text class="play-all-text" :class="layout.isWide ? 'play-all-text-wide' : ''" :style="'color:' + themeStore.skin.accent + ';'">播放全部</text></view
          ></view
        >
      </list-item>
      <list-item v-if="loading && songs.length == 0" class="empty-item" :class="layout.isWide ? 'empty-item-wide' : ''">
        <qt-loading :visible="true" />
      </list-item>
      <list-item
        v-for="song in songs"
        :key="song.id + song.platform"
        class="row-item" :class="[[layout.isWide ? 'row-item-wide' : ''], layout.isWide ? 'row-item-wide' : '']"
        
      >
        <QtSongRowLite
          :song="song"
          :showBadge="false"
          @play="play(song)"
          @more="openSheet"
        />
      </list-item>
      <list-item v-if="!loading && songs.length == 0" class="empty-item" :class="layout.isWide ? 'empty-item-wide' : ''">
        <text class="empty-text" :class="[themeStore.dark ? 'empty-text-dark' : '', layout.isWide ? 'empty-text-wide' : '']">暂无该歌手的热门歌曲</text>
        <text class="empty-retry" :class="layout.isWide ? 'empty-retry-wide' : ''" @click="retry">重新加载</text>
      </list-item>
      <list-item v-if="!finished && songs.length > 0" class="foot-item foot-item-progress" :class="layout.isWide ? 'foot-item-wide foot-item-progress-wide' : ''">
        <qt-loading :visible="true" :size="44" />
        <text class="foot-text" :class="[themeStore.dark ? 'foot-text-dark' : '', layout.isWide ? 'foot-text-wide' : '']">正在取完其余…已加载 {{ songs.length }} 首</text>
      </list-item>
      <list-item v-else-if="finished && songs.length > 0" class="foot-item" :class="layout.isWide ? 'foot-item-wide' : ''">
        <text class="foot-text" :class="[themeStore.dark ? 'foot-text-dark' : '', layout.isWide ? 'foot-text-wide' : '']">已加载全部 {{ songs.length }} 首</text>
      </list-item>
    </list-view>
    <QtBackToTop :visible="showBackToTop" @tap="backToTop" />
    <QtActionSheet
      v-model:visible="sheetVisible"
      :title="sheetTitle()"
      :actions="sheetActions"
      @select="onSheetSelect"
    />
    <MiniPlayer />
  </view>
  </qt-page-frame>
</template>
<script setup lang="ts">
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import { ref, computed, onMounted, onUnmounted } from "vue";
import { onLoad, onShow } from "@dcloudio/uni-app";
import MiniPlayer from "@/uni_modules/qt-ui/components/qt-mini-player/qt-mini-player.uvue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtLoading from "@/uni_modules/qt-ui/components/qt-loading/qt-loading.uvue";
import QtSongRowLite from "@/uni_modules/qt-ui/components/qt-song-row-lite/qt-song-row-lite.uvue";
import QtActionSheet from "@/uni_modules/qt-ui/components/qt-action-sheet/qt-action-sheet.uvue";
import QtBackToTop from "@/uni_modules/qt-ui/components/qt-back-to-top/qt-back-to-top.uvue";
import { useSongSheet } from "@/composables/use-song-sheet";
import { musicApi } from "@/services/music-api";
import { startPagedAllJob, clearPagedAllJob } from "@/services/paged-all";
import type { PagedAllJob, PagedAllPage, PagedAllState } from "@/services/paged-all";
import { resolveArtistId } from "@/services/artist-id";
import { packsFingerprint, SOURCE_PACKS_CHANGED_EVENT } from "@/services/source-update";
import { usePlayerStore } from "@/stores/player";
import { useSourceStore } from "@/stores/source";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useThemeStore, qtAccentRgba } from "@/uni_modules/qt-ui/stores/theme";
import type { Song } from "@/types/music";
import type { Source } from "@/services/music-api";

const player = usePlayerStore();
const sourceStore = useSourceStore();
const layout = useQtLayout();
const themeStore = useThemeStore();

// 回到顶部
const scrollTop = ref(0);
const showBackToTop = ref(false);
function onListScroll(e: any) {
  const st = e.detail != null ? Number(e.detail.scrollTop ?? 0) : 0;
  showBackToTop.value = st > 600;
}
function backToTop() {
  scrollTop.value = scrollTop.value == 0 ? 1 : 0;
  showBackToTop.value = false;
}
const { sheetVisible, sheetActions, openSheet, onSheetSelect, sheetTitle } =
  useSongSheet();
const artist = ref("");
/** 歌手真实 id（2026-10-06）：跳转带了就按 id 取作品，没有就退回名字搜索 */
const artistId = ref("");
const songs = ref<Song[]>([]);
const avatarUrl = ref("");
const loading = ref(false);
/** 全量是否收尾：收尾前底部一直显示进度（以前只看「还有下一页」，翻页失效时停不下来） */
const finished = ref(false);
/** 每页期望条数；实际下发值再按数据包声明的上限收敛（见 ensureLoad） */
const ARTIST_PAGE_SIZE = 30;
/**
 * 缓存键（同时也是「要不要重拉」的判据）：音源 + 歌手名 + 每页条数 + 歌手 id。
 * 命中缓存任务时一次请求都不发；即使中途离开页面，后台也继续跑完并留在缓存里。
 */
let cacheKey = "";
/** 当前订阅的全量任务（退订只停止接收，任务继续跑完） */
let job: PagedAllJob | null = null;
let onJobState: ((state: PagedAllState) => void) | null = null;
let loadedSource = "";
/** 上次加载时的包态指纹：音源包安装/更新/卸载/启停后变化，整页重拉 */
let loadedPackFp = "";
/** 上次加载时的每页条数：注册表晚到导致上限变化时也要重拉（否则翻页粒度不一致） */
let loadedPageSize = 0;

const emptyShow = computed(() => songs.value.length == 0);

onLoad((option: UTSJSONObject) => {
  const nameValue = option.get("name") as string | null;
  artist.value = nameValue != null ? nameValue : "";
  const idValue = option.get("id") as string | null;
  artistId.value = idValue != null ? idValue : "";
});

/**
 * 取一页（供全量任务并发调用）。
 *
 * 没带真 id（从歌单/播放页点歌手名进来）时先补一次：包里拿不到 id 会退回
 * 「把歌手名当关键词全局搜索」，越往后越跑偏（翻唱 / 合作 / 同名歌手）。
 */
async function fetchPage(page: number): Promise<PagedAllPage> {
  const source = sourceStore.current as Source;
  const id = artistId.value.length > 0 ? artistId.value : await resolveArtistId(source, artist.value);
  const result = await musicApi.artistSongs(artist.value, source, page, loadedPageSize, id);
  // 包给了权威 hasMore 就用它；旧包没有该字段（null）才退回「本页非空 = 还有」——
  // 歌手作品是过滤型列表，逐页条数天然不齐，拿「不满一页」当到底会在中途收尾。
  const hasMore = result.hasMore != null ? (result.hasMore as boolean) : result.songs.length > 0;
  return { songs: result.songs, meta: page <= 1 ? result.picUrl : "", hasMore: hasMore };
}

/** 退订当前任务（页面销毁 / 换歌手），任务本身继续跑完 */
function detach(): void {
  if (job != null && onJobState != null) job.unsubscribe(onJobState as (state: PagedAllState) => void);
  job = null;
  onJobState = null;
}

function ensureLoad(): void {
  const fp = packsFingerprint();
  // 注册表异步到达：首帧可能按兜底值取过一页，真实上限一到就整页重拉，
  // 否则首页粒度与后续页不一致，「满页 = 还有下一页」的推断会失真。
  const pageSize = musicApi.clampSearchPageSize(sourceStore.current as Source, ARTIST_PAGE_SIZE);
  const key =
    "artist:" + sourceStore.current + ":" + artist.value + ":" + pageSize + ":" + artistId.value + ":" + fp;
  if (loadedSource == sourceStore.current && loadedPackFp == fp && loadedPageSize == pageSize && cacheKey == key) {
    // 同一个歌手再进来：任务还在缓存里（甚至还在跑），但订阅在上次 onUnmounted 时退掉了，
    // 必须重新挂上 —— 否则这次页面永远收不到状态，列表是空的。
    if (job == null) startLoad();
    return;
  }
  loadedSource = sourceStore.current;
  loadedPackFp = fp;
  loadedPageSize = pageSize;
  cacheKey = key;
  // 这里**不能** clearPagedAllJob(key)：key 里含歌手 / 音源 / 包指纹 / 每页条数，
  // 任一变化就是另一个 key，旧任务自然没人再用；而 key 相同时清掉，等于把刚
  // 缓存好的全量结果丢掉（第二次进页又要重拉）。真正需要清缓存的是 retry。
  detach();
  songs.value = [];
  finished.value = false;
  loading.value = true;
  // 头像只跟第 1 页回来，而命中缓存时不会再取第 1 页：另存一份，第二次进页头像不能丢
  avatarUrl.value = readAvatar(key);
  startLoad();
}

async function startLoad(): Promise<void> {
  // 每页条数依赖注册表：先等它就绪，否则按兜底值取会拿到 0 条，全量任务直接收尾
  await musicApi.ensureRegistry();
  const key = cacheKey;
  const pageSize = musicApi.clampSearchPageSize(sourceStore.current as Source, ARTIST_PAGE_SIZE);
  if (key != cacheKey) return;
  // onMounted / onShow 会连着各调一次 ensureLoad，而这里 await 过注册表：
  // 两次都可能在 await 之后才走到这里，谁先到谁订阅，后来的直接退出（否则订阅两份）。
  if (job != null) return;
  loadedPageSize = pageSize;
  const current = startPagedAllJob(key, {
    fetchPage: fetchPage,
    keyOf: (song: Song) => song.id + ":" + song.platform,
    pageSize: pageSize,
    // 歌手歌曲最多几千首（100/页 → 几十页）：上限只是防上游一直给满页时打转
    maxPages: 60,
  });
  job = current;
  const listener = (state: PagedAllState): void => {
    if (key != cacheKey) return;
    songs.value = state.items;
    loading.value = state.loading;
    finished.value = state.finished;
    if (state.meta.length > 0) {
      avatarUrl.value = state.meta;
      rememberAvatar(key, state.meta);
    }
  };
  onJobState = listener;
  current.subscribe(listener);
}

/** 音源包变更广播：App 层更新弹窗确认时收不到 onShow，事件实时重拉 */
function onPacksChanged(): void {
  ensureLoad();
}

/** 重试：先丢掉缓存任务，否则会立刻拿回同一份结果 */
function retry(): void {
  clearPagedAllJob(cacheKey);
  // 清空键让 ensureLoad 判定「换了歌手」，走完整重拉分支
  cacheKey = "";
  ensureLoad();
}

async function play(song: Song): Promise<void> {
  try {
    song.url = await musicApi.playUrl(song, player.quality);
    player.playSingle(song);
  } catch (_) {
    uni.showToast({ title: "该歌曲暂时无法播放", icon: "none" });
  }
}

function playAll(): void {
  if (songs.value.length > 0) {
    // 播放全部：替换整个队列为当前列表
    player.play(songs.value[0], songs.value);
  }
}

onMounted(() => {
  sourceStore.restore();
  ensureLoad();
  uni.$on(SOURCE_PACKS_CHANGED_EVENT, onPacksChanged);
});
onShow(() => {
  sourceStore.restore();
  ensureLoad();
});
onUnmounted(() => {
  uni.$off(SOURCE_PACKS_CHANGED_EVENT, onPacksChanged);
  // 只退订：任务留在缓存里继续跑完，下次进同一个歌手页直接拿到全量
  detach();
});

/**
 * 头像缓存（进程内）：头像只跟第 1 页回来，命中缓存后不会再取第 1 页。
 * 平行数组 + indexOf（UTS 容器键序在两端实现有差异，与 services/source-switch.ts 同招）。
 */
const AVATAR_CACHE_CAP = 64;
const avatarKeys: string[] = [];
const avatarValues: string[] = [];

function readAvatar(key: string): string {
  const at = avatarKeys.indexOf(key);
  return at >= 0 ? (avatarValues[at] as string) : "";
}

function rememberAvatar(key: string, url: string): void {
  const at = avatarKeys.indexOf(key);
  if (at >= 0) {
    avatarKeys.splice(at, 1);
    avatarValues.splice(at, 1);
  }
  avatarKeys.push(key);
  avatarValues.push(url);
  while (avatarKeys.length > AVATAR_CACHE_CAP) {
    avatarKeys.splice(0, 1);
    avatarValues.splice(0, 1);
  }
}
</script>

<style>
.page {
  flex: 1;
}
/* 不能加 box-shadow：uni-app x Android 上 shadow 落在可点击元素或其祖先上会导致点击穿透/命中丢失
   （qt-ui/docs/ui-review.md P0-1，settings 页实证）。.hero 里的音源切换器、.list-head 里的播放全部按钮正是受害者。
   已有 1px border 表达边缘，去掉 shadow 不会掉层级。 */
.hero {
  padding: 44rpx 36rpx;
  flex-direction: row;
  align-items: center;
  background-color: rgba(255,255,255,0.62);
  border-width: 1px;
  border-color: rgba(255,255,255,0.6);
  border-radius: 0 0 24rpx 24rpx;
}
.avatar {
  width: 130rpx;
  height: 130rpx;
  justify-content: center;
  align-items: center;
  border-radius: 44rpx;
  overflow: hidden;
}
.avatar-img {
  width: 130rpx;
  height: 130rpx;
}
.hero-info {
  flex: 1;
  margin-left: 28rpx;
}
.name {
  color: #191d26;
  font-size: 36rpx;
  font-weight: 700;
  text-overflow: ellipsis;
}
.sub {
  margin-top: 12rpx;
  color: #6b7385;
  font-size: 24rpx;
}
.scroll {
  flex: 1;
}
.list-head {
  height: 96rpx;
  padding: 0 32rpx;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  background-color: rgba(255,255,255,0.62);
  border-width: 1px;
  border-color: rgba(255,255,255,0.6);
  border-radius: 24rpx;
  color: #6b7385;
  font-size: 25rpx;
}
.list-title {
  color: #6b7385;
  font-size: 25rpx;
}
.play-all {
  height: 60rpx;
  padding: 0 24rpx;
  border-radius: 30rpx;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
.play-all-text {
  margin-left: 10rpx;
  font-size: 25rpx;
  font-weight: 500;
}
.empty-item {
  padding: 140rpx 0;
  justify-content: center;
  align-items: center;
}
.empty-text {
  color: #6b7385;
  font-size: 27rpx;
}
.empty-retry {
  margin-top: 24rpx;
  padding: 12rpx 32rpx;
  color: #2563eb;
  font-size: 26rpx;
}
.row-item {
  height: 128rpx;
  justify-content: center;
}
.foot-item {
  height: 88rpx;
  justify-content: center;
  align-items: center;
}
/* 进度行：转圈 + 文案同行（文案不能省，用户要看「条数还在涨」） */
.foot-item-progress {
  height: 108rpx;
  flex-direction: row;
}
.foot-text {
  color: #6b7385;
  font-size: 24rpx;
}

.hero-dark {
  background-color: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.12);
}
.list-head-dark {
  background-color: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.12);
}
/* 其余深色文字/卡片变体：与 playlist 页取值保持一致 */
.whero-dark { background-color: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.14); }
.wname-dark { color: #f2f4f7; }
.wsub-dark { color: #a6adbc; }
.name-dark { color: #f2f4f7; }
.sub-dark { color: #a6adbc; }
.list-title-dark { color: #a6adbc; }
.empty-text-dark { color: #a6adbc; }
.foot-text-dark { color: #a6adbc; }

/* 宽屏：px 覆盖 rpx，避免宽屏下按窗口比例放大 */
.list-head-wide { height: 56px; padding-left: 24px; padding-right: 24px; border-radius: 14px; }
.list-title-wide { font-size: 16px; }
.play-all-wide { height: 36px; padding-left: 16px; padding-right: 16px; border-radius: 18px; }
.play-all-text-wide { margin-left: 6px; font-size: 14px; }
.row-item-wide { height: 82px; padding-left: 20px; padding-right: 20px; }
.empty-item-wide { padding-top: 80px; padding-bottom: 80px; }
.empty-text-wide { font-size: 16px; }
.empty-retry-wide { margin-top: 14px; padding-top: 8px; padding-bottom: 8px; padding-left: 20px; padding-right: 20px; font-size: 14px; }
.foot-item-wide { height: 52px; }
.foot-item-progress-wide { height: 64px; flex-direction: row; }
.foot-text-wide { font-size: 14px; }

/* 宽屏左右布局：左栏歌手信息 + 右栏歌曲列表（竖屏保持上下） */
.page-wide { flex-direction: row; align-items: stretch; padding: 16px 20px 0; }
.wide-left { width: 272px; flex-shrink: 0; margin-right: 16px; padding-bottom: 16px; }
.scroll-wide { flex: 1; min-width: 0; }
.whero { padding: 14px; background-color: rgba(255,255,255,0.62); border-width: 1px; border-color: rgba(255,255,255,0.6); border-radius: 14px; }
.wcover { width: 238px; height: 238px; border-radius: 12px; overflow: hidden; align-items: center; justify-content: center; }
.wcover-img { width: 238px; height: 238px; }
.wname { margin-top: 14px; color: #191d26; font-size: 20px; font-weight: 700; }
.wsub { margin-top: 6px; color: #6b7385; font-size: 14px; }
</style>
