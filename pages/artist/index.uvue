.search-ph { color: #9aa1b1; font-size: 26rpx; }
.search-clear { width: 44rpx; height: 44rpx; align-items: center; justify-content: center; flex-shrink: 0; }
.empty-item { padding: 140rpx 0; justify-content: center; align-items: center; }
.empty-text { font-size:27rpx; }
.empty-retry { margin-top:24rpx; padding:12rpx 32rpx; font-size:26rpx; }
.foot-item { height:88rpx; justify-content:center; align-items:center; }
/* 进度行：转圈 + 文案同行（文案不能省，用户要看「条数还在涨」） */
.foot-item-progress { height:108rpx; flex-direction:row; }
.foot-text { font-size:24rpx; }

.song-item-wide { height: 82px; }
.search-row-wide { padding-top: 10px; padding-left: 24px; padding-right: 24px; }
