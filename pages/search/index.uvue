}
/* 首屏骨架条目：5 行 × 128rpx/82px（与 .row / .row-wide 同高），
   高度写死避免 list-view 虚拟滚动按可变高度预估导致抖动 */
.sk-item {
  height: 640rpx;
}
.sk-item-wide {
  height: 410px;
}
/* 「综合」Tab 是 scroll-view，骨架直接铺在分区位置 */
.all-sk {
