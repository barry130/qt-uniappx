/* 桌面指针反馈 */
.tag-hover {
  background-color: rgba(127, 127, 127, 0.16);
}
.tag-wide { margin-right: 12px; margin-bottom: 12px; padding: 8px 16px; border-radius: 20px; font-size: 15px; }
.row-wide { height: 82px; padding-left: 24px; padding-right: 24px; }
.row-item-wide { height: 82px; }
