<template>
  <qt-page-frame width-kind="flow">
  <view class="page">
    <scroll-view class="list" :class="layout.isWide ? 'list-wide' : ''" direction="vertical" :show-scrollbar="false">
      <view class="group" :class="layout.isWide ? 'group-wide' : ''" :style="groupStyle">
        <view class="cell gapless-cell cell-no-border" :class="layout.isWide ? 'cell-wide gapless-cell-wide' : ''" :style="cellStyle" @click="showMiniPlayerMode">
          <QtIcon class="cell-icon" :class="layout.isWide ? 'cell-icon-wide' : ''" name="music" :size="layout.isWide ? 22 : 36" :color="theme.skin.icon" />
          <view class="cell-main">
            <view class="car-lyric-heading">
              <text class="cell-label cell-title" :class="layout.isWide ? 'cell-title-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">迷你播放器</text>
              <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
                <text class="cell-value" :class="layout.isWide ? 'cell-value-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ miniModeOption.name }}</text>
                <QtIcon name="chevron-right" :size="layout.isWide ? 18 : 28" :color="theme.skin.iconMuted" />
              </view>
            </view>
            <text class="cell-desc" :class="layout.isWide ? 'cell-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 13)">{{ miniModeOption.description }}，竖屏和宽屏共用。</text>
          </view>
        </view>
      </view>
      <!-- 内容列足够宽时分为播放行为 / 音质与输出；设置工作区内仍按有效宽度退回单列。 -->
      <view v-if="twoColumn" class="cols" :style="colsStyle">
        <view class="col" :style="colStyle">
          <view class="group group-wide group-col" :style="groupStyle">
            <view class="cell cell-wide" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="showRate">
              <QtIcon class="cell-icon cell-icon-wide" name="trending" :size="layout.isWide ? 22 : 36" color="#d99b3f" />
              <text class="cell-label cell-title cell-title-wide" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">默认倍速</text>
              <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
                <text class="cell-value cell-value-wide" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ rateText() }}</text>
                <QtIcon name="chevron-right" :size="layout.isWide ? 18 : 28" :color="theme.skin.iconMuted" />
              </view>
            </view>
            <view class="cell cell-wide" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="showSleep">
              <QtIcon class="cell-icon cell-icon-wide" name="clock" :size="layout.isWide ? 22 : 36" color="#9b82d9" />
              <text class="cell-label cell-title cell-title-wide" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">定时关闭</text>
              <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
                <text class="cell-value cell-value-wide" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ sleepText() }}</text>
                <QtIcon name="chevron-right" :size="layout.isWide ? 18 : 28" :color="theme.skin.iconMuted" />
              </view>
            </view>
            <view class="cell cell-wide" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="goEq">
              <QtIcon class="cell-icon cell-icon-wide" name="chart" :size="layout.isWide ? 22 : 36" color="#5b8fd9" />
              <text class="cell-label cell-title cell-title-wide" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">均衡器</text>
              <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
                <text class="cell-value cell-value-wide" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">五段音效调节</text>
                <QtIcon name="chevron-right" :size="layout.isWide ? 18 : 28" :color="theme.skin.iconMuted" />
              </view>
            </view>
            <view class="cell cell-wide" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="showConcurrent">
              <QtIcon class="cell-icon cell-icon-wide" name="sliders" :size="layout.isWide ? 22 : 36" color="#4fb186" />
              <text class="cell-label cell-title cell-title-wide" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">同时播放</text>
              <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
                <text class="cell-value cell-value-wide" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ concurrentText() }}</text>
                <QtIcon name="chevron-right" :size="layout.isWide ? 18 : 28" :color="theme.skin.iconMuted" />
              </view>
            </view>
            <!-- 无缝播放：共享开关，说明随内容撑高。 -->
            <view class="cell cell-no-border cell-wide gapless-cell gapless-cell-wide" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="toggleGapless">
              <QtIcon class="cell-icon cell-icon-wide" name="gauge" :size="layout.isWide ? 22 : 36" color="#d97f9b" />
              <view class="cell-main">
                <text class="cell-title cell-title-wide" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">无缝播放</text>
                <text class="cell-desc cell-desc-wide" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 13)">提前准备下一首，在线音频仅在 Wi-Fi 下预取。</text>
              </view>
              <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
                <qt-switch :model-value="gapless" @change="toggleGapless" />
              </view>
            </view>
          </view>
        </view>
        <view class="col col-right" :style="colStyle">
          <!-- 音质与输出：三项都是「同码率下的听感」开关，与音源档位无关（默认全关） -->
          <view class="group group-wide group-col" :style="groupStyle">
            <view class="cell cell-wide gapless-cell gapless-cell-wide" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="toggleFloatOutput">
              <QtIcon class="cell-icon cell-icon-wide" name="headset" :size="layout.isWide ? 22 : 36" color="#8b7bd9" />
              <view class="cell-main">
                <text class="cell-title cell-title-wide" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">32bit 浮点输出</text>
                <text class="cell-desc cell-desc-wide" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 13)">以 32bit 浮点混音输出，省掉 16bit 量化；出现爆音/无声请关回。</text>
              </view>
              <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
                <qt-switch :disabled="!effectsSupported" :model-value="floatOutput" @change="toggleFloatOutput" />
              </view>
            </view>
            <view class="cell cell-wide gapless-cell gapless-cell-wide" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="togglePreferSw">
              <QtIcon class="cell-icon cell-icon-wide" name="settings" :size="layout.isWide ? 22 : 36" color="#6f9bd9" />
              <view class="cell-main">
                <text class="cell-title cell-title-wide" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">软解优先</text>
                <text class="cell-desc cell-desc-wide" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 13)">改用软件解码器，换兼容性与稳定性；默认硬件解码更省电。</text>
              </view>
              <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
                <qt-switch :disabled="!effectsSupported" :model-value="preferSw" @change="togglePreferSw" />
              </view>
            </view>
            <view class="cell cell-no-border cell-wide gapless-cell gapless-cell-wide" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="toggleEnhance">
              <QtIcon class="cell-icon cell-icon-wide" name="volume" :size="layout.isWide ? 22 : 36" color="#d98b5b" />
              <view class="cell-main">
                <text class="cell-title cell-title-wide" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">音量增强</text>
                <text class="cell-desc cell-desc-wide" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 13)">整体响度 +3dB；母带本就很响的曲子可能削波，默认关闭。</text>
              </view>
              <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
                <qt-switch :disabled="!effectsSupported" :model-value="enhanceOn" @change="toggleEnhance" />
              </view>
            </view>
          </view>
          <view class="group group-wide group-col" :style="groupStyle">
            <view class="cell cell-wide" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="showCacheLimit">
              <QtIcon class="cell-icon cell-icon-wide" name="download" :size="layout.isWide ? 22 : 36" color="#6d8fd6" />
              <text class="cell-label cell-title cell-title-wide" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">音乐缓存上限</text>
              <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
                <text class="cell-value cell-value-wide" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ cacheLimitText() }}</text>
                <QtIcon name="chevron-right" :size="layout.isWide ? 18 : 28" :color="theme.skin.iconMuted" />
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 竖屏 / 较窄内容列：单列 -->
      <view v-else>
      <view class="group" :class="layout.isWide ? 'group-wide' : ''" :style="groupStyle">
        <view class="cell" :class="layout.isWide ? 'cell-wide' : ''" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="showRate">
          <QtIcon class="cell-icon" :class="[layout.isWide ? 'cell-icon-wide' : '']" name="trending" :size="layout.isWide ? 22 : 36" color="#d99b3f" />
          <text class="cell-label cell-title" :class="layout.isWide ? 'cell-title-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">默认倍速</text>
          <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
            <text class="cell-value" :class="layout.isWide ? 'cell-value-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ rateText() }}</text>
            <QtIcon name="chevron-right" :size="layout.isWide ? 18 : 28" :color="theme.skin.iconMuted" />
          </view>
        </view>
        <view class="cell" :class="layout.isWide ? 'cell-wide' : ''" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="showSleep">
          <QtIcon class="cell-icon" :class="[layout.isWide ? 'cell-icon-wide' : '']" name="clock" :size="layout.isWide ? 22 : 36" color="#9b82d9" />
          <text class="cell-label cell-title" :class="layout.isWide ? 'cell-title-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">定时关闭</text>
          <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
            <text class="cell-value" :class="layout.isWide ? 'cell-value-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ sleepText() }}</text>
            <QtIcon name="chevron-right" :size="layout.isWide ? 18 : 28" :color="theme.skin.iconMuted" />
          </view>
        </view>
        <view class="cell" :class="layout.isWide ? 'cell-wide' : ''" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="goEq">
          <QtIcon class="cell-icon" :class="[layout.isWide ? 'cell-icon-wide' : '']" name="chart" :size="layout.isWide ? 22 : 36" color="#5b8fd9" />
          <text class="cell-label cell-title" :class="layout.isWide ? 'cell-title-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">均衡器</text>
          <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
            <text class="cell-value" :class="layout.isWide ? 'cell-value-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">五段音效调节</text>
            <QtIcon name="chevron-right" :size="layout.isWide ? 18 : 28" :color="theme.skin.iconMuted" />
          </view>
        </view>
        <view class="cell" :class="layout.isWide ? 'cell-wide' : ''" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="showConcurrent">
          <QtIcon class="cell-icon" :class="[layout.isWide ? 'cell-icon-wide' : '']" name="sliders" :size="layout.isWide ? 22 : 36" color="#4fb186" />
          <text class="cell-label cell-title" :class="layout.isWide ? 'cell-title-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">同时播放</text>
          <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
            <text class="cell-value" :class="layout.isWide ? 'cell-value-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ concurrentText() }}</text>
            <QtIcon name="chevron-right" :size="layout.isWide ? 18 : 28" :color="theme.skin.iconMuted" />
          </view>
        </view>
        <!-- 无缝播放：共享开关，说明随内容撑高。 -->
        <view class="cell cell-no-border gapless-cell" :class="layout.isWide ? 'cell-wide gapless-cell-wide' : ''" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="toggleGapless">
          <QtIcon class="cell-icon" :class="[layout.isWide ? 'cell-icon-wide' : '']" name="gauge" :size="layout.isWide ? 22 : 36" color="#d97f9b" />
          <view class="cell-main">
            <text class="cell-title" :class="layout.isWide ? 'cell-title-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">无缝播放</text>
            <text class="cell-desc" :class="layout.isWide ? 'cell-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 13)">提前准备下一首，在线音频仅在 Wi-Fi 下预取。</text>
          </view>
          <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
            <qt-switch :model-value="gapless" @change="toggleGapless" />
          </view>
        </view>
      </view>

      <!-- 音质与输出：同为「同码率下的听感」开关，单列时紧跟播放行为组（默认全关） -->
      <view class="group" :class="layout.isWide ? 'group-wide' : ''" :style="groupStyle">
        <view class="cell gapless-cell" :class="layout.isWide ? 'cell-wide gapless-cell-wide' : ''" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="toggleFloatOutput">
          <QtIcon class="cell-icon" :class="[layout.isWide ? 'cell-icon-wide' : '']" name="headset" :size="layout.isWide ? 22 : 36" color="#8b7bd9" />
          <view class="cell-main">
            <text class="cell-title" :class="layout.isWide ? 'cell-title-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">32bit 浮点输出</text>
            <text class="cell-desc" :class="layout.isWide ? 'cell-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 13)">以 32bit 浮点混音输出，省掉 16bit 量化；出现爆音/无声请关回。</text>
          </view>
          <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
            <qt-switch :disabled="!effectsSupported" :model-value="floatOutput" @change="toggleFloatOutput" />
          </view>
        </view>
        <view class="cell gapless-cell" :class="layout.isWide ? 'cell-wide gapless-cell-wide' : ''" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="togglePreferSw">
          <QtIcon class="cell-icon" :class="[layout.isWide ? 'cell-icon-wide' : '']" name="settings" :size="layout.isWide ? 22 : 36" color="#6f9bd9" />
          <view class="cell-main">
            <text class="cell-title" :class="layout.isWide ? 'cell-title-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">软解优先</text>
            <text class="cell-desc" :class="layout.isWide ? 'cell-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 13)">改用软件解码器，换兼容性与稳定性；默认硬件解码更省电。</text>
          </view>
          <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
            <qt-switch :disabled="!effectsSupported" :model-value="preferSw" @change="togglePreferSw" />
          </view>
        </view>
        <view class="cell cell-no-border gapless-cell" :class="layout.isWide ? 'cell-wide gapless-cell-wide' : ''" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="toggleEnhance">
          <QtIcon class="cell-icon" :class="[layout.isWide ? 'cell-icon-wide' : '']" name="volume" :size="layout.isWide ? 22 : 36" color="#d98b5b" />
          <view class="cell-main">
            <text class="cell-title" :class="layout.isWide ? 'cell-title-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">音量增强</text>
            <text class="cell-desc" :class="layout.isWide ? 'cell-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 13)">整体响度 +3dB；母带本就很响的曲子可能削波，默认关闭。</text>
          </view>
          <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
            <qt-switch :disabled="!effectsSupported" :model-value="enhanceOn" @change="toggleEnhance" />
          </view>
        </view>
      </view>

      <view class="group" :class="layout.isWide ? 'group-wide' : ''" :style="groupStyle">
        <view class="cell" :class="layout.isWide ? 'cell-wide' : ''" :style="cellStyle" :hover-class="layout.isWide ? 'cell-hover' : 'none'" @click="showCacheLimit">
          <QtIcon class="cell-icon" :class="[layout.isWide ? 'cell-icon-wide' : '']" name="download" :size="layout.isWide ? 22 : 36" color="#6d8fd6" />
          <text class="cell-label cell-title" :class="layout.isWide ? 'cell-title-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">音乐缓存上限</text>
          <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
            <text class="cell-value" :class="layout.isWide ? 'cell-value-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ cacheLimitText() }}</text>
            <QtIcon name="chevron-right" :size="layout.isWide ? 18 : 28" :color="theme.skin.iconMuted" />
          </view>
        </view>
      </view>

      </view>

      <view class="group" :class="layout.isWide ? 'group-wide' : ''" :style="groupStyle">
        <view class="cell gapless-cell cell-no-border" :class="layout.isWide ? 'cell-wide gapless-cell-wide' : ''" :style="cellStyle" @click="showCarLyric">
          <QtIcon class="cell-icon" :class="layout.isWide ? 'cell-icon-wide' : ''" name="headset" :size="layout.isWide ? 22 : 36" :color="theme.skin.icon" />
          <view class="cell-main">
            <view class="car-lyric-heading">
              <text class="cell-label cell-title" :class="layout.isWide ? 'cell-title-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">蓝牙车载歌词</text>
              <view class="cell-right" :class="layout.isWide ? 'cell-right-wide' : ''">
                <text class="cell-value" :class="layout.isWide ? 'cell-value-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ carLyricLabel() }}</text>
                <QtIcon v-if="carLyricSupported" name="chevron-right" :size="layout.isWide ? 18 : 28" :color="theme.skin.iconMuted" />
              </view>
            </view>
            <text class="cell-desc car-lyric-copy" :class="layout.isWide ? 'cell-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 13)">{{ carLyricSupported ? "默认已打开，显示效果取决于车机兼容性；不显示时可尝试歌手栏或标题栏模式。" : "当前平台暂不支持蓝牙歌词兼容模式。" }}</text>
          </view>
        </view>
      </view>
      <view v-if="carLyricSupported" class="hint">
        <text class="hint-text car-lyric-copy" :class="layout.isWide ? 'hint-text-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 12)">歌手栏或标题栏模式在检测到蓝牙音频设备时生效，不能区分车机和蓝牙耳机；系统通知和锁屏的对应文字也可能变化。选回“打开”、断开蓝牙或无时间轴歌词时恢复歌曲信息。部分车机仍可能无法显示歌词。</text>
      </view>

      <!-- 说明文字：单列在两列分支之外、仍在最下方通栏，两列时不拆断 -->
      <view class="hint">
        <text class="hint-text" :class="layout.isWide ? 'hint-text-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 12)">默认倍速保存后立即对当前播放生效，之后每次播放也按这个速度；定时关闭到达时间后会停止播放（也可以选「播放完当前歌曲后」）。</text>
      </view>
      <view class="hint">
        <text class="hint-text" :class="layout.isWide ? 'hint-text-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 12)">音乐缓存上限是播放过的歌曲在本地保留的音频总量，超出后按最早播放的依次清理。改小上限会在下次播放时重建缓存。</text>
      </view>
      <view class="hint">
        <text class="hint-text" :class="layout.isWide ? 'hint-text-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 12)">{{ effectsSupported ? "浮点输出、软解优先、音量增强的改动在下一首或停止后重播生效，不会打断当前曲目。" : "当前平台暂不支持浮点输出、解码器选择和音量增强。" }}</text>
      </view>
    </scroll-view>

    <!-- 自定义缓存上限：页内输入弹层（uni.showModal 的 editable 输入框在 App 端不渲染） -->
    <qt-sheet :visible="cacheSheetVisible" title="自定义缓存上限" @close="closeCacheSheet">
      <view>
        <text class="cache-desc" :class="layout.isWide ? 'cache-desc-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">输入缓存大小（MB，≥ {{ cacheLimitMinMb }}，不设上限）</text>
        <input
          class="cache-input"
          :class="layout.isWide ? 'cache-input-wide' : ''"
          :style="layout.isWide ? cacheInputStyleWide : cacheInputStyle"
          type="number"
          :value="cacheSheetValue"
          @input="onCacheSheetInput"
          placeholder="1024"
          :placeholder-class="layout.isWide ? 'cache-ph-wide' : 'cache-ph'"
          :maxlength="6"
          :focus="cacheSheetVisible"
        />
        <text v-if="cacheSheetError.length > 0" class="cache-error" :class="layout.isWide ? 'cache-error-wide' : ''" :style="('color:' + theme.skin.danger + ';') + qtFontDual(22, 12)">{{ cacheSheetError }}</text>
        <view class="cache-btn-row" :class="layout.isWide ? 'cache-btn-row-wide' : ''">
          <qt-button class="cache-btn" label="取消" variant="ghost" size="sm" @click="closeCacheSheet" />
          <qt-button class="cache-btn" label="确定" variant="secondary" size="sm" @click="submitCacheSheet" />
        </view>
      </view>
    </qt-sheet>

    <qt-action-sheet
      v-model:visible="sheetVisible"
      :title="sheetTitle"
      :actions="sheetActions"
      :selected-index="sheetSelectedIndex"
      @select="onSheetSelect"
    />
  </view>
  </qt-page-frame>
</template>
<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import { qtShowActionSheet } from "@/services/action-sheet";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import { useQtTwoColumn } from "@/uni_modules/qt-ui/composables/use-qt-columns";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { computed, ref } from "vue";
import { onShow } from "@dcloudio/uni-app";
import type { SheetAction } from "@/uni_modules/qt-ui/components/qt-action-sheet/qt-action-sheet.uvue";
import QtActionSheet from "@/uni_modules/qt-ui/components/qt-action-sheet/qt-action-sheet.uvue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtButton from "@/uni_modules/qt-ui/components/qt-button/qt-button.uvue";
import QtSwitch from "@/uni_modules/qt-ui/components/qt-switch/qt-switch.uvue";
import QtSheet from "@/uni_modules/qt-ui/components/qt-sheet/qt-sheet.uvue";
import { QT_PLAYBACK_RATES, QT_SLEEP_OPTIONS, qtSleepSelectedIndex } from "@/services/player-setting-options";
import { audioPlayer, audioCapabilities } from "@/services/audio-player";
import { usePlayerStore } from "@/stores/player";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";
import { QT_MINI_PLAYER_MODES, useMiniPlayerSettings, setMiniPlayerMode } from "@/uni_modules/qt-ui/stores/mini-player";

/**
 * 播放设置页：原来这些项都散在设置主页里（两组共六行），设置页越来越长，
 * 按用户要求整体拆成独立页；设置主页只留一行入口。
 * 这里是唯一的数据源，设置主页不再保留任何副本。
 */
const player = usePlayerStore();
/** 两列布局按共享内容列宽判定，三栏设置工作区可自动回退单列。 */
const { layout, twoColumn, colStyle, colsStyle } = useQtTwoColumn();
const theme = useThemeStore();
const miniSettings = useMiniPlayerSettings();
const miniModeIndex = computed((): number => QT_MINI_PLAYER_MODES.findIndex((option) => option.id == miniSettings.mode));
const miniModeOption = computed(() => QT_MINI_PLAYER_MODES[miniModeIndex.value]);
async function showMiniPlayerMode(): Promise<void> {
  // Use the frame-level host so the sheet covers the floating player. The row
  // already explains the behavior; short labels keep all four options visible.
  const index = await qtShowActionSheet({
    title: "迷你播放器",
    itemList: QT_MINI_PLAYER_MODES.map((option) => option.name),
    selectedIndex: miniModeIndex.value,
  });
  const option = QT_MINI_PLAYER_MODES[index];
  if (option != null) setMiniPlayerMode(option.id);
}
const carLyricSupported = audioPlayer.carLyricSupported();
const carLyricMode = ref(audioPlayer.getCarLyricMode());
function carLyricLabel(): string {
  if (!carLyricSupported) return "暂不支持";
  if (carLyricMode.value == 1) return "歌手栏";
  if (carLyricMode.value == 2) return "标题栏";
  return "打开";
}
function showCarLyric(): void {
  if (!carLyricSupported) return;
  openSheet("蓝牙车载歌词", [{ name: "打开" }, { name: "显示在歌手栏（保留歌名）" }, { name: "显示在标题栏（兼容部分车机）" }], (index: number) => {
    if (index < 0 || index > 2) return;
    audioPlayer.setCarLyricMode(index);
    carLyricMode.value = index;
    if (index != 0) player.refreshCarLyric();
    qtShowToast({ title: index == 0 ? "蓝牙歌词已设为默认模式" : "蓝牙歌词已设为" + carLyricLabel(), icon: "none" });
  }, carLyricMode.value);
}
const groupStyle = computed<string>(() => "background-color:" + theme.skin.surface + ";border-color:" + theme.skin.border + ";");
const cellStyle = computed<string>(() => "border-bottom-color:" + theme.skin.divider + ";");

const sheetVisible = ref(false);
const sheetTitle = ref("");
const sheetActions = ref<SheetAction[]>([]);
const sheetSelectedIndex = ref(-1);
let sheetSelect: ((index: number) => void) | null = null;

function openSheet(title: string, actions: SheetAction[], select: (index: number) => void, selectedIndex: number = -1): void {
  sheetTitle.value = title;
  sheetActions.value = actions;
  sheetSelectedIndex.value = selectedIndex;
  sheetSelect = select;
  sheetVisible.value = true;
}
function onSheetSelect(_action: SheetAction, index: number): void {
  const cb = sheetSelect;
  sheetSelect = null;
  if (cb) cb(index);
}

// ==================== 默认倍速 ====================

const rates = QT_PLAYBACK_RATES;
const currentRate = ref(audioPlayer.rate);

function rateText(): string {
  return currentRate.value + "x";
}
function showRate(): void {
  currentRate.value = audioPlayer.rate;
  openSheet("默认倍速", rates.map((rate) => ({ name: rate + "x" })), (index) => {
    pickRate(rates[index]);
  }, rates.indexOf(currentRate.value));
}
function pickRate(rate: number): void {
  currentRate.value = rate;
  audioPlayer.changeRate(rate);
  qtShowToast({ title: "默认倍速 " + rate + "x", icon: "none" });
}

// ==================== 定时关闭 ====================

function sleepText(): string {
  if (player.sleepStopAfterCurrent) return "播放完当前歌曲后";
  if (player.sleepEndTime > 0 && player.sleepRequestedMinutes > 0) return player.sleepRequestedMinutes + " 分钟后";
  return "关闭";
}
const sleepOptions = QT_SLEEP_OPTIONS;
function showSleep(): void {
  openSheet("定时关闭", sleepOptions.map((opt) => ({ name: opt.name })), (index) => {
    pickSleep(sleepOptions[index].minutes);
  }, qtSleepSelectedIndex(player.sleepStopAfterCurrent, player.sleepEndTime, player.sleepRequestedMinutes));
}
function pickSleep(minutes: number): void {
  // 90 是播放完当前歌曲哨兵，沿用 store 契约，不当作分钟数。
  player.setSleep(minutes);
}

// ==================== 均衡器 ====================

/** 打开均衡器设置页（五段音效调节独立成页，这里只做入口） */
function goEq(): void {
  uni.navigateTo({ url: "/pages/equalizer/index" });
}

// ==================== 同时播放 ====================

// 与其他应用的音频共存方式（0 不允许 / 1 部分场景 / 2 全部场景）
const concurrentMode = ref(audioPlayer.getConcurrentMode());
const concurrentOptions: { value: number; name: string; hint: string }[] = [
  { value: 0, name: "不允许", hint: "独占音频，其他应用播放时暂停" },
  { value: 1, name: "部分场景", hint: "对方可共存时压低音量继续播放" },
  { value: 2, name: "全部场景", hint: "与其他应用完全同时播放" },
];
function concurrentText(): string {
  for (let i = 0; i < concurrentOptions.length; i++) {
    if (concurrentOptions[i].value == concurrentMode.value) return concurrentOptions[i].name;
  }
  return "不允许";
}
function showConcurrent(): void {
  concurrentMode.value = audioPlayer.getConcurrentMode();
  openSheet("同时播放（与其他应用的音频共存方式）", concurrentOptions.map((opt) => ({
    name: opt.name + "（" + opt.hint + "）",
  })), (index) => {
    const opt = concurrentOptions[index];
    if (opt == null) return;
    audioPlayer.setConcurrentMode(opt.value);
    concurrentMode.value = opt.value;
    qtShowToast({ title: "同时播放：" + opt.name, icon: "none" });
  }, concurrentOptions.map((opt) => opt.value).indexOf(concurrentMode.value));
}

// ==================== 无缝播放 ====================

// 提前把下一首准备好：取链预热 + 整首预取（默认开启）。语义见 services/audio-player.uts
// 的 GAPLESS_KEY 注释：Android 端 audioPreloadTrack 会把下一首整首读进磁盘缓存。
const gapless = ref(audioPlayer.getGapless());
function toggleGapless(): void {
  gapless.value = !gapless.value;
  audioPlayer.setGapless(gapless.value);
  qtShowToast({ title: "无缝播放已" + (gapless.value ? "开启" : "关闭"), icon: "none" });
}

// ==================== 音质与输出（浮点输出 / 软解优先 / 音量增强） ====================
// 三项都在原生**构建播放器时**生效（media3 的 RenderersFactory 只读一次）：
// 播放中点开关不打断当前曲，空闲/已播完时原生会立刻重建，下一次播放即用新参数。
// 默认全关 = 与改动前行为完全一致，避免默认给所有人套上音效链/软解耗电。
const effectsSupported = audioCapabilities().outputEffects;
const floatOutput = ref(effectsSupported && audioPlayer.floatOutput);
const preferSw = ref(effectsSupported && audioPlayer.preferSoftwareDecoder);
const enhanceOn = ref(effectsSupported && audioPlayer.enhanceEnabled);


function toggleFloatOutput(): void {
  if (!audioCapabilities().outputEffects) { qtShowToast({ title: "当前平台暂不支持浮点输出", icon: "none" }); return; }
  floatOutput.value = !floatOutput.value;
  audioPlayer.setFloatOutput(floatOutput.value);
  qtShowToast({ title: "32bit 浮点输出已" + (floatOutput.value ? "开启" : "关闭"), icon: "none" });
}
function togglePreferSw(): void {
  if (!audioCapabilities().outputEffects) { qtShowToast({ title: "当前平台暂不支持选择解码器", icon: "none" }); return; }
  preferSw.value = !preferSw.value;
  audioPlayer.setPreferSoftwareDecoder(preferSw.value);
  qtShowToast({ title: preferSw.value ? "已改为软解优先" : "已改为自动解码（硬件优先）", icon: "none" });
}
function toggleEnhance(): void {
  if (!audioCapabilities().outputEffects) { qtShowToast({ title: "当前平台暂不支持音量增强", icon: "none" }); return; }
  enhanceOn.value = !enhanceOn.value;
  // 增益固定 +3dB：再高会在母带接近满刻度的曲目上削波（原生侧 12dB 上限只是兜底）
  if (enhanceOn.value) audioPlayer.setEnhanceGain(3);
  audioPlayer.setEnhanceEnabled(enhanceOn.value);
  qtShowToast({ title: "音量增强已" + (enhanceOn.value ? "开启（+3dB）" : "关闭"), icon: "none" });
}

// ==================== 音乐缓存上限 ====================

const cacheLimitOptions: number[] = [1024, 2048, 4096];
// 手工输入档只校验下界（与原生层 CACHE_LIMIT_MIN_MB 一致，越界原生会静默夹回），
// 上界已取消：用户要多大给多大，原生按新上限在下次播放时重建缓存
const cacheLimitMinMb = 256;
// 模板需要响应式：audioPlayer 是非响应式单例，直接在模板里读不会触发重渲染
const cacheLimitMb = ref(audioPlayer.getCacheLimitMb());
function cacheLimitLabel(mb: number): string {
  if (mb % 1024 == 0) return (mb / 1024) + " GB";
  return mb + " MB";
}
function cacheLimitText(): string {
  return cacheLimitLabel(cacheLimitMb.value);
}
function showCacheLimit(): void {
  cacheLimitMb.value = audioPlayer.getCacheLimitMb();
  const inPresets = cacheLimitOptions.indexOf(cacheLimitMb.value) >= 0;
  // 档位 + 「自定义…」：当前值不在档位里时高亮自定义项提示已手工设置
  const actions: SheetAction[] = cacheLimitOptions.map((mb) => ({
    name: cacheLimitLabel(mb),
  }));
  actions.push({ name: "自定义…" });
  openSheet("音乐缓存上限", actions, (index) => {
    if (index >= cacheLimitOptions.length) {
      openCacheSheet();
      return;
    }
    const mb = cacheLimitOptions[index];
    audioPlayer.setCacheLimitMb(mb);
    cacheLimitMb.value = mb;
    qtShowToast({ title: "音乐缓存上限：" + cacheLimitLabel(mb), icon: "none" });
  }, inPresets ? cacheLimitOptions.indexOf(cacheLimitMb.value) : (cacheLimitMb.value >= cacheLimitMinMb ? cacheLimitOptions.length : -1));
}

// ==================== 自定义缓存上限弹层 ====================
// uni.showModal 的 editable 在 App 端不出输入框，照 source-pack 的做法用页内弹层

const cacheSheetVisible = ref(false);
const cacheSheetValue = ref("");
const cacheSheetError = ref("");
/** 输入框填充底色 + 文字色 */
const cacheInputStyle = computed<string>(() => "background-color:" + theme.skin.surfaceInset + ";color:" + theme.skin.text + ";border-radius:14rpx;");
const cacheInputStyleWide = computed<string>(() => "background-color:" + theme.skin.surfaceInset + ";color:" + theme.skin.text + ";border-radius:8px;");

function openCacheSheet(): void {
  cacheSheetValue.value = "";
  cacheSheetError.value = "";
  cacheSheetVisible.value = true;
}
function closeCacheSheet(): void {
  cacheSheetVisible.value = false;
}
function onCacheSheetInput(e: InputEvent): void {
  cacheSheetValue.value = e.detail.value;
  if (cacheSheetError.value.length > 0) cacheSheetError.value = "";
}
/** 提交：非法值红字提示留在弹层里；过了就落库下发，以服务层回读值为准显示 */
function submitCacheSheet(): void {
  const mb = parseInt(cacheSheetValue.value);
  if (!(mb >= cacheLimitMinMb)) {
    cacheSheetError.value = "请输入不小于 " + cacheLimitMinMb + " 的数值（MB）";
    return;
  }
  cacheSheetVisible.value = false;
  audioPlayer.setCacheLimitMb(mb);
  cacheLimitMb.value = audioPlayer.getCacheLimitMb();
  qtShowToast({ title: "音乐缓存上限：" + cacheLimitLabel(cacheLimitMb.value), icon: "none" });
}

onShow(() => {
  carLyricMode.value = audioPlayer.getCarLyricMode();
  // 原生层可能被别处改过（清除全部数据会把缓存上限/倍速复位），进页面统一对账
  currentRate.value = audioPlayer.rate;
  concurrentMode.value = audioPlayer.getConcurrentMode();
  cacheLimitMb.value = audioPlayer.getCacheLimitMb();
  gapless.value = audioPlayer.getGapless();
  // 音质与输出三项：别处（清空数据、恢复备份）可能复位，进页面统一对账
  floatOutput.value = audioPlayer.floatOutput;
  preferSw.value = audioPlayer.preferSoftwareDecoder;
  enhanceOn.value = audioPlayer.enhanceEnabled;
});

</script>

<style>
.page {
  flex: 1;
}
.list {
  flex: 1;
  padding: 16rpx 0 40rpx;
}
.list-wide {
  padding: 12px 0 24px;
}
.group {
  margin-top: 20rpx;
  margin-left: 24rpx;
  margin-right: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;

  border-width: 1px; border-style: solid;

}
.cell {
  min-height: 56rpx;
  padding: 20rpx 28rpx;
  flex-direction: row;
  align-items: center;
  border-bottom-width: 1px; border-bottom-style: solid;
}
/* 桌面指针反馈：只在宽屏启用（手机上 hover-class 会在点按瞬间闪一下） */
.cell-hover {
  background-color: rgba(255, 255, 255, 0.06);
}
.cell-no-border {
  border-bottom-width: 0;
}
.cell-icon {
  margin-right: 20rpx;
}
/* 带副标题的行（无缝播放）：高度交给内容，标题/说明纵向排 */
.cell-main {
  flex: 1;
  min-width: 0;
}
.cell-desc {
  margin-top: 6rpx;

  font-size: 22rpx;
  line-height: 1.5;
}
.cell-desc-wide {
  margin-top: 6px;
  font-size: 13px;
  line-height: 1.5;
}
.cell-label {
  flex: 1;
  min-width: 0;
}
.cell-title {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}
.cell-right {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}
.cell-right-wide {
  margin-left: 16px;
}
.cell-value {

  font-size: 24rpx;
  margin-right: 12rpx;
}
/* 宽屏下 rpx 会随窗口放大膨胀，固定 px 尺寸 */
.group-wide { margin-top: 14px; margin-left: 24px; margin-right: 24px; border-radius: 14px; }
.cell-wide { min-height: 32px; padding: 16px 20px; }
.cell-title-wide { font-size: 16px; }
.cell-value-wide { font-size: 14px; margin-right: 12px; }
.cell-icon-wide { margin-right: 14px; }
/* 所有行用 min-height；说明可以自然换行，不再依赖 height:auto 覆盖固定高度。 */
.gapless-cell {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}
.gapless-cell-wide {
  padding-top: 18px;
  padding-bottom: 18px;
}

.hint {
  margin-top: 18rpx;
  padding: 0 40rpx;
}
.hint-text {
  font-size: 22rpx;
  line-height: 32rpx;
}
.hint-text-wide {
  font-size: 12px;
  line-height: 18px;
}
.car-lyric-heading {
  flex-direction: row;
  align-items: center;
}
.car-lyric-copy {
  line-height: 1.5;
}
/* 两列：列内纵向堆叠、顶端对齐（默认 stretch 会把右列拉高露出分组底色） */
.cols {
  flex-direction: row;
  align-items: flex-start;
  justify-content: center;
}
.col {
  flex-direction: column;
}
.col-right {
  margin-left: 16px;
}
/* 两列里的分组不再带左右外边距：列宽已经把 24px 留白与 16px 间距算进去了 */
.group-col {
  margin-left: 0;
  margin-right: 0;
}

/* 自定义缓存输入由 QtSheet 负责壳与宽窄屏布局。 */
.cache-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
}
.cache-desc-wide {
  margin-top: 4px;
  font-size: 13px;
}
.cache-input {
  margin-top: 22rpx;
  height: 78rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}
.cache-input-wide {
  margin-top: 12px;
  height: 40px;
  padding: 0 12px;
  font-size: 14px;
}
.cache-ph {
  font-size: 24rpx;
  color: #9aa1b0;
}
.cache-ph-wide {
  font-size: 13px;
  color: #9aa1b0;
}
.cache-error {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
}
.cache-error-wide {
  margin-top: 6px;
  font-size: 12px;
}
.cache-btn-row {
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 26rpx;
}
.cache-btn-row-wide {
  margin-top: 16px;
}
.cache-btn {
  margin-left: 16rpx;
}
</style>
