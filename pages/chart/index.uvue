<template>
  <QtPageFrame title="排行榜" :header-title-visible="false" width-kind="detail" :header-actions="headerActions" @headerAction="onHeaderAction">
    <view class="source-bar">
      <scroll-view v-if="sources.length > 0" direction="horizontal" class="source-strip"
      :style="sourceStripStyle" :scroll-into-view="sourceReveal.anchor.value" :show-scrollbar="false"
      :scroll-with-animation="false" @scroll="onSourceScroll">
        <view class="source-options" :style="sourceOptionsStyle">
          <view v-for="(source, si) in sources" :id="sourceReveal.itemId(si)" class="source-option" :style="sourceOptionStyle(si)">
            <QtOption :label="sourceRegistry.label(source)" kind="chip" :single-line="true" :style="sourceChipStyle(si)" :selected="selectionIndex == si" @select="onChipTap(si)" />
          </view>
        </view>
      </scroll-view>
      <view v-if="layout.isWide" class="chart-refresh" :style="refreshStyle" @click="reloadChartsSafely">
        <QtIcon name="refresh" :size="22" :color="loading || sources.length == 0 ? theme.skin.textSubtle : theme.skin.icon" />
      </view>
    </view>
    <view class="chart-body">
      <!-- 单scroll-view与稳定前缀：追加后面的卡，不在深滚动处移除/换整组子树。 -->
      <scroll-view id="chart-scroll" class="chart-scroll" direction="vertical" :scroll-top="scrollTop"
        :scroll-with-animation="false" @scroll="onListScroll">
        <view v-if="skeletonOn" class="chart-grid" :style="gridStyle">
          <view class="chart-host">
            <view v-for="i in skeletonCount" class="rank-card" :class="layout.isWide ? 'rank-card-wide' : ''" :style="rankCardStyle(i - 1)">
              <view class="skeleton-heading" :class="layout.isWide ? 'skeleton-heading-wide' : ''" :style="skeletonHeadingStyle"></view>
              <view class="rank-body" :style="rankBodyStyle">
                <view class="rank-cover-placeholder" :class="layout.isWide ? 'rank-cover-placeholder-wide' : ''" :style="coverStyle"></view>
                <view class="preview-lines">
                  <view class="skeleton-line" :class="layout.isWide ? 'skeleton-line-wide' : ''" :style="skeletonLineStyle"></view>
                  <view class="skeleton-line" :class="layout.isWide ? 'skeleton-line-wide' : ''" :style="skeletonLineStyle"></view>
                  <view class="skeleton-line" :class="layout.isWide ? 'skeleton-line-wide' : ''" :style="skeletonLineStyle"></view>
                </view>
              </view>
            </view>
          </view>
        </view>
        <QtEmpty v-if="showNoSources" icon="settings" title="暂无可用音源"
          description="请先到设置安装支持排行榜的数据包。" action-text="去设置" @action="goToSettings" />
        <QtEmpty v-if="showListError" icon="info" title="排行榜加载失败"
          description="网络或音源暂不可用，可以重试或切换其他音源。" action-text="重新加载" @action="reloadChartsSafely" />
        <QtEmpty v-if="showEmptyList" icon="music" title="该音源暂无榜单"
          description="音源返回了空列表，可切换音源或稍后刷新。" action-text="刷新" @action="reloadChartsSafely" />
        <view v-if="filteredCharts.length > 0" class="chart-grid" :style="gridStyle">
          <view class="chart-host">
            <!-- 不加key；Vapor整组替换前必须回顶。前三行显式text，不嵌套v-for/v-else文本。 -->
            <view v-for="(chart, idx) in renderedCharts" class="rank-card" :class="layout.isWide ? 'rank-card-wide' : ''" :style="rankCardStyle(idx)">
              <view class="rank-heading" :style="rankHeadingStyle" @click="openChart(chart)">
                <text class="rank-name" :style="rankNameStyle">{{ chart.name }}</text>
                <text class="rank-meta" :style="smallMutedStyle">{{ chartLoader.meta(idx) }}</text>
                <QtIcon name="chevron-right" :size="layout.isWide ? 16 : 28" :color="theme.skin.textSubtle" />
              </view>
              <view class="rank-body" :style="rankBodyStyle">
                <view class="rank-cover-box" :style="coverBoxStyle" @click="openChart(chart)">
                  <image v-if="coverSources[idx] != null && coverSources[idx] != ''" class="rank-cover" :class="layout.isWide ? 'rank-cover-wide' : ''"
                    :style="coverStyle" :src="coverSources[idx]" mode="aspectFill" />
                  <view v-else class="rank-cover-placeholder" :class="layout.isWide ? 'rank-cover-placeholder-wide' : ''" :style="coverStyle">
                    <text class="cover-placeholder-text" :style="coverTextStyle">榜</text>
                  </view>
                </view>
                <view class="preview-lines">
                  <view class="preview-line" :style="previewLineStyle" @click.stop="onPreviewTap(idx, 0)">
                    <text class="preview-number" :style="previewNumberStyle">1</text>
                    <text class="preview-name" :style="previewNameStyle">{{ chartLoader.songLine(idx, 0) }}</text>
                  </view>
                  <view class="preview-line" :style="previewLineStyle" @click.stop="onPreviewTap(idx, 1)">
                    <text class="preview-number" :style="previewNumberStyle">2</text>
                    <text class="preview-name" :style="previewNameStyle">{{ chartLoader.songLine(idx, 1) }}</text>
                  </view>
                  <view class="preview-line" :style="previewLineStyle" @click.stop="onPreviewTap(idx, 2)">
                    <text class="preview-number" :style="previewNumberStyle">3</text>
                    <text class="preview-name" :style="previewNameStyle">{{ chartLoader.songLine(idx, 2) }}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
          <view class="chart-end">
            <text class="chart-end-text" :style="smallMutedStyle">滑动查看 · 仅加载附近榜单的封面与前三首</text>
          </view>
        </view>
      </scroll-view>
      <view v-if="showBackTop" class="back-top" :class="layout.isWide ? 'back-top-wide' : ''" :style="backTopStyle" @click="backToTop">
        <QtIcon name="arrow-up" :size="layout.isWide ? 20 : 36" :color="theme.skin.text" />
      </view>
    </view>
  </QtPageFrame>
</template>

<script setup lang="ts">
import { computed, ref, watch, nextTick, onMounted, onUnmounted } from "vue";
import { onLoad, onShow, onHide } from "@dcloudio/uni-app";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import QtOption from "@/uni_modules/qt-ui/components/qt-option/qt-option.uvue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtEmpty from "@/uni_modules/qt-ui/components/qt-empty/qt-empty.uvue";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { fontScale, qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";
import { useQtLayout, qtRpx } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtContentWidth, qtColumnCount } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { qtOptionChipMinHeightPx, qtOptionChipWidthPx } from "@/uni_modules/qt-ui/composables/qt-option-metrics";
import { useQtSelectionReveal } from "@/uni_modules/qt-ui/composables/use-qt-selection-reveal";
import { qtSelectionScrollOffset } from "@/uni_modules/qt-ui/composables/selection";
import { musicApi, type Chart } from "@/services/music-api";
import { createChartLoader, chartDemandWindow, readChartListSnapshot, chartListRequiresNetwork, rememberChartList, clearChartViewCache } from "@/services/chart-loader";
import { readChartScroll, saveChartScroll, flushChartScroll } from "@/services/chart-tabs";
import { useSourceStore } from "@/stores/source";
import { useSourceRegistryStore } from "@/stores/source-registry";
import { usePlayerStore } from "@/stores/player";
import { SOURCE_PACKS_CHANGED_EVENT } from "@/services/source-update";
import { logMsgErr } from "@/services/logger";
import { qtShowToast } from "@/services/toast";

const theme = useThemeStore();
const layout = useQtLayout();
const sourceStore = useSourceStore();
const sourceRegistry = useSourceRegistryStore();
const player = usePlayerStore();
const chartLoader = createChartLoader();
const coverSources = chartLoader.coverSources;
const allCharts = ref<Chart[]>([]);
const filteredCharts = computed((): Chart[] => allCharts.value);
const renderedCount = ref(0);
const renderedCharts = computed((): Chart[] => allCharts.value.slice(0, renderedCount.value));
const loading = ref(true);
const loadError = ref("");
const currentSourceLoaded = ref(false);
const sourceIndex = ref(-1);
const pendingSourceIndex = ref(-1);
const activeSource = ref("");
const scrollTop = ref(0);
const showBackTop = ref(false);
const pageVisible = ref(true);
let pageAlive = true;
let mounted = false;
let started = false;
let loadAllBusy = false;
let intent = 0;
let loadedIdentity = "";
let paramSi = -1;
let lastScrollTop = 0;
let suppressScroll = false;
let topTimer = 0;
let topResolve: ((ready: boolean) => void) | null = null;
let restoreTimer = 0;
let releaseTimer = 0;
let measureTimer = 0;
let measureSeq = 0;
const measuredWidth = ref(0);
const measuredHeight = ref(0);
let sourceScrollLeft = 0;

const sources = computed((): string[] => {
  const ids: string[] = [];
  const available = sourceRegistry.sources;
  for (let i = 0; i < available.length; i++) {
    if (available[i].id != "local" && available[i].charts !== false) ids.push(available[i].id);
  }
  return ids;
});
const selectionIndex = computed((): number => {
  const index = pendingSourceIndex.value >= 0 ? pendingSourceIndex.value : sources.value.indexOf(activeSource.value);
  return index >= 0 && index < sources.value.length ? index : -1;
});
function sourceSelectionKey(): string {
  const labels: string[] = [];
  for (let i = 0; i < sources.value.length; i++) {
    const id = sources.value[i];
    labels.push(JSON.stringify([id, sourceRegistry.label(id)]));
  }
  return JSON.stringify(labels);
}
const sourceReveal = useQtSelectionReveal((): boolean => pageVisible.value,
  (): number => selectionIndex.value, (): string => sourceSelectionKey(), sourceNeedsReveal);
const skeletonOn = computed((): boolean => loading.value && allCharts.value.length == 0);
const showNoSources = computed((): boolean => !loading.value && sources.value.length == 0);
const showListError = computed((): boolean => !loading.value && sources.value.length > 0 && loadError.value.length > 0 && allCharts.value.length == 0);
const showEmptyList = computed((): boolean => !loading.value && sources.value.length > 0 && currentSourceLoaded.value && loadError.value.length == 0 && allCharts.value.length == 0);
const headerActions = ["refresh"];
const padX = computed((): number => layout.isWide ? 16 : qtRpx(24));
const padY = computed((): number => layout.isWide ? 12 : qtRpx(20));
const gapPx = computed((): number => layout.isWide ? 12 : qtRpx(20));
const gridWidth = computed((): number => measuredWidth.value > 0 ? measuredWidth.value : qtContentWidth("detail"));
const innerWidth = computed((): number => Math.max(1, gridWidth.value - padX.value * 2));
const columns = computed((): number => layout.isWide ? qtColumnCount(innerWidth.value, 380, gapPx.value, 3) : 1);
const cardWidth = computed((): number => Math.floor((innerWidth.value - (columns.value - 1) * gapPx.value) / columns.value));
const headPx = computed((): number => Math.ceil((layout.isWide ? 17 : qtRpx(32)) * fontScale.scale * 1.4));
const linePx = computed((): number => Math.max(layout.isWide ? 28 : qtRpx(50), Math.ceil((layout.isWide ? 13 : qtRpx(26)) * fontScale.scale * 1.4 + 4)));
const coverPx = computed((): number => layout.isWide ? 84 : qtRpx(148));
const bodyPx = computed((): number => Math.max(coverPx.value, linePx.value * 3));
const bodyGap = computed((): number => layout.isWide ? 10 : qtRpx(20));
const cardPad = computed((): number => layout.isWide ? 12 : qtRpx(24));
const cardHeight = computed((): number => 2 + cardPad.value * 2 + headPx.value + bodyGap.value + bodyPx.value);
const cardStride = computed((): number => cardHeight.value + gapPx.value);
const viewportHeight = computed((): number => measuredHeight.value > 0 ? measuredHeight.value : Math.max(120, layout.windowHeight - (layout.isWide ? 156 : qtRpx(270))));
const skeletonCount = computed((): number => Math.min(8, chartDemandWindow(0, viewportHeight.value, cardStride.value, columns.value, 8).end));
const sourceStripWidth = computed((): number => Math.max(1, gridWidth.value - (layout.isWide ? 68 : 0)));
const sourceStripStyle = computed((): string => "width:" + sourceStripWidth.value + "px;height:" + (qtOptionChipMinHeightPx() + 12) + "px;");
const refreshStyle = computed((): string => "opacity:" + (loading.value || sources.value.length == 0 ? "0.45" : "1") + ";");
const sourceGapPx = computed((): number => layout.isWide ? 8 : qtRpx(16));
const sourceChipWidths = computed((): number[] => sources.value.map((id: string): number => qtOptionChipWidthPx(sourceRegistry.label(id), true)));
const sourceRowWidth = computed((): number => {
  let width = padX.value * 2 + Math.max(0, sources.value.length - 1) * sourceGapPx.value;
  for (let i = 0; i < sourceChipWidths.value.length; i++) width += sourceChipWidths.value[i];
  return Math.ceil(width);
});
function onSourceScroll(event: UniScrollEvent): void {
  const left = Number(event.detail.scrollLeft);
  if (Number.isFinite(left)) sourceScrollLeft = Math.max(0, left);
}
function sourceNeedsReveal(index: number): boolean {
  if (index < 0 || index >= sourceChipWidths.value.length) return false;
  let start = padX.value;
  for (let i = 0; i < index; i++) start += sourceChipWidths.value[i] + sourceGapPx.value;
  const next = qtSelectionScrollOffset(start, start + sourceChipWidths.value[index], sourceStripWidth.value, sourceScrollLeft, sourceRowWidth.value);
  return Math.abs(next - sourceScrollLeft) > 0.5;
}
// Native horizontal content does not grow from flex-none children; use the shared chip border boxes.
const sourceOptionsStyle = computed((): string => "width:" + sourceRowWidth.value + "px;padding:4px " + padX.value + "px;");
function sourceOptionStyle(index: number): string {
  const right = index < sources.value.length - 1 ? sourceGapPx.value : 0;
  return "width:" + sourceChipWidths.value[index] + "px;margin-right:" + right + "px;";
}
// Label-only page border box: override Native's content-floor min-height; shared QtOption stays unchanged.
function sourceChipStyle(index: number): string {
  return "width:" + sourceChipWidths.value[index] + "px;height:" + qtOptionChipMinHeightPx() + "px;min-height:0;";
}
const smallMutedStyle = computed((): string => "color:" + theme.skin.textSubtle + ";" + qtFontDual(21, 11));
const gridStyle = computed((): string => "width:" + gridWidth.value + "px;padding:" + padY.value + "px " + padX.value + "px 0px;");
function rankCardStyle(index: number): string {
  const right = index % columns.value < columns.value - 1 ? gapPx.value : 0;
  return "width:" + cardWidth.value + "px;height:" + cardHeight.value + "px;padding:" + cardPad.value + "px;margin-right:" + right + "px;margin-bottom:" + gapPx.value + "px;background-color:" + theme.skin.surface + ";border-color:" + theme.skin.border + ";";
}
const rankHeadingStyle = computed((): string => "height:" + headPx.value + "px;");
const rankNameStyle = computed((): string => "color:" + theme.skin.text + ";" + qtFontDual(32, 17));
const rankBodyStyle = computed((): string => "height:" + bodyPx.value + "px;margin-top:" + bodyGap.value + "px;");
const coverBoxStyle = computed((): string => "width:" + coverPx.value + "px;height:" + coverPx.value + "px;margin-right:" + (layout.isWide ? 12 : qtRpx(24)) + "px;");
const coverStyle = computed((): string => "width:" + coverPx.value + "px;height:" + coverPx.value + "px;background-color:" + theme.skin.divider + ";");
const coverTextStyle = computed((): string => "color:" + theme.skin.textSubtle + ";" + qtFontDual(46, 26));
const previewLineStyle = computed((): string => "height:" + linePx.value + "px;");
const previewNameStyle = computed((): string => "color:" + theme.skin.textMuted + ";" + qtFontDual(26, 13));
const previewNumberStyle = computed((): string => "width:" + (layout.isWide ? 16 : qtRpx(28)) + "px;color:" + theme.skin.textSubtle + ";" + qtFontDual(22, 11));
const skeletonHeadingStyle = computed((): string => "height:" + headPx.value + "px;background-color:" + theme.skin.divider + ";");
const skeletonLineStyle = computed((): string => "height:" + Math.max(8, linePx.value - 10) + "px;margin-bottom:10px;background-color:" + theme.skin.divider + ";");
const backTopStyle = computed((): string => "background-color:" + theme.skin.surface + ";border-color:" + theme.skin.border + ";" + (layout.isWide ? "width:44px;height:44px;right:20px;bottom:20px;" : ""));

function current(seq: number): boolean { return pageAlive && pageVisible.value && seq == intent; }
function cancelTop(): void {
  if (topTimer != 0) { clearTimeout(topTimer); topTimer = 0; }
  const resolve = topResolve;
  topResolve = null;
  if (resolve != null) resolve(false);
}
function cancelTimers(): void {
  cancelTop();
  if (restoreTimer != 0) { clearTimeout(restoreTimer); restoreTimer = 0; }
  if (releaseTimer != 0) { clearTimeout(releaseTimer); releaseTimer = 0; }
  if (measureTimer != 0) { clearTimeout(measureTimer); measureTimer = 0; }
  measureSeq++;
}
function beginIntent(): number {
  intent++;
  cancelTimers();
  chartLoader.suspend(true);
  loadAllBusy = false;
  return intent;
}
/** 真实设备已验证的替换配方：先回顶，等原生布局，然后换整个source。 */
function awaitTop(seq: number): Promise<boolean> {
  cancelTop();
  if (releaseTimer != 0) { clearTimeout(releaseTimer); releaseTimer = 0; }
  suppressScroll = true;
  scrollTop.value = scrollTop.value == 0 ? 1 : 0;
  lastScrollTop = 0;
  showBackTop.value = false;
  return new Promise<boolean>((resolve) => {
    topResolve = resolve;
    topTimer = setTimeout(() => {
      topTimer = 0;
      topResolve = null;
      if (!current(seq)) { resolve(false); return; }
      scrollTop.value = 0;
      releaseScroll(seq);
      resolve(true);
    }, 80) as number;
  });
}
function releaseScroll(seq: number): void {
  if (releaseTimer != 0) clearTimeout(releaseTimer);
  releaseTimer = setTimeout(() => {
    releaseTimer = 0;
    if (current(seq)) suppressScroll = false;
  }, 80) as number;
}
function updatePreviewWindow(top: number = lastScrollTop, force: boolean = false): void {
  if (!pageAlive || !pageVisible.value || activeSource.value.length == 0) return;
  const demand = chartDemandWindow(Math.max(0, top - padY.value), viewportHeight.value, cardStride.value, columns.value, allCharts.value.length);
  // 不收缩前缀、不换窗口树；先前卡保持原位，仅追加所需尾部。
  renderedCount.value = Math.max(renderedCount.value, demand.end);
  chartLoader.setDemand(demand.start, demand.end, force);
}
function restoreScroll(seq: number, top: number): void {
  if (releaseTimer != 0) { clearTimeout(releaseTimer); releaseTimer = 0; }
  suppressScroll = true;
  lastScrollTop = top;
  updatePreviewWindow(top);
  nextTick(() => {
    if (!current(seq)) return;
    restoreTimer = setTimeout(() => {
      restoreTimer = 0;
      if (!current(seq)) return;
      scrollTop.value = top;
      showBackTop.value = top > 640;
      releaseScroll(seq);
    }, 80) as number;
  });
}
function measureGrid(attempt: number = 0): void {
  if (!pageAlive || !pageVisible.value) return;
  const seq = ++measureSeq;
  nextTick(() => {
    if (!pageAlive || !pageVisible.value || seq != measureSeq) return;
    uni.createSelectorQuery().select("#chart-scroll").boundingClientRect((rect) => {
      if (!pageAlive || !pageVisible.value || seq != measureSeq) return;
      if (rect != null && rect.width > 0 && rect.height > 0) {
        measuredWidth.value = rect.width;
        measuredHeight.value = rect.height;
        updatePreviewWindow();
        return;
      }
      if (attempt < 3) measureTimer = setTimeout(() => { measureTimer = 0; measureGrid(attempt + 1); }, 120) as number;
    }).exec();
  });
}
function onListScroll(event: UniScrollEvent): void {
  const top = Number(event.detail.scrollTop);
  if (suppressScroll || !pageVisible.value || !Number.isFinite(top) || top < 0 || top > 500000) return;
  lastScrollTop = top;
  showBackTop.value = top > 640;
  if (activeSource.value.length > 0) saveChartScroll(activeSource.value, top);
  updatePreviewWindow(top);
}
function backToTop(): void {
  suppressScroll = true;
  scrollTop.value = scrollTop.value == 0 ? 1 : 0;
  lastScrollTop = 0;
  showBackTop.value = false;
  saveChartScroll(activeSource.value, 0);
  updatePreviewWindow(0);
  releaseScroll(intent);
}
function present(source: string, list: Chart[], seq: number, force: boolean): void {
  if (!current(seq)) return;
  activeSource.value = source;
  allCharts.value = list;
  renderedCount.value = 0;
  chartLoader.display(source, list);
  chartLoader.resume();
  currentSourceLoaded.value = true;
  loadError.value = "";
  loading.value = false;
  const restore = force ? 0 : Math.min(readChartScroll(source), Math.max(0, Math.ceil(list.length / columns.value) * cardStride.value - viewportHeight.value));
  lastScrollTop = restore;
  updatePreviewWindow(restore, force);
  restoreScroll(seq, restore);
  measureGrid();
}
async function fetchSource(source: string, force: boolean, seq: number): Promise<void> {
  const identity = musicApi.chartCacheIdentity();
  loadedIdentity = identity;
  const cached = readChartListSnapshot(source);
  if (!force && cached != null) {
    present(source, cached.charts, seq, false);
    return;
  }
  loading.value = true;
  try {
    const forceList = force || chartListRequiresNetwork(source);
    const list = await musicApi.charts(source, forceList);
    if (!current(seq) || identity != musicApi.chartCacheIdentity()) return;
    // 等待期间用户可再滚动；无条件再次回顶，不依赖被程序滚动暂时屏蔽的事件值。
    if (allCharts.value.length > 0 && !(await awaitTop(seq))) return;
    if (!current(seq) || identity != musicApi.chartCacheIdentity()) return;
    rememberChartList(source, list, identity);
    present(source, list, seq, forceList);
  } catch (error) {
    if (!current(seq) || identity != musicApi.chartCacheIdentity()) return;
    logMsgErr("[QT Music Chart Page]", error);
    loadError.value = "加载失败";
    currentSourceLoaded.value = true;
    loading.value = false;
    if (force && allCharts.value.length > 0) qtShowToast({ title: "刷新失败，已保留原榜单", icon: "none" });
    chartLoader.resume();
    updatePreviewWindow();
    releaseScroll(seq);
  }
}
function chooseSource(): number {
  const ids = sources.value;
  if (paramSi >= 0 && paramSi < ids.length) { const index = paramSi; paramSi = -1; return index; }
  paramSi = -1;
  let index = ids.indexOf(activeSource.value);
  if (index < 0) index = ids.indexOf(sourceStore.current);
  return index >= 0 ? index : ids.length > 0 ? 0 : -1;
}
async function loadAll(force: boolean = false): Promise<void> {
  if (!pageAlive || !pageVisible.value) return;
  const seq = beginIntent();
  loadAllBusy = true;
  loading.value = true;
  loadError.value = "";
  try {
    sourceStore.restore();
    await sourceRegistry.ensure();
    if (!current(seq)) return;
    const index = chooseSource();
    if (index < 0) {
      activeSource.value = "";
      sourceIndex.value = -1;
      pendingSourceIndex.value = -1;
      allCharts.value = [];
      renderedCount.value = 0;
      chartLoader.display("", []);
      currentSourceLoaded.value = true;
      loading.value = false;
      suppressScroll = false;
      started = true;
      return;
    }
    const source = sources.value[index];
    const changed = source != activeSource.value;
    if (allCharts.value.length > 0 && !(await awaitTop(seq))) return;
    if (!current(seq)) return;
    sourceIndex.value = index;
    pendingSourceIndex.value = -1;
    activeSource.value = source;
    if (changed) { allCharts.value = []; renderedCount.value = 0; currentSourceLoaded.value = false; }
    await fetchSource(source, force, seq);
    if (current(seq)) started = true;
  } finally {
    if (seq == intent) loadAllBusy = false;
  }
}
async function switchSource(index: number): Promise<void> {
  const source = sources.value[index];
  if (source == null) return;
  const seq = beginIntent(); // A→B→A也必须失效先前B，不能按“当前仍是A”早退。
  pendingSourceIndex.value = index;
  loading.value = true;
  if (!(await awaitTop(seq))) return;
  if (!current(seq)) return;
  sourceIndex.value = index;
  pendingSourceIndex.value = -1;
  if (source != activeSource.value) { allCharts.value = []; renderedCount.value = 0; currentSourceLoaded.value = false; }
  activeSource.value = source;
  loadError.value = "";
  await fetchSource(source, false, seq);
}
function onChipTap(index: number): void {
  if (index < 0 || index >= sources.value.length) return;
  if (index == sourceIndex.value && pendingSourceIndex.value < 0 && !loading.value) return;
  // #ifdef APP-HARMONY
  // 鸿蒙真机页内整组换源会丢渲染；沿用已验证的整页重建与si参数。
  uni.redirectTo({ url: "/pages/chart/index?si=" + index });
  return;
  // #endif
  switchSource(index);
}
function reloadChartsSafely(): void {
  if (loading.value || sources.value.length == 0) return;
  loadAll(true);
}
function onHeaderAction(name: string): void { if (name == "refresh") reloadChartsSafely(); }
function onPacksChanged(): void {
  beginIntent(); // 包事件同步失效在飞工作，不能等回顶计时器再失效。
  clearChartViewCache();
  loadedIdentity = "";
  currentSourceLoaded.value = false;
  if (pageVisible.value && mounted) loadAll(false);
}
function goToSettings(): void { uni.navigateTo({ url: "/pages/settings/index" }); }
function openChart(chart: Chart): void {
  uni.navigateTo({ url: "/pages/playlist/index?id=" + encodeURIComponent(chart.id) + "&platform=" + encodeURIComponent(chart.platform)
    + "&type=chart&name=" + encodeURIComponent(chart.name) + "&desc=" + encodeURIComponent(chart.description || "") + "&pic=" + encodeURIComponent(chart.picUrl || "") });
}
async function onPreviewTap(index: number, row: number): Promise<void> {
  if (chartLoader.previewStates.value[index] == 2) { chartLoader.retry(index); return; }
  const songs = chartLoader.previewSongs.value[index];
  if (songs == null || row < 0 || row >= songs.length) return;
  try {
    // 不预取在线地址；保持player.playSingle的本地优先/统一起播错误处理。
    await player.playSingle(songs[row]);
  } catch (error) {
    logMsgErr("[QT Music Chart Page]", error);
    qtShowToast({ title: "播放失败", icon: "none" });
  }
}
onLoad((options) => {
  // onLoad supplies plain route options, including when mounted in the wide workspace.
  const raw = options != null ? (options["si"] as string | null | undefined) : null;
  if (raw == null || raw.trim().length == 0) return;
  const parsed = Number(raw);
  if (Number.isInteger(parsed) && parsed >= 0) paramSi = parsed;
});
onMounted(() => {
  mounted = true;
  uni.$on(SOURCE_PACKS_CHANGED_EVENT, onPacksChanged);
  measureGrid();
  loadAll(false);
});
onShow(() => {
  pageVisible.value = true;
  if (!mounted || loadAllBusy) return;
  const source = activeSource.value;
  const changed = loadedIdentity != musicApi.chartCacheIdentity();
  if (changed) clearChartViewCache();
  if (!started || changed || !currentSourceLoaded.value || sources.value.indexOf(source) < 0 || readChartListSnapshot(source) == null) {
    loadAll(false);
  } else {
    chartLoader.resume();
    suppressScroll = false;
    updatePreviewWindow();
    measureGrid();
  }
});
onHide(() => {
  pageVisible.value = false;
  beginIntent();
  pendingSourceIndex.value = -1;
  loading.value = false;
  chartLoader.suspend();
  flushChartScroll();
});
onUnmounted(() => {
  pageAlive = false;
  pageVisible.value = false;
  beginIntent();
  chartLoader.dispose();
  flushChartScroll();
  uni.$off(SOURCE_PACKS_CHANGED_EVENT, onPacksChanged);
});
watch((): string => sources.value.join("|"), () => {
  if (!mounted || !pageVisible.value || loadAllBusy) return;
  const index = sources.value.indexOf(activeSource.value);
  if (index < 0 || loadedIdentity != musicApi.chartCacheIdentity()) loadAll(false);
  else sourceIndex.value = index;
});
watch((): string => layout.sizeEpoch + ":" + fontScale.scale, () => {
  if (!pageVisible.value) return;
  measuredWidth.value = 0;
  measuredHeight.value = 0;
  updatePreviewWindow();
  measureGrid();
});
</script>

<style>
.source-bar { flex-direction: row; align-items: center; flex-shrink: 0; }
.source-strip { flex-shrink: 0; }
.chart-refresh { width: 44px; height: 44px; margin-left: 8px; margin-right: 16px; align-items: center; justify-content: center; flex-shrink: 0; }
.source-options { flex-direction: row; align-items: center; }
.source-option { flex-shrink: 0; }
.chart-body { flex: 1; min-height: 0; position: relative; }
.chart-scroll { flex: 1; }
.chart-host { width: 100%; flex-direction: row; flex-wrap: wrap; }
.rank-card { flex-shrink: 0; border-width: 1px; border-style: solid; border-radius: 18rpx; overflow: hidden; }
.rank-card-wide { border-radius: 18px; }
.rank-heading { flex-direction: row; align-items: center; }
.rank-name { flex: 1; min-width: 0; font-weight: 600; line-height: 1.4; white-space: nowrap; text-overflow: ellipsis; }
.rank-meta { margin-left: 8px; margin-right: 4px; line-height: 1.4; }
.rank-body { flex-direction: row; align-items: center; }
.rank-cover-box { flex-shrink: 0; }
.rank-cover { border-radius: 12rpx; }
.rank-cover-wide { border-radius: 12px; }
.rank-cover-placeholder { border-radius: 12rpx; flex-shrink: 0; align-items: center; justify-content: center; }
.rank-cover-placeholder-wide { border-radius: 12px; }
.cover-placeholder-text { font-weight: 700; }
.preview-lines { flex: 1; min-width: 0; justify-content: center; }
.preview-line { flex-direction: row; align-items: center; }
.preview-number { flex-shrink: 0; width: 28rpx; margin-right: 6px; line-height: 1.4; }
.preview-name { flex: 1; min-width: 0; line-height: 1.4; white-space: nowrap; text-overflow: ellipsis; }
.skeleton-heading { width: 54%; border-radius: 8rpx; }
.skeleton-heading-wide { border-radius: 8px; }
.skeleton-line { width: 82%; margin-left: 12px; border-radius: 6rpx; }
.skeleton-line-wide { border-radius: 6px; }
.chart-end { padding: 20px 0px 28px; align-items: center; }
.chart-end-text { line-height: 1.5; text-align: center; }
.back-top { position: absolute; right: 32rpx; bottom: 32rpx; width: 88rpx; height: 88rpx; border-radius: 44rpx; border-width: 1px; border-style: solid; align-items: center; justify-content: center; }
.back-top-wide { border-radius: 22px; }
</style>
