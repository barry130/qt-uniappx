<template>
  <qt-page-frame width-kind="form" :max-width="720">
    <view class="page" :class="layout.isWide ? 'page-wide' : ''">
      <view v-if="song == null" class="empty" :class="layout.isWide ? 'empty-wide' : ''">
        <text class="empty-text" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontPx(14)">没有可分享的歌曲</text>
      </view>

      <template v-else>
        <!-- 内容整体可滚：卡片（尤其歌词卡）在小屏上高过可视区，旧版是普通 view
             直接裁底，两个操作按钮根本点不到（m21618）。参照公告详情页的
             scroll(direction=vertical)+flex:1 模式。 -->
        <scroll-view class="scroll" direction="vertical" :show-scrollbar="false" :scroll-into-view="scrollInto">
          <view class="scroll-body">
        <!-- 卡片模式切换 -->
        <view class="mode-row" :class="layout.isWide ? 'mode-row-wide' : ''">
          <QtSegmented v-model="mode" :list="['歌曲卡片', '歌词卡片']" :item-gap="16" />
        </view>

        <!-- 卡片本体：takeSnapshot 截这个节点 -->
        <view class="card-wrap" :style="'width:' + cardPx + 'px;'">
          <view id="shareCard" class="card" :style="'background-color:' + themeStore.skin.surface + ';width:' + cardPx + 'px;'">
            <image
              class="cover"
              :src="coverUrl"
              mode="aspectFill"
              :style="'width:' + cardPx + 'px;height:' + cardPx + 'px;'"
              @load="onCoverLoad"
              @error="onCoverLoad"
            />
            <view class="info" :style="'width:' + cardPx + 'px;'">
              <text class="song-name" max-lines="2" :style="('color:' + themeStore.skin.text + ';') + qtFontPx(18)">{{ song.name }}</text>
              <text class="song-singer" max-lines="1" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontPx(13)">{{ song.singer }}</text>
              <view v-if="mode == 1" class="lyric-block">
                <view v-if="lyricLines.length > 0">
                  <text
                    v-for="(line, idx) in lyricLines"
                    :key="idx"
                    class="lyric-line"
                    max-lines="1"
                    :style="('color:' + (idx == 0 ? themeStore.skin.accent : themeStore.skin.textSubtle) + ';') + qtFontPx(14)"
                  >{{ line }}</text>
                </view>
                <!-- 歌词未回来：铺三行文字骨架；这块会被截图导出，所以关掉扫光 -->
                <view v-else-if="lyricLoading" class="lyric-sk">
                  <QtSkeletonList kind="text" :rows="3" :shining="false" />
                </view>
                <text v-else class="lyric-line" :style="('color:' + themeStore.skin.textSubtle + ';') + qtFontPx(14)">暂无歌词</text>
              </view>
            </view>
            <view class="footer" :style="'width:' + cardPx + 'px;'">
              <view class="footer-left">
                <text class="footer-brand" :style="('color:' + themeStore.skin.accent + ';') + qtFontPx(13)">轻听音乐</text>
                <text class="footer-tip" :style="('color:' + themeStore.skin.text + ';') + qtFontPx(10)">扫码下载客户端</text>
                <text class="footer-sub" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontPx(10)">QuietMusic</text>
              </view>
              <!-- 下载二维码：静态 PNG（黑白固定，不跟主题），随卡片一起被 takeSnapshot 截进去 -->
              <image class="footer-qr" src="/static/share/share-qr.png" mode="aspectFit" />
            </view>
          </view>
        </view>

        <!-- 操作区 -->
        <view class="actions" :class="layout.isWide ? 'actions-wide' : ''">
          <view class="act-btn act-primary" :style="'background-color:' + themeStore.skin.accent + ';'" @click="doShare">
            <text class="act-text" :style="('color:' + themeStore.skin.onAccent + ';') + qtFontPx(14)">{{ working ? "处理中..." : "分享图片" }}</text>
          </view>
          <view class="act-btn act-ghost" :style="'background-color:' + themeStore.skin.surfaceInset + ';border-color:' + themeStore.skin.border + ';'" @click="doSave">
            <text class="act-text" :style="('color:' + themeStore.skin.text + ';') + qtFontPx(14)">{{ working ? "处理中..." : "保存到相册" }}</text>
          </view>
        </view>
        <view class="tip-row" :class="layout.isWide ? 'tip-row-wide' : ''">
          <text class="tip-text" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontPx(12)">生成图片后可分享到微信、QQ 等应用</text>
        </view>
          </view>
        </scroll-view>
      </template>
    </view>
  </qt-page-frame>
</template>
<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import { onLoad, onUnload } from "@dcloudio/uni-app";
import { computed, ref } from "vue";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import QtSegmented from "@/uni_modules/qt-ui/components/qt-segmented/qt-segmented.uvue";
import QtSkeletonList from "@/uni_modules/qt-ui/components/qt-skeleton-list/qt-skeleton-list.uvue";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { qtTrackPage } from "@/uni_modules/qt-stat";
import { musicApi } from "@/services/music-api";
import { parseLrc } from "@/utils/lrc.uts";
import { useShareCardStore } from "@/stores/share-card";
import { DEFAULT_PLAYLIST_COVER_ASSET } from "@/services/media";
import { beginLoading, finishLoading } from "@/services/ui-loading";
import { qtFontPx } from "@/uni_modules/qt-ui/stores/font-scale";
import { saveImageToGallery } from "@/services/app-native";

const layout = useQtLayout();
const themeStore = useThemeStore();
const shareCard = useShareCardStore();

const song = computed(() => shareCard.song);
/** 0 歌曲卡片 / 1 歌词卡片 */
const mode = ref(0);
const lyricLines = ref<string[]>([]);
const lyricLoading = ref(false);
/** 封面就绪后才允许截图（远程图失败也放行，按兜底样式出图） */
const coverReady = ref(false);
const working = ref(false);

const coverUrl = computed(() => {
  const s = song.value;
  if (s == null) return DEFAULT_PLAYLIST_COVER_ASSET;
  return s.picUrl != null && s.picUrl!.length > 0 ? s.picUrl! : DEFAULT_PLAYLIST_COVER_ASSET;
});

/** 卡片响应式宽度（m21618「分享页面太大了」）：固定 300px 在小屏手机上太高，
 *  高过可视区且旧版无滚动，底部按钮被裁。手机按窗口宽收缩（两侧共留 96px），
 *  下限 220 保住封面观感，宽屏维持 340 上限。封面保持正方形，与卡片同宽。 */
const cardPx = computed((): number => {
  const cap = layout.isWide ? 340 : 300;
  const fit = Math.floor(Math.max(layout.windowWidth, 1) - 96);
  return Math.min(cap, Math.max(220, fit));
});
/** 截图前把卡片滚回可视区：歌词卡会超出视口，takeSnapshot 对视口外节点不可靠。 */
const scrollInto = ref("");
/** snapshotCard 的滚动等待定时器，onUnload 清理，防止离开页面后仍触截图。 */
let snapDelay = 0;

onLoad(() => {
  qtTrackPage("pages/share-card/index");
  loadLyrics();
});

onUnload(() => {
  // 离开页面即清目标，避免返回后再进残留上一首
  shareCard.song = null;
  if (snapDelay != 0) {
    clearTimeout(snapDelay);
    snapDelay = 0;
  }
});

function loadLyrics(): void {
  const s = song.value;
  if (s == null) return;
  lyricLoading.value = true;
  musicApi
    .lyrics(s)
    .then((text) => {
      const lines = parseLrc(text, "")
        .map((l) => l.text.trim())
        .filter((t) => t.length > 0);
      lyricLines.value = lines.slice(0, 6);
      lyricLoading.value = false;
    })
    .catch(() => {
      lyricLoading.value = false;
    });
}

function onCoverLoad(): void {
  coverReady.value = true;
}

/** 截图卡片节点，拿到临时文件后走 then 分支（分享 / 保存共用） */
function snapshotCard(onDone: (tempPath: string) => void, onFail: () => void): void {
  if (working.value) return;
  if (!coverReady.value) {
    qtShowToast({ title: "封面还在加载，稍候再试", icon: "none", duration: 2500 });
    onFail();
    return;
  }
  const el = uni.getElementById("shareCard");
  if (el == null) {
    qtShowToast({ title: "生成图片失败", icon: "none", duration: 2500 });
    onFail();
    return;
  }
  working.value = true;
  // 歌词卡可能被滚出视口：先把卡片滚回可视区再截（scroll-into-view 对齐顶部），
  // 等一拍滚动完成；working 已置位挡住等待窗口内的重复点击。
  // 截图结束后 runSnapshot 会把 scrollInto 复位为 ""，下次还能重新触发滚动。
  scrollInto.value = "shareCard";
  snapDelay = setTimeout(() => {
    snapDelay = 0;
    runSnapshot(el);
  }, 320) as unknown as number;
}

/** 真正执行截图；与 snapDelay 分离后 onUnload 清定时器即可安全放弃未启动的截图 */
function runSnapshot(el: UniElement): void {
  // 截图是异步原生调用，先给 loading，避免“点了没反应”的错觉
  const snapToken = beginLoading("生成图片中...");
  el.takeSnapshot({
    success: (res) => {
      working.value = false;
      scrollInto.value = "";
      finishLoading(snapToken);
      const path = res.tempFilePath;
      if (path == null || path.length == 0) {
        qtShowToast({ title: "生成图片失败", icon: "none", duration: 2500 });
        onFail();
        return;
      }
      onDone(path);
    },
    fail: () => {
      working.value = false;
      scrollInto.value = "";
      finishLoading(snapToken);
      qtShowToast({ title: "生成图片失败", icon: "none", duration: 2500 });
      onFail();
    },
  });
}

function doShare(): void {
  snapshotCard((tempPath) => {
    // shareWithSystem 属于按需编译进基座的 uni 模块：调试基座若早于本页生成，
    // 运行时没有该 API，调用会直接抛错（表现为点击无反应），这里必须兜住并给出出口
    try {
      uni.shareWithSystem({
        type: "image",
        imageUrl: tempPath,
        fail: () => {
          qtShowToast({ title: "分享未完成", icon: "none", duration: 2500 });
        },
      });
    } catch (_) {
      qtShowToast({ title: "系统分享不可用，可先保存到相册", icon: "none", duration: 3000 });
    }
  }, () => {});
}

function doSave(): void {
  snapshotCard((tempPath) => {
    saveImageToGallery(tempPath, "qt-share-" + Date.now() + ".png").then((saved: string) => {
      if (saved.length > 0) {
        qtShowToast({ title: "已保存到相册", icon: "none", duration: 2500 });
      } else {
        qtShowToast({ title: "保存失败，请检查存储空间", icon: "none", duration: 2500 });
      }
    });
  }, () => {});
}
</script>
<style lang="css">
.page {
  flex: 1;
  padding: 16px;
  align-items: center;
}
.scroll {
  flex: 1;
  width: 100%;
}
.scroll-body {
  align-items: center;
}
.page-wide {
  padding: 20px;
}
.empty {
  margin-top: 120px;
  align-items: center;
}
.empty-wide {
  margin-top: 160px;
}
.empty-text {
  font-size: 14px;
}
.mode-row {
  align-items: center;
  margin-bottom: 20px;
}
.mode-row-wide {
  margin-bottom: 24px;
}
.card-wrap {
  align-items: center;
}
.card {
  border-radius: 16px;
  overflow: hidden;
}
.cover {
  border-top-left-radius: 16px;
  border-top-right-radius: 16px;
}
.info {
  padding: 18px 18px 6px 18px;
}
.song-name {
  font-size: 18px;
  font-weight: bold;
  text-overflow: ellipsis;
}
.song-singer {
  margin-top: 6px;
  font-size: 13px;
  text-overflow: ellipsis;
}
.lyric-block {
  margin-top: 14px;
}
.lyric-sk {
  flex-direction: column;
}
.lyric-line {
  font-size: 14px;
  line-height: 26px;
  text-overflow: ellipsis;
}
.footer {
  padding: 12px 18px 16px 18px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.footer-left {
  flex-direction: column;
  align-items: flex-start;
}
.footer-brand {
  font-size: 13px;
  font-weight: bold;
}
.footer-tip {
  font-size: 10px;
  margin-top: 3px;
}
.footer-sub {
  font-size: 10px;
  letter-spacing: 2px;
  margin-top: 3px;
}
.footer-qr {
  width: 64px;
  height: 64px;
}
.actions {
  margin-top: 24px;
  flex-direction: row;
}
.actions-wide {
  margin-top: 28px;
}
.act-btn {
  height: 44px;
  border-radius: 22px;
  padding: 0 28px;
  align-items: center;
  justify-content: center;
}
.act-primary {
  margin-right: 14px;
}
.act-ghost {
  border-width: 1px;
  border-style: solid;
}
.act-text {
  font-size: 14px;
  font-weight: bold;
}
.tip-row {
  margin-top: 14px;
  align-items: center;
}
.tip-row-wide {
  margin-top: 16px;
}
.tip-text {
  font-size: 12px;
}
</style>
