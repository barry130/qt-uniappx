<template>
  <qt-page-frame width-kind="list">
    <view class="page" :class="layout.isWide ? 'page-wide' : ''">
      <!-- 扫描中：用歌曲行骨架占位，状态文案缩成一行顶部提示 -->
      <view v-if="scanning" class="scanning">
        <text class="scanning-text" :class="layout.isWide ? 'scanning-text-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 13)">正在扫描手机里的歌曲…</text>
        <QtSkeletonList kind="song" :rows="SKELETON_ROWS" />
      </view>

      <!-- 首次打开：扫描引导 -->
      <scroll-view v-else-if="viewMode == 'onboard'" class="onboard-scroll" direction="vertical" :show-scrollbar="false">
        <view class="onboard" :class="layout.isWide ? 'onboard-wide' : ''">
          <view class="onboard-inner" :class="layout.isWide ? 'onboard-inner-wide' : ''">
            <view class="hero-ring" :class="layout.isWide ? 'hero-ring-wide' : ''" :style="'border-color:' + theme.skin.accentSoft + ';background-color:' + theme.skin.accentSoft + ';'">
              <view class="hero-chip" :class="layout.isWide ? 'hero-chip-wide' : ''" :style="'background-color:' + theme.skin.accent + ';'">
                <QtIcon name="music" :size="layout.isWide ? 34 : 72" :color="theme.skin.onAccent" />
              </view>
            </view>
            <text class="hero-title" :class="layout.isWide ? 'hero-title-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(38, 22)">一键扫描手机内歌曲文件</text>
            <text class="hero-sub" :class="layout.isWide ? 'hero-sub-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 13)">扫描结果会保存到本地，下次进入直接展示，随时可以重新扫描</text>

            <view class="scan-primary" :class="layout.isWide ? 'scan-primary-wide' : ''" :style="'background-color:' + theme.skin.accent + ';'" @click="startScan('all')">
              <QtIcon name="search" :size="layout.isWide ? 16 : 30" :color="theme.skin.onAccent" />
              <text class="scan-primary-text" :class="layout.isWide ? 'scan-primary-text-wide' : ''" :style="('color:' + theme.skin.onAccent + ';') + qtFontDual(30, 16)">全盘扫描</text>
            </view>
            <view class="scan-ghost" :class="layout.isWide ? 'scan-ghost-wide' : ''" :style="'border-color:' + theme.skin.border + ';background-color:' + theme.skin.surface + ';'">
              <view class="scan-ghost-btn" @click="startScan('folder')">
                <QtIcon name="folder" :size="layout.isWide ? 14 : 26" :color="theme.skin.text" />
                <text class="scan-ghost-text" :class="layout.isWide ? 'scan-ghost-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 15)">文件夹扫描</text>
              </view>
            </view>
            <text class="perm-hint" :class="layout.isWide ? 'perm-hint-wide' : ''" :style="('color:' + theme.skin.textSubtle + ';') + qtFontDual(22, 12)">扫描会申请“音乐和音频”文件访问权限，仅用于读取本地歌曲</text>
          </view>
        </view>
      </scroll-view>

      <!-- 导入配置：勾选要导入的目录 + 扫描规则 -->
      <template v-else-if="viewMode == 'folderPick'">
        <view class="head-card" :class="layout.isWide ? 'head-card-wide' : ''" :style="cardStyle">
          <view class="head-copy">
            <text class="head-title" :class="layout.isWide ? 'head-title-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(32, 20)">导入配置</text>
            <text class="head-sub" :class="layout.isWide ? 'head-sub-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)">{{ pickSummary }}</text>
          </view>
          <view class="head-btn" :class="layout.isWide ? 'head-btn-wide' : ''" :style="'border-color:' + theme.skin.border + ';'">
            <text class="head-btn-text" :class="layout.isWide ? 'head-btn-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(24, 14)" @click="toggleAll">{{ allChecked ? "取消全选" : "全选" }}</text>
          </view>
          <view class="head-btn primary" :class="layout.isWide ? 'head-btn-wide' : ''" :style="'background-color:' + theme.skin.accent + ';border-color:' + theme.skin.accent + ';'">
            <text class="head-btn-text" :class="layout.isWide ? 'head-btn-text-wide' : ''" :style="('color:' + theme.skin.onAccent + ';') + qtFontDual(24, 14)" @click="confirmImport">导入</text>
          </view>
        </view>
        <!-- 扫描规则：留空 = 不限制，改动即时反映到下方目录数量与导入结果 -->
        <view class="rule-card" :class="layout.isWide ? 'rule-card-wide' : ''" :style="cardStyle">
          <view class="rule-line" :class="layout.isWide ? 'rule-line-wide' : ''">
            <text class="rule-label" :class="layout.isWide ? 'rule-label-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 13)">屏蔽少于</text>
            <view class="rule-field" :class="layout.isWide ? 'rule-field-wide' : ''" :style="'background-color:' + theme.skin.surfaceMuted + ';'">
              <input class="rule-input" :class="layout.isWide ? 'rule-input-wide' : ''" type="number" :value="minSecondsText" @input="onMinSecondsInput" placeholder="不限" :placeholder-class="layout.isWide ? 'rule-ph-wide' : 'rule-ph'" />
              <text class="rule-unit" :class="layout.isWide ? 'rule-unit-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 12)">秒</text>
            </view>
            <view class="rule-field" :class="layout.isWide ? 'rule-field-wide' : ''" :style="'background-color:' + theme.skin.surfaceMuted + ';'">
              <input class="rule-input" :class="layout.isWide ? 'rule-input-wide' : ''" type="digit" :value="minSizeText" @input="onMinSizeInput" placeholder="不限" :placeholder-class="layout.isWide ? 'rule-ph-wide' : 'rule-ph'" />
              <text class="rule-unit" :class="layout.isWide ? 'rule-unit-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 12)">MB</text>
            </view>
          </view>
          <!-- 系统音开关：默认屏蔽铃声/通知/闹钟/录音/应用音效，勾上后它们也进列表 -->
          <view class="rule-flag" :class="layout.isWide ? 'rule-flag-wide' : ''" @click="toggleSystemSounds">
            <view class="rule-box" :class="layout.isWide ? 'rule-box-wide' : ''" :style="includeSystemSounds ? 'background-color:' + theme.skin.accent + ';border-color:' + theme.skin.accent + ';' : 'border-color:' + theme.skin.border + ';'">
              <QtIcon v-if="includeSystemSounds" name="check" :size="layout.isWide ? 10 : 18" :color="theme.skin.onAccent" />
            </view>
            <text class="rule-flag-text" :class="layout.isWide ? 'rule-flag-text-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(22, 12)">包含系统音</text>
          </view>
        </view>
        <!-- 文件夹容器独立成弹性区域：配置卡片不压缩，列表占满剩余高度并自行滚动 -->
        <view class="pick-list" :class="layout.isWide ? 'pick-list-wide' : ''">
          <scroll-view class="list-scroll" direction="vertical" :show-scrollbar="false">
            <view
              v-for="folder in pickFolders"
              :key="folder.path"
              class="row" :class="layout.isWide ? 'row-wide' : ''"
              @click="toggleFolder(folder.path)"
            >
              <view class="cover" :class="layout.isWide ? 'cover-wide' : ''" :style="'background-color:' + theme.skin.accentSoft + ';'">
                <QtIcon name="folder" :size="layout.isWide ? 16 : 30" :color="theme.skin.accent" />
              </view>
              <view class="info" :class="layout.isWide ? 'info-wide' : ''">
                <text class="name" :class="layout.isWide ? 'name-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)" :max-lines="1">{{ folder.name }}</text>
                <text class="meta" :class="layout.isWide ? 'meta-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(23, 13)" :max-lines="1">{{ folder.path }} · {{ folder.count }} 首</text>
              </view>
              <view class="checkbox" :class="layout.isWide ? 'checkbox-wide' : ''" :style="isChecked(folder.path) ? 'background-color:' + theme.skin.accent + ';border-color:' + theme.skin.accent + ';' : 'border-color:' + theme.skin.border + ';'">
                <QtIcon v-if="isChecked(folder.path)" name="check" :size="layout.isWide ? 12 : 22" :color="theme.skin.onAccent" />
              </view>
              <view class="row-divider" :class="layout.isWide ? 'row-divider-wide' : ''" :style="'background-color:' + theme.skin.divider + ';'" />
            </view>
            <view class="foot-space" :class="layout.isWide ? 'foot-space-wide' : ''"></view>
          </scroll-view>
        </view>
      </template>

      <!-- 已有扫描结果：本地音乐列表（布局参照系统播放器本地页：
           页签行(分类+搜索+菜单)、播放全部行、歌曲列表） -->
      <template v-else>
        <!-- 页签行：分类页签居左，搜索/三点按钮居右；选择态右侧等高换成「取消」。
             页签常驻、行高固定，勾选歌曲时页面零位移 -->
        <view class="head-row" :class="layout.isWide ? 'head-row-wide' : ''">
          <view class="seg-row">
            <view
              v-for="opt in viewOptions"
              :key="opt.value"
              class="seg-btn"
              :class="[layout.isWide ? 'seg-btn-wide' : '', listView == opt.value ? 'seg-active' : 'seg-idle']"
              :style="listView == opt.value ? 'background-color:' + theme.skin.accentSoft + ';color:' + theme.skin.accent + ';' : 'color:' + theme.skin.text + ';'"
              @click="listView = opt.value"
            >{{ opt.label }}</view>
          </view>
          <view v-if="!selecting" class="head-acts">
            <view class="head-act" :class="layout.isWide ? 'head-act-wide' : ''" @click="toggleSearch">
              <QtIcon name="search" :size="layout.isWide ? 16 : 30" :color="theme.skin.text" />
            </view>
            <view class="head-act" :class="layout.isWide ? 'head-act-wide' : ''" @click="menuOpen = true">
              <QtIcon name="more" :size="layout.isWide ? 16 : 30" :color="theme.skin.text" />
            </view>
          </view>
          <view v-if="selecting" class="select-cancel" :class="layout.isWide ? 'select-cancel-wide' : ''" @click="toggleSelect">
            <text class="select-cancel-text" :class="layout.isWide ? 'select-cancel-text-wide' : ''" :style="('color:' + theme.skin.accent + ';') + qtFontDual(24, 13)">取消</text>
          </view>
        </view>

        <!-- 搜索行：点放大镜展开，收起时清空关键词恢复全量 -->
        <view v-if="searchOpen" class="search-row" :class="layout.isWide ? 'search-row-wide' : ''">
          <view class="search-field" :class="layout.isWide ? 'search-field-wide' : ''" :style="'background-color:' + theme.skin.surfaceMuted + ';'">
            <QtIcon name="search" :size="layout.isWide ? 12 : 22" :color="theme.skin.textMuted" />
            <input class="search-input" :class="layout.isWide ? 'search-input-wide' : ''" :value="query" @input="onQueryInput" placeholder="搜索标题 / 歌手 / 专辑" :placeholder-class="layout.isWide ? 'search-ph-wide' : 'search-ph'" :style="'color:' + theme.skin.text + ';'" />
          </view>
        </view>

        <!-- 播放全部 / 选择态操作：固定行高等高替换，勾选歌曲不会顶动列表 -->
        <view class="all-line" :class="layout.isWide ? 'all-line-wide' : ''">
          <view v-if="!selecting" class="all-left" @click="playAll">
            <view class="all-play-chip" :class="layout.isWide ? 'all-play-chip-wide' : ''" :style="'background-color:' + theme.skin.accentSoft + ';'">
              <QtIcon name="play" :size="layout.isWide ? 12 : 22" :color="theme.skin.accent" />
            </view>
            <text class="all-text" :class="layout.isWide ? 'all-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">播放全部</text>
            <text class="all-count" :class="layout.isWide ? 'all-count-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 13)">({{ filteredItems.length }})</text>
          </view>
          <text v-else class="all-text" :class="layout.isWide ? 'all-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(28, 16)">已选 {{ selected.length }} 首</text>
          <view class="line-right">
            <view v-if="!selecting" class="sort-act" :class="layout.isWide ? 'sort-act-wide' : ''" @click="toggleSortDir">
              <QtIcon :name="sortAsc ? 'arrow-up' : 'arrow-down'" :size="layout.isWide ? 14 : 26" :color="theme.skin.text" />
            </view>
            <view v-if="selecting" class="manage-btn" :class="layout.isWide ? 'manage-btn-wide' : ''" :style="'border-color:' + theme.skin.border + ';'" @click="toggleSelectAll">
              <text class="manage-btn-text" :class="layout.isWide ? 'manage-btn-text-wide' : ''" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 13)">{{ allSel ? "取消全选" : "全选" }}</text>
            </view>
            <view v-if="selecting && selected.length > 0" class="manage-btn danger" :class="layout.isWide ? 'manage-btn-wide' : ''" :style="'background-color:' + theme.skin.danger + ';border-color:' + theme.skin.danger + ';'" @click="confirmBatchDelete">
              <text class="manage-btn-text" :class="layout.isWide ? 'manage-btn-text-wide' : ''" :style="('color:#ffffff;') + qtFontDual(24, 13)">删除（{{ selected.length }}）</text>
            </view>
          </view>
        </view>

        <!-- 歌曲视图：走 list-view 虚拟滚动（此前是本仓唯一还在用 scroll-view 的重列表，
             几千条本地歌曲会一次性建出全部行）。行高定死在 list-item 上，虚拟滚动靠它预估总高。
             宽屏「一行两首」：一个 list-item 承载两格，条目实例数减半。 -->
        <list-view v-if="listView == 'songs'" class="list" direction="vertical" :show-scrollbar="false">
          <list-item v-if="filteredItems.length == 0" class="empty-item">
            <view class="empty">
              <text class="empty-text" :style="('color:' + theme.skin.text + ';') + qtFontDual(30, 16)">没有匹配的歌曲</text>
              <text class="empty-sub" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ searchOpen ? "换个关键词试试" : "可在右上菜单重新扫描或调整导入配置" }}</text>
            </view>
          </list-item>
          <list-item
            v-for="pair in pairs"
            :key="pair.key"
            class="litem" :class="layout.isWide ? 'litem-wide' : ''"
          >
            <view class="pair" :class="twoColumn ? 'pair-wide' : ''">
              <view class="cell" :style="cellStyle">
                <LocalRow
                  :title="pair.left.title" :meta="rowMeta(pair.left)" :durationText="formatDuration(pair.left.duration)"
                  :selecting="selecting" :selected="isSel(pair.left.id)" :current="currentId == pair.left.id"
                  @tap="onRowTap(pair.left)" @more="onRowMore(pair.left)"
                />
              </view>
              <!-- 右格容器恒渲染（两列时），只有内容按 hasRight 决定：保持「一个 list-item =
                   两个格」的结构签名恒定，复用池不会错配；奇数条数时右格留空但宽度仍占满。 -->
              <view v-if="twoColumn" class="cell-right" :style="rightCellStyle">
                <LocalRow
                  v-if="pair.hasRight"
                  :title="pair.right.title" :meta="rowMeta(pair.right)" :durationText="formatDuration(pair.right.duration)"
                  :selecting="selecting" :selected="isSel(pair.right.id)" :current="currentId == pair.right.id"
                  @tap="onRowTap(pair.right)" @more="onRowMore(pair.right)"
                />
              </view>
            </view>
          </list-item>
          <list-item class="foot-space" :class="layout.isWide ? 'foot-space-wide' : ''"></list-item>
        </list-view>

        <!-- 分组视图（歌手/专辑/文件夹）：组头是变高的分隔行，虚拟滚动的等高行无法承载，
             仍用 scroll-view。分组视图不做两列切分——组一旦被列切断就失去阅读意义。 -->
        <scroll-view v-else class="list" direction="vertical" :show-scrollbar="false">
          <view v-if="filteredItems.length == 0" class="empty">
            <text class="empty-text" :style="('color:' + theme.skin.text + ';') + qtFontDual(30, 16)">没有匹配的歌曲</text>
            <text class="empty-sub" :style="('color:' + theme.skin.textMuted + ';') + qtFontDual(24, 14)">{{ searchOpen ? "换个关键词试试" : "可在右上菜单重新扫描或调整导入配置" }}</text>
          </view>
          <view v-for="group in groups" :key="group.name">
            <view class="group-head" :class="layout.isWide ? 'group-head-wide' : ''" :style="'color:' + theme.skin.textMuted + ';'">{{ group.name }} · {{ group.list.length }} 首</view>
            <view v-for="item in group.list" :key="item.id">
              <LocalRow
                :title="item.title" :meta="rowMeta(item)" :durationText="formatDuration(item.duration)"
                :selecting="selecting" :selected="isSel(item.id)" :current="currentId == item.id"
                @tap="onRowTap(item)" @more="onRowMore(item)"
              />
            </view>
          </view>
          <view class="foot-space" :class="layout.isWide ? 'foot-space-wide' : ''"></view>
        </scroll-view>

        <!-- 三点下拉菜单：浮层盖住整页点空白处收起，面板锚在标题行下方右侧 -->
        <view v-if="menuOpen" class="menu-mask" @click="menuOpen = false" />
        <view v-if="menuOpen" class="menu-panel" :class="layout.isWide ? 'menu-panel-wide' : ''" :style="cardStyle">
          <view class="menu-item" :class="layout.isWide ? 'menu-item-wide' : ''" @click="onMenuItem('rescan')">
            <QtIcon name="refresh" :size="layout.isWide ? 14 : 26" :color="theme.skin.text" />
            <text class="menu-item-text" :class="layout.isWide ? 'menu-item-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">重新扫描</text>
          </view>
          <view class="menu-item" :class="layout.isWide ? 'menu-item-wide' : ''" @click="onMenuItem('folder')">
            <QtIcon name="folder" :size="layout.isWide ? 14 : 26" :color="theme.skin.text" />
            <text class="menu-item-text" :class="layout.isWide ? 'menu-item-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">导入配置</text>
          </view>
          <view class="menu-item" :class="layout.isWide ? 'menu-item-wide' : ''" @click="onMenuItem('sort')">
            <QtIcon name="list" :size="layout.isWide ? 14 : 26" :color="theme.skin.text" />
            <text class="menu-item-text" :class="layout.isWide ? 'menu-item-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">选择排序方式</text>
          </view>
          <view class="menu-item" :class="layout.isWide ? 'menu-item-wide' : ''" @click="onMenuItem('syssound')">
            <QtIcon name="sliders" :size="layout.isWide ? 14 : 26" :color="theme.skin.text" />
            <text class="menu-item-text" :class="layout.isWide ? 'menu-item-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">包含系统音</text>
            <view class="menu-item-flag" :class="layout.isWide ? 'menu-item-flag-wide' : ''">
              <QtIcon v-if="includeSystemSounds" name="check" :size="layout.isWide ? 14 : 26" :color="theme.skin.accent" />
            </view>
          </view>
          <view class="menu-item" :class="layout.isWide ? 'menu-item-wide' : ''" @click="onMenuItem('delmode')">
            <QtIcon name="settings" :size="layout.isWide ? 14 : 26" :color="theme.skin.text" />
            <text class="menu-item-text" :class="layout.isWide ? 'menu-item-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">删除设置</text>
          </view>
          <view class="menu-item" :class="layout.isWide ? 'menu-item-wide' : ''" @click="onMenuItem('select')">
            <QtIcon name="trash" :size="layout.isWide ? 14 : 26" :color="theme.skin.text" />
            <text class="menu-item-text" :class="layout.isWide ? 'menu-item-text-wide' : ''" :style="('color:' + theme.skin.text + ';') + qtFontDual(26, 14)">批量删除</text>
          </view>
        </view>
      </template>
    </view>
  </qt-page-frame>
</template>
<script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import { qtConfirm } from "@/services/confirm";
import { qtShowActionSheet } from "@/services/action-sheet";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtSkeletonList from "@/uni_modules/qt-ui/components/qt-skeleton-list/qt-skeleton-list.uvue";
import LocalRow from "@/uni_modules/qt-ui/components/qt-local-row/qt-local-row.uvue";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { ref, computed } from "vue";
import { scanLocalAudio, deleteLocalMedia } from "@/uni_modules/qt-app-native";
import type { LocalAudioItem } from "@/uni_modules/qt-app-native";
import { usePlayerStore } from "@/stores/player";
import type { Song } from "@/types/music";
import { qtTrackPage } from "@/uni_modules/qt-stat";
import { onShow } from "@dcloudio/uni-app";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";
import { useQtSongColumns } from "@/uni_modules/qt-ui/composables/use-qt-song-columns";

const theme = useThemeStore();
const layout = useQtLayout();
const player = usePlayerStore();

// 扫描结果持久化：第二次进入直接展示，不再自动扫描
const STORE_KEY = "qt-local-audio-v1";
// 扫描规则持久化：留空 = 不限制
const RULE_SEC_KEY = "qt-local-rule-min-seconds";
const RULE_SIZE_KEY = "qt-local-rule-min-size-mb";
const MIN_SIZE_BYTES_PER_MB = 1024 * 1024;
// 系统音开关：默认排除铃声/通知/闹钟/录音/应用音效（按目录名判断，见 isSystemSound）
const INCLUDE_SYSTEM_KEY = "qt-local-include-system";
const includeSystemSounds = ref(false);

// 删除歌曲时是否连本地文件一起删（应用内设置：默认只移记录、文件保留）
const DELETE_FILE_KEY = "qt-local-delete-file-v1";
const deleteFileWithSong = ref(false);

/** 删除设置：弹窗二选一（删除歌曲时是否连本地文件一起删），当前项带 ✓ 标记 */
function showDeleteModeSheet(): void {
  const onlyRemove = "删除时仅从列表移除，保留文件";
  const alsoDelete = "删除时同时删除本地文件";
  const items = deleteFileWithSong.value
    ? [onlyRemove, "✓ " + alsoDelete]
    : ["✓ " + onlyRemove, alsoDelete];
  qtShowActionSheet({ title: "删除设置", itemList: items }).then((idx: number) => {
    if (idx != 0 && idx != 1) return;
    deleteFileWithSong.value = idx == 1;
    uni.setStorageSync(DELETE_FILE_KEY, deleteFileWithSong.value);
  });
}

const minSecondsText = ref("");
const minSizeText = ref("");

/** 输入框文本 -> 数值；空/非法/非正数一律视为「不限制」（0） */
function parseRuleValue(text: string): number {
  const t = text.trim();
  if (t.length == 0) return 0;
  const n = parseFloat(t);
  return n > 0 ? n : 0;
}

/**
 * 系统音 / 应用音效的目录特征（小写匹配，路径里出现即视为系统音）。
 *
 * 只能按目录判断，不能信 MediaStore 的 is_music：那个标记是「目录启发式」的产物，
 * Ringtones/ 下的完整歌曲同样是 0，而应用自己的按钮音效常常是 1。
 */
const SYSTEM_PATH_MARKERS: string[] = [
  "/ringtones/",
  "/ringtone/",
  "/notifications/",
  "/alarms/",
  "/recordings/",
  "/cache/",
  "/kugouring/",
  "/android/data/",
  "/android/obb/",
];

/** 是否为系统音（铃声/通知/闹钟/录音/应用音效），用于默认过滤 */
function isSystemSound(it: LocalAudioItem): boolean {
  const p = it.path.toLowerCase();
  for (let i = 0; i < SYSTEM_PATH_MARKERS.length; i++) {
    if (p.indexOf(SYSTEM_PATH_MARKERS[i]) >= 0) return true;
  }
  return false;
}

/**
 * 按扫描规则过滤：默认排除系统音，再按「少于设定时长/体积」过滤。
 * 时长或体积未知（0、老缓存无 size 字段）的条目不参与该项过滤，避免误伤。
 * 开关一开就恢复全量，所以过滤放在页面层，切开关不需要重新扫描。
 */
function applyRule(src: LocalAudioItem[]): LocalAudioItem[] {
  const minSeconds = parseRuleValue(minSecondsText.value);
  const minBytes = parseRuleValue(minSizeText.value) * MIN_SIZE_BYTES_PER_MB;
  const skipSystem = !includeSystemSounds.value;
  if (!skipSystem && minSeconds <= 0 && minBytes <= 0) return src;
  const out: LocalAudioItem[] = [];
  for (let i = 0; i < src.length; i++) {
    const it = src[i];
    if (skipSystem && isSystemSound(it)) continue;
    if (minSeconds > 0 && it.duration > 0 && it.duration < minSeconds) continue;
    const size = it.size != null ? it.size! : 0;
    if (minBytes > 0 && size > 0 && size < minBytes) continue;
    out.push(it);
  }
  return out;
}

function loadRule(): void {
  const sec = uni.getStorageSync(RULE_SEC_KEY) as string;
  if (sec != null && sec.length > 0) minSecondsText.value = sec;
  const size = uni.getStorageSync(RULE_SIZE_KEY) as string;
  if (size != null && size.length > 0) minSizeText.value = size;
}

function onMinSecondsInput(e: InputEvent): void {
  const v = String((e.detail as any).value ?? "");
  minSecondsText.value = v;
  uni.setStorageSync(RULE_SEC_KEY, v);
}

function onMinSizeInput(e: InputEvent): void {
  const v = String((e.detail as any).value ?? "");
  minSizeText.value = v;
  uni.setStorageSync(RULE_SIZE_KEY, v);
}

/** 系统音开关：过滤只在页面层做，切换后立即重算，无需重新扫描 */
function toggleSystemSounds(): void {
  includeSystemSounds.value = !includeSystemSounds.value;
  uni.setStorageSync(INCLUDE_SYSTEM_KEY, includeSystemSounds.value);
  qtShowToast({ title: includeSystemSounds.value ? "已显示系统音" : "已隐藏系统音", icon: "none" });
}

const cardStyle = computed<string>(() =>
  "background-color:" + theme.skin.surface +
  ";border-color:" + theme.skin.border +
  ";box-shadow:0 10rpx 30rpx " + theme.skin.shadow + ";"
);

// onboard = 首次引导；folderPick = 文件夹扫描时勾选目录；list = 展示已收录歌曲
const viewMode = ref<string>("onboard");
const scanning = ref(false);
/** 骨架行数：扫描中占一屏歌曲行，只做占位 */
const SKELETON_ROWS = 6;
const allItems = ref<LocalAudioItem[]>([]);
const pickItems = ref<LocalAudioItem[]>([]);
const checked = ref<string[]>([]);

type FolderEntry = { path: string; name: string; count: number };

function folderOf(path: string): string {
  const cut = path.lastIndexOf("/");
  return cut > 0 ? path.substring(0, cut) : "/";
}

function groupFolders(items: LocalAudioItem[]): FolderEntry[] {
  const map = new Map<string, number>();
  for (let i = 0; i < items.length; i++) {
    const dir = folderOf(items[i].path);
    map.set(dir, (map.get(dir) ?? 0) + 1);
  }
  const list: FolderEntry[] = [];
  map.forEach((count: number, dir: string) => {
    const cut = dir.lastIndexOf("/");
    const name = cut >= 0 && cut < dir.length - 1 ? dir.substring(cut + 1) : dir;
    list.push({ path: dir, name: name, count: count } as FolderEntry);
  });
  list.sort((x: FolderEntry, y: FolderEntry): number => (x.path < y.path ? -1 : x.path > y.path ? 1 : 0));
  return list;
}

/** 导入页待导入条目：规则改动即时反映到目录数量与导入结果，不需要重新扫描 */
const filteredPickItems = computed<LocalAudioItem[]>(() => applyRule(pickItems.value));
const pickFolders = computed<FolderEntry[]>(() => groupFolders(filteredPickItems.value));

/** 已勾选目录下的歌曲数（按规则过滤后） */
const selectedCount = computed<number>(() => {
  let n = 0;
  const pool = filteredPickItems.value;
  for (let i = 0; i < pool.length; i++) {
    if (checked.value.indexOf(folderOf(pool[i].path)) >= 0) n++;
  }
  return n;
});
const pickSummary = computed<string>(() => {
  const hidden = pickItems.value.length - filteredPickItems.value.length;
  let text = "共 " + filteredPickItems.value.length + " 首 · 已选 " + selectedCount.value + " 首";
  if (hidden > 0) text += " · 规则隐藏 " + hidden + " 首";
  return text;
});
const allChecked = computed<boolean>(() => pickFolders.value.length > 0 && checked.value.length >= pickFolders.value.length);

const currentId = computed<string>(() => {
  const cur = player.current;
  return cur != null ? cur.id : "";
});

function isChecked(path: string): boolean {
  return checked.value.indexOf(path) >= 0;
}

/** 按当前扫描规则过滤后的基础列表（规则改完即时生效，无需重新扫描） */
const ruleItems = computed<LocalAudioItem[]>(() => applyRule(allItems.value));

// ---- 搜索 / 排序 / 分类视图 ----
const query = ref<string>("");
const searchOpen = ref<boolean>(false);
const listView = ref<string>("songs");
const sortKey = ref<string>("title");
const sortAsc = ref<boolean>(true);
// 三点下拉菜单开关（自定义浮层，见模板 menu-mask / menu-panel）
const menuOpen = ref<boolean>(false);

const viewOptions: { value: string; label: string }[] = [
  { value: "songs", label: "歌曲" },
  { value: "artists", label: "歌手" },
  { value: "albums", label: "专辑" },
  { value: "folders", label: "文件夹" },
];

const sortOptions: { value: string; name: string }[] = [
  { value: "title", name: "标题" },
  { value: "singer", name: "歌手" },
  { value: "album", name: "专辑" },
  { value: "duration", name: "时长" },
  { value: "size", name: "大小" },
  { value: "mtime", name: "修改时间" },
];

function onQueryInput(e: InputEvent): void {
  query.value = String((e.detail as any).value ?? "");
}

function showSortSheet(): void {
  const names: string[] = [];
  let current = -1;
  for (let i = 0; i < sortOptions.length; i++) {
    names.push(sortOptions[i].name);
    if (sortOptions[i].value == sortKey.value) current = i;
  }
  qtShowActionSheet({ title: "排序方式", itemList: names, selectedIndex: current }).then((idx: number) => {
    if (idx < 0 || idx >= sortOptions.length) return;
    sortKey.value = sortOptions[idx].value;
  });
}

/** 标题行放大镜：展开/收起搜索行；收起时清空关键词，列表恢复全量 */
function toggleSearch(): void {
  searchOpen.value = !searchOpen.value;
  if (!searchOpen.value) query.value = "";
}

/** 右上角三点下拉菜单：重新扫描 / 导入配置 / 选择排序方式 / 包含系统音 / 删除设置 / 批量删除 */
function onMenuItem(kind: string): void {
  menuOpen.value = false;
  if (kind == "rescan") startScan("all");
  else if (kind == "folder") startScan("folder");
  else if (kind == "sort") showSortSheet();
  else if (kind == "syssound") toggleSystemSounds();
  else if (kind == "delmode") showDeleteModeSheet();
  else if (kind == "select") toggleSelect();
}

function toggleSortDir(): void {
  sortAsc.value = !sortAsc.value;
}

function sortCompare(a: LocalAudioItem, b: LocalAudioItem): number {
  let r = 0;
  switch (sortKey.value) {
    case "singer":
      r = a.singer.localeCompare(b.singer, "zh-Hans-CN");
      if (r == 0) r = a.title.localeCompare(b.title, "zh-Hans-CN");
      break;
    case "album":
      r = a.album.localeCompare(b.album, "zh-Hans-CN");
      if (r == 0) r = a.title.localeCompare(b.title, "zh-Hans-CN");
      break;
    case "duration":
      r = a.duration - b.duration;
      break;
    case "size":
      r = (a.size ?? 0) - (b.size ?? 0);
      break;
    case "mtime":
      r = (a.mtime ?? 0) - (b.mtime ?? 0);
      break;
    default:
      r = a.title.localeCompare(b.title, "zh-Hans-CN");
  }
  return sortAsc.value ? r : -r;
}

/** 规则过滤 -> 搜索 -> 排序 后的展示列表（全部播放也用这份） */
const filteredItems = computed<LocalAudioItem[]>(() => {
  const q = query.value.trim().toLowerCase();
  let list = ruleItems.value;
  if (q.length > 0) {
    const out: LocalAudioItem[] = [];
    for (let i = 0; i < list.length; i++) {
      const it = list[i];
      if (
        it.title.toLowerCase().indexOf(q) >= 0 ||
        (it.singer.length > 0 && it.singer.toLowerCase().indexOf(q) >= 0) ||
        (it.album.length > 0 && it.album.toLowerCase().indexOf(q) >= 0)
      ) {
        out.push(it);
      }
    }
    list = out;
  }
  const sorted = [...list];
  sorted.sort(sortCompare);
  return sorted;
});

/**
 * 宽屏「一行两首」的列切分。pagePadPx 传 26，必须与 .page-wide 的左右 padding 一致，
 * 否则算出的 cell 宽会比真实可用宽度多几像素，右列被裁。
 *
 * 这里没有复用 qtSongPairs：那个函数按 platform+id 生成 key，而 LocalAudioItem 没有
 * platform 字段（本地文件本来就不属于任何平台）。本地列表的 id 已是稳定唯一键。
 */
const { twoColumn, cellStyle, rightCellStyle } = useQtSongColumns(26, "list");

type LocalPair = { key: string; left: LocalAudioItem; right: LocalAudioItem; hasRight: boolean };

const pairs = computed<LocalPair[]>(() => {
  const src = filteredItems.value;
  const out: LocalPair[] = [];
  if (!twoColumn.value) {
    // 单列：一条一行，right 用 left 兜底（模板里对可空值做判断在 UTS 模板层不稳）
    for (let i = 0; i < src.length; i++) {
      out.push({ key: src[i].id, left: src[i], right: src[i], hasRight: false });
    }
    return out;
  }
  let i = 0;
  while (i < src.length) {
    const has = i + 1 < src.length;
    out.push({ key: src[i].id, left: src[i], right: has ? src[i + 1] : src[i], hasRight: has });
    i += 2;
  }
  return out;
});

type LocalGroup = { name: string; list: LocalAudioItem[] };

/** 分类视图（歌手 / 专辑 / 文件夹）分组 */
const groups = computed<LocalGroup[]>(() => {
  if (listView.value == "songs") return [];
  const keyOf = (t: LocalAudioItem): string => {
    if (listView.value == "artists") return t.singer.length > 0 ? t.singer : "未知歌手";
    if (listView.value == "albums") return t.album.length > 0 ? t.album : "未知专辑";
    return folderOf(t.path);
  };
  const map = new Map<string, LocalAudioItem[]>();
  const list = filteredItems.value;
  for (let i = 0; i < list.length; i++) {
    const k = keyOf(list[i]);
    const arr = map.get(k);
    if (arr != null) arr.push(list[i]);
    else map.set(k, [list[i]]);
  }
  const names: string[] = [];
  map.forEach((_v: LocalAudioItem[], k: string) => {
    names.push(k);
  });
  names.sort((x: string, y: string): number => x.localeCompare(y, "zh-Hans-CN"));
  const out: LocalGroup[] = [];
  for (let i = 0; i < names.length; i++) out.push({ name: names[i], list: map.get(names[i])! });
  return out;
});

// ---- 批量删除（从本地音乐移除记录，不删除手机里的源文件） ----
const selecting = ref<boolean>(false);
const selected = ref<string[]>([]);

function isSel(id: string): boolean {
  return selected.value.indexOf(id) >= 0;
}

const allSel = computed<boolean>(
  () => filteredItems.value.length > 0 && selected.value.length >= filteredItems.value.length,
);

function toggleSelect(): void {
  selecting.value = !selecting.value;
  if (!selecting.value) selected.value = [];
}

function toggleSelectAll(): void {
  if (allSel.value) {
    selected.value = [];
  } else {
    const ids: string[] = [];
    const list = filteredItems.value;
    for (let i = 0; i < list.length; i++) ids.push(list[i].id);
    selected.value = ids;
  }
}

function onRowTap(item: LocalAudioItem): void {
  if (selecting.value) {
    if (isSel(item.id)) {
      selected.value = selected.value.filter((id: string): boolean => id != item.id);
    } else {
      selected.value = [...selected.value, item.id];
    }
    return;
  }
  play(item);
}

function confirmBatchDelete(): void {
  if (selected.value.length == 0) return;
  const delFile = deleteFileWithSong.value;
  const removed: LocalAudioItem[] = [];
  const keep: LocalAudioItem[] = [];
  for (let i = 0; i < allItems.value.length; i++) {
    const it = allItems.value[i];
    if (selected.value.indexOf(it.id) < 0) keep.push(it);
    else removed.push(it);
  }
  // 只移除记录时保持原有“无确认直接删”的轻量交互；要删本地文件时先确认，避免误删
  if (!delFile) {
    commitBatchDelete(keep, removed, false);
    return;
  }
    qtConfirm({
    title: "删除歌曲",
    content: "将删除选中的 " + removed.length + " 首歌曲，并在手机上删除其本地文件？",
    confirmText: "删除",
    danger: true,
  }).then((ok: boolean) => {
      if (ok) commitBatchDelete(keep, removed, true);
  });
}

function commitBatchDelete(keep: LocalAudioItem[], removed: LocalAudioItem[], delFile: boolean): void {
  if (delFile) {
    const r = deleteLocalMedia(removed);
    if (r.pending > 0) {
      // 需开通「所有文件访问」才能删第三方文件：保留记录，用户开通后可重试
      qtShowToast({ title: "请开启「所有文件访问」后重试", icon: "none" });
      selected.value = [];
      selecting.value = false;
      return;
    }
    saveItems(keep);
    if (r.failed == 0) qtShowToast({ title: "已删除 " + r.deleted + " 首（含本地文件）", icon: "none" });
    else qtShowToast({ title: "已删除 " + r.deleted + " 首，" + r.failed + " 个文件未能删除", icon: "none" });
  } else {
    saveItems(keep);
    qtShowToast({ title: "已移除 " + removed.length + " 首", icon: "none" });
  }
  selected.value = [];
  selecting.value = false;
}

/** 行尾三点：单曲操作。@click.stop 阻止冒泡，避免触发整行播放 */
function onRowMore(item: LocalAudioItem): void {
  qtShowActionSheet({ itemList: ["播放", "移除"] }).then((idx: number) => {
    if (idx == 0) play(item);
    else if (idx == 1) removeOne(item);
  });
}

/** 单曲移除：受「删除时同时删除本地文件」开关控制——开则连源文件一起删（尽力而为） */
function removeOne(item: LocalAudioItem): void {
  const delFile = deleteFileWithSong.value;
    qtConfirm({
    title: "移除歌曲",
    content: delFile
      ? "将「" + item.title + "」从本地音乐移除，并删除手机上的本地文件？"
      : "将「" + item.title + "」从本地音乐中移除？",
    confirmText: delFile ? "删除" : "移除",
    danger: true,
  }).then((ok: boolean) => {
      if (ok) {
        if (delFile) {
          const r = deleteLocalMedia([item]);
          if (r.pending > 0) {
            // 需开通「所有文件访问」才能删第三方文件：保留记录，用户开通后可重试
            qtShowToast({ title: "需开启「所有文件访问」后重试删除", icon: "none" });
          } else {
            saveItems(allItems.value.filter((it: LocalAudioItem): boolean => it.id != item.id));
            if (r.deleted > 0) qtShowToast({ title: "已删除，含本地文件", icon: "none" });
            else qtShowToast({ title: "已移除，但未能删除文件", icon: "none" });
          }
        } else {
          saveItems(allItems.value.filter((it: LocalAudioItem): boolean => it.id != item.id));
          qtShowToast({ title: "已移除", icon: "none" });
        }
      }
  });
}

/** 行副标题只留 歌手 · 专辑：时长右对齐单独展示，文件大小是库管理信息不再占行 */
function rowMeta(item: LocalAudioItem): string {
  let t = item.singer.length > 0 ? item.singer : "未知歌手";
  if (item.album.length > 0) t += " · " + item.album;
  // 打开了「包含系统音」时，把这类条目标出来，避免列表里突然多出铃声/提示音却没有解释
  if (includeSystemSounds.value && isSystemSound(item)) t += " · 系统音";
  return t;
};

function formatDuration(total: number): string {
  const sec = total > 0 ? Math.floor(total) : 0;
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  return m + ":" + (s < 10 ? "0" : "") + s;
}

function loadSaved(): void {
  const raw = uni.getStorageSync(STORE_KEY);
  if (raw == null || raw == "") return;
  const arr = raw as LocalAudioItem[];
  if (!Array.isArray(arr)) return;
  allItems.value = arr;
}

function saveItems(items: LocalAudioItem[]): void {
  allItems.value = items;
  uni.setStorageSync(STORE_KEY, items);
}

/**
 * kind = "all" 全盘扫描直接收录；kind = "folder" 扫描后先勾选目录再导入。
 * 权限申请在 scanLocalAudio 内部处理（拒绝时回调空列表）。
 */
function startScan(kind: string): void {
  if (scanning.value) return;
  scanning.value = true;
  scanLocalAudio((items: LocalAudioItem[]) => {
    scanning.value = false;
    if (items.length == 0) {
      qtShowToast({ title: "未在手机上找到音频文件", icon: "none" });
      return;
    }
    if (kind == "folder") {
      // 保留全量：扫描规则在导入页配置并即时过滤，放宽规则无需重新扫描
      pickItems.value = items;
      const paths: string[] = [];
      const folders = groupFolders(items);
      for (let i = 0; i < folders.length; i++) paths.push(folders[i].path);
      checked.value = paths;
      viewMode.value = "folderPick";
    } else {
      // 全盘扫描：保存全量，展示按规则过滤（改规则即时生效）
      saveItems(items);
      viewMode.value = "list";
    }
  });
}

function toggleFolder(path: string): void {
  if (isChecked(path)) {
    checked.value = checked.value.filter((p: string): boolean => p != path);
  } else {
    checked.value = [...checked.value, path];
  }
}

function toggleAll(): void {
  if (allChecked.value) {
    checked.value = [];
  } else {
    const paths: string[] = [];
    const folders = pickFolders.value;
    for (let i = 0; i < folders.length; i++) paths.push(folders[i].path);
    checked.value = paths;
  }
}

function confirmImport(): void {
  // 按导入页当前规则过滤后导入：规则改动即时生效，无需重新扫描
  const pool = filteredPickItems.value;
  if (pool.length == 0) {
    qtShowToast({ title: "当前规则下没有可导入的歌曲", icon: "none" });
    return;
  }
  const picked: LocalAudioItem[] = [];
  for (let i = 0; i < pool.length; i++) {
    const it = pool[i];
    if (checked.value.indexOf(folderOf(it.path)) >= 0) picked.push(it);
  }
  if (picked.length == 0) {
    qtShowToast({ title: "请至少选择一个文件夹", icon: "none" });
    return;
  }
  saveItems(picked);
  viewMode.value = "list";
  qtShowToast({ title: "已收录 " + picked.length + " 首本地歌曲", icon: "none" });
}

/** 本地音频条目 -> 播放用歌曲：直接用 content:// 地址播放，不走在线取址 */
function toSong(item: LocalAudioItem): Song {
  return {
    id: item.id,
    name: item.title,
    singer: item.singer,
    album: item.album,
    picUrl: "",
    platform: "local",
    duration: item.duration,
    url: item.uri,
  } as Song;
}

function play(item: LocalAudioItem): void {
  player.playSingle(toSong(item));
}

/** 全部播放：用当前展示列表（已按规则过滤）整体替换播放队列，从第一首开始 */
async function playAll(): Promise<void> {
  const list = filteredItems.value;
  if (list.length == 0) return;
  const songs: Song[] = [];
  for (let i = 0; i < list.length; i++) songs.push(toSong(list[i]));
  try {
    await player.play(songs[0], songs);
  } catch (_) {
    qtShowToast({ title: "暂时无法播放全部", icon: "none" });
  }
}

onShow(() => {
  qtTrackPage("pages/local/index");
  // 扫描中 / 勾选目录时不要打断当前流程
  if (scanning.value || viewMode.value == "folderPick") return;
  deleteFileWithSong.value = uni.getStorageSync(DELETE_FILE_KEY) === true;
  includeSystemSounds.value = uni.getStorageSync(INCLUDE_SYSTEM_KEY) === true;
  loadRule();
  loadSaved();
  viewMode.value = allItems.value.length > 0 ? "list" : "onboard";
});
</script>
