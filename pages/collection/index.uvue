<template>
  <qt-page-frame width-kind="grid">
    <view class="page" :class="layout.isWide ? 'page-wide' : ''">
      <!-- 歌单区标题 + 操作 -->
      <view class="pl-head" :class="layout.isWide ? 'pl-head-wide' : ''">
          <view class="pl-head-copy">
            <text class="pl-kicker" :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(21, 12)">COLLECTION</text>
            <view class="pl-head-title-row">
              <text class="pl-head-title" :class="layout.isWide ? 'pl-head-title-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(36, 24)">我的收藏歌单</text>
              <view v-if="allPlaylists.length > 0" class="pl-count-pill" :class="layout.isWide ? 'pl-count-pill-wide' : ''" :style="chipStyle">
                <text class="pl-count-text" :class="layout.isWide ? 'pl-count-text-wide' : ''" :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(24, 14)">{{ allPlaylists.length }}</text>
              </view>
            </view>
          </view>
          <view class="pl-actions">
            <view class="import-btn" :class="layout.isWide ? 'import-btn-wide' : ''" :style="ghostBtnStyle" @click="goImport">
              <QtIcon name="download" :size="layout.isWide ? 14 : 22" :color="themeStore.skin.iconMuted" />
              <text class="import-btn-text" :class="layout.isWide ? 'import-btn-text-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(23, 13)">导入</text>
            </view>
            <view class="create-btn" :class="layout.isWide ? 'create-btn-wide' : ''" :style="'background-color:' + themeStore.skin.accent + ';'" @click="createPlaylist">
              <QtIcon name="folder" :size="layout.isWide ? 14 : 22" :color="themeStore.skin.onAccent" />
              <text class="create-btn-text" :class="layout.isWide ? 'create-btn-text-wide' : ''" :style="('color:' + themeStore.skin.onAccent + ';') + qtFontDual(23, 13)">新建</text>
            </view>
          </view>
        </view>

        <!-- 所有歌单合并（自建 + 收藏） -->
      <scroll-view class="list" direction="vertical" :scroll-top="scrollTop" @scroll="onListScroll">
          <view v-if="allPlaylists.length > 0" class="pl-grid">
            <view
              v-for="pl in allPlaylists"
              :key="pl.id + pl.platform"
              class="pl-item" :class="layout.isWide ? 'pl-item-wide' : ''"
              :style="plItemStyle"
              :hover-class="layout.isWide ? 'pl-item-hover' : 'none'"
              @click="openPlaylist(pl)"
              @longpress="onPlaylistLongPress(pl)"
            >
              <view class="pl-cover-wrap" :class="layout.isWide ? 'pl-cover-wrap-wide' : ''" :style="plCoverStyle">
                <image v-if="pl.picUrl.length > 0" class="pl-cover" :class="layout.isWide ? 'pl-cover-wide' : ''" :style="plCoverStyle" :src="pl.picUrl" mode="aspectFill" />
                <image v-else class="pl-cover" :class="layout.isWide ? 'pl-cover-wide' : ''" :style="plCoverStyle" :src="DEFAULT_PLAYLIST_COVER_ASSET" mode="aspectFill" />
                <view
                  class="pl-badge" :class="layout.isWide ? 'pl-badge-wide' : ''"
                  :style="'background-color:' + (pl.platform === 'local' ? '#8b93a7' : platformColor(pl.platform))"
                >
                  <text class="pl-badge-text" :class="layout.isWide ? 'pl-badge-text-wide' : ''" :style="qtFontDual(22, 12)">{{ pl.platform === 'local' ? '本地' : platformShort(pl.platform) }}</text>
                </view>
                <view
                  v-if="isDefaultFav(pl)"
                  class="pl-fav-badge" :class="layout.isWide ? 'pl-fav-badge-wide' : ''"
                  :style="'background-color:' + themeStore.skin.accent"
                >
                  <QtIcon name="heart-fill" :size="layout.isWide ? 13 : 24" :color="themeStore.skin.onAccent" />
                </view>
              </view>
              <text class="pl-name" :class="layout.isWide ? 'pl-name-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(28, 16)" :max-lines="2">{{ pl.name }}</text>
            </view>
          </view>
          <view v-else class="empty" :class="layout.isWide ? 'empty-wide' : ''">
            <view class="empty-chip" :class="layout.isWide ? 'empty-chip-wide' : ''" :style="chipStyle">
              <QtIcon name="heart" :size="layout.isWide ? 36 : 64" :color="themeStore.skin.accent" />
            </view>
            <text class="empty-text" :class="layout.isWide ? 'empty-text-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(32, 20)">还没有收藏歌单</text>
            <text class="empty-sub" :class="layout.isWide ? 'empty-sub-wide' : ''" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(24, 14)">在发现页找到喜欢的歌单，点收藏即可出现在这里</text>
            <view class="empty-actions">
              <view class="empty-ghost" :class="layout.isWide ? 'empty-ghost-wide' : ''" :style="ghostBtnStyle" @click="createPlaylist">
                <QtIcon name="folder" :size="layout.isWide ? 16 : 28" :color="themeStore.skin.text" />
                <text class="empty-ghost-text" :class="layout.isWide ? 'empty-ghost-text-wide' : ''" :style="('color:' + themeStore.skin.text + ';') + qtFontDual(28, 16)">新建歌单</text>
              </view>
              <view class="empty-primary" :class="layout.isWide ? 'empty-primary-wide' : ''" :style="'background-color:' + themeStore.skin.accent + ';'" @click="discover">
                <QtIcon name="compass" :size="layout.isWide ? 16 : 28" :color="themeStore.skin.onAccent" />
                <text class="empty-primary-text" :class="layout.isWide ? 'empty-primary-text-wide' : ''" :style="('color:' + themeStore.skin.onAccent + ';') + qtFontDual(28, 16)">去发现音乐</text>
              </view>
            </view>
          </view>
        </scroll-view>
      <QtBackToTop :visible="showBackToTop" @tap="backToTop" />
    </view>
  <!-- 新建歌单：页内输入弹层（uni.showModal 的 editable 在 App 端不出输入框） -->
  <!-- 新建 / 重命名共用一个页内输入弹层：uni.showModal 的 editable 在 App 端不出输入框，
       所以「起名/改名」只能在页内做。两种模式只差标题、按钮文案与提交后的落点。 -->
  <QtSheet v-model:visible="sheetVisible" :title="sheetTitle" :subtitle="sheetSubtitle" @close="closeSheet">
    <view class="cs-body" :class="layout.isWide ? 'cs-body-wide' : ''">
      <input
        class="cs-input"
        :class="layout.isWide ? 'cs-input-wide' : ''"
        :style="csInputStyle"
        :value="sheetValue"
        @input="onSheetInput"
        placeholder="请输入歌单名称"
        :placeholder-class="layout.isWide ? 'cs-ph-wide' : 'cs-ph'"
        :maxlength="40"
        :focus="sheetVisible"
      />
      <text v-if="sheetError.length > 0" class="cs-error" :class="layout.isWide ? 'cs-error-wide' : ''" :style="('color:' + themeStore.skin.danger + ';') + qtFontDual(22, 12)">{{ sheetError }}</text>
      <view class="cs-btn-row" :class="layout.isWide ? 'cs-btn-row-wide' : ''">
        <view class="cs-btn" :class="layout.isWide ? 'cs-btn-wide' : ''" @click="closeSheet">
          <text class="cs-btn-text" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(28, 15)">取消</text>
        </view>
        <view class="cs-btn" :class="layout.isWide ? 'cs-btn-wide' : ''" @click="submitSheet">
          <text class="cs-btn-text" :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(28, 15)">{{ sheetConfirmText }}</text>
        </view>
      </view>
    </view>
  </QtSheet>
  <!-- 编辑歌单封面：选图 -> 直传存储端 -> 服务端 complete 回执直接写库并推进同步 seq -->
  <QtSheet
    v-model:visible="coverVisible"
    title="编辑歌单封面"
    :subtitle="coverSubtitle"
    :dismissible="!coverBusy"
    @close="closeCoverSheet"
  >
    <view class="cv-body" :class="layout.isWide ? 'cv-body-wide' : ''">
      <view class="cv-preview-row" :class="layout.isWide ? 'cv-preview-row-wide' : ''">
        <image
          class="cv-preview" :class="layout.isWide ? 'cv-preview-wide' : ''"
          :src="coverPreview" mode="aspectFill"
        />
      </view>
      <text
        class="cv-hint" :class="layout.isWide ? 'cv-hint-wide' : ''"
        :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(22, 12)"
      >{{ coverHasCustom ? '当前是自定义封面' : '当前是默认封面，可上传一张自定义封面' }}</text>
      <text v-if="coverError.length > 0" class="cs-error" :class="layout.isWide ? 'cs-error-wide' : ''" :style="('color:' + themeStore.skin.danger + ';') + qtFontDual(22, 12)">{{ coverError }}</text>
      <view class="cs-btn-row" :class="layout.isWide ? 'cs-btn-row-wide' : ''">
        <view v-if="coverHasCustom" class="cs-btn" :class="layout.isWide ? 'cs-btn-wide' : ''" @click="resetCover">
          <text class="cs-btn-text" :style="('color:' + themeStore.skin.textMuted + ';') + qtFontDual(28, 15)">恢复默认</text>
        </view>
        <view class="cs-btn" :class="layout.isWide ? 'cs-btn-wide' : ''" @click="pickCover">
          <text class="cs-btn-text" :style="('color:' + themeStore.skin.accent + ';') + qtFontDual(28, 15)">{{ coverBusy ? '处理中...' : '从相册选择' }}</text>
        </view>
      </view>
    </view>
  </QtSheet>
  </qt-page-frame>
</template><script setup lang="ts">
import { qtShowToast } from "@/services/toast";
import { qtShowActionSheet } from "@/services/action-sheet";
import QtPageFrame from "@/uni_modules/qt-ui/components/qt-page-frame/qt-page-frame.uvue";
import { computed, ref } from "vue";
import QtIcon from "@/uni_modules/qt-ui/components/qt-icon/qt-icon.uvue";
import QtSheet from "@/uni_modules/qt-ui/components/qt-sheet/qt-sheet.uvue";
import QtBackToTop from "@/uni_modules/qt-ui/components/qt-back-to-top/qt-back-to-top.uvue";
import { useThemeStore } from "@/uni_modules/qt-ui/stores/theme";
import { usePlayerStore } from "@/stores/player";
import { useQtLayout } from "@/uni_modules/qt-ui/composables/use-qt-layout";
import { qtContentWidth, qtColumnCount, QT_MIN_COLUMN_WIDTH } from "@/uni_modules/qt-ui/composables/use-qt-widths";
import { platformShort, platformColor } from "@/services/platform";
import { DEFAULT_PLAYLIST_COVER_ASSET, chooseImage, uploadPlaylistCover, clearPlaylistCover } from "@/services/media";
import { beginLoading, finishLoading } from "@/services/ui-loading";
import { qtFontDual } from "@/uni_modules/qt-ui/stores/font-scale";
import { qtSwitchTab } from "@/uni_modules/qt-ui/composables/qt-nav";

const player = usePlayerStore();
const themeStore = useThemeStore();
const layout = useQtLayout();

const chipStyle = computed<string>(() => "background-color:" + themeStore.skin.accentSoft + ";");
const ghostBtnStyle = computed<string>(() =>
  "background-color:" + themeStore.skin.surfaceMuted + ";border-color:" + themeStore.skin.border + ";"
);

// 回到顶部
const scrollTop = ref(0);
const showBackToTop = ref(false);
function onListScroll(e: any) {
  const st = e.detail != null ? Number(e.detail.scrollTop ?? 0) : 0;
  showBackToTop.value = st > 600;
}
function backToTop() {
  scrollTop.value = scrollTop.value == 0 ? 1 : 0;
  showBackToTop.value = false;
}
const allPlaylists = computed(() => {
  const locals = player.localPlaylists.map(p => ({ ...p, picUrl: player.playlistDisplayPic(p), isLocal: true }));
  const saveds = player.savedPlaylists.map(p => ({ ...p, picUrl: player.playlistDisplayPic(p), isLocal: false }));
  return [...locals, ...saveds];
});

/** 栅格可用宽（px）：宽屏取内容列宽减左右 26px 内边距，手机按 750 基准折算 */
const plInnerWidth = computed<number>((): number => {
  const win = layout.windowWidth;
  return layout.isWide ? qtContentWidth("grid") - 52 : win - win * (48 / 750);
});
/**
 * 宽屏列数按「最小卡宽」推导，不再写死 4 列。
 * 改造前是 isWide 固定 4 列 + 卡宽上限 226px：1920px 窗口里四张 226px 的卡靠左叠放，
 * 右侧空出近 500px，而内容列本身还被旧 qt-page-frame 拉到 1360。
 */
const plCols = computed<number>((): number => {
  if (!layout.isWide) return 3;
  return qtColumnCount(plInnerWidth.value, QT_MIN_COLUMN_WIDTH.card, 20, 8);
});
/**
 * 歌单卡宽（inline px，随窗口实时缩放）：手机端三列起，卡宽 < 92px 退化两列。
 */
const plCardWidth = computed<number>(() => {
  const win = layout.windowWidth;
  if (!layout.isWide) {
    const inner = win - win * (48 / 750);
    const gap = win * (14 / 750);
    const three = Math.floor((inner - gap * 3) / 3);
    const two = Math.floor((inner - gap * 2) / 2);
    return three >= 92 ? three : two;
  }
  const cols = plCols.value;
  const w = Math.floor((plInnerWidth.value - 20 * cols) / cols);
  // 上限 260：再宽封面就成了主角，歌单名反而被挤成两行
  return w > 260 ? 260 : w;
});
const plItemStyle = computed<string>(() => "width:" + plCardWidth.value + "px;");
const plCoverStyle = computed<string>(() => "width:" + plCardWidth.value + "px;height:" + plCardWidth.value + "px;");

// 当前生效的默认收藏歌单（通知栏 ♡ 的收藏目标）：显式设置优先，未设置时回落第一个自建歌单。
// 用 computed 跟随 store 变化（歌单增删 / 长按改设置），模板里据此给歌单打标。
const defaultFavId = computed<string>(() => {
  const pl = player.defaultFavPlaylist();
  return pl != null ? pl.id : "";
});
function isDefaultFav(pl: { id: string; platform: string }): boolean {
  return pl.platform === "local" && pl.id === defaultFavId.value;
}

function openPlaylist(pl: { id: string; platform: string }): void {
  uni.navigateTo({
    url:
      "/pages/playlist/index?id=" +
      encodeURIComponent(pl.id) +
      "&platform=" +
      encodeURIComponent(pl.platform) +
      "&type=playlist",
  });
}

// 长按歌单：仅自建歌单有操作。除默认收藏目标外，进「修改歌单信息」可改名称与封面；
// 收藏的在线歌单仍不提供长按操作（2026-11-01 用户定案：原「长按换封面」在手机端
// 整体删除；服务端歌单行仍带 pic_url，收藏/重放会照常展示）。
function onPlaylistLongPress(pl: { id: string; name: string; platform: string }): void {
  if (pl.platform !== "local") return;
  // 自建歌单含本机新建及其他设备同步回来的 platform=local 条目；两者都可编辑。
  // 通知栏/车机的收藏 ♡ 收进默认歌单；未显式设置时默认取第一个自建歌单。
  const isExplicit = player.defaultFavPlaylistId.length > 0 && player.defaultFavPlaylistId === pl.id;
  const items: string[] = ["修改歌单信息", isExplicit ? "取消默认收藏歌单" : "设为默认收藏歌单"];
  qtShowActionSheet({ itemList: items }).then((idx: number) => {
    if (idx === 0) {
      openInfoMenu(pl);
      return;
    }
    if (idx !== 1) return;
    if (isExplicit) {
      player.setDefaultFavPlaylist("");
      qtShowToast({ title: "已取消设置，通知栏收藏回到第一个自建歌单", icon: "none" });
    } else {
      player.setDefaultFavPlaylist(pl.id);
      qtShowToast({ title: "已设为默认收藏歌单，通知栏收藏将收进这里", icon: "none" });
    }
  });
}

/**
 * 二级菜单「修改歌单信息」：两项都要落到服务端数据库 ——
 * 名称走 playlist/add 的按 pid upsert（服务端 name 覆盖旧值并推进同步 seq），
 * 封面走封面上传链路（complete 阶段服务端直接写 qt_like_playlist.pic_url）。
 */
function openInfoMenu(pl: { id: string; name: string }): void {
  qtShowActionSheet({ title: pl.name, itemList: ["编辑歌单名称", "编辑歌单封面"] }).then((idx: number) => {
    if (idx === 0) {
      openRenameSheet(pl);
      return;
    }
    if (idx === 1) openCoverSheet(pl);
  });
}
function discover() {
  qtSwitchTab("/pages/home/index");
}

/**
 * 新建/改名共用输入弹层：原生 showModal 的 editable 在 App 端不出输入框。
 * 两个动作共用同一套输入、校验样式；改名会预填现有名字，保存时才改动 store。
 */
const sheetVisible = ref(false);
const sheetValue = ref("");
const sheetError = ref("");
const sheetMode = ref<"create" | "rename">("create");
let renameTargetId = "";
const sheetTitle = computed<string>(() => sheetMode.value === "rename" ? "编辑歌单名称" : "新建歌单");
const sheetSubtitle = computed<string>(() =>
  sheetMode.value === "rename" ? "改的是服务器上的歌单名，歌曲和封面不会变" : "给新歌单起个名字，之后可以把喜欢的歌拷进来"
);
const sheetConfirmText = computed<string>(() => sheetMode.value === "rename" ? "保存" : "创建");
const csInputStyle = computed<string>(() => "background-color:" + themeStore.skin.surfaceInset + ";color:" + themeStore.skin.text + ";border-radius:14rpx;");

function createPlaylist(): void {
  sheetMode.value = "create";
  renameTargetId = "";
  sheetValue.value = "";
  sheetError.value = "";
  sheetVisible.value = true;
}

function openRenameSheet(pl: { id: string; name: string }): void {
  sheetMode.value = "rename";
  renameTargetId = pl.id;
  sheetValue.value = pl.name;
  sheetError.value = "";
  sheetVisible.value = true;
}

function closeSheet(): void {
  sheetVisible.value = false;
}

function onSheetInput(e: InputEvent): void {
  sheetValue.value = e.detail.value;
  if (sheetError.value.length > 0) sheetError.value = "";
}

/** 提交：空名/重名留在弹层红字提示，成功才关闭并给出结果。 */
function submitSheet(): void {
  const name = sheetValue.value.trim();
  if (sheetMode.value === "rename") {
    const error = player.renameLocalPlaylist(renameTargetId, name);
    if (error.length > 0) {
      sheetError.value = error;
      return;
    }
    sheetVisible.value = false;
    qtShowToast({ title: "已重命名歌单", icon: "none" });
    return;
  }
  if (name.length === 0) {
    sheetError.value = "歌单名称不能为空";
    return;
  }
  const created = player.createLocalPlaylist(name);
  if (created == null) {
    sheetError.value = "该歌单名称已存在";
    return;
  }
  sheetVisible.value = false;
  qtShowToast({ title: "已创建歌单", icon: "none" });
}

/**
 * 封面编辑：选图 → 直传存储端 → complete 回执由服务端直接把 URL 写进
 * `qt_like_playlist.pic_url` 并推进同步 seq。也就是说这里拿到的 URL 已经是库里的值，
 * 本地只做缓存同步（不补推 playlist/add，见 player.setPlaylistCover 注释）。
 * 「恢复默认封面」走 DELETE 接口把 pic_url 置空，不占每日上传次数。
 */
const coverVisible = ref(false);
const coverBusy = ref(false);
const coverError = ref("");
const coverName = ref("");
const coverStored = ref("");
let coverTargetId = "";
const coverPreview = computed<string>(() => coverStored.value.length > 0 ? coverStored.value : DEFAULT_PLAYLIST_COVER_ASSET);
const coverSubtitle = computed<string>(() =>
  coverName.value.length > 0 ? coverName.value + " · 保存后同步到其他设备" : "保存后同步到其他设备"
);

/** 与 playlistDisplayPic 同口径：这几个占位值都不算「自定义封面」 */
function hasCustomCover(url: string): boolean {
  if (url.length === 0) return false;
  return url !== DEFAULT_PLAYLIST_COVER_ASSET && url !== "/static/logo.png" && url !== "/static/qt-media/default-playlist-cover.png";
}
const coverHasCustom = computed<boolean>(() => hasCustomCover(coverStored.value));

function openCoverSheet(pl: { id: string; name: string }): void {
  coverTargetId = pl.id;
  coverName.value = pl.name;
  coverStored.value = player.playlistCoverOf(pl.id);
  coverError.value = "";
  coverBusy.value = false;
  coverVisible.value = true;
}

function closeCoverSheet(): void {
  // 上传中不允许点遮罩/关闭：结果（成功或失败文案）必须让用户看见一次
  if (coverBusy.value) return;
  coverVisible.value = false;
}

/** 服务端按 pid + platform 定位收藏行；本地条目可能只有 id，pid 兜底成 id */
function coverPid(): string {
  const pid = player.editablePlaylistPidOf(coverTargetId);
  return pid.length > 0 ? pid : coverTargetId;
}

async function pickCover(): Promise<void> {
  if (coverBusy.value) return;
  // 必须在 await 之前占住 busy：chooseImage 是系统选图器，等待期间再点一次
  // 会叠开第二个选图器（两个回调各自上传，谁后回谁覆盖）—— 2026-11-02 审阅
  coverBusy.value = true;
  coverError.value = "";
  let path = "";
  try {
    path = await chooseImage();
  } catch (_) {
    coverBusy.value = false;
    return; // 用户取消选图，静默返回
  }
  if (path.length == 0) {
    coverBusy.value = false;
    return; // 个别平台取消时给空串而不是抛错
  }
  const token = beginLoading("上传封面...");
  try {
    const url = await uploadPlaylistCover(coverPid(), "local", path);
    const error = player.setPlaylistCover(coverTargetId, url);
    if (error.length > 0) {
      coverError.value = error;
      return;
    }
    coverStored.value = url;
    coverVisible.value = false;
    qtShowToast({ title: "封面已更新", icon: "none" });
  } catch (e) {
    // 失败文案（大小/类型/每日限次/还没同步到服务器）由服务端下发，原样展示
    coverError.value = (e as Error).message || "上传失败";
  } finally {
    finishLoading(token);
    coverBusy.value = false;
  }
}

async function resetCover(): Promise<void> {
  if (coverBusy.value) return;
  coverBusy.value = true;
  coverError.value = "";
  const token = beginLoading("正在恢复...");
  try {
    await clearPlaylistCover(coverPid(), "local");
    const error = player.setPlaylistCover(coverTargetId, "");
    if (error.length > 0) {
      coverError.value = error;
      return;
    }
    coverStored.value = "";
    coverVisible.value = false;
    qtShowToast({ title: "已恢复默认封面", icon: "none" });
  } catch (e) {
    coverError.value = (e as Error).message || "恢复失败";
  } finally {
    finishLoading(token);
    coverBusy.value = false;
  }
}

/** 打开导入页（拷贝歌曲进自建歌单 / 收藏远程歌单，两种方式在页内切换） */
function goImport(): void {
  uni.navigateTo({ url: "/pages/playlist-import/index" });
}
</script>
