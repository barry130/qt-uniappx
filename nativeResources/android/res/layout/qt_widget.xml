<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qt_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/qt_widget_bg"
    android:paddingLeft="10dp"
    android:paddingRight="6dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/qt_cover"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="9dp"
        android:layout_marginRight="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/qt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="轻听音乐" />

        <TextView
            android:id="@+id/qt_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#B3FFFFFF"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="轻听音乐，想听就听" />
    </LinearLayout>

    <ImageView
        android:id="@+id/qt_prev"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_qt_notif_prev" />

    <ImageView
        android:id="@+id/qt_play"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginLeft="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_qt_notif_play" />

    <ImageView
        android:id="@+id/qt_next"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_qt_notif_next" />
</LinearLayout>
