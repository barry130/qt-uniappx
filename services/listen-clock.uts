// #ifdef APP-ANDROID || APP-HARMONY
import { audioMonotonicTime } from "@/uni_modules/qt-audio-player";
// #endif
export function listenClockNow(): number {
  // #ifdef APP-ANDROID || APP-HARMONY
  return audioMonotonicTime();
  // #endif
  // #ifndef APP-ANDROID || APP-HARMONY
  return Date.now();
  // #endif
}
