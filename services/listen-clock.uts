// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
import { audioMonotonicTime } from "@/uni_modules/qt-audio-player";
// #endif
export function listenClockNow(): number {
  // #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
  return audioMonotonicTime();
  // #endif
  // #ifndef APP-ANDROID
  // #ifndef APP-HARMONY
  // #ifndef APP-IOS
  return Date.now();
  // #endif
  // #endif
  // #endif
}
