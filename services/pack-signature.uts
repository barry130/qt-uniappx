/**
 * 官方包 Ed25519 验签。公钥内置于宿主，签名覆盖去除尾部签名块后的 UTF-8 全文。
 * Android 使用原生 Bouncy Castle，Harmony 使用系统密码库；整个过程不执行包代码，
 * 不访问音源 WebView 的全局变量或内建函数。平台密码库不可用时拒绝安装官方包。
 */
import { verifyPackSignature } from "@/uni_modules/qt-js-engine";
import { parseJsonToUtso } from "@/services/http";
const OFFICIAL_SIGN_PUBKEY_HEX = "98eb62f89a1a5f64e7e9568ff7513e4da62bb61e2819a52a012bfd3ade0d0dc1";
/** 签名块起始标记（与 qt-sources sign-pack.mjs 同值） */
const SIGN_BLOCK_MARK = "/*__QT_SIGN__";

export type PackSignCheck = {
  /** 验签是否通过（不需要验签的包恒 true） */
  ok: boolean;
  /** 失败原因（ok=true 时为 ""） */
  message: string;
};

/**
 * 拆掉文件尾部的 __QT_SIGN__ 签名块，返回 { content, sig }：
 * - content = 签名对象（剥块后的全文，含身份头）；
 * - sig = base64 签名；无尾部块 / 块不在文件尾 / JSON 非法时 sig=""。
 * 只认 lastIndexOf——签名块必须整个位于文件末尾，其后只允许空白。
 */
export function splitSignatureBlock(text: string): { content: string; sig: string } {
  const pos = text.lastIndexOf(SIGN_BLOCK_MARK);
  if (pos < 0) return { content: text, sig: "" };
  const end = text.indexOf("*/", pos);
  if (end < 0) return { content: text, sig: "" };
  const tail = text.substring(end + 2);
  if (tail.trim().length > 0) return { content: text, sig: "" };
  const json = text.substring(pos + SIGN_BLOCK_MARK.length, end);
  try {
    const info = parseJsonToUtso(json);
    const sig = info.get("sig");
    if (typeof sig == "string" && info.get("alg") == "ed25519") {
      const sigText = sig as string;
      // Ed25519 签名必须是 64 字节的规范 base64，异常输入在原生桥之前拒绝。
      if (sigText.length != 88 || !sigText.endsWith("==")) return { content: text, sig: "" };
      if (sigText.substring(0, 86).indexOf("=") >= 0) return { content: text, sig: "" };
      for (let i = 0; i < sigText.length; i++) {
        const c = sigText.charCodeAt(i);
        const isB64 =
          (c >= 65 && c <= 90) ||
          (c >= 97 && c <= 122) ||
          (c >= 48 && c <= 57) ||
          c == 43 ||
          c == 47 ||
          c == 61;
        if (!isB64) return { content: text, sig: "" };
      }
      return { content: text.substring(0, pos), sig: sigText };
    }
    return { content: text, sig: "" };
  } catch (e) {
    return { content: text, sig: "" };
  }
}

export async function verifyOfficialSignature(text: string): Promise<PackSignCheck> {
  const parts = splitSignatureBlock(text);
  if (parts.sig.length == 0) return { ok: false, message: "文件缺少有效的官方签名" };
  return await new Promise<PackSignCheck>((resolve) => {
    verifyPackSignature(parts.content, parts.sig, OFFICIAL_SIGN_PUBKEY_HEX, (result) => {
      if (!result.ok) { resolve({ ok: false, message: "验签环境不可用：" + result.error }); return; }
      resolve(result.value == "ok" ? { ok: true, message: "" } : { ok: false, message: "签名不匹配，文件已改动或并非官方原版" });
    });
  });
}
