/**
 * 官方音源包 ed25519 签名校验（2026-10 官方身份防仿冒，与 qt-sources
 * scripts/sign-pack.mjs / docs/PACK-AUTHORING.md §签名 同一约定）。
 *
 * 背景与威胁模型：官方包同样走「https 直链 / 本地 js 文件」分发，文件身份不能只靠
 * 首行自述（否则任何第三方都能写 id=play-official 顶掉官方槽）。构建期发布机私钥
 * 对「含 __QT_PACK__ 身份头的文件全文」做 ed25519 签名，尾部追加 __QT_SIGN__ 注释块
 * （JSON：{"alg":"ed25519","sig":"base64 64B"}，见 qt-sources scripts/sign-pack.mjs）。
 *
 * 宿主只内置公钥（本文件常量，绝不放进包文件），安装/更新官方保留 id 时硬校验：
 * 验不过（含无签名块）一律拒绝；第三方包不受影响。
 *
 * 验签在 JS 引擎里执行（tweetnacl 纯 JS 同步实现，ed25519 + SHA-512）——UTS 侧没有
 * 曲线运算原生 API。验签发生在**装载/执行新包内容之前**。对「同引擎里已生效的
 * 恶意包」的三个劫持面全部封死（复审 P0-A）：nacl 只经 ensurePackVerifier 冻结
 * 的随机名全局属性取用（不可写、不可配置，装载后无法重定义/删除）；公钥以 hex
 * 字面量内联（不经可被调包的 atob）；消息字节由手写 UTF-8 编码器从已对表的
 * 送验字符串现算（不经可被调包的 TextEncoder，杜绝「字符串与字节解耦」的
 * 旧包重放）。残余面：恶意包完全接管 JS realm 时同域防御一律不成立。
 *
 * 送验内容按块通过 evaluateJavascript 分批推进引擎（2026-10-08）：1.7MB 官方包整段
 * 内联进单次求值会超过 Android Binder ~1MB 事务上限（见 qt-js-engine webview.uts
 * 文档）。缓冲名带随机数、汇总时做 isArray/长度/双哈希三重校验——正在生效的旧包
 * 既无法预埋同名陷阱，也无法把送验内容调包成另一份真正签过的旧官方包。
 */
import { ensurePackVerifier, evalOnEngine, verifierGlobalName } from "@/services/source-engine";

/**
 * 官方发布公钥（ed25519 raw 32B，hex 字面量）。与 qt-sources sources.config.json
 * packs.signing.publicKey（base64：mOti+JoaX2Tn6VaP91E+TaYrth4oGaUqASv9Ot4NDcE=）、
 * qt-pc 常量同一把钥匙。直接以 hex 内联进验签表达式、不经 atob 解码——atob 是
 * 同域可调包的全局（换掉真公钥即可让冒充包通过），hex 字面量没有这个劫持面。
 */
const OFFICIAL_SIGN_PUBKEY_HEX = "98eb62f89a1a5f64e7e9568ff7513e4da62bb61e2819a52a012bfd3ade0d0dc1";
/** 签名块起始标记（与 qt-sources sign-pack.mjs 同值） */
const SIGN_BLOCK_MARK = "/*__QT_SIGN__";

export type PackSignCheck = {
  /** 验签是否通过（不需要验签的包恒 true） */
  ok: boolean;
  /** 失败原因（ok=true 时为 ""） */
  message: string;
};

/**
 * 拆掉文件尾部的 __QT_SIGN__ 签名块，返回 { content, sig }：
 * - content = 签名对象（剥块后的全文，含身份头）；
 * - sig = base64 签名；无尾部块 / 块不在文件尾 / JSON 非法时 sig=""。
 * 只认 lastIndexOf——签名块必须整个位于文件末尾，其后只允许空白。
 */
export function splitSignatureBlock(text: string): { content: string; sig: string } {
  const pos = text.lastIndexOf(SIGN_BLOCK_MARK);
  if (pos < 0) return { content: text, sig: "" };
  const end = text.indexOf("*/", pos);
  if (end < 0) return { content: text, sig: "" };
  const tail = text.substring(end + 2);
  if (tail.trim().length > 0) return { content: text, sig: "" };
  const json = text.substring(pos + SIGN_BLOCK_MARK.length, end);
  try {
    const info = JSON.parse(json) as UTSJSONObject;
    const sig = info.get("sig");
    if (sig != null) {
      return { content: text.substring(0, pos), sig: `${sig}` };
    }
    return { content: text, sig: "" };
  } catch (e) {
    return { content: text, sig: "" };
  }
}

/**
 * 把任意文本转成可嵌入 JS 双引号字符串字面量的**纯 ASCII** 序列：
 * \\、"、' 与控制字符 → C 风格转义；其余非 ASCII codeUnit → \uXXXX。
 * 代入点在本文件的验签表达式（分块送验时每块独立转义，先切块后转义，
 * \uXXXX 不可能被从中间切断），包内容里任何中文/引号/反斜杠都会被
 * 无歧义转义，不存在注入面。
 */
export function escapeJsAscii(text: string): string {
  const parts: string[] = [];
  const n = text.length;
  for (let i = 0; i < n; i++) {
    const c = text.charCodeAt(i);
    if (c == 92) {
      // backslash
      parts.push("\\\\");
    } else if (c == 34) {
      // double quote
      parts.push('\\"');
    } else if (c == 39) {
      // single quote
      parts.push("\\'");
    } else if (c == 10) {
      parts.push("\\n");
    } else if (c == 13) {
      parts.push("\\r");
    } else if (c == 9) {
      parts.push("\\t");
    } else if (c < 32 || c > 126) {
      const hex = "0123456789abcdef";
      const h = (c >> 12) & 15;
      const a = (c >> 8) & 15;
      const b = (c >> 4) & 15;
      const d = c & 15;
      parts.push("\\u" + hex.charAt(h) + hex.charAt(a) + hex.charAt(b) + hex.charAt(d));
    } else {
      parts.push(String.fromCharCode(c));
    }
  }
  return parts.join("");
}

/**
 * 分块送验的单块原始字符数：转义后最坏每字符 6 个 ASCII（\uXXXX），
 * 96000 × 6 ≈ 576KB，加表达式包裹后仍远低于 evaluateJavascript 的
 * Binder 事务上限（~1MB，见 qt-js-engine webview.uts 文档）。
 */
const SIGN_CHUNK_CHARS = 96000;

/**
 * 送验内容的双 32 位混合校验（xor + 乘法回绕 + 移位混淆，两条独立参数链）。
 * UTS 侧与引擎侧（验签表达式里的同款内联实现）按完全相同的 32 位补码运算
 * 各算一遍、对表——防止引擎里的缓冲在「分块推送」与「汇总验签」之间被正在
 * 生效的旧包调包（拼出另一份真正签过的旧官方包来顶替本次送验内容）。
 * 长度 + 两条非线性链 + nacl 验签同时满足才可能伪造，实际不可构造。
 */
function signContentHash(text: string): string {
  // 复审 P0-B 修复（第二版）：services 层在 uni-app x 安卓上编译为 app-service
  // JS（logcat 的 JSConsole 源码行号即证），既没有 .toInt()，裸乘法也是 Double
  // 语义（超 2^53 丢精度、无 32 位回绕），官方包会 100% 命中「qt:err:hash」。
  // 显式 Int 标注在该层不生效。正解是与引擎侧完全同款的表达式：Math.imul
  // 强制 Int32 乘法 + ^ 与 >> 的 32 位补码语义——两个 JS 域（app-service V8、
  // 引擎 WebView V8）与 Node 对照件逐位一致，Kotlin 原生插件层不经过本函数。
  let a = 0;
  let b = 0;
  for (let i = 0; i < text.length; i++) {
    const c = text.charCodeAt(i);
    a = Math.imul(a ^ c, -2048144789);
    a = a ^ (a >> 13);
    a = Math.imul(a, -1028477387);
    a = a ^ (a >> 16);
    b = Math.imul(b ^ c, 668265263);
    b = b ^ (b >> 15);
    b = Math.imul(b, 374761393);
    b = b ^ (b >> 13);
  }
  return `${a}_${b}`;
}

/**
 * 校验官方包签名（ed25519，签名对象=剥块后全文的 UTF-8 bytes）。
 * 在 JS 引擎里同步求值（nacl.sign.detached.verify），返回 qt:ok / qt:bad / qt:err:*。
 * 引擎不可用 / 资产缺失也判失败——官方包宁拒不装。
 */
export async function verifyOfficialSignature(text: string): Promise<PackSignCheck> {
  if (!(await ensurePackVerifier())) {
    return { ok: false, message: "验签环境不可用（引擎或验签器装载失败）" };
  }
  // 只经冻结全局属性取用 nacl（见 ensurePackVerifier：KAT 自检通过后
  // defineProperty 不可写不可配置，装载后无法被同域代码重定义/删除）
  const verifierRef = verifierGlobalName();
  if (verifierRef.length == 0) {
    return { ok: false, message: "验签环境不可用（验签器引用缺失）" };
  }
  const parts = splitSignatureBlock(text);
  if (parts.sig.length == 0) {
    return { ok: false, message: "文件缺少官方签名（尾部 __QT_SIGN__ 块）" };
  }
  // atob→Uint8Array 的内联小函数（nacl 不带 base64；WebView 标配 atob）。
  // 只用于解码文件自带的签名——atob 即便被调包，产出的假签名配真公钥
  // 只会验假（fail-closed），不可能放行冒充包。
  const b64ToBytes =
    "(function(x){var a=new Uint8Array(x.length);for(var i=0;i<x.length;i++)a[i]=x.charCodeAt(i);return a})";
  // 分块送验（2026-10-08 修复）：单次求值内联全文会超 Binder 上限，首个签名官方包
  // 必装失败。原始文本按 SIGN_CHUNK_CHARS 切块、逐块独立转义后小求值推入引擎侧
  // 随机名缓冲；最后一次小求值完成拼接 + 完整性校验 + nacl 验签（见函数头注释）。
  const bufName = "__qtSbv_" + Math.floor(Math.random() * 2147483647).toString();
  const content = parts.content;
  try {
    // 重置缓冲（赋值覆盖任何残留或预埋的同名值）
    const initAck = await evalOnEngine("(globalThis." + bufName + "=[],\"qt:ready\")");
    if (initAck != "qt:ready") {
      return { ok: false, message: "验签缓冲初始化失败" };
    }
    let index = 0;
    let offset = 0;
    while (offset < content.length) {
      const end = offset + SIGN_CHUNK_CHARS < content.length ? offset + SIGN_CHUNK_CHARS : content.length;
      const expr =
        "(globalThis." +
        bufName +
        ".push(\"" +
        escapeJsAscii(content.substring(offset, end)) +
        "\"),\"qt:" +
        index.toString() +
        "\")";
      const ack = await evalOnEngine(expr);
      if (ack != "qt:" + index.toString()) {
        return { ok: false, message: "验签分块送入失败（第 " + (index + 1).toString() + " 块）" };
      }
      offset = end;
      index = index + 1;
    }
    const verifyExpr =
      "(function(){try{" +
      "var A=globalThis." +
      bufName +
      ";" +
      "if(!Array.isArray(A)||A.length!==" +
      index.toString() +
      ")return String(\"qt:err:buf\");" +
      "var t=\"\";" +
      "for(var i=0;i<A.length;i++){if(typeof A[i]!==\"string\")return String(\"qt:err:buf\");t+=A[i];}" +
      "globalThis." +
      bufName +
      "=null;" +
      "if(t.length!==" +
      content.length.toString() +
      ")return String(\"qt:err:length\");" +
      "var a=0,b=0;" +
      "for(var i=0;i<t.length;i++){var c=t.charCodeAt(i);" +
      "a=Math.imul(a^c,-2048144789);a=a^(a>>13);a=Math.imul(a,-1028477387);a=a^(a>>16);" +
      "b=Math.imul(b^c,668265263);b=b^(b>>15);b=Math.imul(b,374761393);b=b^(b>>13);}" +
      "if((a+\"_\"+b)!==\"" +
      signContentHash(content) +
      "\")return String(\"qt:err:hash\");" +
      // 手写 UTF-8 编码：不依赖 TextEncoder（同域可调包成「返回另一份旧官方
      // 包字节」实现重放）；代理项按 Node Buffer.from(text,'utf8') 同规则
      // 替换为 U+FFFD，保证与 qt-sources 签名侧字节完全一致。
      "var m=(function(s){var n=s.length,o=[],i;" +
      "function w(c){if(c<128)o.push(c);else if(c<2048)o.push(192|c>>6,128|c&63);else if(c<65536)o.push(224|c>>12,128|c>>6&63,128|c&63);else o.push(240|c>>18,128|c>>12&63,128|c>>6&63,128|c&63)}" +
      "for(i=0;i<n;i++){var c=s.charCodeAt(i);" +
      "if(c>=55296&&c<=56319&&i+1<n){var d=s.charCodeAt(i+1);if(d>=56320&&d<=57343){w((c-55296)*1024+(d-56320)+65536);i++;continue}}" +
      "if(c>=55296&&c<=57343)c=65533;w(c)}" +
      "return new Uint8Array(o)})(t);" +
      "var sm=" +
      b64ToBytes +
      "(atob(\"" +
      parts.sig +
      "\"));" +
      "if(sm.length!==64)return String(\"qt:err:siglen\");" +
      "function hb(s){var a=new Uint8Array(s.length/2);for(var i=0;i<s.length;i+=2){a[i>>1]=parseInt(s.substr(i,2),16)}return a}" +
      "var pm=hb(\"" +
      OFFICIAL_SIGN_PUBKEY_HEX +
      "\");" +
      "if(pm.length!==32)return String(\"qt:err:publen\");" +
      "return String(\"qt:\"+(globalThis." +
      verifierRef +
      ".sign.detached.verify(m,sm,pm)?\"ok\":\"bad\"));" +
      "}catch(e){try{globalThis." +
      bufName +
      "=null}catch(_){}return String(\"qt:err:\"+e);}})()";
    const result = await evalOnEngine(verifyExpr);
    if (result == "qt:ok") return { ok: true, message: "" };
    if (result.indexOf("qt:err:") == 0) {
      return { ok: false, message: "验签执行异常：" + result.substring(7) };
    }
    return { ok: false, message: "签名不匹配（文件被改动或非官方原版）" };
  } catch (e) {
    return { ok: false, message: "验签求值失败：" + String(e) };
  }
}
