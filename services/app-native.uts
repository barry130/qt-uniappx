/**
 * 强制窗口回归传统布局模式（decorFitsSystemWindows = true），绕开
 * 三星 One UI 手势导航下 edge-to-edge 窗口的首屏挂载竞态（S24 Ultra 全屏
 * 白屏根因，见 services/boot-guard.ts）。须在 App 启动最早点调用；
 * 非 Android 平台恒为 false。
 * @returns 是否应用成功（失败不影响启动，仅记录日志）
 */
export function applyLegacyInsets(): boolean {
  // #ifdef APP-ANDROID
  try {
    return applyLegacyInsetsNative();
  } catch (e) {
    logErrV("AppNative", "applyLegacyInsets", e);
    return false;
  }
  // #endif
  // #ifndef APP-ANDROID
  return false;
  // #endif
}

/** 设备像素 → 逻辑像素的换算比例（= 屏幕密度，vivo V2505A 上 3.75）。
 *  原生侧（安卓 WindowInsets / 鸿蒙 AvoidArea）给出的都是**设备像素**，而
 *  layout.safeBottomPx 最终写进 uvue 的 padding-bottom / bottom，单位是**逻辑像素**。
 *  两级单位混用正是 2026-10-31 真机上 TabBar 跑到屏幕中部的直接原因：
 *  三键导航真实高度 158 设备像素，被当成 158 逻辑像素写进样式 = 592 设备像素，
 *  内容区 3168 → 2576，绝对定位的悬浮胶囊被顶到窗口中部。
 *  读不到就按 1:1 处理（宁可少让位，不要多算一个密度）。 */
function devicePxToLogicalRatio(): number {
  try {
    const ratio = uni.getWindowInfo().pixelRatio;
    if (ratio != null && ratio > 0) return ratio;
  } catch (_) {
    // 静默：读不到比例时走 1:1，不让换算失败把避让值算大
  }
  return 1;
}

/** 设备像素换算成逻辑像素，保留两位小数并保留正负号编码（正=需让位 / 负=系统已让位）。 */
function devicePxToLogical(devicePx: number): number {
  if (devicePx == 0) return 0;
  const logical = Math.abs(devicePx) / devicePxToLogicalRatio();
  const rounded = Math.round(logical * 100) / 100;
  return devicePx > 0 ? rounded : -rounded;
}

/**
 * 异步读取底部系统导航避让高度（**逻辑像素**，原生侧设备像素已在此折算）。
 * 两个平台 uni.getWindowInfo().safeAreaInsets.bottom 都不报真值（2026-10-31
 * 真机反馈：安卓机悬浮 TabBar 压在三键导航上；鸿蒙同款），只有原生窗口信息
 * 可信。语义统一为「窗口自己让过位了吗」：
 *   - 鸿蒙读 window.getWindowAvoidArea，非沉浸式窗口下避让区自动回 0；
 *   - 安卓比对 DecorView 与内容根的 padding / 高度差，只在真 edge-to-edge
 *     时回导航栏高度（避免正常机型重复叠一次，见 app-android readBottomNavInset）；
 *   - iOS 由 safeAreaInsets 原生承担，不回调（见下）。
 * 结果回调给 App.uvue 写入 layout.safeBottomPx（applyQtNativeSafeBottom）。
 * 注意：**读不到结论时不要回调**（异常、iOS 等没有原生读数的平台）——调用方
 * 把「没回调」当作未知，继续用 uni 的 safeAreaInsets 兜底；回调一个 0 会被当成
 * 「系统已经让过位」的确定结论，反而把 iOS 的安全区让位关掉。
 */
export function readBottomNavInset(onResult: (px: number) => void): void {
  // #ifdef APP-ANDROID || APP-HARMONY
  try {
    readBottomNavInsetNative((devicePx: number) => {
      onResult(devicePxToLogical(devicePx));
    });
  } catch (e) {
    // 静默：原生读数失败时保持「未知」，下一轮 onShow 会再试，不覆写成 0
    logErrV("AppNative", "readBottomNavInset", e);
  }
  // #endif
}

/**
 * 打开系统文件选择器选一个 .js 文件，读回全文（音源包「本地文件安装」用）。
 * Android 走 ACTION_OPEN_DOCUMENT + contentResolver（content URI 只有一次读
 * 权限，所以原生侧直接把内容读出来回传）；鸿蒙走 DocumentViewPicker 选文件 +
 * 临时 URI 读全文（2026-10-25 补齐，此前恒「不支持」导致鸿蒙装不了本地音源包）；
 * 其余平台恒回调不支持。
 */
export function pickJsFile(): Promise<PickFileResult> {
  // #ifdef APP-ANDROID || APP-HARMONY
  return new Promise((resolve) => {
    try {
      pickJsFileNative((result) => {
        resolve(result);
      });
    } catch (e) {
      logErrV("AppNative", "pickJsFile", e);
      resolve({ ok: false, name: "", content: "", message: "无法打开文件选择器" } as PickFileResult);
    }
  });
  // #endif
  // #ifndef APP-ANDROID || APP-HARMONY
  return Promise.resolve({ ok: false, name: "", content: "", message: "当前平台不支持本地文件安装" } as PickFileResult);
  // #endif
}

/**
 * 打开系统文件管理器选一个下载目录（下载设置 → 更改位置）。
 *
 * Android 走 ACTION_OPEN_DOCUMENT_TREE，原生侧把 document URI 反解成真实绝对路径回传；
 * 需要「所有文件访问」权限（Android 11+），调用方负责先引导授权。
 * 鸿蒙走 DocumentViewPicker（selectMode=FOLDER）+ fileShare.persistPermission 持久化
 * 目录授权，回传的是**目录 URI**（不是普通路径）——这是 phone 上唯一能写到公共目录的
 * 路线（READ_WRITE_DOWNLOAD_DIRECTORY 在 phone 上是 INVALID，见原生侧注释）。
 * iOS 无公共目录落盘路径，原生恒回调失败，由调用方保持固定目录并给出说明。
 */
export function pickDirectory(): Promise<PickDirectoryResult> {
  return new Promise((resolve) => {
    try {
      pickDirectoryNative((result) => {
        resolve(result);
      });
    } catch (e) {
      logErrV("AppNative", "pickDirectory", e);
      resolve({ ok: false, path: "", name: "", message: "无法打开文件管理器" } as PickDirectoryResult);
    }
  });
}

/**
 * 把已保存的自定义目录喂回原生层（鸿蒙专用，其余平台空实现）。
 *
 * 为什么需要：鸿蒙的原生变量不跨进程，`persistPermission` 授予的 URI 授权虽然持久，
 * 但每次启动都要 `activatePermission` 激活一次。JS 侧把 URI 存在 uni storage
 * （qt-download-dir），App 启动/进入下载页时调这里恢复。
 * @param uri 目录 URI；空串表示恢复默认目录
 */
export function restoreCustomDir(uri: string): void {
  // #ifdef APP-HARMONY
  try {
    setCustomDirUriNative(uri);
  } catch (e) {
    logErrV("AppNative", "restoreCustomDir", e);
  }
  // #endif
}

/**
 * 查询一批权限的当前授权状态（设置页「权限管理」用）。
 *
 * Android：id 与 manifest.json 的声明串一致（android.permission.XXX）。原生侧已把
 * 「普通权限 / 运行时权限 / 特殊权限」三类收敛成统一结构：applicable 表示
 * 该权限在当前系统版本上是否还适用（如 WRITE_EXTERNAL_STORAGE 只到 Android 9），
 * unknown 表示查不到（窗口未就绪、平台不支持），页面据此显示「无法确定」
 * 而不是误报「未授权」。
 *
 * 鸿蒙：id 是 ohos.permission.XXX，与 module.json5 的 requestPermissions 一致。
 * 原生侧走 AtManager.getSelfPermissionStatus（五态），能真正区分
 * 已授权 / 未授权 / 系统版本不适用 / 受设备策略限制，能力比安卓端更强。
 *
 * 其余平台没有与这两套权限一一对应的授权模型，一律返回 unknown。
 */
export function queryPermissionStates(ids: string[]): PermissionState[] {
  // #ifdef APP-ANDROID || APP-HARMONY
  try {
    return queryPermissionStatesNative(ids);
  } catch (e) {
    logErrV("AppNative", "queryPermissionStates", e);
    return unknownPermissionStates(ids);
  }
  // #endif
  // #ifndef APP-ANDROID || APP-HARMONY
  return unknownPermissionStates(ids);
  // #endif
}

/** 查询失败/平台不支持时的保守结果：全部标 unknown，绝不误报「未授权」 */
function unknownPermissionStates(ids: string[]): PermissionState[] {
  const out: PermissionState[] = [];
  for (let i = 0; i < ids.length; i++) {
    out.push({ id: ids[i], applicable: true, granted: false, unknown: true } as PermissionState);
  }
  return out;
}

/**
 * 跳到某条权限对应的系统设置页（能直达就直达，ROM 不认则退回应用详情页）。
 *
 * 鸿蒙走 AtManager.requestPermissionOnSetting——系统专门为「已拒绝、弹窗不能再弹」
 * 场景提供的直达权限设置对话框；对 system_grant 权限会失败，原生侧自动兜底到
 * 应用详情设置页，因此返回 true 只代表「已受理并会打开某个页面」。
 * @returns 已成功发起跳转返回 true；平台不支持返回 false（调用方提示手动前往）
 */
export function openPermissionSettings(id: string): boolean {
  // #ifdef APP-ANDROID || APP-HARMONY
  try {
    return openPermissionSettingsNative(id);
  } catch (e) {
    logErrV("AppNative", "openPermissionSettings", e);
    return false;
  }
  // #endif
  // #ifndef APP-ANDROID || APP-HARMONY
  return false;
  // #endif
}

/**
 * 读取系统 WebView Cookie 库中一批 URL 的 Cookie（网页登录 v17 契约的捕获通道，
 * 契约细节见 qt-app-native 的 interface.uts）：返回逐 URL 拼好的
 * "name=value; name2=v2" 串数组，读不到的 URL 不出现在结果里。
 *
 * Android 主线程 CookieManager（可读 httpOnly）；鸿蒙/iOS 原生侧暂未实现
 * （恒空数组），宿主按「本轮未捕获到」处理。失败绝不抛异常——轮询调用方
 * 只需要「这轮拿到了什么」，异常一律归为空结果。
 */
export function getWebCookies(urls: string[]): Promise<string[]> {
  // #ifdef APP-ANDROID || APP-HARMONY
  // 原生侧已保证「异常也 resolve 空数组」（Runnable 内部 try/catch），这里不再包一层
  return getWebCookiesNative(urls);
  // #endif
  // #ifndef APP-ANDROID || APP-HARMONY
  return Promise.resolve([] as string[]);
  // #endif
}

/**
 * 用「可控登录 WebView」打开官方网页登录页（网页登录 v17，Android）。
 *
 * 为什么不用内置 <web-view>：QQ 登录页在手机 UA 下把「QQ登录」做成应用跳转
 * （mqqapi:// / intent:// 等自定义 scheme），内置组件既没有 shouldOverrideUrlLoading
 * 钩子也不转发自定义 scheme，点下去页面纹丝不动（2026-10-31 用户实测「无反应」）。
 * 原生 Dialog + WebView 能接管导航并交给系统 Intent，拉起手机QQ 完成授权，
 * 授权后 Cookie 落在同进程 CookieManager，原有的 getWebCookies 轮询照旧工作。
 *
 * @param url     登录页地址（数据包 webLogin.url）
 * @param onClose 关闭时的回调：message 为空 = 用户自己关掉；非空 = 关闭原因
 *                （例如没装手机QQ）。提示一律由宿主用 qtShowToast 展示，
 *                插件内部不弹 Toast / AlertDialog。
 * @param ua      WebView 的 User-Agent；空串 = 插件内置移动端 UA。个别站点只有
 *                桌面版布局才露出「登录」入口（酷我手机 UA 会被 302 到
 *                m.kuwo.cn 的无登录位首页），这类源由调用方传桌面 UA。
 */
export function openAuthWebView(url: string, onClose: (message: string) => void, ua: string): void {
  // #ifdef APP-ANDROID
  openAuthWebViewNative(url, onClose, ua);
  // #endif
  // #ifndef APP-ANDROID
  // iOS / H5 没有原生登录 WebView：调用方（pages/web-login）必须按 isAndroidOs()
  // 选内置 web-view，走到这里是调用方判错了平台，留一行 warn 方便定位
  logWarn("app-native", "openAuthWebView 当前平台无原生实现（iOS/H5 请用内置 web-view）: " + url);
  // #endif
}

/** 关闭 openAuthWebView 打开的登录 WebView（未打开时无副作用，不触发 onClose） */
export function closeAuthWebView(): void {
  // #ifdef APP-ANDROID
  closeAuthWebViewNative();
  // #endif
}

/**
 * 保存图片到系统相册。
 *
 * 为什么不用 `uni.saveImageToPhotosAlbum`：它走 uni-media 的权限链，在 Android 14+
 * 上会经 XXPermissions 校验清单里 WRITE_EXTERNAL_STORAGE 的声明；本工程清单写的是
 * `<uses-permission ... android:maxSdkVersion="28"/>`，XXPermissions 直接抛
 * `IllegalArgumentException: ... does not meet the requirements`，把页面打崩
 * （2026-10-31 用户实测，点「保存二维码」必现）。
 * 安卓改走自己的 MediaStore 写入：Android 10+ 不需要任何存储权限，图片落在
 * `Pictures/qtMusic/`，系统相册即可扫到。
 *
 * @returns 落盘后的绝对路径；失败返回空串
 */
export function saveImageToGallery(tempPath: string, fileName: string): Promise<string> {
  // #ifdef APP-ANDROID
  return saveToPublicMediaNative(tempPath, "picture", fileName, "qtMusic");
  // #endif
  // #ifndef APP-ANDROID
  return new Promise<string>((resolve: (value: string) => void, _reject: (err: any) => void) => {
    uni.saveImageToPhotosAlbum({
      filePath: tempPath,
      success: () => resolve(tempPath),
      fail: () => resolve(""),
    });
  });
  // #endif
}
