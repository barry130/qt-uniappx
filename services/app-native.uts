/**
 * APP 原生能力（UTS）
 * - openInBrowser: 跳转系统浏览器
 * - downloadApk: 直链下载（uni.downloadFile，带进度）
 * - installApk: 安装 APK（Android，经 FileProvider）
 *
 * 说明：Vapor 模式下本文件属于 JS 逻辑层，没有 UTSAndroid / android 全局对象，
 * Android 原生能力（打开浏览器/退出/安装 APK）统一收敛在 uni_modules/qt-app-native 插件
 * （编译进原生层），此处通过平台分发导入调用；H5 保留 window 实现，其余降级为复制+提示。
 */

import { openExternalUrl, exitAppNative, installApkNative, openNotificationSettings as openNotificationSettingsNative, isIgnoringBatteryOptimizations as isIgnoringBatteryOptimizationsNative, openBatteryOptimizationSettings as openBatteryOptimizationSettingsNative, openAutoStartSettings as openAutoStartSettingsNative, openAppDetailsSettings as openAppDetailsSettingsNative, applyLegacyInsets as applyLegacyInsetsNative, pickJsFile as pickJsFileNative, pickDirectory as pickDirectoryNative, setCustomDirUri as setCustomDirUriNative, queryPermissionStates as queryPermissionStatesNative, openPermissionSettings as openPermissionSettingsNative } from "@/uni_modules/qt-app-native";
import type { PickFileResult, PickDirectoryResult, PermissionState } from "@/uni_modules/qt-app-native";
import { logErrV } from "@/services/logger";
import { ensureNotificationPermission as ensureNotificationPermissionNative } from "@/uni_modules/qt-audio-player";
import { qtShowToast } from "@/services/toast";

export type DownloadProgress = (received: number, total: number, percent: number) => void;

/**
 * 本机是否为鸿蒙端。
 *
 * 页面需要按平台切换权限清单与文案，但**不在 .uvue 里写 #ifdef**：本项目所有 .uvue
 * 目前都无条件编译，平台差异一律收敛在 UTS 服务里（AGENTS.md 也要求平台分支进 UTS）。
 * 与 services/source-update.uts 的 currentPlatform() 同一套做法：鸿蒙必须显式分支，
 * 否则会被当成安卓处理。
 *
 * 注意别写成 `#ifndef APP-ANDROID`——uni-preprocess 的 `#ifndef A || B` 不是德摩根律，
 * `#ifndef APP-ANDROID || APP-HARMONY` 在鸿蒙上是 TRUE，会把鸿蒙判成非鸿蒙。
 */
export function isHarmonyOs(): boolean {
  // #ifdef APP-HARMONY
  return true;
  // #endif
  // #ifndef APP-HARMONY
  return false;
  // #endif
}

/**
 * 退出应用（Android 关闭所有 Activity；鸿蒙 terminateSelf 回到桌面；H5 尝试关闭窗口）
 *
 * ⚠️ 鸿蒙必须一起放进来：原实现只门禁了 APP-ANDROID，鸿蒙上 `exitAppNative()` 根本
 * 不会被调用，于是「检测到非官方版本 → 3 秒后自动退出」在鸿蒙上只会弹个 toast 就没了。
 * 这是「非官方 APP 也没有自动退出」的第一层原因（第二层是 exitAppNative 自身恒返回 false）。
 */
export function exitApp(): void {
  // #ifdef APP-ANDROID || APP-HARMONY
  if (exitAppNative()) return;
  // #endif
  // #ifdef H5
  try {
    const w = window as any;
    if (w.close != null) {
      w.close();
      return;
    }
  } catch (e) {}
  // #endif
  qtShowToast({ title: "已退出", icon: "none" });
}

/** 跳转系统浏览器打开链接 */
export function openInBrowser(url: string): void {
  if (url.length == 0) {
    qtShowToast({ title: "下载地址为空", icon: "none" });
    return;
  }
  // #ifdef APP-ANDROID || APP-HARMONY
  if (openExternalUrl(url)) return;
  // #endif
  // #ifdef H5
  try {
    const w = window as any;
    if (w.open != null) {
      w.open(url, "_blank");
      return;
    }
  } catch (e) {}
  // #endif
  // 降级：复制链接 + 提示
  uni.setClipboardData({
    data: url,
    success: () => {
      qtShowToast({ title: "已复制下载链接，请到浏览器打开", icon: "none" });
    },
  });
}

/** 直链下载 APK 到本地（返回临时文件路径） */
export function downloadApk(url: string, onProgress: DownloadProgress): Promise<string> {
  return new Promise((resolve, reject) => {
    const task = uni.downloadFile({
      url,
      success: (res) => {
        if (res.statusCode >= 200 && res.statusCode < 300) {
          resolve(res.tempFilePath);
        } else {
          reject(new Error("下载失败 HTTP " + res.statusCode));
        }
      },
      fail: (error) => {
        logErrV("AppNative", "下载失败", error);
        reject(new Error("下载失败"));
      },
    });
    if (task != null && task.onProgressUpdate != null) {
      task.onProgressUpdate((p) => {
        const total = p.totalBytesExpectedToWrite > 0 ? p.totalBytesExpectedToWrite : 0;
        const received = p.totalBytesWritten > 0 ? p.totalBytesWritten : 0;
        const percent = total > 0 ? Math.floor((received / total) * 100) : 0;
        onProgress(received, total, percent);
      });
    }
  });
}

/**
 * 安装 APK（Android 经 FileProvider，兼容 Android 7+）
 * @returns 是否成功拉起系统安装界面；false 表示只能由用户自己去文件管理里点安装
 */
export function installApk(filePath: string): boolean {
  if (filePath.length == 0) {
    qtShowToast({ title: "安装包不存在", icon: "none" });
    return false;
  }
  // #ifdef APP-ANDROID
  if (installApkNative(filePath)) return true;
  // #endif
  qtShowToast({ title: "安装包已保存，请在文件管理中安装", icon: "none" });
  return false;
}

/**
 * 检查/请求「通知栏」运行时权限（Android 13+ 的 POST_NOTIFICATIONS）。
 * @returns 是否已授权：
 *  - Android 13+ 未授权时自动弹出系统授权框，await 其结果；
 *  - Android 12-（通知权限默认可使用）与 H5 视为已授权。
 * 经 uni_modules 原生插件实现，此处只做 Promise 包装与平台降级。
 */
export function ensureNotificationPermission(): Promise<boolean> {
  // #ifdef APP-ANDROID || APP-HARMONY
  return new Promise((resolve) => {
    try {
      ensureNotificationPermissionNative((granted: boolean) => {
        resolve(granted);
      });
    } catch (e) {
      logErrV("AppNative", "ensureNotificationPermission", e);
      resolve(false);
    }
  });
  // #endif
  // #ifndef APP-ANDROID || APP-HARMONY
  return Promise.resolve(true);
  // #endif
}

/**
 * 打开本应用的系统通知设置页，供用户手动开启通知权限。
 * Android：API 26+ 直达通知页，否则降级到应用详情页。
 * 鸿蒙：直接弹系统「是否允许通知」授权框（notificationManager.requestEnableNotification），
 *   已授权时静默成功；用户已选「不再询问」时原生侧自动降级到应用详情页。
 * iOS / H5：不支持，返回 false，由调用方降级为提示。
 * @returns 是否成功拉起设置页
 */
export function openNotificationSettings(): boolean {
  // #ifdef APP-ANDROID || APP-HARMONY
  try {
    return openNotificationSettingsNative();
  } catch (e) {
    logErrV("AppNative", "openNotificationSettings", e);
    return false;
  }
  // #endif
  // #ifndef APP-ANDROID || APP-HARMONY
  return false;
  // #endif
}

/**
 * 本应用是否已加入系统电池优化白名单（即后台不会被 Doze 冻结）。
 *
 * 用途：后台取链/后台播放被系统限制时，引导用户去把本应用设为「不优化」。
 * 保守策略：查询失败一律返回 true（视为已放行）——误报会打扰用户，漏报只是少一次提示。
 * 非 Android 平台恒为 true（iOS/H5 无此概念）。
 * @returns 是否已放行（true 表示无需引导）
 */
export function isIgnoringBatteryOptimizations(): boolean {
  // #ifdef APP-ANDROID
  try {
    return isIgnoringBatteryOptimizationsNative();
  } catch (e) {
    logErrV("AppNative", "isIgnoringBatteryOptimizations", e);
    return true;
  }
  // #endif
  // #ifndef APP-ANDROID
  return true;
  // #endif
}

/**
 * 打开系统「电池优化」列表页，让用户把本应用改为「不优化」。
 * 用的是零权限的列表页 action（详见 qt-app-native 实现注释），失败时降级到应用详情页。
 * @returns 是否成功拉起设置页
 */
export function openBatteryOptimizationSettings(): boolean {
  // #ifdef APP-ANDROID
  try {
    return openBatteryOptimizationSettingsNative();
  } catch (e) {
    logErrV("AppNative", "openBatteryOptimizationSettings", e);
    return false;
  }
  // #endif
  // #ifndef APP-ANDROID
  return false;
  // #endif
}

/**
 * 打开厂商「自启动 / 后台运行管理」页（国产 ROM 私有入口，逐个厂商试）。
 * 全部候选都落空时原生侧会自动降级到应用详情页，因此返回 true 只代表拉起过某个页面。
 * 鸿蒙：「应用启动管理」没有独立 action，原生侧直接跳应用详情设置页。
 * @returns 是否成功拉起设置页
 */
export function openAutoStartSettings(): boolean {
  // #ifdef APP-ANDROID || APP-HARMONY
  try {
    return openAutoStartSettingsNative();
  } catch (e) {
    logErrV("AppNative", "openAutoStartSettings", e);
    return false;
  }
  // #endif
  // #ifndef APP-ANDROID || APP-HARMONY
  return false;
  // #endif
}

/**
 * 打开本应用的系统详情设置页（所有 ROM 都有的最终兜底入口）。
 * 鸿蒙的权限开关与通知开关都挂在这个页面的「权限」分区下，是通用兜底入口。
 * @returns 是否成功拉起设置页
 */
export function openAppDetailsSettings(): boolean {
  // #ifdef APP-ANDROID || APP-HARMONY
  try {
    return openAppDetailsSettingsNative();
  } catch (e) {
    logErrV("AppNative", "openAppDetailsSettings", e);
    return false;
  }
  // #endif
  // #ifndef APP-ANDROID || APP-HARMONY
  return false;
  // #endif
}

/**
 * 强制窗口回归传统布局模式（decorFitsSystemWindows = true），绕开
 * 三星 One UI 手势导航下 edge-to-edge 窗口的首屏挂载竞态（S24 Ultra 全屏
 * 白屏根因，见 services/boot-guard.ts）。须在 App 启动最早点调用；
 * 非 Android 平台恒为 false。
 * @returns 是否应用成功（失败不影响启动，仅记录日志）
 */
export function applyLegacyInsets(): boolean {
  // #ifdef APP-ANDROID
  try {
    return applyLegacyInsetsNative();
  } catch (e) {
    logErrV("AppNative", "applyLegacyInsets", e);
    return false;
  }
  // #endif
  // #ifndef APP-ANDROID
  return false;
  // #endif
}

/**
 * 打开系统文件选择器选一个 .js 文件，读回全文（音源包「本地文件安装」用）。
 * Android 走 ACTION_OPEN_DOCUMENT + contentResolver（content URI 只有一次读
 * 权限，所以原生侧直接把内容读出来回传）；其他平台恒回调不支持。
 */
export function pickJsFile(): Promise<PickFileResult> {
  // #ifdef APP-ANDROID
  return new Promise((resolve) => {
    try {
      pickJsFileNative((result) => {
        resolve(result);
      });
    } catch (e) {
      logErrV("AppNative", "pickJsFile", e);
      resolve({ ok: false, name: "", content: "", message: "无法打开文件选择器" } as PickFileResult);
    }
  });
  // #endif
  // #ifndef APP-ANDROID
  return Promise.resolve({ ok: false, name: "", content: "", message: "当前平台不支持本地文件安装" } as PickFileResult);
  // #endif
}

/**
 * 打开系统文件管理器选一个下载目录（下载设置 → 更改位置）。
 *
 * Android 走 ACTION_OPEN_DOCUMENT_TREE，原生侧把 document URI 反解成真实绝对路径回传；
 * 需要「所有文件访问」权限（Android 11+），调用方负责先引导授权。
 * 鸿蒙走 DocumentViewPicker（selectMode=FOLDER）+ fileShare.persistPermission 持久化
 * 目录授权，回传的是**目录 URI**（不是普通路径）——这是 phone 上唯一能写到公共目录的
 * 路线（READ_WRITE_DOWNLOAD_DIRECTORY 在 phone 上是 INVALID，见原生侧注释）。
 * iOS 无公共目录落盘路径，原生恒回调失败，由调用方保持固定目录并给出说明。
 */
export function pickDirectory(): Promise<PickDirectoryResult> {
  return new Promise((resolve) => {
    try {
      pickDirectoryNative((result) => {
        resolve(result);
      });
    } catch (e) {
      logErrV("AppNative", "pickDirectory", e);
      resolve({ ok: false, path: "", name: "", message: "无法打开文件管理器" } as PickDirectoryResult);
    }
  });
}

/**
 * 把已保存的自定义目录喂回原生层（鸿蒙专用，其余平台空实现）。
 *
 * 为什么需要：鸿蒙的原生变量不跨进程，`persistPermission` 授予的 URI 授权虽然持久，
 * 但每次启动都要 `activatePermission` 激活一次。JS 侧把 URI 存在 uni storage
 * （qt-download-dir），App 启动/进入下载页时调这里恢复。
 * @param uri 目录 URI；空串表示恢复默认目录
 */
export function restoreCustomDir(uri: string): void {
  // #ifdef APP-HARMONY
  try {
    setCustomDirUriNative(uri);
  } catch (e) {
    logErrV("AppNative", "restoreCustomDir", e);
  }
  // #endif
}

/**
 * 查询一批权限的当前授权状态（设置页「权限管理」用）。
 *
 * Android：id 与 manifest.json 的声明串一致（android.permission.XXX）。原生侧已把
 * 「普通权限 / 运行时权限 / 特殊权限」三类收敛成统一结构：applicable 表示
 * 该权限在当前系统版本上是否还适用（如 WRITE_EXTERNAL_STORAGE 只到 Android 9），
 * unknown 表示查不到（窗口未就绪、平台不支持），页面据此显示「无法确定」
 * 而不是误报「未授权」。
 *
 * 鸿蒙：id 是 ohos.permission.XXX，与 module.json5 的 requestPermissions 一致。
 * 原生侧走 AtManager.getSelfPermissionStatus（五态），能真正区分
 * 已授权 / 未授权 / 系统版本不适用 / 受设备策略限制，能力比安卓端更强。
 *
 * 其余平台没有与这两套权限一一对应的授权模型，一律返回 unknown。
 */
export function queryPermissionStates(ids: string[]): PermissionState[] {
  // #ifdef APP-ANDROID || APP-HARMONY
  try {
    return queryPermissionStatesNative(ids);
  } catch (e) {
    logErrV("AppNative", "queryPermissionStates", e);
    return unknownPermissionStates(ids);
  }
  // #endif
  // #ifndef APP-ANDROID || APP-HARMONY
  return unknownPermissionStates(ids);
  // #endif
}

/** 查询失败/平台不支持时的保守结果：全部标 unknown，绝不误报「未授权」 */
function unknownPermissionStates(ids: string[]): PermissionState[] {
  const out: PermissionState[] = [];
  for (let i = 0; i < ids.length; i++) {
    out.push({ id: ids[i], applicable: true, granted: false, unknown: true } as PermissionState);
  }
  return out;
}

/**
 * 跳到某条权限对应的系统设置页（能直达就直达，ROM 不认则退回应用详情页）。
 *
 * 鸿蒙走 AtManager.requestPermissionOnSetting——系统专门为「已拒绝、弹窗不能再弹」
 * 场景提供的直达权限设置对话框；对 system_grant 权限会失败，原生侧自动兜底到
 * 应用详情设置页，因此返回 true 只代表「已受理并会打开某个页面」。
 * @returns 已成功发起跳转返回 true；平台不支持返回 false（调用方提示手动前往）
 */
export function openPermissionSettings(id: string): boolean {
  // #ifdef APP-ANDROID || APP-HARMONY
  try {
    return openPermissionSettingsNative(id);
  } catch (e) {
    logErrV("AppNative", "openPermissionSettings", e);
    return false;
  }
  // #endif
  // #ifndef APP-ANDROID || APP-HARMONY
  return false;
  // #endif
}
