/**
 * 音源包安装与更新（统一包模型，v3）
 *
 * 所有音源包（meta 数据包 / play 播放包）机制完全一致：
 *   - 安装：用户给「https 直链」或「本地 js 文件」（qt-app-native 的系统文件
 *     选择器），包首行 /*__QT_PACK__{...}*\/ 自述身份（kind/id/名称/版本/updateUrl），
 *     宿主解析头 → 校验 → 落 install/<id>/ → 登记。同 id = 同一个包，新版本
 *     原地替换（.prev 暂存旧文件，失败可回滚）；不同 id 多包共存。
 *   - 更新发现：① 各包自述 updateUrl 探测（拉远端文件头比版本，按包独立节流）；
 *     ② astral manifest 渠道（保留：这是发布方自己的发布接口，未来也用于
 *     下发 meta 包）。两路合并成一份「可用更新」清单。
 *   - 更新生效：**仅提示、手动确认**（启动时/App 内弹一次），确认后下载 →
 *     校验 → 替换 → 生效。绝不明装。
 *     play 生效 = 引擎热注入 + 冒烟自检，失败回滚 .prev 并拉黑该版本；
 *     meta 生效 = 整引擎重装 bundle 槽（reloadEngineMeta），bundleInfo 验
 *     契约，失败回滚 .prev 回退旧版本/基线。
 *
 * 生效位：play 包 activeId（多包并存恰好一个生效，装新包不抢已有生效位）；
 * meta 包 activeMetaId（"" = 内置基线，卸载即回退）。
 *
 * 「落盘」不等于「生效」：装载失败不改落盘状态由用户处理（除非是更新动作——
 * 更新失败自动回滚，安装动作失败则保留由用户决定）。
 */

import type { Song } from "@/types/music";
import { resolveUrl } from "@/services/http";
import { mergeClientHeaders } from "@/services/client-info";
import { getAccessToken } from "@/services/auth";
import { getCurrentVersionCode, getCurrentVersionName } from "@/services/app-version";
import { musicApi } from "@/services/music-api";
import type { SourcePackMeta } from "@/services/source-bundle-fs";
import type { PackHeaderInfo } from "@/services/source-pack-header";
import { parsePackHeader } from "@/services/source-pack-header";
import {
  localState,
  packs,
  packById,
  activePack,
  activeMetaPack,
  setActive,
  setActiveMeta,
  putPack,
  removePack,
  markPackBad,
  isPackBadVersion,
  touchPackProbe,
  touchLastCheck,
  notePackError,
  clearPackError,
  ensureLocalStateRestored,
  ensurePackDir,
  writePackArtifact,
  writeTextFileAt,
  readPackArtifact,
  removePackArtifact,
  readTextFileAt,
  removeFileAt,
  artifactPath,
  artifactOfKind,
  pruneOrphans,
  packDirOf,
  OFFICIAL_PLAY_ID,
  isOfficialPackId,
  PACK_KIND_META,
  PACK_KIND_PLAY,
  ARTIFACT_CHAIN,
  ARTIFACT_PLAY,
  ARTIFACT_META,
} from "@/services/source-bundle-fs";
import { verifyOfficialSignature } from "@/services/pack-signature";
import {
  ensurePlayPackLoaded,
  unloadPlayPack,
  getPlayUrlByEngine,
  verifyPlayableByEngine,
  loadedPlayPackId,
  playPackReady,
  loadFailureKind,
  lastEngineError,
  reloadEngineMeta,
  loadedMetaCode,
  baselineMetaInfo,
  engineUsable,
} from "@/services/source-engine";

/** 平台常量（与 astral 的 qt_app_update.type 同源） */
export const PLATFORM_ANDROID = 1101;
export const PLATFORM_WINDOWS = 1103;
/** 本机支持的宿主契约版本（与 source-engine 里的一致） */
const HOST_API_VERSION = 1;
const MANIFEST_TIMEOUT_MS = 10000;
const DOWNLOAD_TIMEOUT_MS = 60000;
/** 头部探测超时（只拉 4KB，不用下载整包的超时） */
const PROBE_TIMEOUT_MS = 10000;
/** 自管 updateUrl 探测的最小间隔（按包独立节流，4 小时） */
const PROBE_INTERVAL_MS = 4 * 60 * 60 * 1000;
/** manifest 渠道检查的最小间隔（4 小时） */
const CHECK_INTERVAL_MS = 4 * 60 * 60 * 1000;
/** 播放包主体必须含的工厂标记（meta 的 installPlayPack 契约） */
const PLAY_PACK_FACTORY_MARKER = "__qtPlayPackFactory";
/** 头部探测的 Range 上限（包头行远小于此；200 全量应答也能直接用） */
const PROBE_RANGE_BYTES = 4096;

// ==================== 可用更新（提示 + 手动确认） ====================

/**
 * 一条可用更新。targetId 是**包 id**；meta 基线升级时 targetId 为
 * OFFICIAL_META_ID 且 fromBaseline=true（当前用的还是内置基线）。
 */
export type PackUpdateOffer = {
  kind: string;
  targetId: string;
  /** 当前版本（基线无包头 = 0） */
  currentCode: number;
  newCode: number;
  newName: string;
  /** 更新说明（自管头 notes 或 manifest notes） */
  notes: string;
  /** self = 包自述 updateUrl；manifest = astral 发布渠道 */
  channel: string;
  /** 下载地址（确认后从这里拉全量文件） */
  url: string;
  /** meta 专用：当前生效的是内置基线（更新后首次安装 meta 包） */
  fromBaseline: boolean;
};

/** 最近一次发现的可用更新（内存态；设置页/启动提示共用，装完即清） */
let gOffers: PackUpdateOffer[] = [];

/** 当前可用更新列表（拷贝） */
export function pendingUpdates(): PackUpdateOffer[] {
  const out: PackUpdateOffer[] = [];
  for (let i = 0; i < gOffers.length; i++) out.push(gOffers[i]);
  return out;
}

/** 页面红点监听的事件名（stores/source-update 的响应式镜像接住它，tab 栏与行红点随之刷新） */
export const SOURCE_UPDATE_BADGE_EVENT = "qt-source-update-badge";
/** 有可用更新事件（App.uvue 接住弹确认提示；payload = offers JSON） */
export const SOURCE_UPDATE_FOUND_EVENT = "qt-source-update-found";

/** 是否该亮「有可用更新」红点：发现过至少一条未应用的更新 */
export function hasSourceUpdateBadge(): boolean {
  return gOffers.length > 0;
}

/** 广播红点事件：stores/source-update 统一接住刷新，底部 tab 栏与各页面行红点随之更新 */
export function syncSourceUpdateBadge(): void {
  uni.$emit(SOURCE_UPDATE_BADGE_EVENT);
}

/**
 * 启动时的更新发现（不打扰策略）：
 * - 只做发现 + 广播 SOURCE_UPDATE_FOUND_EVENT，由 App.uvue 弹「仅提示」的确认框；
 * - manifest 渠道按 lastCheckAt 节流；自管 updateUrl 按各包 lastProbeAt 节流
 *   （force=true 双双跳过节流，设置页按钮用）；
 * - 全部失败静默：更新检查不该打断播放。
 */
export async function discoverUpdatesAtStartup(): Promise<PackUpdateOffer[]> {
  try {
    await ensureLocalStateRestored();
    const state = localState();
    const now = Date.now();
    const force = now - state.lastCheckAt >= CHECK_INTERVAL_MS;
    const offers = await discoverUpdates(force);
    if (offers.length > 0) {
      uni.$emit(SOURCE_UPDATE_FOUND_EVENT, offersToJson(offers));
    }
    syncSourceUpdateBadge();
    return offers;
  } catch (_) {
    return [] as PackUpdateOffer[];
  }
}

/**
 * 显式发现更新（设置页按钮与启动共用）：合并两路来源——
 *   ① 已装各包的自述 updateUrl（含 meta 包与 play 包；基线 meta 的 updateUrl
 *      来自内置代码里的包头）；
 *   ② astral manifest（play-bundle.js 产物；未来可加 meta-bundle.js）。
 * 同一包两路都报新版时取 versionCode 更高的一路。
 */
export async function discoverUpdates(force: boolean): Promise<PackUpdateOffer[]> {
  await ensureLocalStateRestored();
  const now = Date.now();
  const found: PackUpdateOffer[] = [];
  // ① 自管 updateUrl（已装包 + meta 基线）
  const installed = packs();
  for (let i = 0; i < installed.length; i++) {
    const pack = installed[i];
    if (pack.updateUrl.length == 0) continue;
    if (!force && now - pack.lastProbeAt < PROBE_INTERVAL_MS) continue;
    const remote = await probePackHeader(pack.updateUrl);
    await touchPackProbe(pack.id, now);
    if (remote == null || remote.id != pack.id || remote.kind != pack.kind) continue;
    if (remote.versionCode <= pack.versionCode) continue;
    if (isPackBadVersion(pack.id, remote.versionCode)) continue;
    found.push(
      offerOf(pack.kind, pack.id, pack.versionCode, remote.versionCode, remote.versionName,
        remote.notes, "self", pack.updateUrl, false),
    );
  }
  // meta 基线的 updateUrl（内置包头的自述；基线版本号无头视为 0）
  const baseline = baselineMetaInfo();
  if (baseline != null && baseline.updateUrl.length > 0) {
    const activeMeta = activeMetaPack();
    // 已装生效 meta 包的设备按它自己的 updateUrl 走（上面 ① 已处理），不重复探基线
    if (activeMeta == null) {
      const remote = await probePackHeader(baseline.updateUrl);
      if (
        remote != null &&
        remote.id == baseline.id &&
        remote.kind == PACK_KIND_META &&
        remote.versionCode > baseline.versionCode &&
        !isPackBadVersion(baseline.id, remote.versionCode)
      ) {
        found.push(
          offerOf(PACK_KIND_META, baseline.id, baseline.versionCode, remote.versionCode,
            remote.versionName, remote.notes, "self", baseline.updateUrl, true),
        );
      }
    }
  }
  // ② manifest 渠道
  const manifest = await fetchManifest();
  await touchLastCheck(now);
  if (manifest != null && manifest.release != null) {
    const release = manifest.release;
    if (release.published && !release.bad && release.rollbackTo <= 0 && containsNum(release.platforms, PLATFORM_ANDROID) && release.hostApiVersion <= HOST_API_VERSION) {
      // play 产物：release 版本号即产物版本
      for (let i = 0; i < release.artifacts.length; i++) {
        const a = release.artifacts[i];
        if (a.path != ARTIFACT_PLAY || a.url.length == 0) continue;
        const local = packById(OFFICIAL_PLAY_ID);
        const currentCode = local != null ? local.versionCode : 0;
        // 版本压制例外：本地官方包从未通过签名校验（签名落地前的历史冒充包）——
        // manifest 真官方更新不按 versionCode 压制，总能提示出来覆盖掉它。
        const unverifiedOfficial = local != null && !local.signVerified;
        if ((a.version <= currentCode && !unverifiedOfficial) || isPackBadVersion(OFFICIAL_PLAY_ID, a.version)) continue;
        if (hasOfferFor(found, OFFICIAL_PLAY_ID, a.version)) continue;
        found.push(
          offerOf(PACK_KIND_PLAY, OFFICIAL_PLAY_ID, currentCode, a.version,
            release.sourceVersionName, release.notes, "manifest", a.url, false),
        );
      }
      // meta 产物（未来发布）：版本号在产物头里，需要探测
      for (let i = 0; i < release.artifacts.length; i++) {
        const a = release.artifacts[i];
        if (a.path != ARTIFACT_META || a.url.length == 0) continue;
        const remote = await probePackHeader(a.url);
        if (remote == null || remote.kind != PACK_KIND_META) continue;
        const localMeta = packById(remote.id);
        const currentCode =
          localMeta != null
            ? localMeta.versionCode
            : baseline != null && baseline.id == remote.id
              ? baseline.versionCode
              : 0;
        // 版本压制例外：本地 meta 官方包从未通过签名校验（历史冒充包）→ 不压制
        const unverifiedMeta = localMeta != null && isOfficialPackId(remote.id) && !localMeta.signVerified;
        if ((remote.versionCode <= currentCode && !unverifiedMeta) || isPackBadVersion(remote.id, remote.versionCode)) continue;
        if (hasOfferFor(found, remote.id, remote.versionCode)) continue;
        found.push(
          offerOf(PACK_KIND_META, remote.id, currentCode, remote.versionCode,
            remote.versionName, release.notes, "manifest", a.url, localMeta == null),
        );
      }
    }
  }
  // 同一包取 versionCode 最高的一条（self 与 manifest 撞车时）
  const deduped = dedupeOffers(found);
  gOffers = deduped;
  return deduped;
}

// ==================== 应用更新（手动确认后） ====================

/**
 * 应用一条可用更新（用户在提示框/设置页点了「更新」）：
 * 下载全量 → 头校验（id/kind/version 必须匹配 offer）→ 走统一替换管线 →
 * 立即生效（play 热注入 + 冒烟；meta 重装引擎槽）。失败自动回滚 .prev。
 */
export async function applyUpdate(offer: PackUpdateOffer, smokeSongs: Song[]): Promise<SourceApplyResult> {
  const text = await downloadText(offer.url);
  if (text.length == 0) {
    return applyResult(false, offer.newCode, "下载失败：更新包拉取为空，请稍后重试");
  }
  const header = parsePackHeader(text);
  if (
    header == null ||
    header.id != offer.targetId ||
    header.kind != offer.kind ||
    header.versionCode != offer.newCode
  ) {
    await notePackError(offer.targetId, "更新包无效：文件头与发现的版本不符");
    return applyResult(false, offer.newCode, "更新包无效：文件头与发现的版本不符");
  }
  const result = await installPackText(
    text,
    header,
    smokeSongs,
    true,
    offer.channel == "manifest" ? "manifest" : "keep",
    "",
  );
  if (result.ok) {
    dropOffer(offer.targetId);
    syncSourceUpdateBadge();
  } else if (result.message.indexOf("已回滚") >= 0 || result.message.indexOf("已回退") >= 0) {
    // 更新失败且已回滚：这个版本拉黑，别再反复提示
    await markPackBad(offer.targetId, offer.newCode);
    dropOffer(offer.targetId);
    syncSourceUpdateBadge();
  }
  // manifest 渠道的官方播放包：把结果回传发布端（灰度观测用；自管渠道没有
  // 服务端记录，不报）。失败静默——上报不该影响本地更新体验。
  if (offer.channel == "manifest" && offer.targetId == OFFICIAL_PLAY_ID) {
    reportResult(offer.newCode, result.ok, result.message).catch((_e) => {});
  }
  return result;
}

// ==================== 统一安装（链接 / 本地文件 / 文本） ====================

/**
 * 从 https 直链安装一个包（官方发布直链、第三方作者的分发链接都走这里）。
 * 只接受 https：包会被引擎当脚本执行，明文 http 一律拒绝。
 * 下载走 uni.downloadFile，不加统一客户端头（第三方直链带自定义头会坏签名/表单校验）。
 */
export async function installFromUrl(url: string, smokeSongs: Song[]): Promise<SourceApplyResult> {
  const link = url.trim();
  if (link.length == 0) {
    return applyResult(false, 0, "链接不能为空");
  }
  if (!link.startsWith("https://")) {
    return applyResult(false, 0, "只支持 https 直链（音源包会被当脚本执行，不接受明文 http）");
  }
  const text = await downloadPackText(link);
  if (text.length == 0) {
    return applyResult(false, 0, "下载失败，请检查链接是否可直连");
  }
  return await installFromText(text, smokeSongs, "url", link);
}

/**
 * 下载一个音源包全文（https 直链校验 + uni.downloadFile 临时文件 + 读回 + 清理）。
 * 管理页「安装预览」流程复用：先拿到全文解析包头给用户确认，确认后再走
 * installFromText 落盘。返回空串 = 下载失败。
 */
export async function downloadPackText(url: string): Promise<string> {
  const link = url.trim();
  if (!link.startsWith("https://")) return "";
  const temp = await downloadToTemp(link);
  if (temp.length == 0) return "";
  const text = await readTextFileAt(temp);
  await removeFileAt(temp);
  return text;
}

/**
 * 从本地 js 文件安装：Android 系统选择器（qt-app-native pickJsFile）拿到的
 * content URI 只有一次读权限，原生侧已把全文读回，直接走 installFromText。
 * fileName 仅作来源备注记录（展示用）。
 */
export async function installFromLocalFile(content: string, smokeSongs: Song[], fileName: string): Promise<SourceApplyResult> {
  if (content.trim().length == 0) {
    return applyResult(false, 0, "未选择文件");
  }
  return await installFromText(content, smokeSongs, "file", fileName);
}

/**
 * 从文本安装（统一管线的入口：解析头 → 校验 → 落盘 → 登记 → 按需生效）。
 * source/ref 记录安装来源（"url"=链接 / "file"=本地文件 / "manifest"=官方渠道），
 * 管理页「安装预览」流程确认后直接调这里落盘。
 */
export async function installFromText(text: string, smokeSongs: Song[], source: string, ref: string): Promise<SourceApplyResult> {
  const header = parsePackHeader(text);
  if (header == null) {
    return applyResult(
      false,
      0,
      "不是有效的音源包：文件首行缺少 /*__QT_PACK__*/ 身份头（需要 2026-10 后构建的包）",
    );
  }
  return await installPackText(text, header, smokeSongs, false, source, ref);
}

/**
 * 统一安装/替换管线（安装与更新共用；isUpdate=true 时失败自动回滚 .prev）。
 *
 * 步骤：
 *   1. 内容校验：play 必须含 __qtPlayPackFactory；meta 靠装载后的 bundleInfo 契约
 *      自检兜底（meta 无工厂标记）。
 *   2. 旧文件暂存 .prev（同 id 替换；全新安装无旧文件）。
 *   3. 落盘 install/<id>/<artifact> + putPack 登记（play 直链/本地安装不带
 *      chain.json，顺手清掉可能残留的旧 chain，保证版本配套）。
 *   4. 生效判定：
 *      play —— 生效位为空（首次）或已生效的就是这个包（更新）→ 热注入 + 冒烟；
 *              生效中的是别的包 → 只落盘不抢生效位；
 *      meta —— 生效位为空（还在用基线）或已生效的就是这个包 → 重装引擎槽；
 *              生效中的是别的 meta 包 → 只落盘。
 *   5. 失败回滚（仅 isUpdate）：恢复 .prev、恢复包记录与生效位、重放旧包；
 *      拉黑与否由调用方（applyUpdate 拉黑，手动重装不拉黑）。
 */
async function installPackText(
  text: string,
  header: PackHeaderInfo,
  smokeSongs: Song[],
  isUpdate: boolean,
  source: string,
  ref: string,
): Promise<SourceApplyResult> {
  await ensureLocalStateRestored();
  const kind = header.kind;
  const id = header.id;
  if (kind != PACK_KIND_META && kind != PACK_KIND_PLAY) {
    return applyResult(false, header.versionCode, `未知包种类：${kind}（只认 meta / play）`);
  }
  if (kind == PACK_KIND_PLAY && text.indexOf(PLAY_PACK_FACTORY_MARKER) < 0) {
    return applyResult(
      false,
      header.versionCode,
      "该文件不是有效的播放包（缺少 " + PLAY_PACK_FACTORY_MARKER + " 导出）",
    );
  }
  // ①′ 官方 id 签名硬校验：官方包同样走直链/本地分发，身份靠签名而非渠道——
  // 验不过（含无签名块）一律拒绝，冒充/篡改的包进不了官方槽；第三方 id 不受影响。
  // 对所有渠道生效（直链/本地/manifest/自管更新），是安装管线的最终闸门。
  let signVerified = false;
  if (isOfficialPackId(id)) {
    const check = await verifyOfficialSignature(text);
    if (!check.ok) {
      console.log(`[SourceUpdate] 官方包签名校验失败 ${id}：${check.message}`);
      return applyResult(false, header.versionCode, "官方包签名校验失败：" + check.message);
    }
    signVerified = true;
  }
  const artifact = artifactOfKind(kind);
  const old = packById(id);
  if (old != null && old.kind != kind) {
    return applyResult(false, header.versionCode, `包 id 冲突：${id} 已被${old.kind == PACK_KIND_META ? "数据" : "播放"}包占用`);
  }
  const now = Date.now();
  // ② 旧文件暂存（更新失败回滚用；新装没有旧文件）
  const prevPath = packDirOf(id) + "/" + artifact + ".prev";
  const mainPath = artifactPath(id, artifact);
  const hadOld = (await readPackArtifact(id, artifact)).length > 0;
  if (hadOld) {
    await ensurePackDir(id);
    await writeTextFileAt(prevPath, await readPackArtifact(id, artifact));
  }
  // ③ 落盘 + 登记
  if (!(await ensurePackDir(id))) {
    return applyResult(false, header.versionCode, "写入失败：无法创建包目录");
  }
  if (!(await writePackArtifact(id, artifact, text))) {
    return applyResult(false, header.versionCode, "写入失败：音源包落盘失败");
  }
  if (kind == PACK_KIND_PLAY) {
    // 链接/本地安装的 play 包自包含（内嵌默认链），残留的旧 chain 会造成
    // 「新播放层配旧线路」，一律清掉
    await removePackArtifact(id, ARTIFACT_CHAIN);
  }
  const meta: SourcePackMeta = {
    id: id,
    kind: kind,
    name: header.name.length > 0 ? header.name : id,
    versionCode: header.versionCode,
    versionName: header.versionName,
    updateUrl: header.updateUrl,
    dir: packDirOf(id),
    installedAt: old != null ? old.installedAt : now,
    updatedAt: now,
    skipCodes: old != null ? old.skipCodes : ([] as number[]),
    lastProbeAt: old != null ? old.lastProbeAt : 0,
    // 来源溯源：source=="keep"（自管更新）保留原安装来源；manifest 渠道改写为官方；
    // 全新安装/直链/本地用传入值。新装清空失败记录（后续失败会重新记）。
    installSource: source == "keep" ? (old != null ? old.installSource : "") : source,
    installRef: source == "keep" ? (old != null ? old.installRef : "") : ref,
    lastError: old != null ? old.lastError : "",
    lastErrorAt: old != null ? old.lastErrorAt : 0,
    // 官方 id 包本次安装已验签；第三方包/自管更新保留原值（自管更新走同一闸门，
    // 验过也会置 true——installPackText 里 signVerified 在此之前已算好）
    signVerified: isOfficialPackId(id) ? signVerified : (source == "keep" && old != null ? old.signVerified : false),
  };
  await putPack(meta);
  await pruneOrphans();
  // ④ 生效判定
  const state = localState();
  if (kind == PACK_KIND_PLAY) {
    const canActivate = state.activeId.length == 0 || state.activeId == id;
    if (!canActivate) {
      // 新版本已替换落盘（旧失败记录针对的是旧文件，清掉）；生效位是别的包，等用户切换
      await clearPackError(id);
      syncSourceUpdateBadge();
      return applyResult(
        true,
        header.versionCode,
        `${meta.name} v${header.versionName} 已落盘（当前生效的是其他播放包，可在列表切换）`,
      );
    }
    await setActive(id);
    const smoke = await applyActivePack(smokeSongs);
    if (!smoke.ok && isUpdate) {
      await rollbackPack(old, id, prevPath, mainPath);
      await notePackError(id, smoke.message);
      return applyResult(false, header.versionCode, `${smoke.message}；已回滚到 ${old != null ? old.versionName : "未安装"}`);
    }
    if (!smoke.ok) {
      // 手动重装失败：保留文件由用户决定（可能是环境问题），仅提示
      return smoke;
    }
    await clearPackError(id);
    syncSourceUpdateBadge();
    return applyResult(
      true,
      header.versionCode,
      `${meta.name} v${header.versionName} 已${old != null ? "更新" : "安装"}并生效`,
    );
  }
  // meta：生效位为空（基线）或就是这个包 → 重装引擎槽
  const metaCanActivate = state.activeMetaId.length == 0 || state.activeMetaId == id;
  if (!metaCanActivate) {
    await clearPackError(id);
    return applyResult(
      true,
      header.versionCode,
      `${meta.name} v${header.versionName} 已落盘（当前生效的是其他数据包，可在列表切换）`,
    );
  }
  await setActiveMeta(id);
  const reloaded = await reloadEngineMeta();
  const verified = reloaded && engineUsable() && loadedMetaCode() == header.versionCode;
  if (!verified) {
    const detail = lastEngineError();
    if (isUpdate || old == null) {
      // 新装/更新的 meta 包验证不过：回滚（新装 = 回基线，更新 = 回旧文件）
      await rollbackPack(old, id, prevPath, mainPath);
      await reloadEngineMeta();
      await notePackError(id, `装载未通过（${detail}）`);
      const target = old != null ? old.versionName : "内置基线";
      return applyResult(false, header.versionCode, `数据包装载未通过（${detail}）；已回退到 ${target}`);
    }
    await notePackError(id, `装载未通过（${detail}）`);
    return applyResult(false, header.versionCode, `数据包装载未通过：${detail}（可在列表卸载后回退基线）`);
  }
  await clearPackError(id);
  syncSourceUpdateBadge();
  return applyResult(
    true,
    header.versionCode,
    `${meta.name} v${header.versionName} 已${old != null ? "更新" : "安装"}并生效`,
  );
}

/** 回滚一个包到 .prev（无旧文件 = 恢复到安装前：未安装 / 内置基线） */
async function rollbackPack(
  old: SourcePackMeta | null,
  id: string,
  prevPath: string,
  mainPath: string,
): Promise<void> {
  try {
    if (old != null) {
      const prev = await readTextFileAt(prevPath);
      if (prev.length > 0) {
        await writeTextFileAt(mainPath, prev);
        await putPack(old);
        await removeFileAt(prevPath);
        return;
      }
    }
    // 没有旧文件可回滚：恢复到安装前状态（未安装 / 基线）
    if (old != null && loadedPlayPackId() == old.id) {
      await unloadPlayPack();
    }
    await removePack(id);
    await removeFileAt(prevPath);
  } catch (e) {
    console.log("[SourceUpdate] 回滚失败：" + `${e}`);
  }
}

// ==================== 生效（play 热注入 + 冒烟） ====================

export type SourceApplyResult = {
  ok: boolean;
  versionCode: number;
  message: string;
};

/**
 * 让 activeId 指向的播放包真正生效：引擎**热注入**（installPlayPack 覆盖当前
 * 播放层，无需重建引擎、不影响 meta 数据面）+ 冒烟自检。
 * 装载失败分类见 source-engine（invalid = 包本身坏；missing/engine/contract =
 * 环境问题）。这里只提示（落盘去留由用户/更新管线决定），冒烟通过后清前端
 * 播放地址缓存（旧链路地址会继续用满 10 分钟 TTL）。
 */
export async function applyActivePack(smokeSongs: Song[]): Promise<SourceApplyResult> {
  await ensureLocalStateRestored();
  const pack = activePack();
  if (pack == null) {
    return applyResult(false, 0, "未选择播放音源包：请在列表中启用一个，或先安装");
  }
  if (playPackReady() && loadedPlayPackId() == pack.id) {
    return applyResult(true, pack.versionCode, "该版本已在生效中");
  }
  const loaded = await ensurePlayPackLoaded();
  if (!loaded) {
    const kind = loadFailureKind();
    const detail = lastEngineError();
    if (kind == "invalid") {
      await notePackError(pack.id, `播放包不可用：${detail}`);
      return applyResult(false, pack.versionCode, `该播放包不可用（已保留在列表，可卸载或重装）：${detail}`);
    }
    await notePackError(pack.id, `播放包未能生效：${detail}`);
    return applyResult(false, pack.versionCode, `播放包未能生效：${detail}`);
  }
  const smoke = await smokeTest(smokeSongs);
  if (!smoke.ok) {
    await notePackError(pack.id, `冒烟自检未通过：${smoke.message}`);
    return applyResult(false, pack.versionCode, `冒烟自检未通过（包已保留在列表，可直接试播）：${smoke.message}`);
  }
  // 新包真正生效：清掉前端播放地址缓存，否则旧链路的地址会继续用满 10 分钟 TTL
  musicApi.clearPlayUrlCache();
  await clearPackError(pack.id);
  syncSourceUpdateBadge();
  return applyResult(true, pack.versionCode, `播放音源包已生效：${pack.name} ${pack.versionName}`);
}

/** 切换生效播放包（设置页列表项「启用」）：setActive 后立即热注入 + 冒烟 */
export async function activatePack(id: string, smokeSongs: Song[]): Promise<SourceApplyResult> {
  await ensureLocalStateRestored();
  const pack = packById(id);
  if (pack == null) {
    return applyResult(false, 0, "该播放包已不存在（可能刚被卸载），请刷新列表");
  }
  if (pack.kind == PACK_KIND_META) {
    if (!(await setActiveMeta(id))) {
      return applyResult(false, pack.versionCode, "切换失败：本地状态写入失败");
    }
    const ok = await reloadEngineMeta();
    if (!ok || loadedMetaCode() != pack.versionCode) {
      await setActiveMeta("");
      await reloadEngineMeta();
      await notePackError(id, `装载未通过：${lastEngineError()}`);
      return applyResult(false, pack.versionCode, `数据包装载未通过：${lastEngineError()}（已回退内置基线）`);
    }
    await clearPackError(id);
    syncSourceUpdateBadge();
    return applyResult(true, pack.versionCode, `数据包已生效：${pack.name} ${pack.versionName}`);
  }
  if (!(await setActive(id))) {
    return applyResult(false, pack.versionCode, "切换生效包失败：本地状态写入失败");
  }
  return await applyActivePack(smokeSongs);
}

/**
 * 切回内置数据包基线（音源包管理页「内置基线」行）：清空生效数据包位并让引擎
 * 重装基线。数据包位空 = 基线（activeMetaId 为空串），与 activatePack 的 meta
 * 分支共用装载管线，但不带版本契约校验（基线随应用分发，信任内嵌资产）。
 */
export async function activateBaselineMeta(): Promise<SourceApplyResult> {
  await ensureLocalStateRestored();
  if (!(await setActiveMeta(""))) {
    return applyResult(false, 0, "切换失败：本地状态写入失败");
  }
  const ok = await reloadEngineMeta();
  if (!ok) {
    return applyResult(false, 0, `内置基线装载未通过：${lastEngineError()}`);
  }
  syncSourceUpdateBadge();
  return applyResult(true, 0, "已切回内置基线数据包");
}

/**
 * 卸载一个包：play → 引擎卸载 + 删目录 + 出列表；meta → 回退生效位（activeMetaId
 * 清空即回内置基线）+ 删目录。卸载生效中的 meta 后引擎重装回基线。
 */
export async function uninstallPack(id: string): Promise<SourceApplyResult> {
  await ensureLocalStateRestored();
  const pack = packById(id);
  if (pack == null) {
    return applyResult(false, 0, "该包已不存在");
  }
  if (pack.kind == PACK_KIND_META) {
    if (!(await removePack(id))) {
      return applyResult(false, pack.versionCode, "卸载失败：本地状态写入失败");
    }
    await reloadEngineMeta();
    musicApi.clearPlayUrlCache();
    dropOffer(id);
    syncSourceUpdateBadge();
    return applyResult(true, pack.versionCode, `已卸载 ${pack.name}（数据包已回退内置基线）`);
  }
  if (loadedPlayPackId() == id) {
    await unloadPlayPack();
  }
  if (!(await removePack(id))) {
    return applyResult(false, pack.versionCode, "卸载失败：本地状态写入失败");
  }
  await pruneOrphans();
  musicApi.clearPlayUrlCache();
  dropOffer(id);
  syncSourceUpdateBadge();
  return applyResult(true, pack.versionCode, `已卸载 ${pack.name} ${pack.versionName}`);
}

// ==================== 冒烟自检 ====================

/** 冒烟结果 */
export type SourceSmokeResult = { ok: boolean; message: string };

/**
 * 冒烟自检：对候选曲目逐个取链 + Range 预检，任一成功即算通过。
 * 每首最多试 2 次（网络抖动不该判死一个好包）。
 */
export async function smokeTest(songs: Song[]): Promise<SourceSmokeResult> {
  if (songs.length == 0) {
    // 没有候选曲目就跳过自检（宁可不检，也不能凭空判失败）
    return { ok: true, message: "无候选曲目，跳过冒烟" } as SourceSmokeResult;
  }
  let lastMessage = "";
  for (let i = 0; i < songs.length; i++) {
    const song = songs[i];
    for (let attempt = 0; attempt < 2; attempt++) {
      const url = await getPlayUrlByEngine(song, "128");
      if (url.length == 0) {
        lastMessage = `${song.name} 取链为空`;
        continue;
      }
      const playable = await verifyPlayableByEngine(url);
      if (playable) {
        return { ok: true, message: `${song.name} 取链+预检通过` } as SourceSmokeResult;
      }
      lastMessage = `${song.name} Range 预检未通过`;
    }
  }
  return { ok: false, message: lastMessage } as SourceSmokeResult;
}

/**
 * 冒烟自检的候选曲目：按固定关键词在酷我搜前 5 首（搜索走 meta，不需要播放包）。
 * 不写死歌曲 ID——歌会下架、接口会变，用搜索结果更抗老化；
 * smokeTest 会逐个尝试，任一成功即通过，所以列表里有没有免费歌都能兜住。
 */
export async function pickSmokeSongs(): Promise<Song[]> {
  try {
    const results = await musicApi.search(SMOKE_KEYWORD, "kw", "song", 1, 5);
    return results;
  } catch (e) {
    return [] as Song[];
  }
}

/** 冒烟搜索关键词（选最常见的歌名，保证各源都有结果） */
const SMOKE_KEYWORD = "晴天";

// ==================== manifest 渠道（astral 发布接口） ====================

/** manifest 里的产物条目 */
export type SourceArtifact = {
  path: string;
  /** 单文件版本号（play = release 发号；meta 实际版本以产物头为准） */
  version: number;
  url: string;
};

/** manifest 里的 release 节点 */
export type SourceRelease = {
  sourceVersionCode: number;
  sourceVersionName: string;
  platforms: number[];
  hostApiVersion: number;
  channel: string;
  notes: string;
  publishedAt: string;
  rollbackTo: number;
  bad: boolean;
  /** 是否已发布（缺失视为已发布，服务端本应预筛撤回版本） */
  published: boolean;
  artifacts: SourceArtifact[];
};

export type SourceManifest = {
  schema: number;
  generatedAt: string;
  release: SourceRelease | null;
};

function requestJson(
  url: string,
  method: "GET" | "POST",
  data: UTSJSONObject | null
): Promise<UTSJSONObject | null> {
  return new Promise<UTSJSONObject | null>((resolve) => {
    const headers = new UTSJSONObject();
    headers.set("Content-Type", "application/json");
    // astral 网关请求：本地有 satoken 就携带（后端据此识别测试人群），未登录不带
    const token = getAccessToken();
    if (token.length > 0) {
      headers.set("satoken", token);
    }
    // 统一客户端系统头（X-App-Ut / X-App-Version / X-Device / X-OS）：
    // 本文件的 url 由调用方 resolveUrl() 得到，恒为 astral 网关，直接合并。
    mergeClientHeaders(headers);
    uni.request({
      url: url,
      method: method,
      data: data != null ? data : new UTSJSONObject(),
      header: headers,
      timeout: MANIFEST_TIMEOUT_MS,
      success: (response) => {
        const status = response.statusCode;
        if (status < 200 || status >= 300) {
          resolve(null);
          return;
        }
        const body = response.data as UTSJSONObject | null;
        if (body == null) {
          resolve(null);
          return;
        }
        const code = body.get("code");
        if (code == null) {
          resolve(null);
          return;
        }
        const n = code as number;
        if (n == 0 || n == 200) {
          resolve(body);
        } else {
          resolve(null);
        }
      },
      fail: (error) => {
        console.log("[SourceUpdate] 请求失败：" + `${error}`);
        resolve(null);
      },
    });
  });
}

/** 拉取 manifest（QtRestResp 包装：{code:200, data:{schema, generatedAt, release}}；服务端已预筛，至多一条 release） */
export async function fetchManifest(): Promise<SourceManifest | null> {
  const appCode = getCurrentVersionCode();
  // channel 入参已随后端接口删除（测试人群识别改走 satoken 请求头，见 requestJson）
  let path =
    "app/source/manifest?platform=" +
    PLATFORM_ANDROID +
    "&hostApiVersion=" +
    HOST_API_VERSION;
  // 版本号取不到时（0）不带该参数：服务端对「未提供」应视为不限制，
  // 否则本机会被准入表整体挡在门外（宁可多给一个包，也不能谁都拿不到）。
  if (appCode > 0) {
    path += "&appVersionCode=" + appCode;
  }
  const body = await requestJson(resolveUrl(path), "GET", null);
  if (body == null) return null;
  const data = body.get("data") as UTSJSONObject | null;
  if (data == null) return null;
  return manifestFromJson(data);
}

/** 上报更新结果（manifest 渠道的官方播放包专用；自管渠道没有服务端记录） */
export async function reportResult(
  sourceVersionCode: number,
  ok: boolean,
  detail: string
): Promise<void> {
  const data = new UTSJSONObject();
  data.set("platform", PLATFORM_ANDROID);
  data.set("appVersionCode", getCurrentVersionCode());
  data.set("appVersionName", getCurrentVersionName());
  data.set("sourceVersionCode", sourceVersionCode);
  data.set("result", ok ? "ok" : "smoke_failed");
  data.set("detail", detail.length > 1000 ? detail.substring(0, 1000) : detail);
  await requestJson(resolveUrl("app/source/report"), "POST", data);
}

// ==================== 下载与头探测 ====================

/** uni.downloadFile → 临时文件绝对路径；失败返回 "" */
function downloadToTemp(url: string): Promise<string> {
  return new Promise<string>((resolve) => {
    uni.downloadFile({
      url: url,
      timeout: DOWNLOAD_TIMEOUT_MS,
      success: (res) => {
        if (res.statusCode >= 200 && res.statusCode < 300) {
          resolve(res.tempFilePath);
        } else {
          resolve("");
        }
      },
      fail: (error) => {
        console.log("[SourceUpdate] 下载失败：" + `${error}`);
        resolve("");
      },
    });
  });
}

/** 下载一个产物到内存文本（安装/更新的「先下后写」用）；失败返回 "" */
async function downloadText(url: string): Promise<string> {
  const temp = await downloadToTemp(url);
  if (temp.length == 0) return "";
  const text = await readTextFileAt(temp);
  // 临时文件在 cache 目录系统会回收，这里顺手清掉
  await removeFileAt(temp);
  return text;
}

/**
 * 探测一个包直链的文件头（不用下载整个文件）：
 * GET + Range: bytes=0-4095 —— 支持 Range 的服务器回 206（省流量），
 * 不支持的回 200 全量（数据已在手，同样只用头部解析）。
 * 只解析首行 __QT_PACK__ 头；URL 是第三方直链，绝不合并客户端系统头。
 */
export function probePackHeader(url: string): Promise<PackHeaderInfo | null> {
  return new Promise<PackHeaderInfo | null>((resolve) => {
    if (!url.startsWith("https://")) {
      resolve(null);
      return;
    }
    const headers = new UTSJSONObject();
    headers.set("Range", "bytes=0-" + (PROBE_RANGE_BYTES - 1));
    uni.request({
      url: url,
      method: "GET",
      header: headers,
      timeout: PROBE_TIMEOUT_MS,
      success: (response) => {
        const status = response.statusCode;
        if (status != 206 && status != 200) {
          resolve(null);
          return;
        }
        const data = response.data;
        if (data == null) {
          resolve(null);
          return;
        }
        resolve(parsePackHeader(`${data}`));
      },
      fail: (_) => {
        resolve(null);
      },
    });
  });
}

// ==================== JSON ↔ 类型 ====================

function manifestFromJson(o: UTSJSONObject): SourceManifest {
  const releaseJson = o.get("release") as UTSJSONObject | null;
  return {
    schema: numOf(o, "schema"),
    generatedAt: strOf(o, "generatedAt"),
    release: releaseJson != null ? releaseFromJson(releaseJson) : null,
  } as SourceManifest;
}

function releaseFromJson(o: UTSJSONObject): SourceRelease {
  const platforms: number[] = [];
  const platformsJson = o.get("platforms") as number[] | null;
  if (platformsJson != null) {
    for (let i = 0; i < platformsJson.length; i++) {
      const n = platformsJson[i] as number;
      if (n != null) platforms.push(n);
    }
  }
  const artifacts: SourceArtifact[] = [];
  const artifactsJson = o.get("artifacts") as UTSJSONObject[] | null;
  if (artifactsJson != null) {
    for (let i = 0; i < artifactsJson.length; i++) {
      const a = artifactsJson[i];
      artifacts.push({
        path: strOf(a, "path"),
        version: numOf(a, "version"),
        url: strOf(a, "url"),
      } as SourceArtifact);
    }
  }
  return {
    sourceVersionCode: numOf(o, "sourceVersionCode"),
    sourceVersionName: strOf(o, "sourceVersionName"),
    platforms: platforms,
    hostApiVersion: numOf(o, "hostApiVersion"),
    channel: strOf(o, "channel"),
    notes: strOf(o, "notes"),
    publishedAt: strOf(o, "publishedAt"),
    rollbackTo: numOf(o, "rollbackTo"),
    bad: boolOfDefault(o, "bad", false),
    // 字段缺失视为已发布（与 qt-pc 的 null_as_published 容错一致）
    published: boolOfDefault(o, "published", true),
    artifacts: artifacts,
  } as SourceRelease;
}

function offerOf(
  kind: string,
  targetId: string,
  currentCode: number,
  newCode: number,
  newName: string,
  notes: string,
  channel: string,
  url: string,
  fromBaseline: boolean,
): PackUpdateOffer {
  return {
    kind: kind,
    targetId: targetId,
    currentCode: currentCode,
    newCode: newCode,
    newName: newName,
    notes: notes,
    channel: channel,
    url: url,
    fromBaseline: fromBaseline,
  } as PackUpdateOffer;
}

/** offers → JSON（事件 payload 用；UTSJSONObject 手工组装） */
function offersToJson(list: PackUpdateOffer[]): string {
  const arr: UTSJSONObject[] = [];
  for (let i = 0; i < list.length; i++) {
    const o = new UTSJSONObject();
    o.set("kind", list[i].kind);
    o.set("targetId", list[i].targetId);
    o.set("currentCode", list[i].currentCode);
    o.set("newCode", list[i].newCode);
    o.set("newName", list[i].newName);
    o.set("notes", list[i].notes);
    o.set("channel", list[i].channel);
    o.set("url", list[i].url);
    o.set("fromBaseline", list[i].fromBaseline);
    arr.push(o);
  }
  const root = new UTSJSONObject();
  root.set("offers", arr);
  return JSON.stringify(root);
}

/** 事件 payload → offers（App.uvue 接住 SOURCE_UPDATE_FOUND_EVENT 用） */
export function offersFromJson(payload: string): PackUpdateOffer[] {
  const out: PackUpdateOffer[] = [];
  try {
    const root = JSON.parse(payload) as UTSJSONObject;
    const arr = root.get("offers") as UTSJSONObject[] | null;
    if (arr == null) return out;
    for (let i = 0; i < arr.length; i++) {
      const o = arr[i];
      out.push(
        offerOf(
          strOf(o, "kind"),
          strOf(o, "targetId"),
          numOf(o, "currentCode"),
          numOf(o, "newCode"),
          strOf(o, "newName"),
          strOf(o, "notes"),
          strOf(o, "channel"),
          strOf(o, "url"),
          boolOfDefault(o, "fromBaseline", false),
        ),
      );
    }
  } catch (_) {}
  return out;
}

/** 更新提示的一行文案（弹窗/列表共用） */
export function offerLabel(o: PackUpdateOffer): string {
  const kindLabel = o.kind == PACK_KIND_META ? "数据包" : "播放包";
  const from = o.fromBaseline ? "内置基线" : `v${o.currentCode}`;
  return `${kindLabel}有新版本：v${from} → v${o.newCode}（${o.newName}）`;
}

/** 应用成功（或拉黑）后从内存清单里去掉对应 offer */
function dropOffer(targetId: string): void {
  const kept: PackUpdateOffer[] = [];
  for (let i = 0; i < gOffers.length; i++) {
    if (gOffers[i].targetId != targetId) kept.push(gOffers[i]);
  }
  gOffers = kept;
}

/** found 里是否已有某包某版本的 offer（manifest 与 self 渠道去重） */
function hasOfferFor(found: PackUpdateOffer[], targetId: string, newCode: number): boolean {
  for (let i = 0; i < found.length; i++) {
    if (found[i].targetId == targetId && found[i].newCode == newCode) return true;
  }
  return false;
}

/** 同一包的多个 offer 取 versionCode 最高的 */
function dedupeOffers(found: PackUpdateOffer[]): PackUpdateOffer[] {
  const out: PackUpdateOffer[] = [];
  for (let i = 0; i < found.length; i++) {
    let j = 0;
    let replaced = false;
    for (; j < out.length; j++) {
      if (out[j].targetId == found[i].targetId) {
        if (found[i].newCode > out[j].newCode) out[j] = found[i];
        replaced = true;
        break;
      }
    }
    if (!replaced) out.push(found[i]);
  }
  return out;
}

function applyResult(ok: boolean, code: number, message: string): SourceApplyResult {
  return { ok: ok, versionCode: code, message: message } as SourceApplyResult;
}

function containsNum(list: number[], v: number): boolean {
  for (let i = 0; i < list.length; i++) {
    if (list[i] == v) return true;
  }
  return false;
}

function strOf(o: UTSJSONObject, key: string): string {
  const v = o.get(key);
  if (v == null) return "";
  return `${v}`;
}

function numOf(o: UTSJSONObject, key: string): number {
  const v = o.get(key);
  if (v == null) return 0;
  const n = v as number;
  if (n == null) return 0;
  return n;
}

function boolOfDefault(o: UTSJSONObject, key: string, d: boolean): boolean {
  const v = o.get(key);
  if (v == null) return d;
  const b = v as boolean;
  if (b == null) return d;
  return b;
}
