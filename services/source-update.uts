/**
 * 播放音源包热更新与安装（双包架构，v2 多包版）
 *
 * 只管**播放包**（play-bundle.js）：官方 manifest 检查/下载/原地替换 +
 * 用户直链安装 custom 包。元数据包（meta-bundle.js）内置在代码里
 * （services/source-meta-code.uts），不经本文件。
 *
 * 判定顺序（与 qt-pc source_update.rs 的 decide_update 同口径）：
 *   1. 拉 manifest（服务端已按平台/准入预筛，返回至多一条 release）
 *   2. 无 release → 「远端没有可用播放包」
 *   3. 不面向本平台 / 未发布（已撤回）→ 各自提示，不动本地
 *   4. hostApiVersion > 本机契约 → 「需要更高版本的 App」
 *   5. 服务端 rollbackTo / bad 命中本地版本 → 移除官方包（回退到「未安装」）
 *   6. 本地 bad[] 含该 code → 跳过（此前装载失败）
 *   7. 官方包未安装 → 全新安装（含冒烟）；远端 > 本地 → 更新；
 *      == → 已是最新；< → 拒绝降级
 *
 * 生效策略：官方包安装/更新后，仅当当前**没有生效包或生效的就是官方包**时才
 * 自动激活并冒烟；生效中的是自定义包时不抢激活（用户在列表里自己切换）。
 * custom 直链包**从不自动激活**——多包并存、装完由用户挑一个生效正是本设计的
 * 核心用法。
 *
 * 「落盘」不等于「生效」：生效 = 引擎热注入（installPlayPack，无需重建引擎）
 * + 冒烟自检（取链 + Range 预检）。官方包装载/冒烟失败 → 拉黑该版本 + 移除 +
 * 上报；custom 包失败 → 保留在列表（用户手装的，去留由用户决定），只提示。
 */

import type { Song } from "@/types/music";
import { resolveUrl } from "@/services/http";
import { mergeClientHeaders } from "@/services/client-info";
import { getAccessToken } from "@/services/auth";
import { getCurrentVersionCode, getCurrentVersionName } from "@/services/app-version";
import { musicApi } from "@/services/music-api";
import type { PlayPackMeta } from "@/services/source-bundle-fs";
import {
  localState,
  officialPack,
  activePack,
  packById,
  setActive,
  putPack,
  setPreviousOfficial,
  removePack,
  isBad,
  markBad,
  touchLastCheck,
  ensureLocalStateRestored,
  ensurePackDir,
  writePackArtifact,
  removePackArtifact,
  readTextFileAt,
  removeFileAt,
  customPackId,
  pruneOrphans,
  packDirOf,
  OFFICIAL_PACK_ID,
  PACK_SOURCE_CUSTOM,
  ARTIFACT_CHAIN,
  ARTIFACT_PLAY,
} from "@/services/source-bundle-fs";
import {
  ensurePlayPackLoaded,
  unloadPlayPack,
  getPlayUrlByEngine,
  verifyPlayableByEngine,
  loadedPlayPackId,
  playPackReady,
  loadFailureKind,
  lastEngineError,
} from "@/services/source-engine";

/** 平台常量（与 astral 的 qt_app_update.type 同源） */
export const PLATFORM_ANDROID = 1101;
export const PLATFORM_WINDOWS = 1103;
/** 本机支持的宿主契约版本（与 source-engine 里的一致） */
const HOST_API_VERSION = 1;
const MANIFEST_TIMEOUT_MS = 10000;
const DOWNLOAD_TIMEOUT_MS = 60000;
/** 启动静默检查的最小间隔（4 小时；只对已装官方包的设备生效） */
const SILENT_INTERVAL_MS = 4 * 60 * 60 * 1000;
/** 播放包主体必须含的工厂标记（meta 的 installPlayPack 契约） */
const PLAY_PACK_FACTORY_MARKER = "__qtPlayPackFactory";

/** 最近一次检查拿到的远端信息（设置页展示「远端最新 / 更新说明」，与 qt-pc 一致只放内存） */
export type SourceRemoteInfo = {
  versionCode: number;
  versionName: string;
  notes: string;
  channel: string;
  checkedAt: number;
};

let gRemote: SourceRemoteInfo | null = null;

/** 最近一次检查的远端结果（null = 本次启动还没检查过） */
export function lastRemoteInfo(): SourceRemoteInfo | null {
  return gRemote;
}

/** 页面红点监听的事件名（stores/source-update 的响应式镜像接住它，tab 栏与行红点随之刷新） */
export const SOURCE_UPDATE_BADGE_EVENT = "qt-source-update-badge";

/**
 * 是否该亮「有新音源包」红点：已装官方包且远端有更高版本。
 * 更新装好（官方包 versionCode 追平远端）后红点自然消失。
 */
export function hasSourceUpdateBadge(): boolean {
  const remote = gRemote;
  if (remote == null) return false;
  const official = officialPack();
  if (official == null) return false;
  return remote.versionCode > official.versionCode;
}

/** 广播红点事件：stores/source-update 统一接住刷新，底部 tab 栏与各页面行红点随之更新 */
export function syncSourceUpdateBadge(): void {
  uni.$emit(SOURCE_UPDATE_BADGE_EVENT);
}

/**
 * 启动静默检查：只对**已安装官方包**的设备生效（首装是用户显式动作，交给设置页），
 * 不弹任何 UI；失败静默——音源包检查不该打扰播放。查到新版就走完整更新
 * （下载 → 原地替换 → 自动激活（如允许）→ 冒烟），官方包冒烟失败自动回退移除。
 */
export async function checkSourceUpdateSilently(): Promise<void> {
  try {
    await ensureLocalStateRestored();
    if (officialPack() == null) {
      // 没装官方包：不打扰，等用户进设置页显式「检查更新」安装
      return;
    }
    const state = localState();
    const now = Date.now();
    if (now - state.lastCheckAt < SILENT_INTERVAL_MS) return;
    await checkSourceUpdate(false);
  } catch (_) {}
  syncSourceUpdateBadge();
}

// ==================== 检查（判定 + 触发安装/更新） ====================

/** manifest 里的产物条目 */
export type SourceArtifact = {
  path: string;
  /** 单文件版本号（取代 sha256 的角色） */
  version: number;
  url: string;
};

/** manifest 里的 release 节点 */
export type SourceRelease = {
  sourceVersionCode: number;
  sourceVersionName: string;
  platforms: number[];
  hostApiVersion: number;
  channel: string;
  notes: string;
  publishedAt: string;
  rollbackTo: number;
  bad: boolean;
  /** 是否已发布（缺失视为已发布，服务端本应预筛撤回版本） */
  published: boolean;
  artifacts: SourceArtifact[];
};

export type SourceManifest = {
  schema: number;
  generatedAt: string;
  release: SourceRelease | null;
};

/** 检查结果（给设置页展示用） */
export type SourceCheckResult = {
  /**
   * none=没动作 / up_to_date=已是最新 / updated=已安装或更新并生效 /
   * downloaded=已落盘未激活（生效中的是自定义包）/ rolled_back=已按远端要求移除 /
   * blocked=被拦下（契约/坏包）/ failed=安装或冒烟失败
   */
  action: string;
  versionCode: number;
  versionName: string;
  message: string;
};

/**
 * 显式检查更新（设置页按钮与静默检查共用）：判定 + 必要时安装/更新。
 * force=true 预留给设置页（本函数不做节流，节流在 checkSourceUpdateSilently）。
 */
export async function checkSourceUpdate(force: boolean): Promise<SourceCheckResult> {
  const result = await decideSourceUpdate();
  // gRemote 在判定中可能刷新（影响红点），统一在出口广播一次
  syncSourceUpdateBadge();
  return result;
}

async function decideSourceUpdate(): Promise<SourceCheckResult> {
  await ensureLocalStateRestored();
  const now = Date.now();
  const manifest = await fetchManifest();
  await touchLastCheck(now);
  if (manifest == null) {
    return checkResult("none", 0, "", "检查更新失败：网络异常或服务暂不可用，请稍后重试");
  }
  const release = manifest.release;
  if (release == null) {
    gRemote = null;
    syncSourceUpdateBadge();
    return checkResult("none", 0, "", "远端没有可用播放包");
  }
  gRemote = {
    versionCode: release.sourceVersionCode,
    versionName: release.sourceVersionName,
    notes: release.notes,
    channel: release.channel,
    checkedAt: now,
  };
  // ① 平台
  if (!containsNum(release.platforms, PLATFORM_ANDROID)) {
    return checkResult("none", release.sourceVersionCode, release.sourceVersionName, "该播放包不面向本平台");
  }
  // ② 发布状态
  if (!release.published) {
    return checkResult("none", release.sourceVersionCode, release.sourceVersionName, "该版本已撤回或未发布");
  }
  // ③ 宿主契约
  if (release.hostApiVersion > HOST_API_VERSION) {
    return checkResult(
      "blocked",
      release.sourceVersionCode,
      release.sourceVersionName,
      "该播放包需要更高版本的应用，请先升级 App",
    );
  }
  const official = officialPack();
  // ④ 服务端要求回退 / 标坏：命中本地已装版本才动作
  if (release.rollbackTo > 0 || release.bad) {
    if (official != null && official.versionCode == release.sourceVersionCode) {
      const reason = release.bad ? "该版本已被服务端标记为问题版本，官方播放包已移除" : `远端已撤回该版本，官方播放包已移除（回退目标 v${release.rollbackTo}）`;
      await removeOfficialFromDevice();
      return checkResult("rolled_back", release.sourceVersionCode, release.sourceVersionName, reason);
    }
    if (release.rollbackTo > 0 && official != null && official.versionCode == release.rollbackTo) {
      return checkResult("up_to_date", official.versionCode, official.versionName, "官方播放包已在回退目标版本");
    }
    return checkResult(
      "none",
      release.sourceVersionCode,
      release.sourceVersionName,
      "远端要求回退到 v" + release.rollbackTo + "，本地未安装受影响版本",
    );
  }
  // ⑤ 本地坏包名单
  if (isBad(release.sourceVersionCode)) {
    return checkResult(
      "blocked",
      release.sourceVersionCode,
      release.sourceVersionName,
      "该版本此前装载失败，已跳过（卸载官方包并重新检查可重试）",
    );
  }
  // ⑥ 版本比较
  if (official == null) {
    // 首次安装：manifest 是官方播放包唯一的获取渠道（仓库不内置、也不放下载直链）
    return await installOfficialRelease(release, now);
  }
  if (release.sourceVersionCode < official.versionCode) {
    return checkResult("none", official.versionCode, official.versionName, "拒绝降级：远端版本不高于本地");
  }
  if (release.sourceVersionCode == official.versionCode) {
    return checkResult("up_to_date", official.versionCode, official.versionName, "官方播放包已是最新版本");
  }
  return await installOfficialRelease(release, now);
}

// ==================== 官方包安装/更新 ====================

/**
 * 把一个官方 release 落盘并按需激活（installOfficialRelease）：
 *   1. 全部产物先下到内存再落盘（中途失败不清掉旧官方包——原地替换不能留半新半旧）
 *   2. play-bundle.js 必须含 __qtPlayPackFactory（外层冒烟，防 manifest 指错文件）
 *   3. manifest 没列 chain.json 时清掉旧官方包可能留下的 chain（版本必须配套）
 *   4. 激活条件：当前无生效包或生效的就是官方包；生效中的是自定义包时不抢
 *   5. 激活走 applyActivePack（热注入 + 冒烟），失败自动拉黑移除（见其注释）
 */
async function installOfficialRelease(release: SourceRelease, now: number): Promise<SourceCheckResult> {
  const code = release.sourceVersionCode;
  if (code <= 0) {
    return checkResult("none", 0, "", "远端版本号无效");
  }
  // 收集清单：play 必需，chain 可选
  let playUrl = "";
  let chainUrl = "";
  for (let i = 0; i < release.artifacts.length; i++) {
    const a = release.artifacts[i];
    if (a.path == ARTIFACT_PLAY && a.url.length > 0) {
      playUrl = a.url;
    } else if (a.path == ARTIFACT_CHAIN && a.url.length > 0) {
      chainUrl = a.url;
    }
  }
  if (playUrl.length == 0) {
    return checkResult("none", code, release.sourceVersionName, "远端清单缺少 " + ARTIFACT_PLAY + "，无法安装");
  }
  // ① 全部先下到内存（失败早退，不动磁盘上的旧官方包）
  const playText = await downloadText(playUrl);
  if (playText.length == 0) {
    return checkResult("failed", code, release.sourceVersionName, "下载失败：播放包主体拉取为空，请稍后重试");
  }
  if (playText.indexOf(PLAY_PACK_FACTORY_MARKER) < 0) {
    return checkResult("failed", code, release.sourceVersionName, "远端播放包无效：缺少 " + PLAY_PACK_FACTORY_MARKER + " 导出");
  }
  let chainText = "";
  if (chainUrl.length > 0) {
    chainText = await downloadText(chainUrl);
    if (chainText.length == 0) {
      return checkResult("failed", code, release.sourceVersionName, "下载失败：线路覆盖层拉取为空，请稍后重试");
    }
  }
  // ② 落盘（原地替换 official 目录）
  if (!(await ensurePackDir(OFFICIAL_PACK_ID))) {
    return checkResult("failed", code, release.sourceVersionName, "写入失败：无法创建官方播放包目录");
  }
  if (!(await writePackArtifact(OFFICIAL_PACK_ID, ARTIFACT_PLAY, playText))) {
    return checkResult("failed", code, release.sourceVersionName, "写入失败：播放包落盘失败");
  }
  if (chainText.length > 0) {
    if (!(await writePackArtifact(OFFICIAL_PACK_ID, ARTIFACT_CHAIN, chainText))) {
      return checkResult("failed", code, release.sourceVersionName, "写入失败：线路覆盖层落盘失败");
    }
  } else {
    // 本版 manifest 不发 chain：清掉旧官方包的 chain，避免新播放层配旧线路
    await removePackArtifact(OFFICIAL_PACK_ID, ARTIFACT_CHAIN);
  }
  // ③ 登记包记录（official 原地覆盖；记下被覆盖的旧版本供诊断）
  const old = officialPack();
  const meta: PlayPackMeta = {
    id: OFFICIAL_PACK_ID,
    name: "官方播放包",
    versionCode: code,
    versionName: release.sourceVersionName,
    source: "official",
    dir: packDirOf(OFFICIAL_PACK_ID),
    installedAt: now,
  };
  await putPack(meta);
  if (old != null && old.versionCode != code) {
    await setPreviousOfficial(old);
  }
  await pruneOrphans();
  // ④ 激活（不抢自定义包的生效位）
  const state = localState();
  const activateAllowed = state.activeId.length == 0 || state.activeId == OFFICIAL_PACK_ID;
  if (!activateAllowed) {
    syncSourceUpdateBadge();
    return checkResult(
      "downloaded",
      code,
      release.sourceVersionName,
      `官方播放包已更新到 ${release.sourceVersionName}（当前生效的是自定义包，可在列表切换）`,
    );
  }
  await setActive(OFFICIAL_PACK_ID);
  const smokeSongs = await pickSmokeSongs();
  const applied = await applyActivePack(smokeSongs);
  syncSourceUpdateBadge();
  if (!applied.ok) {
    return checkResult("failed", code, release.sourceVersionName, applied.message);
  }
  const verb = old == null ? "已安装并生效" : "已更新并生效";
  return checkResult("updated", code, release.sourceVersionName, `官方播放包 v${release.sourceVersionName} ${verb}`);
}

/** 移除官方包（远端回退/标坏、或装载冒烟失败后的清理）：先从引擎卸掉再删盘 */
async function removeOfficialFromDevice(): Promise<void> {
  if (loadedPlayPackId() == OFFICIAL_PACK_ID) {
    await unloadPlayPack();
  }
  await removePack(OFFICIAL_PACK_ID);
  await pruneOrphans();
  musicApi.clearPlayUrlCache();
  syncSourceUpdateBadge();
}

// ==================== 生效（热注入 + 冒烟自检） ====================

export type SourceApplyResult = {
  ok: boolean;
  versionCode: number;
  message: string;
};

/**
 * 让 activeId 指向的播放包真正生效：引擎**热注入**（installPlayPack 覆盖当前
 * 播放层，无需重建引擎、不影响 meta 数据面）+ 冒烟自检。
 *
 * 失败处理（见 source-engine 的 SourceLoadFailure）：
 *   - invalid（包本身坏）→ 官方包：拉黑 + 移除 + 上报（自动回退到「未安装」，
 *     多包下用户还装了别的包可在列表启用）；custom 包：保留在列表，仅提示；
 *   - missing/engine/contract（环境问题）→ 只提示，不拉黑不删包。
 * 冒烟同口径：官方失败移除拉黑上报，custom 失败保留。
 *
 * @param smokeSongs 冒烟候选曲目（调用方 pickSmokeSongs 给，通常 1~5 首）
 */
export async function applyActivePack(smokeSongs: Song[]): Promise<SourceApplyResult> {
  await ensureLocalStateRestored();
  const pack = activePack();
  if (pack == null) {
    return applyResult(false, 0, "未选择播放音源包：请在列表中启用一个，或安装官方包");
  }
  const isOfficial = pack.source != PACK_SOURCE_CUSTOM;
  if (playPackReady() && loadedPlayPackId() == pack.id) {
    return applyResult(true, pack.versionCode, "该版本已在生效中");
  }
  const loaded = await ensurePlayPackLoaded();
  if (!loaded) {
    const kind = loadFailureKind();
    const detail = lastEngineError();
    if (kind == "invalid") {
      if (isOfficial) {
        await markBad(pack.versionCode);
        await removeOfficialFromDevice();
        await reportResult(pack.versionCode, false, "装载失败：" + detail);
        return applyResult(false, pack.versionCode, "官方播放包不可用，已移除并拉黑该版本：" + detail);
      }
      return applyResult(false, pack.versionCode, `自定义播放包未能生效（已保留在列表）：${detail}`);
    }
    return applyResult(false, pack.versionCode, `播放包未能生效：${detail}`);
  }
  const smoke = await smokeTest(smokeSongs);
  if (!smoke.ok) {
    if (isOfficial) {
      await markBad(pack.versionCode);
      await removeOfficialFromDevice();
      await reportResult(pack.versionCode, false, "冒烟自检失败：" + smoke.message);
      return applyResult(false, pack.versionCode, "冒烟自检未通过，官方播放包已移除：" + smoke.message);
    }
    return applyResult(false, pack.versionCode, `冒烟自检未通过（自定义包已保留在列表，可直接试播）：${smoke.message}`);
  }
  // 新包真正生效：清掉前端播放地址缓存，否则旧链路的地址会继续用满 10 分钟 TTL
  musicApi.clearPlayUrlCache();
  if (isOfficial) {
    await reportResult(pack.versionCode, true, "冒烟通过：" + smoke.message);
  }
  syncSourceUpdateBadge();
  return applyResult(true, pack.versionCode, `播放音源包已生效：${pack.name} ${pack.versionName}`);
}

/** 切换生效包（设置页列表项「启用」）：setActive 后立即热注入 + 冒烟 */
export async function activatePack(id: string, smokeSongs: Song[]): Promise<SourceApplyResult> {
  await ensureLocalStateRestored();
  const pack = packById(id);
  if (pack == null) {
    return applyResult(false, 0, "该播放包已不存在（可能刚被卸载），请刷新列表");
  }
  if (!(await setActive(id))) {
    return applyResult(false, pack.versionCode, "切换生效包失败：本地状态写入失败");
  }
  return await applyActivePack(smokeSongs);
}

/** 卸载一个播放包（设置页列表项「卸载」）：引擎卸载 → 删目录 → 出列表 */
export async function uninstallPack(id: string): Promise<SourceApplyResult> {
  await ensureLocalStateRestored();
  const pack = packById(id);
  if (pack == null) {
    return applyResult(false, 0, "该播放包已不存在");
  }
  if (loadedPlayPackId() == id) {
    await unloadPlayPack();
  }
  if (!(await removePack(id))) {
    return applyResult(false, pack.versionCode, "卸载失败：本地状态写入失败");
  }
  await pruneOrphans();
  musicApi.clearPlayUrlCache();
  syncSourceUpdateBadge();
  return applyResult(true, pack.versionCode, `已卸载 ${pack.name} ${pack.versionName}`);
}

// ==================== 冒烟自检 ====================

/** 冒烟结果 */
export type SourceSmokeResult = { ok: boolean; message: string };

/**
 * 冒烟自检：对候选曲目逐个取链 + Range 预检，任一成功即算通过。
 * 每首最多试 2 次（网络抖动不该判死一个好包）。
 */
export async function smokeTest(songs: Song[]): Promise<SourceSmokeResult> {
  if (songs.length == 0) {
    // 没有候选曲目就跳过自检（宁可不检，也不能凭空判失败）
    return { ok: true, message: "无候选曲目，跳过冒烟" } as SourceSmokeResult;
  }
  let lastMessage = "";
  for (let i = 0; i < songs.length; i++) {
    const song = songs[i];
    for (let attempt = 0; attempt < 2; attempt++) {
      const url = await getPlayUrlByEngine(song, "128");
      if (url.length == 0) {
        lastMessage = `${song.name} 取链为空`;
        continue;
      }
      const playable = await verifyPlayableByEngine(url);
      if (playable) {
        return { ok: true, message: `${song.name} 取链+预检通过` } as SourceSmokeResult;
      }
      lastMessage = `${song.name} Range 预检未通过`;
    }
  }
  return { ok: false, message: lastMessage } as SourceSmokeResult;
}

/**
 * 冒烟自检的候选曲目：按固定关键词在酷我搜前 5 首（搜索走内置 meta，不需要播放包）。
 * 不写死歌曲 ID——歌会下架、接口会变，用搜索结果更抗老化；
 * smokeTest 会逐个尝试，任一成功即通过，所以列表里有没有免费歌都能兜住。
 */
export async function pickSmokeSongs(): Promise<Song[]> {
  try {
    const results = await musicApi.search(SMOKE_KEYWORD, "kw", "song", 1, 5);
    return results;
  } catch (e) {
    return [] as Song[];
  }
}

/** 冒烟搜索关键词（选最常见的歌名，保证各源都有结果） */
const SMOKE_KEYWORD = "晴天";

// ==================== 从链接安装自定义包 ====================

/**
 * 从直链安装自定义播放包（source=custom，不自动更新、不自动激活）。
 *
 * 与 qt-pc 的 source_install_from_url 同口径：
 *   - 只接受 https 直链（包会被引擎当脚本执行，明文 http 一律拒绝）
 *   - 下载 → 外层校验（必须含 __qtPlayPackFactory，meta installPlayPack 契约）→ 落盘
 *   - 每次安装都落新目录（custom-<时间戳>），多份共存，卸载即删
 *   - 只写 play-bundle.js：直链包自包含（内含默认线路），不带 chain.json
 *   - 装完不抢激活：用户在播放包列表里自己选择启用哪个
 *
 * 下载走 uni.downloadFile，不加统一客户端头（第三方直链带自定义头会坏签名/表单校验）。
 */
export async function installFromUrl(url: string): Promise<SourceApplyResult> {
  const link = url.trim();
  if (link.length == 0) {
    return applyResult(false, 0, "链接不能为空");
  }
  if (!link.startsWith("https://")) {
    return applyResult(false, 0, "只支持 https 直链（播放包会被当脚本执行，不接受明文 http）");
  }
  const temp = await downloadToTemp(link);
  if (temp.length == 0) {
    return applyResult(false, 0, "下载失败，请检查链接是否可直连");
  }
  const text = await readTextFileAt(temp);
  await removeFileAt(temp);
  if (text.length == 0) {
    return applyResult(false, 0, "播放包下载为空");
  }
  // 外层校验：看起来是播放包（meta installPlayPack 约定的工厂导出），否则直接拒绝。
  // 旧「单体 ESM 官方包」（createSourceLayer 导出）在这里被拦下——与双包客户端不兼容。
  if (text.indexOf(PLAY_PACK_FACTORY_MARKER) < 0) {
    return applyResult(false, 0, "该链接不是有效的播放音源包（缺少 " + PLAY_PACK_FACTORY_MARKER + "）");
  }
  await ensureLocalStateRestored();
  const id = customPackId();
  if (!(await ensurePackDir(id))) {
    return applyResult(false, 0, "写入失败：无法创建播放包目录");
  }
  if (!(await writePackArtifact(id, ARTIFACT_PLAY, text))) {
    return applyResult(false, 0, "写入失败：播放包落盘失败");
  }
  const now = Date.now();
  const meta: PlayPackMeta = {
    id: id,
    name: "自定义播放包",
    // custom 包没有官方发号：unix 秒只用于展示与排序，不参与官方版本比较
    versionCode: Math.floor(now / 1000),
    versionName: id.substring("custom-".length),
    source: PACK_SOURCE_CUSTOM,
    dir: packDirOf(id),
    installedAt: now,
  };
  await putPack(meta);
  await pruneOrphans();
  syncSourceUpdateBadge();
  return applyResult(true, meta.versionCode, "自定义播放包已安装；在下方列表中选择「启用」使其生效");
}

// ==================== 请求 ====================

function requestJson(
  url: string,
  method: "GET" | "POST",
  data: UTSJSONObject | null
): Promise<UTSJSONObject | null> {
  return new Promise<UTSJSONObject | null>((resolve) => {
    const headers = new UTSJSONObject();
    headers.set("Content-Type", "application/json");
    // astral 网关请求：本地有 satoken 就携带（后端据此识别测试人群），未登录不带
    const token = getAccessToken();
    if (token.length > 0) {
      headers.set("satoken", token);
    }
    // 统一客户端系统头（X-App-Ut / X-App-Version / X-Device / X-OS）：
    // 本文件的 url 由调用方 resolveUrl() 得到，恒为 astral 网关，直接合并。
    mergeClientHeaders(headers);
    uni.request({
      url: url,
      method: method,
      data: data != null ? data : new UTSJSONObject(),
      header: headers,
      timeout: MANIFEST_TIMEOUT_MS,
      success: (response) => {
        const status = response.statusCode;
        if (status < 200 || status >= 300) {
          resolve(null);
          return;
        }
        const body = response.data as UTSJSONObject | null;
        if (body == null) {
          resolve(null);
          return;
        }
        const code = body.get("code");
        if (code == null) {
          resolve(null);
          return;
        }
        const n = code as number;
        if (n == 0 || n == 200) {
          resolve(body);
        } else {
          resolve(null);
        }
      },
      fail: (error) => {
        console.log("[SourceUpdate] 请求失败：" + `${error}`);
        resolve(null);
      },
    });
  });
}

/** 拉取 manifest（QtRestResp 包装：{code:200, data:{schema, generatedAt, release}}；服务端已预筛，至多一条 release） */
export async function fetchManifest(): Promise<SourceManifest | null> {
  const appCode = getCurrentVersionCode();
  // channel 入参已随后端接口删除（测试人群识别改走 satoken 请求头，见 requestJson）
  let path =
    "app/source/manifest?platform=" +
    PLATFORM_ANDROID +
    "&hostApiVersion=" +
    HOST_API_VERSION;
  // 版本号取不到时（0）不带该参数：服务端对「未提供」应视为不限制，
  // 否则本机会被准入表整体挡在门外（宁可多给一个包，也不能谁都拿不到）。
  if (appCode > 0) {
    path += "&appVersionCode=" + appCode;
  }
  const body = await requestJson(resolveUrl(path), "GET", null);
  if (body == null) return null;
  const data = body.get("data") as UTSJSONObject | null;
  if (data == null) return null;
  return manifestFromJson(data);
}

/** 上报冒烟/加载结果（失败时后端可据此把该版本标坏）；custom 包没有服务端记录，调用方别传它 */
export async function reportResult(
  sourceVersionCode: number,
  ok: boolean,
  detail: string
): Promise<void> {
  const data = new UTSJSONObject();
  data.set("platform", PLATFORM_ANDROID);
  data.set("appVersionCode", getCurrentVersionCode());
  data.set("appVersionName", getCurrentVersionName());
  data.set("sourceVersionCode", sourceVersionCode);
  data.set("result", ok ? "ok" : "smoke_failed");
  data.set("detail", detail.length > 1000 ? detail.substring(0, 1000) : detail);
  await requestJson(resolveUrl("app/source/report"), "POST", data);
}

// ==================== 下载 ====================

/** uni.downloadFile → 临时文件绝对路径；失败返回 "" */
function downloadToTemp(url: string): Promise<string> {
  return new Promise<string>((resolve) => {
    uni.downloadFile({
      url: url,
      timeout: DOWNLOAD_TIMEOUT_MS,
      success: (res) => {
        if (res.statusCode >= 200 && res.statusCode < 300) {
          resolve(res.tempFilePath);
        } else {
          resolve("");
        }
      },
      fail: (error) => {
        console.log("[SourceUpdate] 下载失败：" + `${error}`);
        resolve("");
      },
    });
  });
}

/** 下载一个产物到内存文本（installOfficialRelease 的「先下后写」用）；失败返回 "" */
async function downloadText(url: string): Promise<string> {
  const temp = await downloadToTemp(url);
  if (temp.length == 0) return "";
  const text = await readTextFileAt(temp);
  // 临时文件在 cache 目录系统会回收，这里顺手清掉
  await removeFileAt(temp);
  return text;
}

// ==================== JSON ↔ 类型 ====================

function manifestFromJson(o: UTSJSONObject): SourceManifest {
  const releaseJson = o.get("release") as UTSJSONObject | null;
  return {
    schema: numOf(o, "schema"),
    generatedAt: strOf(o, "generatedAt"),
    release: releaseJson != null ? releaseFromJson(releaseJson) : null,
  } as SourceManifest;
}

function releaseFromJson(o: UTSJSONObject): SourceRelease {
  const platforms: number[] = [];
  const platformsJson = o.get("platforms") as number[] | null;
  if (platformsJson != null) {
    for (let i = 0; i < platformsJson.length; i++) {
      const n = platformsJson[i] as number;
      if (n != null) platforms.push(n);
    }
  }
  const artifacts: SourceArtifact[] = [];
  const artifactsJson = o.get("artifacts") as UTSJSONObject[] | null;
  if (artifactsJson != null) {
    for (let i = 0; i < artifactsJson.length; i++) {
      const a = artifactsJson[i];
      artifacts.push({
        path: strOf(a, "path"),
        version: numOf(a, "version"),
        url: strOf(a, "url"),
      } as SourceArtifact);
    }
  }
  return {
    sourceVersionCode: numOf(o, "sourceVersionCode"),
    sourceVersionName: strOf(o, "sourceVersionName"),
    platforms: platforms,
    hostApiVersion: numOf(o, "hostApiVersion"),
    channel: strOf(o, "channel"),
    notes: strOf(o, "notes"),
    publishedAt: strOf(o, "publishedAt"),
    rollbackTo: numOf(o, "rollbackTo"),
    bad: boolOfDefault(o, "bad", false),
    // 字段缺失视为已发布（与 qt-pc 的 null_as_published 容错一致）
    published: boolOfDefault(o, "published", true),
    artifacts: artifacts,
  } as SourceRelease;
}

function checkResult(action: string, code: number, name: string, message: string): SourceCheckResult {
  return { action: action, versionCode: code, versionName: name, message: message } as SourceCheckResult;
}

function applyResult(ok: boolean, code: number, message: string): SourceApplyResult {
  return { ok: ok, versionCode: code, message: message } as SourceApplyResult;
}

function containsNum(list: number[], v: number): boolean {
  for (let i = 0; i < list.length; i++) {
    if (list[i] == v) return true;
  }
  return false;
}

function strOf(o: UTSJSONObject, key: string): string {
  const v = o.get(key);
  if (v == null) return "";
  return `${v}`;
}

function numOf(o: UTSJSONObject, key: string): number {
  const v = o.get(key);
  if (v == null) return 0;
  const n = v as number;
  if (n == null) return 0;
  return n;
}

function boolOfDefault(o: UTSJSONObject, key: string, d: boolean): boolean {
  const v = o.get(key);
  if (v == null) return d;
  const b = v as boolean;
  if (b == null) return d;
  return b;
}
