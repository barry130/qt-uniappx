/**
 * 音源包本地存储（目录布局 + 读写 + 本地状态，schema 3 统一包模型）
 *
 * 统一包模型（2026-10，与 qt-pc 同源）：
 *   - 所有音源包（meta 数据包 / play 播放包）一律由用户经「https 链接 / 本地 js
 *     文件」安装，包文件首行 /*__QT_PACK__{...}*\/ 自述身份（kind/id/名称/版本/
 *     updateUrl），宿主不执行包体即可解析（见 source-pack-header.uts）；
 *   - 每个包按自述 id 独立版本管理：同 id 的新版本原地替换，不同 id 多包共存；
 *   - meta：同样不内置（未装时数据面下线），多包共存、生效由 activeMetaId
 *     指定（"" = 未装/停用）；play：多包并存、恰好一个生效（activeId）；
 *   - 更新发现：各包 updateUrl 自管探测 + astral manifest 渠道（source-update.uts），
 *     一律「仅提示、手动确认」后下载生效。
 *
 * 目录（Android 私有目录 filesDir 下，路径由 qt-js-engine 插件的 dataDir() 给出）：
 *   source-bundle/
 *     state.json                          本地状态（见 SourceLocalState，schema 3）
 *     install/<packId>/meta-bundle.js     meta 包主体（kind=meta）
 *     install/<packId>/play-bundle.js     play 包主体（kind=play）
 *     install/<packId>/chain.json         可选线路覆盖层（play 包专属）
 *
 * state.json 结构（schema 3）：
 *   { "schema": 3,
 *     "packs": [ {id,kind,name,versionCode,versionName,updateUrl,dir,
 *                 installedAt,updatedAt,skipCodes,lastProbeAt} ],
 *     "activeId": "play-official" | "custom-20261001-173005" | "",
 *     "activeMetaId": "meta-official" | "",
 *     "lastCheckAt": 1758200000000 }
 *
 * schema 2 → 3 迁移（统一包模型）：
 *   - packs 全部补 kind="play"；id "official" 改 "play-official"（目录随改名）；
 *   - source 字段删除（官方/自定义之分只是包自述 id 的差别）；
 *   - 全局 bad[]（官方坏版本）并入 play-official 的 skipCodes；
 *   - previousOfficial 删除（服务端回退治理已随 manifest 自动安装一并移除）。
 * schema 1 → 3：旧包是单体全量 ESM，直接清掉 pkg/ 与 install/（与 v2 迁移同口径）。
 *
 * 注意 packs 表示「已落盘」，不等于「引擎已生效」：play 生效由 activeId 指定、
 * meta 生效由 activeMetaId 指定（"" = 未装/停用，数据面下线），装载是否成功见 source-engine
 * （失败不改这里的落盘状态——用户手装的包失败也留在列表里，由用户自行处理）。
 *
 * 为什么不放 uni storage：bundle 约 2MB，storage 是给小数据的；
 * 文件读写统一走 qt-js-engine 插件（java.io），不依赖 uni.getFileSystemManager 的跨端可用性。
 */

// #ifdef APP-ANDROID
import {
  dataDir as nativeDataDir,
  readTextFile as nativeReadTextFile,
  writeTextFile as nativeWriteTextFile,
  exists as nativeExists,
  remove as nativeRemove,
  mkdirs as nativeMkdirs,
  listDir as nativeListDir,
} from "@/uni_modules/qt-js-engine";
// #endif

const UNSUPPORTED = "当前平台不支持音源包存储";
const ROOT_NAME = "source-bundle";
const STATE_FILE = "state.json";
const INSTALL_DIR = "install";

/** 包种类：meta 数据包（搜索/歌单/歌词，不内置） */
export const PACK_KIND_META = "meta";
/** 包种类：play 播放包（取链，不内置） */
export const PACK_KIND_PLAY = "play";

/** 官方播放包自述 id（qt-sources sources.config.json 的 packs.play.id） */
export const OFFICIAL_PLAY_ID = "play-official";
/** 官方数据包自述 id */
export const OFFICIAL_META_ID = "meta-official";

/** 产物文件名：meta 包主体 */
export const ARTIFACT_META = "meta-bundle.js";
/** 产物文件名：play 包主体 */
export const ARTIFACT_PLAY = "play-bundle.js";
/** 产物文件名：可选线路覆盖层（play 专属） */
export const ARTIFACT_CHAIN = "chain.json";

/** 某种类包的主体产物名 */
export function artifactOfKind(kind: string): string {
  return kind == PACK_KIND_META ? ARTIFACT_META : ARTIFACT_PLAY;
}

/** 已落盘的一个音源包（meta/play 通用；身份字段来自包文件头自述） */
export type SourcePackMeta = {
  /** 包 id（包头自述，同时是目录名；同 id 更新原地替换） */
  id: string;
  /** PACK_KIND_META / PACK_KIND_PLAY */
  kind: string;
  /** 包头自述名（展示用，如「官方播放包」） */
  name: string;
  /** 包头自述版本号（单调递增；更新判定与展示用） */
  versionCode: number;
  /** 包头自述版本名（如 2026.10.02.1） */
  versionName: string;
  /** 包头自述更新源（https 直链；空 = 该包不自管更新） */
  updateUrl: string;
  /** 包目录绝对路径 */
  dir: string;
  /** 首次安装时间（毫秒） */
  installedAt: number;
  /** 最近一次版本变更时间（毫秒；列表排序用） */
  updatedAt: number;
  /** 该包装载/冒烟失败过的版本号：不再对这些版本提示更新 */
  skipCodes: number[];
  /** 上次探测 updateUrl 的时间（毫秒；按包独立节流） */
  lastProbeAt: number;
  /** 安装来源：""（旧记录/未知） | "url" | "file" | "manifest"（展示与溯源用） */
  installSource: string;
  /** 来源备注：url=安装链接；file=文件名；manifest 留空 */
  installRef: string;
  /** 最近一次装载/冒烟失败原因（空 = 无记录；成功生效后清空） */
  lastError: string;
  /** lastError 时间（毫秒；0 = 无失败记录） */
  lastErrorAt: number;
  /**
   * 官方 id 包安装时 ed25519 签名校验通过（true）。
   * 签名落地前安装的历史官方包为 false——manifest 渠道对这类包不按
   * versionCode 压制（见 source-update.discoverUpdates），让真官方更新
   * 总能提示出来，覆盖掉历史遗留的冒充包。第三方包恒 false（不参与判定）。
   */
  signVerified: boolean;
};

/** 本地状态（state.json，schema 3） */
export type SourceLocalState = {
  schema: number;
  /** 已落盘的全部音源包（meta + play 混排，靠 kind 区分） */
  packs: SourcePackMeta[];
  /** 生效中的 play 包 id（"" = 未安装，在线取链不可用） */
  activeId: string;
  /** 生效中的 meta 包 id（"" = 未装/停用，数据面下线） */
  activeMetaId: string;
  /** 上次 manifest 渠道检查时间（毫秒，节流用） */
  lastCheckAt: number;
};

// ==================== 平台文件 API ====================

// #ifdef APP-ANDROID
function fsDataDir(): string {
  return nativeDataDir();
}

function fsRead(path: string): Promise<string> {
  return new Promise<string>((resolve, reject) => {
    nativeReadTextFile(path, (ok: boolean, value: string, error: string) => {
      if (ok) {
        resolve(value);
      } else {
        reject(new Error(error));
      }
    });
  });
}

function fsWrite(path: string, text: string): Promise<boolean> {
  return new Promise<boolean>((resolve, reject) => {
    nativeWriteTextFile(path, text, (ok: boolean, value: string, error: string) => {
      if (ok) {
        resolve(true);
      } else {
        reject(new Error(error));
      }
    });
  });
}

function fsExists(path: string): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    nativeExists(path, (ok: boolean, value: string, error: string) => {
      resolve(ok && value == "1");
    });
  });
}

function fsRemove(path: string): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    nativeRemove(path, (ok: boolean, value: string, error: string) => {
      resolve(ok);
    });
  });
}

function fsMkdirs(path: string): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    nativeMkdirs(path, (ok: boolean, value: string, error: string) => {
      resolve(ok);
    });
  });
}
// #endif

// #ifndef APP-ANDROID
function fsDataDir(): string {
  return "";
}

function fsRead(path: string): Promise<string> {
  return Promise.reject(new Error(UNSUPPORTED));
}

function fsWrite(path: string, text: string): Promise<boolean> {
  return Promise.reject(new Error(UNSUPPORTED));
}

function fsExists(path: string): Promise<boolean> {
  return Promise.resolve(false);
}

function fsRemove(path: string): Promise<boolean> {
  return Promise.resolve(false);
}

function fsMkdirs(path: string): Promise<boolean> {
  return Promise.resolve(false);
}
// #endif

// #ifdef APP-ANDROID
function fsListNames(dir: string): Promise<string[]> {
  return new Promise<string[]>((resolve) => {
    nativeListDir(dir, (ok: boolean, value: string, error: string) => {
      if (!ok) {
        resolve([] as string[]);
        return;
      }
      const out: string[] = [];
      try {
        const arr = JSON.parse(value) as UTSJSONObject[];
        for (let i = 0; i < arr.length; i++) {
          const o = arr[i];
          const isDir = o.get("dir") as boolean | null;
          const name = o.get("name") as string | null;
          if (isDir == true && name != null) out.push(name);
        }
      } catch (_) {}
      resolve(out);
    });
  });
}
// #endif

// #ifndef APP-ANDROID
function fsListNames(dir: string): Promise<string[]> {
  return Promise.resolve([] as string[]);
}
// #endif

// ==================== 路径 ====================

/** 音源包根目录（空串 = 当前平台不可用） */
export function packageRoot(): string {
  const base = fsDataDir();
  if (base.length == 0) return "";
  return base + "/" + ROOT_NAME;
}

/** install/ 目录（全部包的父目录） */
export function installDir(): string {
  return packageRoot() + "/" + INSTALL_DIR;
}

/** 某个包的目录（id 即目录名） */
export function packDirOf(id: string): string {
  return installDir() + "/" + id;
}

/** 某个产物在包目录里的绝对路径（path 用 ARTIFACT_* 常量） */
export function artifactPath(id: string, path: string): string {
  return packDirOf(id) + "/" + path;
}

export function statePath(): string {
  return packageRoot() + "/" + STATE_FILE;
}

// ==================== 内存副本 + 读写 ====================

let gState: SourceLocalState = emptyState();

/** restoreLocalState 的单飞句柄：进程内只恢复一次（重复恢复会把内存状态清空重读） */
let gRestorePromise: Promise<SourceLocalState> | null = null;

/** 同步读本地状态（启动预热后可用；未预热时是空状态） */
export function localState(): SourceLocalState {
  return gState;
}

export function emptyState(): SourceLocalState {
  return {
    schema: 3,
    packs: [] as SourcePackMeta[],
    activeId: "",
    activeMetaId: "",
    lastCheckAt: 0,
  } as SourceLocalState;
}

/** 全部已落盘的音源包（拷贝一份，防调用方改内存状态） */
export function packs(): SourcePackMeta[] {
  const out: SourcePackMeta[] = [];
  for (let i = 0; i < gState.packs.length; i++) out.push(clonePack(gState.packs[i]));
  return out;
}

/** 某种类的全部包（meta / play） */
export function packsOfKind(kind: string): SourcePackMeta[] {
  const out: SourcePackMeta[] = [];
  for (let i = 0; i < gState.packs.length; i++) {
    if (gState.packs[i].kind == kind) out.push(clonePack(gState.packs[i]));
  }
  return out;
}

export function packById(id: string): SourcePackMeta | null {
  for (let i = 0; i < gState.packs.length; i++) {
    if (gState.packs[i].id == id) return clonePack(gState.packs[i]);
  }
  return null;
}

/** 生效中的播放包（null = 未安装，在线取链不可用） */
export function activePack(): SourcePackMeta | null {
  if (gState.activeId.length == 0) return null;
  return packById(gState.activeId);
}

/** 生效中的 meta 包（null = 未装/停用，数据面下线） */
export function activeMetaPack(): SourcePackMeta | null {
  if (gState.activeMetaId.length == 0) return null;
  return packById(gState.activeMetaId);
}

/**
 * 从磁盘恢复本地状态到内存（幂等，进程内单飞）。
 * 恢复时做两件清洗：
 *   1. 旧 schema 状态 → 迁移到 schema 3；
 *   2. 落盘校验：主体产物不在的包直接剔除（防「状态在、文件被清」），
 *      生效包被剔除时对应 activeId/activeMetaId 清空。
 */
export async function restoreLocalState(): Promise<SourceLocalState> {
  gState = emptyState();
  try {
    const raw = await fsRead(statePath());
    if (raw.length > 0) {
      const o = JSON.parse(raw) as UTSJSONObject;
      const schema = numOf(o, "schema");
      if (schema >= 3) {
        const state = stateFromJson(o);
        await validateOnDisk(state);
        gState = state;
      } else {
        await migrateLegacy(o, schema);
      }
    }
  } catch (_) {
    // 读不到/解析不了 state.json 就当空状态（未安装）
  }
  return gState;
}

/** v1/v2 → v3 迁移（详见文件头注释；迁移后立即落盘） */
async function migrateLegacy(old: UTSJSONObject, schema: number): Promise<void> {
  const state = emptyState();
  // v2 的全局坏版本名单（官方播放包历史拉黑版本）→ play-official 的 skipCodes
  const bad: number[] = [];
  const badRaw = old.get("bad") as number[] | null;
  if (badRaw != null) {
    for (let i = 0; i < badRaw.length; i++) {
      const n = badRaw[i] as number;
      if (n != null && n != 0) bad.push(n);
    }
  }
  state.lastCheckAt = numOf(old, "lastCheckAt");
  if (schema == 2) {
    const packList = old.get("packs") as UTSJSONObject[] | null;
    if (packList != null) {
      for (let i = 0; i < packList.length; i++) {
        const legacy = packList[i] as UTSJSONObject;
        const id = strOf(legacy, "id");
        if (id.length == 0) continue;
        // 统一包模型：official → play-official（目录随改名），custom-* 保持原 id
        const isOfficial = id == "official";
        const nextId = isOfficial ? OFFICIAL_PLAY_ID : id;
        if (isOfficial) {
          await moveDirIfPresent(packDirOf("official"), packDirOf(nextId));
        }
        const dir = strOf(legacy, "dir");
        const meta = packFromJsonParts(nextId, PACK_KIND_PLAY, legacy);
        meta.dir = packDirOf(nextId);
        if (isOfficial && bad.length > 0) meta.skipCodes = bad;
        state.packs.push(meta);
        if (strOf(old, "activeId") == id) state.activeId = nextId;
      }
    }
  } else {
    // schema 1：旧包是单体全量 ESM，新引擎装不了，整体清掉
    await fsRemove(packageRoot() + "/pkg");
    await fsRemove(installDir());
  }
  gState = state;
  await saveLocalState(state);
  await pruneOrphans();
  console.log(`[SourceBundleFs] schema ${schema} → 3 迁移完成`);
}

/** 目录改名迁移用：from 存在且 to 不存在时把 from 改成 to（读出重写，跨设备安全） */
async function moveDirIfPresent(from: string, to: string): Promise<void> {
  if (await fsExists(to)) return;
  if (!(await fsExists(from))) return;
  await fsMkdirs(to);
  for (const name of [ARTIFACT_PLAY, ARTIFACT_CHAIN]) {
    const text = await readTextFileAt(from + "/" + name);
    if (text.length > 0) await writeTextFileAt(to + "/" + name, text);
  }
  await fsRemove(from);
}

/** 剔除主体产物不在盘上的包；生效包被剔除则清空对应 active id */
async function validateOnDisk(state: SourceLocalState): Promise<void> {
  const kept: SourcePackMeta[] = [];
  for (let i = 0; i < state.packs.length; i++) {
    const p = state.packs[i];
    const ok = await fsExists(artifactPath(p.id, artifactOfKind(p.kind)));
    if (ok) {
      kept.push(p);
    } else {
      console.log(`[SourceBundleFs] 包 ${p.id} 的主体产物不在盘上，已剔除`);
      if (state.activeId == p.id) state.activeId = "";
      if (state.activeMetaId == p.id) state.activeMetaId = "";
    }
  }
  state.packs = kept;
}

/**
 * 确保本地状态已从磁盘恢复（进程内幂等，只跑一次）。
 *
 * 为什么需要：恢复是异步的，而首页等页面现在直接依赖本地状态（activeMetaId/
 * activeId 都是恢复后才有），页面调用完全可能赶在预热完成之前——直接读
 * activePack() 会拿到空状态，误报「未安装」。所有链路必须先过这里。
 */
export function ensureLocalStateRestored(): Promise<SourceLocalState> {
  if (gRestorePromise == null) {
    gRestorePromise = restoreLocalState();
    // 恢复失败不该让所有等待方集体报错：失败时 activePack() 自然为 null，
    // 各调用方按「没有可用包」走自己的兜底
    gRestorePromise.catch(() => {});
  }
  return gRestorePromise;
}

/** 写本地状态（同时更新内存副本） */
export async function saveLocalState(state: SourceLocalState): Promise<boolean> {
  try {
    await fsWrite(statePath(), JSON.stringify(stateToJson(state)));
    gState = state;
    return true;
  } catch (_) {
    return false;
  }
}

/** 只更新 lastCheckAt 并落盘（manifest 渠道节流用） */
export async function touchLastCheck(at: number): Promise<void> {
  const next = cloneState(gState);
  next.lastCheckAt = at;
  await saveLocalState(next);
}

export function cloneState(s: SourceLocalState): SourceLocalState {
  const packList: SourcePackMeta[] = [];
  for (let i = 0; i < s.packs.length; i++) packList.push(clonePack(s.packs[i]));
  return {
    schema: s.schema,
    packs: packList,
    activeId: s.activeId,
    activeMetaId: s.activeMetaId,
    lastCheckAt: s.lastCheckAt,
  } as SourceLocalState;
}

export function clonePack(p: SourcePackMeta): SourcePackMeta {
  const skip: number[] = [];
  for (let i = 0; i < p.skipCodes.length; i++) skip.push(p.skipCodes[i]);
  return {
    id: p.id,
    kind: p.kind,
    name: p.name,
    versionCode: p.versionCode,
    versionName: p.versionName,
    updateUrl: p.updateUrl,
    dir: p.dir,
    installedAt: p.installedAt,
    updatedAt: p.updatedAt,
    skipCodes: skip,
    lastProbeAt: p.lastProbeAt,
    installSource: p.installSource,
    installRef: p.installRef,
    lastError: p.lastError,
    lastErrorAt: p.lastErrorAt,
    signVerified: p.signVerified,
  } as SourcePackMeta;
}

// ==================== 包级操作（增/删/切换） ====================

/**
 * 新增或替换一个包记录（同 id 覆盖 = 原地更新）。
 * 列表顺序：meta 包在前、play 包在后，各组内 updatedAt 新→旧（设置页展示序）。
 */
export async function putPack(meta: SourcePackMeta): Promise<boolean> {
  const next = cloneState(gState);
  const list: SourcePackMeta[] = [];
  let replaced = false;
  for (let i = 0; i < next.packs.length; i++) {
    if (next.packs[i].id == meta.id) {
      list.push(clonePack(meta));
      replaced = true;
    } else {
      list.push(next.packs[i]);
    }
  }
  if (!replaced) list.push(clonePack(meta));
  const metas = list
    .filter((p) => p.kind == PACK_KIND_META)
    .sort((a, b) => (a.updatedAt > b.updatedAt ? -1 : 1));
  const plays = list
    .filter((p) => p.kind != PACK_KIND_META)
    .sort((a, b) => (a.updatedAt > b.updatedAt ? -1 : 1));
  next.packs = metas.concat(plays);
  return saveLocalState(next);
}

/** 切换生效 play 包（包必须已落盘且 kind=play；传 "" 表示全部不生效） */
export async function setActive(id: string): Promise<boolean> {
  if (id.length > 0) {
    const p = packById(id);
    if (p == null || p.kind != PACK_KIND_PLAY) return false;
  }
  const next = cloneState(gState);
  next.activeId = id;
  return saveLocalState(next);
}

/** 切换生效 meta 包（传 "" = 停用数据包，数据面下线） */
export async function setActiveMeta(id: string): Promise<boolean> {
  if (id.length > 0) {
    const p = packById(id);
    if (p == null || p.kind != PACK_KIND_META) return false;
  }
  const next = cloneState(gState);
  next.activeMetaId = id;
  return saveLocalState(next);
}

/** 记录一个包最近一次装载/冒烟失败原因（管理页展示与诊断用；失败静默不抛） */
export async function notePackError(id: string, message: string): Promise<void> {
  if (id.length == 0 || message.length == 0) return;
  if (packById(id) == null) return;
  const next = cloneState(gState);
  for (let i = 0; i < next.packs.length; i++) {
    if (next.packs[i].id == id) {
      next.packs[i].lastError = message;
      next.packs[i].lastErrorAt = Date.now();
    }
  }
  await saveLocalState(next);
}

/** 清掉一个包的失败记录（成功生效后调用） */
export async function clearPackError(id: string): Promise<void> {
  if (id.length == 0) return;
  if (packById(id) == null) return;
  const next = cloneState(gState);
  for (let i = 0; i < next.packs.length; i++) {
    if (next.packs[i].id == id) {
      if (next.packs[i].lastError.length == 0 && next.packs[i].lastErrorAt == 0) return;
      next.packs[i].lastError = "";
      next.packs[i].lastErrorAt = 0;
    }
  }
  await saveLocalState(next);
}

/** 官方包 id（astral manifest 发布的推荐 id）：直链/本地装到这些 id 时 UI 要提示防仿冒 */
export function isOfficialPackId(id: string): boolean {
  return id == OFFICIAL_PLAY_ID || id == OFFICIAL_META_ID;
}

/**
 * 卸载一个包：删目录 + 出列表；卸的是生效包则对应 activeId/activeMetaId 清空
 * （play 回到未安装、meta 回到停用，由用户在列表里另选或重装）。
 */
export async function removePack(id: string): Promise<boolean> {
  const next = cloneState(gState);
  const list: SourcePackMeta[] = [];
  for (let i = 0; i < next.packs.length; i++) {
    if (next.packs[i].id != id) list.push(next.packs[i]);
  }
  next.packs = list;
  if (next.activeId == id) next.activeId = "";
  if (next.activeMetaId == id) next.activeMetaId = "";
  await fsRemove(packDirOf(id));
  return saveLocalState(next);
}

/**
 * 清掉全部音源包（回到「未安装/停用」）：state.json 重置、install/ 整棵删除。
 * 排查/迁移用；正常卸载走 removePack（逐包）。
 */
export async function clearAllPacks(): Promise<void> {
  gState = emptyState();
  await fsRemove(packageRoot());
}

/** 清理孤儿目录：install/ 下不在 packs 里的目录（上次卸载/落盘中断的残留） */
export async function pruneOrphans(): Promise<void> {
  const names = await fsListNames(installDir());
  for (let i = 0; i < names.length; i++) {
    if (packById(names[i]) == null) {
      await fsRemove(packDirOf(names[i]));
    }
  }
}

// ==================== 产物读写 ====================

export function ensurePackDir(id: string): Promise<boolean> {
  return fsMkdirs(packDirOf(id));
}

/** 写一个产物到包目录（调用前先 ensurePackDir） */
export function writePackArtifact(id: string, path: string, text: string): Promise<boolean> {
  return fsWrite(artifactPath(id, path), text);
}

/** 读一个产物；读不到返回 "" */
export async function readPackArtifact(id: string, path: string): Promise<string> {
  try {
    return await fsRead(artifactPath(id, path));
  } catch (_) {
    return "";
  }
}

/** 删一个产物（文件本就不存在也算成功）；更新包不再带 chain.json 时用它清掉旧覆盖层 */
export function removePackArtifact(id: string, path: string): Promise<boolean> {
  return fsRemove(artifactPath(id, path));
}

/** 按绝对路径读文本（下载中转/系统选择器选中的文件用）；读不到返回 "" */
export async function readTextFileAt(path: string): Promise<string> {
  try {
    return await fsRead(path);
  } catch (_) {
    return "";
  }
}

/** 按绝对路径写文本 */
export function writeTextFileAt(path: string, text: string): Promise<boolean> {
  return fsWrite(path, text);
}

/** 按绝对路径删除文件/目录 */
export function removeFileAt(path: string): Promise<boolean> {
  return fsRemove(path);
}

/** 按绝对路径判断存在 */
export function existsFileAt(path: string): Promise<boolean> {
  return fsExists(path);
}

// ==================== 坏版本名单（按包独立） ====================

/**
 * 给某个包记一个「装载/冒烟失败」的版本号：探测更新时跳过对该版本的提示，
 * 防止反复下载一个装不上的版本。
 */
export async function markPackBad(packId: string, versionCode: number): Promise<void> {
  if (versionCode <= 0) return;
  const next = cloneState(gState);
  for (let i = 0; i < next.packs.length; i++) {
    if (next.packs[i].id == packId) {
      let exists = false;
      for (let j = 0; j < next.packs[i].skipCodes.length; j++) {
        if (next.packs[i].skipCodes[j] == versionCode) exists = true;
      }
      if (!exists) next.packs[i].skipCodes.push(versionCode);
    }
  }
  await saveLocalState(next);
}

export function isPackBadVersion(packId: string, versionCode: number): boolean {
  for (let i = 0; i < gState.packs.length; i++) {
    if (gState.packs[i].id != packId) continue;
    for (let j = 0; j < gState.packs[i].skipCodes.length; j++) {
      if (gState.packs[i].skipCodes[j] == versionCode) return true;
    }
  }
  return false;
}

/** 记录某包上次探测 updateUrl 的时间（按包独立节流） */
export async function touchPackProbe(packId: string, at: number): Promise<void> {
  const next = cloneState(gState);
  for (let i = 0; i < next.packs.length; i++) {
    if (next.packs[i].id == packId) next.packs[i].lastProbeAt = at;
  }
  await saveLocalState(next);
}

// ==================== JSON ↔ 类型 ====================

function packToJson(p: SourcePackMeta): UTSJSONObject {
  const o = new UTSJSONObject();
  o.set("id", p.id);
  o.set("kind", p.kind);
  o.set("name", p.name);
  o.set("versionCode", p.versionCode);
  o.set("versionName", p.versionName);
  o.set("updateUrl", p.updateUrl);
  o.set("dir", p.dir);
  o.set("installedAt", p.installedAt);
  o.set("updatedAt", p.updatedAt);
  o.set("skipCodes", p.skipCodes);
  o.set("lastProbeAt", p.lastProbeAt);
  o.set("installSource", p.installSource);
  o.set("installRef", p.installRef);
  o.set("lastError", p.lastError);
  o.set("lastErrorAt", p.lastErrorAt);
  o.set("signVerified", p.signVerified);
  return o;
}

function packFromJson(v: UTSJSONObject | null): SourcePackMeta | null {
  if (v == null) return null;
  const id = strOf(v, "id");
  if (id.length == 0) return null;
  const kind = strOf(v, "kind");
  const meta = packFromJsonParts(id, kind.length > 0 ? kind : PACK_KIND_PLAY, v);
  meta.updatedAt = numOf(v, "updatedAt");
  meta.lastProbeAt = numOf(v, "lastProbeAt");
  // 新增字段（schema 3 内追加，旧记录缺字段 → 默认值，向后兼容）
  meta.installSource = strOf(v, "installSource");
  meta.installRef = strOf(v, "installRef");
  meta.lastError = strOf(v, "lastError");
  meta.lastErrorAt = numOf(v, "lastErrorAt");
  // boolean 缺字段/旧记录 → `${null}`=="null" != "true" → false（strOf 同款语义）
  meta.signVerified = `${v.get("signVerified")}` == "true";
  const skip = v.get("skipCodes") as number[] | null;
  if (skip != null) {
    for (let i = 0; i < skip.length; i++) {
      const n = skip[i] as number;
      if (n != null && n != 0) meta.skipCodes.push(n);
    }
  }
  return meta;
}

/** 从包头同名字段组装包记录（id/kind 由调用方给定，v 提供自述身份字段） */
function packFromJsonParts(id: string, kind: string, v: UTSJSONObject): SourcePackMeta {
  return {
    id: id,
    kind: kind,
    name: strOf(v, "name"),
    versionCode: numOf(v, "versionCode"),
    versionName: strOf(v, "versionName"),
    updateUrl: strOf(v, "updateUrl"),
    dir: packDirOf(id),
    installedAt: numOf(v, "installedAt"),
    updatedAt: numOf(v, "installedAt"),
    skipCodes: [] as number[],
    lastProbeAt: 0,
    installSource: "",
    installRef: "",
    lastError: "",
    lastErrorAt: 0,
    signVerified: false,
  } as SourcePackMeta;
}

function stateToJson(s: SourceLocalState): UTSJSONObject {
  const o = new UTSJSONObject();
  o.set("schema", s.schema);
  const packList: UTSJSONObject[] = [];
  for (let i = 0; i < s.packs.length; i++) packList.push(packToJson(s.packs[i]));
  o.set("packs", packList);
  o.set("activeId", s.activeId);
  o.set("activeMetaId", s.activeMetaId);
  o.set("lastCheckAt", s.lastCheckAt);
  return o;
}

function stateFromJson(o: UTSJSONObject): SourceLocalState {
  const state = emptyState();
  const packList = o.get("packs") as UTSJSONObject[] | null;
  if (packList != null) {
    for (let i = 0; i < packList.length; i++) {
      const p = packFromJson(packList[i] as UTSJSONObject);
      if (p != null) state.packs.push(p);
    }
  }
  state.activeId = strOf(o, "activeId");
  state.activeMetaId = strOf(o, "activeMetaId");
  state.lastCheckAt = numOf(o, "lastCheckAt");
  return state;
}

function strOf(o: UTSJSONObject, key: string): string {
  const v = o.get(key);
  if (v == null) return "";
  return `${v}`;
}

function numOf(o: UTSJSONObject, key: string): number {
  const v = o.get(key);
  if (v == null) return 0;
  const n = v as number;
  if (n == null) return 0;
  return n;
}
