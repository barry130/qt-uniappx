/**
 * 播放音源包本地存储（目录布局 + 读写 + 本地状态，schema 2 多包并存）
 *
 * 双包架构（2026-10，与 qt-pc 的 source_install.rs v2 同源）：
 *   - 元数据包（meta-bundle.js）**内置**在代码里（services/source-meta-code.uts），
 *     不落盘、不走这里的任何路径；
 *   - 播放音源包（play-bundle.js，高版权风险）**绝不内置**：用户安装，可多版本
 *     共存，其中 exactly one 生效（activeId）。这里只管播放包的落盘与状态。
 *
 * 目录（Android 私有目录 filesDir 下，路径由 qt-js-engine 插件的 dataDir() 给出）：
 *   source-bundle/
 *     state.json                          本地状态（见 SourceLocalState，schema 2）
 *     install/<packId>/play-bundle.js     播放包主体（必需）
 *     install/<packId>/chain.json         可选线路覆盖层（manifest 列了才有）
 *
 * state.json 结构（schema 2）：
 *   { "schema": 2,
 *     "packs": [ {id,name,versionCode,versionName,source,dir,installedAt} ],
 *     "activeId": "official" | "custom-20261001-173005" | "",
 *     "bad": [2026091801],
 *     "lastCheckAt": 1758200000000,
 *     "previousOfficial": {…} | null }
 *
 * 包 id 规则：
 *   - official：id 恒为 "official"，目录同名，更新时**原地替换**（旧版本不保留
 *     目录；回退目标版本本地没有时按「未安装」处理，重新检查即可装回）；
 *   - custom：id 为 "custom-<yyyyMMdd-HHmmss>"，每次从链接安装都落新目录，
 *     多份共存互不影响，卸载即删目录。
 *
 * schema 1（单包 installed/previous）→ 2 迁移：旧包是「单体 ESM 全量包」
 * （元数据+取链同一文件），与双包契约不兼容，迁移时整体清掉 pkg/ 目录，
 * 只保留 bad / lastCheckAt 两个字段（发布前的破坏性变更，与 qt-pc 同口径）。
 *
 * 注意 packs 表示「已落盘」，不等于「引擎已生效」：生效由 activeId 指定，
 * 引擎装载是否成功见 source-engine（装载失败不在这里改状态——用户手装的
 * custom 包失败也保留在列表里，由用户自己决定卸载或换包）。
 *
 * 为什么不放 uni storage：bundle 约 2MB，storage 是给小数据的；
 * 文件读写统一走 qt-js-engine 插件（java.io），不依赖 uni.getFileSystemManager 的跨端可用性。
 */

// #ifdef APP-ANDROID
import {
  dataDir as nativeDataDir,
  readTextFile as nativeReadTextFile,
  writeTextFile as nativeWriteTextFile,
  exists as nativeExists,
  remove as nativeRemove,
  mkdirs as nativeMkdirs,
  listDir as nativeListDir,
} from "@/uni_modules/qt-js-engine";
// #endif

const UNSUPPORTED = "当前平台不支持播放音源包存储";
const ROOT_NAME = "source-bundle";
const STATE_FILE = "state.json";
const INSTALL_DIR = "install";

/** 官方播放包 id（目录名同名；更新原地替换这个目录） */
export const OFFICIAL_PACK_ID = "official";
/** 播放包来源：官方 manifest 下发 */
export const PACK_SOURCE_OFFICIAL = "official";
/** 播放包来源：用户从链接安装 */
export const PACK_SOURCE_CUSTOM = "custom";

/** 产物文件名（与 manifest 的 artifacts[].path 一致；chain.json 是可选覆盖层） */
export const ARTIFACT_PLAY = "play-bundle.js";
export const ARTIFACT_CHAIN = "chain.json";

/** 已落盘的一个播放音源包 */
export type PlayPackMeta = {
  /** 包 id：OFFICIAL_PACK_ID 或 "custom-<yyyyMMdd-HHmmss>"（同时是目录名） */
  id: string;
  /** 播放包自述名（bundleInfo 报告，如 "play-bundle"；展示用） */
  name: string;
  /**
   * 版本号：official 是后端发号（如 2026100101）；custom 用安装时刻的
   * unix 秒（正数），只用于展示与列表排序，不参与官方版本比较。
   */
  versionCode: number;
  /** 版本名（official 如 2026.10.01.1；custom 同 id） */
  versionName: string;
  /** official = manifest 下发（可更新）；custom = 用户直链（不自动更新） */
  source: string;
  /** 包目录绝对路径 */
  dir: string;
  /** 安装时间（毫秒） */
  installedAt: number;
};

/** 本地状态（state.json，schema 2） */
export type SourceLocalState = {
  schema: number;
  /** 已落盘的全部播放包（official 至多一个 + 任意多个 custom） */
  packs: PlayPackMeta[];
  /** 生效中的包 id（"" = 没有任何生效包，在线取链不可用） */
  activeId: string;
  /** 装载/冒烟失败过的官方版本号，不再自动重下 */
  bad: number[];
  /** 上次检查更新时间（毫秒，节流用） */
  lastCheckAt: number;
  /** 官方包被覆盖前的版本（回退目标候选；目录不保留，仅记录元信息） */
  previousOfficial: PlayPackMeta | null;
};

// ==================== 平台文件 API ====================

// #ifdef APP-ANDROID
function fsDataDir(): string {
  return nativeDataDir();
}

function fsRead(path: string): Promise<string> {
  return new Promise<string>((resolve, reject) => {
    nativeReadTextFile(path, (ok: boolean, value: string, error: string) => {
      if (ok) {
        resolve(value);
      } else {
        reject(new Error(error));
      }
    });
  });
}

function fsWrite(path: string, text: string): Promise<boolean> {
  return new Promise<boolean>((resolve, reject) => {
    nativeWriteTextFile(path, text, (ok: boolean, value: string, error: string) => {
      if (ok) {
        resolve(true);
      } else {
        reject(new Error(error));
      }
    });
  });
}

function fsExists(path: string): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    nativeExists(path, (ok: boolean, value: string, error: string) => {
      resolve(ok && value == "1");
    });
  });
}

function fsRemove(path: string): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    nativeRemove(path, (ok: boolean, value: string, error: string) => {
      resolve(ok);
    });
  });
}

function fsMkdirs(path: string): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    nativeMkdirs(path, (ok: boolean, value: string, error: string) => {
      resolve(ok);
    });
  });
}
// #endif

// #ifndef APP-ANDROID
function fsDataDir(): string {
  return "";
}

function fsRead(path: string): Promise<string> {
  return Promise.reject(new Error(UNSUPPORTED));
}

function fsWrite(path: string, text: string): Promise<boolean> {
  return Promise.reject(new Error(UNSUPPORTED));
}

function fsExists(path: string): Promise<boolean> {
  return Promise.resolve(false);
}

function fsRemove(path: string): Promise<boolean> {
  return Promise.resolve(false);
}

function fsMkdirs(path: string): Promise<boolean> {
  return Promise.resolve(false);
}
// #endif

// #ifdef APP-ANDROID
function fsListNames(dir: string): Promise<string[]> {
  return new Promise<string[]>((resolve) => {
    nativeListDir(dir, (ok: boolean, value: string, error: string) => {
      if (!ok) {
        resolve([] as string[]);
        return;
      }
      const out: string[] = [];
      try {
        const arr = JSON.parse(value) as UTSJSONObject[];
        for (let i = 0; i < arr.length; i++) {
          const o = arr[i];
          const isDir = o.get("dir") as boolean | null;
          const name = o.get("name") as string | null;
          if (isDir == true && name != null) out.push(name);
        }
      } catch (_) {}
      resolve(out);
    });
  });
}
// #endif

// #ifndef APP-ANDROID
function fsListNames(dir: string): Promise<string[]> {
  return Promise.resolve([] as string[]);
}
// #endif

// ==================== 路径 ====================

/** 播放包根目录（空串 = 当前平台不可用） */
export function packageRoot(): string {
  const base = fsDataDir();
  if (base.length == 0) return "";
  return base + "/" + ROOT_NAME;
}

/** install/ 目录（全部播放包的父目录） */
export function installDir(): string {
  return packageRoot() + "/" + INSTALL_DIR;
}

/** 某个包的目录（id 即目录名） */
export function packDirOf(id: string): string {
  return installDir() + "/" + id;
}

/** 某个产物在包目录里的绝对路径（path 用 ARTIFACT_* 常量） */
export function artifactPath(id: string, path: string): string {
  return packDirOf(id) + "/" + path;
}

export function statePath(): string {
  return packageRoot() + "/" + STATE_FILE;
}

/** 新 custom 包 id：custom-<yyyyMMdd-HHmmss>（本地时间，同秒重复安装加序号） */
export function customPackId(): string {
  const d = new Date();
  const pad = (n: number): string => (n < 10 ? "0" + n : "" + n);
  const stamp =
    d.getFullYear() +
    pad(d.getMonth() + 1) +
    pad(d.getDate()) +
    "-" +
    pad(d.getHours()) +
    pad(d.getMinutes()) +
    pad(d.getSeconds());
  let id = "custom-" + stamp;
  // 同秒内二次安装：后缀 -2/-3…，避免覆盖上一份
  let suffix = 2;
  while (packById(id) != null) {
    id = "custom-" + stamp + "-" + suffix;
    suffix += 1;
  }
  return id;
}

// ==================== 内存副本 + 读写 ====================

let gState: SourceLocalState = emptyState();

/** restoreLocalState 的单飞句柄：进程内只恢复一次（重复恢复会把内存状态清空重读） */
let gRestorePromise: Promise<SourceLocalState> | null = null;

/** 同步读本地状态（启动预热后可用；未预热时是空状态） */
export function localState(): SourceLocalState {
  return gState;
}

export function emptyState(): SourceLocalState {
  return {
    schema: 2,
    packs: [] as PlayPackMeta[],
    activeId: "",
    bad: [] as number[],
    lastCheckAt: 0,
    previousOfficial: null,
  } as SourceLocalState;
}

/** 全部已落盘的播放包（拷贝一份，防调用方改内存状态） */
export function packs(): PlayPackMeta[] {
  const out: PlayPackMeta[] = [];
  for (let i = 0; i < gState.packs.length; i++) out.push(clonePack(gState.packs[i]));
  return out;
}

export function packById(id: string): PlayPackMeta | null {
  for (let i = 0; i < gState.packs.length; i++) {
    if (gState.packs[i].id == id) return clonePack(gState.packs[i]);
  }
  return null;
}

/** 生效中的播放包（null = 未安装，在线取链不可用） */
export function activePack(): PlayPackMeta | null {
  if (gState.activeId.length == 0) return null;
  return packById(gState.activeId);
}

/** 官方播放包（至多一个；null = 未安装官方包） */
export function officialPack(): PlayPackMeta | null {
  return packById(OFFICIAL_PACK_ID);
}

/**
 * 从磁盘恢复本地状态到内存（幂等，进程内单飞）。
 * 恢复时做两件清洗：
 *   1. schema 1 旧状态 → 迁移（清 pkg/，保 bad/lastCheckAt）；
 *   2. 落盘校验：play-bundle.js 不在的包直接剔除（防「状态在、文件被清」），
 *      生效包被剔除时 activeId 清空（回到未安装）。
 */
export async function restoreLocalState(): Promise<SourceLocalState> {
  gState = emptyState();
  try {
    const raw = await fsRead(statePath());
    if (raw.length > 0) {
      const o = JSON.parse(raw) as UTSJSONObject;
      if (o.get("packs") == null) {
        // schema 1（单包 installed/previous）：旧包是单体全量 ESM，双包引擎
        // 装不了（bundle 槽现在恒放 meta），整体清掉只保 bad/lastCheckAt
        await migrateFromV1(o);
      } else {
        const state = stateFromJson(o);
        await validateOnDisk(state);
        gState = state;
      }
    }
  } catch (_) {
    // 读不到/解析不了 state.json 就当空状态（未安装）
  }
  return gState;
}

/** v1 → v2 迁移：删 pkg/ 整棵 + install/ 残留，state 重写为 schema 2 */
async function migrateFromV1(old: UTSJSONObject): Promise<void> {
  const state = emptyState();
  const bad = old.get("bad") as number[] | null;
  if (bad != null) {
    for (let i = 0; i < bad.length; i++) {
      const n = bad[i] as number;
      if (n != null && n != 0) state.bad.push(n);
    }
  }
  state.lastCheckAt = numOf(old, "lastCheckAt");
  await fsRemove(packageRoot() + "/pkg");
  await fsRemove(installDir());
  gState = state;
  await saveLocalState(state);
  console.log("[SourceBundleFs] schema 1 → 2 迁移完成（旧单体包已清除，需重新安装播放包）");
}

/** 剔除 play-bundle.js 不在盘上的包；生效包被剔除则清空 activeId */
async function validateOnDisk(state: SourceLocalState): Promise<void> {
  const kept: PlayPackMeta[] = [];
  for (let i = 0; i < state.packs.length; i++) {
    const p = state.packs[i];
    const ok = await fsExists(artifactPath(p.id, ARTIFACT_PLAY));
    if (ok) {
      kept.push(p);
    } else {
      console.log(`[SourceBundleFs] 包 ${p.id} 的 ${ARTIFACT_PLAY} 不在盘上，已剔除`);
      if (state.activeId == p.id) state.activeId = "";
      if (state.previousOfficial != null && state.previousOfficial.id == p.id) {
        state.previousOfficial = null;
      }
    }
  }
  state.packs = kept;
}

/**
 * 确保本地状态已从磁盘恢复（进程内幂等，只跑一次）。
 *
 * 为什么需要：恢复是异步的，而首页等页面现在直接依赖引擎数据（数据面只需内置
 * meta，但播放面要读 activeId），页面调用完全可能赶在预热完成之前——直接读
 * activePack() 会拿到空状态，误报「未安装」。所有链路必须先过这里。
 */
export function ensureLocalStateRestored(): Promise<SourceLocalState> {
  if (gRestorePromise == null) {
    gRestorePromise = restoreLocalState();
    // 恢复失败不该让所有等待方集体报错：失败时 activePack() 自然为 null，
    // 各调用方按「没有可用包」走自己的兜底
    gRestorePromise.catch(() => {});
  }
  return gRestorePromise;
}

/** 写本地状态（同时更新内存副本） */
export async function saveLocalState(state: SourceLocalState): Promise<boolean> {
  try {
    await fsWrite(statePath(), JSON.stringify(stateToJson(state)));
    gState = state;
    return true;
  } catch (_) {
    return false;
  }
}

/** 只更新 lastCheckAt 并落盘（节流用） */
export async function touchLastCheck(at: number): Promise<void> {
  const next = cloneState(gState);
  next.lastCheckAt = at;
  await saveLocalState(next);
}

export function cloneState(s: SourceLocalState): SourceLocalState {
  const packList: PlayPackMeta[] = [];
  for (let i = 0; i < s.packs.length; i++) packList.push(clonePack(s.packs[i]));
  const bad: number[] = [];
  for (let i = 0; i < s.bad.length; i++) bad.push(s.bad[i]);
  return {
    schema: s.schema,
    packs: packList,
    activeId: s.activeId,
    bad: bad,
    lastCheckAt: s.lastCheckAt,
    previousOfficial: s.previousOfficial != null ? clonePack(s.previousOfficial) : null,
  } as SourceLocalState;
}

export function clonePack(p: PlayPackMeta): PlayPackMeta {
  return {
    id: p.id,
    name: p.name,
    versionCode: p.versionCode,
    versionName: p.versionName,
    source: p.source,
    dir: p.dir,
    installedAt: p.installedAt,
  } as PlayPackMeta;
}

// ==================== 包级操作（增/删/切换） ====================

/** 新增或替换一个包记录（同 id 覆盖，如 official 原地更新） */
export async function putPack(meta: PlayPackMeta): Promise<boolean> {
  const next = cloneState(gState);
  const list: PlayPackMeta[] = [];
  let replaced = false;
  for (let i = 0; i < next.packs.length; i++) {
    if (next.packs[i].id == meta.id) {
      list.push(clonePack(meta));
      replaced = true;
    } else {
      list.push(next.packs[i]);
    }
  }
  if (!replaced) list.push(clonePack(meta));
  // official 排最前，custom 按安装时间新→旧（设置页列表顺序）
  const officials = list.filter((p) => p.source == PACK_SOURCE_OFFICIAL);
  const customs = list
    .filter((p) => p.source != PACK_SOURCE_OFFICIAL)
    .sort((a, b) => (a.installedAt > b.installedAt ? -1 : 1));
  next.packs = officials.concat(customs);
  return saveLocalState(next);
}

/** 记录「官方包被覆盖前的版本」（回退目标候选） */
export async function setPreviousOfficial(meta: PlayPackMeta | null): Promise<boolean> {
  const next = cloneState(gState);
  next.previousOfficial = meta != null ? clonePack(meta) : null;
  return saveLocalState(next);
}

/** 切换生效包（包必须已落盘；传 "" 表示全部不生效） */
export async function setActive(id: string): Promise<boolean> {
  if (id.length > 0 && packById(id) == null) return false;
  const next = cloneState(gState);
  next.activeId = id;
  return saveLocalState(next);
}

/**
 * 卸载一个包：删目录 + 出列表；卸的是生效包则 activeId 清空（回到未安装，
 * 由用户在列表里另选或重装）。返回是否成功。
 */
export async function removePack(id: string): Promise<boolean> {
  const next = cloneState(gState);
  const list: PlayPackMeta[] = [];
  for (let i = 0; i < next.packs.length; i++) {
    if (next.packs[i].id != id) list.push(next.packs[i]);
  }
  next.packs = list;
  if (next.activeId == id) next.activeId = "";
  if (next.previousOfficial != null && next.previousOfficial.id == id) {
    next.previousOfficial = null;
  }
  await fsRemove(packDirOf(id));
  return saveLocalState(next);
}

/**
 * 清掉全部播放包（回到「未安装」）：state.json 重置、install/ 整棵删除。
 * 排查/迁移用；正常卸载走 removePack（逐包）。
 */
export async function clearAllPacks(): Promise<void> {
  gState = emptyState();
  await fsRemove(packageRoot());
}

/** 清理孤儿目录：install/ 下不在 packs 里的目录（上次卸载/落盘中断的残留） */
export async function pruneOrphans(): Promise<void> {
  const names = await fsListNames(installDir());
  for (let i = 0; i < names.length; i++) {
    if (packById(names[i]) == null) {
      await fsRemove(packDirOf(names[i]));
    }
  }
}

// ==================== 产物读写 ====================

export function ensurePackDir(id: string): Promise<boolean> {
  return fsMkdirs(packDirOf(id));
}

/** 写一个产物到包目录（调用前先 ensurePackDir） */
export function writePackArtifact(id: string, path: string, text: string): Promise<boolean> {
  return fsWrite(artifactPath(id, path), text);
}

/** 读一个产物；读不到返回 "" */
export async function readPackArtifact(id: string, path: string): Promise<string> {
  try {
    return await fsRead(artifactPath(id, path));
  } catch (_) {
    return "";
  }
}

/** 删一个产物（文件本就不存在也算成功）；发布清单不再列出某产物时用它清掉旧覆盖层 */
export function removePackArtifact(id: string, path: string): Promise<boolean> {
  return fsRemove(artifactPath(id, path));
}

/** 按绝对路径读文本（下载中转的临时文件用）；读不到返回 "" */
export async function readTextFileAt(path: string): Promise<string> {
  try {
    return await fsRead(path);
  } catch (_) {
    return "";
  }
}

/** 按绝对路径写文本 */
export function writeTextFileAt(path: string, text: string): Promise<boolean> {
  return fsWrite(path, text);
}

/** 按绝对路径删除文件/目录 */
export function removeFileAt(path: string): Promise<boolean> {
  return fsRemove(path);
}

/** 按绝对路径判断存在 */
export function existsFileAt(path: string): Promise<boolean> {
  return fsExists(path);
}

// ==================== 坏包名单 ====================

/**
 * 把一个官方版本号标记为坏包（装载/冒烟失败后调用），自动更新不再重下它。
 * custom 包不进名单：它没有版本号语义，失败也保留在列表里由用户处理。
 */
export async function markBad(versionCode: number): Promise<void> {
  if (versionCode <= 0) return;
  const next = cloneState(gState);
  let exists = false;
  for (let i = 0; i < next.bad.length; i++) {
    if (next.bad[i] == versionCode) exists = true;
  }
  if (!exists) next.bad.push(versionCode);
  await saveLocalState(next);
}

export function isBad(versionCode: number): boolean {
  for (let i = 0; i < gState.bad.length; i++) {
    if (gState.bad[i] == versionCode) return true;
  }
  return false;
}

// ==================== JSON ↔ 类型 ====================

function packToJson(p: PlayPackMeta): UTSJSONObject {
  const o = new UTSJSONObject();
  o.set("id", p.id);
  o.set("name", p.name);
  o.set("versionCode", p.versionCode);
  o.set("versionName", p.versionName);
  o.set("source", p.source);
  o.set("dir", p.dir);
  o.set("installedAt", p.installedAt);
  return o;
}

function packFromJson(v: UTSJSONObject | null): PlayPackMeta | null {
  if (v == null) return null;
  const id = strOf(v, "id");
  if (id.length == 0) return null;
  return {
    id: id,
    name: strOf(v, "name"),
    versionCode: numOf(v, "versionCode"),
    versionName: strOf(v, "versionName"),
    // 旧数据缺 source 一律按 official 兜底（custom 记录从 v2 起就有）
    source: strOf(v, "source").length > 0 ? strOf(v, "source") : PACK_SOURCE_OFFICIAL,
    dir: strOf(v, "dir"),
    installedAt: numOf(v, "installedAt"),
  } as PlayPackMeta;
}

function stateToJson(s: SourceLocalState): UTSJSONObject {
  const o = new UTSJSONObject();
  o.set("schema", s.schema);
  const packList: UTSJSONObject[] = [];
  for (let i = 0; i < s.packs.length; i++) packList.push(packToJson(s.packs[i]));
  o.set("packs", packList);
  o.set("activeId", s.activeId);
  o.set("bad", s.bad);
  o.set("lastCheckAt", s.lastCheckAt);
  o.set("previousOfficial", s.previousOfficial != null ? packToJson(s.previousOfficial) : null);
  return o;
}

function stateFromJson(o: UTSJSONObject): SourceLocalState {
  const state = emptyState();
  const packList = o.get("packs") as UTSJSONObject[] | null;
  if (packList != null) {
    for (let i = 0; i < packList.length; i++) {
      const p = packFromJson(packList[i] as UTSJSONObject);
      if (p != null) state.packs.push(p);
    }
  }
  state.activeId = strOf(o, "activeId");
  state.lastCheckAt = numOf(o, "lastCheckAt");
  const bad = o.get("bad") as number[] | null;
  if (bad != null) {
    const list: number[] = [];
    for (let i = 0; i < bad.length; i++) {
      const n = bad[i] as number;
      if (n != null && n != 0) list.push(n);
    }
    state.bad = list;
  }
  state.previousOfficial = packFromJson(o.get("previousOfficial") as UTSJSONObject | null);
  return state;
}

function strOf(o: UTSJSONObject, key: string): string {
  const v = o.get(key);
  if (v == null) return "";
  return `${v}`;
}

function numOf(o: UTSJSONObject, key: string): number {
  const v = o.get(key);
  if (v == null) return 0;
  const n = v as number;
  if (n == null) return 0;
  return n;
}
