/**
 * 页面侧诊断日志出口。
 *
 * 为什么需要这个文件：**`.uvue` 页面里的 console.log 不会进 logcat**。
 * 真机实测（2026-09-23，微光「歌词不跟随进度」排查）：播放页确实打开了
 * （logcat 有 `onReady pageUrl:/pages/player/index`），但页面里写的 3 条
 * `[QT Lyric]` 一条都没有；而 `.uts` 里的 console.log 会带文件名行号正常出现
 * （如 `[SourceEngine] … at services/source-engine.uts:247`）。
 *
 * 所以页面里想观测的状态（歌词行数、行高测量结果、滚动目标…）统一从这里打出去。
 *
 * 2026-10 起改为走 services/logger.uts：既进控制台（连着电脑调试时看），
 * 也落本地文件（发行包用户报障时能查）——发行版没有控制台，只打 console
 * 等于这些诊断点在最需要的时候全都不存在。
 */
import { logMsg } from "@/services/logger";

/**
 * 22 个调用点都按仓库惯例在消息里自带 `[Tag]`（`[QT Lyric]`、`[QT Music API]`…），
 * 所以这里走 logMsg 让它把标签拆出来，而不是再套一层固定的 "Diag"
 * ——否则日志里会出现 `[Diag] [QT Lyric] …` 这种双层标签。
 */
export function qtDiag(msg: string): void {
  logMsg(msg);
}
