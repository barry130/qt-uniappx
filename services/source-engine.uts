/**
 * 音源引擎门面（app 侧，双包架构）
 *
 * 引擎上下文分两层装配：
 *   ① 元数据包（meta-bundle.js，同样不内置）：用户在设置页从链接或本地文件安装，
 *      装进 qt-js-engine 的**唯一 bundle 槽**（插件经 https://qt.local/qt-bundle.js
 *      动态 import ESM；meta 顶层检测到 globalThis.__qtHost 时自注册 __qtEntries）。
 *      搜索/歌单/专辑/歌词/封面等数据入口与 verifyPlayable 都由它提供——
 *      **未安装时数据面整体下线**（本地音乐不受影响），首页引导只指路设置页。
 *   ② 播放音源包（play-bundle.js，高版权风险，同样不内置）：用户在设置页安装
 *      （自定义直链；已装包的更新经 manifest 提示），文本经 meta 的
 *      installPlayPack 入口 eval 注入同一引擎上下文
 *      （globalThis.__qtPlayPackFactory 约定），getPlayUrl/loadChain 由 meta 转发给它。
 *
 * 生效中的播放包由 source-bundle-fs 的 activeId 指定（多包并存、其一生效）；
 * 这里维护「引擎里已注入的是哪个包」（gPlayPackLoadedId），切换/更新后热注入。
 *
 * ── meta 入口契约（hostApiVersion = 1，与 qt-pc 同一份 meta-bundle.js）──
 *   bundleInfo()          → {name:"meta-bundle", version:"meta.1", metaRevision,
 *                            playPack:{name,version}|null, platforms, hostApiVersion}
 *   installPlayPack(args) → {ok, playPack:{name,version}}；包代码非法时抛错
 *   uninstallPlayPack()   → {ok}
 *   loadChain(chainJson)  → {ok:true, lines:N}；chain 非法时抛错
 *   getPlayUrl(args)      → {url, source, quality, line}；未装播放包时抛
 *                            PLAY_PACK_MISSING_MESSAGE（“未安装播放音源包…”）
 *   verifyPlayable(args)  → {ok, status, length}（实现在 meta，冒烟预检不依赖播放包）
 *   其余数据入口（search/searchPlaylists/lyric/cover/...）与旧单体包同名同形。
 * args 都是「单个对象的 JSON 数组文本」（引擎边界只走字符串，位置参数）。
 *
 * line 是取链命中线路 {id,name,kind}（kind 另有 "cross"=跨源兜底），供管理端
 * 「当前播放地址」显示；包内缓存命中时为 null（见 parsePlayUrlLine 的兼容注释）。
 *
 * 契约版本不匹配时**拒绝装载**：入口名/参数形状变了以后静默失败比直接降级更难排查。
 */

import type { Song } from "@/types/music";
import type { SourcePackMeta } from "@/services/source-bundle-fs";
import { parsePackHeader } from "@/services/source-pack-header";
import {
  start,
  stop,
  loadBundle,
  invoke,
  evaluate,
  readAssetText,
  isRunning,
  isHealthy,
} from "@/uni_modules/qt-js-engine";
import {
  activePack,
  activeMetaPack,
  readPackArtifact,
  ensureLocalStateRestored,
  ARTIFACT_CHAIN,
  ARTIFACT_PLAY,
  ARTIFACT_META,
  PACK_KIND_META,
} from "@/services/source-bundle-fs";

/** 与插件 interface.uts 对应的结构类型（服务层不引插件类型，避免跨模块类型耦合） */
type EngineInfo = { engine: string; version: string; hostApiVersion: number; probe: string };
/** 引擎启动参数：V8 后端不需要任何参数（内存/栈上限是已删除的 QuickJS 后端专有开关） */
type StartOptions = {};
type VoidResult = { ok: boolean; error: string };
type EvalResult = { ok: boolean; value: string; error: string };

export type SourceEngineStatus = "idle" | "starting" | "loading" | "ready" | "failed";

/**
 * 装载失败的原因分类：热更新侧据此决定「是不是坏包」。
 * invalid = 包本身有问题（语法错/chain 非法）→ 可以拉黑；
 * missing / engine / contract 都是环境或本机问题，不能拉黑好包。
 */
export type SourceLoadFailure = "" | "missing" | "invalid" | "engine" | "contract";

/** 宿主契约版本（manifest 里也有这个字段，两边必须一致） */
const HOST_API_VERSION = 1;
/** 取链超时：包含 bundle 内所有 HTTP 与定时器等待 */
const PLAY_TIMEOUT_MS = 12000;
/** 冒烟/试听校验超时 */
const VERIFY_TIMEOUT_MS = 8000;
/** 装载 chain 的超时（纯本地计算，给短一点） */
const LOAD_CHAIN_TIMEOUT_MS = 4000;
/** installPlayPack 注入超时：eval 1.7MB IIFE 一般 <1s，留足余量 */
const INSTALL_PACK_TIMEOUT_MS = 15000;
/** bundleInfo 探测超时 */
const BUNDLE_INFO_TIMEOUT_MS = 4000;

/**
 * 「未安装播放音源包」提示事件：getPlayUrl 失败且原因是没装播放包时广播
 * （10s 节流）。App.uvue 接住弹一次引导弹窗（去设置安装），与 qt-pc 的
 * PlayPackPrompt 同口径——提示需要安装，不内置下载链接，跳转设置页。
 */
export const PLAY_PACK_MISSING_EVENT = "qt-play-pack-missing";
const PLAY_PACK_MISSING_MESSAGE_PART = "未安装播放音源包";
let gLastMissingEmitAt = 0;

/**
 * 引擎被隔离（poison：单次 evaluate 同步执行超过插件侧 STALL_MS）后的自动重建策略。
 *
 * 隔离是**全局**的：gPoisoned 一置位，搜索/歌单/歌词/榜单/取链全部立刻失败，
 * 且插件侧不会自己复位——只有 stop() 才能清掉（stop 对已隔离引擎是「放弃卡住的
 * 线程」直接重建，那个线程会成为泄漏，已记录为插件的已知代价）。
 * 所以服务层必须自己发现并重建，否则一次超时就等于永久不可用，用户只能手动重启。
 *
 * 但重建不能无上限：若某个包/线路必然超时，每次请求都「重建 → 又超时」会把
 * 卡住的线程越攒越多（每个都占着 128MB 内存上限）。故设「时间窗内最多 N 次」。
 */
const MAX_REVIVES_PER_WINDOW = 3;
const REVIVE_WINDOW_MS = 10 * 60 * 1000;
/** 两次自动重建的最小间隔，避免连续请求触发重建风暴 */
const MIN_REVIVE_INTERVAL_MS = 20000;

let gStatus: SourceEngineStatus = "idle";
let gEngineVersion = "";
/** 引擎内核标识（固定 webview-v8）：排查「安卓到底跑的哪个引擎」用 */
let gEngineName = "";
let gLastError = "";
let gLoadFailure: SourceLoadFailure = "";
/** 内置 meta 是否已装进引擎（引擎重建/隔离后归零；未装数据包时恒为 false） */
let gMetaReady = false;
/** 引擎里实际装载的 meta 来源：包 id（如 meta-official）；数据包不内置，未装时为 "" */
let gMetaLoadedId = "";
/** 引擎里实际装载的 meta 版本号（未装时为 0） */
let gMetaLoadedCode = 0;
/** 已成功注入引擎的播放包 id（"" = 没注入任何播放包） */
let gPlayPackLoadedId = "";
/** 已成功注入引擎的播放包版本号（0 = 无；设置页/红点比对用） */
let gPlayPackLoadedCode = 0;
/** 注入失败过的播放包 id，避免每次播放都重试同一个坏包 */
let gPlayPackFailedId = "";
/** 起引擎的并发去重 */
let gBootPromise: Promise<boolean> | null = null;
/** 装 meta 的并发去重 */
let gMetaPromise: Promise<boolean> | null = null;
/** 注入播放包的并发去重 */
let gPlayPackPromise: Promise<boolean> | null = null;
/** 自动重建的滑动窗口计数（见 MAX_REVIVES_PER_WINDOW） */
let gReviveWindowStart = 0;
let gRevivesInWindow = 0;
let gLastReviveAt = 0;

export function engineStatus(): SourceEngineStatus {
  return gStatus;
}

export function engineVersion(): string {
  return gEngineVersion;
}

/** 引擎内核标识：固定 webview-v8（系统 WebView 的 V8/JIT）。真机排查第一眼看这个 */
export function engineName(): string {
  return gEngineName;
}

/** 引擎里已注入的播放包 id（"" = 未注入；与 activeId 比对即「待生效」） */
export function loadedPlayPackId(): string {
  return gPlayPackLoadedId;
}

/** 引擎里已注入的播放包版本号（0 = 未注入） */
export function loadedPlayPackCode(): number {
  return gPlayPackLoadedCode;
}

/** 引擎里实际装载的 meta 来源 id（"" = 未装数据包，数据面下线；与 activeMetaId 比对即「待生效」） */
export function loadedMetaId(): string {
  return gMetaLoadedId;
}

/** 引擎里实际装载的 meta 版本号（0 = 未装） */
export function loadedMetaCode(): number {
  return gMetaLoadedCode;
}

export function lastEngineError(): string {
  return gLastError;
}

/** 上次装载失败的原因分类（见 SourceLoadFailure） */
export function loadFailureKind(): SourceLoadFailure {
  return gLoadFailure;
}

/**
 * 引擎当前是否可用于**数据入口**（搜索/歌单/歌词…）：只需已装数据包。
 * 播放取链是否可用要另看 playPackReady()。
 */
export function engineUsable(): boolean {
  return gStatus == "ready" && gMetaReady && isRunning() && isHealthy();
}

/** 引擎当前是否可用于**取链**：meta + 播放包都已注入且引擎健康 */
export function playPackReady(): boolean {
  return engineUsable() && gPlayPackLoadedId.length > 0;
}

function msgOf(e: any): string {
  if (e == null) return "unknown error";
  return `${e}`;
}

function fail(message: string): void {
  gStatus = "failed";
  gLastError = message;
  console.log("[SourceEngine] " + message);
}

// ==================== 插件回调 → Promise ====================

function callStart(options: StartOptions): Promise<EngineInfo> {
  return new Promise<EngineInfo>((resolve, reject) => {
    start(options, (info: EngineInfo | null, error: string | null) => {
      if (info != null) {
        resolve(info);
      } else {
        reject(new Error(error != null ? error : "引擎启动失败"));
      }
    });
  });
}

function callStop(): Promise<boolean> {
  return new Promise<boolean>((resolve) => {
    stop((r: VoidResult) => {
      resolve(r.ok);
    });
  });
}

function callLoadBundle(code: string): Promise<boolean> {
  return new Promise<boolean>((resolve, reject) => {
    loadBundle(code, (r: VoidResult) => {
      if (r.ok) {
        resolve(true);
      } else {
        reject(new Error(r.error));
      }
    });
  });
}

function callInvoke(name: string, argsJson: string, timeoutMs: number): Promise<string> {
  return new Promise<string>((resolve, reject) => {
    invoke(name, argsJson, timeoutMs, (r: EvalResult) => {
      if (r.ok) {
        resolve(r.value);
      } else {
        reject(new Error(r.error));
      }
    });
  });
}

/**
 * 在引擎里执行一段同步 JS 表达式（String(...) 收尾），返回求值字符串。
 * 官方包验签专用（nacl 装载 + verify），业务取链仍走 callInvoke。
 * 返回值可能是 evaluateJavascript 的 JSON 序列化形式（两端带引号），调用方需 stripEvalQuotes。
 */
function callEvaluate(code: string): Promise<string> {
  return new Promise<string>((resolve, reject) => {
    evaluate(code, (r: EvalResult) => {
      if (r.ok) {
        resolve(r.value);
      } else {
        reject(new Error(r.error));
      }
    });
  });
}

/** 读 APK assets 里的文本（官方包验签的 nacl 实现就放在 static/pack-verify/） */
function callReadAssetText(path: string): Promise<string> {
  return new Promise<string>((resolve, reject) => {
    readAssetText(path, (ok: boolean, value: string, error: string) => {
      if (ok) {
        resolve(value);
      } else {
        reject(new Error(error));
      }
    });
  });
}

/** 剥掉 evaluateJavascript JSON 序列化字符串两端可能带的引号（含 \" 转义还原） */
export function stripEvalQuotes(value: string): string {
  let v = value.trim();
  if (v.length >= 2 && v.charAt(0) == '"' && v.charAt(v.length - 1) == '"') {
    v = v.substring(1, v.length - 1);
    v = v.split('\\"').join('"').split("\\\\").join("\\").split("\\n").join("\n");
  }
  return v;
}

/** 官方包验签器（nacl）是否已装进当前引擎 */
let gVerifierReady = false;

/**
 * 确保引擎里已装载官方包验签器（tweetnacl，static/pack-verify/nacl.min.js，
 * 纯 JS 同步实现，装载后挂全局 self.nacl）。引擎重建后归零重装（resetLoadedState）。
 * 幂等：已就绪直接返回；重复装载也只重复定义全局，无副作用。
 */
export async function ensurePackVerifier(): Promise<boolean> {
  if (gVerifierReady) return true;
  if (!(await ensureEngine())) return false;
  try {
    const asset = await callReadAssetText("static/pack-verify/nacl.min.js");
    if (asset.length < 1000) {
      console.log("[SourceEngine] 验签器资产缺失或过短：" + String(asset.length));
      return false;
    }
    // 末尾判断装载结果：nacl-fast.min 会挂 self.nacl（WebView 里 self === window）
    const probe = await callEvaluate(asset + ";String(typeof self.nacl==='object'&&typeof nacl.sign==='object'&&typeof nacl.sign.detached==='object'?'ok':'missing')");
    const ok = stripEvalQuotes(probe) == "ok";
    if (ok) {
      gVerifierReady = true;
    } else {
      console.log("[SourceEngine] 验签器装载探测失败：" + probe);
    }
    return ok;
  } catch (e) {
    console.log("[SourceEngine] 验签器装载异常：" + String(e));
    return false;
  }
}

/** 在引擎里跑验签表达式（pack-signature.uts 组装），返回剥引号后的结果字符串 */
export async function evalOnEngine(code: string): Promise<string> {
  return stripEvalQuotes(await callEvaluate(code));
}

// ==================== 引擎生命周期 ====================

/**
 * 启动引擎（幂等，并发调用共用同一次启动）。
 *
 * 额外职责：**发现引擎被隔离并自动重建**。
 * 插件侧对「单次 evaluate 同步执行超过 STALL_MS」的脚本做 poison 隔离，被隔离后
 * gStatus 仍是 "ready"、isHealthy() 变 false，所有 invoke 立刻失败且永不恢复。
 * 这里把它降级为「这一次请求失败 + 下一次自动恢复」：
 *   stop()（放弃卡住的线程）→ start()，并归零 meta/播放包装载标记，
 *   让随后的 ensureDataEngine / ensurePlayPackLoaded 走完整重装。
 */
export function ensureEngine(): Promise<boolean> {
  if (gStatus == "ready" && !isHealthy()) {
    const now = Date.now();
    if (now - gReviveWindowStart > REVIVE_WINDOW_MS) {
      gReviveWindowStart = now;
      gRevivesInWindow = 0;
    }
    if (gRevivesInWindow >= MAX_REVIVES_PER_WINDOW || now - gLastReviveAt < MIN_REVIVE_INTERVAL_MS) {
      // 反复被隔离说明包/线路有系统性问题：不再重建，明确失败等用户手动重启。
      // 保持 gStatus = "ready"（而不是 failed），这样窗口过期后还能自动恢复。
      gLastError = `引擎多次被隔离（脚本执行超时），已暂停自动重建；请在设置里切换/重装播放包重建引擎`;
      console.log("[SourceEngine] " + gLastError);
      return Promise.resolve(false);
    }
    gRevivesInWindow += 1;
    gLastReviveAt = now;
    console.log(
      `[SourceEngine] 引擎已被隔离（脚本执行超时），自动重建（本窗口第 ${gRevivesInWindow}/${MAX_REVIVES_PER_WINDOW} 次）`,
    );
    gStatus = "idle";
    resetLoadedState();
    gLastError = "";
    const revived = reviveEngine();
    gBootPromise = revived;
    return revived;
  }
  if (gStatus == "ready" || gStatus == "loading") return Promise.resolve(true);
  const pending = gBootPromise;
  if (pending != null) return pending;
  const p = bootEngine();
  gBootPromise = p;
  return p;
}

/** 引擎重建后归零「已装载」标记（meta、播放包与验签器都要重装） */
function resetLoadedState(): void {
  gMetaReady = false;
  gMetaLoadedId = "";
  gMetaLoadedCode = 0;
  gPlayPackLoadedId = "";
  gPlayPackLoadedCode = 0;
  gPlayPackFailedId = "";
  gVerifierReady = false;
}

/** 被隔离后的重建：停掉旧引擎（放弃卡住的线程）再起一个新的 */
async function reviveEngine(): Promise<boolean> {
  await callStop();
  return await bootEngine();
}

async function bootEngine(): Promise<boolean> {
  gStatus = "starting";
  try {
    const info = await callStart({});
    if (info.hostApiVersion != HOST_API_VERSION) {
      gLoadFailure = "contract";
      fail(`宿主契约版本不匹配：引擎 ${info.hostApiVersion} / 期望 ${HOST_API_VERSION}`);
      return false;
    }
    gEngineVersion = info.version;
    gEngineName = info.engine;
    gLastError = "";
    gStatus = "idle";
    console.log(
      `[SourceEngine] 引擎就绪：${info.engine} ${info.version}（hostApiVersion ${info.hostApiVersion}，probe "${info.probe}"）`,
    );
    return true;
  } catch (e) {
    gLoadFailure = "engine";
    fail(`引擎启动失败：${msgOf(e)}`);
    return false;
  } finally {
    gBootPromise = null;
  }
}

/** 停止引擎（换包/排查时用；平时不需要停） */
export async function shutdownEngine(): Promise<void> {
  await callStop();
  gStatus = "idle";
  gEngineVersion = "";
  resetLoadedState();
  gLoadFailure = "";
  // 手动重启 = 用户已介入，清掉自动重建的限流窗口，让它重新可用
  gReviveWindowStart = 0;
  gRevivesInWindow = 0;
  gLastReviveAt = 0;
}

// ==================== ① 装 meta（数据面） ====================

/**
 * 确保「引擎已起 + 生效 meta 已装」（幂等，并发单飞）。
 * 这是数据入口（invokeSource）的唯一前置——**没有播放包也成功**，
 * 搜索/歌单/歌词等数据功能与播放解耦正是双包架构的要点。
 * 数据包不内置：未安装时返回 false（failure=missing），数据面下线不是引擎错误。
 */
export async function ensureDataEngine(): Promise<boolean> {
  await ensureLocalStateRestored();
  if (!(await ensureEngine())) {
    gLoadFailure = "engine";
    return false;
  }
  if (gMetaReady && isHealthy()) return true;
  const pending = gMetaPromise;
  if (pending != null) return pending;
  const p = loadMetaIntoEngine();
  gMetaPromise = p;
  return p;
}

/**
 * 解析要装进 bundle 槽的 meta 文本：生效中的 meta 包（source-bundle-fs 的
 * activeMetaId）。统一包模型：meta 包与播放包一样是用户安装的 js 文件，只是
 * 装进引擎的槽位不同——数据包不内置，未安装时返回 null（数据面下线，非错误）。
 */
async function resolveMetaText(): Promise<{ id: string; code: number; text: string } | null> {
  const pack = activeMetaPack();
  if (pack == null) return null;
  const text = await readPackArtifact(pack.id, ARTIFACT_META);
  const header = parsePackHeader(text);
  if (text.length > 0 && header != null && header.kind == PACK_KIND_META) {
    return { id: pack.id, code: header.versionCode, text: text };
  }
  console.log(`[SourceEngine] meta 包 ${pack.id} 不可用（文件缺失或包头非法）`);
  return null;
}

/** 把生效 meta（已装包）灌进 bundle 槽并验契约（bundleInfo 自述）；未装走下线路径 */
async function loadMetaIntoEngine(): Promise<boolean> {
  try {
    const pack = activeMetaPack();
    const meta = await resolveMetaText();
    if (meta == null) {
      if (pack == null) {
        // 未装数据包：数据面整体下线，不是引擎错误（本地音乐照常），首页/设置页引导
        gStatus = "idle";
        gLoadFailure = "missing";
        gLastError = "未安装数据包：在线搜索/歌单/歌词及在线播放不可用，可在 设置 → 音源包管理 安装";
        console.log("[SourceEngine] " + gLastError);
        return false;
      }
      // 生效包在列表里但文件没了/包头坏了：按坏包处理（可卸载后重装）
      gLoadFailure = "invalid";
      fail(`数据包 ${pack.id} 文件缺失或包头非法（可在列表卸载后重装）`);
      return false;
    }
    gStatus = "loading";
    // 插件内部会先 compile 做语法校验（不执行），再经动态 import 装载 ESM；
    // meta 顶层检测到 globalThis.__qtHost（prelude 已注入）时自注册 __qtEntries
    await callLoadBundle(meta.text);
    // 契约自检：bundleInfo 必须自述是 meta-bundle 且 hostApiVersion 一致
    // （旧「单体 ESM 官方包」自述 name=source-bundle，会在这里被拒——
    //  它们与双包客户端不兼容，需从设置页重新安装播放包）
    const infoText = await callInvoke("bundleInfo", "[]", BUNDLE_INFO_TIMEOUT_MS);
    const info = JSON.parse(infoText) as UTSJSONObject;
    const name = info.get("name") as string | null;
    const hostApi = info.get("hostApiVersion") as number | null;
    if (name != "meta-bundle" || hostApi == null || hostApi != HOST_API_VERSION) {
      gLoadFailure = "contract";
      fail(`元数据包契约不符：name=${name} hostApiVersion=${hostApi}`);
      return false;
    }
    gMetaReady = true;
    gMetaLoadedId = meta.id;
    gMetaLoadedCode = meta.code;
    gStatus = "ready";
    gLastError = "";
    const revision = info.get("metaRevision");
    console.log(
      `[SourceEngine] meta 已装载：${meta.id} v${meta.code}` +
        `（${name}，metaRevision=${revision}，hostApiVersion ${HOST_API_VERSION}）`,
    );
    return true;
  } catch (e) {
    // 装载阶段抛错多为包文本本身非法（插件 compile 校验不过）；环境级故障
    // （起不来/隔离）已在 ensureEngine 按 engine 分类，这里按坏包处理
    gLoadFailure = "invalid";
    fail(`元数据包装载失败：${msgOf(e)}`);
    return false;
  } finally {
    gMetaPromise = null;
  }
}

// ==================== ② 注入播放包（播放面） ====================

/**
 * 确保「生效中的播放包已注入引擎」（幂等，并发单飞）。
 * 返回 false 表示「本次取不了链」：没有生效包 / 引擎起不来 / meta 没装上 /
 * 播放包注入失败。注意播放注入走 meta 的 installPlayPack 入口——**数据包
 * 未装时在线播放同样不可用**（ensureDataEngine 先行失败，gLastError 已给出
 * 指路文案）。没有生效播放包时广播 PLAY_PACK_MISSING_EVENT（节流），
 * 由 App.uvue 弹引导安装的提示。
 */
export async function ensurePlayPackLoaded(): Promise<boolean> {
  await ensureLocalStateRestored();
  const pack = activePack();
  if (pack == null) {
    emitPlayPackMissing();
    return false;
  }
  if (!(await ensureDataEngine())) return false;
  if (gPlayPackLoadedId == pack.id && isHealthy()) return true;
  if (gPlayPackFailedId == pack.id && isHealthy()) return false;
  const pending = gPlayPackPromise;
  if (pending != null) return pending;
  const p = applyPlayPackInEngine(pack);
  gPlayPackPromise = p;
  return p;
}

/**
 * 把一个播放包注入引擎：installPlayPack（eval play-bundle.js，约定
 * globalThis.__qtPlayPackFactory）→ 有 chain.json 时 loadChain。
 * 失败分类：missing=文件没了；invalid=包代码/chain 非法（可拉黑）；
 * engine=meta 层都没就绪（环境问题）。
 */
async function applyPlayPackInEngine(pack: SourcePackMeta): Promise<boolean> {
  try {
    const code = await readPackArtifact(pack.id, ARTIFACT_PLAY);
    if (code.length == 0) {
      gPlayPackFailedId = pack.id;
      gLoadFailure = "missing";
      fail(`播放包文件缺失：${pack.id}`);
      return false;
    }
    gStatus = "loading";
    // meta 的 installPlayPack：new Function(code) 执行，取 __qtPlayPackFactory
    // 构造播放层并替换当前生效层；包代码抛错 = 包本身有问题
    const installArgs = new UTSJSONObject();
    installArgs.set("code", code);
    const resText = await callInvoke(
      "installPlayPack",
      JSON.stringify([installArgs]),
      INSTALL_PACK_TIMEOUT_MS,
    );
    const res = JSON.parse(resText) as UTSJSONObject;
    const okFlag = res.get("ok") as boolean | null;
    if (okFlag != true) {
      gPlayPackFailedId = pack.id;
      gLoadFailure = "invalid";
      const err = res.get("error") as string | null;
      fail(`播放包注入失败：${pack.id}（${err != null ? err : "installPlayPack 未成功"}）`);
      return false;
    }
    // chain.json 是可选线路覆盖层（内容与播放包内置默认链同源）：custom 直链
    // 包必无，official 的 manifest 也可不列——缺了就跳过 loadChain。
    const chain = await readPackArtifact(pack.id, ARTIFACT_CHAIN);
    if (chain.length > 0) {
      try {
        const chainResText = await callInvoke("loadChain", JSON.stringify([chain]), LOAD_CHAIN_TIMEOUT_MS);
        const chainRes = JSON.parse(chainResText) as UTSJSONObject;
        const chainOk = chainRes.get("ok") as boolean | null;
        if (chainOk != true) throw new Error("loadChain 应答 ok!=true");
      } catch (e) {
        // chain 不合法等于没有线路，按包有问题处理（否则每次播放都白跑一趟）
        gPlayPackFailedId = pack.id;
        gLoadFailure = "invalid";
        fail(`chain.json 装载失败：${msgOf(e)}`);
        return false;
      }
    }
    gPlayPackLoadedId = pack.id;
    gPlayPackLoadedCode = pack.versionCode;
    gPlayPackFailedId = "";
    gStatus = "ready";
    gLastError = "";
    gLoadFailure = "";
    console.log(
      `[SourceEngine] 播放包已注入：${pack.id}（${pack.versionName}，code ${pack.versionCode}）`,
    );
    return true;
  } catch (e) {
    // invoke 抛错：装载阶段（eval/loadChain 都是同步计算）失败按包问题处理
    gPlayPackFailedId = pack.id;
    gLoadFailure = "invalid";
    fail(`播放包装载失败：${pack.id}（${msgOf(e)}）`);
    return false;
  } finally {
    gPlayPackPromise = null;
  }
}

/** 「未安装播放音源包」广播（10s 节流；App.uvue 接住弹引导） */
function emitPlayPackMissing(): void {
  const now = Date.now();
  if (now - gLastMissingEmitAt < 10000) return;
  gLastMissingEmitAt = now;
  gLastError = "未安装播放音源包：在线播放需要在 设置 → 音源包管理 安装并启用播放音源包";
  console.log("[SourceEngine] " + gLastError);
  uni.$emit(PLAY_PACK_MISSING_EVENT);
}

/**
 * 从引擎里卸掉当前播放包（切包/卸载前的清理；meta 层保留，数据功能不受影响）。
 * 失败不阻塞调用方——引擎重建后播放包本来就要重注入。
 */
export async function unloadPlayPack(): Promise<void> {
  if (gPlayPackLoadedId.length == 0) return;
  const loaded = gPlayPackLoadedId;
  gPlayPackLoadedId = "";
  gPlayPackLoadedCode = 0;
  try {
    if (await ensureDataEngine()) {
      await callInvoke("uninstallPlayPack", "[]", LOAD_CHAIN_TIMEOUT_MS);
    }
  } catch (e) {
    console.log(`[SourceEngine] uninstallPlayPack 失败（${msgOf(e)}），将在下次注入时覆盖`);
  }
  console.log(`[SourceEngine] 播放包已卸载：${loaded}`);
}

/**
 * 让「生效 meta 变更」立即生效：整引擎重启（meta 在唯一 bundle 槽里，换它只能
 * 重装槽位）→ 重装 meta → 把生效播放包重新热注入。
 * meta 包安装/更新/卸载/停用后由 source-update 调用。音频播放器不受影响
 * （引擎只负责取链，正在放的歌继续放），之后的数据/取链请求自动走新 meta。
 */
export async function reloadEngineMeta(): Promise<boolean> {
  await shutdownEngine();
  if (!(await ensureDataEngine())) return false;
  if (activePack() != null) {
    return await ensurePlayPackLoaded();
  }
  return true;
}

// ==================== bundleInfo（诊断） ====================

/** 引擎侧 bundleInfo 应答（含 meta 版本与当前 playPack 自述）；不可用时返回 "" */
export async function bundleInfo(): Promise<string> {
  if (!(await ensureDataEngine())) return "";
  try {
    return await callInvoke("bundleInfo", "[]", BUNDLE_INFO_TIMEOUT_MS);
  } catch (e) {
    return "";
  }
}

// ==================== 取链 ====================

/**
 * 取链命中的音源线路：chain.json 里那条真正给出地址的源。
 * kind 取值 lx / http / bundle，另有 "cross" 表示「本档线路全灭、跨源兜底救回」。
 */
export type PlayUrlLine = { id: string; name: string; kind: string; targetSong: Song | null };

/**
 * 最近一次取链命中的线路。bundle 侧只在成功应答里带回来（失败走 trace），
 * 这里接住供调用方落进播放地址缓存——管理端要显示「当前这条地址走的是哪条源」，
 * 而地址会被缓存 10 分钟，线路信息必须与地址同生命周期，不能只看最后一次调用。
 */
let lastPlayUrlLine: PlayUrlLine | null = null;

/** 读走最近一次命中线路（读后即清）；无命中（包内缓存/老包）返回 null */
export function consumePlayUrlLine(): PlayUrlLine | null {
  const t = lastPlayUrlLine;
  lastPlayUrlLine = null;
  return t;
}

/**
 * 跨源兜底命中的目标歌（bundle 侧搜索匹配到的目标平台条目）。
 * 引擎歌曲条目不带 platform（单源契约按入参补），这里从线路 id 前缀取：
 * "cross:kw" → kw。非 cross 线路（或字段缺失）返回 null。
 */
function parseTargetSong(raw: any, lineId: string): Song | null {
  if (raw == null) return null;
  if (!lineId.startsWith("cross:")) return null;
  const platform = lineId.substring("cross:".length);
  if (platform.length == 0) return null;
  try {
    const o = raw as UTSJSONObject;
    const id = o.get("id") as string | null;
    if (id == null || id.length == 0) return null;
    const name = o.get("name") as string | null;
    const singer = o.get("singer") as string | null;
    const album = o.get("album") as string | null;
    const picUrl = o.get("picUrl") as string | null;
    const interval = o.get("interval") as number | null;
    const duration = o.get("duration") as number | null;
    const song: Song = {
      id: id,
      name: name != null ? name : "",
      singer: singer != null ? singer : "",
      album: album != null ? album : "",
      picUrl: picUrl != null ? picUrl : "",
      platform: platform,
      url: "",
      duration: duration != null ? duration : (interval != null ? interval : 0),
    };
    return song;
  } catch (_) {
    return null;
  }
}

/**
 * 解析应答里的 line 字段。形状不对（null/缺 id/非对象）一律按无命中处理。
 *
 * 兼容两种形状：新包是嵌套对象 `{id,name,kind}`，早期构建把它序列化成了
 * **字符串**（JSON 文本）。这里先按对象取，取不到再按字符串 parse 一次——
 * 这样升级顺序（先换包 / 先换 App）都不会让管理端显示不出线路。
 */
function parsePlayUrlLine(raw: any): PlayUrlLine | null {
  if (raw == null) return null;
  // ① 对象形状（当前包）
  try {
    const o = raw as UTSJSONObject;
    const id = o.get("id") as string | null;
    if (id != null && id.length > 0) {
      const name = o.get("name") as string | null;
      const kind = o.get("kind") as string | null;
      return {
        id: id,
        name: name != null ? name : "",
        kind: kind != null ? kind : "",
        targetSong: parseTargetSong(o.get("targetSong"), id),
      };
    }
  } catch (e) {
    // 落到下面按字符串再试
  }
  // ② 字符串形状（旧包：line 是 JSON 文本）
  try {
    const text = raw as string;
    if (text.length == 0) return null;
    const o = JSON.parse(text) as UTSJSONObject;
    const id = o.get("id") as string | null;
    if (id == null || id.length == 0) return null;
    const name = o.get("name") as string | null;
    const kind = o.get("kind") as string | null;
    return {
      id: id,
      name: name != null ? name : "",
      kind: kind != null ? kind : "",
      targetSong: parseTargetSong(o.get("targetSong"), id),
    };
  } catch (e) {
    return null;
  }
}

/**
 * 用引擎取播放地址。失败一律返回 ""（不抛错）——
 * 调用方拿到空串直接报「暂时无法播放」，不再有第二套取链实现兜底。
 * 没装播放包 / meta 报「未安装播放音源包」时广播 PLAY_PACK_MISSING_EVENT。
 * 成功时把命中的线路存进 lastPlayUrlLine（见 consumePlayUrlLine）。
 */
export async function getPlayUrlByEngine(song: Song, quality: string): Promise<string> {
  if (!(await ensurePlayPackLoaded())) return "";
  const args = new UTSJSONObject();
  args.set("platform", song.platform);
  args.set("id", song.id);
  args.set("name", song.name);
  args.set("singer", song.singer);
  args.set("album", song.album);
  args.set("quality", quality);
  args.set("duration", song.duration != null ? song.duration : 0);
  let value = "";
  try {
    value = await callInvoke("getPlayUrl", JSON.stringify([args]), PLAY_TIMEOUT_MS);
  } catch (e) {
    // 未装播放包（meta 转发层抛 PLAY_PACK_MISSING_MESSAGE）→ 引导安装
    const message = msgOf(e);
    if (message.indexOf(PLAY_PACK_MISSING_MESSAGE_PART) >= 0) {
      emitPlayPackMissing();
      return "";
    }
    // 单曲取不到不算引擎故障，不写 failed。
    // 错误文本里带歌/音质定位 + bundle 侧的逐线路追踪（meta 会把 trace 拼进 error）
    console.log(`[SourceEngine] 引擎取链失败：${message}（${song.platform} @${quality}「${song.name} ${song.singer}」id=${song.id}）`);
    return "";
  }
  try {
    const o = JSON.parse(value) as UTSJSONObject;
    const url = o.get("url") as string | null;
    if (url == null || url.length == 0) return "";
    // 命中线路随应答一起回来（老包没有 line 字段 → null，管理端按未知展示）
    lastPlayUrlLine = parsePlayUrlLine(o.get("line"));
    return url;
  } catch (e) {
    return "";
  }
}

// ==================== 音源数据接口 ====================

/** 数据接口默认超时：单请求一般数秒；像酷我每日推荐一次拉 20 页这种多请求链条，
 * 手机网络下可到 20-30s，给 30s 预算（单个 HTTP 仍有 15s 超时，坏接口不会拖满） */
const DATA_TIMEOUT_MS = 30000;

/**
 * 调 meta 的音源数据入口（search / playlistDetail / lyric / cover 等），
 * 返回入口应答的 JSON 文本（形状见 qt-sources/src/meta-entries.ts）。
 *
 * 只需已装数据包（数据面与播放包解耦）：未装播放包时搜索/歌单/歌词照常工作；
 * 未装数据包时这里抛错（missing，调用方按页面加载失败提示，首页引导指路设置页）。
 * 失败抛错（调用方按原语义 catch/提示），因为数据接口取不到就是页面加载失败，
 * 需要让用户看到。
 */
export async function invokeSource(name: string, argsJson: string, timeoutMs: number = DATA_TIMEOUT_MS): Promise<string> {
  if (!(await ensureDataEngine())) {
    throw new Error("音源引擎未就绪：" + (gLastError.length > 0 ? gLastError : "尚未装载"));
  }
  return await callInvoke(name, argsJson, timeoutMs);
}

/** 试听校验：让 meta 发一次 Range 请求确认地址真的可播（冒烟自检的第 ③ 道闸门；
 *  实现在 meta 层，不依赖播放包） */
export async function verifyPlayableByEngine(url: string): Promise<boolean> {
  if (!(await ensureDataEngine())) return false;
  const args = new UTSJSONObject();
  args.set("url", url);
  try {
    const value = await callInvoke("verifyPlayable", JSON.stringify([args]), VERIFY_TIMEOUT_MS);
    const o = JSON.parse(value) as UTSJSONObject;
    const okFlag = o.get("ok") as boolean | null;
    return okFlag == true;
  } catch (e) {
    return false;
  }
}

// ==================== 启动预热 ====================

/**
 * 冷启动预热：恢复生效状态 → 起引擎 → 装生效数据包（未装则直接返回，数据面下线
 * 由首页/设置页引导）→ 注入生效中的播放包（如有）。
 * 全部失败都只记录日志，不抛错：本地音乐不受影响；未装数据包/播放包时由
 * 设置页/首页引导指路安装。
 * 启动预热**不做冒烟**（冒烟要发真实网络请求，交给用户显式的安装/切换动作）。
 */
export async function prewarm(): Promise<void> {
  try {
    await ensureLocalStateRestored();
    if (!(await ensureDataEngine())) return;
    const pack = activePack();
    if (pack == null) return;
    await ensurePlayPackLoaded();
  } catch (e) {
    console.log("[SourceEngine] 预热失败：" + msgOf(e));
  }
}

/** App.uvue 启动入口用的别名（语义更直白） */
export const prewarmSourceEngine = prewarm;
