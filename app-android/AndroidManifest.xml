<?xml version="1.0" encoding="utf-8"?>
<!-- 轻听音乐 - 自定义 AndroidManifest.xml
     允许全部明文 HTTP 流量：酷我/酷狗/QQ/网易云等第三方音乐接口与封面均为 http://，
     Android 9+ 默认禁止明文，发行包若不放行会出现"CLEARTEXT not permitted"网络错误。
     云打包机制：项目根目录 AndroidManifest.xml 会与 DCloud 默认 manifest 合并。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 后台音频前台服务所需权限（冗余声明，确保播放不崩） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 允许全部明文 HTTP 流量 -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />

</manifest>
