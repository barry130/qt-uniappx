  // #ifndef APP-HARMONY
  // 鸿蒙不注册 tabBar：uni-app x 鸿蒙 runtime 的原生 Tabs 容器在「追加第二个 tab 页」
  // 这条链路上不生效（switchTab/reLaunch 都会走到 switchSelect → appendItem，
  // success 回调会触发、JS 侧页面栈也会变，但原生视图不切换，详见 design.md「平台差异」）。
  // 少注册 tabBar 后，首页/我的都退化成普通页面，切 tab 用 reLaunch（qtSwitchTab），
  // 走的是与普通页面一致的原生路由，鸿蒙上实测可用。
  "tabBar": {
    "color": "@tabFontColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "white",
    "fontSize": "10px",
    "height": "56px",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "发现",
        "iconPath": "static/tab/discover.png",
        "selectedIconPath": "static/tab/discover-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tab/profile.png",
        "selectedIconPath": "static/tab/profile-active.png"
      }
    ]
  },
  // #endif
  "globalStyle": {
    "navigationStyle": "custom",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "轻听",
    "backgroundColor": "@pageBg",
    "pageOrientation": "auto",
    "rpxCalcMaxDeviceWidth": 500,
    "rpxCalcBaseDeviceWidth": 375
  }
}
