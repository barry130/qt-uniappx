# dependencies
node_modules/

# build output
unpackage/

# 本地临时目录（APK 解包、诊断产物等，不入库）
.tmp/
.tmpapk/
_shots/

# IDE
.hbuilderx/

# OS
.DS_Store
Thumbs.db

# logs
*.log

# runtime logs
dist/ 

# local API config (生产地址，不上传)
