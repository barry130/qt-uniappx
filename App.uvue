<script setup lang="uts">
import { qtShowToast } from "@/services/toast";
import { usePlayerStore } from '@/stores/player'
import { useDownloadsStore } from '@/stores/downloads'
import { useDislikesStore } from '@/stores/dislikes'
import { useLyricOffsetStore } from '@/stores/lyric-offset'
import { useSourceStore } from '@/stores/source'
import { playerBarCounted, usePlayerBarStore } from '@/stores/player-bar'
import { isQtAdmin } from '@/services/music-api'
import { useThemeStore } from '@/uni_modules/qt-ui/stores/theme'
import { useFontScaleStore } from '@/uni_modules/qt-ui/stores/font-scale'
import { useNoticeStore } from '@/stores/notice'
import { useDisclaimerStore } from '@/stores/disclaimer'
import { audioPlayer } from '@/services/audio-player'
import { desktopLyric } from '@/services/desktop-lyric'
import { resolveUrl } from '@/services/http'
import { initQtStat, qtTrack, qtTrackError, qtStatFlush } from '@/uni_modules/qt-stat'
import { checkAppUpdate, checkOfficialVersion, setPendingUpdate } from '@/services/upgrade'
import { prewarmSourceEngine, PLAY_PACK_MISSING_EVENT } from '@/services/source-engine'
import {
  discoverUpdatesAtStartup,
  SOURCE_UPDATE_FOUND_EVENT,
  offersFromJson,
  applyUpdate,
  pickSmokeSongs,
  offerLabel,
} from '@/services/source-update'
import type { PackUpdateOffer } from '@/services/source-update'
import { exitApp, ensureNotificationPermission, openNotificationSettings, applyLegacyInsets, isIgnoringBatteryOptimizations, openBatteryOptimizationSettings } from '@/services/app-native'
import { beginLoading, finishLoading } from '@/services/ui-loading'
import { refreshQtLayout, pauseQtLayoutWatcher, resumeQtLayoutWatcher } from '@/uni_modules/qt-ui/composables/use-qt-layout'
import { installBootGuard, notifyAppForeground, notifyAppBackground } from '@/services/boot-guard'
import { refreshMe } from '@/services/user-cache'
import { initLogger, flushLogs, logLine, logMsgErr, LOG_ERROR } from '@/services/logger'
import { qtConfirm } from '@/services/confirm'
// 音源账号登录态注入：import 即注册「meta 装载成功」钩子（服务模块级副作用）
import { ensureSourceAuthInjected } from '@/services/source-auth'

onLaunch(() => {
  // 三星 One UI 手势导航下 edge-to-edge 窗口会让运行时首屏挂载竞态（S24 Ultra
  // 全屏白屏），启动最早点强制窗口回归传统 inset 布局（等价三键导航），见 boot-guard.ts
  applyLegacyInsets()
  // 尽早确定宽窄屏状态（qt-page-frame / 各组件的响应式判断都依赖它）
  refreshQtLayout(720)
  // 本地日志最先初始化：后面每一步（统计、恢复、预热）都可能出错，
  // 而那些错误只有在日志已经能落盘时才有地方记。发行包没有控制台，这是唯一现场。
  initLogger()
  // 统计采集最先初始化（JS/UTS 层错误等，走自建 /api/v1/app/stat/report）
  initQtStat({
    ingestUrl: resolveUrl('app/stat/report'),
    channel: 'official',
    debug: false,
    batchIntervalMs: 10000,
    maxBatchSize: 50,
  })
  qtTrack('launcher')

  // 让自定义基座收录 uni-showLoading 模块（框架 navigateBack 内部会无条件调 hideLoading，
  // 而自定义基座按用量裁剪模块；项目本身不用 loading 会导致返回时报 uni-showLoading not found）。
  keepLoadingModule()
  audioPlayer.restore()
  // 桌面歌词开关为运行期状态（不持久化），启动后默认关闭，无需恢复
  desktopLyric.restore()
  usePlayerStore().restore()
  useDownloadsStore().restore()
  // 不喜欢列表：放在 player 之后（player restore 只加载数据不推时间线），
  // 但必须在用户任何播放动作之前就绪——启动后首次 play/pushTimeline 就要按它过滤
  useDislikesStore().restore()
  // 歌词偏移（全局默认 + 按曲目覆盖）：纯本地偏好，播放页取当前行时按它换算，
  // 所以必须在首次渲染歌词之前就绪
  useLyricOffsetStore().restore()
  useSourceStore().restore()
  // 播放页工具按钮开关（设置 → 播放页按钮）：纯本地展示偏好。
  // 必须带名额口径：非管理员的「播放链接」不渲染、不占名额，否则恢复时会把
  // 白名单里的第 5 个按钮当成超额项截掉（表现为「设置了，返回又没了」）。
  usePlayerBarStore().restore((id: string): boolean => playerBarCounted(id, isQtAdmin()))
  useThemeStore().init()
  // 全局字号缩放：纯本地偏好，必须在首屏渲染前恢复，否则首帧字号会先按标准档
  // 画一次再跳变（内联 :style 绑定依赖 store 已就绪的 scale）
  useFontScaleStore().init()
  // 酷我 Cookie 鉴权随音源包走（bundle 内惰性初始化），启动无需本端预热
  // 启动时检查/请求通知栏权限（Android 13+ 弹系统授权框，并说明用途）
  checkNotificationPermission()
  // 已登录时从服务器同步收藏：先增量拉取，再与服务器做存在性对账，本地有而
  // 服务器没有的收藏自动补推（覆盖服务器整库重建/部分删数据后自愈）
  usePlayerStore().syncLikesOnLaunch().catch(() => {})
  // 已登录则后台拉一次 /me 写缓存：本次运行内「我的」相关页面只读缓存，不再每次 onShow 都请求
  refreshMe().catch(() => {})
  // 启动顺序：1.官方校验 → 2.检查更新 → 3.加载公告
  runStartup()
  // 音源引擎预热：恢复本地状态 → 起 WebView(V8) 引擎 → 装已安装的音源包（未安装则直接返回，全程失败静默）
  prewarmSourceEngine()
  // 音源账号登录态对账重灌（引擎未就绪则静默；装载成功钩子会兜底重放）
  ensureSourceAuthInjected().catch(() => {})
  // 启动时发现音源包更新（各包自管 updateUrl + astral manifest，4 小时节流）：
  // 只发现不安装——发现到新版后弹「仅提示」的确认框，用户点了「更新」才下载生效
  setTimeout(() => {
    discoverUpdatesAtStartup()
  }, 3000)
  // 首屏守卫：部分机型（如三星 S24 Ultra 全屏）首页视图树可能一直不挂载，
  // 8s 后仍未挂载则上报 boot-guard 并重建首页，见 services/boot-guard.ts
  installBootGuard()
  // 在线播放需要「播放音源包」（不内置，版权风险由用户自行安装）：
  // 引擎在「要取链但没有生效播放包」时广播该事件（引擎侧 10s 节流），
  // 这里弹一次引导，去设置页安装——不放下载链接，安装动作都在设置页完成
  uni.$on(PLAY_PACK_MISSING_EVENT, showPlayPackMissingGuide)
  // 启动更新发现拿到「可用更新」清单：逐条弹「仅提示」确认框（绝不自动安装），
  // 用户点「更新」才下载 → 校验 → 替换 → 生效；点「暂不」保留红点进设置页处理
  uni.$on(SOURCE_UPDATE_FOUND_EVENT, (payload: string) => {
    promptPackUpdates(offersFromJson(payload))
  })
})

/**
 * 逐条提示可用更新（仅提示、手动确认；meta 先于 play——数据面先就绪）。
 * 确认后走 applyUpdate（下载 → 头校验 → 替换 → 生效/回滚），结果 toast。
 */
async function promptPackUpdates(offers: PackUpdateOffer[]): Promise<void> {
  const sorted = offers
    .filter((o) => o.kind == 'meta' || o.kind == 'play')
    .sort((a, b) => (a.kind == 'meta' ? -1 : 1))
  for (let i = 0; i < sorted.length; i++) {
    const offer = sorted[i]
    const confirmed = await qtConfirm({
      title: '音源包更新',
      content:
        offerLabel(offer) +
        (offer.notes.length > 0 ? '\n' + offer.notes : '') +
        '\n是否现在下载并更新？',
      confirmText: '更新',
      cancelText: '暂不',
    })
    if (!confirmed) continue
    // 用户在确认框弹出后可能已离开当时的前台页面。框架的 uni-showLoading 绑定
    // 「调用时的前台页面」，对已销毁页面调 show/hide 会抛内部空指针
    // （NativeLoading.updateUI index.kt:84）。这里记下确认框弹出时的路由，
    // 用户确认后若路由已变，就只刷新红点、跳过这次更新。
    const routeAtPrompt = currentTopRoute()
    const token = beginLoading('正在更新…')
    try {
      const songs = await pickSmokeSongs()
      const result = await applyUpdate(offer, songs)
      if (routeAtPrompt != currentTopRoute()) continue
      qtShowToast({ title: result.message, icon: 'none', duration: 3000 })
    } catch (e) {
      // 单条更新链路意外失败不拦住后续 offer：落日志、继续弹下一条
      logMsgErr('[App] 音源包更新失败: ' + (e != null ? String(e) : 'unknown'))
    } finally {
      // beginLoading/finishLoading 必须配对：ui-loading 只防页面销毁/跨页错位，
      // 不兜业务异常，漏收口就是永久 loading
      finishLoading(token)
    }
  }
}

/** 栈顶页面路由；页面栈为空或取不到时返回 "" */
function currentTopRoute(): string {
  try {
    const pages = getCurrentPages()
    if (pages.length > 0) {
      const top = pages[pages.length - 1]
      const route = top.route
      if (route != null) return route
    }
  } catch (_) {}
  return ""
}

/** 播放包缺失引导的弹窗节流：1 分钟内最多一次（用户点了「去安装」则到设置页处理） */
let lastPlayPackGuideAt = 0

function showPlayPackMissingGuide(): void {
  const now = Date.now()
  if (now - lastPlayPackGuideAt < 60000) return
  lastPlayPackGuideAt = now
  qtConfirm({
    title: '未安装播放音源包',
    content: '在线播放需要在 设置 → 音源包管理 安装并启用播放音源包。本地音乐播放不受影响。',
    confirmText: '去安装',
    cancelText: '暂不',
  }).then((ok) => {
    if (!ok) return
    uni.navigateTo({ url: '/pages/source-pack/index' })
  })
}

// 进入前台时发送 show 事件（统计回前台）；已登录时增量拉取收藏变更（多端同步，LIKE_SYNC_DESIGN.md）
onShow(() => {
  // 首屏守卫回前台：后台期间系统会冻结 JS 定时器，冻到很晚才触发的「未挂载」判定
  // 毫无意义（实测有间隔 19 分钟的用例），所以回前台重新计时并重新给一次机会
  notifyAppForeground()
  qtTrack('show')
  useThemeStore().syncSystemTheme()
  // 回前台恢复窗口尺寸监听（后台期间系统可能改了窗口尺寸，如分屏 / 旋转）
  resumeQtLayoutWatcher(720)
  usePlayerStore().pullChanges().catch(() => {})
  // 桌面歌词与原生真相（悬浮窗是否真的在显示）对账：后台期间用户可能在通知栏
  // 点过「词」按钮，而 JS 侧回调未必收到，这里补齐，避免窗口开着却没歌词
  desktopLyric.refreshFromNative()
})

// 进入后台时保存播放状态（当前歌曲/进度），供下次重启后恢复；并追加统计 flush
onHide(() => {
  // 进后台立刻停掉首屏守卫的判定：后台白屏不该被当成启动失败
  notifyAppBackground()
  // 注意：**后台继续下载**，这里不暂停。只有「退出/被杀后重新启动」才是暂停态，
  // 那条路径由 restoreTasks 恢复成 paused 保证（见 stores/downloads.ts）。
  usePlayerStore().persist()
  // 暂停宽窄屏窗口监听，避免后台空转
  pauseQtLayoutWatcher()
  qtStatFlush()
  // 日志刷盘：后台后进程随时可能被系统回收，队列里没写完的行不能等下次启动再补
  flushLogs().catch(() => {})
})

/**
 * 仅「引用」loading API，不实际弹出，用于让编译器把 uni-showLoading 模块打进自定义基座。
 * 不要删除：删掉后自定义基座会裁掉该模块，返回上一页时框架内部 hideLoading 会抛
 * “uni-showLoading not found”。
 */
function keepLoadingModule(): void {
  // 条件恒为 false，只保留对 API 的静态引用，运行时不会执行、不会闪 loading
  if (Date.now() < 0) {
    uni.showLoading({ title: '' })
    uni.hideLoading()
  }
}

// JS/UTS 层运行错误上报（仅覆盖可捕获运行错误，走自建 /api/v1/app/stat/report；原生崩溃不做采集）
// err 类型不定：优先取 Error.message/stack（实测 JSON.stringify(Error) 会得到 "{}"，不可作首选）；
// stack 由运行时提供（含 app-service.js 位置），page 取 getCurrentPages 栈顶路由
onError((err: any) => {
  let msg = ''
  let stack = ''
  try {
    const e = err as Error
    const m = e.message
    if (m != null && m.length > 0) msg = m
  } catch (_) {}
  if (msg.length == 0) {
    try {
      msg = JSON.stringify(err)
    } catch (_) {
      msg = ''
    }
  }
  if (msg.length == 0 || msg == '{}') msg = 'unknown'
  try {
    const e2 = err as Error
    const st = e2.stack
    if (st != null) stack = st
  } catch (_) {}
  let page = ''
  try {
    const pages = getCurrentPages()
    if (pages.length > 0) {
      const top = pages[pages.length - 1]
      const r = top.route
      if (r != null) page = r
    }
  } catch (_) {}
  // 本地日志留一份：发行包用户报障时，服务端统计未必拿到（离线/未同意），
  // 而文件是「用户能复制出来发给我们」的那一份
  logLine(LOG_ERROR, 'App', '未捕获运行错误 page=' + page + ' msg=' + msg + (stack.length > 0 ? '\n' + stack : ''))
  qtTrackError('js', msg, stack, page)
})

// 关于未处理的 Promise 拒绝：uni-app x 只在**选项式** App 接口里给了
// `onUnhandledRejection?(): void`（types/app.d.ts:830），组合式 API 没有对应
// 导出（LifeCycle.d.ts 里只有 onError），而且它连拒绝原因都不传。
// 所以这里注册不了全局拒绝钩子——拒绝值只能由各调用点自己 catch 后 logError，
// services 里的关键链路（http / 音源 / 下载 / 更新）都按这个约定处理。

/** 启动时检查通知栏权限，未授权则弹系统授权框，并说明用途 */
function checkNotificationPermission(): void {
  ensureNotificationPermission().then((granted) => {
    if (granted) return
    // 拒绝或未授权：说明用途，避免用户不理解为何需要此权限
    qtConfirm({
      title: '开启通知权限',
      content: '为了在后台播放时也能显示歌曲信息与播放控制，需要开启「通知」权限。\n是否前往系统设置开启？',
      confirmText: '去设置',
      cancelText: '暂不',
      danger: true,
    }).then((ok) => {
      if (!ok) return
      const opened = openNotificationSettings()
      if (!opened) {
        qtShowToast({ title: '无法打开设置页，请手动在系统设置中开启', icon: 'none' })
      }
    })
  })
}

/**
 * 后台保活引导（一次性）。
 *
 * 背景：锁屏 / 切后台后系统进入 Doze 会掐掉后台网络，此时「下一首」取链会失败，
 * 用户看到的是「播放突然断了」而不是「系统限制了后台」。播放本身有前台服务
 * （QtAudioService，mediaPlayback 类型）保活，但部分国产 ROM 的省电策略更激进，
 * 必须由用户手动把本应用加进电池优化白名单 / 允许自启动。
 *
 * 只提示一次（storage 记住），且启动后延迟 6s——不打断冷启动的官方校验/更新检查。
 * 查询失败时原生侧返回 true（视为已放行），所以不会误报。
 */
const BATTERY_GUIDE_KEY = 'qt-battery-guide-shown'

function guideBatteryOptimization(): void {
  if (isIgnoringBatteryOptimizations()) return
  try {
    if (uni.getStorageSync(BATTERY_GUIDE_KEY) == '1') return
  } catch (_) {}
  // 标记先写：用户中途杀进程也不该重复打扰（设置页里随时能手动改）
  try {
    uni.setStorageSync(BATTERY_GUIDE_KEY, '1')
  } catch (_) {}
  qtConfirm({
    title: '让后台播放更稳定',
    content:
      '检测到本应用未加入电池优化白名单，锁屏或切到后台后系统可能限制网络，导致自动播放下一首失败。\n建议在系统设置中允许后台运行。',
    confirmText: '去设置',
    cancelText: '暂不',
  }).then((ok) => {
    if (!ok) return
    const opened = openBatteryOptimizationSettings()
    if (!opened) {
      qtShowToast({ title: '无法打开设置页，请手动在 设置→电池 中放行', icon: 'none' })
    }
  })
}

/** 启动主流程（顺序执行） */
async function runStartup(): Promise<void> {
  // 1. 校验是否为官方 APP：非官方则提示并 3S 后自动退出
  const isOfficial = await checkOfficialVersion()
  if (!isOfficial) {
    qtConfirm({
      title: '提示',
      content: '检测到非官方版本，3 秒后自动退出',
      showCancel: false,
      confirmText: '知道了',
      danger: true,
    })
    setTimeout(() => {
      exitApp()
    }, 3000)
    return
  }

  // 2. 检查 APP 更新：存在更新时挂起，由首页直接弹出升级弹窗（富文本展示更新说明，
  //    确认后原地下载/安装，不再跳转 我的 → 关于 页面）
  try {
    const info = await checkAppUpdate()
    if (info != null && info.updateType == '1') {
      setPendingUpdate(info)
    }
  } catch (e) {
    logMsgErr('[App] 检查更新异常', e)
  }

  // 3. 加载 APP 公告
  useNoticeStore().load().catch(() => {})
  // 3.1 首次启动免责声明（正文由后台下发）：与公告同一时机拉取。
  //     独立请求而不是复用上面那份列表，是为了让两个功能互不牵连——
  //     公告接口失败不该连带声明不弹，反之亦然。init() 内部自己吞异常。
  useDisclaimerStore().init().catch(() => {})
  // 4. 后台保活引导：延迟到冷启动流程之后，避免和官方校验/更新弹窗抢焦点
  setTimeout(() => {
    guideBatteryOptimization()
  }, 6000)
}
</script>

<style>
  @import "@/styles/glass.css";
</style>
